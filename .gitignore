# Compiled output programs are extensionless and sit right next to their
# .yoop sources. So the default rule is: ignore every extensionless file,
# but track anything that has an extension (.yoop, .md, .js, .c, ...).
#
#   *      ignore everything
#   !*/    but still descend into directories (so files below can be re-added)
#   !*.*   and re-add any file whose name contains a "." (i.e. has an extension)
*
!*/
!*.*

# Extensionless files we DO want to keep tracked:
!LICENSE
# A module's advisory version file (plans/modules-folder.md). Extensionless on
# purpose - it reads as informational next to LICENSE and README - which means
# the "*" rule above would drop it from every module that ships one.
!MODULE
# The local-CI image (scripts/ci_local.sh). Extensionless by docker convention,
# so the "*" rule dropped it: the script shipped, the file it builds did not,
# and local CI was broken on any machine but the one it was written on.
!Dockerfile

# Re-ignore artifacts that DO have an extension (the rules above would keep
# them otherwise):
*.exe
**/*dSYM/
# The Windows equivalents of *dSYM/: link.exe drops a .pdb (debug symbols)
# and a .ilk (incremental-link state) beside every binary it produces.
*.pdb
*.ilk
# Object files - the C runtime compiles to these when built out of tree
# (the test suites prebuild it once per run rather than per fixture).
*.o
*.obj

# Local editor / tooling state (not a source file, just has an extension).
.claude/

.DS_Store

# Dependency + build trees. These need naming explicitly: the "!*.*" rule
# above would otherwise track every .js in node_modules and every .yoop the
# SEA build copies into dist/*/lib/std.
node_modules/
build/
dist/

# npm pack output.
*.tgz
