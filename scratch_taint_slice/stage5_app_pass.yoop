// STAGE 5 (positive control for the cross-module SINK check): a legitimately
// `cleared` value (here a parameter; in real code the result of a launder)
// flows into the namespaced library sink. Must compile clean - confirms the
// new cross-module arg check accepts a value that DOES carry the capability
// (imported `cleared` is the same object as the sink's, so identity lines up).

import { Body, cleared } from "./stage5_lib.yoop";
import * as db from "./stage5_lib.yoop";

function forward(safe: cleared Body): void {
    db.runQuery(safe); // cleared param into a namespaced sink: should pass
}

function main(): int32 {
    return 0;
}
