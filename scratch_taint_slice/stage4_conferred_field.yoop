// STAGE 4: the conferred direction, which does NOT need a marker on the field.
// The Request body is a PLAIN field (no kind prefix). The SQL sink simply
// requires `cleared`. The only way to mint `cleared` is the Sanitizer trait
// method. So:
//   - forgot:  runQuery(req.body)                      -> should REJECT (field access lacks `cleared`)
//   - correct: runQuery(Sanitizer.sanitize(ref req.body)) -> should PASS (launder mints `cleared`)
// This probes whether the guarantee flows through a struct field via the
// conferred (positive-capability) direction, with zero field annotation.

trait Sanitizer<T> {
    function sanitize(ref self): T;
}

kind cleared {
    appliesTo binding parameter field return;
    conferred;
    requires Sanitizer;
    appliedBy sanitize;
}

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type Body implements Sanitizer<Body> {
    text: string,
    function sanitize(ref self): Body {
        return { text: "safe" };
    }
}

// Note: body is a PLAIN field. No `tainted`, no `propagates`. Nothing special.
type Request {
    path: string,
    body: Body,
}

function receive(): Request {
    return { path: "/", body: { text: "'; DROP TABLE users; --" } };
}

function runQuery(sql: cleared Body): void {
    printf(`query: %s\n`, sql.text);
}

function main(): int32 {
    let req: Request = receive();
    let safe: cleared Body = Sanitizer.sanitize(ref req.body);
    runQuery(safe);                 // correct path
    return 0;
}
