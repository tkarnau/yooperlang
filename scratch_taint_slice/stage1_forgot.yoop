// STAGE 1 (forgot): same setup, but main passes the raw body straight to the
// SQL sink. Expectation: REJECTED. This is the bug we want the compiler to catch.

trait Sanitizer<T> {
    function sanitize(ref self): T;
}

kind tainted {
    appliesTo binding parameter field return;
    restrictive;
    requires Sanitizer;
    clearedBy sanitize;
}

kind cleared {
    appliesTo binding parameter field return;
    conferred;
    requires Sanitizer;
    appliedBy sanitize;
}

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type Body implements Sanitizer<Body> {
    text: string,
    function sanitize(ref self): Body {
        return { text: "safe" };
    }
}

function readRequestBody(): tainted Body {
    return { text: "'; DROP TABLE users; --" };
}

function runQuery(sql: cleared Body): void {
    printf(`query: %s\n`, sql.text);
}

function main(): int32 {
    let raw: tainted Body = readRequestBody();
    runQuery(raw); // forgot to sanitize: should be rejected
    return 0;
}
