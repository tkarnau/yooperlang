// STAGE 3b: the realistic std shape. Kinds/types can be imported by-name (std
// exempts them), but a std VALUE (the source function) must be called through a
// namespace: `lib.readRequestBody()`. That call is a non-string callee, which
// exprMarkers does not recognize. Prediction: the taint evaporates and the
// forgot-to-sanitize bug compiles clean.

import { tainted, cleared, Body } from "./stage3_lib.yoop";
import * as lib from "./stage3_lib.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function runQuery(sql: cleared Body): void {
    printf(`query: %s\n`, sql.text);
}

function main(): int32 {
    let raw: tainted Body = lib.readRequestBody();
    runQuery(raw); // forgot to sanitize, via a namespaced (std-style) call
    return 0;
}
