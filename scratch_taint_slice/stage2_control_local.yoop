// STAGE 2 (control): identical plain sink, but the tainted value is a LOCAL
// binding, not a struct field. v0 enforces binding sites, so this SHOULD be
// rejected. The contrast with stage2_field_leak isolates the gap: the
// restrictive check works; field access is where the marker is dropped.

trait Sanitizer<T> {
    function sanitize(ref self): T;
}

kind tainted {
    appliesTo binding parameter field return;
    restrictive;
    requires Sanitizer;
    clearedBy sanitize;
}

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type Body implements Sanitizer<Body> {
    text: string,
    function sanitize(ref self): Body {
        return { text: "safe" };
    }
}

function readRequestBody(): tainted Body {
    return { text: "'; DROP TABLE users; --" };
}

function logLine(b: Body): void {
    printf(`log: %s\n`, b.text);
}

function main(): int32 {
    let dirty: tainted Body = readRequestBody();
    logLine(dirty); // tainted local into a plain slot: should be rejected
    return 0;
}
