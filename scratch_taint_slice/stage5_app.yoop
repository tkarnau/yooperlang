// STAGE 5 app: forgets to sanitize, and calls the library sink through its
// namespace (`db.runQuery(...)`) - exactly how std sinks are invoked. If the
// arg check only fires for bare-name callees, this SQL-injection bug compiles
// clean. Prediction: compiles (the guarantee evaporates at the namespaced sink).

import { Body } from "./stage5_lib.yoop";
import * as db from "./stage5_lib.yoop";

function main(): int32 {
    let req: db.Request = db.receive();
    db.runQuery(req.body); // namespaced sink call with an un-sanitized body
    return 0;
}
