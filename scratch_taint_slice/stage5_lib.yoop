// STAGE 5: the sink lives in the library (as a real std sink would). The app
// calls it through a namespace. Probes whether the arg check fires for a
// namespaced (non-string) callee.

export trait Sanitizer<T> {
    function sanitize(ref self): T;
}

export kind cleared {
    appliesTo binding parameter field return;
    conferred;
    requires Sanitizer;
    appliedBy sanitize;
}

export type Body implements Sanitizer<Body> {
    text: string,
    function sanitize(ref self): Body {
        return { text: "safe" };
    }
}

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

// The library's SQL sink: demands a cleared body.
export function runQuery(sql: cleared Body): void {
    printf(`query: %s\n`, sql.text);
}

// The library hands you a request whose body is plain.
export type Request {
    path: string,
    body: Body,
}

export function receive(): Request {
    return { path: "/", body: { text: "'; DROP TABLE users; --" } };
}
