/*
  Author: Tom Karnau

  Http server proof of concept demonstration in yooperlang

  The ergonomics in here are deliberately chosen to make higher level
  feeling in the http code that we normally get from popular TS/JS libraries
  but this is running in a systems language.

  The actual network layer OS calls and such are the C system headers
  and we have a std/core set of yoop code that interfaces with that and
  surfaces yooperlang modules for interacting with it.

  Any of these core features could be written by hand.
*/

// The server handles N requests and then exits (the `n` arg). Use n <= 0 for
// a forever loop (normal behavior).

import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { ListenResult } from "std/net/tcp.yoop";
import * as tcp from "std/net/tcp.yoop";
import * as httpServer, { Handler, HandleOutcome, Dispatcher } from "std/http/server.yoop";
import * as http, { Request, Response, HttpError } from "std/http/types.yoop";

extern "C" from "stdio.h" {
  function printf(fmt: string, ...): int32;
}

// user-defined handler.
// this lives in your code when writing an API because the handler is the
// extension point - different programs supply different handlers and the
// std/http/server works against the Handler trait. Borrows from my comfort
// with things like Express.JS
type HelloHandler implements Handler {
  greeting: string,
  function handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
    // One call sets the status, the Content-Type, and the body.
    http.respondText(ref resp, http.ok(), self.greeting);
    return HandleOutcome.Ok;
  }
}

function main(): int32 {

  // host, port, backlog
  // backlog is the maximum pending-connection queue length
  // backlog is passed directly to C function -> "listen" call in sys/socket.h
  let disposable lr: ListenResult = tcp.tcp_listen("127.0.0.1", 18080, 128) {
    // there is no try/catch in this language.
    // explicitly inspect the `error` field on the disposable result.
    if (lr.error.len > 0) {
      printf(`bind failed: ${lr.error}\n`);
      return 1;
    }
    printf(`listening on 127.0.0.1:18080\n`);
    let handler: HelloHandler = { greeting: "Hello, World!\n" };

    // `Dispatcher.from` erases the handler's type. The serve loop takes the
    // erased form, so it is compiled once for the whole program no matter
    // how many handlers you write.
    let d: Dispatcher = Dispatcher.from(ref handler);

    // n=0: serve forever. Switch to a positive N to exit after N requests,
    // which is what the test scripts do.
    // This is not an async function - it runs a blocking accept loop with its
    // own suspension and timers underneath. This IS the "long-running"
    // process; there is no ambient event loop to hand work back to like in a
    // GC'd or event-looped language. Wrap it in a `task` if the program has
    // other work to do.
    switch (httpServer.serveDefault(ref lr.listener, ref d, 0)) {
      case Result.Ok { value: n }: { printf(`served=${n}\n`); }
      // A listener failure is the only thing that ends the loop. A bad
      // request, an abrupt disconnect, or a handler error costs that one
      // connection and the server keeps going.
      case Result.Err { error: e }: { printf(`server stopped: ${e}\n`); return 1; }
    }
  }

  return 0;
}
