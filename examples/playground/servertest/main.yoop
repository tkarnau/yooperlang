/*
  Author: Tom Karnau

  Http server proof of concept demonstration in yooperlang

  The ergonomics in here are deliberately chosen to make higher level
  feeling in the http code that we normally get from popular TS/JS libraries
  but this is running in a systems language.

  The actual network layer OS calls and such are the C system headers
  and we have a std/core set of yoop code that interfaces with that and
  surfaces yooperlang modules for interacting with it.

  Any of these core features could be written by hand.
*/

// The server handles N requests and then exits (the `n` arg). Use n <= 0 for
// a forever loop (normal behavior).

import { disposable, task } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { ListenResult } from "std/net";
import * as tcp from "std/net";
import * as httpServer, { Handler, HandleOutcome, Dispatcher } from "std/http";
import * as http, { Request, Response, HttpError } from "std/http";

extern "C" from "stdio.h" {
  function printf(fmt: string, ...): int32;
}

// user-defined handler.
// this lives in your code when writing an API because the handler is the
// extension point - different programs supply different handlers and the
// std/http/server works against the Handler trait. Borrows from my comfort
// with things like Express.JS
//
// Note what the handler is NOT: async. It takes a fully buffered request and
// fills in a response, so there is nothing in here to await. The async
// coloring stops at the I/O boundary, one layer below this.
type HelloHandler implements Handler {
  greeting: string,
  async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
    // One call sets the status, the Content-Type, and the body.
    http.respondText(ref resp, http.ok(), self.greeting);
    return HandleOutcome.Ok;
  }
}

// `run` is async because everything underneath it is. Every accept, read and
// write in std/http suspends the calling coroutine instead of parking a
// worker thread, so a server sitting on an idle listener costs one coroutine
// frame and no thread at all. `await` is the only way to call an async
// function, and it is only legal inside another async function (or a `task`
// body) - which is what guarantees there is always a frame to suspend into.
async run(): Result<int32, HttpError> {

  // host, port, backlog
  // backlog is the maximum pending-connection queue length
  // backlog is passed directly to C function -> "listen" call in sys/socket.h
  let disposable lr: ListenResult = tcp.tcpListen("127.0.0.1", 18080, 128) {
    // there is no try/catch in this language.
    // explicitly inspect the `error` field on the disposable result.
    if (lr.error.len > 0) {
      return Result.Err { error: http.errIo(lr.error) };
    }
    printf(`listening on 127.0.0.1:18080\n`);
    let handler: HelloHandler = { greeting: "Hello, World!\n" };

    // `Dispatcher.from` erases the handler's type. The serve loop takes the
    // erased form, so it is compiled once for the whole program no matter
    // how many handlers you write.
    let d: Dispatcher = Dispatcher.from(ref handler);

    // n=0: serve forever. Switch to a positive N to exit after N requests,
    // which is what the test scripts do.
    switch (await httpServer.serveDefault(ref lr.listener, ref d, 0)) {
      case Result.Ok { value: n }: {
        printf(`served=${n}\n`);
        return Result.Ok { value: n };
      }
      // A listener failure is the only thing that ends the loop. A bad
      // request, an abrupt disconnect, or a handler error costs that one
      // connection and the server keeps going.
      case Result.Err { error: e }: {
        printf(`server stopped: ${e}\n`);
        return Result.Err { error: e };
      }
    }
  }

  return Result.Ok { value: 0 };
}

// `main` cannot be async - it is the sync/async boundary of the program.
// The bridge across it is a `task`: a task body is implicitly async, so it
// may await, and `wait` blocks the calling (synchronous) thread until the
// task settles. This IS the "long-running" process; there is no ambient
// event loop to hand work back to like in a GC'd or event-looped language.
task serveTask(): Result<int32, HttpError> {
  return await run();
}

function main(): int32 {
  // `pooled` is a kind: the binding is refcounted, and the compiler injects
  // the release at scope end. `wait` on it joins the task.
  pooled h = serveTask();
  switch (wait h) {
    case Result.Ok { value: _n }: { return 0; }
    case Result.Err { error: e }: {
      printf(`server failed: ${e}\n`);
      return 1;
    }
  }
  return 0;
}
