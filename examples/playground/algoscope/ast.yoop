// algoscope/ast.yoop - a thin typed view over the dumped-AST JSON tree.
//
// The `--dump-ast-json` payload is just JSON, so rather than build a second
// node tree we operate directly on `json.JsonValue` through these accessors.
// Each AST node is a JSON object shaped like:
//
//   { id, kind, label?, loc?, fields:{...scalars/objects}, children:[...] }
//
// where array-valued AST fields are wrapped as a child GROUP node
//   { kind:"GROUP", label:<fieldName>, children:[...] }
// and single AST children carry their field name in `label` (e.g. "left",
// "cond", "body"). These helpers hide that shape from pseudo.yoop.

import.unsafe;
import * as intr from "std/core/intrinsics.yoop";
import * as str from "std/core/strings.yoop";
import { Vec } from "std/core/vec.yoop";
import * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import * as json from "./json.yoop";

// ---- basic node fields ----

export function node_kind(n: json.JsonValue): string {
    return json.as_str(json.obj_get(n, "kind"));
}

export function node_label(n: json.JsonValue): string {
    return json.as_str(json.obj_get(n, "label"));
}

export function node_id(n: json.JsonValue): int32 {
    return json.as_int(json.obj_get(n, "id"));
}

export function kind_is(n: json.JsonValue, k: string): bool {
    return str.stringEq(node_kind(n), k);
}

// Direct children array (includes GROUP wrappers).
export function node_children(n: json.JsonValue): json.JsonValue[] {
    return json.obj_get(n, "children").items;
}

// ---- scalar field access (under the node's "fields" object) ----

export function field_str(n: json.JsonValue, key: string): string {
    return json.as_str(json.obj_get(json.obj_get(n, "fields"), key));
}

export function field_int(n: json.JsonValue, key: string): int32 {
    return json.as_int(json.obj_get(json.obj_get(n, "fields"), key));
}

export function field_bool(n: json.JsonValue, key: string): bool {
    return json.as_bool(json.obj_get(json.obj_get(n, "fields"), key));
}

export function field_num(n: json.JsonValue, key: string): float64 {
    return json.as_num(json.obj_get(json.obj_get(n, "fields"), key));
}

// A type annotation lives in `fields` as a nested object { kind, name, ... };
// project its display name. Returns "" when the field is absent.
export function field_type_name(n: json.JsonValue, key: string): string {
    let ta: json.JsonValue = json.obj_get(json.obj_get(n, "fields"), key);
    return json.as_str(json.obj_get(ta, "name"));
}

// Render a type-annotation object to a readable string: `int32`, `T[]`,
// `ref Pt`, etc. Handles the nested `arrayType`/`refType` shapes; falls back to
// a bare `name` or the kind tag for anything else.
export function type_display(ta: json.JsonValue): string {
    let k: string = json.as_str(json.obj_get(ta, "kind"));
    if (str.stringEq(k, "arrayType")) {
        return `${type_display(json.obj_get(ta, "elem"))}[]`;
    }
    if (str.stringEq(k, "refType")) {
        return `ref ${type_display(json.obj_get(ta, "elem"))}`;
    }
    if (str.stringEq(k, "typeName")) {
        return json.as_str(json.obj_get(ta, "name"));
    }
    let nm: string = json.as_str(json.obj_get(ta, "name"));
    if (!str.stringEq(nm, "")) { return nm; }
    return k;
}

// Render the type annotation stored at `fields[key]`.
export function type_of(n: json.JsonValue, key: string): string {
    return type_display(json.obj_get(json.obj_get(n, "fields"), key));
}

// ---- structural child lookups ----

// First direct child whose `label` equals `label`, or a null JsonValue.
export function child_by_label(n: json.JsonValue, label: string): json.JsonValue {
    let kids: json.JsonValue[] = node_children(n);
    let i: usize = usize(0);
    while (i < kids.len) {
        if (str.stringEq(node_label(kids[i]), label)) {
            return kids[i];
        }
        i = i + usize(1);
    }
    return json.mk_null();
}

export function has_child_label(n: json.JsonValue, label: string): bool {
    return !json.is_null(child_by_label(n, label));
}

// Items of the GROUP child named `label` (the array that field expanded into),
// or an empty array if there is no such group.
export function group_items(n: json.JsonValue, label: string): json.JsonValue[] {
    let kids: json.JsonValue[] = node_children(n);
    let i: usize = usize(0);
    while (i < kids.len) {
        let c: json.JsonValue = kids[i];
        if (kind_is(c, "GROUP") && str.stringEq(node_label(c), label)) {
            return json.obj_get(c, "children").items;
        }
        i = i + usize(1);
    }
    return intr.heapAlloc(usize(0));
}

// Statements of a BLOCK node (its body GROUP).
export function block_stmts(block: json.JsonValue): json.JsonValue[] {
    return group_items(block, "body");
}

// ---- top-level function discovery ----

// Collect every top-level FUNCTION_DECL under a PROGRAM node, descending into
// EXPORT_DECL wrappers (an `export function` parses as EXPORT_DECL with a single
// child labeled "decl"). Returned as an independently-owned array.
export function top_functions(program: json.JsonValue): json.JsonValue[] {
    disposable fns: Vec<json.JsonValue> = vec.vecNew(usize(16));
    let decls: json.JsonValue[] = group_items(program, "body");
    let i: usize = usize(0);
    while (i < decls.len) {
        let d: json.JsonValue = decls[i];
        if (kind_is(d, "FUNCTION_DECL")) {
            vec.vecPush(ref fns, d);
        } else if (kind_is(d, "EXPORT_DECL")) {
            let inner: json.JsonValue = child_by_label(d, "decl");
            if (kind_is(inner, "FUNCTION_DECL")) {
                vec.vecPush(ref fns, inner);
            }
        }
        i = i + usize(1);
    }
    // Copy out of the temporary Vec into an owned array (the Vec's view would
    // dangle once it is disposed at scope exit).
    let out: json.JsonValue[] = intr.heapAlloc(fns.len);
    let j: usize = usize(0);
    while (j < fns.len) {
        out[j] = fns.data[j];
        j = j + usize(1);
    }
    return out;
}
