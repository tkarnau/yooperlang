// Nebula Arena - GLSL + GPU-particle sibling demo to twinstick.
//
// Pure OpenGL pipeline (no SDL_Renderer). Showcases:
//   - A fragment-shader animated nebula background
//   - A single point-sprite shader that renders the player, bullets,
//     enemies, AND particle bursts -- driven by per-vertex size + color
//   - A pooled particle system: each enemy hit spawns ~30 short-lived
//     particles whose alpha + position decay frame to frame
//
// Gameplay is the same A/D + space + Esc loop twinstick uses, so the
// muscle memory transfers. The big difference is everything is drawn
// in one or two draw calls per frame instead of one per sprite.
//
// macOS-only today (uses `framework:OpenGL`). Linux would need a GL
// function loader for the 3.2+ core entry points; the rest of the
// program is portable.

import.unsafe;

import { Disposable, disposable } from "std/core/kinds.yoop";
import * as intr from "std/core/intrinsics.yoop";

// ── extern surface (SDL2 + OpenGL.framework) ─────────────────────────────────

extern "C" from library "SDL2" {
    type SDL_Window;
    type SDL_GLContext;

    function SDL_Init(flags: uint32): int32;
    function SDL_Quit(): void;
    function SDL_GetError(): string;
    function SDL_GetKeyboardState(ref numKeys: int): uint8[];
    function SDL_PumpEvents(): void;
    function SDL_GetTicks(): uint32;
    function SDL_Delay(ms: uint32): void;

    function SDL_CreateWindow(
        title: string,
        x: int32, y: int32,
        w: int32, h: int32,
        flags: uint32
    ): ref SDL_Window;
    function SDL_DestroyWindow(ref win: SDL_Window): void;

    function SDL_GL_SetAttribute(attr: int32, value: int32): int32;
    function SDL_GL_CreateContext(ref win: SDL_Window): unsafe_ptr<SDL_GLContext>;
    function SDL_GL_DeleteContext(ctx: unsafe_ptr<SDL_GLContext>): void;
    function SDL_GL_SetSwapInterval(interval: int32): int32;
    function SDL_GL_SwapWindow(ref win: SDL_Window): void;
}

extern "C" from library "framework:OpenGL" {
    function glClearColor(r: float32, g: float32, b: float32, a: float32): void;
    function glClear(mask: uint32): void;
    function glViewport(x: int32, y: int32, w: int32, h: int32): void;
    function glEnable(cap: uint32): void;
    function glBlendFunc(sfactor: uint32, dfactor: uint32): void;

    // Shader pipeline.
    function glCreateShader(stage: uint32): uint32;
    function glShaderSource(
        shader: uint32,
        count: int32,
        string_ptrs: unsafe_ptr<string>,
        length_ptrs: unsafe_ptr<int32>
    ): void;
    function glCompileShader(shader: uint32): void;
    function glGetShaderiv(shader: uint32, pname: uint32, params: unsafe_ptr<int32>): void;
    function glGetShaderInfoLog(
        shader: uint32,
        max_len: int32,
        length_out: unsafe_ptr<int32>,
        log_out: unsafe_ptr<uint8>
    ): void;
    function glDeleteShader(shader: uint32): void;

    function glCreateProgram(): uint32;
    function glAttachShader(program: uint32, shader: uint32): void;
    function glLinkProgram(program: uint32): void;
    function glGetProgramiv(program: uint32, pname: uint32, params: unsafe_ptr<int32>): void;
    function glGetProgramInfoLog(
        program: uint32,
        max_len: int32,
        length_out: unsafe_ptr<int32>,
        log_out: unsafe_ptr<uint8>
    ): void;
    function glUseProgram(program: uint32): void;
    function glDeleteProgram(program: uint32): void;
    function glBindFragDataLocation(program: uint32, color_number: uint32, name: string): void;
    function glBindAttribLocation(program: uint32, index: uint32, name: string): void;

    function glGenVertexArrays(n: int32, arrays: unsafe_ptr<uint32>): void;
    function glBindVertexArray(array: uint32): void;
    function glDeleteVertexArrays(n: int32, arrays: unsafe_ptr<uint32>): void;
    function glGenBuffers(n: int32, buffers: unsafe_ptr<uint32>): void;
    function glBindBuffer(target: uint32, buffer: uint32): void;
    function glBufferData(target: uint32, size: int64, data: unsafe_ptr<uint8>, usage: uint32): void;
    function glDeleteBuffers(n: int32, buffers: unsafe_ptr<uint32>): void;
    function glVertexAttribPointer(
        index: uint32,
        size: int32,
        elem_type: uint32,
        normalized: uint8,
        stride: int32,
