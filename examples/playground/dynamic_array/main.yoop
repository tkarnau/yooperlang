// Safe, generic dynamic array.
//
//   - `DynArray<T> implements Disposable propagates<usedisposable>`:
//     the type itself is the disposable thing, and its `propagates<usedisposable>`
//     clause says: every binding of `DynArray<T>` carries the dispose obligation
//     and must either fulfil it or pass it on. There is no way to use a value
//     of this type that silently leaks the obligation.
//   - `new_dynarray<T>(...): DynArray<T> propagates<usedisposable>`:
//     factory that pushes the obligation through its return type to the caller.
//     The function must declare `propagates<usedisposable>`, otherwise the
//     return is rejected — a helper that creates a DynArray either disposes
//     it locally or hands the dispose obligation up to its caller.
//   - At a call site (main) the binding's `usedisposable` keyword opts into
//     auto-cleanup: the compiler injects `Disposable.dispose(ref arr)` at
//     scope end. A plain `let arr: DynArray<int32> = ...` is also legal but
//     then the user must either call `Disposable.dispose(ref arr)` manually
//     or return `arr` from a function that propagates `usedisposable`.
//
// Try dropping `propagates<usedisposable>` from `new_dynarray` and the compiler
// will reject the return: the kind's obligation has nowhere to go. Try dropping
// the `usedisposable` keyword on `arr` in main without adding a manual dispose
// call, and the compiler will reject the binding for an unsatisfied obligation.

/*
    This demonstrates a dynamic array implementation for yooperlang


*/

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type Maybe {
    err: string,
}

trait Disposable {
    function dispose(ref self): Maybe;
}


kind usedisposable {
    appliesTo binding;
    requires Disposable;
    ownsBlock;
    mustCall dispose beforeScopeEnd;
}

// The generic struct *is* the Disposable. `propagates<usedisposable>` says
// "every binding of me inherits the dispose obligation."
type DynArray<T> implements Disposable propagates<usedisposable> {
    data: T[],
    len: usize,
    cap: usize,
    isDisposed: bool,

    function dispose(ref self): Maybe {
        if (self.isDisposed) {
            return { err: "already disposed" };
        }
        self.isDisposed = true;
        printf(`(dispose: freeing DynArray, len=${self.len} cap=${self.cap})\n`);
        heap_free(self.data);
        return { err: "" };
    }
}

// Factory. `propagates<usedisposable>` on the return type transfers the
// dispose obligation to the caller. The local `newArr` does NOT declare the
// kind keyword — the function's propagates clause is what allows it to escape
// via return without local discharge. Adding `usedisposable` here would mean
// "I'll dispose this locally", which contradicts returning it.
function new_dynarray<T>(initial_cap: usize): DynArray<T> propagates<usedisposable> {
    let newArr: DynArray<T> = { data: heap_alloc(initial_cap), len: 0, cap: initial_cap, isDisposed: false };

    return newArr;
}

function push<T>(a: ref DynArray<T>, value: T): void {
    if (a.len >= a.cap) {
        let new_cap: usize = a.cap * 2;
        let new_data: T[] = heap_alloc(new_cap);
        let i: usize = 0;
        while (i < a.len) {
            new_data[i] = a.data[i];
            i = i + 1;
        }
        printf(`growing capacity of array to ${new_cap}\n`);
        heap_free(a.data);
        a.data = new_data;
        a.cap = new_cap;
    }
    a.data[a.len] = value;
    a.len = a.len + 1;
}

function get<T>(a: ref DynArray<T>, i: usize): T {
    return a.data[i];
}

function main(): int32 {
    // `usedisposable` opts into auto-cleanup at scope end. The compiler
    // injects `Disposable.dispose(ref arr)` before this function returns.
    usedisposable arr: DynArray<int32> = new_dynarray(4) {
        // Force two grow passes (4 -> 8 -> 16).
        let i: int32 = 0;
        while (i < 10) {
            push(ref arr, i * i);
            i = i + 1;
        }
        
        printf(`len=${arr.len} cap=${arr.cap}\n`);
        let j: usize = 0;
        while (j < arr.len) {
            printf(`arr[${j}]=${get(ref arr, j)}\n`);
            j = j + 1;
        }
        const disposeResult: Maybe = Disposable.dispose(ref arr);
        if (disposeResult.err.len > 0) {
            printf(`disposal failure: err${disposeResult.err}\n`);
        }
    
        const disposeResult2: Maybe = Disposable.dispose(ref arr);
        if (disposeResult2.err.len > 0) {
            printf(`disposal2 failure: ${disposeResult2.err}\n`);
        }
    }

    // Manual discharge route: plain `let` of a propagating type is fine if
    // the user satisfies the obligation themselves at the same conditional
    // depth as the binding. Hiding the call inside an `if`/`while`/etc. does
    // NOT satisfy it — that path is conditional, the obligation is not.
    let arr2: DynArray<int32> = new_dynarray(4);
    if (2 > 1) {
        const r1: Maybe = Disposable.dispose(ref arr2);
        if (r1.err.len > 0) {
            printf(`disposal of arr2 failed (then): ${r1.err}\n`);
        }
    } else {
        const r2: Maybe = Disposable.dispose(ref arr2);
        if (r2.err.len > 0) {
            printf(`disposal of arr2 failed (else): ${r2.err}\n`);
        }
    }

    // The compiler emits `Disposable.dispose(ref arr)` right here, before return.
    return 0;
}
