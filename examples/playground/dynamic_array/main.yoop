// Safe, generic dynamic array.
//
// Ownership redesign (2026-06-17, plans/ownership-and-typestate-redesign.md):
// `propagates<disposable>` is ADVISORY guidance, not an enforced contract. The
// compiler does not error on an undisposed binding or an undeclared return.
//
//   - `DynArray<T> implements Disposable propagates<disposable>`:
//     the type is the disposable thing; the `propagates<disposable>` clause
//     documents (for readers and tooling) that every binding of `DynArray<T>`
//     carries a dispose obligation. It is a hint, not a gate.
//   - `new_dynarray<T>(...): DynArray<T> propagates<disposable>`:
//     factory whose return clause advertises that the result owns a resource.
//     The clause is optional - omitting it no longer rejects the return.
//   - At a call site (main) the binding's `disposable` keyword is the one
//     piece with teeth: it opts into auto-cleanup, so the compiler injects
//     `Disposable.dispose(ref arr)` at scope end. A plain `let arr: ... = ...`
//     is equally legal and silent - then it is on you to dispose it (or not).
//
// Avoiding double-free is the dispose implementer's job, not the compiler's:
// note how `dispose` below guards on `isDisposed` and is safe to call twice.
// That idempotency convention is what the advisory model relies on.

import * as intr from "std/core/intrinsics.yoop";

/*
    This demonstrates a dynamic array implementation for yooperlang


*/

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type Maybe {
    err: string,
}

trait Disposable {
    function dispose(ref self): Maybe;
}


kind disposable {
    appliesTo binding;
    requires Disposable;
    ownsBlock;
    mustCall dispose beforeScopeEnd;
}

// The generic struct *is* the Disposable. `propagates<disposable>` says
// "every binding of me inherits the dispose obligation."
type DynArray<T> implements Disposable propagates<disposable> {
    data: T[],
    len: usize,
    cap: usize,
    isDisposed: bool,

    function dispose(ref self): Maybe {
        if (self.isDisposed) {
            return { err: "already disposed" };
        }
        self.isDisposed = true;
        printf(`(dispose: freeing DynArray, len=${self.len} cap=${self.cap})\n`);
        intr.heap_free(self.data);
        return { err: "" };
    }
}

// Factory. The `propagates<disposable>` return clause advertises that the
// result owns a resource (advisory only). The local `newArr` is a plain `let`
// and is simply moved out via return. Adding `disposable` here would opt into
// local auto-cleanup, which would contradict returning it.
function new_dynarray<T>(initial_cap: usize): DynArray<T> propagates<disposable> {
    let newArr: DynArray<T> = { data: intr.heap_alloc(initial_cap), len: 0, cap: initial_cap, isDisposed: false };

    return newArr;
}

function push<T>(a: ref DynArray<T>, value: T): void {
    if (a.len >= a.cap) {
        let new_cap: usize = a.cap * 2;
        let new_data: T[] = intr.heap_alloc(new_cap);
        let i: usize = 0;
        while (i < a.len) {
            new_data[i] = a.data[i];
            i = i + 1;
        }
        printf(`growing capacity of array to ${new_cap}\n`);
        intr.heap_free(a.data);
        a.data = new_data;
        a.cap = new_cap;
    }
    a.data[a.len] = value;
    a.len = a.len + 1;
}

function get<T>(a: ref DynArray<T>, i: usize): T {
    return a.data[i];
}

function main(): int32 {
    // `disposable` opts into auto-cleanup at scope end. The compiler
    // injects `Disposable.dispose(ref arr)` before this function returns.
    disposable arr: DynArray<int32> = new_dynarray(4) {
        // Force two grow passes (4 -> 8 -> 16).
        let i: int32 = 0;
        while (i < 10) {
            push(ref arr, i * i);
            i = i + 1;
        }
        
        printf(`len=${arr.len} cap=${arr.cap}\n`);
        let j: usize = 0;
        while (j < arr.len) {
            printf(`arr[${j}]=${get(ref arr, j)}\n`);
            j = j + 1;
        }
        const disposeResult: Maybe = Disposable.dispose(ref arr);
        if (disposeResult.err.len > 0) {
            printf(`disposal failure: err${disposeResult.err}\n`);
        }
    
        const disposeResult2: Maybe = Disposable.dispose(ref arr);
        if (disposeResult2.err.len > 0) {
            printf(`disposal2 failure: ${disposeResult2.err}\n`);
        }
    }

    // Manual discharge route: plain `let` of a propagating type is fine if
    // the user satisfies the obligation themselves at the same conditional
    // depth as the binding. Hiding the call inside an `if`/`while`/etc. does
    // NOT satisfy it - that path is conditional, the obligation is not.
    let arr2: DynArray<int32> = new_dynarray(4);
    if (2 % 1 > 0) {
        const r1: Maybe = Disposable.dispose(ref arr2);
        if (r1.err.len > 0) {
            printf(`disposal of arr2 failed (then): ${r1.err}\n`);
        }
    } else {
        const r2: Maybe = Disposable.dispose(ref arr2);
        if (r2.err.len > 0) {
            printf(`disposal of arr2 failed (else): ${r2.err}\n`);
        }
    }

    // The compiler emits `Disposable.dispose(ref arr)` right here, before return.
    return 0;
}
