import { Ball, Steppable } from "./physics.yoop";

// SDL2 bouncing-balls demo -- three neon balls arc around a dark window,
// each cycling through a different phase of the colour wheel.
//
// Showcases:
//   - C FFI declarations and library linking
//   - float32/float64 arithmetic, uint8 casts for colour channels
//   - Cross-module Ball type and physics from physics.yoop
//   - sin/sqrt from libm for colour cycling and circle scanlines
//   - Traits: Ball implements Steppable, Window/Renderer implement Disposable
//   - Kinds: `disposable` bindings drop the SDL handles automatically (LIFO)
//     so SDL_DestroyRenderer / SDL_DestroyWindow are never called by hand.


// ── Math ─────────────────────────────────────────────────────────────────────

extern "C" from library "m" {
    function sin(x: float64): float64;
    function sqrt(x: float64): float64;
    function printf(fmt: string, ...): int32;
}

// ── SDL2 ──────────────────────────────────────────────────────────────────────

extern "C" from library "SDL2" {
    // Opaque SDL handle types; only ever used via ref in this file.
    type SDL_Window;
    type SDL_Renderer;

    function SDL_Init(flags: uint32): int32;
    function SDL_Quit(): void;

    function SDL_GetKeyboardState(ref numKeys: int): uint8[];

    function SDL_CreateWindow(
        title: string,
        x: int32, y: int32,
        w: int32, h: int32,
        flags: uint32
    ): ref SDL_Window;
    function SDL_DestroyWindow(ref win: SDL_Window): void;

    function SDL_CreateRenderer(
        ref win: SDL_Window,
        index: int32,
        flags: uint32
    ): ref SDL_Renderer;
    function SDL_DestroyRenderer(ref ren: SDL_Renderer): void;

    function SDL_SetRenderDrawColor(
        ref ren: SDL_Renderer,
        r: uint8, g: uint8, b: uint8, a: uint8
    ): int32;
    function SDL_RenderClear(ref ren: SDL_Renderer): int32;
    function SDL_RenderPresent(ref ren: SDL_Renderer): void;

    // Draw a single horizontal span -- used to scanline-fill circles.
    function SDL_RenderDrawLine(
        ref ren: SDL_Renderer,
        x1: int32, y1: int32,
        x2: int32, y2: int32
    ): int32;

    function SDL_GetTicks(): uint32;
    function SDL_Delay(ms: uint32): void;
    // On macOS, Cocoa's run loop doesn't advance unless this is called
    // each frame -- without it the window stays invisible even after
    // CreateWindow + RenderPresent succeed.
    function SDL_PumpEvents(): void;
}

// ── Resource RAII via traits + kinds ────────────────────────────────────────

// Anything that can be deterministically cleaned up at scope end.
trait Disposable {
    function dispose(ref self): void;
}

// Thin yoop-side wrapper around the opaque C handle. Holding the handle in
// a struct field lets it be tracked by the `disposable` kind below; the
// dispose method forwards to the SDL destructor.
type Window implements Disposable {
    handle: ref SDL_Window,
    function dispose(ref self): void {
        SDL_DestroyWindow(self.handle);
        printf("Destroyed window handle\n");
    }
}

type Renderer implements Disposable {
    handle: ref SDL_Renderer,
    function dispose(ref self): void {
        SDL_DestroyRenderer(self.handle);
        printf("Destroyed renderer handle\n");
    }
}

// `disposable x: T = ...` requires T implements Disposable and emits a call
// to `dispose(ref x)` at scope end (in LIFO order across multiple bindings).
kind disposable {
    appliesTo binding;
    requires Disposable;
    ownsBlock;
    mustCall dispose beforeScopeEnd;
}

// ── Colour helpers ────────────────────────────────────────────────────────────

// Map one channel of a sine-based colour wheel (hue in radians, offset in radians)
// to a [0, 255] byte.  Three calls with offsets 0, 2π/3, 4π/3 give smooth RGB.
function channel(hue: float32, phase_offset: float32): uint8 {
    const v: float64 = sin(float64(hue) + float64(phase_offset)) * 0.5 + 0.5;
    return uint8(int32(v * 255.0));
}

type Channels {
    // little endian
    a: uint8,
    b: uint8,
    g: uint8,
    r: uint8,
}

union Color {
    rgba: uint32,
    channels: Channels,
}

// ── Entry point ───────────────────────────────────────────────────────────────

function main(): int32 {
    // ── Constants ─────────────────────────────────────────────────────────────────

    const WIN_W: int32 = 800;
    const WIN_H: int32 = 600;
    const FPS_TARGET: uint32 = 60;
    const MS_PER_FRAME: uint32 = 1000 / FPS_TARGET;
    const DURATION_MS: uint32 = 8000;

    const SDL_SCANCODE_ESCAPE: int32 = 41;
    const SDL_SCANCODE_W: int32 = 26;
    const SDL_SCANCODE_A: int32 = 4;
    const SDL_SCANCODE_S: int32 = 22;
    const SDL_SCANCODE_D: int32 = 7;

    const PLAYER_SIZE: float32 = 24.0;
    const PLAYER_SPEED: float32 = 0.3;

    // SDL_Init flags
    const SDL_INIT_VIDEO: uint32 = 0x00000020;

    // SDL_CreateWindow position / flags
    const SDL_WINDOWPOS_CENTERED: int32 = 0x2FFF0000;
    const SDL_WINDOW_SHOWN: uint32 = 0x00000004;

    // SDL_CreateRenderer flags
    const SDL_RENDERER_ACCELERATED: uint32 = 0x00000002;
    const SDL_RENDERER_PRESENTVSYNC: uint32 = 0x00000004;

    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        printf("SDL_Init failed\n");
        return 1;
    }

    // SDL handles wrapped so the `disposable` kind handles destruction
    // automatically at function exit -- ren first, then win (LIFO).
    disposable win: Window = {
        handle: SDL_CreateWindow(
            "yooperlang SDL2 demo",
            SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
            WIN_W, WIN_H,
            SDL_WINDOW_SHOWN
        )
    } {
        disposable ren: Renderer = {
            handle: SDL_CreateRenderer(
                win.handle, -1,
                SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC
            )
        };

        // Three balls, staggered positions and velocities so they never overlap
        // at t=0.  Hue offsets spread them evenly around the colour wheel (2π/3
        // radians apart).
        let b1: Ball = { x: 200.0, y: 150.0, vx:  0.22, vy:  0.17, radius: 42.0, hue: 0.0 };
        let b2: Ball = { x: 400.0, y: 400.0, vx: -0.19, vy:  0.25, radius: 36.0, hue: 2.094 };
        let b3: Ball = { x: 620.0, y: 250.0, vx:  0.15, vy: -0.21, radius: 50.0, hue: 4.189 };

        // WASD-controlled player square. Position is the top-left corner.
        let player_x: float32 = float32(WIN_W) * 0.5 - PLAYER_SIZE * 0.5;
        let player_y: float32 = float32(WIN_H) * 0.5 - PLAYER_SIZE * 0.5;

        const start: uint32 = SDL_GetTicks();

        while (SDL_GetTicks() > 0/*  - start < DURATION_MS */) {
            const frame_start: uint32 = SDL_GetTicks();

            let kbRef: int = 0;
            const keyboardState: uint8[] = SDL_GetKeyboardState(ref kbRef);
            if (keyboardState[SDL_SCANCODE_ESCAPE] != 0) {
                break;
            }

            // Pump the Cocoa event loop so the window stays responsive (and on
            // macOS, so it actually appears at all -- without this the window
            // is created but never composited).
            SDL_PumpEvents();

            // Physics via the Steppable trait -- in-place mutation through `ref`.
            const dt: float32 = float32(MS_PER_FRAME);
            Steppable.step(ref b1, dt, float32(WIN_W), float32(WIN_H));
            Steppable.step(ref b2, dt, float32(WIN_W), float32(WIN_H));
            Steppable.step(ref b3, dt, float32(WIN_W), float32(WIN_H));

            // WASD movement, then clamp to window.
            const move: float32 = PLAYER_SPEED * dt;
            if (keyboardState[SDL_SCANCODE_W] != 0) { player_y = player_y - move; }
            if (keyboardState[SDL_SCANCODE_S] != 0) { player_y = player_y + move; }
            if (keyboardState[SDL_SCANCODE_A] != 0) { player_x = player_x - move; }
            if (keyboardState[SDL_SCANCODE_D] != 0) { player_x = player_x + move; }
            if (player_x < 0.0) { player_x = 0.0; }
            if (player_y < 0.0) { player_y = 0.0; }
            if (player_x + PLAYER_SIZE > float32(WIN_W)) { player_x = float32(WIN_W) - PLAYER_SIZE; }
            if (player_y + PLAYER_SIZE > float32(WIN_H)) { player_y = float32(WIN_H) - PLAYER_SIZE; }

            // Clear to near-black background.
            const bg: Color = { rgba: 0x770F1455 };
            SDL_SetRenderDrawColor(ren.handle, bg.channels.r, bg.channels.g, bg.channels.b, bg.channels.a);
            SDL_RenderClear(ren.handle);

            // Draw ball 1 -- colour based on its hue.
            SDL_SetRenderDrawColor(
                ren.handle,
                channel(b1.hue, 0.0),
                channel(b1.hue, 2.094),
                channel(b1.hue, 4.189),
                uint8(255)
            );
            let row1: int32 = int32(-b1.radius);
            while (row1 <= int32(b1.radius)) {
                const half1: int32 = int32(sqrt(float64(b1.radius * b1.radius) - float64(float32(row1) * float32(row1))));
                SDL_RenderDrawLine(ren.handle, int32(b1.x) - half1, int32(b1.y) + row1, int32(b1.x) + half1, int32(b1.y) + row1);
                row1 = row1 + 1;
            }

            // Draw ball 2.
            SDL_SetRenderDrawColor(
                ren.handle,
                channel(b2.hue, 0.0),
                channel(b2.hue, 2.094),
                channel(b2.hue, 4.189),
                uint8(255)
            );
            let row2: int32 = int32(-b2.radius);
            while (row2 <= int32(b2.radius)) {
                const half2: int32 = int32(sqrt(float64(b2.radius * b2.radius) - float64(float32(row2) * float32(row2))));
                SDL_RenderDrawLine(ren.handle, int32(b2.x) - half2, int32(b2.y) + row2, int32(b2.x) + half2, int32(b2.y) + row2);
                row2 = row2 + 1;
            }

            // Draw ball 3.
            SDL_SetRenderDrawColor(
                ren.handle,
                channel(b3.hue, 0.0),
                channel(b3.hue, 2.094),
                channel(b3.hue, 4.189),
                uint8(255)
            );
            let row3: int32 = int32(-b3.radius);
            while (row3 <= int32(b3.radius)) {
                const half3: int32 = int32(sqrt(float64(b3.radius * b3.radius) - float64(float32(row3) * float32(row3))));
                SDL_RenderDrawLine(ren.handle, int32(b3.x) - half3, int32(b3.y) + row3, int32(b3.x) + half3, int32(b3.y) + row3);
                row3 = row3 + 1;
            }

            // Player square -- scanline fill in solid white.
            SDL_SetRenderDrawColor(ren.handle, uint8(255), uint8(255), uint8(255), uint8(255));
            const px: int32 = int32(player_x);
            const py: int32 = int32(player_y);
            const psize: int32 = int32(PLAYER_SIZE);
            let prow: int32 = 0;
            while (prow < psize) {
                SDL_RenderDrawLine(ren.handle, px, py + prow, px + psize, py + prow);
                prow = prow + 1;
            }

            SDL_RenderPresent(ren.handle);

            // Cap frame rate when vsync is not available.
            const elapsed: uint32 = SDL_GetTicks() - frame_start;
            if (elapsed < MS_PER_FRAME) {
                SDL_Delay(MS_PER_FRAME - elapsed);
            }
        }

        // No SDL_DestroyRenderer / SDL_DestroyWindow here -- the `disposable`
        // bindings handle that automatically at function exit, LIFO-ordered.
        SDL_Quit();
    }
    printf("Exiting cleanly\n");
    return 0;
}
