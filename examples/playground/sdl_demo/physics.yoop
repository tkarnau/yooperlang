// Bouncing ball physics -- pure value computation, no FFI required.
// All functions take and return Ball by value so refs are not needed.

export type Ball {
    x: float32,
    y: float32,
    vx: float32,
    vy: float32,
    radius: float32,
    hue: float32,
}

// Advance one ball by dt milliseconds, bouncing off the window edges.
export function ball_step(b: Ball, dt: float32, win_w: float32, win_h: float32): Ball {
    let nx: float32 = b.x + b.vx * dt;
    let ny: float32 = b.y + b.vy * dt;
    let nvx: float32 = b.vx;
    let nvy: float32 = b.vy;

    if (nx - b.radius < 0.0) {
        nx = b.radius;
        nvx = nvx * -1.0;
    }
    if (nx + b.radius > win_w) {
        nx = win_w - b.radius;
        nvx = nvx * -1.0;
    }
    if (ny - b.radius < 0.0) {
        ny = b.radius;
        nvy = nvy * -1.0;
    }
    if (ny + b.radius > win_h) {
        ny = win_h - b.radius;
        nvy = nvy * -1.0;
    }

    return {
        x: nx,
        y: ny,
        vx: nvx,
        vy: nvy,
        radius: b.radius,
        hue: b.hue + 0.015,
    };
}
