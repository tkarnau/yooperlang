// Bouncing ball physics. Ball implements the Steppable trait so the per-frame
// update reads as a method call on the receiver, mutating in place via
// `ref self` instead of returning a fresh Ball each frame.

export trait Steppable {
    function step(ref self, dt: float32, win_w: float32, win_h: float32): void;
}

export type Ball implements Steppable {
    x: float32,
    y: float32,
    vx: float32,
    vy: float32,
    radius: float32,
    hue: float32,

    // Advance the ball one dt-step, bouncing off the window edges.
    function step(ref self, dt: float32, win_w: float32, win_h: float32): void {
        self.x = self.x + self.vx * dt;
        self.y = self.y + self.vy * dt;

        if (self.x - self.radius < 0.0) {
            self.x = self.radius;
            self.vx = self.vx * -1.0;
        }
        if (self.x + self.radius > win_w) {
            self.x = win_w - self.radius;
            self.vx = self.vx * -1.0;
        }
        if (self.y - self.radius < 0.0) {
            self.y = self.radius;
            self.vy = self.vy * -1.0;
        }
        if (self.y + self.radius > win_h) {
            self.y = win_h - self.radius;
            self.vy = self.vy * -1.0;
        }

        self.hue = self.hue + 0.015;
    }
}
