// yoopstore/handler.yoop - StorageHandler implements the Handler trait from
// std/http/server.yoop. Dispatches GET / HEAD / PUT / POST / DELETE against
// the on-disk storage rooted at `rootDir`.
//
// Response bodies are owned: the GET path reads the file into a local Vec
// and *seals* it into the Response via bytesFromVec (a zero-copy
// hand-off), so there is no
// per-handler buffer to keep alive across the return and no copy. The
// Response disposes the bytes itself. The handler therefore owns nothing and
// doesn't need Disposable.

import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import * as vec, { Vec } from "std/core/vec.yoop";
import * as bytes from "std/core/bytes.yoop";

import { Handler, HandleOutcome } from "std/http";
import * as http, { Request, Response, HttpMethod, StatusCode } from "std/http";

import * as safepath from "./safepath.yoop";
import * as storage from "./storage.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

export type StorageHandler implements Handler {
    rootDir: string,

    async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        let san: Result<string, string> = safepath.sanitize(req.path);
        let rel: string = "";
        switch (san) {
            case Result.Ok  { value: ok }:  { rel = ok; }
            case Result.Err { error: err }: {
                respondText(ref resp, http.badRequest(), err);
                return HandleOutcome.Ok;
            }
        }

        let full: string = storage.join_path(self.rootDir, rel);

        switch (req.method) {
            case HttpMethod.Get: {
                disposable buf: Vec<uint8> = vec.vecNew(4096);
                let err: string = storage.readFileInto(ref buf, full);
                if (err.len > 0) {
                    respondText(ref resp, http.notFound(), `not found: ${rel}\n`);
                    return HandleOutcome.Ok;
                }
                let n: usize = buf.len;
                // Hand the read buffer straight to the Response (no copy);
                // `buf` is left empty, its auto-cleanup becomes a no-op.
                http.respondBytes(ref resp, http.ok(), "application/octet-stream",
                    bytes.bytesFromVec(ref buf));
                printf(`GET   /${rel} -> ${n} bytes\n`);
                return HandleOutcome.Ok;
            }
            case HttpMethod.Head: {
                // HEAD: fill Content-Length from a stat (storage.fileSize)
                // without reading or sending the body.
                let sz: int64 = storage.fileSize(full);
                if (sz < 0) {
                    respondText(ref resp, http.notFound(), `not found: ${rel}\n`);
                    return HandleOutcome.Ok;
                }
                // A HEAD reply carries the headers the GET would have. The
                // server writes Content-Length from the body it would have
                // sent, so this one is informational only.
                http.respondEmpty(ref resp, http.ok());
                http.setHeader(ref resp, "Content-Type", "application/octet-stream");
                http.setHeader(ref resp, "X-Content-Length", `${sz}`);
                printf(`HEAD  /${rel} -> ${sz} bytes\n`);
                return HandleOutcome.Ok;
            }
            case HttpMethod.Put, HttpMethod.Post: {
                return storeBody(rel, full, ref req, ref resp);
            }
            case HttpMethod.Delete: {
                let err: string = storage.deleteFile(full);
                if (err.len > 0) {
                    respondText(ref resp, http.notFound(), `not found: ${rel}\n`);
                    return HandleOutcome.Ok;
                }
                respondText(ref resp, http.ok(), `deleted /${rel}\n`);
                printf(`DEL   /${rel}\n`);
                return HandleOutcome.Ok;
            }
            default: {
                // PATCH / OPTIONS - not supported.
                respondText(ref resp, http.methodNotAllowed(), "method not allowed\n");
                return HandleOutcome.Ok;
            }
        }
    }
}

function storeBody(rel: string, full: string, ref req: Request, ref resp: Response): HandleOutcome {
    let err: string = storage.writeFile(full, req.body);
    if (err.len > 0) {
        respondText(ref resp, http.serverError(), err);
        return HandleOutcome.Ok;
    }
    respondText(ref resp, http.ok(), `stored /${rel} (${req.body.len} bytes)\n`);
    printf(`STORE /${rel} <- ${req.body.len} bytes\n`);
    return HandleOutcome.Ok;
}

// Set status + a plain-text body. `respondText` borrows the string; literals
// and template-literal results both outlive the response, so there is nothing
// for the response to free.
function respondText(ref resp: Response, code: StatusCode, msg: string): void {
    http.respondText(ref resp, code, msg);
}

export function storageHandlerNew(rootDir: string): StorageHandler {
    return { rootDir: rootDir };
}
