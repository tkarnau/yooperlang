// Phase 6.4 strict propagates: a binding of a type that propagates a mustCall
// kind cannot reach scope exit with an unsatisfied obligation, even when the
// initializer is a struct literal (no factory call involved).

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Widget implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

function main(): int32 {
    // Struct literal RHS, plain `const`, no manual dispose, no propagating
    // return - the obligation has nowhere to go.
    const w: Widget = { id: 1 };
    return 0;
}

// Fails: binding 'w' has unsatisfied obligation from propagates<disposable>
