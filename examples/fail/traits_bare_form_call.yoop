trait Disposable {
    function dispose(ref self): void;
}

type FileHandle implements Disposable {
    fd: int32,
    function dispose(ref self): void {
    }
}

function main(): int32 {
    let h: FileHandle = { fd: 7 };
    dispose(ref h);
    return 0;
}

// Trait methods cannot be called via the bare-form
// `dispose(ref h)`. The typechecker rejects the call with a hint pointing at
// the qualified form `Disposable.dispose(ref h)`.
