// Yoopstore-papercut #3: assigning a bare `unsafe_ptr` to an
// `unsafe_ptr<T>` requires an explicit `unsafe_ptr.cast<T>(p)` -
// otherwise the user would be silently claiming a pointee type
// the source pointer doesn't carry.

import.unsafe;

function main(): int32 {
    let x: int32 = 7;
    let typed: unsafe_ptr<int32> = &x;
    let opaque: unsafe_ptr = typed;
    let back: unsafe_ptr<int32> = opaque;
    return *back;
}
