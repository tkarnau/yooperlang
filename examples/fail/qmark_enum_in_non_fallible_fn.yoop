// Phase 9.H: `?` on a fallible enum is only legal inside a function whose
// return type is also a fallible enum with the same Err payload.

variant IntResult {
    Ok { value: int32 },
    Err { error: int32 },
}

function fail(): IntResult {
    return IntResult.Err { error: 1 };
}

function main(): int32 {
    let x: int32 = fail()?;
    return x;
}

// expected error: '?' on enum enum IntResult requires the enclosing function to return a fallible enum
