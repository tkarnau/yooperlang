// A string-backed value enum cannot be a switch scrutinee: switch lowers to
// the LLVM `switch` instruction, whose condition must be an integer. The
// typechecker rejects this up front rather than letting it emit `switch ptr`
// IR that clang chokes on. Use if/else with == for string-backed enums.
enum Dir<string> {
    Asc "ASC",
    Desc "DESC",
}

function pick(d: Dir): int32 {
    switch (d) {
        case Dir.Asc: { return 1; }
        case Dir.Desc: { return 2; }
    }
    return 0;
}

function main(): int32 {
    return pick(Dir.Asc);
}
