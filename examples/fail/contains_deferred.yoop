trait Disposable {
    function dispose(ref self): void;
}

type FileHandle implements Disposable {
    fd: int32,
    function dispose(ref self): void {}
}

kind disposable {
    appliesTo binding field;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type S contains<disposable> {
    f: disposable FileHandle,
}

function main(): int32 {
    return 0;
}

// Fails: contains not yet supported (phase 6.5 or later)
