// Phase 6.4 path coverage: a dispose call in only ONE arm of an if/else does
// not satisfy the obligation — the other path still leaks. The mirror-image
// pass test (`examples/pass/propagates_dispose_both_branches.yoop`) has
// dispose in both arms and compiles cleanly.

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Resource implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

function make_resource(): Resource propagates<disposable> {
    return { id: 7 };
}

function main(): int32 {
    let r: Resource = make_resource();
    if (2 > 1) {
        Disposable.dispose(ref r);
    } else {
        // missing dispose — `r` leaks down this path
    }
    return 0;
}

// Fails: binding 'r' has unsatisfied obligation from propagates<disposable>
