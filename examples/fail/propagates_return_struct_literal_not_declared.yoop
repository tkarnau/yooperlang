// Yoopstore-papercut #11 (negative): returning a struct literal that moves a
// propagating binding into a field still requires the enclosing function to
// declare propagates<K>. Without it, the obligation has nowhere to go.

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Inner implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

type Outer implements Disposable propagates<disposable> {
    inner: Inner,
    function dispose(ref self): void {
        Disposable.dispose(ref self.inner);
    }
}

// Missing propagates<disposable> on the return - should be an error.
function make_outer(): Outer {
    let inner: Inner = { id: 1 };
    return { inner: inner };
}

function main(): int32 {
    return 0;
}

// Fails: function returns a value of type Outer carrying propagates<disposable>
