// Phase 6.4 strict propagates: a function that returns a value whose type
// propagates a kind with mustCall obligations must declare propagates<K> on
// its own return type. Without it, the obligation is silently dropped.

trait Disposable {
    function dispose(ref self): void;
}

kind usedisposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Widget implements Disposable propagates<usedisposable> {
    id: int32,
    function dispose(ref self): void {}
}

// Missing propagates<usedisposable> on the return type — should be an error.
function make_widget(): Widget {
    return { id: 1 };
}

function main(): int32 {
    return 0;
}

// Fails: function returns a value of type Widget carrying propagates<usedisposable>
