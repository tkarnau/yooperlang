// The syntax error is in lib.yoop (a missing semicolon), NOT here. The driver
// used to render every parse error against the ENTRY file, so this printed
// main.yoop's source with a caret at lib.yoop's offsets - pointing at unrelated
// code in the wrong file.
import * as lib from "./lib.yoop";

function main(): int32 {
    return lib.ok();
}
