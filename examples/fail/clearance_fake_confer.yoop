// Clearance kinds: only an impl method of the kind's `requires` trait may
// confer a conferred kind. A free function returning the conferred form is
// NOT authorized - the trait is the structural gate.

trait Cleansable<T> {
    function cleanse(ref self): T;
}

kind cleared {
    appliesTo binding parameter field return;
    conferred;
    requires Cleansable;
    appliedBy cleanse;
}

type SafeText implements Cleansable<SafeText> {
    body: string,
    function cleanse(ref self): SafeText {
        return { body: "safe" };
    }
}

// A free function whose return claims to confer `cleared`. Rejected at the
// function decl: free functions cannot confer, only trait impl methods can.
function fake_confer(s: SafeText): cleared SafeText {
    return s;
}

function main(): int32 { return 0; }
