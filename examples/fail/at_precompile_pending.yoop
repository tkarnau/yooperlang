// Phase 11.A: `@precompile` parses + typechecks fine, but the
// attribute pass surfaces a "comptime engine not yet implemented"
// error until the interpreter lands in Phase 11.C. This fixture
// exists to verify the integration point fires; once 11.C ships,
// the expected error message changes (and this fixture either
// moves or is replaced by a passing equivalent).

@precompile {
    let x: int32 = 1 + 2;
}

function main(): int32 { return 0; }
