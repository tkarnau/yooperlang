trait Disposable {
    function dispose(ref self): void;
}

type FileHandle implements Disposable {
    fd: int32,
    function dispose(ref self): void {
    }
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

function main(): int32 {
    disposable a: FileHandle = { fd: 1 } {
        return 0;
    }
    return 0;
}

// Fails because the kind `disposable` does not declare `ownsBlock`, but the
// binding uses the trailing-block form. Trailing blocks require the kind to
// opt-in via the `ownsBlock` clause.
