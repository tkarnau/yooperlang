extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

trait Disposable {
    function dispose(ref self): void;
}

type FileHandle implements Disposable {
    fd: int32,
    function dispose(ref self): void {
        printf(`disposing fd=${self.fd}\n`);
    }
}

kind paramOnly {
    appliesTo parameter;
    requires Disposable;
    mustNotEscape scope;
}

function main(): int32 {
    paramOnly a: FileHandle = { fd: 1 };
    return 0;
}

// Fails: kind 'paramOnly' does not apply to bindings (declared appliesTo: parameter)
