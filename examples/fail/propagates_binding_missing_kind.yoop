// Phase 6.4 strict propagates: a binding of a type that propagates a mustCall
// kind reaches scope exit with an unsatisfied obligation if the user neither
// declares the kind keyword (for auto-cleanup), nor calls the cleanup method
// manually, nor returns the binding through a propagating function.

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Widget implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

function make_widget(): Widget propagates<disposable> {
    return { id: 1 };
}

function main(): int32 {
    // `let` is fine syntactically, but `main` doesn't propagate the kind and
    // `w` is never disposed manually - so the obligation is unsatisfied at
    // scope end. Fix: add `disposable` for auto-cleanup, OR add an
    // explicit `Disposable.dispose(ref w);` before returning.
    let w: Widget = make_widget();
    return 0;
}

// Fails: binding 'w' has unsatisfied obligation from propagates<disposable>
