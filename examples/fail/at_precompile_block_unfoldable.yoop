// A `@precompile { ... }` block that hits a
// non-whitelisted extern at fold time surfaces as a hard build
// error - same policy as the init form (`@precompile const X = ...`).
// The user's explicit `@precompile` is a commitment that the
// effects of the block must be fully computable at comptime; a
// silent fallback to runtime evaluation would defeat that contract.

extern "C" from "stdlib.h" {
    function getenv(name: string): string;
}

let HOME: string = "<unset>";

@precompile {
    // getenv isn't on the comptime extern whitelist (it would read
    // process environment, which is non-deterministic across
    // compiler invocations). The fold fails with a clear traceback
    // pointing at this call site.
    HOME = getenv("HOME");
}

function main(): int32 { return 0; }
