// EPISODE 6 - Generics, with bounds and without turbofish
//
// `<T>` on a function or type. Bounds use the same `implements` word as
// structs do: `<T implements Display>`, or `<T implements (A, B)>` for more
// than one. Generics monomorphize - one real machine function per concrete
// type you actually call with, no boxing, no runtime dispatch.
//
// Type arguments at call sites are always INFERRED from the arguments.
// There is no turbofish. If inference cannot get there, that is a compile
// error asking you to restructure, not a syntax you reach for.

import { Display } from "std/core/traits.yoop";

// Unbounded: works for any T because it only moves the value around.
function identity<T>(x: T): T {
    return x;
}

// Bounded: the body may only use what the bound guarantees.
function describe<T implements Display>(ref x: T): string {
    return `[${Display.toString(ref x)}]`;
}

// Generic struct. `Box<int32>` and `Box<Tag>` are separate concrete types.
type Box<T> {
    item: T,
}

@derive(display)
type Tag {
    label: string,
    n: int32,
}

function unwrap<T>(ref b: Box<T>): T {
    return b.item;
}

function main(): int32 {
    // T inferred as int32 from the argument's type. Note the binding is
    // typed first - see BREAK IT #2 for why a bare `42` does not work.
    const n: int32 = 42;
    printf(`identity(n) = ${identity(n)}\n`);

    // T inferred as Tag; the Display bound is satisfied by @derive(display).
    let t: Tag = { label: "north", n: 7 };
    printf(`describe = ${describe(ref t)}\n`);

    // Generic struct, two different instantiations, two different machine types.
    let bi: Box<int32> = { item: 99 };
    let bt: Box<Tag> = { item: { label: "south", n: 3 } };

    printf(`box of int = ${unwrap(ref bi)}\n`);

    const inner = unwrap(ref bt);
    printf(`box of tag = ${inner}\n`);

    return 0;
}

// expected output:
// identity(n) = 42
// describe = [Tag { label: north, n: 7 }]
// box of int = 99
// box of tag = Tag { label: south, n: 3 }

// ---------------------------------------------------------------------------
// BREAK IT #1 - the bound is checked at the call site, and it names the gap
//
// Add a type with no Display impl and pass it to `describe`:
//
//     type Plain { n: int32 }
//     // ...in main:
//     let pl: Plain = { n: 1 };
//     printf(`${describe(ref pl)}\n`);
//
//   ep06_generics.yoop:8:24: call to "describe": type argument "T" = struct Plain
//     does not satisfy bound - type "Plain" does not implement trait "Display"
//     |
//   8 |     printf(`${describe(ref pl)}\n`);
//     |                        ^
//
// Talking point: read that error out loud - it tells you the function, the
// type parameter, what it got bound to, and which trait is missing. Then fix
// it live by adding `@derive(display)` to `Plain`. One line, error gone.
// Nice short loop for video.

// BREAK IT #2 - an untyped literal does not pin a type parameter
//
// This is the one that will bite a viewer first. Change the call to pass the
// literal directly: `${identity(42)}`
//
//   ep06_generics.yoop:41:39: cannot infer type argument "T" for generic function "identity"
//     |
//  41 |     printf(`identity(42) = ${identity(42)}\n`);
//     |                                       ^
//
// Talking point: `42` is an *untyped* int literal - it has no type yet, it
// gets pinned by context (to int32 by default, or to usize/int64 if something
// demands that). Deliberately, that pinning does NOT happen against a type
// parameter, because then `identity(42)` would silently mint `T = int32` and
// the defaulting rule would be making a generic instantiation decision for
// you. So the literal has to land somewhere concrete first. That is why the
// example writes `const n: int32 = 42;` and passes `n`.
//
// This is a genuinely arguable design call - good spot to say "here is the
// tradeoff, tell me if you think I got it wrong."

// BREAK IT #3 - no turbofish, on purpose
//
// Now try to force it the way you would in Rust: `identity<int32>(42)`.
//
// `<` in expression position is still the less-than operator, so this does not
// parse as a type application at all. There is no `::<>` either.
//
// Talking point: this is a real tradeoff, not a win. It keeps the parser's
// lookahead shallow (no unbounded scan to decide whether `<` opens a type
// argument list), and it costs you the ability to disambiguate by hand. When
// inference cannot determine a parameter you get an explicit error telling you
// which one - and the workaround is an annotation on the binding or an extra
// argument, not a turbofish.

// BREAK IT #4 - monomorphization is real, show the symbols
//
// Compile with `--keep-ir`, then grep the emitted LLVM for the instantiations:
//
//   node ./src/yoopiler.js --keep-ir examples/tour/ep06_generics.yoop
//   grep '^define.*unwrap' /path/it/printed/yooper_out.ll
//
// You will see two separate `define`s - one per concrete T, mangled with the
// type argument. Good visual for "generics are a compile-time feature here".
