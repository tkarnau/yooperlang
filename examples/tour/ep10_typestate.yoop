// EPISODE 10 - Typestate: kinds that carry no code at all
//
// Episode 8's kinds injected calls. These do not. A MARKER kind is a purely
// static tag that rides along in the type system - no runtime cost, no
// codegen, nothing in the binary. It exists only to make certain programs
// fail to compile.
//
// Two polarities:
//
//   restrictive - a HAZARD. A plain slot FORBIDS it. It cannot be silently
//                 dropped; it has to be explicitly stripped.
//   conferred   - a CAPABILITY. A slot that names it REQUIRES it. It cannot
//                 be forged; it has to be explicitly granted.
//
// The classic use is taint tracking. `tainted` on user input, `cleared` on
// what a dangerous sink demands, and the compiler proves every path from
// source to sink goes through a sanitizer.
//
// And here is the part that is genuinely hard to get elsewhere: the AUTHORITY
// to perform the transition is a trait impl. Not a signature shape. See the
// bottom of the file.

// The trait that mediates the transition. Ordinary generic trait, plain
// signature. Nothing about it says "sanitizer" - the kind declarations below
// are what assign it that role.
trait Cleansable<T> {
    function cleanse(ref self): T;
}

kind tainted {
    appliesTo binding parameter field return;
    restrictive;                 // a hazard: plain slots forbid it
    requires Cleansable;         // only Cleansable impls may touch it
    clearedBy cleanse;           // ...and only via this method
}

kind cleared {
    appliesTo binding parameter field return;
    conferred;                   // a capability: sinks demand it
    requires Cleansable;
    appliedBy cleanse;           // ...granted only by this method
}

// A type opts in to being launderable by implementing the trait.
type Query implements Cleansable<Query> {
    sql: string,
    function cleanse(ref self): Query {
        // The real thing would escape/parameterize. Point is that THIS
        // function is the only authorized place for the transition.
        return { sql: "SELECT 1 -- sanitized" };
    }
}

// A source. Its return type declares the hazard, so everything downstream
// inherits it until something strips it.
function fromRequest(): tainted Query {
    return { sql: "'; DROP TABLE towns; --" };
}

// A sink. Its parameter demands the capability, so it is unreachable from
// unsanitized input.
function execute(q: cleared Query): void {
    printf(`executing: ${q.sql}\n`);
}

function main(): int32 {
    // The hazard propagates into the binding.
    let dirty: tainted Query = fromRequest();
    printf(`raw input: ${dirty.sql}\n`);

    // The authorized transition. Trait-qualified, like every method call.
    let safe: cleared Query = Cleansable.cleanse(ref dirty);

    // Now the sink accepts it.
    execute(safe);

    return 0;
}

// expected output:
// raw input: '; DROP TABLE towns; --
// executing: SELECT 1 -- sanitized

// ---------------------------------------------------------------------------
// BREAK IT #1 - the sink refuses unsanitized input (TWO errors, both useful)
//
// Skip the cleanse. Change the sink call to `execute(dirty);`
//
//   ep10_typestate.yoop:75:19: parameter 'q' of 'execute' requires kind
//     'cleared' but the value does not carry it; obtain it from a function
//     whose return type declares 'cleared'
//   ep10_typestate.yoop:75:19: parameter 'q' of 'execute' forbids kind
//     'tainted' but the value carries it; pass it through a function that
//     accepts 'tainted' and returns without it
//
// Talking point: you get BOTH polarities reported, because they are genuinely
// two different problems. The value is missing something it needs AND
// carrying something it must not. Each message says how to fix that half.

// BREAK IT #2 - THE ONE TO BUILD THE EPISODE AROUND
//
// Now play the attacker. Write a function that has exactly the right shape to
// launder - takes tainted, returns clean - but does something else entirely:
//
//     function fakeClear(t: tainted Query): Query {
//         printf(`exfiltrating: ${t.sql}\n`);   // <-- the actual attack
//         return { sql: t.sql };                 // <-- nothing sanitized
//     }
//
// In a type system where the SIGNATURE authorizes the transition, that
// compiles and the whole scheme is theater. Here:
//
//   ep10_typestate.yoop:66:19: function 'fakeClear' would strip kind 'tainted',
//     but only an impl method of trait 'Cleansable' (kind 'tainted's
//     'clearedBy cleanse') may do so; a free function is not authorized
//     |
//  66 | function fakeClear(t: tainted Query): Query {
//     |                   ^
//
// Read that last clause out loud: "a free function is not authorized."
//
// Free functions are CATEGORICALLY rejected as launderers. Matching the shape
// proves nothing. The only way to strip `tainted` is to be a method, on a type
// that implements the trait the kind names, with the method name the kind
// names. Laundering is something you opt into by writing an impl - which is a
// visible, greppable, reviewable act.
//
// This is the difference between "the types line up" and "someone authorized
// this." Most taint systems bolted onto a language cannot say the second one.

// BREAK IT #3 - and the compiler bakes in no policy
//
// Search this file for a built-in notion of "taint", "sanitize" or "security".
// There is none. `tainted`, `cleared`, `Cleansable` and `cleanse` are all
// names YOU chose. The compiler knows: restrictive, conferred, requires,
// clearedBy, appliedBy. Five clauses.
//
// Rename them all to something else on camera - `radioactive` / `shielded`,
// `unvalidated` / `validated`, `draft` / `published` - and it keeps working.
// That is the pitch: this is a mechanism for expressing YOUR invariant, not a
// security feature someone shipped you.

// KNOWN GAP - be honest about this one
//
// Field-position sources are not wired up yet. A `tainted` struct FIELD read
// through `x.field` comes back with no markers, so the hazard is dropped.
// Parameters, returns and bindings are enforced; fields are the follow-up.
// Say so - a viewer who finds it themselves will trust the rest less.
