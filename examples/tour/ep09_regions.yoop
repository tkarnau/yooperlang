// EPISODE 9 - Region kinds: an owner with no name
//
// `disposable` (episode 8) binds a resource you hold and use. But some guards
// have no value worth naming - their whole purpose is a side effect installed
// on entry and undone on exit. An allocator scope. A pushed context. A
// transaction. An indent level.
//
// `appliesTo region` is the kind for that. You write the kind name, an
// expression, and a block. There is no binding, and you cannot refer to the
// value - which is the point.
//
//     ephemeral arenaScope(4096) {
//         ...
//     }                              // teardown fires here
//
// Under the hood it is a name-less `disposable`: the parser synthesizes an
// unspellable `$region$N` binding, and everything downstream is unchanged.

import.unsafe;
import { Disposable } from "std/core/kinds.yoop";
import { ephemeral } from "std/core/kinds.yoop";
import * as mem from "std/core/alloc.yoop";

// ---- a region kind you write yourself -------------------------------------
// Nothing std-specific here. `Indent` prints on the way in and on the way out.

let DEPTH: int32 = 0;

function pad(): void {
    let i: int32 = 0;
    while (i < DEPTH) { printf("  "); i = i + 1; }
}

type Indent implements Disposable {
    label: string,
    function dispose(ref self): void {
        DEPTH = DEPTH - 1;
        pad();
        printf(`< leave ${self.label}\n`);
    }
}

// Constructing it IS the entry side effect. That is the idiom.
function section(label: string): Indent {
    pad();
    printf(`> enter ${label}\n`);
    DEPTH = DEPTH + 1;
    return { label: label };
}

// ---- using it -------------------------------------------------------------

function nested(): void {
    ephemeral section("outer") {
        pad();
        printf("work in outer\n");

        ephemeral section("inner") {
            pad();
            printf("work in inner\n");
        }

        pad();
        printf("back in outer\n");
    }
}

// The implicit form: no block, teardown fires at the ENCLOSING scope end,
// LIFO. Handy when the guard should cover the rest of the function.
function implicitForm(): void {
    ephemeral section("whole function");
    pad();
    printf("everything here is inside the region\n");
}

// ---- the real payoff: an arena --------------------------------------------
// `allocatorScope(arena)` installs an arena as the ambient allocator on entry
// and pops it on exit. Every allocation inside the block draws from the arena,
// and the whole region is reclaimed in one move. No per-object free.
//
// The arena itself stays an ordinary named value, so we can ask it questions.
// Only the push/pop is the anonymous region.

function arenaDemo(): void {
    printf("arena:\n");
    const arena = mem.arenaNew(4096);
    let usedInside: usize = 0;

    ephemeral mem.allocatorScope(arena) {
        const a: unsafe_ptr<void> = mem.allocBytes(64, 8);
        const b: unsafe_ptr<void> = mem.allocBytes(64, 8);
        usedInside = mem.arenaUsed(arena);
    }
    // Allocator popped at the brace. Allocations after this point go to malloc.

    printf(`  bytes used inside the scope: ${usedInside}\n`);
    mem.arenaDestroy(arena);
}

function main(): int32 {
    nested();
    implicitForm();
    arenaDemo();
    return 0;
}

// expected output:
// > enter outer
//   work in outer
//   > enter inner
//     work in inner
//   < leave inner
//   back in outer
// < leave outer
// > enter whole function
//   everything here is inside the region
// < leave whole function
// arena:
//   bytes used inside the scope: 128

// ---------------------------------------------------------------------------
// BREAK IT #1 - the two shapes are not interchangeable, and both say so
//
// Try to give the region a binding:
// `ephemeral g: Indent = section("outer") { ... }`
//
//   kind 'ephemeral' applies to a region and cannot be bound to a name; drop
//     the name and use the anonymous form: 'ephemeral EXPR { ... }'
//     (or 'ephemeral EXPR;')
//
// Now the mirror image - use the anonymous form with a binding kind:
// `disposable section("outer") { ... }`
//
//   kind 'disposable' does not apply to a region (declared appliesTo: binding);
//     the anonymous 'disposable EXPR { ... }' form requires a region kind. To
//     use it as a named resource, give it a name: 'disposable name = EXPR ...'
//
// Talking point: read both messages on camera. Each one names the kind, states
// what it declared, and hands you the exact other spelling. The `appliesTo`
// clause in the kind declaration is the single source of truth for which shape
// is legal - the compiler is just reporting what the kind author wrote.
//
// Talking point: this is a small thing that says a lot about the design. The
// language did not add a `defer` statement and a `using` statement and a
// `with` statement. It added one mechanism - kinds - and these are two
// spellings of it that fall out of one clause in a declaration.

// BREAK IT #2 - watch the LIFO ordering
//
// In `implicitForm`, add a second `ephemeral section("second");` right after
// the first. Both teardowns fire at function end, in reverse order. Then
// convert one to the block form and watch the interleaving change.

// BREAK IT #3 - compare against the alternative
//
// Good beat for the video: write `arenaDemo` the way you would without the
// region kind - make the arena, push it, allocate, pop it, destroy it, and
// get all of that right on every early-return path. Then delete it and put
// the four-line version back.
