// EPISODE 12 - The real harness, and the one thing the compiler does help with
//
// Episode 11 built describe/it from scratch and ran it from `main`. That works,
// but it does not scale to a project: you would have to call every suite by
// hand from one `main`, and adding a test file means editing that list.
//
// std/test.yoop closes that gap with ONE extra clause. Run this file with:
//
//   node ./src/yoopiler.js --test examples/tour
//
// ...and note there is no `main` anywhere in this file.
//
// ---------------------------------------------------------------------------
// `import.test;` is the flag. It declares "this module has no `main` on
// purpose". Without it, a module with no `main` is just a compile error - so a
// mis-named or mis-placed test file fails loudly instead of being skipped.

import.test;

import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import { clampToGrid, manhattan } from "./ep12_geometry.yoop";

// A suite is a top-level function carrying the `suite` kind. Its declaration
// in std/test.yoop is the interesting part:
//
//     export kind suite {
//         appliesTo function;              // <- a THIRD application site
//         signature () => void;            // <- pins the shape
//         enumerable as "suites";          // <- the one compiler favor
//     }
//
// `enumerable as "suites"` is what authorizes the driver to collect every
// function carrying this kind into a table. That is the whole compiler
// contribution to testing in this language: notice the flag, gather the
// kinded functions, generate a `main` that hands them to `runAll`.
//
// The generated main is yoop SOURCE, reparsed through the ordinary parser.
// There is no second codegen path.

suite function clampsDownToTheGrid(): void {
    let test theory: Case = t.asserts("leaves exact multiples alone") {
        const got = clampToGrid(20, 10);
        theory.isSuccessful = got == 20;
        theory.detail = `clampToGrid(20, 10) gave ${got}, wanted 20`;
    }

    let test theory: Case = t.asserts("rounds down to the previous step") {
        const got = clampToGrid(27, 10);
        theory.isSuccessful = got == 20;
        theory.detail = `clampToGrid(27, 10) gave ${got}, wanted 20`;
    }

    let test theory: Case = t.asserts("passes through a non-positive step") {
        const got = clampToGrid(27, 0);
        theory.isSuccessful = got == 27;
        theory.detail = `clampToGrid(27, 0) gave ${got}, wanted 27`;
    }
}

suite function measuresManhattanDistance(): void {
    let test theory: Case = t.asserts("is zero for a point against itself") {
        const got = manhattan(3, 4, 3, 4);
        theory.isSuccessful = got == 0;
        theory.detail = `manhattan(3,4,3,4) gave ${got}, wanted 0`;
    }

    let test theory: Case = t.asserts("adds both axes regardless of direction") {
        const got = manhattan(0, 0, -3, 4);
        theory.isSuccessful = got == 7;
        theory.detail = `manhattan(0,0,-3,4) gave ${got}, wanted 7`;
    }
}

// expected output (TAP):
// # ep12_geometry.test.yoop:clampsDownToTheGrid
// ok 1 - leaves exact multiples alone
// ok 2 - rounds down to the previous step
// ok 3 - passes through a non-positive step
// # ep12_geometry.test.yoop:measuresManhattanDistance
// ok 4 - is zero for a point against itself
// ok 5 - adds both axes regardless of direction
// 1..5
// # 5 passed, 0 failed

// ---------------------------------------------------------------------------
// NOTICE: `theory` is rebound over and over
//
// Every case in a suite reuses the name. That is not sloppiness - each `test`
// binding owns its own block, so each `theory` is scoped to its own case and
// dies at its closing brace. Reading it top to bottom, the repetition is what
// makes the cases look uniform.

// THINGS TO SHOW ON CAMERA
//
// 1. Run it and get TAP output. Lines are written as each case completes
//    rather than buffered, so a segfault keeps everything already reported
//    and just omits the plan line.
//
// 2. Break one on purpose - change a `wanted` value - and show that the
//    `detail` string only appears on failure. That is why a check is a bool
//    plus a sentence rather than `equals(got, want)`: the sentence can say
//    whatever made the check meaningful.
//
// 3. Filters ride as positionals: `--test examples/tour clamps` runs only the
//    suite whose name contains "clamps". Read `selected()` in std/test.yoop -
//    it is fifteen lines of ordinary yoop reading argv.
//
// 4. Isolation is a kind, not a runner feature. `runAll` wraps each suite in
//    `ephemeral arenaScope(...)` - episode 9's mechanism - so everything a
//    suite allocated is reclaimed in bulk before the next one starts.
//
// 5. Open std/test.yoop and scroll it on screen. It is ~150 lines including
//    comments, and every line of the ordering, isolation, filtering,
//    reporting and exit code is plain yoop you could edit.

// BREAK IT #1 - `signature` pins the shape at the suite, not inside generated code
//
// Give a suite a parameter: `suite function clampsDownToTheGrid(n: int32): void`
//
//   ep12_geometry.test.yoop:4:1: function "clampsDownToTheGrid" carries kind
//     'suite' and must match `() => void` (declared by kind 'suite'), but
//     takes 1 parameter(s) instead of 0
//
// Talking point: without the `signature` clause this would blow up inside the
// generated entry module, pointing at source the user never wrote. Instead it
// points at the suite. Good example of a diagnostic decision that costs one
// clause and saves a lot of confusion.

// BREAK IT #2 - std value imports must be namespaced
//
// Try `import { asserts } from "std/test.yoop";` instead of the `* as t` form:
//
//   ep12_geometry.test.yoop:1:7: imports of value "asserts" from
//     "std/test.yoop" must use the namespace form: write
//     `import * as <ns> from "std/test.yoop"` and call as `<ns>.asserts(...)`
//
// Talking point: note that `suite`, `test` and `Case` on the line below ARE
// imported by name and that is fine. Types, traits and kinds are exempt -
// their declaration-position usage keeps them from competing with ordinary
// identifiers. Only VALUES (functions, consts) need the namespace, because a
// name like `asserts` or `info` would otherwise shadow user code in every
// module that touched the library.

// BREAK IT #3 - forget the flag
//
// Comment out `import.test;` at the top:
//
//   ...the module has no `main`, so it is an ordinary compile error.
//
// That failure is the feature. A test file that quietly does not run is worse
// than one that refuses to compile.
