export function clampToGrid(v: int32, step: int32): int32 {
    if (step <= 0) {
        return v;
    }
    const rem = v % step;
    if (rem == 0) {
        return v;
    }
    return v - rem;
}

export function manhattan(x1: int32, y1: int32, x2: int32, y2: int32): int32 {
    let dx: int32 = x2 - x1;
    let dy: int32 = y2 - y1;
    if (dx < 0) { dx = 0 - dx; }
    if (dy < 0) { dy = 0 - dy; }
    return dx + dy;
}
