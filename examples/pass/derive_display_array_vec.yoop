import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { disposable } from "std/core/kinds.yoop";

function double(n: int32): int32 {
  return n * 2;
}

@derive(display)
type Bag propagates<disposable> {
  xs: int32[],
  v: Vec<int32>,
  m: Map<string, int32>,
  cb: (n: int32) => int32,
}

function main(): int {
  let nums: Vec<int32> = vec.vecNew(2);
  vec.vecPush(ref nums, 7);
  vec.vecPush(ref nums, 8);
  let mapNums: Map<string, int32> = map.mapNew(2, map.stringKeyOps());
  map.mapInsert(ref mapNums, "t", 9);
  map.mapInsert(ref mapNums, "u", 10);
  const full: Bag = { xs: [1, 2, 3], v: nums, cb: double, m: mapNums };
  printf(`${full}\n`);

  let empty: Vec<int32> = vec.vecNew(0);
  let emptyMap: Map<string, int32> = map.mapNew(0, map.stringKeyOps());
  const bare: Bag = { xs: [], v: empty, cb: double, m: emptyMap };
  printf(`${bare}\n`);
  return 0;
}
