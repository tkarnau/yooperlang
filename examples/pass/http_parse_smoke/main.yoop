// Parse a hard-coded HTTP/1.1 request through std/http/parser and print the
// structured fields. No sockets, no FFI - just the request line, the header
// block, the split target, and the body offset.
//
// The buffer is a string literal rather than a table of decimal byte values:
// `string_as_bytes` is a view, not a copy, so this is the same bytes the
// socket would have delivered.

import { disposable, Disposable } from "../../../std/core/kinds.yoop";
import { Result } from "../../../std/core/types.yoop";
import * as intr from "../../../std/core/intrinsics.yoop";
import * as types, { HttpError } from "std/http";
import * as parser, { ParsedRequest } from "std/http";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

const REQUEST: string = "GET /hello?name=yoop HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n";

function run(): Result<int32, HttpError> {
    let disposable p: ParsedRequest = parser.parseRequestHead(intr.string_as_bytes(REQUEST))?;
    printf(`method=${types.methodLabel(p.request.method)} path=${p.request.path} version=${p.request.version} cl=${parser.expectedBodyLen(ref p)} host=${types.headerOr(ref p.request, "host", "?")}\n`);
    printf(`query name=${types.queryOr(ref p.request, "name", "?")}\n`);
    return Result.Ok { value: 0 };
}

// A request the parser must refuse. The last header line is where a
// too-permissive parser stops looking, so this one puts the bad field there
// on purpose.
function rejects(what: string, raw: string): void {
    switch (parser.parseRequestHead(intr.string_as_bytes(raw))) {
        case Result.Ok { value: p }: {
            printf(`${what}: UNEXPECTEDLY ACCEPTED\n`);
            Disposable.dispose(ref p);
        }
        case Result.Err { error: e }: { printf(`${what}: ${e}\n`); }
    }
}

// The mirror of `rejects`, for a head that must get THROUGH the parser.
function accepts(what: string, raw: string): void {
    switch (parser.parseRequestHead(intr.string_as_bytes(raw))) {
        case Result.Ok { value: p }: {
            disposable parsed: ParsedRequest = p;
            printf(`${what}: accepted chunked=${parsed.info.chunked}\n`);
        }
        case Result.Err { error: e }: { printf(`${what}: UNEXPECTEDLY REJECTED ${e}\n`); }
    }
}

function main(): int32 {
    switch (run()) {
        case Result.Ok { value: _n }: { }
        case Result.Err { error: e }: { printf(`parse failed: ${e}\n`); return 1; }
    }
    rejects("bad-method ", "BREW /x HTTP/1.1\r\nHost: h\r\n\r\n");
    rejects("bad-version", "GET /x HTTP/9.9\r\nHost: h\r\n\r\n");
    rejects("bad-length ", "GET /x HTTP/1.1\r\nContent-Length: eight\r\n\r\n");
    // A chunked head PARSES now - the body framing is the read loop's problem,
    // not the head parser's. See examples/pass/http_chunked for the decoding.
    accepts("chunked    ", "GET /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n");
    // ...but both framings at once is still refused. RFC 9112 section 6.1:
    // one intermediary frames the message by the length and the next by the
    // chunks, and a request appears out of nowhere between them.
    rejects("both-framings", "GET /x HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\n\r\n");
    rejects("encoded-sep", "GET /a%2Fb HTTP/1.1\r\nHost: h\r\n\r\n");
    return 0;
}
