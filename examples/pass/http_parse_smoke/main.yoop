// Library Phase C smoke: parse a hard-coded HTTP/1.1 request buffer
// through std/http/parser and print the structured fields. No sockets,
// no FFI - exercises the request-line + headers + body-offset path.

import { disposable } from "../../../std/core/kinds.yoop";
import { HttpMethod, headers_get } from "../../../std/http/types.yoop";
import {
    ParsedRequest, parse_request_head, parsed_content_length,
} from "../../../std/http/parser.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function method_label(m: HttpMethod): string {
    switch (m) {
        case HttpMethod.Get:     { return "GET";     }
        case HttpMethod.Post:    { return "POST";    }
        case HttpMethod.Put:     { return "PUT";     }
        case HttpMethod.Delete:  { return "DELETE";  }
        case HttpMethod.Head:    { return "HEAD";    }
        case HttpMethod.Patch:   { return "PATCH";   }
        case HttpMethod.Options: { return "OPTIONS"; }
    }
    return "?";
}

function main(): int32 {
    // "GET /hello HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n"
    let raw: uint8[] = [
        71, 69, 84, 32,
        47, 104, 101, 108, 108, 111, 32,
        72, 84, 84, 80, 47, 49, 46, 49, 13, 10,
        72, 111, 115, 116, 58, 32, 108, 111, 99, 97, 108, 104, 111, 115, 116, 13, 10,
        67, 111, 110, 116, 101, 110, 116, 45, 76, 101, 110, 103, 116, 104, 58, 32, 48, 13, 10,
        13, 10,
    ];
    let disposable p: ParsedRequest = parse_request_head(raw);
    if (p.error.len > 0) {
        printf(`parse err: ${p.error}\n`);
        return 1;
    }
    let m: string = method_label(p.request.method);
    let host: string = headers_get(ref p.request.headers, "host");
    let cl: usize = parsed_content_length(ref p);
    printf(`method=${m} path=${p.request.path} version=${p.request.version} cl=${cl} host=${host}\n`);
    return 0;
}
