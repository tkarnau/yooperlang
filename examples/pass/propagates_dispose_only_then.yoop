// Obligations are advisory, so a manual dispose in only ONE arm of an if/else
// is not an error (there is no obligation to leave unsatisfied on the other
// path). This typechecks cleanly.

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Resource implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

function make_resource(): Resource propagates<disposable> {
    return { id: 7 };
}

function main(): int32 {
    let r: Resource = make_resource();
    if (2 > 1) {
        Disposable.dispose(ref r);
    } else {
        // missing dispose - `r` leaks down this path
    }
    return 0;
}
