// Ownership redesign (2026-06-17, plans/ownership-and-typestate-redesign.md):
// obligations are advisory, so a manual dispose in only ONE arm of an if/else
// is no longer an error (there is no obligation to leave unsatisfied on the
// other path). This typechecks cleanly. (Formerly
// examples/fail/propagates_dispose_only_then.)

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Resource implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

function make_resource(): Resource propagates<disposable> {
    return { id: 7 };
}

function main(): int32 {
    let r: Resource = make_resource();
    if (2 > 1) {
        Disposable.dispose(ref r);
    } else {
        // missing dispose - `r` leaks down this path
    }
    return 0;
}
