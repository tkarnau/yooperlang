import {
    stringEq,
    stringStartsWith,
    stringIndexOf,
    stringSlice,
    stringConcat,
    stringConcatAll,
    stringFromBytes,
} from "../../../std/core/strings.yoop";

import { Result } from "../../../std/core/types.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    let s: string = "Hello, World";

    let eq1: bool = stringEq(s, "Hello, World");
    let eq2: bool = stringEq(s, "Goodbye");
    let eq1i: int32 = 0; if (eq1) { eq1i = 1; }
    let eq2i: int32 = 0; if (eq2) { eq2i = 1; }
    printf(`eq_match=${eq1i} eq_diff=${eq2i}\n`);

    let sw: bool = stringStartsWith(s, "Hello");
    let swi: int32 = 0; if (sw) { swi = 1; }
    printf(`starts_with_Hello=${swi}\n`);

    let idx: usize = stringIndexOf(s, "World");
    printf(`idx_of_World=${idx}\n`);

    let sl: Result<string, string> = stringSlice(s, 7, 12);
    let sl_val: string = "";
    let sl_err: string = "";
    switch (sl) {
        case Result.Ok { value: sl_ok }: { sl_val = sl_ok; }
        case Result.Err { error: sl_e }: { sl_err = sl_e; }
    }
    printf(`slice=${sl_val} err=${sl_err}\n`);

    let cat: string = stringConcat("foo", "bar");
    printf(`cat=${cat}\n`);

    let parts: string[] = ["a", "-", "b", "-", "c"];
    let all: string = stringConcatAll(parts);
    printf(`all=${all}\n`);

    let bytes: uint8[] = [72, 105];
    let fb: Result<string, string> = stringFromBytes(bytes);
    let fb_val: string = "";
    let fb_err: string = "";
    switch (fb) {
        case Result.Ok { value: fb_ok }: { fb_val = fb_ok; }
        case Result.Err { error: fb_e }: { fb_err = fb_e; }
    }
    printf(`fb=${fb_val} err=${fb_err}\n`);

    return 0;
}
