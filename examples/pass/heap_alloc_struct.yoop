import * as intr from "std/core/intrinsics.yoop";

type Point {
    x: int32,
    y: float64,
}

function main(): int32 {
    let pts: Point[] = intr.heap_alloc(3);
    pts[0] = { x: 1, y: 2.5 };
    pts[1] = { x: 3, y: 4.5 };
    pts[2] = { x: 5, y: 6.5 };
    printf(`p[0]=(${pts[0].x}, ${pts[0].y}) p[2]=(${pts[2].x}, ${pts[2].y})\n`);
    intr.heap_free(pts);
    return 0;
}

// expected output:
// p[0]=(1, 2.500000) p[2]=(5, 6.500000)
