import { Vec, vecNew, vecPush, vecGet, vecSet, vecClear } from "../../../std/core/vec.yoop";
import { Disposable, disposable } from "../../../std/core/kinds.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    disposable v: Vec<int32> = vecNew(2);
    vecPush(ref v, 10);
    vecPush(ref v, 20);
    vecPush(ref v, 30);
    vecPush(ref v, 40);
    printf(`len=${v.len} cap=${v.cap}\n`);
    let x: int32 = vecGet(ref v, 2);
    printf(`v[2]=${x}\n`);
    vecSet(ref v, 0, 99);
    printf(`v[0]=${vecGet(ref v, 0)}\n`);
    vecClear(ref v);
    printf(`after_clear len=${v.len} cap=${v.cap}\n`);
    return 0;
}
