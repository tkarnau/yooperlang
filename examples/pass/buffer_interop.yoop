import.unsafe;

extern "C" from "stdlib.h" {
    function malloc(n: c_size_t): unsafe_ptr<uint8>;
    function free(p: unsafe_ptr<uint8>): void;
}

extern "C" from "string.h" {
    function memcmp(a: unsafe_ptr<uint8>, b: unsafe_ptr<uint8>, n: c_size_t): c_int;
}

function main(): int32 {
    // Heap-allocate via libc, wrap as a yoop view.
    let raw: unsafe_ptr<uint8> = malloc(8);
    let view: uint8[] = unsafe_ptr.toArray<uint8>(raw, 8);
    let i: int32 = 0;
    for (i = 0; i < 8; i = i + 1) {
        view[i] = uint8(i * 2);
    }

    // yoop-local literal — uses .ptr to expose its data buffer to libc.
    let expect: uint8[] = [0, 2, 4, 6, 8, 10, 12, 14];

    // memcmp(view.ptr, expect.ptr, 8) should be 0 if the writes round-tripped.
    let rc: c_int = memcmp(view.ptr, expect.ptr, 8);
    let matched: int32 = 0;
    if (rc == 0) {
        matched = 1;
    }
    printf(`view.len=${view.len} expect.len=${expect.len} matched=${matched}\n`);

    free(raw);
    return 0;
}
