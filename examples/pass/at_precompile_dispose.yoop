// Phase 11.D.17: real CLEANUP_CALL execution at comptime. The
// kindCheck pass synthesizes a `CLEANUP_CALL` statement at scope
// exit for each `disposable` (or other `mustCall <method>`)
// binding. The interpreter resolves the trait method's bytecode
// via the trait method resolver and dispatches CALL_DIRECT with
// `ref binding` as the `self` arg - same shape as a regular trait
// method call.
//
// At runtime the dispose impl typically calls a libc / SDL / yoop
// runtime extern to release OS state (free, close, etc). At
// comptime those externs aren't whitelisted, so the fold would
// surface a clear error. Bindings whose dispose impl is
// comptime-safe (pure value mutation of `self`) fold cleanly -
// that's what this fixture exercises.

import { disposable, Disposable } from "std/core/kinds.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

// Comptime-safe dispose: just mutates self. No OS state, no extern
// calls. The fold succeeds.
type Counter implements Disposable {
    value: int32,
    function dispose(ref self): void {
        self.value = self.value;  // no-op; proves the dispatch runs
    }
}

function build_counter(start: int32): int32 {
    disposable c: Counter = { value: start };
    return c.value + 1;
}

// Comptime fold here: build_counter constructs a Counter with the
// disposable kind. After the return-value expression evaluates, the
// kindCheck-inserted CLEANUP_CALL fires, running Disposable.dispose
// on `c`. The dispose body is pure, so it has no observable effect
// on the returned value. R folds to `start + 1`.
@precompile const R_FIVE: int32 = build_counter(5);    // 6
@precompile const R_HUNDRED: int32 = build_counter(99);// 100

function main(): int32 {
    printf(`R_FIVE=${R_FIVE} R_HUNDRED=${R_HUNDRED}\n`);
    return 0;
}

// expected stdout:
//   R_FIVE=6 R_HUNDRED=100
