// The same allocator-context bug, with no async code anywhere in sight.
//
// `yoop_task_wait` drains the run queue re-entrantly on the CALLING thread,
// so that a nested wait chain cannot deadlock the pool (Phase 9.I). The
// consequence is that a plain synchronous function holding an arena will run
// whatever task it happens to pop INSIDE its own region - and everything that
// task allocated is reclaimed the moment the arena scope ends.
//
// So arenas and tasks were already incompatible in straight-line code, before
// anybody wrote `async`. The fix is the same one: run_task_step installs the
// task's own allocator context around the step and restores the caller's
// afterwards, whichever thread the step runs on.
//
// Pinned to ONE worker with that worker parked inside a blocking sleep, so
// main is guaranteed to be the thread that dispatches `allocates`.

import.unsafe;
import { ephemeral } from "std/core/kinds.yoop";
import * as mem from "std/core/alloc.yoop";
import * as conc from "std/core/concurrency.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

// Occupies the single worker with a BLOCKING sleep. Deliberately not an
// await, which would hand the worker straight back and defeat the setup.
task hog(): int32 {
    conc.sleep_ms(250);
    return 0;
}

// Allocates through the ambient allocator. Must not be handed main's arena
// just because main is the thread that happened to dispatch it.
task allocates(ar: mem.Arena): int32 {
    let p: unsafe_ptr<void> = mem.allocBytes(512, 8);
    if (p == null) { return -1; }
    printf("task: arena used=%d\n", mem.arenaUsed(ar));
    mem.freeBytes(p);
    return 0;
}

function main(): int32 {
    let ar: mem.Arena = mem.arenaNew(65536);

    pooled h = hog();
    conc.sleep_ms(60);              // make sure the worker is inside the sleep

    ephemeral mem.allocatorScope(ar) {
        // Main's own allocation DOES come from the arena - that is the half
        // of the behavior that has to keep working.
        let mine: unsafe_ptr<void> = mem.allocBytes(128, 8);
        if (mine == null) { printf("arena alloc failed\n"); return 1; }
        printf("main: after own alloc used=%d\n", mem.arenaUsed(ar));

        // No worker is free, so main dispatches this task on its own thread,
        // inside its own arena scope.
        pooled t = allocates(ar);
        let trc: int32 = wait t;
        printf("main: after task used=%d rc=%d\n", mem.arenaUsed(ar), trc);
    }

    let hrc: int32 = wait h;
    printf("hog rc=%d\n", hrc);
    mem.arenaDestroy(ar);
    return 0;
}

// expected output:
// main: after own alloc used=128
// task: arena used=128
// main: after task used=128 rc=0
// hog rc=0
