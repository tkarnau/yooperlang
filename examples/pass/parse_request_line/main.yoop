// Phase 8.H headline demo: parse an HTTP/1.1 request line into method,
// path, and version using only std/core/bytes + std/core/strings — no
// `import.unsafe;`. This is the smoke test for "the library prereqs are
// done" per plans/phase-8-h-string-bytes-vec.md.

import { bytes_index_of, bytes_slice } from "../../../std/core/bytes.yoop";
import { string_from_bytes } from "../../../std/core/strings.yoop";
import { Result } from "../../../std/core/types.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

type RequestLine {
    method: string,
    path: string,
    version: string,
    error: string,
}

function empty_request_line(msg: string): RequestLine {
    return { method: "", path: "", version: "", error: msg };
}

function parse_request_line(buf: uint8[]): RequestLine {
    // Find the trailing CRLF.
    let cr: usize = bytes_index_of(buf, 13);
    if (cr == buf.len) {
        return empty_request_line("parse_request_line: missing CR");
    }
    // First space.
    let s1: usize = bytes_index_of(buf, 32);
    if (s1 == buf.len || s1 >= cr) {
        return empty_request_line("parse_request_line: missing method separator");
    }
    // Search for the second space after s1.
    let after_first: uint8[] = bytes_slice(buf, s1 + 1, cr);
    let s2_rel: usize = bytes_index_of(after_first, 32);
    if (s2_rel == after_first.len) {
        return empty_request_line("parse_request_line: missing path/version separator");
    }
    let s2: usize = s1 + 1 + s2_rel;
    // Slice + convert.
    let method_bytes: uint8[] = bytes_slice(buf, 0, s1);
    let path_bytes: uint8[] = bytes_slice(buf, s1 + 1, s2);
    let version_bytes: uint8[] = bytes_slice(buf, s2 + 1, cr);

    let method_r: Result<string, string> = string_from_bytes(method_bytes);
    let method_val: string = "";
    switch (method_r) {
        case Result.Ok { value: mv }: { method_val = mv; }
        case Result.Err { error: me }: { return empty_request_line(me); }
    }

    let path_r: Result<string, string> = string_from_bytes(path_bytes);
    let path_val: string = "";
    switch (path_r) {
        case Result.Ok { value: pv }: { path_val = pv; }
        case Result.Err { error: pe }: { return empty_request_line(pe); }
    }

    let version_r: Result<string, string> = string_from_bytes(version_bytes);
    let version_val: string = "";
    switch (version_r) {
        case Result.Ok { value: vv }: { version_val = vv; }
        case Result.Err { error: ve }: { return empty_request_line(ve); }
    }

    return {
        method: method_val,
        path: path_val,
        version: version_val,
        error: "",
    };
}

function main(): int32 {
    // "GET /path HTTP/1.1\r\n" = 71 45 54 20 2F 70 61 74 68 20 48 54 54 50 2F 31 2E 31 0D 0A
    let raw: uint8[] = [
        71, 69, 84,                            // GET
        32,                                    // ' '
        47, 112, 97, 116, 104,                 // /path
        32,                                    // ' '
        72, 84, 84, 80, 47, 49, 46, 49,        // HTTP/1.1
        13, 10,                                // CRLF
    ];
    let rl: RequestLine = parse_request_line(raw);
    printf(`method=${rl.method} path=${rl.path} version=${rl.version} err=${rl.error}\n`);

    // Malformed: missing CRLF.
    let bad: uint8[] = [71, 69, 84, 32, 47];  // "GET /"
    let bad_rl: RequestLine = parse_request_line(bad);
    printf(`bad.err=${bad_rl.error}\n`);

    return 0;
}
