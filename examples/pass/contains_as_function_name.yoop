// `contains` is a kind-clause word, and as a global keyword it would block a
// very natural function name. It is contextual instead: the lexer emits IDENT,
// and the parser recognizes it only inside kind decls and propagation
// clauses.

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function contains(haystack: string, needle: string): bool {
    if (needle.len > haystack.len) { return false; }
    return true;
}

function main(): int32 {
    let ok: bool = contains("hello world", "world");
    if (ok) { printf(`yes\n`); } else { printf(`no\n`); }
    return 0;
}
