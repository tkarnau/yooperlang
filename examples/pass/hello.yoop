// to compile me from the node compiler
// node .\src\yoopiler.js --inputFile .\examples\test.yoop --outputFile .\examples\test


function pow(a: int32, b: int32): int32 {
  let i: int32 = 0;
  let r: int32 = 1;
  while (i < b) {
    i = i + 1;
    r = r * a;
  }

  return r;
}

function main(): int32 {
  printf("Hello, World!\n");
  let x: int32 = 4 + 5;
  printf(`x is ${x}\n`);
  printf(`sum: ${x + 1}, doubled: ${x * 2}\n`);
  let y: int32 = pow(3, 5); // should be 243?
  printf(`pow: 3 to the 5th is ${y}\n`);
  return 0;
}
