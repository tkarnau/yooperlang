extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

trait Disposable {
    function dispose(ref self): void;
}

type H implements Disposable {
    fd: int32,
    function dispose(ref self): void {
        printf(`disposing ${self.fd}\n`);
    }
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    ownsBlock;
    mustCall dispose beforeScopeEnd;
}

function main(): int32 {
    disposable a: H = { fd: 7 };
    printf(`work\n`);
    return 0;
}
