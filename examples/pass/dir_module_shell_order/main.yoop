// Regression: a value enum or union declared in a directory-module file that
// sorts AFTER a sibling using it must not reach consumers as its pass-A shell -
// a null `underlying` for the enum (so `switch` refuses it) and empty `fields`
// for the union (so field access refuses it). Pass C fills both shells in
// place instead of replacing the table entry, the same as structs and
// vtables.

import * as shapes from "./shapes";
import { Color, Bits } from "./shapes";

function main(): int32 {
  switch (shapes.pickColor()) {
    case Color.RED: { printf("red\n"); }
    case Color.GREEN: { printf("green\n"); }
    default: { printf("other\n"); }
  }

  const b: Bits = shapes.bitsOf(42);
  printf("bits=%d\n", b.asInt);
  return 0;
}
