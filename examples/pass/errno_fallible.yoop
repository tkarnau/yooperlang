extern "C" from "fcntl.h" {
    function open(path: string, flags: c_int): c_int;
    function close(fd: c_int): c_int;
}

type OpenResult { fd: c_int, err: string }

function open_safe(path: string, flags: c_int): OpenResult {
    let fd: c_int = open(path, flags);
    if (fd < 0) {
        let code: c_int = errno.get();
        return { fd: -1, err: errno.message(code) };
    }
    return { fd: fd, err: "" };
}

type Probe { found: int32, err: string }

function probe(path: string): Probe {
    let fd: c_int = open_safe(path, 0)?;
    let rc: c_int = close(fd);
    return { found: 1, err: "" };
}

function main(): int32 {
    let p: Probe = probe("/no/such/file/yoop-phase-8-d");
    if (p.err.len > 0) {
        printf(`propagated err: ${p.err}\n`);
        return 0;
    }
    printf(`unexpected: found=${p.found}\n`);
    return 1;
}
