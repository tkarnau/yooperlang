// An HTTP server that uses std/http/router.yoop to dispatch across several
// handlers behind one type-erased route table.
//
// Build: node ./src/yoopiler.js examples/pass/http_router/main.yoop -o /tmp/http_router
// Run:   /tmp/http_router
// Test:  curl http://localhost:18081/hello
//        curl http://localhost:18081/greet/marquette      (a captured segment)
//        curl http://localhost:18081/healthz
//        curl -X DELETE http://localhost:18081/hello      (405 with Allow)
//        curl http://localhost:18081/anything-else        (the fallback)

import { disposable } from "../../../std/core/kinds.yoop";
import { Result } from "../../../std/core/types.yoop";
import * as tcp, { ListenResult } from "../../../std/net/tcp.yoop";
import * as http, {
    Handler, HandleOutcome, Dispatcher,
} from "../../../std/http/server.yoop";
import * as types, {
    Request, Response, HttpError, HttpMethod,
} from "../../../std/http/types.yoop";
import * as router, { Router } from "../../../std/http/router.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

// Three handlers, each with its own state.
type HelloHandler implements Handler {
    greeting: string,
    function handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        types.respondText(ref resp, types.ok(), self.greeting);
        return HandleOutcome.Ok;
    }
}

// Reads the `:name` segment the router captured out of the path.
type GreetHandler implements Handler {
    fallbackName: string,
    function handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        let who: string = types.paramOr(ref req, "name", self.fallbackName);
        types.respondText(ref resp, types.ok(), `Hello, ${who}!\n`);
        return HandleOutcome.Ok;
    }
}

type HealthHandler implements Handler {
    statusText: string,
    function handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        types.respondJson(ref resp, types.ok(), self.statusText);
        return HandleOutcome.Ok;
    }
}

type FallbackHandler implements Handler {
    note: string,
    function handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        types.respondText(ref resp, types.notFound(), `${self.note}: ${req.path}\n`);
        return HandleOutcome.Ok;
    }
}

function run(): Result<int32, HttpError> {
    let disposable lr: ListenResult = tcp.tcp_listen("127.0.0.1", 18081, 128);
    if (lr.error.len > 0) {
        return Result.Err { error: types.errIo(lr.error) };
    }

    let hello: HelloHandler       = { greeting: "Hello via router!\n" };
    let greet: GreetHandler       = { fallbackName: "stranger" };
    let health: HealthHandler     = { statusText: "{\"status\":\"ok\"}\n" };
    let missing: FallbackHandler  = { note: "no route" };

    let disposable r: Router = router.routerNew();
    router.routerGet(ref r, "/hello", Dispatcher.from(ref hello));
    router.routerGet(ref r, "/greet/:name", Dispatcher.from(ref greet));
    router.routerGet(ref r, "/healthz", Dispatcher.from(ref health));
    router.routerFallback(ref r, Dispatcher.from(ref missing));

    printf("router listening on 127.0.0.1:18081\n");

    // The router is itself a Handler, so it erases into a Dispatcher exactly
    // like the handlers it holds.
    let d: Dispatcher = Dispatcher.from(ref r);
    let served: int32 = http.serveDefault(ref lr.listener, ref d, 1)?;
    printf(`served=${served}\n`);
    return Result.Ok { value: served };
}

function main(): int32 {
    switch (run()) {
        case Result.Ok { value: _n }: { return 0; }
        case Result.Err { error: e }: { printf(`server failed: ${e}\n`); return 1; }
    }
    return 0;
}
