// `==` / `!=` on two bools.
//
// Without them ("operator != cannot be applied to bool and bool"), every
// equality test on a truth value has to be spelled
// `(a && !b) || (!a && b)` - which needs a named helper to stay readable at a
// call site. Ordered comparison on bools IS rejected on purpose: there
// is no useful ordering on a truth value, so `a < b` is a typo far more often
// than it is intent.

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

// The shape the workaround existed for: "did these two checks agree?"
function agree(a: bool, b: bool): bool {
    return a == b;
}

function main(): int32 {
    let t: bool = true;
    let f: bool = false;

    if (t != f) { printf("t!=f\n"); }
    if (t == f) { printf("UNREACHABLE eq\n"); }
    if (t == t) { printf("t==t\n"); }
    if (f == f) { printf("f==f\n"); }

    // Against a literal, and under negation.
    if (t == true) { printf("t==true\n"); }
    if (!(t == f)) { printf("!(t==f)\n"); }

    // Through a function, which is where the long-form workaround hurt.
    if (agree(f, f)) { printf("agree(f,f)\n"); }
    if (agree(t, f)) { printf("UNREACHABLE agree\n"); }

    // As a value, not just a condition.
    let same: bool = t == t;
    let diff: bool = t != t;
    printf(`same=${same} diff=${diff}\n`);

    return 0;
}
