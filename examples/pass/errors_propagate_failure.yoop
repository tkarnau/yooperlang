type Bytes {
    len: int32,
    err: string,
}

type Result {
    total: int32,
    err: string,
}

function read_all(path: string): Bytes {
    if (path.len == 0) {
        return { len: 0, err: "empty path" };
    }
    return { len: 42, err: "" };
}

function load_and_double(path: string): Result {
    const n: int32 = read_all(path)?;
    return { total: n + n, err: "" };
}

function main(): int32 {
    const { total, err } = load_and_double("");
    if (err.len > 0) {
        printf(`err: ${err}\n`);
        return 0;
    }
    printf(`total = ${total}\n`);
    return 1;
}

// expected output: err: empty path
