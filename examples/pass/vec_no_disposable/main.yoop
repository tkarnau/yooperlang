// Vec<T> carries propagates<disposable>. Obligations are ADVISORY, not
// enforced: binding a Vec without `disposable` (or any other discharge) is
// not an error - it typechecks cleanly and the user owns the lifetime.

import { Vec, vecNew } from "../../../std/core/vec.yoop";
import { disposable } from "../../../std/core/kinds.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    let v: Vec<int32> = vecNew(4);
    printf(`leaked: ${v.cap}\n`);
    return 0;
}
