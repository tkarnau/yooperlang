import { read_all, Bytes } from "./io.yoop";

function load(p: string): Bytes {
    const n: int32 = read_all(p)?;
    return Bytes.Ok { value: n + 1 };
}

function main(): int32 {
    const r: Bytes = load("foo");
    switch (r) {
        case Bytes.Ok { value: len }: { printf(`len = ${len}\n`); return 0; }
        case Bytes.Err { error: e }: { printf(`err: ${e}\n`); return 1; }
    }
    return 0;
}
