// The `std/...` import root resolves against the std/ directory at
// the repo root, instead of forcing a deep relative path like
// `import { ... } from "../../../std/core/vec.yoop";`. SPEC section 1's
// relative-only rule applies to every other import; `std/` is the only
// escape hatch.

import { Vec } from "std/core/vec.yoop";
import * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    disposable v: Vec<int32> = vec.vecNew(4);
    v.push(10);
    v.push(20);
    v.push(30);
    let total: int32 = v.get(0) + v.get(1) + v.get(2);
    printf(`total=${total}\n`);
    return 0;
}
