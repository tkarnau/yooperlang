// A wait inside a task body must yield the worker rather than
// block it, so deeper-than-N-deep nested-wait chains complete even when the
// pool size is N=1.
//
// Chain shape: leaf -> mid_a -> mid_b -> main. Each interior task waits on
// the next one inline (`let r = next();` inserts wait at the next statement).
// Why it matters, with YOOP_NUM_WORKERS=1: main submits mid_b and blocks. If
// it blocked in pthread_cond_wait, the lone worker would pick up mid_b, which
// submits mid_a and blocks waiting for it; with no remaining workers, mid_a
// would sit in the queue forever -> deadlock. Instead the blocked worker
// re-enters the dispatch loop, drains the queue, and the chain finishes.

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

task leaf(): int32 {
    return 7;
}

task mid_a(): int32 {
    let v: int32 = leaf();
    return v + 1;
}

task mid_b(): int32 {
    let v: int32 = mid_a();
    return v + 10;
}

function main(): int32 {
    let result: int32 = mid_b();
    printf(`chain=${result}\n`);
    return 0;
}

// expected output:
// chain=18
