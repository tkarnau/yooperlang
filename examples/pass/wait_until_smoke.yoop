// Phase 10.F: `conc.wait_until(h, deadline_ns)` is the bounded-wait counterpart
// to the `wait` keyword. It returns a `WaitResult<T>` enum with two
// variants: `Done { value: T }` carrying the task's result, or `Timeout`
// when the absolute deadline elapsed before the task completed.
//
// This fixture exercises both branches:
//   - `compute(7)` is a single-statement task that finishes far inside
//     the 1-second deadline → Done { value: 49 }.
//   - `slow(...)` sleeps for 200ms before returning, then we wait_until
//     with a 50ms deadline → Timeout.
// Each switch arm prints a distinct line so the test can assert on
// stdout without flakiness around exact timing.

import { WaitResult } from "std/core/concurrency.yoop";
import * as conc from "std/core/concurrency.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

task compute(x: int32): int32 {
    return x * x;
}

task slow(): int32 {
    conc.sleep_ms(200);
    return 99;
}

function main(): int32 {
    pooled fast = compute(7);
    let fast_deadline: uint64 = conc.now_ns() + 1_000_000_000;
    let fast_result: WaitResult<int32> = conc.wait_until(fast, fast_deadline);
    switch (fast_result) {
        case WaitResult.Done { value: v }: { printf(`fast done=${v}\n`); }
        case WaitResult.Timeout: { printf(`fast timed out (unexpected)\n`); }
        case WaitResult.Cancelled: { printf(`fast cancelled (unexpected)\n`); }
    }

    pooled lazy = slow();
    let lazy_deadline: uint64 = conc.now_ns() + 50_000_000;
    let lazy_result: WaitResult<int32> = conc.wait_until(lazy, lazy_deadline);
    switch (lazy_result) {
        case WaitResult.Done { value: v }: { printf(`lazy done=${v} (unexpected)\n`); }
        case WaitResult.Timeout: { printf(`lazy timed out\n`); }
        case WaitResult.Cancelled: { printf(`lazy cancelled (unexpected)\n`); }
    }
    // Drain the still-running slow task so its handle frees cleanly
    // (a pooled task without a final wait would leak the handle alloc).
    let _final: int32 = wait lazy;
    return 0;
}

// expected output:
// fast done=49
// lazy timed out
