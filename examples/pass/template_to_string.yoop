// Phase 10.D.1: template literals with `${...}` interpolation can be
// used anywhere a `string` is expected - not just inside printf.
// Lowering runs `${x}` through the matching `to_string` shim in
// std/core/format.yoop and concats the parts via `string_concat_all`.

import * as log from "std/log.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    let count: int32 = 7;
    let ratio: float64 = 1.5;
    let name: string = "world";
    let ok: bool = true;

    // log.info takes a plain `string`. The template literal lowering
    // turns each interpolation into a `<type>_to_string` call and
    // concatenates the parts before the call.
    log.info(`hello ${name}`);
    log.info(`count=${count} ratio=${ratio} ok=${ok}`);

    // Bind a template literal to a string variable, then interpolate
    // that variable into another template - confirms the result of
    // string_concat_all behaves like any other string.
    let msg: string = `count is ${count}`;
    printf(`${msg}\n`);
    return 0;
}
