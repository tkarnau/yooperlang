// Ownership redesign (2026-06-17, plans/ownership-and-typestate-redesign.md):
// returning a struct literal that moves a propagating binding into a field
// needs no propagates<K> on the function. Obligations are advisory; this
// typechecks cleanly. (Formerly
// examples/fail/propagates_return_struct_literal_not_declared.)

trait Disposable {
    function dispose(ref self): void;
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
}

type Inner implements Disposable propagates<disposable> {
    id: int32,
    function dispose(ref self): void {}
}

type Outer implements Disposable propagates<disposable> {
    inner: Inner,
    function dispose(ref self): void {
        Disposable.dispose(ref self.inner);
    }
}

// No propagates<disposable> on the return. Advisory model: not an error.
function make_outer(): Outer {
    let inner: Inner = { id: 1 };
    return { inner: inner };
}

function main(): int32 {
    return 0;
}
