// End-to-end demo for std/http/client.yoop. A background task serves two
// requests; the main thread issues a GET and a POST against it and prints
// what came back.
//
// Both directions go through the same wire helpers and the same header
// reader, so a framing change on one side cannot quietly break the other.

import { disposable, Disposable } from "../../../std/core/kinds.yoop";
import { Result } from "../../../std/core/types.yoop";

import * as tcp, { ListenResult } from "std/net";
import * as http, {
    Handler, HandleOutcome, Dispatcher,
} from "std/http";
import * as types, {
    Request, Response, HttpError, HttpMethod,
} from "std/http";
import * as client, { Client, ClientResponse } from "std/http";
import * as strings from "std/core/strings.yoop";
import * as fmt from "std/core/format.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}
// yoop_sleep_ms rather than libc usleep: usleep is POSIX-only and does not
// exist in the MSVC CRT, while the runtime's own sleep is portable and is
// what the rest of the tree already uses to pause.
extern "C" from "yoop_runtime" {
    function yoop_sleep_ms(ms: uint64): int32;
}

// The port the server actually bound. Filled in by serverTask once the kernel
// has assigned one, and read by the client after main gives the server its
// startup window.
//
// The listener binds port 0 rather than a hard-coded number so this fixture
// cannot collide with anything else listening - which is what lets the e2e
// suite run tests concurrently. std/net reports the assigned port back through
// TcpListener.bound_port.
let boundPort: int32 = 0;

// Answers a GET with a fixed body, and a POST with the body it was sent.
type EchoHandler implements Handler {
    greeting: string,
    async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        if (types.methodEq(req.method, HttpMethod.Post)) {
            types.respondText(ref resp, types.ok(), `echo:${types.bodyText(ref req)}\n`);
            return HandleOutcome.Ok;
        }
        types.respondText(ref resp, types.ok(), self.greeting);
        return HandleOutcome.Ok;
    }
}

task serverTask(): int32 {
    let disposable lr: ListenResult = tcp.tcp_listen("127.0.0.1", 0, 32);
    if (lr.error.len > 0) {
        printf(`server bind err: ${lr.error}\n`);
        return 1;
    }
    // Publish the port the kernel chose, so the client half can dial it.
    boundPort = lr.listener.bound_port;
    let h: EchoHandler = { greeting: "ping-pong\n" };
    let d: Dispatcher = Dispatcher.from(ref h);
    switch (await http.serveDefault(ref lr.listener, ref d, 2)) {
        case Result.Ok { value: n }: { printf(`server done served=${n}\n`); }
        case Result.Err { error: e }: { printf(`server done err=${e}\n`); }
    }
    return 0;
}

// Async: every client call suspends rather than blocking a worker.
async exercise(): Result<int32, HttpError> {
    let c: Client = client.clientNew();
    let base: string = strings.string_concat(
        "http://127.0.0.1:", fmt.int_to_string(int64(boundPort)));

    disposable got: ClientResponse = await client.get(ref c, strings.string_concat(base, "/"))?;
    printf(`status=${got.status.code} body=${client.responseText(ref got)}`);

    disposable posted: ClientResponse =
        await client.post(ref c, strings.string_concat(base, "/items"), "text/plain", "hello")?;
    printf(`status=${posted.status.code} body=${client.responseText(ref posted)}`);
    return Result.Ok { value: 0 };
}

task exerciseTask(): Result<int32, HttpError> {
    return await exercise();
}

function main(): int32 {
    joined sh = serverTask();
    // Give the server a moment to bind. Racing the accept loop is fine -
    // tcp_connect retries until accept(2) takes the fd.
    let _slept: int32 = yoop_sleep_ms(100);

    // main is the sync/async boundary - spawn the async work as a task.
    pooled ex = exerciseTask();
    let code: int32 = 0;
    switch (wait ex) {
        case Result.Ok { value: _n }: { }
        case Result.Err { error: e }: {
            printf(`client err: ${e}\n`);
            code = 1;
        }
    }
    let _rc: int32 = wait sh;
    return code;
}
