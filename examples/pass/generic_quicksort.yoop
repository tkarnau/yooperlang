trait Comparable<T> {
  function compare(ref self, b: T): int8;
}

type Num implements Comparable<Num> {
  v: int32,
  function compare(ref self, b: Num): int8 {
    if (self.v < b.v) {
      return -1;
    } else if (self.v > b.v) {
      return 1;
    } else {
      return 0;
    }
  }
}

function swap<T>(arr: T[], i: usize, j: usize): void {
  const temp = arr[i];
  arr[i] = arr[j];
  arr[j] = temp;
}

// Lomuto partition, usize-safe (no `low - 1`): `store` starts at `low` and we
// swap-then-advance, so the boundary index never goes below `low`.
function partition<T implements Comparable<T>>(arr: T[], low: usize, high: usize): usize {
  const pivot = arr[high];
  let store = low;
  let j = low;
  for (j = low; j < high; j = j + 1) {
    // ascending order: elements <= pivot move to the left partition.
    if (Comparable.compare(ref arr[j], pivot) <= 0) {
      swap(arr, store, j);
      store = store + 1;
    }
  }
  swap(arr, store, high);
  return store;
}

function quickSort<T implements Comparable<T>>(arr: T[], low: usize, high: usize): void {
  // base case covers empty and single-element ranges; `>=` (not `>`) is load
  // bearing because usize means low can equal high.
  if (low >= high) {
    return;
  }
  const p = partition(arr, low, high);
  // guard the left recursion so `p - 1` never underflows when p == 0.
  if (p > low) {
    quickSort(arr, low, p - 1);
  }
  quickSort(arr, p + 1, high);
}

// public entry: sorts the whole array, empty-safe (no `len - 1` underflow).
function sort<T implements Comparable<T>>(arr: T[]): void {
  if (arr.len > 0) {
    quickSort(arr, 0, arr.len - 1);
  }
}

function main(): int32 {
  let xs: Num[] = [
    { v: 5 }, { v: 2 }, { v: 9 }, { v: 1 }, { v: 5 }, { v: 7 }, { v: 3 },
  ];
  sort(xs);
  let i: usize = 0;
  for (i = 0; i < xs.len; i = i + 1) {
    printf(`${xs[i].v} `);
  }
  printf(`\n`);
  return 0;
}
