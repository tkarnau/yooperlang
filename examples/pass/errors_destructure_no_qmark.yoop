type Bytes {
    len: int32,
    err: string,
}

function read_all(path: string): Bytes {
    return { len: 7, err: "" };
}

function main(): int32 {
    const { len, err } = read_all("foo");
    if (err.len > 0) {
        return 1;
    }
    printf(`len = ${len}\n`);
    return 0;
}

// expected output: len = 7
