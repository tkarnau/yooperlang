// std/core/format - direct calls into the primitive `toString`
// shims, prior to the template-literal lowering picking them up.
// Verifies digit assembly across zero, single-digit, multi-digit,
// and negative ints; the boolean labels; and the snprintf-backed
// float formatter.

import * as fmt from "std/core/format.yoop";

extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

function main(): int32 {
    printf(`${fmt.intToString(0)}\n`);
    printf(`${fmt.intToString(7)}\n`);
    printf(`${fmt.intToString(12345)}\n`);
    printf(`${fmt.intToString(-42)}\n`);

    printf(`${fmt.uintToString(0)}\n`);
    printf(`${fmt.uintToString(255)}\n`);

    printf(`${fmt.boolToString(true)}\n`);
    printf(`${fmt.boolToString(false)}\n`);

    printf(`${fmt.floatToString(1.5)}\n`);
    printf(`${fmt.floatToString(0.0)}\n`);
    return 0;
}
