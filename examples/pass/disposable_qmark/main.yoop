extern "C" from "stdio.h" {
    function printf(fmt: string, ...): int32;
}

trait Disposable {
    function dispose(ref self): void;
}

type FileHandle implements Disposable {
    fd: int32,
    function dispose(ref self): void {
        printf(`disposing fd=${self.fd}\n`);
    }
}

kind disposable {
    appliesTo binding;
    requires Disposable;
    ownsBlock;
    mustCall dispose beforeScopeEnd;
}

enum ReadResult {
    Ok { value: int32 },
    Err { error: string },
}

function readOne(ref h: FileHandle, fail: bool): ReadResult {
    if (fail) {
        return ReadResult.Err { error: "boom" };
    }
    return ReadResult.Ok { value: h.fd };
}

function go(fail: bool): ReadResult {
    disposable a: FileHandle = { fd: 5 };
    const v: int32 = readOne(ref a, fail)?;
    return ReadResult.Ok { value: v };
}

function main(): int32 {
    const r1: ReadResult = go(false);
    switch (r1) {
        case ReadResult.Ok { value: v1 }: { printf(`ok r1=${v1} err=''\n`); }
        case ReadResult.Err { error: e1 }: { printf(`ok r1=0 err='${e1}'\n`); }
    }
    const r2: ReadResult = go(true);
    switch (r2) {
        case ReadResult.Ok { value: v2 }: { printf(`fail r2=${v2} err=''\n`); }
        case ReadResult.Err { error: e2 }: { printf(`fail r2=0 err='${e2}'\n`); }
    }
    return 0;
}
