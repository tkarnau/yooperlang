function main(): int32 {
    let i: int32 = 0;
    let sum: int32 = 0;

    // sum 0..4 (break at 5)
    for (i = 0; i < 10; i = i + 1) {
        if (i == 5) { break; }
        sum = sum + i;
    }
    printf(`sum = ${sum}\n`);

    // sum only odd values 1..9 via continue
    let odd: int32 = 0;
    for (i = 0; i < 10; i = i + 1) {
        if (i == i / 2 * 2) { continue; }
        odd = odd + i;
    }
    printf(`odd = ${odd}\n`);

    return 0;
}

// expected output:
// sum = 10
// odd = 25
