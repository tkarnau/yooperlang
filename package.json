{
  "name": "yooperlang",
  "version": "0.2.0",
  "description": "A systems language with a TypeScript feel - no garbage collector, structs plus free functions, traits and kinds. Compiles to LLVM IR.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Tom Karnau",
  "homepage": "https://tkarnau.github.io/yooperlang/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkarnau/yooperlang.git"
  },
  "bugs": {
    "url": "https://github.com/tkarnau/yooperlang/issues"
  },
  "keywords": [
    "compiler",
    "programming-language",
    "systems-programming",
    "llvm",
    "language"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"src/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"src/**/!(selfhost|fail|pass|slice|debug|lsp).test.js\"",
    "test:e2e": "node --test --test-reporter=spec src/slice.test.js src/fail.test.js src/pass.test.js src/selfhost.test.js src/lsp.test.js",
    "test:slice": "node --test --test-reporter=spec src/slice.test.js",
    "test:lsp": "node --test --test-reporter=spec src/lsp.test.js",
    "test:fail": "node --test --test-reporter=spec src/fail.test.js",
    "test:pass": "node --test --test-reporter=spec src/pass.test.js",
    "test:selfhost": "node --test --test-reporter=spec src/selfhost.test.js",
    "test:debug": "node --test --test-reporter=spec src/debug.test.js",
    "package:boot": "node scripts/package_bootstrap.mjs",
    "gen:index": "node scripts/gen_std_index.mjs",
    "gen:web": "node scripts/gen_web.mjs"
  }
}
