{
  "name": "yooperlang",
  "version": "0.1.0",
  "description": "A systems language with a TypeScript feel - no garbage collector, structs plus free functions, traits and kinds. Compiles to LLVM IR.",
  "type": "module",
  "license": "MIT",
  "author": "Tom Karnau",
  "homepage": "https://tkarnau.github.io/yooperlang/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkarnau/yooperlang.git"
  },
  "bugs": {
    "url": "https://github.com/tkarnau/yooperlang/issues"
  },
  "keywords": [
    "compiler",
    "programming-language",
    "systems-programming",
    "llvm",
    "language"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "yoopiler_alpha": "src/yoopiler.js"
  },
  "files": [
    "src",
    "std",
    "runtime",
    "SPEC.md",
    "!src/**/*.test.js",
    "!runtime/tests"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec 'src/**/*.test.js'",
    "test:unit": "node --test --test-reporter=spec 'src/**/!(e2e).test.js'",
    "test:e2e": "node --test --test-reporter=spec src/e2e.test.js",
    "lsp": "node src/lsp/server.js",
    "build:sea": "node scripts/build_sea.mjs",
    "package": "node scripts/package_release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6"
  }
}
