// std/net/socket.yoop — safe envelope around a TCP socket fd.
//
// `Socket` is a thin Disposable around the raw fd returned by socket_ffi.
// Centralizes the close() path so TcpListener / TcpStream don't each
// re-implement disposal.
//
// `SocketResult` is an ordinary Disposable struct (not a "fallible" struct
// in the compiler's sense — its diagnostic lives in the `error` field).
// The caller's typical pattern is auto-cleanup at scope end:
//
//   disposable r: SocketResult = open_tcp_socket();
//   if (r.error.len > 0) { return ...; }
//   // operations on r.socket via `ref` borrow
//
// On the error path, r.socket holds fd=-1 and dispose is a no-op. On the
// success path, the socket is alive for the binding's lifetime; when
// `r` goes out of scope the autocleanup runs close(fd). If the caller
// wants to extend the socket's lifetime, the FUNCTION should declare
// `propagates<disposable>` on its return and return the result onward.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Result } from "../core/types.yoop";
import {
    ffi_socket_open,
    ffi_close,
} from "./socket_ffi.yoop";

// Hold an fd. fd < 0 means "no fd" (the result of an error path or
// after-dispose). dispose only calls close() when the fd is valid.
export type Socket implements Disposable propagates<disposable> {
    fd: c_int,
    function dispose(ref self): void {
        if (self.fd >= 0) {
            let rc: c_int = ffi_close(self.fd);
            self.fd = -1;
        }
    }
}

// SocketResult / open_tcp_socket are the safe surface — callers that
// need a raw socket reach through this rather than going to socket_ffi.
// Implements Disposable so the caller can `disposable r: SocketResult =
// open_tcp_socket()` and let autocleanup do the right thing.
export type SocketResult implements Disposable propagates<disposable> {
    socket: Socket,
    error:  string,
    function dispose(ref self): void {
        Disposable.dispose(ref self.socket);
    }
}

export function open_tcp_socket(): SocketResult propagates<disposable> {
    let r: Result<c_int, string> = ffi_socket_open();
    let fd: c_int = -1;
    let err_msg: string = "";
    switch (r) {
        case Result.Ok { value: ok_fd }: { fd = ok_fd; }
        case Result.Err { error: e }: { err_msg = e; }
    }
    return { socket: { fd: fd }, error: err_msg };
}
