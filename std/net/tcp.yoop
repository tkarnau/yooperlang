// std/net/tcp.yoop - TcpListener + TcpStream.
//
// Safe wrappers over std/net/socket_ffi. `TcpListener` owns a listening
// socket and exposes `tcp_accept`. `TcpStream` owns a connected socket
// and implements Readable + Writable + Disposable.
//
// All blocking operations (accept, read, write) park the calling pthread
// on the runtime multiplexer; if the caller wraps these in a `task` the
// suspension cooperates with the scheduler.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Result } from "../core/types.yoop";
import {
    Readable, Writable, FlushOutcome,
} from "../core/traits.yoop";
import { Socket } from "./socket.yoop";
import {
    AcceptedFd,
    ConnectOutcome,
    ffi_accept,
    ffi_close,
    ffi_connect,
    ffi_listen,
    ffi_recv,
    ffi_send_all,
    ffi_socket_open,
} from "./socket_ffi.yoop";

// ----- TcpListener --------------------------------------------------------

export type TcpListener implements Disposable propagates<disposable> {
    socket: Socket,
    bound_port: int32,    // remembered for diagnostics; the kernel may have
                          // assigned this if port=0 was passed in (not yet
                          // surfaced - we use the value the caller passed)
    function dispose(ref self): void {
        Disposable.dispose(ref self.socket);
    }
}

export type ListenResult implements Disposable propagates<disposable> {
    listener: TcpListener,
    error:    string,
    function dispose(ref self): void {
        Disposable.dispose(ref self.listener);
    }
}

// Open a TCP socket, bind it to host:port, and put it in the listening
// state. backlog is the maximum pending-connection queue length passed
// to listen(). The returned listener owns the socket; the error path
// leaves a TcpListener with fd=-1 (disposes are no-ops).
export function tcp_listen(host: string, port: int32, backlog: int32): ListenResult propagates<disposable> {
    let r: Result<c_int, string> = ffi_listen(host, port, backlog);
    let fd: c_int = -1;
    let err_msg: string = "";
    switch (r) {
        case Result.Ok { value: ok_fd }: { fd = ok_fd; }
        case Result.Err { error: e }: { err_msg = e; }
    }
    let bound: int32 = port;
    if (fd < 0) { bound = 0; }
    return {
        listener: { socket: { fd: fd }, bound_port: bound },
        error: err_msg,
    };
}

// ----- TcpStream ----------------------------------------------------------

// TcpStream is the workhorse: a connected TCP byte stream. Implements
// Readable + Writable + Disposable. Both read and write delegate to the
// task-shaped ffi helpers in socket_ffi, which park on the multiplexer
// before issuing recv/send.
export type TcpStream implements (Disposable, Readable, Writable) propagates<disposable> {
    socket: Socket,

    function dispose(ref self): void {
        Disposable.dispose(ref self.socket);
    }

    function read(ref self, ref buf: uint8[]): Result<c_ssize_t, string> {
        return ffi_recv(self.socket.fd, buf);
    }

    function write(ref self, ref buf: uint8[]): Result<c_ssize_t, string> {
        return ffi_send_all(self.socket.fd, buf);
    }

    function flush(ref self): FlushOutcome {
        // Unbuffered stream - flush is a no-op.
        return FlushOutcome.Ok;
    }
}

// ----- Accept --------------------------------------------------------------

export type AcceptResult implements Disposable propagates<disposable> {
    stream:    TcpStream,
    peer_host: uint32,
    peer_port: uint16,
    error:     string,
    function dispose(ref self): void {
        Disposable.dispose(ref self.stream);
    }
}

// Park on the listener's readability and accept one inbound connection.
// On success the returned AcceptResult.stream owns the client fd; the
// caller is responsible for disposing it (or letting auto-cleanup at
// scope end do so).
export function tcp_accept(ref l: TcpListener): AcceptResult propagates<disposable> {
    let r: Result<AcceptedFd, string> = ffi_accept(l.socket.fd);
    let fd: c_int = -1;
    let peer_host: uint32 = 0;
    let peer_port: uint16 = 0;
    let err_msg: string = "";
    switch (r) {
        case Result.Ok { value: ok }: {
            fd = ok.fd;
            peer_host = ok.peer_host;
            peer_port = ok.peer_port;
        }
        case Result.Err { error: e }: { err_msg = e; }
    }
    return {
        stream:    { socket: { fd: fd } },
        peer_host: peer_host,
        peer_port: peer_port,
        error:     err_msg,
    };
}

// ----- Connect (client-side) ----------------------------------------------

export type ConnectResult implements Disposable propagates<disposable> {
    stream: TcpStream,
    error:  string,
    function dispose(ref self): void {
        Disposable.dispose(ref self.stream);
    }
}

// Open a fresh socket and connect it to host:port. Returns the connected
// stream + error. On error, the inner socket holds fd=-1.
export function tcp_connect(host: string, port: int32): ConnectResult propagates<disposable> {
    let open: Result<c_int, string> = ffi_socket_open();
    let fd: c_int = -1;
    let open_err: string = "";
    switch (open) {
        case Result.Ok { value: ok_fd }: { fd = ok_fd; }
        case Result.Err { error: open_e }: { open_err = open_e; }
    }
    if (fd < 0) {
        return {
            stream: { socket: { fd: -1 } },
            error:  open_err,
        };
    }
    let c: ConnectOutcome = ffi_connect(fd, host, port);
    switch (c) {
        case ConnectOutcome.Ok: {
            return {
                stream: { socket: { fd: fd } },
                error:  "",
            };
        }
        case ConnectOutcome.Err { error: connect_e }: {
            let _rc: c_int = ffi_close(fd);
            return {
                stream: { socket: { fd: -1 } },
                error:  connect_e,
            };
        }
    }
    // Unreachable.
    return { stream: { socket: { fd: -1 } }, error: "" };
}
