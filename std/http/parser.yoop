module http;

// std/http/parser.yoop - HTTP/1.1 message-head parsing.
//
// Two entry points, one for each direction:
//
//   parseRequestHead(buf)  -> Result<ParsedRequest, HttpError>    (server side)
//   parseResponseHead(buf) -> Result<ParsedResponse, HttpError>   (client side)
//
// Both take the bytes accumulated so far and parse up to the blank line that
// ends the head. Neither reads the body: they report where it starts and how
// long it is, and the caller (which owns the socket) decides how to get the
// rest. That split is what lets both parsers be exercised against a byte
// literal with no sockets involved.
//
// The strings inside a parsed message are fresh copies, not views into `buf`,
// so the parse result stays valid after the read buffer is reused.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Result, Option } from "../core/types.yoop";
import * as bytes from "../core/bytes.yoop";
import * as intr from "../core/intrinsics.yoop";

// ----- parsed request -----------------------------------------------------

// A parsed request head plus where its body lives. `bodyStart` is an offset
// into the buffer that was parsed; `info.contentLength` is `None` when the
// message declared no length, which for a request means "no body" and for a
// response means "read until the peer closes".
export type ParsedRequest implements Disposable propagates<disposable> {
    request:   Request,
    bodyStart: usize,
    info:      HeadInfo,
    function dispose(ref self): void {
        Disposable.dispose(ref self.request);
    }
}

// Body length the caller should expect, with the "no header" case collapsed
// to 0 (a request with no Content-Length has no body).
export function expectedBodyLen(ref p: ParsedRequest): usize {
    switch (p.info.contentLength) {
        case Option.Some { value: n }: { return n; }
        case Option.None: { return 0; }
    }
}

// ----- parsed response ----------------------------------------------------

export type ParsedResponse implements Disposable propagates<disposable> {
    status:    StatusCode,
    headers:   Headers,
    bodyStart: usize,
    info:      HeadInfo,
    function dispose(ref self): void {
        Disposable.dispose(ref self.headers);
    }
}

// ----- shared bits --------------------------------------------------------

// Offset of the head-terminating blank line, or an error when the caller
// handed us an incomplete head. Callers loop on `findHeadEnd` before
// getting here, so reaching this error means a genuinely malformed message.
function requireHeadEnd(buf: uint8[], what: string): Result<usize, HttpError> {
    let headEnd: usize = findHeadEnd(buf);
    if (headEnd == buf.len) {
        return Result.Err { error: errBadRequest(`${what} head is missing the blank line that ends it`) };
    }
    return Result.Ok { value: headEnd };
}

// End offset of the first line (the request line or the status line).
function firstLineEnd(buf: uint8[], headEnd: usize, what: string): Result<usize, HttpError> {
    let head: uint8[] = bytes.bytes_slice(buf, 0, headEnd);
    let cr: usize = bytes.bytes_index_of(head, '\r');
    if (cr == head.len) {
        return Result.Err { error: errBadRequest(`${what} line is not CRLF terminated`) };
    }
    return Result.Ok { value: cr };
}

// The only versions this implementation speaks. A 1.0 client gets 1.1
// framing back, which is compatible for the connection-close style the
// server uses.
function checkVersion(versionBytes: uint8[]): Result<string, HttpError> {
    let v: string = intr.string_from_bytes_unchecked(versionBytes);
    if (bytes.bytes_eq(versionBytes, intr.string_as_bytes("HTTP/1.1"))) {
        return Result.Ok { value: v };
    }
    if (bytes.bytes_eq(versionBytes, intr.string_as_bytes("HTTP/1.0"))) {
        return Result.Ok { value: v };
    }
    return Result.Err { error: httpError(status(505), `unsupported HTTP version "${v}"`) };
}

// ----- request ------------------------------------------------------------

// Everything that allocates into the request happens here, so the caller can
// dispose the half-built request on failure with one call instead of
// remembering to do it at four separate error returns.
function fillRequest(
    buf: uint8[],
    headerStart: usize,
    headEnd: usize,
    ref req: Request,
): Result<HeadInfo, HttpError> {
    let info: HeadInfo = readHeaderLines(buf, headerStart, headEnd, ref req.headers)?;

    // Split the raw target first, decode the pieces after. Decoding before
    // splitting would let "%2F" forge a path separator or an extra query
    // parameter; `decodePath` additionally rejects an encoded separator
    // rather than folding it into the decoded path.
    let parts: TargetParts = splitTarget(req.target);
    req.path = decodePath(parts.path)? `decoding request path "${parts.path}"`;
    let _pairs: usize = parseQuery(parts.queryString, ref req.query)?;
    return Result.Ok { value: info };
}

// Parse a request head out of `buf`. The caller should have accumulated at
// least through the blank line; pass the whole buffer and the boundary is
// found internally.
export function parseRequestHead(buf: uint8[]): Result<ParsedRequest, HttpError> {
    let headEnd: usize = requireHeadEnd(buf, "request")?;
    let lineEnd: usize = firstLineEnd(buf, headEnd, "request")?;

    // request-line = method SP request-target SP HTTP-version
    let line: uint8[] = bytes.bytes_slice(buf, 0, lineEnd);
    let sp1: usize = bytes.bytes_index_of(line, ' ');
    if (sp1 == line.len) {
        return Result.Err { error: errBadRequest("request line has no space after the method") };
    }
    let afterMethod: uint8[] = bytes.bytes_slice(line, sp1 + 1, line.len);
    let sp2: usize = bytes.bytes_index_of(afterMethod, ' ');
    if (sp2 == afterMethod.len) {
        return Result.Err { error: errBadRequest("request line has no space after the target") };
    }

    let methodBytes: uint8[] = bytes.bytes_slice(line, 0, sp1);
    let method: HttpMethod = HttpMethod.Get;
    switch (methodFromBytes(methodBytes)) {
        case Option.Some { value: m }: { method = m; }
        case Option.None: {
            let token: string = intr.string_from_bytes_unchecked(methodBytes);
            return Result.Err { error: httpError(notImplemented(), `unsupported method "${token}"`) };
        }
    }

    let targetBytes: uint8[] = bytes.bytes_slice(afterMethod, 0, sp2);
    if (targetBytes.len == 0) {
        return Result.Err { error: errBadRequest("request line has an empty target") };
    }
    let version: string = checkVersion(bytes.bytes_slice(afterMethod, sp2 + 1, afterMethod.len))?;

    let req: Request = requestNew(method, intr.string_from_bytes_unchecked(targetBytes));
    req.version = version;
    switch (fillRequest(buf, lineEnd + 2, headEnd, ref req)) {
        case Result.Ok { value: info }: {
            return Result.Ok {
                value: { request: req, bodyStart: headEnd + 4, info: info },
            };
        }
        case Result.Err { error: e }: {
            // The request owns three Vecs by now; give them back before the
            // error leaves.
            Disposable.dispose(ref req);
            return Result.Err { error: e };
        }
    }
}

// ----- response -----------------------------------------------------------

// Parse a response head. Shape mirrors `parseRequestHead`; the only real
// difference is the first line.
export function parseResponseHead(buf: uint8[]): Result<ParsedResponse, HttpError> {
    let headEnd: usize = requireHeadEnd(buf, "response")?;
    let lineEnd: usize = firstLineEnd(buf, headEnd, "status")?;

    // status-line = HTTP-version SP status-code SP [ reason-phrase ]
    let line: uint8[] = bytes.bytes_slice(buf, 0, lineEnd);
    let sp1: usize = bytes.bytes_index_of(line, ' ');
    if (sp1 == line.len) {
        return Result.Err { error: errBadRequest("status line has no space after the version") };
    }
    let _version: string = checkVersion(bytes.bytes_slice(line, 0, sp1))?;

    let afterVersion: uint8[] = bytes.bytes_slice(line, sp1 + 1, line.len);
    let sp2: usize = bytes.bytes_index_of(afterVersion, ' ');
    let codeBytes: uint8[] = bytes.bytes_slice(afterVersion, 0, sp2);
    let code: int32 = 0;
    switch (bytes.bytes_parse_int(codeBytes)) {
        case Result.Ok { value: bp }: {
            if (bp.consumed != codeBytes.len) {
                return Result.Err { error: errBadRequest("status code has trailing characters") };
            }
            code = int32(bp.value);
        }
        case Result.Err { error: _e }: {
            return Result.Err { error: errBadRequest("status code is not a number") };
        }
    }
    if (code < 100 || code > 599) {
        return Result.Err { error: errBadRequest(`status code ${code} is out of range`) };
    }

    let headers: Headers = headersNew(8);
    switch (readHeaderLines(buf, lineEnd + 2, headEnd, ref headers)) {
        case Result.Ok { value: info }: {
            return Result.Ok {
                value: {
                    status:    { code: code, class: statusClassFor(code) },
                    headers:   headers,
                    bodyStart: headEnd + 4,
                    info:      info,
                },
            };
        }
        case Result.Err { error: e }: {
            Disposable.dispose(ref headers);
            return Result.Err { error: e };
        }
    }
}
