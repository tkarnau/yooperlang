module http;

// std/http/server.yoop - the accept loop, the `Handler` trait, and the
// request/response exchange on one connection.
//
// Shape of the module:
//
//   Handler        the trait user code implements
//   Dispatcher     the vtable for it, so the server is not generic
//   ServerConfig   the limits (head size, body size, requests per connection)
//   serve          the serial loop, over a `Dispatcher` and a config
//   serveDefault   the same loop with the default config
//   serveConcurrent  a task per connection, bounded by a caller-owned
//                    `ServeState` that doubles as the introspection surface
//
// Three things changed from the first cut and are worth knowing:
//
//   1. **The loop is not generic.** It takes a `Dispatcher`, the Phase 9.G
//      vtable for `Handler`, so there is one copy of the serve machinery no
//      matter how many handler types a program has - and the per-connection
//      work could finally be split into named functions, which a generic
//      calling a generic across module boundaries would not survive.
//   2. **A bad client no longer kills the server.** A malformed request gets
//      the status its error carries (400, 413, 501, 505) and the connection
//      is dropped; the accept loop keeps going. Only a failure of the
//      listener itself ends `serve`.
//   3. **Connections are reused.** HTTP/1.1 keep-alive is the default; a
//      request asking for `Connection: close`, a 1.0 request, or hitting
//      `maxRequestsPerConnection` ends the connection cleanly.
//
// TWO accept loops, and the difference matters:
//
//   serve            one connection at a time. Awaits each to completion
//                    before accepting the next, so one slow client stalls
//                    every other. Right for a bounded fixture, wrong for a
//                    server.
//   serveConcurrent  a task per connection, bounded, with a 503 at capacity.
//                    Takes a caller-owned `ServeState` that both bounds it and
//                    reports on it. This is the one a real server wants.
//
// `serveConnection` stays exported so a program with its own accept strategy
// can still reuse the per-connection half.
//
// **Nothing below the accept boundary knows what a socket is.** Every reader
// and writer parameter here is a `Reader` / `Writer` - the type-erased vtables
// from std/core/traits.yoop - so the same code serves a TcpStream, an
// in-memory buffer (examples/pass/http_no_socket), or a TlsStream once one
// exists. The concrete stream is erased in exactly three places: `serve`,
// `connectionTask`, and the client's `send`. See plans/tls.md phase 0.
//
// One known limitation, stated plainly.
//
// Strings built while parsing a request are never freed, so a long-lived
// server's memory grows with the distinct header values it has seen. Note
// what this is NOT: `string_from_bytes_unchecked` mallocs and copies (see
// its codegen, and the `_from_` naming convention in std/core/strings.yoop),
// and it returns `owned string`, so `strings.strFree` accepts these and the
// storage is releasable. What is missing is the bookkeeping - Request and
// Headers do not track which of their strings they own, so there is nothing
// safe to hand to strFree at the end of an exchange. A per-request arena is
// the other candidate fix and does not work as things stand, because this
// allocation goes to malloc directly rather than through the ambient
// allocator.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Result, Option } from "../core/types.yoop";
import { Readable, Writable, Reader, Writer } from "../core/traits.yoop";
import * as vec, { Vec } from "../core/vec.yoop";
import * as str from "../core/strings.yoop";
import * as bytes, { Bytes } from "../core/bytes.yoop";
import * as intr from "../core/intrinsics.yoop";
import * as tcp, { AcceptOutcome, TcpListener, TcpStream } from "../net";
import * as atomic from "../core/atomic.yoop";

// stdout is block-buffered when it is not a terminal, which would make the
// access log appear in bursts (or not at all, if the process is killed).
// A server's log is only useful live, so each line is flushed. Passing 0 for
// the `FILE *` is the null-stream form, which flushes every open stream.
extern "C" from "stdio.h" {
    function fflush(stream: int64): int32;
}

// ----- Handler ------------------------------------------------------------

// What a handler reports. `Ok` means it wrote a response; `Err` hands the
// failure back to the server, which renders it with the status the error
// carries. A handler that cannot decide should return an `HttpError` rather
// than writing a 500 itself, so the shape of an error page stays in one place.
export variant HandleOutcome {
    Ok,
    Err { error: HttpError },
}

// Trait indicating the type will implement functionality for handling an http request
// `handle` is ASYNC, which is what makes a handler able to do I/O of its own.
//
// It was deliberately synchronous at first, to bound how far the async colour
// spread: a handler takes a buffered request and fills a response, so there
// was nothing for it to await. But `client.send` IS async, so a synchronous
// handler cannot call the HTTP client - and that means a PROXY cannot be
// written, which is every sidecar, gateway, and load balancer there is.
//
// A handler that does no I/O simply declares `async` and never awaits; an
// async function that never suspends runs straight through on its first step
// and costs one frame allocation. See examples/pass/http_proxy for the shape
// this exists to allow.
export trait Handler {
    async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome;
}

// The type-erased view of a Handler. Routers and middleware hold these
// instead of monomorphizing over every handler type.
//
// A `Dispatcher` stores a POINTER to the handler it was built from, so the
// handler has to outlive it. Build them from bindings that live as long as
// the server does (locals in `main` is the usual shape), never from a value
// that goes out of scope while the route table keeps running.
export vtable Dispatcher for Handler {
    handle: (ref req: Request, ref resp: Response) => HandleOutcome,
}

// ----- configuration ------------------------------------------------------

// The limits that keep one client from being able to exhaust the server.
// Every one of them has a defensible default and none of them is unlimited.
export type ServerConfig {
    maxHeadBytes:              usize,   // request line + headers
    // Body ceiling. Under Content-Length it is checked against the declared
    // length before a byte is read; under chunked it bounds the DECODED total
    // as the chunks arrive, which is the number that matters - a sender can
    // inflate the raw byte count with tiny chunks and extensions.
    maxBodyBytes:              usize,
    readChunk:                 usize,   // per-recv scratch size
    maxRequestsPerConnection:  int32,   // keep-alive ceiling, <= 0 for one
    logRequests:               bool,
}

export function defaultConfig(): ServerConfig {
    return {
        maxHeadBytes:             16384,
        maxBodyBytes:             1048576,   // 1 MiB
        readChunk:                4096,
        maxRequestsPerConnection: 100,
        logRequests:              false,
    };
}

// ----- reading ------------------------------------------------------------

// Read until the head-terminating blank line is in `buf`, or the head limit
// is hit. Returns `None` when the peer closed cleanly before sending anything
// (the normal end of a keep-alive connection) and `Some { offset }` otherwise.
async readRequestHead(
    ref r: Reader,
    ref buf: Vec<uint8>,
    ref scratch: Bytes,
    cfg: ServerConfig,
): Result<Option<usize>, HttpError> {
    // Bytes left over from the previous request on this connection may
    // already contain a whole head.
    let pre: usize = findHeadEnd(vec.vec_as_array(ref buf));
    if (pre != buf.len) { return Result.Ok { value: Option.Some { value: pre } }; }

    let window: uint8[] = bytes.bytes_to_array(ref scratch);
    while (true) {
        let n: usize = await readRequestBytes(ref r, ref window)? "reading the request head";
        if (n == 0) {
            if (buf.len == 0) { return Result.Ok { value: Option.None }; }
            return Result.Err { error: errBadRequest("connection closed mid-head") };
        }
        vec.vec_extend_from(ref buf, intr.array_slice(window, 0, n));

        let at: usize = findHeadEnd(vec.vec_as_array(ref buf));
        if (at != buf.len) { return Result.Ok { value: Option.Some { value: at } }; }
        if (buf.len > cfg.maxHeadBytes) {
            return Result.Err {
                error: httpError(status(431), `request head exceeded ${cfg.maxHeadBytes} bytes`),
            };
        }
    }
}

// One recv, with the error mapped into the layer's error type. Byte-identical
// to `readResponseBytes` in client.yoop; the two differ only in the peer they
// are reading from. It does not live in yoop because yoop is
// deliberately socket-free (that is what lets the parsers be tested against a
// byte literal), so the duplicate stands until std/http is one module and one
// private copy can serve both directions.
async readRequestBytes(ref r: Reader, ref window: uint8[]): Result<usize, HttpError> {
    switch (await Reader.read(ref r, ref window)) {
        case Result.Ok { value: n }: { return Result.Ok { value: usize(n) }; }
        case Result.Err { error: e }: { return Result.Err { error: errIo(e) }; }
    }
}

// Top up `buf` until it holds `bodyStart + need` bytes.
async readBody(
    ref r: Reader,
    ref buf: Vec<uint8>,
    ref scratch: Bytes,
    bodyStart: usize,
    need: usize,
): Result<usize, HttpError> {
    let window: uint8[] = bytes.bytes_to_array(ref scratch);
    while (buf.len < bodyStart + need) {
        let n: usize = await readRequestBytes(ref r, ref window)? "reading the request body";
        if (n == 0) {
            return Result.Err { error: errBadRequest("connection closed mid-body") };
        }
        vec.vec_extend_from(ref buf, intr.array_slice(window, 0, n));
    }
    return Result.Ok { value: need };
}

// Read a chunked body, decoding as it arrives.
//
// Returns the number of RAW bytes the body occupied, which is what the caller
// needs to find the start of the next pipelined request - not the decoded
// length, which is `out.len`.
//
// The decoder is incremental (see chunkedFeed in wire.yoop), so each read
// examines only the bytes it added rather than re-walking the whole buffer.
async readChunkedBody(
    ref r: Reader,
    ref buf: Vec<uint8>,
    ref scratch: Bytes,
    bodyStart: usize,
    ref out: Vec<uint8>,
    maxBody: usize,
): Result<usize, HttpError> {
    let window: uint8[] = bytes.bytes_to_array(ref scratch);
    let reader: ChunkedReader = chunkedReaderNew(bodyStart);

    while (true) {
        // Re-take the view every pass: the read below may have grown and
        // therefore MOVED the Vec's buffer.
        let done: bool = chunkedFeed(vec.vec_as_array(ref buf), ref reader, ref out, maxBody)?;
        if (done) { return Result.Ok { value: reader.end }; }

        let n: usize = await readRequestBytes(ref r, ref window)? "reading the chunked request body";
        if (n == 0) {
            return Result.Err { error: errBadRequest("connection closed mid-chunk") };
        }
        vec.vec_extend_from(ref buf, intr.array_slice(window, 0, n));
    }
}

// Drop the first `n` bytes of `buf`, keeping whatever followed at the front.
// That tail is the start of the next pipelined request; it is usually empty.
function compact(ref buf: Vec<uint8>, n: usize): void {
    if (n >= buf.len) {
        vec.vec_clear(ref buf);
        return;
    }
    let view: uint8[] = vec.vec_as_array(ref buf);
    disposable tail: Bytes = bytes.bytes_from_array(intr.array_slice(view, n, view.len));
    vec.vec_clear(ref buf);
    vec.vec_extend_from(ref buf, bytes.bytes_to_array(ref tail));
}

// ----- writing ------------------------------------------------------------

// Serialize and send. `headOnly` suppresses the body (a HEAD reply carries
// the headers the GET would have, including its Content-Length, and no body).
async writeResponse(
    ref w: Writer,
    ref resp: Response,
    keepAlive: bool,
    headOnly: bool,
): Result<usize, HttpError> {
    let body: uint8[] = responseBodyBytes(ref resp);

    disposable out: Vec<uint8> = vec.vec_new(512 + body.len);
    pushStr(ref out, `HTTP/1.1 ${resp.status.code} ${reasonPhrase(resp.status.code)}`);
    pushCrlf(ref out);

    // The server owns framing. A handler that set Content-Length or
    // Connection itself would be able to desynchronize the stream from the
    // client's idea of it, so those two are written here and skipped below.
    pushHeaderLine(ref out, "Content-Length", `${body.len}`);
    if (keepAlive) {
        pushHeaderLine(ref out, "Connection", "keep-alive");
    } else {
        pushHeaderLine(ref out, "Connection", "close");
    }

    for e in headersView(ref resp.headers) {
        if (isFramingHeader(e.name)) { continue; }
        pushHeaderLine(ref out, e.name, e.value);
    }
    pushCrlf(ref out);

    if (!headOnly) {
        pushBytes(ref out, body);
    }

    let view: uint8[] = vec.vec_as_array(ref out);
    switch (await Writer.write(ref w, ref view)) {
        case Result.Ok { value: n }: { return Result.Ok { value: usize(n) }; }
        case Result.Err { error: e }: { return Result.Err { error: errIo(e) }; }
    }
    return Result.Ok { value: 0 };
}

function isFramingHeader(name: string): bool {
    return str.string_eq_ignore_ascii_case(name, "Content-Length")
        || str.string_eq_ignore_ascii_case(name, "Connection")
        || str.string_eq_ignore_ascii_case(name, "Transfer-Encoding");
}

// A header value carrying CR or LF would let a handler inject a second
// message into the stream (response splitting). Rather than sanitize and
// carry on, the whole response is replaced: a handler that produced one is
// broken, and truncating its output quietly is worse than a visible 500.
function checkResponseHeaders(ref resp: Response): bool {
    for e in headersView(ref resp.headers) {
        if (!isValidHeaderValue(e.value) || !isValidHeaderValue(e.name)) {
            return false;
        }
    }
    return true;
}

// ----- one exchange -------------------------------------------------------

// Parse, dispatch, and let the caller turn any failure into a response. The
// request lives only for the duration of this call.
async exchange(
    ref r: Reader,
    ref w: Writer,
    ref buf: Vec<uint8>,
    ref scratch: Bytes,
    ref decoded: Vec<uint8>,
    ref d: Dispatcher,
    cfg: ServerConfig,
    ref resp: Response,
    ref meta: ExchangeMeta,
): Result<usize, HttpError> {
    let disposable pr: ParsedRequest = parseRequestHead(vec.vec_as_array(ref buf))?;

    if (pr.info.chunked) {
        // A chunked body is decoded into `decoded`, which is connection-owned
        // and lives past this call - so the view handed to the handler stays
        // valid for as long as the Content-Length path's view into `buf` does.
        vec.vec_clear(ref decoded);
        let raw: usize = await readChunkedBody(
            ref r, ref buf, ref scratch, pr.bodyStart, ref decoded, cfg.maxBodyBytes)?;
        pr.request.body = vec.vec_as_array(ref decoded);
        // RAW bytes, not decoded: this is where the next pipelined request
        // begins, and the chunk framing was part of the message.
        meta.consumed = raw;
    } else {
        let need: usize = expectedBodyLen(ref pr);
        if (need > cfg.maxBodyBytes) {
            return Result.Err {
                error: httpError(payloadTooLarge(), `body of ${need} bytes exceeds the ${cfg.maxBodyBytes} byte limit`),
            };
        }
        let _got: usize = await readBody(ref r, ref buf, ref scratch, pr.bodyStart, need)?;

        // The read above may have grown (and moved) the buffer, so the body
        // view has to be taken after it, not before.
        let view: uint8[] = vec.vec_as_array(ref buf);
        pr.request.body = intr.array_slice(view, pr.bodyStart, pr.bodyStart + need);
        meta.consumed = pr.bodyStart + need;
    }

    meta.headOnly = methodEq(pr.request.method, HttpMethod.Head);
    // HTTP/1.0 defaults to close; 1.1 defaults to keep-alive.
    meta.clientWantsClose = pr.info.connectionClose
        || !str.string_eq(pr.request.version, "HTTP/1.1");
    meta.line = `${methodLabel(pr.request.method)} ${pr.request.target}`;

    switch (await Dispatcher.handle(ref d, ref pr.request, ref resp)) {
        case HandleOutcome.Ok: { return Result.Ok { value: meta.consumed }; }
        case HandleOutcome.Err { error: e }: { return Result.Err { error: e }; }
    }
    return Result.Ok { value: meta.consumed };
}

// What `exchange` learned about the message, for the connection loop. It is
// filled even on the failure paths that got far enough to know it, so the
// access log and the framing decision do not depend on the handler running.
type ExchangeMeta {
    consumed:         usize,
    headOnly:         bool,
    clientWantsClose: bool,
    line:             string,
}

function newMeta(): ExchangeMeta {
    return { consumed: 0, headOnly: false, clientWantsClose: false, line: "-" };
}

// Serve requests on one accepted connection until it closes. Returns the
// number of requests answered. Connection-level failures end the connection,
// not the server, so this swallows its error after reporting it as a
// response where that is still possible.
//
// Exported because `serve` below runs connections ONE AT A TIME - it awaits
// each to completion before accepting the next, so a single keep-alive
// client that goes idle stalls every other client. That is fine for the
// bounded fixtures `serve` was written for and wrong for a real server, so
// a caller that needs concurrency writes its own accept loop and spawns a
// task per connection around this. See examples/playground/counter_server.
export async serveConnection(
    ref stream: TcpStream,
    ref d: Dispatcher,
    cfg: ServerConfig,
    budget: int32,
): int32 {
    // The socket-shaped front door. Builds the erased pair and hands off, so
    // the existing signature keeps working for callers with their own accept
    // loop (examples/playground/counter_server).
    //
    // The two views hold POINTERS to `stream`, which outlives this call by
    // construction - the caller owns it. Same rule `Dispatcher` has.
    let r: Reader = Reader.from(ref stream);
    let w: Writer = Writer.from(ref stream);
    return await serveConnectionOn(ref r, ref w, ref d, cfg, budget);
}

// Serve requests on one already-erased connection.
//
// This is the one that does the work, and it does not know what it is talking
// to. A TcpStream, a TlsStream, or a pair of in-memory buffers all reach it
// the same way, which is the whole point of taking `Reader`/`Writer` rather
// than a concrete stream - see std/core/traits.yoop, which declares those
// vtables for exactly this case.
//
// Reading and writing are SEPARATE views on purpose. They usually come from
// one stream, but nothing here requires that, which is what lets a test drive
// a request in from one buffer and collect the response in another.
export async serveConnectionOn(
    ref r: Reader,
    ref w: Writer,
    ref d: Dispatcher,
    cfg: ServerConfig,
    budget: int32,
): int32 {
    let served: int32 = 0;
    let limit: int32 = cfg.maxRequestsPerConnection;
    if (limit <= 0) { limit = 1; }
    // `budget` is what is left of the caller's `n`; a bounded run must not
    // overshoot it just because keep-alive would have allowed more.
    if (budget > 0 && budget < limit) { limit = budget; }

    disposable buf: Vec<uint8> = vec.vec_new(cfg.readChunk);
    disposable scratch: Bytes = bytes.bytes_from_raw(intr.heap_alloc(cfg.readChunk), cfg.readChunk);
    // Decoded chunked bodies land here. Connection-owned rather than
    // per-request so the handler's view outlives `exchange`, and started small
    // rather than at readChunk because a connection that never sends a chunked
    // body should not pay for one - it grows on first use and is then reused
    // for the rest of the connection.
    disposable decoded: Vec<uint8> = vec.vec_new(64);

    while (served < limit) {
        // Head first: a clean close here is how a keep-alive connection ends.
        let headAt: Option<usize> = Option.None;
        switch (await readRequestHead(ref r, ref buf, ref scratch, cfg)) {
            case Result.Ok { value: at }: { headAt = at; }
            case Result.Err { error: e }: {
                let _ignored: bool = await replyWithError(ref w, ref e, cfg);
                return served;
            }
        }
        switch (headAt) {
            case Option.Some { value: _at }: { }
            case Option.None: { return served; }
        }

        disposable resp: Response = responseNew();
        let meta: ExchangeMeta = newMeta();
        let failed: bool = false;
        switch (await exchange(ref r, ref w, ref buf, ref scratch, ref decoded, ref d, cfg, ref resp, ref meta)) {
            case Result.Ok { value: _n }: { }
            case Result.Err { error: e }: {
                respondError(ref resp, ref e);
                failed = true;
            }
        }
        if (!checkResponseHeaders(ref resp)) {
            let broken: HttpError = errInternal("handler produced a header value containing CR or LF");
            respondError(ref resp, ref broken);
            failed = true;
        }

        served = served + 1;
        let keepAlive: bool = !failed
            && !meta.clientWantsClose
            && served < limit;

        if (cfg.logRequests) {
            printf(`${meta.line} -> ${resp.status.code}\n`);
            let _f: int32 = fflush(0);
        }

        switch (await writeResponse(ref w, ref resp, keepAlive, meta.headOnly)) {
            case Result.Ok { value: _n }: { }
            case Result.Err { error: _e }: { return served; }
        }
        if (!keepAlive) { return served; }
        compact(ref buf, meta.consumed);
    }
    return served;
}

// Last-ditch reply for a failure that happened before there was a response to
// put it in (a head that was too large, a socket that died mid-head). Best
// effort: if this write fails too, the connection is gone anyway.
async replyWithError(ref w: Writer, ref e: HttpError, cfg: ServerConfig): bool {
    disposable resp: Response = responseNew();
    respondError(ref resp, ref e);
    if (cfg.logRequests) {
        printf(`- -> ${resp.status.code} (${e.message})\n`);
        let _f: int32 = fflush(0);
    }
    switch (await writeResponse(ref w, ref resp, false, false)) {
        case Result.Ok { value: _n }: { return true; }
        case Result.Err { error: _e2 }: { return false; }
    }
    return false;
}

// ----- the loop -----------------------------------------------------------

// Accept and serve until `n` requests have been answered. `n <= 0` runs
// forever. The listener stays owned by the caller (the usual shape is a
// `disposable lr: ListenResult = tcp.tcp_listen(...)`).
//
// Only a listener failure ends this loop. Anything a connection does to
// itself - malformed bytes, an abrupt close, a handler error - costs that
// connection and nothing else.
export async serve(
    ref l: TcpListener,
    ref d: Dispatcher,
    cfg: ServerConfig,
    n: int32,
): Result<int32, HttpError> {
    let served: int32 = 0;
    let unbounded: bool = n <= 0;
    while (unbounded || served < n) {
        let budget: int32 = 0;
        if (!unbounded) { budget = n - served; }
        // The accept SUSPENDS rather than parking a thread, so a server
        // waiting on an idle listener costs a coroutine frame and no
        // worker. Same for every read and write inside serveConnection.
        switch (await tcp.tcpAcceptAsync(ref l)) {
            case AcceptOutcome.Accepted { stream: st, peerHost: _h, peerPort: _p }: {
                disposable conn: TcpStream = st;
                served = served + await serveConnection(ref conn, ref d, cfg, budget);
            }
            case AcceptOutcome.TimedOut: {
                // No deadline was set, so this is not reachable today.
                // Treated as "keep waiting" rather than an error.
            }
            case AcceptOutcome.Cancelled: {
                return Result.Ok { value: served };
            }
            case AcceptOutcome.Err { error: e }: {
                return Result.Err { error: errIo(e) };
            }
        }
    }
    return Result.Ok { value: served };
}

// ----- concurrent serve ----------------------------------------------------
//
// `serve` above handles one connection at a time: it AWAITS each to completion
// before accepting the next, so one slow client stalls every other. That is
// fine for a bounded fixture and wrong for anything else.
//
// `serveConcurrent` spawns a task per connection instead. The shape is
// constrained in three ways that are worth writing down, because each one
// ruled out a design that looks more obvious:
//
//   1. ONE accept loop, not N acceptor tasks. The multiplexer allows one
//      waiter per (fd, direction) - a second task awaiting accept on the same
//      listener gets EAGAIN back, not a queued turn. So the "K workers all
//      calling accept" model does not work here.
//   2. Connections are FIRE AND FORGET. A `Task<T>` handle cannot be put in an
//      array or a Vec - the typechecker requires a kind-prefixed binding
//      (`pooled h = f()`), which is what manages its refcount - so there is no
//      collection of in-flight handles to await on. The handle is released at
//      the end of the accept arm and the task runs on.
//   3. The counter therefore lives with the CALLER, not in this function's
//      frame. Because connections outlive the accept loop, a pointer into
//      `serveConcurrent`'s own frame would dangle the moment it returned.
//
// That third constraint is a gift: since the state has to be caller-owned
// anyway, it may as well be readable, so `ServeState` carries the numbers a
// running server should be able to report about itself.

// Live counters for one concurrent server. The CALLER owns it and it must
// outlive every connection - see constraint 3 above.
//
// Every field is touched from several workers at once, so all of them are read
// and written through std/core/atomic. Reading them from outside while the
// server runs is fine and is the point: this is the introspection surface.
export type ServeState {
    // Connections currently being served.
    inFlight:      int32,
    // High-water mark of `inFlight`. The one number that cannot be
    // reconstructed after the fact from the others.
    peak:          int32,
    // Connections accepted and handed to a task.
    accepted:      int32,
    // Connections refused with a 503 because the server was at capacity.
    rejected:      int32,
    // Requests answered, summed across finished connections.
    served:        int32,
    // The ceiling on `inFlight`. Zero or less means "one at a time", which
    // makes `serveConcurrent` behave like `serve`.
    maxConcurrent: int32,
}

export function serveStateNew(maxConcurrent: int32): ServeState {
    let m: int32 = maxConcurrent;
    if (m <= 0) { m = 1; }
    return {
        inFlight: 0, peak: 0, accepted: 0, rejected: 0, served: 0,
        maxConcurrent: m,
    };
}

// Snapshot readers, so a caller does not have to know these are atomic.
export function serveInFlight(ref s: ServeState): int32 { return atomic.loadI32(ref s.inFlight); }
export function servePeak(ref s: ServeState): int32     { return atomic.loadI32(ref s.peak); }
export function serveAccepted(ref s: ServeState): int32 { return atomic.loadI32(ref s.accepted); }
export function serveRejected(ref s: ServeState): int32 { return atomic.loadI32(ref s.rejected); }
export function serveServed(ref s: ServeState): int32   { return atomic.loadI32(ref s.served); }

// The canned refusal. Written by hand rather than built through `Response`
// because it has to be cheap: this is the path a server takes when it is
// already overloaded, and it must not allocate a header map to say so.
const BUSY_RESPONSE: string = "HTTP/1.1 503 Service Unavailable\r\nContent-Type: text/plain\r\nContent-Length: 25\r\nConnection: close\r\nRetry-After: 1\r\n\r\n503 Service Unavailable\r\n";

// One connection, on its own task.
//
// Takes the stream BY VALUE: ownership moves here, and the `disposable`
// binding closes it on every path out. `d` and `cfg` are copies - a
// `Dispatcher` is a context pointer plus method slots, and the handler it
// points at outlives the server by construction.
//
// `counters` is a pointer into the caller's `ServeState`. The decrement at the
// end is what frees the slot, and it must happen on every exit - which it
// does, because `serveConnection` swallows its own failures and returns a
// count rather than propagating.
task connectionTask(
    st: TcpStream,
    d: Dispatcher,
    cfg: ServerConfig,
    ref inFlight: int32,
    ref servedTotal: int32,
): int32 {
    disposable conn: TcpStream = st;
    let n: int32 = await serveConnection(ref conn, ref d, cfg, 0);
    let _total: int32 = atomic.addI32(ref servedTotal, n);
    let _left: int32 = atomic.decrI32(ref inFlight);
    return n;
}

// Write the 503 and drop the connection. Deliberately ignores its own write
// error: the client is being refused either way, and a server at capacity has
// nothing useful to do about a refusal that did not land.
async refuse(ref w: Writer): void {
    let out: uint8[] = intr.string_as_bytes(BUSY_RESPONSE);
    switch (await Writer.write(ref w, ref out)) {
        case Result.Ok { value: _n }: { }
        case Result.Err { error: _e }: { }
    }
}

// Accept forever, serving each connection on its own task.
//
// `n` bounds how many connections are ACCEPTED (not completed), so a bounded
// run returns once it has handed out that many; zero or less runs forever.
// Because connections are fire-and-forget, some may still be in flight when
// this returns - which is why `state` has to outlive the call, and why a
// caller that needs to know when the work is finished polls
// `serveInFlight(ref state)` rather than trusting the return.
//
// At capacity the connection is accepted and answered with a 503 rather than
// left to hang: refusing costs one small write and no task, and a client that
// is refused KNOWS it was refused instead of timing out against a silent peer.
export async serveConcurrent(
    ref l: TcpListener,
    ref d: Dispatcher,
    cfg: ServerConfig,
    ref state: ServeState,
    n: int32,
): Result<int32, HttpError> {
    let handled: int32 = 0;
    let unbounded: bool = n <= 0;

    while (unbounded || handled < n) {
        switch (await tcp.tcpAcceptAsync(ref l)) {
            case AcceptOutcome.Accepted { stream: st, peerHost: _h, peerPort: _p }: {
                handled = handled + 1;

                // Claim a slot first, and give it straight back if that put
                // us over. Incrementing before the test is what makes the
                // check race-free: two accepts cannot both see room for the
                // last slot, because the counter has already moved.
                let live: int32 = atomic.incrI32(ref state.inFlight);
                if (live > state.maxConcurrent) {
                    let _back: int32 = atomic.decrI32(ref state.inFlight);
                    let _r: int32 = atomic.incrI32(ref state.rejected);
                    disposable busy: TcpStream = st;
                    let bw: Writer = Writer.from(ref busy);
                    await refuse(ref bw);
                    continue;
                }

                let _p2: int32 = atomic.maxI32(ref state.peak, live);
                let _a: int32 = atomic.incrI32(ref state.accepted);
                // Fire and forget: the handle is released at the end of this
                // arm and the connection runs on. See constraint 2 above.
                pooled h = connectionTask(st, d, cfg, ref state.inFlight, ref state.served);
            }
            case AcceptOutcome.TimedOut: {
                // No deadline is set on this listener, so unreachable today.
            }
            case AcceptOutcome.Cancelled: {
                return Result.Ok { value: handled };
            }
            case AcceptOutcome.Err { error: e }: {
                return Result.Err { error: errIo(e) };
            }
        }
    }
    return Result.Ok { value: handled };
}

// `serve` with the default limits.
//
// Note there is no `serveN<H implements Handler>` convenience wrapper that
// erases the handler for you: `Dispatcher.from(ref h)` needs a concrete
// struct receiver and rejects a type parameter, so the erasure has to happen
// at a call site that knows the handler's real type. One line at the top of
// main, and in exchange the serve loop exists exactly once in the binary:
//
//     let d: Dispatcher = Dispatcher.from(ref handler);
//     let served: int32 = http.serveDefault(ref lr.listener, ref d, 0)?;
export async serveDefault(
    ref l: TcpListener,
    ref d: Dispatcher,
    n: int32,
): Result<int32, HttpError> {
    return await serve(ref l, ref d, defaultConfig(), n);
}
