module http;

// std/http/router.yoop - method + path routing over `Handler`.
//
// A `Router` holds routes, each pairing a method and a path pattern with a
// type-erased `Dispatcher`. It implements `Handler` itself, so it drops
// straight into `serve` with no extra server surface:
//
//     let mut r: Router = routerNew();
//     routerGet(ref r, "/todos",     Dispatcher.from(ref list));
//     routerGet(ref r, "/todos/:id", Dispatcher.from(ref show));
//     routerPost(ref r, "/todos",    Dispatcher.from(ref create));
//     let d: Dispatcher = Dispatcher.from(ref r);
//     let served: int32 = http.serveDefault(ref lr.listener, ref d, 0)?;
//
// Patterns:
//
//     /todos          literal segments, matched exactly
//     /todos/:id      `:name` captures one segment into `req.params`
//     /static/*       `*` captures the remaining path as the `rest` param
//
// Matching is first-registered-wins over a linear scan. That is the right
// shape at this size: a handful of routes, one comparison pass per request,
// no trie to keep in sync with the pattern syntax.
//
// Two behaviors that a router either gets right or annoys everyone with:
//
//   * A path that matches but with the wrong method is a 405 with an `Allow`
//     header listing the methods that DO match, not a 404.
//   * A HEAD with no HEAD route falls back to the GET route. The server
//     suppresses the body, so the reply carries exactly the headers the GET
//     would have.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Option } from "../core/types.yoop";
import * as vec, { Vec } from "../core/vec.yoop";
import * as bytes from "../core/bytes.yoop";
import * as intr from "../core/intrinsics.yoop";

// ----- pattern matching ---------------------------------------------------

// Match `path` against `pattern`, appending any captures to `out`. Returns
// false without promising anything about `out`, so callers clear it before
// each attempt rather than after a failure.
//
// Both sides are walked as raw bytes, segment by segment, with no allocation
// per attempt - a router with twenty routes does twenty of these per request.
export function matchPath(pattern: string, path: string, ref out: Params): bool {
    let p: uint8[] = intr.stringAsBytes(pattern);
    let s: uint8[] = intr.stringAsBytes(path);
    let pi: usize = 0;
    let si: usize = 0;

    while (true) {
        // Separators are collapsed on both sides, so "/a//b/" and "/a/b"
        // route the same way.
        while (pi < p.len && p[pi] == '/') { pi = pi + 1; }
        while (si < s.len && s[si] == '/') { si = si + 1; }

        if (pi >= p.len) {
            // Pattern is out of segments: the path has to be too.
            return si >= s.len;
        }

        let pEnd: usize = pi;
        while (pEnd < p.len && p[pEnd] != '/') { pEnd = pEnd + 1; }
        let pseg: uint8[] = bytes.bytesSlice(p, pi, pEnd);

        // `*` swallows the rest, including nothing at all.
        if (pseg[0] == '*') {
            paramsAdd(ref out, "rest", intr.stringFromBytesUnchecked(
                bytes.bytesSlice(s, si, s.len)));
            return true;
        }

        if (si >= s.len) { return false; }
        let sEnd: usize = si;
        while (sEnd < s.len && s[sEnd] != '/') { sEnd = sEnd + 1; }
        let sseg: uint8[] = bytes.bytesSlice(s, si, sEnd);

        if (pseg[0] == ':') {
            // An empty capture would let "/todos/" match "/todos/:id" with an
            // empty id, which is never what the handler wants.
            if (sseg.len == 0) { return false; }
            paramsAdd(ref out,
                intr.stringFromBytesUnchecked(bytes.bytesSlice(pseg, 1, pseg.len)),
                intr.stringFromBytesUnchecked(sseg));
        } else if (!bytes.bytesEq(pseg, sseg)) {
            return false;
        }

        pi = pEnd;
        si = sEnd;
    }
}

// ----- routes -------------------------------------------------------------

export type Route {
    method:     HttpMethod,
    pattern:    string,
    dispatcher: Dispatcher,
}

export type Router implements (Disposable, Handler) propagates<disposable> {
    routes:      Vec<Route>,
    fallback:    Dispatcher,
    hasFallback: bool,

    function dispose(ref self): void {
        Disposable.dispose(ref self.routes);
    }

    async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        let entries: Route[] = vec.vecAsArray(ref self.routes);

        for (let i = 0; i < entries.len; i += 1) {
            paramsClear(ref req.params);
            if (!matchPath(entries[i].pattern, req.path, ref req.params)) { continue; }
            if (methodEq(req.method, entries[i].method)) {
                return await Dispatcher.handle(ref entries[i].dispatcher, ref req, ref resp);
            }
            // A HEAD with no HEAD route is answered by the GET route; the
            // server drops the body on the way out.
            if (methodEq(req.method, HttpMethod.Head)
                && methodEq(entries[i].method, HttpMethod.Get)) {
                return await Dispatcher.handle(ref entries[i].dispatcher, ref req, ref resp);
            }
        }
        paramsClear(ref req.params);

        // Nothing matched on method. Did anything match on path alone? If so
        // this is a 405 and the client is owed the list of methods that would
        // have worked; if not, it is a 404.
        let allow: string = allowedMethods(ref self, ref req);
        if (allow.len > 0) {
            setHeader(ref resp, "Allow", allow);
            resp.status = methodNotAllowed();
        } else {
            resp.status = notFound();
        }

        // The fallback, when installed, renders BOTH - with `resp.status`
        // already set and (for a 405) the `Allow` header already written. An
        // API that answers JSON everywhere needs that hook, because otherwise
        // these two responses are the only plain-text ones it emits.
        if (self.hasFallback) {
            return await Dispatcher.handle(ref self.fallback, ref req, ref resp);
        }
        if (allow.len > 0) {
            respondText(ref resp, methodNotAllowed(),
                `405 Method Not Allowed: ${methodLabel(req.method)} ${req.path}\n`);
        } else {
            respondText(ref resp, notFound(), `404 Not Found: ${req.path}\n`);
        }
        return HandleOutcome.Ok;
    }
}

// Comma-separated methods registered for this request's path, or "" when the
// path matches nothing at all. This is the difference between a 405 and a
// 404, and it is also the body of the `Allow` header the 405 owes the client.
function allowedMethods(ref r: Router, ref req: Request): string {
    let entries: Route[] = vec.vecAsArray(ref r.routes);
    let allow: string = "";
    disposable scratch: Params = paramsNew(4);
    for (let i = 0; i < entries.len; i += 1) {
        paramsClear(ref scratch);
        if (!matchPath(entries[i].pattern, req.path, ref scratch)) { continue; }
        let label: string = methodLabel(entries[i].method);
        if (allow.len == 0) {
            allow = label;
        } else {
            allow = `${allow}, ${label}`;
        }
    }
    return allow;
}

// ----- building -----------------------------------------------------------

export function routerNew(): Router propagates<disposable> {
    let placeholder: NoRoute = { unused: 0 };
    return {
        routes:      vec.vecNew(8),
        fallback:    Dispatcher.from(ref placeholder),
        hasFallback: false,
    };
}

// Seeds the fallback slot so it always holds a valid vtable. It is never
// dispatched unless `routerFallback` replaced it, and if it somehow were, a
// 500 is the honest answer.
type NoRoute implements Handler {
    unused: int32,
    async handle(ref self, ref req: Request, ref resp: Response): HandleOutcome {
        respondText(ref resp, serverError(), "500 no route\n");
        return HandleOutcome.Ok;
    }
}

export function routerAdd(ref r: Router, method: HttpMethod, pattern: string, d: Dispatcher): void {
    let entry: Route = { method: method, pattern: pattern, dispatcher: d };
    vec.vecPush(ref r.routes, entry);
}

export function routerGet(ref r: Router, pattern: string, d: Dispatcher): void {
    routerAdd(ref r, HttpMethod.Get, pattern, d);
}

export function routerPost(ref r: Router, pattern: string, d: Dispatcher): void {
    routerAdd(ref r, HttpMethod.Post, pattern, d);
}

export function routerPut(ref r: Router, pattern: string, d: Dispatcher): void {
    routerAdd(ref r, HttpMethod.Put, pattern, d);
}

export function routerPatch(ref r: Router, pattern: string, d: Dispatcher): void {
    routerAdd(ref r, HttpMethod.Patch, pattern, d);
}

export function routerDelete(ref r: Router, pattern: string, d: Dispatcher): void {
    routerAdd(ref r, HttpMethod.Delete, pattern, d);
}

// Handle anything no route answered: an unmatched path (404) and a path that
// matched with the wrong method (405). `resp.status` is already set to the
// right one when the fallback runs, and for a 405 the `Allow` header is
// already written, so a fallback that only wants to change the body format
// can read the status and render it. Without a fallback both come out as
// plain text.
export function routerFallback(ref r: Router, d: Dispatcher): void {
    r.fallback = d;
    r.hasFallback = true;
}
