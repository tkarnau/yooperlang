// std/http/client.yoop - a minimal HTTP/1.1 client.
//
//     let c: Client = clientNew();
//     disposable resp: ClientResponse = get(ref c, "http://127.0.0.1:8080/todos")?;
//     printf(`${resp.status} ${responseText(ref resp)}\n`);
//
// One connection per call, closed when the response is complete. Everything
// about framing the request and reading the response head is shared with the
// server through std/http/wire.yoop and std/http/parser.yoop, so the two
// directions cannot drift apart.
//
// Limitations, all deliberate and all deferred:
//   * No TLS. `https://` URLs parse, but the connection is plain TCP and the
//     peer will drop it at the handshake.
//   * No chunked responses. A `Transfer-Encoding: chunked` reply is rejected
//     by the shared header reader with a 501-shaped error rather than being
//     mis-read as a body with chunk headers in it.
//   * No redirect following and no connection pooling. A 3xx comes back as
//     it arrived; the `Location` header is the caller's to act on.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Result, Option } from "../core/types.yoop";
import { Readable, Writable } from "../core/traits.yoop";
import * as vec, { Vec } from "../core/vec.yoop";
import * as bytes, { Bytes } from "../core/bytes.yoop";
import * as intr from "../core/intrinsics.yoop";
import * as uri, { Uri } from "../net/uri.yoop";
import * as tcp, { TcpStream, ConnectResult } from "../net/tcp.yoop";
import * as wire from "./wire.yoop";
import * as parser, { ParsedResponse } from "./parser.yoop";
import * as types, {
    Headers, HttpError, HttpMethod, StatusCode,
    errBadRequest, errIo, headersNew, headersAdd, headersGet, headersSet,
    headersView, httpError, isSuccess, methodLabel, payloadTooLarge,
} from "./types.yoop";

// ----- request ------------------------------------------------------------

// What the caller hands to `send`. `body` is a borrowed view: the client
// copies it onto the wire during the call and never holds it afterwards.
export type ClientRequest implements Disposable propagates<disposable> {
    method:  HttpMethod,
    url:     string,
    headers: Headers,
    body:    uint8[],
    function dispose(ref self): void {
        Disposable.dispose(ref self.headers);
    }
}

export function request(method: HttpMethod, url: string): ClientRequest propagates<disposable> {
    return { method: method, url: url, headers: headersNew(8), body: [] };
}

export function setHeader(ref req: ClientRequest, name: string, value: string): void {
    headersSet(ref req.headers, name, value);
}

// Attach a body and declare what it is. The Content-Length is computed at
// send time, so it cannot disagree with what is actually written.
export function setBody(ref req: ClientRequest, mediaType: string, body: uint8[]): void {
    req.body = body;
    headersSet(ref req.headers, "Content-Type", mediaType);
}

export function setTextBody(ref req: ClientRequest, mediaType: string, body: string): void {
    setBody(ref req, mediaType, intr.string_as_bytes(body));
}

// ----- response -----------------------------------------------------------

export type ClientResponse implements Disposable propagates<disposable> {
    status:  StatusCode,
    headers: Headers,
    body:    Vec<uint8>,
    function dispose(ref self): void {
        Disposable.dispose(ref self.headers);
        Disposable.dispose(ref self.body);
    }
}

export function responseBytes(ref r: ClientResponse): uint8[] {
    return vec.vec_as_array(ref r.body);
}

// The body as text. Not UTF-8 validated, for the same reason the server side
// is not: the bytes are whatever the peer sent.
export function responseText(ref r: ClientResponse): string {
    return intr.string_from_bytes_unchecked(responseBytes(ref r));
}

export function responseHeader(ref r: ClientResponse, name: string): Option<string> {
    return headersGet(ref r.headers, name);
}

export function responseOk(ref r: ClientResponse): bool {
    return isSuccess(r.status);
}

// ----- client -------------------------------------------------------------

// Per-client configuration. `maxResponseBytes` is the ceiling on a single
// response; without one, a hostile or broken peer can make the client
// allocate until it dies.
export type Client {
    readChunk:        usize,
    maxHeadBytes:     usize,
    maxResponseBytes: usize,
    userAgent:        string,
}

export function clientNew(): Client {
    return {
        readChunk:        4096,
        maxHeadBytes:     16384,
        maxResponseBytes: 8388608,   // 8 MiB
        userAgent:        "yoop-http/1.1",
    };
}

// ----- wire format --------------------------------------------------------

// Serialize the request. Host, Content-Length, Connection and User-Agent are
// written here rather than trusted from the caller's header list, so a caller
// cannot desynchronize the framing; a caller-supplied copy of one of those is
// skipped below.
function serializeRequest(ref req: ClientRequest, ref u: Uri, ref c: Client, ref out: Vec<uint8>): void {
    wire.pushStr(ref out, `${methodLabel(req.method)} ${u.target} HTTP/1.1`);
    wire.pushCrlf(ref out);

    wire.pushHeaderLine(ref out, "Host", `${u.host}:${u.port}`);
    wire.pushHeaderLine(ref out, "User-Agent", c.userAgent);
    wire.pushHeaderLine(ref out, "Connection", "close");
    if (req.body.len > 0) {
        wire.pushHeaderLine(ref out, "Content-Length", `${req.body.len}`);
    }

    for e in headersView(ref req.headers) {
        if (isClientFramingHeader(e.name)) { continue; }
        wire.pushHeaderLine(ref out, e.name, e.value);
    }

    wire.pushCrlf(ref out);
    wire.pushBytes(ref out, req.body);
}

function isClientFramingHeader(name: string): bool {
    return strEq(name, "Host")
        || strEq(name, "Content-Length")
        || strEq(name, "Connection")
        || strEq(name, "Transfer-Encoding")
        || strEq(name, "User-Agent");
}

function strEq(a: string, b: string): bool {
    return bytes.bytes_eq_ignore_ascii_case(intr.string_as_bytes(a), intr.string_as_bytes(b));
}

// A header a caller set must not be able to inject a second request into the
// stream. Same check the server does on the way out.
function checkRequestHeaders(ref req: ClientRequest): Result<usize, HttpError> {
    for e in headersView(ref req.headers) {
        if (!wire.isValidHeaderValue(e.name) || !wire.isValidHeaderValue(e.value)) {
            return Result.Err {
                error: errBadRequest(`header "${e.name}" contains CR or LF`),
            };
        }
    }
    return Result.Ok { value: 0 };
}

// ----- send ---------------------------------------------------------------

async readSome(ref stream: TcpStream, ref window: uint8[]): Result<usize, HttpError> {
    switch (await Readable.read(ref stream, ref window)) {
        case Result.Ok { value: n }: { return Result.Ok { value: usize(n) }; }
        case Result.Err { error: e }: { return Result.Err { error: errIo(e) }; }
    }
    return Result.Ok { value: 0 };
}

// Read until the response head is complete. Unlike the server side, an EOF
// here is always an error: a peer that closes without a status line answered
// nothing.
async readHead(
    ref stream: TcpStream,
    ref buf: Vec<uint8>,
    ref scratch: Bytes,
    ref c: Client,
): Result<usize, HttpError> {
    let window: uint8[] = bytes.bytes_to_array(ref scratch);
    while (true) {
        let n: usize = await readSome(ref stream, ref window)? "reading the response head";
        if (n == 0) {
            return Result.Err { error: errIo("peer closed before the response head was complete") };
        }
        vec.vec_extend_from(ref buf, intr.array_slice(window, 0, n));
        let at: usize = wire.findHeadEnd(vec.vec_as_array(ref buf));
        if (at != buf.len) { return Result.Ok { value: at }; }
        if (buf.len > c.maxHeadBytes) {
            return Result.Err {
                error: errIo(`response head exceeded ${c.maxHeadBytes} bytes`),
            };
        }
    }
    return Result.Ok { value: 0 };
}

// Send `req` and read the whole response. The connection is opened, used, and
// closed inside this call.
export async send(ref c: Client, ref req: ClientRequest): Result<ClientResponse, HttpError> propagates<disposable> {
    let _checked: usize = checkRequestHeaders(ref req)?;

    let u: Uri = { scheme: "", host: "", port: 0, target: "/" };
    switch (uri.parse_uri(req.url)) {
        case Result.Ok { value: parsed }: { u = parsed; }
        case Result.Err { error: e }: {
            return Result.Err { error: errBadRequest(`${e} (url "${req.url}")`) };
        }
    }

    disposable cr: ConnectResult = tcp.tcp_connect(u.host, u.port);
    if (cr.error.len > 0) {
        return Result.Err { error: errIo(`${cr.error} (connecting to ${u.host}:${u.port})`) };
    }

    // -- write the request --
    disposable out: Vec<uint8> = vec.vec_new(512 + req.body.len);
    serializeRequest(ref req, ref u, ref c, ref out);
    let outView: uint8[] = vec.vec_as_array(ref out);
    switch (await Writable.write(ref cr.stream, ref outView)) {
        case Result.Ok { value: _n }: { }
        case Result.Err { error: e }: { return Result.Err { error: errIo(e) }; }
    }

    // -- read the head --
    disposable buf: Vec<uint8> = vec.vec_new(c.readChunk);
    disposable scratch: Bytes = bytes.bytes_from_raw(intr.heap_alloc(c.readChunk), c.readChunk);
    let _headEnd: usize = await readHead(ref cr.stream, ref buf, ref scratch, ref c)?;

    let disposable head: ParsedResponse = parser.parseResponseHead(vec.vec_as_array(ref buf))?;

    // -- read the body --
    // Whatever came in with the head is already body; the rest is read either
    // to the declared length or to EOF.
    let resp: ClientResponse = {
        status:  head.status,
        headers: headersNew(8),
        body:    vec.vec_new(c.readChunk),
    };
    for e in headersView(ref head.headers) {
        headersAdd(ref resp.headers, e.name, e.value);
    }

    let seen: uint8[] = vec.vec_as_array(ref buf);
    if (seen.len > head.bodyStart) {
        vec.vec_extend_from(ref resp.body, intr.array_slice(seen, head.bodyStart, seen.len));
    }

    switch (await readRest(ref cr.stream, ref scratch, ref c, ref head, ref resp.body)) {
        case Result.Ok { value: _n }: { return Result.Ok { value: resp }; }
        case Result.Err { error: e }: {
            Disposable.dispose(ref resp);
            return Result.Err { error: e };
        }
    }
}

// Body-reading half of `send`, split out so the failure path has one place to
// give the half-built response back.
async readRest(
    ref stream: TcpStream,
    ref scratch: Bytes,
    ref c: Client,
    ref head: ParsedResponse,
    ref body: Vec<uint8>,
): Result<usize, HttpError> {
    let window: uint8[] = bytes.bytes_to_array(ref scratch);
    let want: usize = 0;
    let bounded: bool = false;
    switch (head.info.contentLength) {
        case Option.Some { value: n }: { want = n; bounded = true; }
        case Option.None: { }
    }
    if (bounded && want > c.maxResponseBytes) {
        return Result.Err {
            error: httpError(payloadTooLarge(),
                `response of ${want} bytes exceeds the ${c.maxResponseBytes} byte limit`),
        };
    }

    while (true) {
        if (bounded && body.len >= want) { break; }
        let n: usize = await readSome(ref stream, ref window)? "reading the response body";
        if (n == 0) {
            // EOF. With a declared length this is a truncated response; with
            // no length it is how the peer signals the end.
            if (bounded && body.len < want) {
                return Result.Err {
                    error: errIo(`response body truncated at ${body.len} of ${want} bytes`),
                };
            }
            break;
        }
        vec.vec_extend_from(ref body, intr.array_slice(window, 0, n));
        if (body.len > c.maxResponseBytes) {
            return Result.Err {
                error: httpError(payloadTooLarge(),
                    `response body exceeded the ${c.maxResponseBytes} byte limit`),
            };
        }
    }
    // A bounded read can overshoot into the next message only on a connection
    // we reuse, and this client never reuses one - so trim and move on.
    return Result.Ok { value: body.len };
}

// ----- convenience --------------------------------------------------------

export async get(ref c: Client, url: string): Result<ClientResponse, HttpError> propagates<disposable> {
    disposable req: ClientRequest = request(HttpMethod.Get, url);
    return await send(ref c, ref req);
}

// POST with a body and its media type, e.g.
// `post(ref c, url, "application/json", "{\"a\":1}")`.
export async post(
    ref c: Client,
    url: string,
    mediaType: string,
    body: string,
): Result<ClientResponse, HttpError> propagates<disposable> {
    disposable req: ClientRequest = request(HttpMethod.Post, url);
    setTextBody(ref req, mediaType, body);
    return await send(ref c, ref req);
}

export async put(
    ref c: Client,
    url: string,
    mediaType: string,
    body: string,
): Result<ClientResponse, HttpError> propagates<disposable> {
    disposable req: ClientRequest = request(HttpMethod.Put, url);
    setTextBody(ref req, mediaType, body);
    return await send(ref c, ref req);
}

export async delete(ref c: Client, url: string): Result<ClientResponse, HttpError> propagates<disposable> {
    disposable req: ClientRequest = request(HttpMethod.Delete, url);
    return await send(ref c, ref req);
}
