module http;

// std/http/wire.yoop - the byte level shared by the server and the client.
//
// Two jobs, both of which used to be copy-pasted between server.yoop and
// client.yoop:
//
//   1. Building a message into a `Vec<uint8>` (`pushStr`, `pushHeaderLine`).
//   2. Reading the head of one (`findHeadEnd`, `readHeaderLines`).
//
// A request head and a response head differ only in their first line, so the
// header-field loop below is written once and both parsers call it.
//
// Nothing here is exported, FULL STOP - it used to say "by convention", because
// under file-as-module every one of these had to be `export`ed just so its three
// consumers could import it. Now that the seven files of std/http are one
// module, parser.yoop / server.yoop / client.yoop reach these as siblings and
// none of it is public API. This is the clearest single win of the merge.
//
// It has no dependency on sockets, which is what lets the parsers be tested
// against a byte literal - and that invariant is why `readRequestBytes` /
// `readResponseBytes` live in server.yoop and client.yoop rather than here,
// despite being byte-identical twins.

import { Result, Option } from "../core/types.yoop";
import * as vec, { Vec } from "../core/vec.yoop";
import * as bytes from "../core/bytes.yoop";
import * as intr from "../core/intrinsics.yoop";

// The two structural separators of HTTP/1.1, spelled as the characters they
// are rather than as 13/10.
const CRLF: uint8[] = ['\r', '\n'];
const HEAD_END: uint8[] = ['\r', '\n', '\r', '\n'];

// ----- building -----------------------------------------------------------

function pushByte(ref out: Vec<uint8>, b: uint8): void {
    vec.vec_push(ref out, b);
}

function pushBytes(ref out: Vec<uint8>, src: uint8[]): void {
    vec.vec_extend_from(ref out, src);
}

// Strings go out as their UTF-8 bytes. Numbers ride in through a template
// literal at the call site (`pushStr(ref out, `${n}`)`), which is why there is
// no decimal formatter here any more.
function pushStr(ref out: Vec<uint8>, s: string): void {
    vec.vec_extend_from(ref out, intr.string_as_bytes(s));
}

function pushCrlf(ref out: Vec<uint8>): void {
    vec.vec_extend_from(ref out, CRLF);
}

// `Name: value\r\n`. No validation: a header value containing CR or LF would
// be a response-splitting hole, so callers building headers from untrusted
// input must reject those first (see `isValidHeaderValue`).
function pushHeaderLine(ref out: Vec<uint8>, name: string, value: string): void {
    pushStr(ref out, name);
    pushStr(ref out, ": ");
    pushStr(ref out, value);
    pushCrlf(ref out);
}

// A header value is safe iff it contains no CR, LF, or NUL. Anything that
// smuggles those into a response can inject an entire extra message into the
// stream, so this is checked at the point a value reaches the wire.
function isValidHeaderValue(value: string): bool {
    for c in intr.string_as_bytes(value) {
        if (c == '\r' || c == '\n' || c == 0) { return false; }
    }
    return true;
}

// ----- reading ------------------------------------------------------------

// Offset of the blank line that ends the head, or `buf.len` when the head is
// not complete yet. The read loop calls this after every recv to decide
// whether it has enough to parse.
function findHeadEnd(buf: uint8[]): usize {
    return bytes.bytes_index_of_seq(buf, HEAD_END);
}

// What the header block told us about the body that follows it.
//
// `chunked` selects the framing: a chunked body is delimited by its chunk
// headers rather than by a length, so the two are read by different loops.
// Both are mutually exclusive by RFC 9112 and rejected together below.
type HeadInfo {
    contentLength:   Option<usize>,
    chunked:         bool,
    connectionClose: bool,
}

// Optional whitespace either side of a field value (RFC 9110 says to strip
// it, and a client that sends "Host: example.com " is common enough).
function trimOws(raw: uint8[]): uint8[] {
    let start: usize = 0;
    let end: usize = raw.len;
    while (start < end && (raw[start] == ' ' || raw[start] == '\t')) {
        start = start + 1;
    }
    while (end > start && (raw[end - 1] == ' ' || raw[end - 1] == '\t')) {
        end = end - 1;
    }
    return bytes.bytes_slice(raw, start, end);
}

function asString(raw: uint8[]): string {
    return intr.string_from_bytes_unchecked(raw);
}

// Parse the header fields into `out`, and report what they say about the
// body. `start` is the offset just past the first line's CRLF and `headEnd`
// is what `findHeadEnd` returned.
//
// The scan runs to `headEnd + 2`, not to `headEnd`: `findHeadEnd` points at
// the CR that *terminates the last header line*, so a region ending there
// holds a final line with no CRLF of its own. Stopping at `headEnd` silently
// drops that last field - which is exactly what the pre-rewrite parser did,
// and why a malformed Content-Length in last position used to sail through.
//
// Lines are `name: value`, one per CRLF; a line with no colon is malformed
// and rejected rather than skipped, because a header this server silently
// drops is a header some proxy in front of it did not.
function readHeaderLines(
    buf: uint8[],
    start: usize,
    headEnd: usize,
    ref out: Headers,
): Result<HeadInfo, HttpError> {
    let info: HeadInfo = {
        contentLength:   Option.None,
        chunked:         false,
        connectionClose: false,
    };

    // Safe: a buffer with a head end has at least the four bytes of the
    // terminating CRLF CRLF after it.
    let end: usize = headEnd + 2;
    let pos: usize = start;
    while (pos < end) {
        let rest: uint8[] = bytes.bytes_slice(buf, pos, end);
        let lineLen: usize = bytes.bytes_index_of(rest, '\r');
        if (lineLen == rest.len) { break; }
        let line: uint8[] = bytes.bytes_slice(rest, 0, lineLen);

        // A leading space or tab means an obs-fold continuation line. RFC 9112
        // says a server must reject those (they are a request-smuggling
        // vector), so this does.
        if (line.len > 0 && (line[0] == ' ' || line[0] == '\t')) {
            return Result.Err { error: errBadRequest("obsolete line folding in header block") };
        }

        let colon: usize = bytes.bytes_index_of(line, ':');
        if (colon == line.len) {
            return Result.Err { error: errBadRequest("header line has no \":\"") };
        }
        // No space is allowed between the field name and the colon.
        let nameBytes: uint8[] = bytes.bytes_slice(line, 0, colon);
        if (nameBytes.len == 0) {
            return Result.Err { error: errBadRequest("header line has an empty field name") };
        }
        if (nameBytes[nameBytes.len - 1] == ' ' || nameBytes[nameBytes.len - 1] == '\t') {
            return Result.Err { error: errBadRequest("whitespace between header name and \":\"") };
        }
        let valueBytes: uint8[] = trimOws(bytes.bytes_slice(line, colon + 1, line.len));

        let name: string = asString(nameBytes);
        let value: string = asString(valueBytes);
        headersAdd(ref out, name, value);

        // Sniff the three fields that change how the body is read. The
        // comparisons are case insensitive, per RFC 9110 field-name rules.
        if (bytes.bytes_eq_ignore_ascii_case(nameBytes, intr.string_as_bytes("Content-Length"))) {
            info.contentLength = parseContentLength(valueBytes, info.contentLength)?;
        } else if (bytes.bytes_eq_ignore_ascii_case(nameBytes, intr.string_as_bytes("Transfer-Encoding"))) {
            if (bytes.bytes_eq_ignore_ascii_case(valueBytes, intr.string_as_bytes("chunked"))) {
                info.chunked = true;
            }
        } else if (bytes.bytes_eq_ignore_ascii_case(nameBytes, intr.string_as_bytes("Connection"))) {
            if (bytes.bytes_eq_ignore_ascii_case(valueBytes, intr.string_as_bytes("close"))) {
                info.connectionClose = true;
            }
        }

        pos = pos + lineLen + 2;
    }

    // RFC 9112 section 6.1: a message with both a Transfer-Encoding and a
    // Content-Length is exactly the ambiguity request smuggling is built on -
    // one intermediary frames it by the length and the next by the chunks, and
    // a request appears out of nowhere between them. The spec says a server
    // MUST reject it; so does this, in both directions.
    switch (info.contentLength) {
        case Option.Some { value: _n }: {
            if (info.chunked) {
                return Result.Err {
                    error: errBadRequest("message has both Transfer-Encoding and Content-Length"),
                };
            }
        }
        case Option.None: { }
    }
    return Result.Ok { value: info };
}

// ----- chunked transfer decoding (RFC 9112 section 7.1) --------------------
//
// The wire format:
//
//     <hex-size> [;ext] CRLF
//     <size bytes of data> CRLF
//     ...
//     0 [;ext] CRLF
//     [trailer-field CRLF]...
//     CRLF
//
// Go's HTTP server chunks anything it cannot size up front, which means ollama
// and most local model runners, which means this is not an exotic corner: it
// is what a reply from the thing you most want to talk to looks like. Before
// this, `readHeaderLines` returned an honest 501 and small replies arrived
// while the first full-size one did not.
//
// INCREMENTAL, because a body arrives across many reads and re-decoding the
// whole buffer after each one is quadratic. `ChunkedReader` holds a cursor that
// only ever advances past a COMPLETE chunk, so every byte is examined once and
// every data byte is copied once. The caller loops: feed what it has, read
// more if not done.
//
// Socket-free like everything else in this file, which is what lets the
// decoder be tested against a byte literal rather than against a server.

// A chunk size is a hex number. 16 digits is the widest a 64-bit value can be,
// and anything longer is malformed rather than large - bounding it here is
// what stops `0000...0005` from being an unbounded parse.
const MAX_CHUNK_SIZE_DIGITS: usize = 16;

// Bound on the trailer section, which is otherwise an unbounded header block
// arriving after the caller's body limit has already been checked.
const MAX_TRAILER_BYTES: usize = 8192;

type ChunkedReader {
    // Next byte not yet accounted for. Only ever advanced past a chunk that
    // was present in full, so a partial read is simply re-examined next time.
    cursor:     usize,
    // Decoded bytes handed to `out` so far, for the size limit.
    decoded:    usize,
    // Past the terminal zero-size chunk, reading trailer fields.
    inTrailers: bool,
    trailerAt:  usize,
    done:       bool,
    // Raw bytes of the message this body occupied, valid once done. The server
    // needs it to find where the next pipelined request starts.
    end:        usize,
}

function chunkedReaderNew(bodyStart: usize): ChunkedReader {
    return {
        cursor: bodyStart,
        decoded: 0,
        inTrailers: false,
        trailerAt: 0,
        done: false,
        end: 0,
    };
}

// Index of the CR of the next CRLF at or after `pos`, or `buf.len` when there
// is not a complete line yet.
//
// A bare CR or a bare LF is NOT a line ending here. RFC 9112 allows a lone LF
// as a terminator for robustness, but a decoder that accepts both gives two
// intermediaries two different framings of the same bytes - the smuggling
// shape again - so this requires CRLF and rejects the rest.
function findCrlf(buf: uint8[], pos: usize): usize {
    let i: usize = pos;
    while (i + 1 < buf.len) {
        if (buf[i] == '\r' && buf[i + 1] == '\n') { return i; }
        i = i + 1;
    }
    return buf.len;
}

// The hex value of a chunk-size line, which runs to a `;` (chunk extensions,
// which are legal and ignored) or to the CRLF.
function parseChunkSize(line: uint8[]): Result<usize, HttpError> {
    let end: usize = bytes.bytes_index_of(line, ';');
    let digits: uint8[] = bytes.bytes_slice(line, 0, end);

    // Trailing whitespace before the `;` or CRLF is tolerated; leading is not,
    // since that would make the size line indistinguishable from a folded
    // continuation.
    let n: usize = digits.len;
    while (n > 0 && (digits[n - 1] == ' ' || digits[n - 1] == '\t')) { n = n - 1; }
    digits = bytes.bytes_slice(digits, 0, n);

    if (digits.len == 0) {
        return Result.Err { error: errBadRequest("chunk size line has no size") };
    }
    if (digits.len > MAX_CHUNK_SIZE_DIGITS) {
        return Result.Err { error: errBadRequest("chunk size is too long to be valid") };
    }

    let value: usize = 0;
    for d in digits {
        let v: int32 = hexDigit(d);
        if (v < 0) {
            return Result.Err { error: errBadRequest("chunk size is not hexadecimal") };
        }
        value = value * 16 + usize(v);
    }
    return Result.Ok { value: value };
}

function hexDigit(c: uint8): int32 {
    if (c >= '0' && c <= '9') { return int32(c) - int32('0'); }
    if (c >= 'a' && c <= 'f') { return int32(c) - int32('a') + 10; }
    if (c >= 'A' && c <= 'F') { return int32(c) - int32('A') + 10; }
    return -1;
}

// Consume as much of `buf` as is structurally complete, appending decoded data
// to `out`. Returns true once the whole body (terminal chunk plus trailers)
// has been seen; false means "read more and call again".
//
// `maxDecoded` bounds the DECODED size, which is the number that matters - a
// sender can inflate the raw byte count with chunk extensions and tiny chunks,
// so limiting raw bytes would be the wrong ceiling.
//
// Trailers are consumed and DISCARDED. RFC 9112 permits a recipient to drop
// them, and merging them into the header map after the handler has already
// been given its headers is how a trailer becomes a way to smuggle a header
// past whatever inspected the head.
function chunkedFeed(
    buf: uint8[],
    ref r: ChunkedReader,
    ref out: Vec<uint8>,
    maxDecoded: usize,
): Result<bool, HttpError> {
    while (!r.done) {
        if (r.inTrailers) {
            let lineAt: usize = findCrlf(buf, r.cursor);
            if (lineAt == buf.len) {
                if (buf.len - r.trailerAt > MAX_TRAILER_BYTES) {
                    return Result.Err { error: errBadRequest("chunked trailer section is too large") };
                }
                return Result.Ok { value: false };
            }
            // An empty line ends the trailers and the message.
            if (lineAt == r.cursor) {
                r.end = r.cursor + 2;
                r.done = true;
                return Result.Ok { value: true };
            }
            // A non-empty trailer line: skipped, but its shape is still
            // checked, because a line with no colon here means the framing is
            // wrong rather than that a field is uninteresting.
            let line: uint8[] = bytes.bytes_slice(buf, r.cursor, lineAt);
            if (line[0] == ' ' || line[0] == '\t') {
                return Result.Err { error: errBadRequest("obsolete line folding in chunked trailer") };
            }
            if (bytes.bytes_index_of(line, ':') == line.len) {
                return Result.Err { error: errBadRequest("chunked trailer line has no \":\"") };
            }
            r.cursor = lineAt + 2;
            if (r.cursor - r.trailerAt > MAX_TRAILER_BYTES) {
                return Result.Err { error: errBadRequest("chunked trailer section is too large") };
            }
            continue;
        }

        // A chunk-size line.
        let sizeEnd: usize = findCrlf(buf, r.cursor);
        if (sizeEnd == buf.len) {
            // Guard the size line itself: without this a sender can stream
            // digits forever and never complete a line.
            if (buf.len - r.cursor > MAX_CHUNK_SIZE_DIGITS + 256) {
                return Result.Err { error: errBadRequest("chunk size line is too long") };
            }
            return Result.Ok { value: false };
        }
        let size: usize = parseChunkSize(bytes.bytes_slice(buf, r.cursor, sizeEnd))?;
        let dataAt: usize = sizeEnd + 2;

        if (size == 0) {
            // The terminal chunk. What follows is the trailer section, which
            // may be empty (the common `0\r\n\r\n`).
            r.cursor = dataAt;
            r.trailerAt = dataAt;
            r.inTrailers = true;
            continue;
        }

        if (r.decoded + size > maxDecoded) {
            return Result.Err {
                error: httpError(payloadTooLarge(),
                    `chunked body exceeds the ${maxDecoded} byte limit`),
            };
        }

        // The chunk is only complete once its data AND its trailing CRLF have
        // arrived. Leaving the cursor put means a short read costs nothing but
        // one re-examination of this size line.
        if (dataAt + size + 2 > buf.len) {
            return Result.Ok { value: false };
        }
        if (buf[dataAt + size] != '\r' || buf[dataAt + size + 1] != '\n') {
            return Result.Err { error: errBadRequest("chunk data is not followed by CRLF") };
        }

        vec.vec_extend_from(ref out, bytes.bytes_slice(buf, dataAt, dataAt + size));
        r.decoded = r.decoded + size;
        r.cursor = dataAt + size + 2;
    }
    return Result.Ok { value: true };
}

// One Content-Length value. A non-numeric value, a negative one, or a second
// one that disagrees with the first are all rejected: a message whose length
// is ambiguous is exactly the shape a request-smuggling attack takes.
function parseContentLength(value: uint8[], prior: Option<usize>): Result<Option<usize>, HttpError> {
    let parsed: Result<bytes.BytesParsed, string> = bytes.bytes_parse_int(value);
    let n: int64 = 0;
    switch (parsed) {
        case Result.Ok { value: bp }: {
            if (bp.consumed != value.len) {
                return Result.Err { error: errBadRequest("Content-Length has trailing characters") };
            }
            n = bp.value;
        }
        case Result.Err { error: _e }: {
            return Result.Err { error: errBadRequest("Content-Length is not a number") };
        }
    }
    if (n < 0) {
        return Result.Err { error: errBadRequest("Content-Length is negative") };
    }
    let value2: usize = usize(n);
    switch (prior) {
        case Option.Some { value: seen }: {
            if (seen != value2) {
                return Result.Err { error: errBadRequest("conflicting Content-Length headers") };
            }
        }
        case Option.None: { }
    }
    return Result.Ok { value: Option.Some { value: value2 } };
}
