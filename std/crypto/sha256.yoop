// std/crypto - SHA-256 and HMAC-SHA-256, in pure yoop with no FFI.
//
// Request signing is table stakes for cloud APIs - AWS SigV4, webhook
// signature headers, and every "sign this with your secret" integration are
// HMAC-SHA-256 over a canonicalised string. This is the smallest thing that
// makes those reachable from Yoop.
//
// One module across one file today; it is a DIRECTORY so a future sha512 or
// md5 can join it without every consumer rewriting an import.
//
// NOT a general crypto library, and it should not grow into one without
// someone who does this for a living. Specifically:
//
//   * Nothing here is constant-time except `equalConstantTime`, which is
//     provided precisely because comparing MACs with a normal loop leaks the
//     answer one byte at a time. USE IT for anything an attacker supplies.
//   * No key derivation, no PBKDF2/scrypt/argon2. Do not hash passwords with
//     this - SHA-256 is fast, which is the wrong property for that job.
//   * No memory zeroing. A key handed in here stays in whatever buffer the
//     caller owns.
//
// Verified against the NIST FIPS 180-4 vectors and RFC 4231 (HMAC).
module crypto;

import { Disposable, disposable } from "../core/kinds.yoop";
import * as vec, { Vec } from "../core/vec.yoop";
import * as intr from "../core/intrinsics.yoop";

// Digest size in bytes, and the compression block size. HMAC needs the block
// size (not the digest size) to pad a key, and getting that wrong produces a
// MAC that is self-consistent and wrong against every other implementation.
export const SHA256_DIGEST_BYTES: usize = 32;
export const SHA256_BLOCK_BYTES: usize = 64;

// FIPS 180-4 section 4.2.2: the first 32 bits of the fractional parts of the
// cube roots of the first 64 primes.
const K: uint32[] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

function rotr(x: uint32, n: uint32): uint32 {
    return (x >> n) | (x << (32 - n));
}

// ----- the streaming state ------------------------------------------------

// Incremental so a caller can hash something larger than memory, and so HMAC
// can hash `pad ++ message` without concatenating the two into one buffer.
//
// Not Disposable: the buffer is a fixed 64-byte inline array, so a Sha256 owns
// no heap and can live on the stack or in a struct field with no cleanup.
export type Sha256 {
    h0: uint32, h1: uint32, h2: uint32, h3: uint32,
    h4: uint32, h5: uint32, h6: uint32, h7: uint32,
    // Partial block, and how much of it is filled.
    buf: uint8[],
    bufLen: usize,
    // Total message length in BYTES; the padding encodes it in bits.
    total: uint64,
}

// FIPS 180-4 section 5.3.3: the first 32 bits of the fractional parts of the
// square roots of the first 8 primes.
export function sha256New(): Sha256 {
    return {
        h0: 0x6a09e667, h1: 0xbb67ae85, h2: 0x3c6ef372, h3: 0xa54ff53a,
        h4: 0x510e527f, h5: 0x9b05688c, h6: 0x1f83d9ab, h7: 0x5be0cd19,
        buf: intr.heapAlloc(64),
        bufLen: 0,
        total: 0,
    };
}

// Free the partial-block buffer. Paired with sha256New; `digest` does not do
// it, because a caller may want the state afterwards.
export function sha256Free(ref s: Sha256): void {
    intr.heapFree(s.buf);
}

// Feed bytes in. May be called any number of times with any sizes.
export function update(ref s: Sha256, data: uint8[]): void {
    s.total = s.total + uint64(data.len);
    let i: usize = 0;

    // Top up a partial block first.
    if (s.bufLen > 0) {
        while (i < data.len && s.bufLen < SHA256_BLOCK_BYTES) {
            s.buf[s.bufLen] = data[i];
            s.bufLen = s.bufLen + 1;
            i = i + 1;
        }
        if (s.bufLen == SHA256_BLOCK_BYTES) {
            compress(ref s, s.buf, 0);
            s.bufLen = 0;
        }
    }

    // Whole blocks straight out of the input, no copy.
    while (i + SHA256_BLOCK_BYTES <= data.len) {
        compress(ref s, data, i);
        i = i + SHA256_BLOCK_BYTES;
    }

    // Whatever is left starts the next partial block.
    while (i < data.len) {
        s.buf[s.bufLen] = data[i];
        s.bufLen = s.bufLen + 1;
        i = i + 1;
    }
}

// Append the FIPS padding and write the 32-byte digest to `out`.
//
// Consumes the state: calling it twice on one Sha256 gives the second call a
// padded message. Hash again from a fresh `sha256New` instead.
export function digest(ref s: Sha256, ref out: Vec<uint8>): void {
    // Length in BITS, captured before padding changes the count.
    let bitLen: uint64 = s.total * 8;

    // 0x80, then zeros, then the 8-byte big-endian bit length. The block that
    // holds the length must have room for all 8 bytes, so a partial block with
    // 56 or more bytes in it needs one extra block.
    s.buf[s.bufLen] = 0x80;
    s.bufLen = s.bufLen + 1;
    if (s.bufLen > 56) {
        while (s.bufLen < SHA256_BLOCK_BYTES) {
            s.buf[s.bufLen] = 0;
            s.bufLen = s.bufLen + 1;
        }
        compress(ref s, s.buf, 0);
        s.bufLen = 0;
    }
    while (s.bufLen < 56) {
        s.buf[s.bufLen] = 0;
        s.bufLen = s.bufLen + 1;
    }
    for (let i: usize = 0; i < 8; i += 1) {
        let shift: uint64 = uint64(56 - i * 8);
        s.buf[56 + i] = uint8((bitLen >> shift) & 255);
    }
    compress(ref s, s.buf, 0);

    pushBE32(ref out, s.h0);
    pushBE32(ref out, s.h1);
    pushBE32(ref out, s.h2);
    pushBE32(ref out, s.h3);
    pushBE32(ref out, s.h4);
    pushBE32(ref out, s.h5);
    pushBE32(ref out, s.h6);
    pushBE32(ref out, s.h7);
}

function pushBE32(ref out: Vec<uint8>, v: uint32): void {
    vec.vecPush(ref out, uint8((v >> 24) & 255));
    vec.vecPush(ref out, uint8((v >> 16) & 255));
    vec.vecPush(ref out, uint8((v >> 8) & 255));
    vec.vecPush(ref out, uint8(v & 255));
}

// One 64-byte block, read from `data` at `off`. FIPS 180-4 section 6.2.2.
function compress(ref s: Sha256, data: uint8[], off: usize): void {
    disposable w: Vec<uint32> = vec.vecNew(64);

    // The first 16 words are the block, big-endian.
    for (let i: usize = 0; i < 16; i += 1) {
        let b: usize = off + i * 4;
        vec.vecPush(ref w,
            (uint32(data[b]) << 24)
            | (uint32(data[b + 1]) << 16)
            | (uint32(data[b + 2]) << 8)
            | uint32(data[b + 3]));
    }
    // The remaining 48 are the message schedule.
    for (let i: usize = 16; i < 64; i += 1) {
        let wm15: uint32 = vec.vecGet(ref w, i - 15);
        let wm2: uint32 = vec.vecGet(ref w, i - 2);
        let s0: uint32 = rotr(wm15, 7) ^ rotr(wm15, 18) ^ (wm15 >> 3);
        let s1: uint32 = rotr(wm2, 17) ^ rotr(wm2, 19) ^ (wm2 >> 10);
        vec.vecPush(ref w,
            vec.vecGet(ref w, i - 16) + s0 + vec.vecGet(ref w, i - 7) + s1);
    }

    let a: uint32 = s.h0;
    let b: uint32 = s.h1;
    let c: uint32 = s.h2;
    let d: uint32 = s.h3;
    let e: uint32 = s.h4;
    let f: uint32 = s.h5;
    let g: uint32 = s.h6;
    let hh: uint32 = s.h7;

    for (let i: usize = 0; i < 64; i += 1) {
        let sig1: uint32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        let ch: uint32 = (e & f) ^ ((~e) & g);
        let t1: uint32 = hh + sig1 + ch + K[i] + vec.vecGet(ref w, i);
        let sig0: uint32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        let maj: uint32 = (a & b) ^ (a & c) ^ (b & c);
        let t2: uint32 = sig0 + maj;

        hh = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
    }

    s.h0 = s.h0 + a;
    s.h1 = s.h1 + b;
    s.h2 = s.h2 + c;
    s.h3 = s.h3 + d;
    s.h4 = s.h4 + e;
    s.h5 = s.h5 + f;
    s.h6 = s.h6 + g;
    s.h7 = s.h7 + hh;
}

// ----- one-shot -----------------------------------------------------------

// Hash `data` and append the 32 raw digest bytes to `out`. The common case.
export function sha256(ref out: Vec<uint8>, data: uint8[]): void {
    let s: Sha256 = sha256New();
    update(ref s, data);
    digest(ref s, ref out);
    sha256Free(ref s);
}

// ----- HMAC (RFC 2104) ----------------------------------------------------

// HMAC-SHA-256 of `message` under `key`, appended to `out` as 32 raw bytes.
//
// The key is normalised the way RFC 2104 requires: longer than the BLOCK size
// (64, not the 32-byte digest size) means hash it first; shorter means
// zero-pad it. Getting that boundary wrong yields a MAC that is stable and
// disagrees with every other implementation, which is a bug you find in
// production against someone else's server.
export function hmacSha256(ref out: Vec<uint8>, key: uint8[], message: uint8[]): void {
    disposable block: Vec<uint8> = vec.vecNew(SHA256_BLOCK_BYTES);

    if (key.len > SHA256_BLOCK_BYTES) {
        sha256(ref block, key);
    } else {
        vec.vecExtendFrom(ref block, key);
    }
    while (block.len < SHA256_BLOCK_BYTES) {
        vec.vecPush(ref block, 0);
    }

    // inner = H((K ^ 0x36) ++ message)
    disposable inner: Vec<uint8> = vec.vecNew(SHA256_DIGEST_BYTES);
    let si: Sha256 = sha256New();
    disposable ipad: Vec<uint8> = vec.vecNew(SHA256_BLOCK_BYTES);
    for (let i: usize = 0; i < SHA256_BLOCK_BYTES; i += 1) {
        vec.vecPush(ref ipad, vec.vecGet(ref block, i) ^ 0x36);
    }
    update(ref si, vec.vecAsArray(ref ipad));
    update(ref si, message);
    digest(ref si, ref inner);
    sha256Free(ref si);

    // out = H((K ^ 0x5c) ++ inner)
    let so: Sha256 = sha256New();
    disposable opad: Vec<uint8> = vec.vecNew(SHA256_BLOCK_BYTES);
    for (let i: usize = 0; i < SHA256_BLOCK_BYTES; i += 1) {
        vec.vecPush(ref opad, vec.vecGet(ref block, i) ^ 0x5c);
    }
    update(ref so, vec.vecAsArray(ref opad));
    update(ref so, vec.vecAsArray(ref inner));
    digest(ref so, ref out);
    sha256Free(ref so);
}

// ----- helpers ------------------------------------------------------------

// Lowercase hex of `data`, appended to `out`. What goes in a signature header.
export function toHex(ref out: Vec<uint8>, data: uint8[]): void {
    let digits: uint8[] = intr.stringAsBytes("0123456789abcdef");
    for (let i: usize = 0; i < data.len; i += 1) {
        vec.vecPush(ref out, digits[usize(data[i] >> 4)]);
        vec.vecPush(ref out, digits[usize(data[i] & 15)]);
    }
}

// Compare two byte strings without leaking WHERE they differ through timing.
//
// Use this for anything an attacker supplies. An ordinary loop returns as soon
// as it finds a mismatch, so the time it takes reveals how many leading bytes
// were right - which turns forging a MAC into guessing it one byte at a time
// instead of all at once. This walks the whole buffer and accumulates.
//
// Length is not secret (it is the digest size, which is public), so an early
// return on a length mismatch is fine.
export function equalConstantTime(a: uint8[], b: uint8[]): bool {
    if (a.len != b.len) { return false; }
    let diff: uint8 = 0;
    for (let i: usize = 0; i < a.len; i += 1) {
        diff = diff | (a[i] ^ b[i]);
    }
    return diff == 0;
}
