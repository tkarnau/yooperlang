// std/fs.yoop - filesystem operations for regular files.
//
// This is a small wrapper over libc stdio (fopen / fread / fwrite /
// fclose / fseek / ftell / remove) and POSIX mkdir, modeled after the
// std/net layer: an internal `import.unsafe` C interop block, and a set
// of safe exports that hand back yoop-shaped types.
//
// The public API:
//
//   read_file(path)                  -> ReadFileResult propagates<disposable>
//   read_file_into(ref out, path)    -> string (empty on success)
//   write_file(path, bytes)          -> string
//   delete_file(path)                -> string
//   mkdir_p(path)                    -> string
//   path_join(parts)                 -> string
//   exists(path)                     -> bool
//   file_size(path)                  -> int64 (-1 if absent / not a file)
//
// All "string" returns are empty on success and an error message on
// failure - matching the std/net convention so callers stay uniform.
// Failure messages from the libc calls carry the real errno reason
// (via the Phase 8.D errno bridge) so "not found" and "permission
// denied" are distinguishable.
//
// What's deliberately absent from this MVP:
//   * No streaming reads. read_file slurps. A `read_chunks` over the
//     existing Readable trait is the right follow-up once `std/io` is
//     factored out from std/net.
//   * No Windows-specific path handling. Forward slashes only.

import.unsafe;

import { Disposable, disposable } from "./core/kinds.yoop";
import { Iterable, IterStep } from "./core/traits.yoop";
import { Result } from "./core/types.yoop";
import * as vec, { Vec } from "./core/vec.yoop";
import * as intr from "./core/intrinsics.yoop";
import * as str from "./core/strings.yoop";

// FILE* is opaque - we use bare `unsafe_ptr` (no `<T>`) so we don't have
// to invent a fake pointee. `unsafe_ptr<uint8>` (e.g. `body.ptr`) decays
// implicitly when passed where bare `unsafe_ptr` is expected.
extern "C" from "stdio.h" {
    function fopen(path: string, mode: string): unsafe_ptr;
    function fclose(stream: unsafe_ptr): c_int;
    function fwrite(buf: unsafe_ptr<uint8>, size: c_size_t, count: c_size_t, stream: unsafe_ptr): c_size_t;
    function fread(buf: unsafe_ptr<uint8>, size: c_size_t, count: c_size_t, stream: unsafe_ptr): c_size_t;
    function fseek(stream: unsafe_ptr, offset: c_long, whence: c_int): c_int;
    function ftell(stream: unsafe_ptr): c_long;
    function remove(path: string): c_int;
}

// mkdir's `mode_t` permission bits differ in width per platform and the
// 0755 mask is a magic number when hand-mirrored in yoop. yoop_io_mkdir
// (runtime/yoop_io.c) computes the standard directory mode from the POSIX
// S_* symbols at C compile time and applies it - the same pattern std/net
// uses for SO_REUSEADDR. See plans/completed/yoopstore-papercuts.md #10.
extern "C" from "yoop_runtime" {
    function yoop_io_mkdir(path: string): c_int;
    function yoop_io_exists(path: string): c_int;
    function yoop_io_normalize_real_path(path: string, ref out: string): c_int;
    function yoop_io_file_size(path: string): int64;

    function yoop_io_opendir(path: string): unsafe_ptr;
    function yoop_io_readdir(d: unsafe_ptr): string;
    function yoop_io_closedir(d: unsafe_ptr): void;
    function yoop_io_stat_meta(
        path: string,
        kind: unsafe_ptr<int32>,
        perm: unsafe_ptr<int32>,
        nlink: unsafe_ptr<int32>,
        uid: unsafe_ptr<int32>,
        gid: unsafe_ptr<int32>,
        mtime: unsafe_ptr<int64>
    ): int64;
    function yoop_io_user_name(uid: int32): string;
    function yoop_io_group_name(gid: int32): string;
    function yoop_io_time_string(epoch: int64): string;
}

const SEEK_SET: c_int = 0;
const SEEK_END: c_int = 2;

// ----- path joining ------------------------------------------------------

// Join an array of components with `/`. Empty components are kept (so the
// caller can prepend an absolute root by passing `[""].concat(...)`).
// We do NOT normalize - successive `/`s are not collapsed, `.` and `..`
// pass through. Validation belongs at the API boundary, not here.
export function path_join(parts: string[]): string {
    if (parts.len == 0) { return ""; }
    if (parts.len == 1) { return parts[0]; }
    let pieces: Vec<string> = vec.vec_new(parts.len * 2);
    let i: usize = 0;
    while (i < parts.len) {
        if (i > 0) { vec.vec_push(ref pieces, "/"); }
        vec.vec_push(ref pieces, parts[i]);
        i = i + 1;
    }
    let arr: string[] = vec.vec_as_array(ref pieces);
    let out: string = str.string_concat_all(arr);
    Disposable.dispose(ref pieces);
    return out;
}

// ----- mkdir_p -----------------------------------------------------------

// Walk `full_path` left to right and mkdir each `/`-bounded prefix.
// "Already exists" failures are NOT treated as errors: the next
// operation (fopen, mkdir of the next segment) is what decides whether
// the path is usable. If `full_path` is itself the file you want to
// create, this creates its parent directories but not the file.
export function mkdir_p(full_path: string): string {
    let bytes: uint8[] = intr.string_as_bytes(full_path);
    let i: usize = 1;
    while (i < bytes.len) {
        if (bytes[i] == 47) {  // '/'
            let prefix_view: uint8[] = intr.array_slice(bytes, 0, i);
            let prefix: string = intr.string_from_bytes_unchecked(prefix_view);
            let _r: c_int = yoop_io_mkdir(prefix);
        }
        i = i + 1;
    }
    return "";
}

// ----- write -------------------------------------------------------------

// Create-or-truncate `path` and write all of `body`. Parent directories
// are NOT created automatically - call mkdir_p first if the destination
// is nested. Returns "" on success, an error string on failure.
export function write_file(path: string, body: uint8[]): string {
    let f: unsafe_ptr = fopen(path, "wb");
    if (f == null) {
        let why: string = errno.message(errno.get());
        return `std/fs: fopen("${path}", "wb") failed: ${why}`;
    }
    if (body.len > 0) {
        let n: c_size_t = fwrite(body.ptr, 1, body.len, f);
        if (n != body.len) {
            let _c: c_int = fclose(f);
            return `std/fs: short write to "${path}"`;
        }
    }
    let _c: c_int = fclose(f);
    return "";
}

// ----- read --------------------------------------------------------------

// `read_file_into` is the lower-level form: fills the caller's Vec with
// the file contents (clearing it first). On error the Vec is left empty.
// Preferred when the caller already owns a reusable buffer (e.g. an HTTP
// handler reusing its body buffer across requests).
export function read_file_into(ref out: Vec<uint8>, path: string): string {
    vec.vec_clear(ref out);
    let f: unsafe_ptr = fopen(path, "rb");
    if (f == null) {
        let why: string = errno.message(errno.get());
        return `std/fs: fopen("${path}", "rb") failed: ${why}`;
    }
    let s1: c_int = fseek(f, 0, SEEK_END);
    if (s1 != 0) {
        let _c: c_int = fclose(f);
        return `std/fs: fseek(end) failed for "${path}"`;
    }
    let size: c_long = ftell(f);
    if (size < 0) {
        let _c: c_int = fclose(f);
        return `std/fs: ftell failed for "${path}"`;
    }
    let s2: c_int = fseek(f, 0, SEEK_SET);
    if (s2 != 0) {
        let _c: c_int = fclose(f);
        return `std/fs: fseek(set) failed for "${path}"`;
    }
    let want: usize = usize(size);

    // Slurp into a scratch buffer, then bulk-copy into `out` in one shot via
    // vec_extend_from - which grows `out` at most once (to exactly `want`,
    // or not at all when the caller's buffer is already big enough) rather
    // than the O(log n) reallocs a vec_push loop would incur.
    let scratch: uint8[] = intr.heap_alloc(want);
    let n: c_size_t = 0;
    if (want > 0) {
        n = fread(scratch.ptr, 1, want, f);
    }
    let _c: c_int = fclose(f);
    if (n != want) {
        intr.heap_free(scratch);
        return `std/fs: short read from "${path}"`;
    }
    vec.vec_extend_from(ref out, scratch);
    intr.heap_free(scratch);
    return "";
}

// Owned-result form: allocates a fresh Vec<uint8> and reads the whole
// file into it. Caller wraps in `disposable` and observes `error`.
export type ReadFileResult implements Disposable propagates<disposable> {
    data:  Vec<uint8>,
    error: string,
    function dispose(ref self): void {
        Disposable.dispose(ref self.data);
    }
}

export function read_file(path: string): ReadFileResult propagates<disposable> {
    let buf: Vec<uint8> = vec.vec_new(4096);
    let err: string = read_file_into(ref buf, path);
    return { data: buf, error: err };
}

// ----- delete ------------------------------------------------------------

export function delete_file(path: string): string {
    let rc: c_int = remove(path);
    if (rc != 0) {
        let why: string = errno.message(errno.get());
        return `std/fs: remove("${path}") failed: ${why}`;
    }
    return "";
}

// ----- metadata ----------------------------------------------------------

// True if `path` names an existing filesystem entry (file, directory, or
// otherwise). A missing parent component also reads as "does not exist".
export function exists(path: string): bool {
    return yoop_io_exists(path) != 0;
}

// Size in bytes of the regular file at `path`, or -1 if it doesn't exist
// or isn't a regular file. (-1 rather than a fallible struct keeps the
// common "stat the file I just wrote" path a single read.)
export function file_size(path: string): int64 {
    return yoop_io_file_size(path);
}

// ----- directories -------------------------------------------------------

// A directory opened for iteration. `for name in dir` yields each entry name
// (an owned copy - readdir's own buffer is reused per call), skipping "."
// and "..". Hidden entries are NOT filtered; that is the caller's policy.
// Iterating consumes the stream, so a second pass needs a second openDir.
export type DirIter implements (Disposable, Iterable<string>) propagates<disposable> {
    handle: unsafe_ptr,

    function next(ref self): IterStep<string> {
        if (self.handle == null) { return IterStep.Done; }
        let name: string = yoop_io_readdir(self.handle);
        if (name.len == 0) { return IterStep.Done; }
        return IterStep.Yield { value: str.string_concat(name, "") };
    }

    function dispose(ref self): void {
        if (self.handle != null) {
            yoop_io_closedir(self.handle);
            self.handle = null;
        }
    }
}

// Open `path` for iteration. A path that isn't a readable directory yields an
// iterator that is immediately Done rather than an error - check `exists`
// first when the difference matters.
export function openDir(path: string): DirIter propagates<disposable> {
    return { handle: yoop_io_opendir(path) };
}

// What one lstat tells you about a path. `ok` is false when the probe failed
// (missing, or a permission-denied parent); every other field is then zero.
// Symlinks are NOT followed, so `isLink` describes the link itself.
export type FileMeta {
    ok:     bool,
    isDir:  bool,
    isLink: bool,
    size:   int64,
    perm:   int32,
    links:  int32,
    owner:  string,
    group:  string,
    mtime:  int64,
}

export function statPath(path: string): FileMeta {
    let tag:   int32 = 0;
    let perm:  int32 = 0;
    let links: int32 = 0;
    let uid:   int32 = 0;
    let gid:   int32 = 0;
    let mtime: int64 = 0;
    let size: int64 = yoop_io_stat_meta(path, &tag, &perm, &links, &uid, &gid, &mtime);
    if (size < 0) {
        return { ok: false, isDir: false, isLink: false, size: 0, perm: 0, links: 0, owner: "", group: "", mtime: 0 };
    }
    return {
        ok: true,
        isDir: tag == 1,
        isLink: tag == 2,
        size: size,
        perm: perm,
        links: links,
        owner: yoop_io_user_name(uid),
        group: yoop_io_group_name(gid),
        mtime: mtime,
    };
}

// Unix seconds rendered in local time the way `ls -l` does it: "Mon DD HH:MM"
// inside the last six months, "Mon DD  YYYY" beyond it.
export function timeString(epoch: int64): string {
    return yoop_io_time_string(epoch);
}

// odd helpers for now...
export function hasYoopFileNameSuffix(s: string): bool {
  const n = s.len;
  if (n < 5) {
    return false;
  }
  switch (str.string_slice(s, n - 5, n)) {
    case Result.Ok { value: tail }: { return str.string_eq(tail, ".yoop"); }
    case Result.Err { error: _ }: { return false; }
  }
}

export function dirName(path: string): string {
  const lastSlashIndex = str.lastIndexOf(path, "/");
  switch(str.string_slice(path, 0, lastSlashIndex)) {
    case Result.Ok { value: d }: { return d; }
    case Result.Err { error: _ }: { return ""; }
  }
}

export function normalizePath(path: string): string {
  let outputString = "";
  const normalizeResult = yoop_io_normalize_real_path(path, ref outputString);

  if (normalizeResult != 0) {
    return "";
  } else {
    return outputString;
  }
}
