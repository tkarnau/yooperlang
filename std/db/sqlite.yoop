// std/db/sqlite.yoop - safe SQLite bindings.
//
// The public face of std/db. Compiles without `import.unsafe;` and never names
// a pointer type: every handle rides inside the `RawDb` / `RawStmt` envelopes
// from std/db/sqlite_ffi.yoop, which is the only unsafe module down here.
//
// The public API:
//
//   open(path)                   -> Result<Db, string>
//   openMemory()                 -> Result<Db, string>
//   exec(ref db, sql)            -> Result<int32, string>   rows changed
//   prepare(ref db, sql)         -> Result<Stmt, string>
//   bindInt / bindInt64 / bindDouble / bindText / bindNull   -> DbOutcome
//   step(ref stmt)               -> StepOutcome              Row / Done / Err
//   rows(ref stmt)               -> Rows                     for row in rows
//   reset(ref stmt)              -> DbOutcome                rebind and re-run
//   columnInt / columnInt64 / columnDouble / columnText / columnIsNull
//   columnCount / columnName
//   changes(ref db) / lastInsertRowid(ref db) / libVersion()
//
// Ownership: `Db` and `Stmt` are `Disposable`, so the idiomatic use is the
// `disposable` keyword on the binding and no explicit cleanup call:
//
//     disposable db: Db = sqlite.open("app.db")?;
//     disposable q: Stmt = sqlite.prepare(ref db, "select name from t;")?;
//
// Both disposers are idempotent (close/finalize, then null the handle), so a
// hand-written `Disposable.dispose(ref db)` followed by scope exit is safe -
// this is the free-then-null discipline the advisory ownership model leans on
// instead of compiler-enforced moves.
//
// Deliberately absent from this first cut:
//   * Blobs. sqlite3_bind_blob / column_blob want a length pair; the shape
//     wants `uint8[]` plumbing that is worth its own pass.
//   * A `transaction` region kind. `appliesTo region` + `ownsBlock` is the
//     right home for begin/commit-or-rollback (the doc comment on `ephemeral`
//     in std/core/kinds.yoop already names transactions as the motivating
//     case), but it is a separate design step - see plans/.
//   * Connection pooling, and any notion of a query builder.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Iterable, IterStep } from "../core/traits.yoop";
import { Result } from "../core/types.yoop";
import * as str from "../core/strings.yoop";
import * as ffi, { RawDb, RawStmt } from "./sqlite_ffi.yoop";

// ----- result codes --------------------------------------------------------
//
// The three sqlite result codes that are control flow rather than errors.
// Everything else is surfaced as an error string built from sqlite3_errmsg.

export const SQLITE_OK: int32 = 0;
export const SQLITE_ROW: int32 = 100;
export const SQLITE_DONE: int32 = 101;

// sqlite3_column_type's SQLITE_NULL. The other four type tags (INTEGER 1,
// FLOAT 2, TEXT 3, BLOB 4) are not needed yet - `columnIsNull` is the only
// question callers actually ask, because the typed accessors coerce.
const SQLITE_NULL: int32 = 5;

// ----- outcome shapes ------------------------------------------------------

// Err-only outcome for operations with no useful success value (binds,
// reset). Same shape as std/net's ConnectOutcome and Writable.flush's
// FlushOutcome - `?` does not apply, callers switch or ignore.
export variant DbOutcome {
    Ok,
    Err { error: string },
}

// A cursor over the row currently under a statement. Copyable and cheap (it is
// one handle), and deliberately NOT Disposable - it borrows the statement's
// row rather than owning anything. It stops being valid at the next step /
// reset / dispose of the statement it came from.
//
// Declared BEFORE StepOutcome on purpose: a variant payload whose type is
// declared later in the file resolves against a not-yet-populated shell, and
// the constructor literal fails with `type "Row" has no field "raw"`.
export type Row {
    raw: RawStmt,
}

// The three-way result of advancing a statement. `Row` means the column
// accessors are live for the row now under the cursor (sqlite's SQLITE_ROW);
// `Done` means the statement finished (and for an insert/update, that it took
// effect). The case sharing a name with the `Row` type above is fine - the
// case-struct and the type do not collide, given the type is declared first.
export variant StepOutcome {
    Row { row: Row },
    Done,
    Err { error: string },
}

// ----- handles -------------------------------------------------------------

// An open database connection. Not copyable in spirit: two `Db` values sharing
// one handle would both try to close it. Pass it as `ref db`.
export type Db implements Disposable propagates<disposable> {
    raw: RawDb,

    // Idempotent: guard on null, close, then null. Safe to call twice, which
    // is what lets a manual dispose coexist with a `disposable` binding.
    function dispose(ref self): void {
        if (!ffi.rawDbIsNull(self.raw)) {
            let _rc: int32 = ffi.rawClose(self.raw);
            self.raw = ffi.rawDbNull();
        }
    }
}

// A prepared statement. Carries the connection handle too, so error messages
// can be read without the caller threading the `Db` back in.
export type Stmt implements Disposable propagates<disposable> {
    raw: RawStmt,
    db: RawDb,

    // Idempotent, same discipline as Db.dispose.
    function dispose(ref self): void {
        if (!ffi.rawStmtIsNull(self.raw)) {
            let _rc: int32 = ffi.rawFinalize(self.raw);
            self.raw = ffi.rawStmtNull();
        }
    }
}

// ----- error plumbing ------------------------------------------------------

// Build "sqlite: <op> failed: <reason>" from the connection's current error
// message. Interpolating copies the borrowed sqlite3_errmsg pointer, so the
// returned string outlives the next call on the connection.
function failure(d: RawDb, op: string): string {
    return `sqlite: ${op} failed: ${ffi.rawErrmsg(d)}`;
}

// ----- open / close --------------------------------------------------------

// Open (creating if absent) the database at `path`. On failure the handle
// sqlite allocated anyway is closed before returning, so a failed open leaks
// nothing.
export function open(path: string): Result<Db, string> {
    let raw: RawDb = ffi.rawDbNull();
    let rc: int32 = ffi.rawOpen(path, ref raw);
    if (rc != SQLITE_OK) {
        let why: string = failure(raw, `open("${path}")`);
        let _c: int32 = ffi.rawClose(raw);
        return Result.Err { error: why };
    }
    return Result.Ok { value: { raw: raw } };
}

// A private, process-lifetime database. Nothing touches the filesystem, which
// makes this the right target for tests and for the examples.
export function openMemory(): Result<Db, string> {
    return open(":memory:");
}

// ----- one-shot statements -------------------------------------------------

// Run one or more statements with no parameters and no result rows (DDL,
// pragmas, a bare insert). Returns the number of rows the most recent
// statement changed, which is 0 for DDL.
//
// This is the only entry point that accepts multiple `;`-separated statements.
// It also takes the SQL as one finished string, so it is the wrong tool for
// anything containing user input - use `prepare` plus the bind functions.
export function exec(ref db: Db, sql: string): Result<int32, string> {
    let rc: int32 = ffi.rawExec(db.raw, sql);
    if (rc != SQLITE_OK) {
        return Result.Err { error: failure(db.raw, "exec") };
    }
    return Result.Ok { value: ffi.rawChanges(db.raw) };
}

// ----- prepared statements -------------------------------------------------

// Compile one SQL statement. Parameters are sqlite's own `?`, `?N`, or `:name`
// placeholders; bind them by 1-based index with the bind functions below.
export function prepare(ref db: Db, sql: string): Result<Stmt, string> {
    let raw: RawStmt = ffi.rawStmtNull();
    let rc: int32 = ffi.rawPrepare(db.raw, sql, ref raw);
    if (rc != SQLITE_OK) {
        return Result.Err { error: failure(db.raw, "prepare") };
    }
    return Result.Ok { value: { raw: raw, db: db.raw } };
}

// How many `?` placeholders the compiled statement has. Useful as an assertion
// that the SQL and the bind calls agree.
export function parameterCount(ref s: Stmt): int32 {
    return ffi.rawBindParameterCount(s.raw);
}

// Advance the statement one row. A `Row` outcome carries the cursor for the
// row now available; `Done` means there are no more rows.
export function step(ref s: Stmt): StepOutcome {
    let rc: int32 = ffi.rawStep(s.raw);
    if (rc == SQLITE_ROW) {
        return StepOutcome.Row { row: { raw: s.raw } };
    }
    if (rc == SQLITE_DONE) {
        return StepOutcome.Done;
    }
    return StepOutcome.Err { error: failure(s.db, "step") };
}

// Rewind a finished (or half-consumed) statement so it can run again. Bound
// parameters SURVIVE a reset - that is sqlite's rule, not ours - so rebind
// only what changes, or call `clearBindings` to drop them all.
export function reset(ref s: Stmt): DbOutcome {
    let rc: int32 = ffi.rawReset(s.raw);
    if (rc != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, "reset") };
    }
    return DbOutcome.Ok;
}

// Set every bound parameter back to NULL.
export function clearBindings(ref s: Stmt): DbOutcome {
    let rc: int32 = ffi.rawClearBindings(s.raw);
    if (rc != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, "clearBindings") };
    }
    return DbOutcome.Ok;
}

// ----- binding -------------------------------------------------------------
//
// `idx` is 1-based, matching sqlite's own numbering so the SQL and the bind
// calls line up (`?1` is idx 1). Binding is the injection-safe path: the value
// never becomes part of the SQL text, so no escaping question arises. `bindText`
// hands sqlite a copy (SQLITE_TRANSIENT), so the string does not have to
// outlive the statement.
//
// A bind failure means a bad index or out-of-memory - a bug, not a runtime
// condition - so these return the err-only DbOutcome and most call sites let
// them fall through to `step`, which reports the same underlying error.

export function bindInt(ref s: Stmt, idx: int32, v: int32): DbOutcome {
    if (ffi.rawBindInt(s.raw, idx, v) != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, `bindInt(${idx})`) };
    }
    return DbOutcome.Ok;
}

export function bindInt64(ref s: Stmt, idx: int32, v: int64): DbOutcome {
    if (ffi.rawBindInt64(s.raw, idx, v) != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, `bindInt64(${idx})`) };
    }
    return DbOutcome.Ok;
}

export function bindDouble(ref s: Stmt, idx: int32, v: float64): DbOutcome {
    if (ffi.rawBindDouble(s.raw, idx, v) != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, `bindDouble(${idx})`) };
    }
    return DbOutcome.Ok;
}

export function bindText(ref s: Stmt, idx: int32, v: string): DbOutcome {
    if (ffi.rawBindText(s.raw, idx, v) != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, `bindText(${idx})`) };
    }
    return DbOutcome.Ok;
}

export function bindNull(ref s: Stmt, idx: int32): DbOutcome {
    if (ffi.rawBindNull(s.raw, idx) != SQLITE_OK) {
        return DbOutcome.Err { error: failure(s.db, `bindNull(${idx})`) };
    }
    return DbOutcome.Ok;
}

// ----- column access -------------------------------------------------------
//
// `col` is 0-based (sqlite's numbering again). The typed accessors coerce the
// way sqlite does rather than failing on a type mismatch, so `columnInt` on a
// TEXT column gives sqlite's own best-effort conversion. Check `columnIsNull`
// first when the difference between NULL and 0 matters.

export function columnCount(row: Row): int32 {
    return ffi.rawColumnCount(row.raw);
}

// The declared name of a column. Copied out of sqlite's storage.
export function columnName(row: Row, col: int32): string {
    return str.string_concat(ffi.rawColumnName(row.raw, col), "");
}

export function columnIsNull(row: Row, col: int32): bool {
    return ffi.rawColumnType(row.raw, col) == SQLITE_NULL;
}

export function columnInt(row: Row, col: int32): int32 {
    return ffi.rawColumnInt(row.raw, col);
}

export function columnInt64(row: Row, col: int32): int64 {
    return ffi.rawColumnInt64(row.raw, col);
}

export function columnDouble(row: Row, col: int32): float64 {
    return ffi.rawColumnDouble(row.raw, col);
}

// Copies. sqlite's own pointer dies at the next step, so handing it straight
// back would be a dangling read the moment the caller advanced the cursor.
export function columnText(row: Row, col: int32): string {
    return str.string_concat(ffi.rawColumnText(row.raw, col), "");
}

// ----- iteration -----------------------------------------------------------

// `for row in rows(ref stmt)` over the remaining rows of a statement.
//
// `Iterable.next` has no error channel, so a mid-iteration sqlite failure ends
// the loop and is recorded in `err`. CHECK `err` AFTER THE LOOP if you need to
// tell "no more rows" from "the query broke" - an empty `err` means the former.
// (Same trade std/fs.yoop's DirIter makes.)
//
// Not Disposable: it borrows the statement, which the caller still owns.
export type Rows implements Iterable<Row> {
    raw: RawStmt,
    db: RawDb,
    err: string,
    done: bool,

    function next(ref self): IterStep<Row> {
        if (self.done) { return IterStep.Done; }
        let rc: int32 = ffi.rawStep(self.raw);
        if (rc == SQLITE_ROW) {
            return IterStep.Yield { value: { raw: self.raw } };
        }
        self.done = true;
        if (rc != SQLITE_DONE) {
            self.err = `sqlite: step failed: ${ffi.rawErrmsg(self.db)}`;
        }
        return IterStep.Done;
    }
}

export function rows(ref s: Stmt): Rows {
    return { raw: s.raw, db: s.db, err: "", done: false };
}

// ----- connection metadata -------------------------------------------------

// Rows changed by the most recent statement on this connection.
export function changes(ref db: Db): int32 {
    return ffi.rawChanges(db.raw);
}

// The rowid of the most recent successful insert on this connection.
export function lastInsertRowid(ref db: Db): int64 {
    return ffi.rawLastInsertRowid(db.raw);
}

// The linked libsqlite3's version, e.g. "3.43.2". Handy for confirming which
// sqlite the binary actually picked up.
export function libVersion(): string {
    return str.string_concat(ffi.libVersion(), "");
}
