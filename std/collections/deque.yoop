// std/collections/deque.yoop - double-ended queue (ring buffer).
//
// `Deque<T>` is a ring buffer backed by a single heap allocation.
// Both ends are O(1); growing doubles capacity and re-bases the
// buffer at index 0 so the head/tail pointers don't have to wrap on
// the new buffer. Capacity is always a power of two so modulo is a
// bit-and.
//
// Layout invariants:
//   * `head` is the index of the front element (when len > 0).
//   * Elements at indices `head, (head+1) & mask, ..., (head+len-1) & mask`
//     are live.
//   * `head` and `len` are stored as `usize`. `mask = cap - 1`.

import { Disposable, disposable } from "../core/kinds.yoop";
import { Option } from "../core/types.yoop";
import { DoubleEnded } from "../core/traits.yoop";
import * as intr from "../core/intrinsics.yoop";
import { Allocator, currentAllocator, pushAllocator, popAllocator } from "../core/alloc.yoop";
import { nextPow2Floor8 } from "../core/numbers.yoop";

// Container-owned, like Vec: the Deque remembers the allocator it was built
// with and routes grows and the final free back through it, so a Deque built
// inside an arena scope draws from (and frees into) the arena.
export type Deque<T> implements (Disposable, DoubleEnded<T>) propagates<disposable> {
    data: T[],
    head: usize,
    len:  usize,
    cap:  usize,
    alloc: Allocator,
    function dispose(ref self): void {
        if (self.cap > 0) {
            let prev: Allocator = pushAllocator(self.alloc);
            intr.ctxFree(self.data);
            popAllocator(prev);
            self.cap = 0;
        }
    }

    // ----- DoubleEnded<T> ------------------------------------------------

    // Append at the back. O(1) amortized.
    function pushBack(ref self, value: T): void {
        if (self.len >= self.cap) { grow(ref self); }
        let mask: usize = self.cap - 1;
        let idx: usize = (self.head + self.len) & mask;
        self.data[idx] = value;
        self.len = self.len + 1;
    }

    // Prepend at the front. O(1) amortized.
    function pushFront(ref self, value: T): void {
        if (self.len >= self.cap) { grow(ref self); }
        let mask: usize = self.cap - 1;
        // head moves backwards (modulo cap).
        self.head = (self.head + self.cap - 1) & mask;
        self.data[self.head] = value;
        self.len = self.len + 1;
    }

    // Remove + return the front element. `None` when empty.
    function popFront(ref self): Option<T> {
        if (self.len == 0) { return Option.None; }
        let v: T = self.data[self.head];
        let mask: usize = self.cap - 1;
        self.head = (self.head + 1) & mask;
        self.len = self.len - 1;
        return Option.Some { value: v };
    }

    // Remove + return the back element. `None` when empty.
    function popBack(ref self): Option<T> {
        if (self.len == 0) { return Option.None; }
        let mask: usize = self.cap - 1;
        let idx: usize = (self.head + self.len - 1) & mask;
        let v: T = self.data[idx];
        self.len = self.len - 1;
        return Option.Some { value: v };
    }

    // Read by logical index (`0` is the front). Out-of-bounds yields `None`.
    function get(ref self, i: usize): Option<T> {
        if (i >= self.len) { return Option.None; }
        let mask: usize = self.cap - 1;
        return Option.Some { value: self.data[(self.head + i) & mask] };
    }

    function clear(ref self): void {
        self.head = 0;
        self.len  = 0;
    }

    function isEmpty(ref self): bool {
        return self.len == 0;
    }
}

export function dequeNew<T>(initial_cap: usize): Deque<T> propagates<disposable> {
    let cap: usize = nextPow2Floor8(initial_cap);
    let a: Allocator = currentAllocator();
    return { data: intr.ctxAlloc(cap), head: 0, len: 0, cap: cap, alloc: a };
}

// Linearize into a fresh buffer at twice the capacity. The new head is
// 0; existing elements move to their natural offsets.
function grow<T>(ref d: Deque<T>): void {
    let new_cap: usize = d.cap * 2;
    let prev: Allocator = pushAllocator(d.alloc);
    let new_data: T[] = intr.ctxAlloc(new_cap);
    let i: usize = 0;
    let mask: usize = d.cap - 1;
    while (i < d.len) {
        new_data[i] = d.data[(d.head + i) & mask];
        i = i + 1;
    }
    intr.ctxFree(d.data);
    popAllocator(prev);
    d.data = new_data;
    d.head = 0;
    d.cap  = new_cap;
}

