// std/collections/set.yoop - generic hash set.
//
// `Set<K>` is a thin wrapper over `Map<K, bool>`. yoop doesn't have
// `void` as a type-arg (you can't write `Map<K, void>`), and the bool
// dummy values cost one byte per slot - negligible next to the
// power-of-two-keyed arrays the map already maintains.
//
// All methods forward straight to the underlying Map. The wrapping
// gives users an unambiguous Set-shaped API and lets us swap the
// backing implementation later without changing callers.

import { Disposable, disposable } from "../core/kinds.yoop";
import {
    Map,
    KeyOps,
    mapNew,
    mapInsert,
    mapContainsKey,
    mapRemove,
    mapLen,
} from "./map.yoop";

export type Set<K> implements Disposable propagates<disposable> {
    inner: Map<K, bool>,
    function dispose(ref self): void {
        Disposable.dispose(ref self.inner);
    }
}

export function setNew<K>(initial_cap: usize, ops: KeyOps<K>): Set<K> propagates<disposable> {
    return { inner: mapNew(initial_cap, ops) };
}

// Insert `k`. Returns true if `k` was already present.
export function setInsert<K>(ref s: Set<K>, k: K): bool {
    return mapInsert(ref s.inner, k, true);
}

export function setContains<K>(ref s: Set<K>, k: K): bool {
    return mapContainsKey(ref s.inner, k);
}

export function setRemove<K>(ref s: Set<K>, k: K): bool {
    return mapRemove(ref s.inner, k);
}

export function setLen<K>(ref s: Set<K>): usize {
    return mapLen(ref s.inner);
}
