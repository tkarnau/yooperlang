// std/env.yoop - command line arguments and environment variables.
//
// Yoop's `main` IS the C entry point (`int main(void)`), so argc/argv never
// reach user code as parameters. The runtime grabs them after the fact from
// platform globals (runtime/yoop_args.c: _NSGetArgv on macOS, a parsed
// /proc/self/cmdline on Linux) and the arg exports here are the safe view of
// that. `argAt(0)` is the program name, exactly as in C.
//
//     import * as env from "std/env.yoop";
//
//     let port: string = env.getOr("PORT", "8080");
//     if (env.has("DEBUG")) { ... }
//
// Every string returned here is borrowed for the process lifetime and is
// never null - copy with `string_concat(s, "")` if you need one to outlive a
// reassignment.

import.unsafe;

extern "C" from "yoop_runtime" {
    function yoop_argc(): int32;
    function yoop_argv(i: int32): string;
    function yoop_getenv(name: string): string;
    function yoop_env_has(name: string): int32;
}

// Number of command line arguments, including the program name.
export function argCount(): int32 {
    return yoop_argc();
}

// Argument at `i`, or "" when out of range. Never null.
export function argAt(i: int32): string {
    return yoop_argv(i);
}

// The value of environment variable `name`, or "" when it is unset. Never
// null, so it is safe to read `.len` or pass straight on.
//
// "" is also what a variable explicitly set to the empty string reads as. Use
// `has` when that distinction matters - `PORT=` and no PORT at all are
// different things to a program that treats an empty value as a
// misconfiguration.
export function get(name: string): string {
    return yoop_getenv(name);
}

// Whether `name` is present in the environment at all, including when its
// value is the empty string.
export function has(name: string): bool {
    return yoop_env_has(name) != 0;
}

// The value of `name`, or `fallback` when it is UNSET.
//
// Note "unset", not "unset or empty": a variable explicitly set to "" is a
// value and is returned as one. That is the composable definition (it agrees
// with `has`), and it means `PORT= program` is a visible misconfiguration
// rather than a silent fall back to the default. A program that wants to
// treat empty as absent can say so:
//
//     let p: string = env.get("PORT");
//     if (p.len == 0) { p = "8080"; }
export function getOr(name: string, fallback: string): string {
    if (yoop_env_has(name) != 0) {
        return yoop_getenv(name);
    }
    return fallback;
}
