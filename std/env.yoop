// std/env.yoop - process environment.
//
// Yoop's `main` IS the C entry point (`int main(void)`), so argc/argv never
// reach user code as parameters. The runtime grabs them after the fact from
// platform globals (runtime/yoop_args.c: _NSGetArgv on macOS, a parsed
// /proc/self/cmdline on Linux) and these two exports are the safe view of
// that. `argAt(0)` is the program name, exactly as in C.
//
// The returned strings are borrowed for the process lifetime - copy with
// `string_concat(s, "")` if you need one to outlive a reassignment.

import.unsafe;

extern "C" from "yoop_runtime" {
    function yoop_argc(): int32;
    function yoop_argv(i: int32): string;
}

// Number of command line arguments, including the program name.
export function argCount(): int32 {
    return yoop_argc();
}

// Argument at `i`, or "" when out of range. Never null.
export function argAt(i: int32): string {
    return yoop_argv(i);
}
