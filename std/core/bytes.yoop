// std/core/bytes.yoop - Phase 8.H byte-buffer primitives.
//
// Pure-yoop operations on top of the `$builtin__array_slice` and
// `$builtin__heap_alloc` intrinsics. No `import.unsafe;` - these are the
// safe surface library code reaches for to parse and shuffle bytes.
//
// Naming convention (see plans/phase-8-h-string-bytes-vec.md "Intrinsics as
// a first-class concept"):
//   * `_slice` -> borrowing view, no allocation
//   * `_copy` -> fresh heap allocation
//   * everything else here is read-only over its inputs.

import { Result } from "./types.yoop";
import { Disposable, disposable } from "./kinds.yoop";
import { Vec } from "./vec.yoop";
import * as intr from "./intrinsics.yoop";

// ----- owned byte buffer -------------------------------------------------

// `Bytes` is the canonical owned, heap-backed byte buffer. A bare `uint8[]`
// is a *borrowing* fat-pointer view with no ownership, so an API that wants
// to hand back bytes the caller can keep has to wrap them in something that
// implements Disposable. `Bytes` is that wrapper - lighter than a full
// `Vec<uint8>` (no push / capacity-doubling machinery), for the common
// "here are N owned bytes" return shape (file reads, response bodies).
//
//   * `data` is the owned allocation. Its fat-pointer length is the
//     allocation size (kept intact so heapFree / --track-heap stay paired
//     with the original heapAlloc).
//   * `len`  is the number of valid bytes, which may be < data.len when the
//     buffer was handed over from a Vec that still had spare capacity.
//
// Carries propagates<disposable>: the caller picks auto-cleanup
// (`disposable b: Bytes = ...`), manual `Disposable.dispose`, or transfer-up
// via return - same contract as Vec.
export type Bytes implements Disposable propagates<disposable> {
    data: uint8[],
    len:  usize,
    function dispose(ref self): void {
        if (self.data.len > 0) {
            intr.heapFree(self.data);
            // Reslice to an empty view so a second dispose is a no-op (the
            // pointer dangles but is never dereferenced).
            self.data = intr.arraySlice(self.data, 0, 0);
            self.len = 0;
        }
    }
}

// Borrowing view of the valid prefix as a regular uint8[]. Valid until the
// Bytes is disposed; the caller must keep the Bytes alive while using it.
export function bytesToArray(b: ref Bytes): uint8[] {
    return intr.arraySlice(b.data, 0, b.len);
}

// Copy `src` into a fresh owned allocation (capacity == src.len, no spare).
// `src` is unmodified, so passing a borrowing view (stringAsBytes,
// arraySlice, vecAsArray) is safe.
export function bytesFromArray(src: uint8[]): Bytes propagates<disposable> {
    let data: uint8[] = intr.heapAlloc(src.len);
    let i: usize = 0;
    while (i < src.len) {
        data[i] = src[i];
        i = i + 1;
    }
    return { data: data, len: src.len };
}

// Take ownership of an already-heap-allocated buffer (zero-copy). The caller
// is asserting that `buf` came from heapAlloc (directly or via a Vec /
// another Bytes) and is transferring ownership - do NOT pass a borrowing
// view here, or dispose will free memory the Bytes doesn't own. `len` is the
// count of valid bytes and must be <= buf.len.
export function bytesFromRaw(buf: uint8[], len: usize): Bytes propagates<disposable> {
    return { data: buf, len: len };
}

// Seal a Vec<uint8> into Bytes, taking ownership of its backing buffer with
// no copy. The Vec is left empty (cap reset to 0) so its own dispose becomes
// a harmless no-op - the buffer now belongs to the returned Bytes. Pass the
// Vec by ref; after the call the (emptied) Vec still needs its obligation
// discharged, but disposing it does nothing.
export function bytesFromVec(v: ref Vec<uint8>): Bytes propagates<disposable> {
    let b: Bytes = { data: v.data, len: v.len };
    v.cap = 0;
    v.len = 0;
    return b;
}

// Byte-wise equality. Returns true iff lengths match and every byte matches.
export function bytesEq(a: uint8[], b: uint8[]): bool {
    if (a.len != b.len) { return false; }
    let i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// First index `i` such that `buf[i] == needle`, or `buf.len` if not found.
export function bytesIndexOf(buf: uint8[], needle: uint8): usize {
    let i: usize = 0;
    while (i < buf.len) {
        if (buf[i] == needle) { return i; }
        i = i + 1;
    }
    return buf.len;
}

export function lastIndexOfSeq(buf: uint8[], needle: uint8[]): usize {
  if (needle.len == 0) { return 0; }
  if (needle.len > buf.len ) { return buf.len; }

  // Walk DOWN from the highest start offset that still leaves room for the
  // needle. `i` is one PAST the candidate start rather than the start itself:
  // usize is unsigned, so a loop that decremented a start offset of 0 would
  // wrap to a huge number instead of terminating. Counting down to 1 and
  // deriving `start = i - 1` keeps offset 0 reachable and the loop finite.
  let i: usize = buf.len - needle.len + 1;
  while (i > 0) {
    const start: usize = i - 1;
    let matched = true;
    let j: usize = 0;
    while (j < needle.len) {
      if (buf[start + j] != needle[j]) {
        matched = false;
        break;
      }
      j += 1;
    }
    if (matched) { return start; }
    i -= 1;
  }

  return buf.len; // fail case
}

// First index `i` such that buf[i..i+needle.len] == needle, or buf.len if
// not found. Naive O(n*m) scan; HTTP needles are short.
export function bytesIndexOfSeq(buf: uint8[], needle: uint8[]): usize {
    if (needle.len == 0) { return 0; }
    if (needle.len > buf.len) { return buf.len; }
    let max: usize = buf.len - needle.len + 1;
    let i: usize = 0;
    while (i < max) {
        let matched: bool = true;
        let j: usize = 0;
        while (j < needle.len) {
            if (buf[i + j] != needle[j]) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if (matched) { return i; }
        i = i + 1;
    }
    return buf.len;
}

// True iff buf starts with prefix.
export function bytesStartsWith(buf: uint8[], prefix: uint8[]): bool {
    if (prefix.len > buf.len) { return false; }
    let i: usize = 0;
    while (i < prefix.len) {
        if (buf[i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// ASCII-only case-insensitive byte equality. Non-ASCII bytes compare
// exactly. HTTP headers are ASCII; full Unicode case folding is out of
// scope (see plans/phase-8-h-string-bytes-vec.md §8.H.2).
export function bytesEqIgnoreAsciiCase(a: uint8[], b: uint8[]): bool {
    if (a.len != b.len) { return false; }
    let i: usize = 0;
    while (i < a.len) {
        let ca: uint8 = a[i];
        let cb: uint8 = b[i];
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return false; }
        i = i + 1;
    }
    return true;
}

// Borrowing sub-slice [start, end). Zero-copy view backed by the same
// storage as `buf`. The caller is responsible for keeping `buf` alive as
// long as the slice is used.
export function bytesSlice(buf: uint8[], start: usize, end: usize): uint8[] {
    return intr.arraySlice(buf, start, end);
}

// Copy buf into a fresh heap-allocated uint8[]. Caller owns the result and
// is responsible for freeing it (via heapFree) - though typical use is to
// hand it off to stringFromBytesUnchecked which retains the bytes.
export function bytesCopy(buf: uint8[]): uint8[] {
    let result: uint8[] = intr.heapAlloc(buf.len);
    let i: usize = 0;
    while (i < buf.len) {
        result[i] = buf[i];
        i = i + 1;
    }
    return result;
}

// Parse a decimal ASCII integer at the start of `buf`. Stops at the first
// non-digit. The `Ok` payload holds the parsed value plus how many bytes
// were consumed. `Err` is returned if no leading digits were found.
//
// Overflow is not detected (the multiplication wraps in int64); a defense
// against pathological inputs is the caller's responsibility today.
export type BytesParsed { value: int64, consumed: usize }

export function bytesParseInt(buf: uint8[]): Result<BytesParsed, string> {
    let i: usize = 0;
    let val: int64 = 0;
    while (i < buf.len) {
        let c: uint8 = buf[i];
        if (c < 48 || c > 57) {
            break;
        }
        let digit: int64 = int64(c) - 48;
        val = val * 10 + digit;
        i = i + 1;
    }
    if (i == 0) {
        return Result.Err { error: "bytesParseInt: no leading digits" };
    }
    return Result.Ok { value: { value: val, consumed: i } };
}
