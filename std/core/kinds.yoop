// std/core/kinds.yoop - foundational trait + kind shared across std.
//
// The `Disposable` trait and the `disposable` kind are the entry point for
// every resource-owning type in the standard library (sockets, file
// handles, dynamic vectors, etc). Defined once here and imported by every
// std module that needs them, so the identity is preserved (kinds and
// traits compare by reference; one canonical declaration per program).

export trait Disposable {
    function dispose(ref self): void;
}

// A bare `disposable x = ...` binding is CONST, and that is deliberate.
//
//     disposable buf: Buf = bufNew();     // const - cannot rebind, cannot
//                                         // assign to its fields
//     let disposable buf: Buf = bufNew(); // mutable, and you own the
//                                         // consequences (below)
//
// The auto-cleanup this kind injects fires ONCE, at scope end, on whatever the
// binding holds at that moment. So rebinding silently drops the outgoing value
// without disposing it - a leak the compiler cannot see, because from its side
// the obligation was discharged. Const by default makes that impossible to do
// by accident; writing `let` is the informed opt-in, and the rule it comes with
// is "dispose the old value before you overwrite it":
//
//     let disposable s: Text = textFrom("a");
//     let next: Text = replace(ref s, "a", "b");
//     Disposable.dispose(ref s);          // the outgoing value, by hand
//     s = next;
//
// That loop is the shape that motivates the mutable form at all. Reading the
// const form as a papercut is the natural first reaction (it was reported as
// one) - it is a guard rail with a gate in it.
export kind disposable {
    appliesTo binding;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
    ownsBlock;
}

// `ephemeral` is the region-scoped sibling of `disposable`. Where `disposable`
// binds a named resource you hold and use, `ephemeral` governs a lexical region
// with no value to name - it is for guards whose whole purpose is the ambient
// state change they install on entry and undo on exit (an allocator scope, a
// pushed context, a transaction). `appliesTo region` makes it usable only in
// the anonymous block form, with no binding:
//
//     ephemeral mem.allocatorScope(arena) {   // explicit block:
//         ...                                  //   dispose() fires at the `}`
//     }
//
//     ephemeral mem.allocatorScope(arena);     // implicit block:
//     ...                                      //   dispose() fires at the
//                                              //   enclosing scope end (LIFO)
//
// The value is still constructed (running the guard's side effect) and disposed
// via the same machinery as a name-less `disposable`; you simply cannot refer
// to it - which is the point.
export kind ephemeral {
    appliesTo region;
    requires Disposable;
    mustCall dispose beforeScopeEnd;
    ownsBlock;
}

// ----- the concurrency core ---------------------------------------------
//
// `task`, `async`, `joined`, `pooled` and `Task` are ordinary kind
// declarations, not reserved words backed by hardcoded kind objects in the
// compiler. Their behavior comes from the clauses below rather than from a
// name the compiler recognizes.
//
// The compiler does still REQUIRE these to exist - it asserts this file
// declares them with at least the clauses it depends on, and errors naming
// this file if one is missing or reshaped. That is the carve-out: a fixed
// requirement, not a fixed implementation.
//
// The one genuinely built-in part is `Task<T>` SATISFYING the two traits
// below. Its `retain` / `release` / `wait` bodies are compiler-provided and
// lower to the runtime's yoop_task_* calls - those have to come from
// somewhere, and this is the smallest possible somewhere.

// A reference-counted handle. `refcounted` names these two methods, so the
// compiler calls them by name instead of assuming what a "refcounted" kind
// means.
export trait Shared {
    function retain(ref self): void;
    function release(ref self): void;
}

// A handle whose result can be joined. `joined`'s auto-join is an ordinary
// `mustCall join beforeScopeEnd` against this.
//
// The method is `join`, not `wait`, because `wait` is an expression operator
// and cannot also be an identifier - and `joined` calling `join` reads
// better than `joined` calling `wait` anyway.
export trait Joinable<T> {
    function join(ref self): T;
}

// ----- function kinds ----------------------------------------------------

// `pausable` is the clause that makes a function a coroutine: it may stop
// partway through and continue later, and while stopped it is not holding a
// worker thread. That is what forces the `await` calling convention - a
// pause has to have somewhere to propagate to.
export kind async {
    appliesTo function;
    pausable;
}

// A task is the scheduler's unit of work. `provides Task` is what rewrites
// the call site: the body returns T, but `task f(): T` evaluates to
// `Task<T>` where it is called, which is then joined with `wait`.
//
// Also `pausable`, because a task body is exactly where a pause can land -
// requiring `async task` would be noise.
export kind task {
    appliesTo function;
    pausable;
    provides Task;
}

// ----- handle-binding kinds ----------------------------------------------

// `joined d = f();` - the handle is joined automatically at scope end.
//
// `mustNotEscape scope` is load-bearing beyond documentation: a binding that
// provably cannot outlive its frame can live in a stack slot, which is how
// the compiler decides storage for this kind without matching on its name.
export kind joined {
    appliesTo binding;
    requires Joinable;
    mustCall join beforeScopeEnd;
    mustNotEscape scope;
}

// `pooled h = f();` - a refcounted handle that MAY outlive its scope, which
// is the whole point of refcounting it. No `mustNotEscape`, so it needs the
// heap.
//
// Also the FIELD form: a struct storing a task handle participates in the
// same refcount lifecycle, and says so with `propagates<pooled>`.
//
// There is no separate `kind Task` for the field position. Byte-identical
// clauses differing only in `appliesTo` would be the same kind wearing a
// second name, and that name collides with the `Task<T>` TYPE, giving you
// `type Job propagates<Task> { work: Task<int32> }` where the two `Task`s
// mean different things.
export kind pooled {
    appliesTo binding parameter field;
    requires Shared;
    refcounted retain release;
}

// ----- provenance --------------------------------------------------------

// `owned` marks a value whose storage came from an allocator, as opposed to
// one that borrows storage somebody else owns. It exists because a `string`
// is a single pointer with nowhere to record where it came from: a literal
// and a freshly built string have exactly the same type, and freeing the
// wrong one is an abort rather than a diagnostic.
//
//     function strFree(s: owned string): void { ... }
//
//     strFree(str.stringConcat("a", "b"));   // ok, the result is owned
//     strFree("a literal");                   // compile error
//
// It is CONFERRED, so it reads in the useful direction: a sink that names it
// requires it, and a plain `string` slot accepts an owned value happily. So
// an owned string still passes to printf, to a comparison, to anything that
// only reads. The marker only gets in the way at the one place it should -
// a function claiming the right to release the storage.
//
// There is deliberately no `requires` / `appliedBy` pair. Those name a trait
// impl as the authority for a transition, and no trait impl can be the
// authority here: the only thing that genuinely mints owned storage is the
// allocating intrinsic itself, which is a bodyless `extern "intrinsic"` decl
// and therefore never subject to the decl-authority check. Ordinary code
// reaches `owned` by passthrough (returning a value that already carries
// it). Anything else - a function that returns a literal, or that launders
// on one path and forges on another - fails with "declares no 'appliedBy'
// clause", which is the correct answer.
//
// What `owned` does NOT do, so nobody expects it later: it is provenance
// only. It does not force you to free, does not prevent a double free or a
// use after free, and does not know WHICH allocator produced the value. For
// storage you intend to release, `Text` in std/core/text.yoop carries its
// allocator and is the sound vehicle; `owned` is how the older bare-string
// API tells the truth about itself.
export kind owned {
    appliesTo binding parameter field return;
    conferred;
}
