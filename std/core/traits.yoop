// std/core/traits.yoop - foundational traits used across std modules.
//
// The staple Readable / Writable / Display traits that every downstream
// module either implements or takes as input. Disposable
// is intentionally NOT defined here - it lives in std/core/kinds.yoop
// alongside the disposable kind that requires it.

import { Result } from "./types.yoop";

// ----- Readable ----------------------------------------------------------

// Result of a single read attempt. `Ok { value }` carries the count of
// bytes written into the caller's buffer (0 = EOF on a stream); `Err`
// carries a non-empty diagnostic when the underlying source failed.
// `read` is ASYNC: a network read suspends the calling task and hands
// its worker thread back to the pool rather than blocking it. That makes
// every consumer of this trait async too - which is the coloring cost,
// and the reason the trait is worth declaring async rather than adding a
// parallel AsyncReadable: a stream you cannot await is not much use for
// real I/O.
//
// An implementation over an already-buffered source can simply never
// suspend; an async function that does no awaiting costs one frame
// allocation and runs straight through.
export trait Readable {
    async read(ref self, ref buf: uint8[]): Result<c_ssize_t, string>;
}

// ----- Writable ----------------------------------------------------------

// Write result: `Ok { value: n }` is bytes actually written (may be less
// than buf.len for partial writes on a non-blocking sink; callers loop
// until either `n == buf.len` or they observe an `Err`).
//
// Flush result is err-only - `Ok` (no payload) on success, `Err { error }`
// on failure.
export variant FlushOutcome {
    Ok,
    Err { error: string },
}

export trait Writable {
    // Async for the same reason as Readable.read - a socket write can
    // fill the kernel buffer and has to wait for drain.
    async write(ref self, ref buf: uint8[]): Result<c_ssize_t, string>;
    // `flush` stays synchronous: the implementations that have one are
    // buffer swaps, and making it async would color a lot of code for no
    // suspension.
    function flush(ref self): FlushOutcome;
}

// ----- Reader / Writer vtables ------------------------------------------
//
// Type-erased views over Readable / Writable. Callers that
// want to mix concrete impl types behind one parameter (e.g. an HTTP
// parser that doesn't care whether it's reading from a TcpStream, a
// TlsStream, or an in-memory buffer) take a `Reader` / `Writer` rather
// than a generic `<R implements Readable>`. The trait stays the source
// of truth; `Reader.from(ref s)` builds the erased view from any impl.
//
// The vtables intentionally don't carry Disposable - the caller still
// owns the underlying stream and is responsible for disposing it. Use
// the concrete-type / generic-bound form when ownership transfers.

export vtable Reader for Readable {
    read: (ref buf: uint8[]) => Result<c_ssize_t, string>,
}

export vtable Writer for Writable {
    write: (ref buf: uint8[]) => Result<c_ssize_t, string>,
    flush: () => FlushOutcome,
}

// ----- Display ----------------------------------------------------------

// Convert a value to its human-readable string form. Currently template
// literals special-case int/float/bool/string; lifting Display into the
// template path is a separate typechecker change.
export trait Display {
    function toString(ref self): string;
}

// ----- Iterable ----------------------------------------------------------

// A step from an iterator: either `Yield { value: T }` with the next
// element, or `Done` once the sequence is exhausted. The for-in loop
// pattern-matches on this enum to drive iteration.
export variant IterStep<T> {
    Yield { value: T },
    Done,
}

// Any type implementing `Iterable<T>` can be walked with `for x in ...`.
// The `next` method advances internal state and returns the next step.
// Lowering for `for x in EXPR` desugars to:
//   while (true) {
//       switch (Iterable.next(ref iter)) {
//           case IterStep.Yield { value: x }: { <body> }
//           case IterStep.Done: break;
//       }
//   }
export trait Iterable<T> {
    function next(ref self): IterStep<T>;
}

// ----- Into ------------------------------------------------------------

// Cross-shape `?` conversion. When a `?`-propagated error's
// payload type differs from the enclosing function's Err payload type, the
// typechecker looks for an `Into<TargetErr>` impl on the operand's error
// type and rewrites the propagation to call `Into.into(ref operandErr)`
// before constructing the outer `Err` variant.
//
// Semantically the source type is `self` and the target is the type
// parameter, so the natural read is "IoError implements Into<AppError>"
// ("an IoError can be converted into an AppError").
export trait Into<T> {
    function into(ref self): T;
}

// ----- WithContext -----------------------------------------------------

// Context-attaching `?`. `expr? "loading config"` prepends a
// message to the propagated error. When both Err payloads are plain strings
// the compiler concatenates `"<context>: <err>"` itself and no impl is
// needed; for any other payload type the operand's Err type must implement
// `WithContext<TargetErr>`, and the failure branch calls
// `WithContext.withContext(ref operandErr, context)` to build the outer Err
// payload.
//
// Like `Into<T>`, the source type is `self` and the target is the type
// parameter, so a same-shape impl reads `ParsingError implements
// WithContext<ParsingError>`. The impl decides where the context lands - a
// message prefix, a separate field, or an accumulated breadcrumb list - and
// it doubles as the cross-shape conversion, so one impl covers both.
export trait WithContext<T> {
    function withContext(ref self, context: string): T;
}
