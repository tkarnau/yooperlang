// std/core/numbers.yoop - numeric parsing and small integer helpers.
//
// The parsing direction only, and only from BYTES: `parseBytesToInt32` reads a
// signed integer in any radix from 2 to 36 and returns a `Result` rather than
// a sentinel, so a bad digit is a value you have to handle. The rendering
// direction lives in std/core/format.yoop (`intToString` / `uintToString`).
//
// `nextPow2Floor8` is the growth-policy helper the containers share.
//
//     import * as num from "std/core/numbers.yoop";
//     switch (num.parseBytesToInt32(intr.stringAsBytes("ff"), 16)) { ... }

import * as intr from "./intrinsics.yoop";
import { Result } from "./types.yoop";

function digitValue(ch: uint8): int32 {
  if (ch >= '0' && ch <= '9') {
    return int32(ch - '0');
  }
  if (ch >= 'a' && ch <= 'z') {
    return int32(ch - 'a' + 10);
  }
  if (ch >= 'A' && ch <= 'Z') {
    return int32(ch - 'A' + 10);
  }
  return -1; // radix checks should reject this value
}

export function parseBytesToInt32(bytes: uint8[], radix: int32): Result<int32, string> {
  if (radix < 2 || radix > 36) {
    return Result.Err { error: "radix must be in 2..36" };
  }

  if (bytes.len == 0) {
    return Result.Err { error: "empty string" };
  }

  let i: usize = 0;
  let negative: bool = false;

  let first = bytes[0];
  if (first == '-') {
    negative = true;
    i = 1;
  } else if (first == '+') {
    i = 1;
  }

  if (i == bytes.len) {
    return Result.Err { error: "no digits after sign" };
  }

  let acc: int32 = 0;
  while (i < bytes.len) {
    let digit = digitValue(bytes[i]);
    if (digit < 0 || digit >= radix) {
      return Result.Err { error: "invalid digit for radix" };
    }
    acc = acc * radix + digit;
    i += 1;
  }

  if (negative) {
    acc = 0 - acc;
  }

  return Result.Ok { value: acc };
}

// Round `n` up to the next power of two, with a floor of 8. The container
// modules use this to size a power-of-two-capacity backing buffer, which is
// what lets them mask instead of modulo when mapping an index into the buffer.
export function nextPow2Floor8(n: usize): usize {
  let cap: usize = 8;
  while (cap < n) {
    cap = cap * 2;
  }
  return cap;
}
