// std/core/strings.yoop - string primitives and bridges.
//
// Built on the `stringAsBytes` / `stringFromBytesUnchecked` builtins
// and on top of std/core/bytes.yoop. `stringFromBytes` validates UTF-8
// and is the wrapper users should reach for; `stringFromBytesUnchecked`
// is the underlying intrinsic and skips validation.
//
// Naming convention (intrinsics index):
//   * `_as_*` -> view, no allocation
//   * `_from_*` / `_slice` / `_concat` / `_concat_all` -> fresh allocation

import {
    bytesEq,
    bytesEqIgnoreAsciiCase,
    bytesStartsWith,
    bytesIndexOfSeq,
    bytesSlice,
    lastIndexOfSeq,
} from "./bytes.yoop";

import * as vec, { Vec } from "./vec.yoop";
import { Result } from "./types.yoop";
import * as intr from "./intrinsics.yoop";
import { owned } from "./kinds.yoop";

// Fresh-string construction from a UTF-8 byte buffer. Validates the bytes
// are well-formed UTF-8 (per RFC 3629, with the 4-byte-max cap). On invalid
// input, returns `Err` with a diagnostic.
export function stringFromBytes(buf: uint8[]): Result<string, string> {
    let i: usize = 0;
    while (i < buf.len) {
        let first: uint8 = buf[i];
        let seq_len: usize = 0;
        if (first < 128) {
            seq_len = 1;
        } else if (first < 194) {
            return Result.Err { error: "stringFromBytes: invalid UTF-8 start byte" };
        } else if (first < 224) {
            seq_len = 2;
        } else if (first < 240) {
            seq_len = 3;
        } else if (first < 245) {
            seq_len = 4;
        } else {
            return Result.Err { error: "stringFromBytes: invalid UTF-8 start byte" };
        }
        if (i + seq_len > buf.len) {
            return Result.Err { error: "stringFromBytes: truncated UTF-8 sequence" };
        }
        let j: usize = 1;
        while (j < seq_len) {
            let c: uint8 = buf[i + j];
            if (c < 128 || c >= 192) {
                return Result.Err { error: "stringFromBytes: malformed continuation byte" };
            }
            j = j + 1;
        }
        i = i + seq_len;
    }
    return Result.Ok { value: intr.stringFromBytesUnchecked(buf) };
}

// String equality. Byte-wise comparison of the underlying UTF-8.
export function stringEq(a: string, b: string): bool {
    return bytesEq(intr.stringAsBytes(a), intr.stringAsBytes(b));
}

// ASCII-only case-insensitive equality. Non-ASCII bytes compare exactly.
export function stringEqIgnoreAsciiCase(a: string, b: string): bool {
    return bytesEqIgnoreAsciiCase(intr.stringAsBytes(a), intr.stringAsBytes(b));
}

// True iff `s` starts with `prefix`.
export function stringStartsWith(s: string, prefix: string): bool {
    return bytesStartsWith(intr.stringAsBytes(s), intr.stringAsBytes(prefix));
}

// First byte-offset of `needle` in `s`, or `s.len` if not found.
export function stringIndexOf(s: string, needle: string): usize {
    return bytesIndexOfSeq(intr.stringAsBytes(s), intr.stringAsBytes(needle));
}

export function lastIndexOf(s: string, needle: string): usize {
  return lastIndexOfSeq(intr.stringAsBytes(s), intr.stringAsBytes(needle));
}


// Sub-string in BYTE offsets. Allocates a fresh string. Errors if `start`
// or `end` would split a multi-byte UTF-8 codepoint (verified by checking
// that neither lands on a continuation byte 0x80-0xBF, except at the
// boundaries where there's nothing to split).
export function stringSlice(s: string, start: usize, end: usize): Result<owned string, string> {
    let bytes: uint8[] = intr.stringAsBytes(s);
    if (end > bytes.len) {
        return Result.Err { error: "stringSlice: end > s.len" };
    }
    if (start > end) {
        return Result.Err { error: "stringSlice: start > end" };
    }
    if (start > 0 && start < bytes.len) {
        let c_start: uint8 = bytes[start];
        if (c_start >= 128 && c_start < 192) {
            return Result.Err { error: "stringSlice: start is mid-codepoint" };
        }
    }
    if (end > 0 && end < bytes.len) {
        let c_end: uint8 = bytes[end];
        if (c_end >= 128 && c_end < 192) {
            return Result.Err { error: "stringSlice: end is mid-codepoint" };
        }
    }
    let view: uint8[] = bytesSlice(bytes, start, end);
    return Result.Ok { value: intr.stringFromBytesUnchecked(view) };
}

// FNV-1a hash of the underlying UTF-8 bytes. Stable across runs but not
// cryptographically secure - meant for hash-table keying, not crypto.
// Empty string hashes to the FNV offset basis (14695981039346656037).
export function stringHash(s: string): uint64 {
    let bytes: uint8[] = intr.stringAsBytes(s);
    let h: uint64 = 14695981039346656037;
    let prime: uint64 = 1099511628211;
    let i: usize = 0;
    while (i < bytes.len) {
        h = h ^ uint64(bytes[i]);
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// Concat two strings into one fresh heap-allocated string.
export function stringConcat(a: string, b: string): owned string {
    let a_bytes: uint8[] = intr.stringAsBytes(a);
    let b_bytes: uint8[] = intr.stringAsBytes(b);
    let total: usize = a_bytes.len + b_bytes.len;
    let buf: uint8[] = intr.heapAlloc(total);
    let i: usize = 0;
    while (i < a_bytes.len) {
        buf[i] = a_bytes[i];
        i = i + 1;
    }
    let j: usize = 0;
    while (j < b_bytes.len) {
        buf[a_bytes.len + j] = b_bytes[j];
        j = j + 1;
    }
    let result: owned string = intr.stringFromBytesUnchecked(buf);
    intr.heapFree(buf);
    return result;
}

// Concat N strings into one fresh heap-allocated string. One allocation
// total (sum the lengths, then alloc + copy). Takes an ordinary string[],
// since there are no `...string` variadic parameters.
export function stringConcatAll(parts: string[]): owned string {
    let total: usize = 0;
    let i: usize = 0;
    while (i < parts.len) {
        total = total + intr.stringAsBytes(parts[i]).len;
        i = i + 1;
    }
    let buf: uint8[] = intr.heapAlloc(total);
    let pos: usize = 0;
    let k: usize = 0;
    while (k < parts.len) {
        let part_bytes: uint8[] = intr.stringAsBytes(parts[k]);
        let m: usize = 0;
        while (m < part_bytes.len) {
            buf[pos + m] = part_bytes[m];
            m = m + 1;
        }
        pos = pos + part_bytes.len;
        k = k + 1;
    }
    let result: owned string = intr.stringFromBytesUnchecked(buf);
    intr.heapFree(buf);
    return result;
}

// Number of whole `fill` repetitions needed to bring `have` up to `width`.
// Padding repeats `fill` whole, so a multi-byte fill can overshoot - that is
// the long-standing behavior and is preserved here.
function padReps(have: usize, width: usize, fillLen: usize): usize {
    if (fillLen == 0) { return 0; }
    let reps: usize = 0;
    while (have + reps * fillLen < width) { reps = reps + 1; }
    return reps;
}

// Pad `s` with `fill` until it is at least `width` BYTES long. Byte length,
// not display width - fine for the ASCII columns of a table, wrong for text
// that may hold multi-byte codepoints. An empty `fill` is a no-op rather
// than a hang.
//
// The result is ALWAYS fresh storage, including when `s` is already wide
// enough. Returning `s` itself in that case would make the result borrowed on
// one path and owned on the other, so a caller that freed it would be right
// half the time. `owned` is what makes that shape impossible to write by
// accident.
//
// It sizes the result up front and allocates once, rather than concatenating
// in a loop and abandoning one string per repetition.
//
// Prefer `text.padStart` in std/core/text.yoop, which returns a `Text` that
// cleans itself up.
export function padStart(s: string, width: usize, fill: string): owned string {
    let sb: uint8[] = intr.stringAsBytes(s);
    let fb: uint8[] = intr.stringAsBytes(fill);
    let reps: usize = padReps(sb.len, width, fb.len);
    let buf: uint8[] = intr.heapAlloc(reps * fb.len + sb.len);
    let w: usize = 0;
    let r: usize = 0;
    while (r < reps) {
        let i: usize = 0;
        while (i < fb.len) { buf[w] = fb[i]; w = w + 1; i = i + 1; }
        r = r + 1;
    }
    let j: usize = 0;
    while (j < sb.len) { buf[w] = sb[j]; w = w + 1; j = j + 1; }
    let result: owned string = intr.stringFromBytesUnchecked(buf);
    intr.heapFree(buf);
    return result;
}

export function padEnd(s: string, width: usize, fill: string): owned string {
    let sb: uint8[] = intr.stringAsBytes(s);
    let fb: uint8[] = intr.stringAsBytes(fill);
    let reps: usize = padReps(sb.len, width, fb.len);
    let buf: uint8[] = intr.heapAlloc(sb.len + reps * fb.len);
    let w: usize = 0;
    let j: usize = 0;
    while (j < sb.len) { buf[w] = sb[j]; w = w + 1; j = j + 1; }
    let r: usize = 0;
    while (r < reps) {
        let i: usize = 0;
        while (i < fb.len) { buf[w] = fb[i]; w = w + 1; i = i + 1; }
        r = r + 1;
    }
    let result: owned string = intr.stringFromBytesUnchecked(buf);
    intr.heapFree(buf);
    return result;
}

// Sub-string from `start` to the end, in BYTE offsets. Freshly allocated on
// BOTH paths. Handing back the literal "" on the failure path would make
// freeability depend on the data, and a caller that freed it would abort
// whenever the slice happened to fail.
//
// Both paths reach `owned` by passthrough: the Ok arm's `v` inherits it from
// `Result<owned string, string>`'s first type argument, and the Err arm
// allocates. Neither mints it, so no transition authority is involved.
export function sliceFrom(s: string, start: usize): owned string {
  switch(stringSlice(s, start, s.len)) {
    case Result.Ok { value: v }: { return v; }
    case Result.Err { error: _ }: { return stringConcat("", ""); }
  }
}

// Release a string's storage. The `owned` parameter is the whole point: a
// string literal lives in read-only memory and freeing one is a SIGABRT, not
// a diagnostic, so this refuses anything that cannot prove it was allocated.
//
//     strFree(stringConcat("a", "b"));   // ok
//     strFree("a literal");               // compile error
//
// This does NOT make freeing safe in general - it is provenance, not
// ownership. Nothing here prevents a double free or a use after free, and
// the storage is released through raw `free` regardless of which allocator
// produced it. For storage you intend to release, reach for `Text` in
// std/core/text.yoop, which carries its allocator and disposes itself.
export function strFree(s: owned string): void {
    intr.heapFree(intr.stringAsBytes(s));
}

export function split(
  ref out: Vec<string>,
  input: string,
  separator: string,
  keepEmpty: bool
): string {
  const inputBytes = intr.stringAsBytes(input);
  const separatorBytes = intr.stringAsBytes(separator);
  if (separatorBytes.len > inputBytes.len || separatorBytes.len == 0) {
    // nothing splittable, just use the string
    vec.vecPush(ref out, input);
    return "";
  }

  // iterate over the string looking for instances of the separator
  // and shoving the bytes into the output vec since the last instance
  let i: usize = 0;
  let indexOfEndOfLastMatch: usize = 0;
  while (i < inputBytes.len - separatorBytes.len + 1) {
    let j: usize = 0;
    let matching = true;
    while (j < separatorBytes.len) {
      if (inputBytes[i + j] != separatorBytes[j]) {
        matching = false;
        break;
      }
      j += 1;
    }
    if (matching) {
      // push an entry
      const entry = inputBytes[indexOfEndOfLastMatch..i];
      if (entry.len > 0 || keepEmpty) {
        const entryStringResult = stringFromBytes(entry);
        switch (entryStringResult) {
          case Result.Ok { value: entryString }: {
            vec.vecPush(ref out, entryString);
          }
          case Result.Err { error: e }: {
            return `unable to parse string when recomposing split entry strings: ${e}`;
          }
        }
      }
      indexOfEndOfLastMatch = i + separatorBytes.len;
    }
    i += 1;
  }

  // add last entry
  if (i > indexOfEndOfLastMatch) {
    const entry = inputBytes[indexOfEndOfLastMatch..i];
    if (entry.len > 0 || keepEmpty) {
      const entryStringResult = stringFromBytes(entry);
      switch (entryStringResult) {
        case Result.Ok { value: entryString }: {
          vec.vecPush(ref out, entryString);
        }
        case Result.Err { error: e }: {
          return `unable to parse string when recomposing split entry strings: ${e}`;
        }
      }
    }
  }

  return "";
}
