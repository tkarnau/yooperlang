// std/core/strings.yoop - Phase 8.H string primitives and bridges.
//
// Built on the `string_as_bytes` / `string_from_bytes_unchecked` builtins
// and on top of std/core/bytes.yoop. `string_from_bytes` validates UTF-8
// and is the wrapper users should reach for; `string_from_bytes_unchecked`
// is the underlying intrinsic and skips validation.
//
// Naming convention (intrinsics index):
//   * `_as_*` -> view, no allocation
//   * `_from_*` / `_slice` / `_concat` / `_concat_all` -> fresh allocation

import {
    bytes_eq,
    bytes_eq_ignore_ascii_case,
    bytes_starts_with,
    bytes_index_of_seq,
    bytes_slice,
    lastIndexOfSeq,
} from "./bytes.yoop";

import * as vec, { Vec } from "./vec.yoop";
import { Result } from "./types.yoop";
import * as intr from "./intrinsics.yoop";

// Fresh-string construction from a UTF-8 byte buffer. Validates the bytes
// are well-formed UTF-8 (per RFC 3629, with the 4-byte-max cap). On invalid
// input, returns `Err` with a diagnostic.
export function string_from_bytes(buf: uint8[]): Result<string, string> {
    let i: usize = 0;
    while (i < buf.len) {
        let first: uint8 = buf[i];
        let seq_len: usize = 0;
        if (first < 128) {
            seq_len = 1;
        } else if (first < 194) {
            return Result.Err { error: "string_from_bytes: invalid UTF-8 start byte" };
        } else if (first < 224) {
            seq_len = 2;
        } else if (first < 240) {
            seq_len = 3;
        } else if (first < 245) {
            seq_len = 4;
        } else {
            return Result.Err { error: "string_from_bytes: invalid UTF-8 start byte" };
        }
        if (i + seq_len > buf.len) {
            return Result.Err { error: "string_from_bytes: truncated UTF-8 sequence" };
        }
        let j: usize = 1;
        while (j < seq_len) {
            let c: uint8 = buf[i + j];
            if (c < 128 || c >= 192) {
                return Result.Err { error: "string_from_bytes: malformed continuation byte" };
            }
            j = j + 1;
        }
        i = i + seq_len;
    }
    return Result.Ok { value: intr.string_from_bytes_unchecked(buf) };
}

// String equality. Byte-wise comparison of the underlying UTF-8.
export function string_eq(a: string, b: string): bool {
    return bytes_eq(intr.string_as_bytes(a), intr.string_as_bytes(b));
}

// ASCII-only case-insensitive equality. Non-ASCII bytes compare exactly.
export function string_eq_ignore_ascii_case(a: string, b: string): bool {
    return bytes_eq_ignore_ascii_case(intr.string_as_bytes(a), intr.string_as_bytes(b));
}

// True iff `s` starts with `prefix`.
export function string_starts_with(s: string, prefix: string): bool {
    return bytes_starts_with(intr.string_as_bytes(s), intr.string_as_bytes(prefix));
}

// First byte-offset of `needle` in `s`, or `s.len` if not found.
export function string_index_of(s: string, needle: string): usize {
    return bytes_index_of_seq(intr.string_as_bytes(s), intr.string_as_bytes(needle));
}

export function lastIndexOf(s: string, needle: string): usize {
  return lastIndexOfSeq(intr.string_as_bytes(s), intr.string_as_bytes(needle));
}


// Sub-string in BYTE offsets. Allocates a fresh string. Errors if `start`
// or `end` would split a multi-byte UTF-8 codepoint (verified by checking
// that neither lands on a continuation byte 0x80-0xBF, except at the
// boundaries where there's nothing to split).
export function string_slice(s: string, start: usize, end: usize): Result<string, string> {
    let bytes: uint8[] = intr.string_as_bytes(s);
    if (end > bytes.len) {
        return Result.Err { error: "string_slice: end > s.len" };
    }
    if (start > end) {
        return Result.Err { error: "string_slice: start > end" };
    }
    if (start > 0 && start < bytes.len) {
        let c_start: uint8 = bytes[start];
        if (c_start >= 128 && c_start < 192) {
            return Result.Err { error: "string_slice: start is mid-codepoint" };
        }
    }
    if (end > 0 && end < bytes.len) {
        let c_end: uint8 = bytes[end];
        if (c_end >= 128 && c_end < 192) {
            return Result.Err { error: "string_slice: end is mid-codepoint" };
        }
    }
    let view: uint8[] = bytes_slice(bytes, start, end);
    return Result.Ok { value: intr.string_from_bytes_unchecked(view) };
}

// FNV-1a hash of the underlying UTF-8 bytes. Stable across runs but not
// cryptographically secure - meant for hash-table keying, not crypto.
// Empty string hashes to the FNV offset basis (14695981039346656037).
export function string_hash(s: string): uint64 {
    let bytes: uint8[] = intr.string_as_bytes(s);
    let h: uint64 = 14695981039346656037;
    let prime: uint64 = 1099511628211;
    let i: usize = 0;
    while (i < bytes.len) {
        h = h ^ uint64(bytes[i]);
        h = h * prime;
        i = i + 1;
    }
    return h;
}

// Concat two strings into one fresh heap-allocated string.
export function string_concat(a: string, b: string): string {
    let a_bytes: uint8[] = intr.string_as_bytes(a);
    let b_bytes: uint8[] = intr.string_as_bytes(b);
    let total: usize = a_bytes.len + b_bytes.len;
    let buf: uint8[] = intr.heap_alloc(total);
    let i: usize = 0;
    while (i < a_bytes.len) {
        buf[i] = a_bytes[i];
        i = i + 1;
    }
    let j: usize = 0;
    while (j < b_bytes.len) {
        buf[a_bytes.len + j] = b_bytes[j];
        j = j + 1;
    }
    let result: string = intr.string_from_bytes_unchecked(buf);
    intr.heap_free(buf);
    return result;
}

// Concat N strings into one fresh heap-allocated string. One allocation
// total (sum the lengths, then alloc + copy). Takes an ordinary string[];
// real `...string` variadic parameters are a future ergonomic upgrade.
export function string_concat_all(parts: string[]): string {
    let total: usize = 0;
    let i: usize = 0;
    while (i < parts.len) {
        total = total + intr.string_as_bytes(parts[i]).len;
        i = i + 1;
    }
    let buf: uint8[] = intr.heap_alloc(total);
    let pos: usize = 0;
    let k: usize = 0;
    while (k < parts.len) {
        let part_bytes: uint8[] = intr.string_as_bytes(parts[k]);
        let m: usize = 0;
        while (m < part_bytes.len) {
            buf[pos + m] = part_bytes[m];
            m = m + 1;
        }
        pos = pos + part_bytes.len;
        k = k + 1;
    }
    let result: string = intr.string_from_bytes_unchecked(buf);
    intr.heap_free(buf);
    return result;
}

// Pad `s` with `fill` until it is at least `width` BYTES long. Byte length,
// not display width - fine for the ASCII columns of a table, wrong for text
// that may hold multi-byte codepoints. A longer `s` is returned untouched,
// and an empty `fill` is a no-op rather than a hang.
export function padStart(s: string, width: usize, fill: string): string {
    if (fill.len == 0) { return s; }
    let out: string = s;
    while (out.len < width) {
        out = string_concat(fill, out);
    }
    return out;
}

export function padEnd(s: string, width: usize, fill: string): string {
    if (fill.len == 0) { return s; }
    let out: string = s;
    while (out.len < width) {
        out = string_concat(out, fill);
    }
    return out;
}

export function sliceFrom(s: string, start: usize): string {
  switch(string_slice(s, start, s.len)) {
    case Result.Ok { value: v }: { return v; }
    case Result.Err { error: _ }: { return ""; }
  }
}

export function split(
  ref out: Vec<string>,
  input: string,
  separator: string,
  keepEmpty: bool
): string {
  const inputBytes = intr.string_as_bytes(input);
  const separatorBytes = intr.string_as_bytes(separator);
  if (separatorBytes.len > inputBytes.len || separatorBytes.len == 0) {
    // nothing splittable, just use the string
    vec.vec_push(ref out, input);
    return "";
  }

  // iterate over the string looking for instances of the separator
  // and shoving the bytes into the output vec since the last instance
  let i: usize = 0;
  let indexOfEndOfLastMatch: usize = 0;
  while (i < inputBytes.len - separatorBytes.len + 1) {
    let j: usize = 0;
    let matching = true;
    while (j < separatorBytes.len) {
      if (inputBytes[i + j] != separatorBytes[j]) {
        matching = false;
        break;
      }
      j += 1;
    }
    if (matching) {
      // push an entry
      const entry = inputBytes[indexOfEndOfLastMatch..i];
      if (entry.len > 0 || keepEmpty) {
        const entryStringResult = string_from_bytes(entry);
        switch (entryStringResult) {
          case Result.Ok { value: entryString }: {
            vec.vec_push(ref out, entryString);
          }
          case Result.Err { error: e }: {
            return `unable to parse string when recomposing split entry strings: ${e}`;
          }
        }
      }
      indexOfEndOfLastMatch = i + separatorBytes.len;
    }
    i += 1;
  }

  // add last entry
  if (i > indexOfEndOfLastMatch) {
    const entry = inputBytes[indexOfEndOfLastMatch..i];
    if (entry.len > 0 || keepEmpty) {
      const entryStringResult = string_from_bytes(entry);
      switch (entryStringResult) {
        case Result.Ok { value: entryString }: {
          vec.vec_push(ref out, entryString);
        }
        case Result.Err { error: e }: {
          return `unable to parse string when recomposing split entry strings: ${e}`;
        }
      }
    }
  }

  return "";
}
