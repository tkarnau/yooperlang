module cancel;

// std/core/cancel/ffi.yoop - unsafe runtime FFI for cancellation tokens.
//
// The one source FILE of the `cancel` module that opts into unsafe.
// token.yoop is the public face; users never reach here.
//
// `import.unsafe;` is a per-source-file pragma, not a module-wide one, which is
// what keeps this split meaningful when the two files are one module: this
// file may name `unsafe_ptr`, its sibling may not, and the sibling can hold a
// token anyway because the pointer rides inside the one-field `RawCancel`
// envelope below (no pointer types in an exported safe signature). Same shape
// as std/net/socket_ffi.yoop and std/db/sqlite_ffi.yoop.
//
// Everything here except `RawCancel` is MODULE-PRIVATE: token.yoop reaches these
// as a sibling with no import, and no `export` keyword. `RawCancel` itself is
// exported because std/net/socket_ffi legitimately needs the envelope type.

import.unsafe;

// A `yoop_cancel_t *`. One pointer field, so `RawCancel` is
// ABI-identical to the bare pointer at every call boundary.
export type RawCancel { p: unsafe_ptr }

function rawCancelNull(): RawCancel { return { p: null }; }
function rawCancelIsNull(c: RawCancel): bool { return c.p == null; }

extern "C" from "yoop_runtime" {
    function yoop_cancel_new(): unsafe_ptr;
    function yoop_cancel_new_deadline(deadlineNs: uint64): unsafe_ptr;
    function yoop_cancel_retain(t: unsafe_ptr): void;
    function yoop_cancel_release(t: unsafe_ptr): void;
    function yoop_cancel_request(t: unsafe_ptr): void;
    function yoop_cancel_requested(t: unsafe_ptr): c_int;
    function yoop_cancel_flagged(t: unsafe_ptr): c_int;
    function yoop_cancel_deadline_ns(t: unsafe_ptr): uint64;
    function yoop_cancel_set_deadline_ns(t: unsafe_ptr, deadlineNs: uint64): void;
    function yoop_cancel_link(child: unsafe_ptr, parent: unsafe_ptr): c_int;
    function yoop_cancel_sleep_ns(t: unsafe_ptr, ns: uint64): c_int;
    function yoop_cancel_wait(t: unsafe_ptr, deadlineNs: uint64): c_int;
    function yoop_now_ns(): uint64;
}

// ----- thin wrappers -------------------------------------------------------
//
// Every helper takes and returns plain yoop types, so `c_int` and
// `unsafe_ptr` both stop at this file.

function rawNew(): RawCancel {
    return { p: yoop_cancel_new() };
}

function rawNewDeadline(deadlineNs: uint64): RawCancel {
    return { p: yoop_cancel_new_deadline(deadlineNs) };
}

function rawRetain(c: RawCancel): void {
    yoop_cancel_retain(c.p);
}

function rawRelease(c: RawCancel): void {
    yoop_cancel_release(c.p);
}

function rawRequest(c: RawCancel): void {
    yoop_cancel_request(c.p);
}

function rawRequested(c: RawCancel): bool {
    return yoop_cancel_requested(c.p) != 0;
}

function rawFlagged(c: RawCancel): bool {
    return yoop_cancel_flagged(c.p) != 0;
}

function rawDeadlineNs(c: RawCancel): uint64 {
    return yoop_cancel_deadline_ns(c.p);
}

function rawSetDeadlineNs(c: RawCancel, deadlineNs: uint64): void {
    yoop_cancel_set_deadline_ns(c.p, deadlineNs);
}

function rawLink(child: RawCancel, parent: RawCancel): int32 {
    return int32(yoop_cancel_link(child.p, parent.p));
}

function rawSleepNs(c: RawCancel, ns: uint64): int32 {
    return int32(yoop_cancel_sleep_ns(c.p, ns));
}

function rawWait(c: RawCancel, deadlineNs: uint64): int32 {
    return int32(yoop_cancel_wait(c.p, deadlineNs));
}

// The monotonic deadline clock. Re-exported here so std/core/cancel.yoop
// does not need its own extern block for the one call it needs.
function rawNowNs(): uint64 {
    return yoop_now_ns();
}
