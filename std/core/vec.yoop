// std/core/vec.yoop - growable vector type.
//
// `Vec<T>` is the blessed growable-array primitive that std modules and
// user code build collections out of. Owns a heap-allocated backing buffer
// and grows on demand. Carries `propagates<disposable>` so the underlying
// memory cannot be silently dropped - the user must pick auto-cleanup
// (`disposable v: Vec<T> = vec.vecNew(8);`), manual `v.dispose()`, or
// transfer-up via return.
//
// The operations are the `Growable<T>` contract from std/core/traits.yoop
// (which extends `Sequence<T>` and `Collection`), called through the value:
// `v.push(x)`, `v.get(i)`, `v.asArray()`. A bounded generic takes any growable
// sequence the same way, which is what lets another backing strategy stand in
// for this one.
//
// Allocation behavior per operation (per the intrinsics-index naming
// convention):
//   * `vecNew`        -> fresh heap allocation
//   * `push`          -> may reallocate (when len == cap)
//   * `get` / `set`   -> in place; no allocation
//   * `clear`         -> in place; capacity unchanged, no allocation
//   * `asArray`       -> borrowing view valid until the next mutation
//   * `dispose`       -> frees the backing buffer

import { Disposable, disposable } from "./kinds.yoop";
import * as intr from "./intrinsics.yoop";
import { Allocator, currentAllocator, pushAllocator, popAllocator } from "./alloc.yoop";
import { Iterable, IterStep, Growable } from "./traits.yoop";

// `Vec<T>` is container-owned: it remembers the allocator it was built with
// (whatever was current at `vecNew`) and routes every later grow and the
// final free back through that same allocator, regardless of what is current
// when those happen. So a Vec built inside an arena scope frees into the arena
// (a no-op; the region reclaims in bulk), and a malloc Vec stays malloc-backed
// even if it grows while an arena is installed.
export type Vec<T> implements (Disposable, Growable<T>) propagates<disposable> {
    data: T[],
    len: usize,
    cap: usize,
    alloc: Allocator,
    function dispose(ref self): void {
        if (self.cap > 0) {
            let prev: Allocator = pushAllocator(self.alloc);
            intr.ctxFree(self.data);
            popAllocator(prev);
            self.cap = 0;
        }
    }

    // ----- Collection, Sequence<T> --------------------------------------

    // Reset length to zero. Capacity unchanged; backing buffer is retained so
    // subsequent pushes don't reallocate immediately.
    function clear(ref self): void {
        self.len = 0;
    }

    function isEmpty(ref self): bool {
        return self.len == 0;
    }

    // Read `v[i]`. Traps via the underlying array indexing if i >= len -
    // matches the existing yoop array-indexing convention (no bounds check;
    // caller's responsibility).
    function get(ref self, i: usize): T {
        return self.data[i];
    }

    // Write `v[i] = value`. Same OOB convention as `get`.
    function set(ref self, i: usize, value: T): void {
        self.data[i] = value;
    }

    // Borrowing view of the populated prefix as a regular yoop array. The view
    // is valid until the next mutation (push/clear/dispose) - the underlying
    // fat-pointer may dangle if `push` reallocates.
    function asArray(ref self): T[] {
        return intr.arraySlice(self.data, 0, self.len);
    }

    // ----- Growable<T> ---------------------------------------------------

    // Append `value`, growing the backing buffer if necessary (doubling
    // strategy). MAY REALLOCATE when len == cap - callers holding views from
    // `asArray` should re-fetch after a push.
    function push(ref self, value: T): void {
        if (self.len >= self.cap) {
            let new_cap: usize = self.cap * 2;
            if (new_cap == 0) { new_cap = 4; }
            // Grow through the Vec's own allocator, not whatever is ambient now.
            let prev: Allocator = pushAllocator(self.alloc);
            let new_data: T[] = intr.ctxAlloc(new_cap);
            let i: usize = 0;
            while (i < self.len) {
                new_data[i] = self.data[i];
                i = i + 1;
            }
            if (self.cap > 0) {
                intr.ctxFree(self.data);
            }
            popAllocator(prev);
            self.data = new_data;
            self.cap = new_cap;
        }
        self.data[self.len] = value;
        self.len = self.len + 1;
    }

    // Append every element of `src`, growing the backing buffer at most once
    // (to exactly `len + src.len` when a grow is needed). This is the bulk
    // append the byte-shuffling paths want: O(n) copies but a single
    // allocation, versus `push` in a loop which reallocates O(log n) times.
    // MAY REALLOCATE - callers holding views from `asArray` should re-fetch.
    function extendFrom(ref self, src: T[]): void {
        let needed: usize = self.len + src.len;
        if (needed > self.cap) {
            let prev: Allocator = pushAllocator(self.alloc);
            let new_data: T[] = intr.ctxAlloc(needed);
            let i: usize = 0;
            while (i < self.len) {
                new_data[i] = self.data[i];
                i = i + 1;
            }
            if (self.cap > 0) {
                intr.ctxFree(self.data);
            }
            popAllocator(prev);
            self.data = new_data;
            self.cap = needed;
        }
        let j: usize = 0;
        while (j < src.len) {
            self.data[self.len + j] = src[j];
            j = j + 1;
        }
        self.len = needed;
    }
}

// Construct a fresh Vec with `initial_cap` capacity. Captures the current
// allocator. Caller must discharge the disposable obligation (auto-cleanup,
// manual dispose, or transfer up).
export function vecNew<T>(initial_cap: usize): Vec<T> propagates<disposable> {
    let a: Allocator = currentAllocator();
    return { data: intr.ctxAlloc(initial_cap), len: 0, cap: initial_cap, alloc: a };
}

// Build a fresh Vec holding a copy of `src` (capacity == src.len, so no
// spare). Like `vecNew` it allocates once and carries the disposable
// obligation to the caller. `src` is unmodified - the bytes are copied, not
// aliased - so passing a borrowing view (stringAsBytes, arraySlice) is
// safe.
export function vecFromArray<T>(src: T[]): Vec<T> propagates<disposable> {
    let a: Allocator = currentAllocator();
    let data: T[] = intr.ctxAlloc(src.len);
    let i: usize = 0;
    while (i < src.len) {
        data[i] = src[i];
        i = i + 1;
    }
    return { data: data, len: src.len, cap: src.len, alloc: a };
}

// ----- Iteration ---------------------------------------------------------

// `VecIter<T>` walks the populated prefix (indices 0 .. len-1) in order, so
// `for x in vecIter(ref v)` replaces the index-plumbing while-loop that
// reading a Vec otherwise requires.
//
// Like `MapIter`, the iterator holds a BORROWING view of the backing buffer:
// the `T[]` fat pointer is a copy, the heap data is shared. Any mutation that
// can reallocate (`push` at capacity, `extendFrom`, `dispose`) invalidates it
// and leaves the view dangling - keep the iterator scoped tightly around its
// loop and re-fetch after mutating.
export type VecIter<T> implements Iterable<T> {
    data: T[],
    len: usize,
    i: usize,

    function next(ref self): IterStep<T> {
        if (self.i >= self.len) {
            return IterStep.Done;
        }
        let cur: usize = self.i;
        self.i = self.i + 1;
        return IterStep.Yield { value: self.data[cur] };
    }
}

// Build a `VecIter<T>` over the populated prefix of `v`, for `for ... in`.
// The iterator yields `T` values via the `Iterable<T>` trait.
export function vecIter<T>(v: ref Vec<T>): VecIter<T> {
    return { data: v.data, len: v.len, i: 0 };
}
