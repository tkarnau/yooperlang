// std/core/vec.yoop - Phase 8.H growable vector type.
//
// `Vec<T>` is the blessed growable-array primitive that std modules and
// user code build collections out of. Owns a heap-allocated backing buffer
// and grows on demand. Carries `propagates<disposable>` so the underlying
// memory cannot be silently dropped - the user must pick auto-cleanup
// (`disposable v: Vec<T> = vec_new(8);`), manual `Disposable.dispose`, or
// transfer-up via return.
//
// Allocation behavior per call (per the intrinsics-index naming convention):
//   * `vec_new`       -> fresh heap allocation
//   * `vec_push`      -> may reallocate (when len == cap)
//   * `vec_pop`       -> in place; no allocation
//   * `vec_get/_set`  -> in place; no allocation
//   * `vec_clear`     -> in place; capacity unchanged, no allocation
//   * `vec_as_array`  -> borrowing view valid until the next mutation
//   * `dispose`       -> frees the backing buffer

import { Disposable, disposable } from "./kinds.yoop";
import * as intr from "./intrinsics.yoop";
import { Allocator, currentAllocator, pushAllocator, popAllocator } from "./alloc.yoop";

// `Vec<T>` is container-owned: it remembers the allocator it was built with
// (whatever was current at `vec_new`) and routes every later grow and the
// final free back through that same allocator, regardless of what is current
// when those happen. So a Vec built inside an arena scope frees into the arena
// (a no-op; the region reclaims in bulk), and a malloc Vec stays malloc-backed
// even if it grows while an arena is installed.
export type Vec<T> implements Disposable propagates<disposable> {
    data: T[],
    len: usize,
    cap: usize,
    alloc: Allocator,
    function dispose(ref self): void {
        if (self.cap > 0) {
            let prev: Allocator = pushAllocator(self.alloc);
            intr.ctx_free(self.data);
            popAllocator(prev);
            self.cap = 0;
        }
    }
}

// Construct a fresh Vec with `initial_cap` capacity. Captures the current
// allocator. Caller must discharge the disposable obligation (auto-cleanup,
// manual dispose, or transfer up).
export function vec_new<T>(initial_cap: usize): Vec<T> propagates<disposable> {
    let a: Allocator = currentAllocator();
    return { data: intr.ctx_alloc(initial_cap), len: 0, cap: initial_cap, alloc: a };
}

// Append `value`, growing the backing buffer if necessary (doubling
// strategy). MAY REALLOCATE when len == cap - callers holding views from
// `vec_as_array` should re-fetch after a push.
export function vec_push<T>(v: ref Vec<T>, value: T): void {
    if (v.len >= v.cap) {
        let new_cap: usize = v.cap * 2;
        if (new_cap == 0) { new_cap = 4; }
        // Grow through the Vec's own allocator, not whatever is ambient now.
        let prev: Allocator = pushAllocator(v.alloc);
        let new_data: T[] = intr.ctx_alloc(new_cap);
        let i: usize = 0;
        while (i < v.len) {
            new_data[i] = v.data[i];
            i = i + 1;
        }
        if (v.cap > 0) {
            intr.ctx_free(v.data);
        }
        popAllocator(prev);
        v.data = new_data;
        v.cap = new_cap;
    }
    v.data[v.len] = value;
    v.len = v.len + 1;
}

// Read `v[i]`. Traps via the underlying array indexing if i >= v.len -
// matches the existing yoop array-indexing convention (no bounds check;
// caller's responsibility).
export function vec_get<T>(v: ref Vec<T>, i: usize): T {
    return v.data[i];
}

// Write `v[i] = value`. Same OOB convention as vec_get.
export function vec_set<T>(v: ref Vec<T>, i: usize, value: T): void {
    v.data[i] = value;
}

// Reset length to zero. Capacity unchanged; backing buffer is retained so
// subsequent pushes don't reallocate immediately.
export function vec_clear<T>(v: ref Vec<T>): void {
    v.len = 0;
}

// Borrowing view of the populated prefix as a regular yoop array. The view
// is valid until the next mutation (push/clear/dispose) - the underlying
// fat-pointer may dangle if vec_push reallocates.
export function vec_as_array<T>(v: ref Vec<T>): T[] {
    return intr.array_slice(v.data, 0, v.len);
}

// Append every element of `src` to `v`, growing the backing buffer at most
// once (to exactly `v.len + src.len` when a grow is needed). This is the
// bulk-append the byte-shuffling paths want: O(n) copies but a single
// allocation, versus `vec_push` in a loop which reallocates O(log n) times.
// MAY REALLOCATE - callers holding views from `vec_as_array` should re-fetch.
export function vec_extend_from<T>(v: ref Vec<T>, src: T[]): void {
    let needed: usize = v.len + src.len;
    if (needed > v.cap) {
        let prev: Allocator = pushAllocator(v.alloc);
        let new_data: T[] = intr.ctx_alloc(needed);
        let i: usize = 0;
        while (i < v.len) {
            new_data[i] = v.data[i];
            i = i + 1;
        }
        if (v.cap > 0) {
            intr.ctx_free(v.data);
        }
        popAllocator(prev);
        v.data = new_data;
        v.cap = needed;
    }
    let j: usize = 0;
    while (j < src.len) {
        v.data[v.len + j] = src[j];
        j = j + 1;
    }
    v.len = needed;
}

// Build a fresh Vec holding a copy of `src` (capacity == src.len, so no
// spare). Like `vec_new` it allocates once and carries the disposable
// obligation to the caller. `src` is unmodified - the bytes are copied, not
// aliased - so passing a borrowing view (string_as_bytes, array_slice) is
// safe.
export function vec_from_array<T>(src: T[]): Vec<T> propagates<disposable> {
    let a: Allocator = currentAllocator();
    let data: T[] = intr.ctx_alloc(src.len);
    let i: usize = 0;
    while (i < src.len) {
        data[i] = src[i];
        i = i + 1;
    }
    return { data: data, len: src.len, cap: src.len, alloc: a };
}
