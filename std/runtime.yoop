// std/runtime.yoop - the process and its worker pool, from the inside.
//
// Two things live here that a long-running service needs and a one-shot
// program never asks for:
//
//   1. **Pool sizing from source.** `YOOP_NUM_WORKERS` is an env var, which
//      means the decision belongs to whoever runs the binary. A server
//      usually wants to make it itself - "one worker per core", "leave a
//      core for the OS", "one, because my state is not locked". See
//      `setWorkerCount`.
//   2. **Introspection.** Uptime, resident memory, and the shared counters
//      that make a `/stats` endpoint tell the truth when more than one
//      worker thread is answering requests.
//
// On the concurrency model, because it differs from Node and the
// difference matters: yoop's pool is THREADS in ONE process sharing ONE
// address space, not Node's `cluster` of separate processes each with
// private memory. A module-level binding here is genuinely shared, so a
// counter touched by two workers needs `Counter` (below) rather than a
// plain `+= 1`. In exchange there is no IPC and no per-worker duplication
// of your route table or caches.
//
// Task scheduling itself is in std/core/concurrency.yoop; this module is
// about the pool those tasks run on.

extern "C" from "yoop_runtime" {
    function yoop_runtime_cpu_count(): int32;
    function yoop_runtime_worker_count(): int32;
    function yoop_runtime_set_worker_count(n: int32): int32;
    function yoop_runtime_rss_bytes(): uint64;
    function yoop_now_ns(): uint64;
    function yoop_stdout_linebuf(): void;

    function yoop_atomic_add_u64(p: ref uint64, delta: uint64): uint64;
    function yoop_atomic_sub_u64(p: ref uint64, delta: uint64): uint64;
    function yoop_atomic_load_u64(p: ref uint64): uint64;
    function yoop_atomic_store_u64(p: ref uint64, v: uint64): void;
    function yoop_atomic_cas_u64(p: ref uint64, expected: ref uint64, desired: uint64): int32;
}

// ----- the pool -----------------------------------------------------------

// Logical CPUs visible to the process. Node's `os.cpus().length`.
//
// Inside a container this is the HOST's core count, not the share cgroups
// will actually let you use - `docker run --cpus=2` on a 16-core box still
// reports 16. Size the pool from your own config when you have one and
// treat this as the ceiling.
export function cpuCount(): int32 {
    return yoop_runtime_cpu_count();
}

// Workers the pool has, or will have once the first task spawns it.
export function workerCount(): int32 {
    return yoop_runtime_worker_count();
}

// Ask for `n` workers. Returns false if the pool is already running.
//
// Workers spawn lazily on the first task submit, so this has to be called
// before ANY task starts - the top of `main` is the place. It overrides
// `YOOP_NUM_WORKERS`, so read that yourself first if you want the env var
// to keep winning.
//
// One worker is a real choice, not a degraded one: tasks still multiplex
// over it through the async I/O path, so a server keeps handling thousands
// of concurrent connections, and every worker-shared piece of state stops
// needing synchronization.
export function setWorkerCount(n: int32): bool {
    return yoop_runtime_set_worker_count(n) == 1;
}

// ----- process ------------------------------------------------------------

// Resident set size in bytes - physical memory the process occupies, and
// what a container memory limit is enforced against. Returns 0 where it is
// unavailable (today: Windows, which would need PSAPI linked in).
export function rssBytes(): uint64 {
    return yoop_runtime_rss_bytes();
}

// Monotonic nanoseconds, the same clock std/core/concurrency.yoop uses for
// deadlines. Only differences are meaningful; this is not a timestamp.
export function monotonicNs(): uint64 {
    return yoop_now_ns();
}

// Flush stdout after every line instead of when a 4KB buffer fills.
//
// A terminal gets line buffering for free; a PIPE does not, and stdout is
// a pipe under `docker logs`, systemd, and every CI runner. Without this a
// server's startup banner sits in the buffer indefinitely and the process
// looks hung when it is serving fine. Call it once at the top of `main` in
// anything long-running. (Unbuffered on Windows - see yoop_args.c for why
// the CRT leaves no better option.)
export function lineBufferStdout(): void {
    yoop_stdout_linebuf();
}

// ----- shared counters ----------------------------------------------------

// A 64-bit counter that stays exact when several workers touch it.
//
// Deliberately a struct with a plain field rather than an opaque handle:
// the storage is yours, so a counter can sit inline in whatever struct
// already owns the thing being counted, with no allocation and no
// separate lifetime to manage. Read `value` directly only when you know
// no other thread can be writing (setup, teardown); otherwise go through
// `counterGet`, which is what makes the read atomic.
export type Counter {
    value: uint64,
}

export function counterNew(): Counter {
    return { value: 0 };
}

// Add `delta` and return the NEW value, so a caller that needs the number
// it just produced does not have to re-read (and race).
export function counterAdd(ref c: Counter, delta: uint64): uint64 {
    return yoop_atomic_add_u64(ref c.value, delta);
}

// Convenience for the overwhelmingly common `+ 1`.
export function counterInc(ref c: Counter): uint64 {
    return yoop_atomic_add_u64(ref c.value, 1);
}

// Subtract `delta` and return the new value. Wraps on underflow, like the
// unsigned arithmetic it is - guard the caller, not this.
export function counterSub(ref c: Counter, delta: uint64): uint64 {
    return yoop_atomic_sub_u64(ref c.value, delta);
}

export function counterDec(ref c: Counter): uint64 {
    return yoop_atomic_sub_u64(ref c.value, 1);
}

export function counterGet(ref c: Counter): uint64 {
    return yoop_atomic_load_u64(ref c.value);
}

export function counterSet(ref c: Counter, v: uint64): void {
    yoop_atomic_store_u64(ref c.value, v);
}

// Compare-and-swap: set the counter to `desired` only if it still holds
// `expected`. Returns true on success; on failure `expected` is overwritten
// with the value actually observed, so a retry loop re-reads for free:
//
//     let seen: uint64 = rt.counterGet(ref c);
//     while (!rt.counterCas(ref c, ref seen, f(seen))) { }
//
// This is the primitive for "claim this slot exactly once" - the thing a
// plain load-then-store cannot express when two workers arrive together.
export function counterCas(ref c: Counter, ref expected: uint64, desired: uint64): bool {
    return yoop_atomic_cas_u64(ref c.value, ref expected, desired) == 1;
}
