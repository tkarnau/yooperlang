// A minimal bootstrap-parseable module: a struct and top-level functions, no
// imports. Used by main.yoop to smoke-test lex -> parse -> typecheck pass A end
// to end, so keep it inside what the bootstrap parser actually handles today.

type Point {
  x: int,
  y: int,
}

function add(a: int, b: int): int {
  return a + b;
}

function main(): int {
  const num = 32 + 10;

  return num;
}
