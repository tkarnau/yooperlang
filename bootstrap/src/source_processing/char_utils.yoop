/*
  Author: Tom Karnau

  Character Utilities - primarily used by lexer and parser functionality
*/

import * as intr from "std/core/intrinsics.yoop";
import * as log from "std/log.yoop";
import * as debug from "std/debug.yoop";
import { Option, Result } from "std/core/types.yoop";
import { SourceLocation } from "../contracts.yoop";

const whitespaceCharCodes: uint8[] = [32, 9, 13, 10];
function isWhitespace(ch: uint8): bool {
  for i in whitespaceCharCodes {
    if (ch == i) {
      return true;
    }
  }

  return false;
}

function skipLineComment(src: uint8[], pos: usize): usize {
  let p = pos;
  while (p < src.len) {
    let ch = src[p];
    if (ch == 10) {// new line
      return p;
    }
    p = p + 1;
  }

  return p;
}

// returns position after all discard space, comments, etc
export function skipWhitespace(src: uint8[], pos: usize): usize {
  let p = pos;
  // let strBytes = intr.string_as_bytes(src);

  while (p < src.len) {
    let ch = src[p];
    // log.info(`ch: ${ch}`);
    if (isWhitespace(ch)) {
      p = p + 1;
    } else { // check for comments
      if (p + 1 < src.len) {
        let nextCh = src[p + 1];
        if (ch == 47 && nextCh == 47) { // forward slashes
          p = skipLineComment(src, p);

          // continue
          return skipWhitespace(src, p);
        }
        if (ch == 47 && nextCh == 42) { // block comments
          p = p + 2;
          let blockCommentStack = 1;
          while (p + 1 < src.len) {
            if (src[p] == 42 && src[p + 1] == 47) {
              p = p + 2;
              blockCommentStack = blockCommentStack - 1;
              if (blockCommentStack == 0) {
                break;
              }
            } else if (src[p] == 47 && src[p + 1] == 42) {
              p += 2;
              blockCommentStack = blockCommentStack + 1;
            }
            p = p + 1;
          }

          // continue
          return skipWhitespace(src, p);
        }
      }

      return p;
    }
  }
  // eof fallback
  return p;
}

// bool checks

export function isHexDigit(ch: uint8): bool {
  const result = (
    isDigit(ch) ||
    (ch >= 'a' && ch <= 'f') ||
    (ch >= 'A' && ch <= 'F')
  );

  return result;
}

export function isDigit(ch: uint8): bool {
  return ch >= '0' && ch <= '9';
}

export function isBinDigit(ch: uint8): bool {
  return ch == '0' || ch == '1';
}

export function isOctDigit(ch:uint8): bool {
  return ch >= '0' && ch <= '7';
}

function isAlpha(ch: uint8): bool {
  return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z');
}

function isAlphaNumOr_(ch: uint8): bool {
  return isAlpha(ch) || isDigit(ch) || ch == '_';
}

// An identifier (or keyword) may start with a letter or an underscore, but not
// a digit - that is `lexNumericLiteral`'s job. The rest of the run is scanned
// by `scanIdentity`.
export function isIdentStart(ch: uint8): bool {
  return isAlpha(ch) || ch == '_';
}

// scan functions
//
// A scan predicate answers "does the byte at `pos` keep the run going?" and
// may reject the whole token (the underscore rules below). Every predicate
// gets the scanner's full context - the source, the current position, and the
// run's start - so none of them need to capture state: they're all plain
// top-level functions. `scanCharPredicates` takes them as a plain array of
// function pointers - no trait, no vtable, no per-predicate struct.

function hexDigitPred(src: uint8[], pos: usize, start: usize): Result<bool, string> {
  return Result.Ok { value: isHexDigit(src[pos]) };
}

function binDigitPred(src: uint8[], pos: usize, start: usize): Result<bool, string> {
  return Result.Ok { value: isBinDigit(src[pos]) };
}

function octDigitPred(src: uint8[], pos: usize, start: usize): Result<bool, string> {
  return Result.Ok { value: isOctDigit(src[pos]) };
}

function decDigitPred(src: uint8[], pos: usize, start: usize): Result<bool, string> {
  return Result.Ok { value: isDigit(src[pos]) };
}

function validUnderscorePred(src: uint8[], pos: usize, start: usize): Result<bool, string> {
  const isUnderscore = src[pos] == '_';
  if (isUnderscore) {
    if (pos == start) {
      // cannot start with an underscore
      return Result.Err { error: `numeric token at pos ${pos} starting with underscore is not allowed`};
    }
    if (pos + 1 >= src.len ||
      !isHexDigit(src[pos - 1]) ||
      !isHexDigit(src[pos + 1])) {
      return Result.Err { error: `numeric token at pos ${pos} underscore must be surrounded by digits` };
    }
  }

  return Result.Ok { value: isUnderscore };
}

function scanCharPredicates(
  src: uint8[],
  start: usize,
  ref predicates: ((src: uint8[], pos: usize, start: usize) => Result<bool, string>)[]):
    Result<usize, string> {
  let p = start;
  while (p < src.len) {
    let passed = false;
    for predicate in predicates {
      switch (predicate(src, p, start)) {
        case Result.Err { error: e }: {
          return Result.Err { error: e };
        }
        case Result.Ok { value: pass }: {
          if (pass) {
            p += 1;
            passed = true;
            break;
          }
        }
      }
    }
    if (!passed) {
      break;
    }
  }

  if (p == start) {
    return Result.Err { error: `expected one or more characters to satisfy a scanner predicate at pos ${p}` };
  }

  return Result.Ok { value: p };
}

function allocDigitPredicateArr(size: usize): ((src: uint8[], pos: usize, start: usize) => Result<bool, string>)[] {
  return intr.heap_alloc(size);
}

export function scanHexDigitsAndUnderscores(src: uint8[], start: usize): Result<usize, string> {
  let predicates = allocDigitPredicateArr(2);
  predicates[0] = hexDigitPred;
  predicates[1] = validUnderscorePred;
  const result = scanCharPredicates(src, start, ref predicates);

  intr.heap_free(predicates);
  return result;
}

export function scanBinDigitsAndUnderscores(src: uint8[], start: usize): Result<usize, string> {
  let predicates = allocDigitPredicateArr(2);
  predicates[0] = binDigitPred;
  predicates[1] = validUnderscorePred;
  const result = scanCharPredicates(src, start, ref predicates);

  intr.heap_free(predicates);
  return result;
}

export function scanOctDigitsAndUnderscores(src: uint8[], start: usize): Result<usize, string> {
  let predicates = allocDigitPredicateArr(2);
  predicates[0] = octDigitPred;
  predicates[1] = validUnderscorePred;
  const result = scanCharPredicates(src, start, ref predicates);

  intr.heap_free(predicates);
  return result;
}

export function scanDecDigitsAndUnderscores(src: uint8[], start: usize): Result<usize, string> {
  let predicates = allocDigitPredicateArr(2);
  predicates[0] = decDigitPred;
  predicates[1] = validUnderscorePred;
  const result = scanCharPredicates(src, start, ref predicates);

  intr.heap_free(predicates);
  return result;
}



export function scanStringLiteral(src: uint8[], start: usize): Option<usize> {
  const quote = src[start];
  let p = start + 1;
  while (p < src.len) {
    const ch = src[p];
    if (ch == '\\') { // check for escape char
      p += 2;
    } else if (ch == quote) {
      return Option.Some { value: p + 1 };
    } else {
      p += 1;
    }
  }
  return Option.None;
}

export function scanIdentity(src: uint8[], start: usize): usize {
  let p = start;
  while (p < src.len) {
    const ch = src[p];
    if (isAlphaNumOr_(ch)) {
      p += 1;
    } else {
      break;
    }
  }

  return p;
}

export function digitValue(ch: uint8): int {
  if (ch >= '0' && ch <= '9') { return int(ch - '0'); }
  if (ch >= 'a' && ch <= 'f') { return int(ch - 'a') + 10; }
  if (ch >= 'A' && ch <= 'F') { return int(ch - 'A') + 10; }
  return 0;
}

export function posToSourceLocation(ref src: uint8[], pos: usize, length: usize): SourceLocation {
  debug.assert(pos <= src.len, `posToSourceLocation failed, pos ${pos} cannot be outside src length ${src.len}`);

  let i: usize = 0;
  let line: usize = 0;
  let lastNewLinePos: usize = 0;
  while (i < pos) {
    if (src[i] == '\n') {
      line += 1;
      lastNewLinePos = i;
    }
    i += 1;
  }
  const column = pos - lastNewLinePos;
  return {
    line: line,
    column: column,
    pos: pos,
    length: length
  };
}