import { Result } from "std/core/types.yoop";
import { ParsingResult, ASTNode, ASTNodeKind, TokenTags, tagName, getTokenPrecedence } from "../../contracts.yoop";
import { ParserState, SelfLexing as sl, peekLengthUsize } from "./parser_state.yoop";
import { parseIdentAsName } from "./names.yoop";

export function parseExpressionStatement(ref ps: ParserState): ParsingResult {
  let node = sl.buildSourcedNode(ref ps, ASTNodeKind.EXPRESSION_STATEMENT);
  node.childA = parseExpression(ref ps, 0)?;
  sl.expect(ref ps, TokenTags.SEMICOLON)?;

  return Result.Ok { value: sl.pushNode(ref ps, node) };
}

export function parseExpression(ref ps: ParserState, minPrecedence: int): ParsingResult {
  let node: ASTNode;
  const peekTag = sl.peek(ref ps).tag;
  // prefix first
  switch (peekTag) {
    case TokenTags.MINUS: {
      sl.advance(ref ps); // consume the dash
      const operand = parseExpression(ref ps, 70);
      // todo finish minus - moved on to intLiteral to test the flow
    }
    case TokenTags.INTLITERAL: {
      node = sl.buildSourcedNode(ref ps, ASTNodeKind.INT_LITERAL);
      node.intVal = sl.advance(ref ps)?.intVal;
    }
    case TokenTags.IDENT: {
      const name = parseIdentAsName(ref ps)?;
      // handle errno stuff...
      // handle unsafe_ptr stuff...
      if (sl.peek(ref ps).tag == TokenTags.LPAREN) {
        // todo callexpression...
      } else {
        node = sl.buildSourcedNode(ref ps, ASTNodeKind.IDENT);
        node.name = name;
      }
    }
    default: {
      return Result.Err { error: sl.createParsingError(
        ref ps,
        `unexpected token in expression: ${tagName(peekTag)}`,
        peekLengthUsize(ref ps),
      )};
    }
  }

  // postfix

  // assignment
  // compound assignment
  // binary ops
  while (true) {
    let opToken = sl.peek(ref ps);
    const precedence = getTokenPrecedence(opToken.tag);
    if (precedence <= minPrecedence) {
      break;
    }

    sl.advance(ref ps)?; // consumer operator token
    // recurse through, finding the side - actually using the precedence here
    const right = parseExpression(ref ps, precedence)?;
    let binNode = sl.buildSourcedNode(ref ps, ASTNodeKind.BINARY_EXPRESSION);
    binNode.operator = opToken.tag;
    // push the current node onto the left
    binNode.childA = sl.pushNode(ref ps, node);
    binNode.childB = right;
    // set the current node to the binnode, and eventually push the final one
    node = binNode;
  }
  // return
  return Result.Ok { value: sl.pushNode(ref ps, node) };
}
