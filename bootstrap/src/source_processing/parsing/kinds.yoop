import { Result } from "std/core/types.yoop";
import { TokenTags, NodeId, ParsingError, ASTNodeKind } from "../../contracts.yoop";
import { ParserState, SelfLexing as sl } from "./parser_state.yoop";
import { parseIdentAsName } from "./names.yoop";

export function consumeKindPrefixWithArgs(ref ps: ParserState): Result<NodeId, ParsingError> {
  const kindTok = sl.expect(ref ps, TokenTags.IDENT)?;
  const   name = parseIdentAsName(ref ps)?;
  // let args = null;

  if (sl.peek(ref ps).tag == TokenTags.LPAREN) {
    sl.advance(ref ps);
    let peekTag = sl.peek(ref ps).tag;
    while (peekTag != TokenTags.RPAREN && peekTag != TokenTags.EOF) {
      // push into "args" nodes as a node list
      if (peekTag == TokenTags.COMMA) {
        sl.advance(ref ps);
        peekTag = sl.peek(ref ps).tag;
      }
    }
    sl.expect(ref ps, TokenTags.RPAREN)?;
  }
  let node = sl.buildSourcedNode(ref ps, ASTNodeKind.KIND_PREFIX);
  node.name = name;
  return Result.Ok { value: sl.pushNode(ref ps, node) };
}