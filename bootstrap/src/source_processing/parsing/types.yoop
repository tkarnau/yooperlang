import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ASTNodeKind, TokenTags, NodeId, ParsingError } from "../../contracts.yoop";
import { SelfLexing as sl, ParserState, peekLengthUsize } from "./parser_state.yoop";
import { parseIdentAsName } from "./names.yoop";
import { posToSourceLocation } from "../char_utils.yoop";
import { findMatchingRParen } from "./utils.yoop";
import { consumeKindPrefixWithArgs } from "./kinds.yoop";

// `<T, U>` after a type name (generics, etc). Returns the NodeId of a NODE_LIST holding the
// TYPE_PARAM nodes, or 0 (the none sentinel) when there is no list.
export function parseTypeParamList(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (sl.peek(ref ps).tag != TokenTags.LT) {
    return Result.Ok { value: 0 };
  }
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  sl.advance(ref ps)?; // consume `<`

  if (sl.peek(ref ps).tag == TokenTags.GT) {
    return Result.Err { error: sl.createParsingError(
      ref ps,
      `empty type parameter list <> is not allowed`,
      peekLengthUsize(ref ps),
    )};
  }

  // Collect each TYPE_PARAM's NodeId in a scratch buffer, then splice the whole
  // run into the arena in one shot (see buildListNode).
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (true) {
    let tp = sl.buildSourcedNode(ref ps, ASTNodeKind.TYPE_PARAM);
    tp.name = parseIdentAsName(ref ps)?;
    // TODO: optional `implements` bound list (`T implements Display`) - needs
    // parseTypeAnnotation; deferred until type-annotation nodes are designed.
    vec.vecPush(ref ids, sl.pushNode(ref ps, tp));
    if (sl.peek(ref ps).tag != TokenTags.COMMA) {
      break;
    }
    sl.advance(ref ps)?; // consume `,`
  }
  sl.expect(ref ps, TokenTags.GT)?;

  return Result.Ok { value: sl.buildListNode(ref ps, ref ids, loc) };
}

export function parseTypeDecl(ref ps: ParserState): Result<NodeId, ParsingError> {
  sl.expect(ref ps, TokenTags.TYPE)?; // don't care about the token
  let node = sl.buildSourcedNode(ref ps, ASTNodeKind.TYPE_DECL);
  node.name = parseIdentAsName(ref ps)?;
  node.childA = parseTypeParamList(ref ps)?; // typeParams list-node (0 = none)

  // node.kindPrefix
  if (sl.peek(ref ps).tag == TokenTags.IDENT) {
    let afterIdx: usize = 1;
    if (sl.peekAhead(ref ps, 1)?.tag == TokenTags.LPAREN) { // NOTE(tom): may be an incorrect to fail here
      const jRes = findMatchingRParen(ref ps, 1);
      switch (jRes) {
        case Option.None {}: {
          afterIdx = 0; // rparen not found, will fail next steps, that's not our problem here.
        }
        case Option.Some { value: j }: {
          afterIdx = j + 1;
        }
      }
    }
    if (afterIdx > 0) {
      const after = sl.peekAhead(ref ps, afterIdx)?;
      if (
        after.tag == TokenTags.IMPLEMENTS ||
        after.tag == TokenTags.PROPAGATES ||
        after.tag == TokenTags.CONTAINS ||
        after.tag == TokenTags.LCURLY ||
        after.tag == TokenTags.EQ
      ) {
        node.childB = consumeKindPrefixWithArgs(ref ps)?;
      }
    }
  }
  // TODO: the rest of the type decl - optional kind prefix, `implements`
  // clause, propagates/contains clauses, and then either the struct body
  // (`{ field: Type, ... }` -> this node's own childStart/childCount run) or a
  // transparent alias RHS (`= Type;`). Those need parseTypeAnnotation AND a
  // decision on how type-annotation nodes live in the arena (no TYPE_NAME /
  // REF_TYPE / ARRAY_TYPE kinds exist yet). For now a TYPE_DECL carries only
  // its name + type params.

  return Result.Ok { value: sl.pushNode(ref ps, node) };
}

// original js compiler had a custom shape for this, but we're going to fit it
// as a regular AST node
export function parseTypeAnnotation(ref ps: ParserState): Result<NodeId, ParsingError> {
  // TODO - clearance kind support like tainted uint8[], or cleared validated Foo
  // TODO - Function param types or wrapped type for attaching as an array
  // ref T
  let peekTag = sl.peek(ref ps).tag;
  if (peekTag == TokenTags.REF) {
    sl.advance(ref ps)?;
    let refNode = sl.buildSourcedNode(ref ps, ASTNodeKind.TYPE_ANNOTATION_REF_TYPE);
    refNode.childA = parseTypeAnnotation(ref ps)?;
    return Result.Ok { value: sl.pushNode(ref ps, refNode) };
  }
  // other conditions.. for now just do a basic type without namespace...
  let typeNameNode = sl.buildSourcedNode(ref ps, ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME);
  let name = parseIdentAsName(ref ps)?;
  typeNameNode.name = name;

  return Result.Ok { value: sl.pushNode(ref ps, typeNameNode) };
}
