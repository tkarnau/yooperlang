module test_mode;

/*
  The synthetic entry module: a `main` that hands the collected suites to
  std/test.yoop.

  It is SOURCE rather than an AST. Generating text and letting the ordinary
  lexer and parser read it means there is no second path into the arena to keep
  in step with the first - the same choice the derive expansion makes (see
  parse/derive_text.yoop), and the same one the reference makes.

  It is never written to disk. `--test bootstrap/src/typecheck` would otherwise
  drop a `.yoop` file into a DIRECTORY MODULE, and every file in such a
  directory is absorbed into the module - so the entry would join the very
  module it is supposed to test. The graph is seeded from these bytes instead;
  see loadModuleGraphFromSource in source_graph/walk.yoop.

  Each suite is imported BY NAME under a generated alias rather than through a
  namespace, for the reference's two reasons and both hold here: two test files
  may each declare a `setup`, and a namespaced function in VALUE position is
  not something either codegen lowers.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";
import * as fs from "std/fs.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { disposable } from "std/core/kinds.yoop";

// Basename the synthetic entry answers to. It lives in the search root so a
// relative import WOULD resolve, though every import it writes is absolute or
// a `std/` one. The name is deliberately not something anyone would want: a
// real file called this would be shadowed by the generated one.
export const ENTRY_BASENAME: string = "yoopiler_generated_test_entry.yoop";

// Absolute path the synthetic entry is registered under.
export function entryPathFor(rootDir: string): string {
  return fs.pathJoin([rootDir, ENTRY_BASENAME]);
}

// The entry module's source.
//
// Built with `Text` rather than by concatenation: every built `string` is a raw
// malloc nothing frees, and this one is assembled a token at a time across two
// nested loops.
export function generateEntrySource(ref files: Vec<SuiteFile>): Text propagates<disposable> {
  let out: Text = text.make(4096);
  text.push(ref out, "// Generated by yoopiler_boot --test. Not written to disk.\n");
  text.push(ref out, "import * as harness from \"std/test.yoop\";\n");
  pushSuiteImports(ref out, ref files);

  text.push(ref out, "\nfunction main(): int {\n");
  text.push(ref out, "  const fns: (() => void)[] = [");
  pushAliasList(ref out, ref files);
  text.push(ref out, "];\n");
  text.push(ref out, "  const names: string[] = [");
  pushLabelList(ref out, ref files);
  text.push(ref out, "];\n");
  text.push(ref out, "  return harness.runAll(fns, names);\n");
  text.push(ref out, "}\n");
  return out;
}

// One `import { <suite> as suiteN } from "<absPath>";` per collected suite.
function pushSuiteImports(ref out: Text, ref files: Vec<SuiteFile>): void {
  let n: usize = 0;
  let f: usize = 0;
  while (f < files.len) {
    const file = vec.vecGet(ref files, f);
    let s: usize = 0;
    while (s < file.suites.len) {
      text.push(ref out, "import { ");
      text.push(ref out, vec.vecGet(ref file.suites, s));
      text.push(ref out, " as ");
      pushAlias(ref out, n);
      text.push(ref out, " } from \"");
      pushEscaped(ref out, file.absPath);
      text.push(ref out, "\";\n");
      n += 1;
      s += 1;
    }
    f += 1;
  }
}

// `suite0, suite1, ...` - the table, in the same order the imports were
// written, which is what pairs it with the labels below.
function pushAliasList(ref out: Text, ref files: Vec<SuiteFile>): void {
  let n: usize = 0;
  let f: usize = 0;
  while (f < files.len) {
    const file = vec.vecGet(ref files, f);
    let s: usize = 0;
    while (s < file.suites.len) {
      if (n > 0) {
        text.push(ref out, ", ");
      }
      pushAlias(ref out, n);
      n += 1;
      s += 1;
    }
    f += 1;
  }
}

// `"<relPath>:<suite>", ...` - what a running suite is announced under, so a
// failure names a path short enough to read and the function to open.
function pushLabelList(ref out: Text, ref files: Vec<SuiteFile>): void {
  let n: usize = 0;
  let f: usize = 0;
  while (f < files.len) {
    const file = vec.vecGet(ref files, f);
    let s: usize = 0;
    while (s < file.suites.len) {
      if (n > 0) {
        text.push(ref out, ", ");
      }
      text.push(ref out, "\"");
      pushEscaped(ref out, file.relPath);
      text.push(ref out, ":");
      pushEscaped(ref out, vec.vecGet(ref file.suites, s));
      text.push(ref out, "\"");
      n += 1;
      s += 1;
    }
    f += 1;
  }
}

// `suiteN`. The alias is positional rather than derived from the function's own
// name, which is exactly what makes two files declaring the same suite name
// legal.
function pushAlias(ref out: Text, n: usize): void {
  text.push(ref out, "suite");
  text.pushUint(ref out, uint64(n));
}

// The bytes of `s`, with the two a yoop string literal cannot carry raw escaped.
// A path with a quote in it is not something anyone means to write, but a
// generated literal that silently ends early is a parse error in source nobody
// can open, so it is worth the loop.
function pushEscaped(ref out: Text, s: string): void {
  const raw = intr.stringAsBytes(s);
  let i: usize = 0;
  while (i < raw.len) {
    if (raw[i] == '\\' || raw[i] == '"') {
      text.pushByte(ref out, '\\');
    }
    text.pushByte(ref out, raw[i]);
    i += 1;
  }
}
