module typecheck;

// Pass D - check function bodies and decorate every node codegen will read.
//
// Decoration is the dense `TypedModule.resolvedTypes` vector indexed by NodeId
// (decision D2): the AST stays the parser's immutable output and the types live
// beside it. Codegen may assume every node it visits has a concrete TypeId here.
//
// This is the thinnest pass D that gets a program to an executable. It handles
// int and string literals, calls, and return statements; anything else gets a
// named "not supported yet" diagnostic rather than a silently untyped node.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, nodeAt, kindName } from "../ast";
import { SourceLocation } from "../diagnostics";
import { Module } from "../source_graph";
import { TokenTags, tagSpelling } from "../lex";
import * as str from "std/core/strings.yoop";
import { Option } from "std/core/types.yoop";

export function passDCheckBodies(ref prog: Program, ref tm: TypedModule, m: Module): void {
  // One decoration slot per arena node, so a NodeId indexes straight in.
  // TYPE_ERROR_ID doubles as "nothing resolved here".
  vec.vecClear(ref tm.resolvedTypes);
  let n: usize = 0;
  while (n < m.ast.nodes.len) {
    vec.vecPush(ref tm.resolvedTypes, TYPE_ERROR_ID);
    n += 1;
  }

  let f: usize = 0;
  while (f < m.files.len) {
    const file = vec.vecGet(ref m.files, f);
    beginFile(ref prog, file.absPath);
    checkFileBodies(ref prog, ref tm, m, file.root);
    f += 1;
  }
}

function checkFileBodies(ref prog: Program, ref tm: TypedModule, m: Module, root: NodeId): void {
  const programNode = nodeAt(ref m.ast, root);
  let i: usize = 0;
  while (i < programNode.childCount) {
    const declId = declOf(ref m.ast, childAt(ref m.ast, programNode, i));
    const declNode = nodeAt(ref m.ast, declId);
    if (declNode.kind == ASTNodeKind.FUNCTION_DECL) {
      checkFunctionBody(ref prog, ref tm, ref m.ast, declNode);
    }
    // A type's METHODS have bodies too, and they are not module-level names -
    // so the walk has to reach into the decl to find them.
    if (declNode.kind == ASTNodeKind.TYPE_DECL ||
        declNode.kind == ASTNodeKind.VARIANT_DECL ||
        declNode.kind == ASTNodeKind.ENUM_DECL) {
      checkMethodBodies(ref prog, ref tm, ref m.ast, declNode);
    }
    i += 1;
  }
}

// Every METHOD_DECL member of a type decl. Its signature is already in the
// owner's method table, so this is the same job checkFunctionBody does with the
// lookup replaced.
function checkMethodBodies(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): void {
  const ownerType = ownTypeOf(ref prog, ref tm, declNode.name);

  // A generic type's methods talk about `T` - in `ref self`, in their
  // parameters, and in any annotation inside the body - so its parameters go
  // into scope for the whole run, the same way a generic function's do.
  disposable names: Vec<string> = bodyTypeParamNames(ref ast, declNode);
  disposable params: Vec<TypeId> = bodyTypeParams(ref prog, ref tm, declNode);
  if (names.len > 0) {
    beginTypeParams(ref prog, ref params, ref names);
  }

  let i: usize = 0;
  while (i < declNode.childCount) {
    const memberId = childAt(ref ast, declNode, i);
    const member = nodeAt(ref ast, memberId);
    if (member.kind == ASTNodeKind.METHOD_DECL) {
      checkBodyAgainst(ref prog, ref tm, ref ast, member,
        lookupMethod(ref prog, ownerType, member.name));
    }
    i += 1;
  }

  if (names.len > 0) {
    endTypeParams(ref prog);
  }
}

// The type a decl's own name binds to. Only used to reach a method table.
function ownTypeOf(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  const symId = lookupOwnName(ref tm, name);
  if (symId == SYMBOL_NONE_ID) {
    return TYPE_ERROR_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Struct { typeId: t }: { return t; }
    case Symbol.VariantT { typeId: t }: { return t; }
    case Symbol.ValueEnum { typeId: t }: { return t; }
    // A GENERIC type's methods hang off its TEMPLATE. Without this the lookup
    // fails, the body is never checked, and its parameters are never decorated
    // - which codegen finds out about as an empty owner name and a void return.
    case Symbol.GenericDecl { decl: d, sort: srt }: { return genericAt(ref prog, d).template; }
    default: { return TYPE_ERROR_ID; }
  }
}

function checkFunctionBody(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): void {
  const symId = lookupOwnName(ref tm, declNode.name);
  if (symId == SYMBOL_NONE_ID) {
    return;
  }
  // A GENERIC function is checked ONCE, against its template - so its type
  // parameters stay opaque and its decoration is written in terms of them.
  // Codegen substitutes per instantiation rather than pass D re-checking, which
  // is sound precisely because a parameter has no bounds: an opaque `T` supports
  // nothing, so a body that checks generically checks for every instantiation.
  // When bounds land, this is the decision to revisit.
  let signature: TypeId = TYPE_ERROR_ID;
  let generic = false;
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Func { typeId: t }: { signature = t; }
    case Symbol.GenericDecl { decl: d, sort: s }: {
      if (s != GenericSort.FUNC) {
        return;
      }
      signature = genericAt(ref prog, d).template;
      generic = true;
    }
    default: { return; }
  }

  if (!generic) {
    checkBodyAgainst(ref prog, ref tm, ref ast, declNode, signature);
    return;
  }

  // The parameters have to be in scope for the BODY, not just the signature:
  // `let new_data: T[] = ...` is an annotation inside the body, and `T` means
  // nothing without them. Pass C does the same around a signature; this is the
  // half that was missing.
  disposable names: Vec<string> = bodyTypeParamNames(ref ast, declNode);
  disposable params: Vec<TypeId> = bodyTypeParams(ref prog, ref tm, declNode);
  beginTypeParams(ref prog, ref params, ref names);
  checkBodyAgainst(ref prog, ref tm, ref ast, declNode, signature);
  endTypeParams(ref prog);
}

// The declared type-parameter NAMES of a generic decl, in order.
function bodyTypeParamNames(ref ast: AST, declNode: ASTNode): Vec<string> propagates<disposable> {
  let names: Vec<string> = vec.vecNew(2);
  if (declNode.childA == 0) {
    return names;
  }
  const list = nodeAt(ref ast, declNode.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    vec.vecPush(ref names, nodeAt(ref ast, childAt(ref ast, list, i)).name);
    i += 1;
  }
  return names;
}

// The TypeParam ids pass A interned for it - the SAME ids the template's
// signature uses, so a body annotation and the signature agree.
function bodyTypeParams(
  ref prog: Program,
  ref tm: TypedModule,
  declNode: ASTNode
): Vec<TypeId> propagates<disposable> {
  const symId = lookupOwnName(ref tm, declNode.name);
  if (symId == SYMBOL_NONE_ID) {
    return vec.vecNew(0);
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.GenericDecl { decl: d, sort: s }: {
      let info = genericAt(ref prog, d);
      return vec.vecFromArray(vec.vecAsArray(ref info.params));
    }
    default: { return vec.vecNew(0); }
  }
}

// Bind the parameters from `signature` and check the body against its return
// type. Shared by a function and a method, which differ only in where the
// signature was found.
function checkBodyAgainst(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode,
  signature: TypeId
): void {
  let retType: TypeId = TYPE_VOID_ID;
  let paramTypes: Vec<TypeId> = vec.vecNew(0);
  switch (typeAt(ref prog, signature)) {
    case Type.Func { params: p, ret: r, variadic: v }: {
      retType = r;
      paramTypes = p;
    }
    default: { return; }
  }

  if (declNode.childD != 0) {
    // `?` needs the enclosing function's return type, and it can sit at any
    // depth of an expression - so the answer is ambient rather than threaded
    // through every expression helper. See the fields on Program.
    beginFunction(ref prog, declNode.name, retType);
    disposable scope: LocalScope = scopeNew();
    bindParams(ref prog, ref tm, ref ast, declNode, ref paramTypes, ref scope);
    checkBlock(ref prog, ref tm, ref ast, declNode.childD, retType, ref scope);
  }
}

// Parameters are locals the caller filled in. Their types come from the Func
// type pass C built, not from re-resolving the annotations, so the signature
// stays the single source of truth.
function bindParams(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode,
  ref paramTypes: Vec<TypeId>,
  ref scope: LocalScope
): void {
  if (declNode.childB == 0) {
    return;
  }
  const list = nodeAt(ref ast, declNode.childB);
  let i: usize = 0;
  while (i < list.childCount) {
    const paramId = childAt(ref ast, list, i);
    const paramNode = nodeAt(ref ast, paramId);
    let t: TypeId = TYPE_ERROR_ID;
    if (i < paramTypes.len) {
      t = vec.vecGet(ref paramTypes, i);
    }
    // A `ref v: Vec<T>` parameter is `ref Vec<T>` in the SIGNATURE - that is
    // what makes passing a bare `v` an error - but the BODY sees a plain
    // `Vec<T>`, because a borrow IS the thing it borrows as far as the callee
    // is concerned. Unwrapping here is what keeps every read, write and field
    // access in the body from needing to know about references at all.
    const bound = derefType(ref prog, t);
    // A parameter is a local COPY, so writing to it is ordinary. A `ref`
    // parameter is mutable too - that is the whole point of the borrow.
    //
    // The binding REMEMBERS which of the two it was, because the unwrapping is
    // not total: a name that is already a borrow may be forwarded into another
    // `ref T` slot with no second `ref` written, and by then `bound` no longer
    // says so. See `reborrowIfWanted`.
    let declared = true;
    if (bound != t) {
      declared = scopeDeclareRefParam(ref scope, paramNode.name, bound);
    } else {
      declared = scopeDeclare(ref scope, paramNode.name, bound, true);
    }
    if (!declared) {
      reportError(ref prog, `parameter "${paramNode.name}" is declared more than once`, paramNode.sourceLoc);
    }
    // The DECORATION keeps the signature type: it is what codegen emits the
    // parameter as, and a `ref` parameter arrives as a pointer.
    vec.vecSet(ref tm.resolvedTypes, paramId, t);
    i += 1;
  }
}

function checkBlock(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  blockId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  const block = nodeAt(ref ast, blockId);
  if (block.childA == 0) {
    return;
  }
  const list = nodeAt(ref ast, block.childA);
  scopePush(ref scope);
  let i: usize = 0;
  while (i < list.childCount) {
    checkStatement(ref prog, ref tm, ref ast, childAt(ref ast, list, i), retType, ref scope);
    i += 1;
  }
  scopePop(ref scope);
}

function checkStatement(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmtId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  const stmt = nodeAt(ref ast, stmtId);
  switch (stmt.kind) {
    case ASTNodeKind.RETURN_STATEMENT: {
      if (stmt.childA == 0) {
        return;   // bare `return;`
      }
      // The return type is what an untyped literal in the expression pins to.
      const got = checkExpr(ref prog, ref tm, ref ast, stmt.childA, retType, ref scope);
      if (got != TYPE_ERROR_ID && retType != TYPE_ERROR_ID && !typeAccepts(ref prog, retType, got)) {
        reportError(
          ref prog,
          `cannot return ${formatType(ref prog, got)} from a function returning ${formatType(ref prog, retType)}`,
          stmt.sourceLoc
        );
      }
    }
    // `expr;` and `_ = expr;` differ only in whether the discard was written
    // down. Neither supplies an expectation, so an untyped literal in either
    // takes its own default.
    case ASTNodeKind.EXPRESSION_STATEMENT, ASTNodeKind.DISCARD_STATEMENT: {
      checkExpr(ref prog, ref tm, ref ast, stmt.childA, TYPE_ERROR_ID, ref scope);
    }
    case ASTNodeKind.LET_DECL, ASTNodeKind.CONST_DECL: {
      checkVarDecl(ref prog, ref tm, ref ast, stmt, stmtId, retType, ref scope);
    }
    case ASTNodeKind.IF_STATEMENT: {
      checkCondition(ref prog, ref tm, ref ast, stmt.childA, ref scope);
      checkBlock(ref prog, ref tm, ref ast, stmt.childB, retType, ref scope);
      if (stmt.childC != 0) {
        // The else branch is a BLOCK, or another IF_STATEMENT for `else if`.
        if (nodeAt(ref ast, stmt.childC).kind == ASTNodeKind.IF_STATEMENT) {
          checkStatement(ref prog, ref tm, ref ast, stmt.childC, retType, ref scope);
        } else {
          checkBlock(ref prog, ref tm, ref ast, stmt.childC, retType, ref scope);
        }
      }
    }
    case ASTNodeKind.WHILE_STATEMENT: {
      checkCondition(ref prog, ref tm, ref ast, stmt.childA, ref scope);
      scope.loopDepth += 1;
      checkBlock(ref prog, ref tm, ref ast, stmt.childB, retType, ref scope);
      scope.loopDepth -= 1;
    }
    case ASTNodeKind.FOR_LOOP: {
      checkForLoop(ref prog, ref tm, ref ast, stmt, stmtId, retType, ref scope);
    }
    case ASTNodeKind.FOR_IN_LOOP: {
      checkForInLoop(ref prog, ref tm, ref ast, stmt, stmtId, retType, ref scope);
    }
    case ASTNodeKind.KIND_REGION: {
      checkKindRegion(ref prog, ref tm, ref ast, stmt, stmtId, retType, ref scope);
    }
    case ASTNodeKind.SWITCH_STATEMENT: {
      checkSwitch(ref prog, ref tm, ref ast, stmt, retType, ref scope);
    }
    case ASTNodeKind.BREAK_STATEMENT: {
      // A SWITCH is a breakable scope, exactly as a loop is: `break` leaves the
      // switch. So either counter being non-zero makes it legal, and the two
      // are deliberately NOT merged into one depth - `continue` below reads
      // only the loop half.
      if (scope.loopDepth == 0 && scope.switchDepth == 0) {
        reportError(
          ref prog,
          "\"break\" is only legal inside a loop or a switch",
          stmt.sourceLoc
        );
      }
    }
    case ASTNodeKind.CONTINUE_STATEMENT: {
      // NOT symmetric with `break`. A switch is a break target only, so
      // `continue` keeps targeting the enclosing LOOP and a switch supplies
      // none - which is the reference's rule, and why the two depths exist.
      if (scope.loopDepth == 0) {
        reportError(
          ref prog,
          "\"continue\" is only legal inside a loop",
          stmt.sourceLoc
        );
      }
    }
    default: {
      reportError(ref prog, `pass D does not handle ${kindName(stmt.kind)} yet`, stmt.sourceLoc);
    }
  }
}

// Returns the node's type AND records it. `expected` is the type an untyped
// literal should pin to, or TYPE_ERROR_ID when there is no expectation.
function checkExpr(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  exprId: NodeId,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  const expr = nodeAt(ref ast, exprId);
  let resolved: TypeId = TYPE_ERROR_ID;

  switch (expr.kind) {
    case ASTNodeKind.INT_LITERAL: {
      // An int literal is untyped until context pins it, and it may only pin to
      // an INTEGER type - the JS reference rejects untyped-int-to-float too.
      // With no expectation, or an expectation it cannot satisfy, it falls back
      // to int32 and the caller's own check reports the mismatch.
      if (expected != TYPE_ERROR_ID && isIntPrimType(ref prog, expected)) {
        resolved = expected;
      } else {
        if (expected == TYPE_ERROR_ID) {
          resolved = primTypeId(PrimKind.INT32);
        } else {
          reportError(
            ref prog,
            `cannot assign untyped int to ${formatType(ref prog, expected)}`,
            expr.sourceLoc
          );
          // Stay TYPE_ERROR_ID so the caller's own mismatch check stays quiet:
          // one problem should produce one diagnostic.
        }
      }
    }
    // A float literal is untyped until context pins it, and it may only pin to
    // a FLOAT type - not to an integer, which is the mirror of the rule above.
    // Unconstrained it defaults to float64, which is what the reference infers
    // for `const a = 1.5` before its codegen refuses to lower the literal.
    case ASTNodeKind.FLOAT_LITERAL: {
      if (expected != TYPE_ERROR_ID && isFloatPrimType(ref prog, expected)) {
        resolved = expected;
      } else {
        if (expected == TYPE_ERROR_ID) {
          resolved = primTypeId(PrimKind.FLOAT64);
        } else {
          reportError(
            ref prog,
            `cannot assign untyped float to ${formatType(ref prog, expected)}`,
            expr.sourceLoc
          );
        }
      }
    }
    case ASTNodeKind.STRING_LITERAL: {
      resolved = primTypeId(PrimKind.STRING);
    }
    case ASTNodeKind.TEMPLATE_LITERAL: {
      checkTemplateParts(ref prog, ref tm, ref ast, expr, ref scope);
      resolved = primTypeId(PrimKind.STRING);
    }
    case ASTNodeKind.BOOL_LITERAL: {
      resolved = primTypeId(PrimKind.BOOL);
    }
    case ASTNodeKind.DEREF_EXPRESSION: {
      resolved = checkDeref(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.ADDRESS_OF_EXPRESSION: {
      resolved = checkAddressOf(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.SLICE_EXPRESSION: {
      resolved = checkSlice(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.NULL_LITERAL: {
      // Pins to the expected pointer type when there is one, exactly as an
      // untyped int literal pins to an integer. Without an expectation it stays
      // untyped, and typeAccepts lets it into any `unsafe_ptr` later.
      if (isUnsafePtrType(ref prog, expected)) {
        resolved = expected;
      } else {
        resolved = TYPE_UNTYPED_NULL_ID;
      }
    }
    case ASTNodeKind.UNARY_EXPRESSION: {
      resolved = checkUnary(ref prog, ref tm, ref ast, expr, expected, ref scope);
    }
    case ASTNodeKind.ARRAY_LITERAL: {
      resolved = checkArrayLiteral(ref prog, ref tm, ref ast, expr, expected, ref scope);
    }
    case ASTNodeKind.STRUCT_LITERAL: {
      resolved = checkStructLiteral(ref prog, ref tm, ref ast, expr, expected, ref scope);
    }
    case ASTNodeKind.INDEX_EXPRESSION: {
      resolved = checkIndex(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.FIELD_ACCESS: {
      resolved = checkFieldAccess(ref prog, ref tm, ref ast, expr, expected, ref scope);
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      // A comparison's operands constrain each other but NOT the result, so an
      // untyped literal in `n < 10` pins to `n`, never to the bool the whole
      // expression produces.
      const compares = isComparison(expr.operator);
      const logical = isLogical(expr.operator);
      let operandExpected = expected;
      if (compares) {
        operandExpected = TYPE_ERROR_ID;
      } else if (logical) {
        // `&&` / `||` take bools and produce one.
        operandExpected = primTypeId(PrimKind.BOOL);
      }
      let left = checkExpr(ref prog, ref tm, ref ast, expr.childA, operandExpected, ref scope);
      const right = checkExpr(ref prog, ref tm, ref ast, expr.childB, left, ref scope);

      // An untyped int literal takes the OTHER operand's type. The right side
      // gets that for free - it is checked WITH `left` as its expectation - but
      // a LEADING literal has already defaulted to int32 by the time the right
      // side is known. So re-check it, which also re-decorates the node.
      //
      // `48 + (rest % 10)` with a uint64 `rest` is the case: without this the
      // 48 is an int32 and the addition is refused for a difference the writer
      // never wrote.
      if (left != right &&
          isIntLiteralNode(ref ast, expr.childA) &&
          isIntPrimType(ref prog, right)) {
        left = checkExpr(ref prog, ref tm, ref ast, expr.childA, right, ref scope);
      }

      // The same re-pin for a LEADING float literal. `1.5 * scale` with a
      // float32 `scale` is the case: without this the 1.5 has already defaulted
      // to float64 and the two widths refuse to mix.
      if (left != right &&
          isFloatLiteralNode(ref ast, expr.childA) &&
          isFloatPrimType(ref prog, right)) {
        left = checkExpr(ref prog, ref tm, ref ast, expr.childA, right, ref scope);
      }

      if (left != right) {
        reportError(
          ref prog,
          `operator "${tagSpelling(expr.operator)}" cannot be applied to ${formatType(ref prog, left)} and ${formatType(ref prog, right)}`,
          expr.sourceLoc
        );
      } else if (isFloatPrimType(ref prog, left) &&
                 !checkFloatOperator(ref prog, expr)) {
        // A float keeps arithmetic and comparison and loses the bitwise family.
        // checkFloatOperator reported it.
      } else if (isValueEnumType(ref prog, left) &&
                 !checkEnumOperator(ref prog, expr, left)) {
        // An enum keeps equality and, when it is integer-backed, ordering and
        // the bitwise family. It loses arithmetic: two enums added produce
        // something that names no case. checkEnumOperator reported it.
      } else if (compares) {
        resolved = primTypeId(PrimKind.BOOL);
      } else if (logical) {
        if (left != primTypeId(PrimKind.BOOL)) {
          reportError(ref prog, "logical operands must be bool", expr.sourceLoc);
        } else {
          resolved = primTypeId(PrimKind.BOOL);
        }
      } else {
        resolved = left;
      }
    }
    case ASTNodeKind.CALL_EXPRESSION: {
      resolved = checkCall(ref prog, ref tm, ref ast, expr, exprId, expected, ref scope);
    }
    case ASTNodeKind.REF_EXPRESSION: {
      resolved = checkRefExpr(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.VARIANT_CONSTRUCTOR: {
      resolved = checkVariantConstructor(
        ref prog, ref tm, ref ast, expr, expr.childB, expr.childA, expected, ref scope
      );
    }
    case ASTNodeKind.ASSIGNMENT: {
      resolved = checkAssignment(ref prog, ref tm, ref ast, expr, ref scope);
    }
    case ASTNodeKind.TRY_OP: {
      resolved = checkTryOp(ref prog, ref tm, ref ast, exprId, ref scope);
    }
    case ASTNodeKind.IDENT: {
      switch (scopeBinding(ref scope, expr.name)) {
        case Option.Some { value: b }: {
          resolved = reborrowIfWanted(ref prog, ref tm, b, exprId, expected);
        }
        case Option.None: {
          // Not a local, so it may be a module-level `const`. Locals win, which
          // is the same precedence every other language gives them.
          resolved = moduleConstType(ref prog, ref tm, expr.name);
          if (resolved == TYPE_ERROR_ID) {
            // Or a FUNCTION named without being called: `{ hash: stringHash }`
            // puts one in a function-typed field. Its type is its signature -
            // a yoop function value IS its address, so there is nothing to
            // convert and nothing to wrap.
            resolved = moduleFuncType(ref prog, ref tm, expr.name);
          }
          if (resolved == TYPE_ERROR_ID) {
            reportError(ref prog, `unknown name "${expr.name}"`, expr.sourceLoc);
          }
        }
      }
    }
    default: {
      reportError(ref prog, `pass D does not handle ${kindName(expr.kind)} yet`, expr.sourceLoc);
    }
  }

  resolved = openBorrowIfWanted(ref prog, ref tm, expr, exprId, expected, resolved);
  vec.vecSet(ref tm.resolvedTypes, exprId, resolved);
  return resolved;
}

// A `ref T` value in a position that wants a plain `T` is OPENED: the borrow
// derefs and the node's type becomes `T`.
//
// This is the same rule `bindParams` applies to a `ref` parameter, moved one
// layer out so it covers a borrow that arrived any other way - out of a `ref T`
// struct field, or through a local bound to one. A borrow IS the thing it
// borrows at every use except one: handing it on AS a borrow, which is what a
// `ref T` expectation means and is why this is keyed on `expected`.
//
// It is recorded rather than just returned, because codegen has to emit the
// load and cannot re-derive the question - by then the node's type says `T` and
// the operand is still a pointer.
function openBorrowIfWanted(
  ref prog: Program,
  ref tm: TypedModule,
  expr: ASTNode,
  exprId: NodeId,
  expected: TypeId,
  resolved: TypeId
): TypeId {
  // No expectation is no conversion. A vararg past the fixed parameters and a
  // field/index base both land here, and both keep the borrow.
  if (expected == TYPE_ERROR_ID || resolved == TYPE_ERROR_ID || expected == resolved) {
    return resolved;
  }
  // `ref x` WRITTEN OUT never opens. The whole reason writing it is required is
  // that the reader can see at the call which arguments the callee may write
  // through, and silently undoing it would make `f(ref n)` and `f(n)` the same
  // call. The reference draws the line in the same place, established by
  // probing: it accepts a borrow that ARRIVED as a value in a by-value slot and
  // refuses `takes(ref n)` against `takes(n: int32)`.
  if (expr.kind == ASTNodeKind.REF_EXPRESSION) {
    return resolved;
  }
  const inner = derefType(ref prog, resolved);
  if (inner == resolved) {
    return resolved;
  }
  if (!typeAccepts(ref prog, expected, inner)) {
    return resolved;
  }
  map.mapInsert(ref tm.derefUses, uint64(exprId), true);
  return inner;
}

// The MIRROR of `openBorrowIfWanted`: a name that is already a borrow, in a
// position that wants a borrow, is FORWARDED rather than opened.
//
// `bindParams` unwraps a `ref T` parameter to `T` so the body never has to know
// about references, and that is right for every use but one -
// `lexNext(ref tables, src, pos)`, where `src` is itself a `ref uint8[]`
// parameter going straight into another `ref uint8[]` slot. Writing `ref src`
// would ask for `ref ref T`, which is not a thing; writing nothing is what the
// reference accepts (probed: `inner(v)`, `inner(ref v)` and `byVal(v)` all
// compile on a `ref` parameter).
//
// The rule is narrow ON PURPOSE, and the narrowness is the whole point: it
// applies only to a name that ARRIVED as a borrow, so no new aliasing is
// created that the caller's own signature did not already declare. A plain
// local still has to write `ref` at the call - the reference refuses `inner(x)`
// there with "parameter \"v\" expects a ref argument", and so does this.
//
// Recorded rather than just returned, for the same reason derefUses is: by the
// time codegen sees the node its type says `ref T` while the slot still holds a
// plain parameter, and only pass D knows the position asked for the pointer.
function reborrowIfWanted(
  ref prog: Program,
  ref tm: TypedModule,
  b: Binding,
  exprId: NodeId,
  expected: TypeId
): TypeId {
  if (!b.refParam || expected == TYPE_ERROR_ID || expected == b.typeId) {
    return b.typeId;
  }
  if (derefType(ref prog, expected) != b.typeId) {
    return b.typeId;
  }
  map.mapInsert(ref tm.reborrowUses, uint64(exprId), true);
  return expected;
}

function checkCall(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  // `ns.fn(...)`. The parser could not tell a namespace from a value, so the
  // fork is here, before the cast and printf carve-outs - neither of which a
  // qualified name can mean.
  if (expr.childB != 0) {
    return checkQualifiedCall(ref prog, ref tm, ref ast, expr, exprId, expected, ref scope);
  }

  // `runSuite()` where `runSuite` is a LOCAL holding a function value. A local
  // shadows a module function of the same name, so this is checked first - and
  // it is the same indirect call a function-typed FIELD produces, just reached
  // through a name.
  switch (scopeLookup(ref scope, expr.name)) {
    case Option.Some { value: localType }: {
      switch (typeAt(ref prog, localType)) {
        case Type.Func { params: p, ret: r, variadic: v }: {
          map.mapInsert(ref tm.indirectCalls, uint64(exprId), true);
          checkArgsAgainstFunc(ref prog, ref tm, ref ast, expr, localType, expr.name, ref scope);
          return r;
        }
        default: { }
      }
    }
    case Option.None: { }
  }

  // A cast is handled before the arguments, because its single operand wants to
  // be checked AGAINST the target type (so `int64(1)` pins the literal) rather
  // than with no expectation like a call argument.
  const earlyCast = primTypeIdOfName(expr.name);
  if (earlyCast != TYPE_ERROR_ID) {
    return checkCast(ref prog, ref tm, ref ast, expr, earlyCast, ref scope);
  }

  const symId = lookupOwnName(ref tm, expr.name);
  if (symId == SYMBOL_NONE_ID) {
    // printf stays magic when NOTHING declared it, exactly as it is in the JS
    // reference: it is variadic C and almost every program uses it, so a call
    // with no signature in sight still works. A module that writes its own
    // `extern "C" { function printf(fmt: string, ...): int32; }` - which 158
    // files in this tree do - resolves above and gets its arguments checked
    // against that declaration instead. Probing the reference is what settled
    // the precedence: declaring a NON-variadic printf there makes
    // `printf("a %d\n", 3)` an arity error, so the declaration wins.
    if (isPrintfName(expr.name)) {
      checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
      return primTypeId(PrimKind.INT32);
    }
    // Still check the arguments, so a mistake inside one is reported alongside
    // the unknown name rather than hidden behind it.
    checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
    reportError(ref prog, `unknown function "${expr.name}"`, expr.sourceLoc);
    return TYPE_ERROR_ID;
  }
  return checkAgainstSignature(ref prog, ref tm, ref ast, expr, exprId, symId, expr.name, expected, ref scope);
}

// Arguments checked with NO expectation. Only for a callee with no signature to
// check against: printf, and a name that did not resolve.
function checkCallArgs(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): void {
  if (expr.childA == 0) {
    return;
  }
  const args = nodeAt(ref ast, expr.childA);
  let a: usize = 0;
  while (a < args.childCount) {
    checkExpr(ref prog, ref tm, ref ast, childAt(ref ast, args, a), TYPE_ERROR_ID, ref scope);
    a += 1;
  }
}

// Infer a generic callee's type arguments, monomorphize it, and record which
// instance this call site landed on. Returns the SUBSTITUTED Func type.
//
// Two sources of information, in this order:
//
//   the ARGUMENTS   `identity(3)` matches the declared `T` against int32
//   the EXPECTED    `let v: Box<int> = boxOf(3)` matches `Box<T>` against
//                   `Box<int>`, which is the only signal when nothing but the
//                   RETURN type mentions T
//
// Arguments go first because they are what the reader is looking at. The
// expected type fills in whatever they left unknown.
function instantiateCallee(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  declId: DeclId,
  calleeName: string,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  let info = genericAt(ref prog, declId);

  // One slot per parameter, TYPE_ERROR_ID meaning "still unknown".
  disposable bound: Vec<TypeId> = vec.vecNew(info.params.len);
  let b: usize = 0;
  while (b < info.params.len) {
    vec.vecPush(ref bound, TYPE_ERROR_ID);
    b += 1;
  }

  // The arguments are checked with NO expectation here, because the parameter
  // types are exactly what is not known yet. checkAgainstSignature re-checks
  // them against the substituted signature once it is built, which is where an
  // untyped literal finally pins.
  switch (typeAt(ref prog, info.template)) {
    case Type.Func { params: p, ret: r, variadic: v }: {
      if (expr.childA != 0) {
        const args = nodeAt(ref ast, expr.childA);
        let a: usize = 0;
        while (a < args.childCount && a < p.len) {
          const argId = childAt(ref ast, args, a);
          // A STRUCT LITERAL is skipped here rather than checked. It has no type
          // of its own - which struct it is comes from context - so with no
          // expectation to give it, checking it can only report "cannot tell
          // which struct this literal is" about a call that is perfectly well
          // formed. It contributes nothing to inference either, so nothing is
          // lost: `vec.vecPush(ref out, { str: "(", tag: ... })` infers T from
          // the vector and the re-check in checkArgsAgainstFunc pins the
          // literal to it. If NOTHING else pins the parameter, the "cannot
          // infer T" message below is the right one and this is what lets it be
          // reached.
          if (nodeAt(ref ast, argId).kind == ASTNodeKind.STRUCT_LITERAL) {
            a += 1;
            continue;
          }
          const got = checkExpr(ref prog, ref tm, ref ast, argId, TYPE_ERROR_ID, ref scope);
          inferTypeArgs(ref prog, vec.vecGet(ref p, a), got, ref info.params, ref bound);
          a += 1;
        }
      }
      inferTypeArgs(ref prog, r, expected, ref info.params, ref bound);
    }
    default: { return TYPE_ERROR_ID; }
  }

  // A parameter nothing mentioned is not an error the CALL can fix by trying
  // harder - it needs an annotation somewhere, and saying which one is missing
  // is the whole message.
  let u: usize = 0;
  while (u < bound.len) {
    if (vec.vecGet(ref bound, u) == TYPE_ERROR_ID) {
      reportError(
        ref prog,
        `cannot infer "${typeParamNameAt(ref prog, ref info.params, u)}" for "${calleeName}" - annotate the binding it goes to`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    u += 1;
  }

  // The bounds are the promise the DECL made; this is where an argument keeps
  // it. Checked before the instance is registered, so a refused call leaves no
  // monomorphization behind for codegen to emit against a type that cannot
  // supply the methods its body calls.
  if (!checkBoundsSatisfied(ref prog, ref info.params, ref bound,
                            `call to "${calleeName}"`, expr.sourceLoc)) {
    return TYPE_ERROR_ID;
  }

  const instance = instantiateFunction(ref prog, declId, ref bound);
  map.mapInsert(ref tm.calleeInstance, uint64(exprId), instance);
  return funcInstanceAt(ref prog, instance).funcType;
}

// The NAME of the i'th type parameter, for the message above.
function typeParamNameAt(ref prog: Program, ref params: Vec<TypeId>, i: usize): string {
  if (i >= params.len) {
    return "?";
  }
  switch (typeAt(ref prog, vec.vecGet(ref params, i))) {
    case Type.TypeParam { name: n, originDecl: o, bounds: bs }: { return n; }
    default: { return "?"; }
  }
}

// A call checked against the callee's declared parameters: the right NUMBER of
// arguments, each of the right type. Returns the callee's return type.
//
// Each argument is checked AGAINST its parameter, which is what pins an untyped
// literal to it - `takesLong(1)` gives the 1 an int64 rather than defaulting it
// to int32 and then complaining they differ.
function checkAgainstSignature(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  symId: SymbolId,
  calleeName: string,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  let funcType: TypeId = TYPE_ERROR_ID;
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Func { typeId: t }: { funcType = t; }
    case Symbol.GenericDecl { decl: d, sort: s }: {
      if (s != GenericSort.FUNC) {
        checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
        reportError(ref prog, `"${calleeName}" is a type, not a function`, expr.sourceLoc);
        return TYPE_ERROR_ID;
      }
      // Nothing wrote the type arguments down, so they are INFERRED from the
      // arguments and the expected type, and the call is monomorphized against
      // whatever comes out.
      funcType = instantiateCallee(
        ref prog, ref tm, ref ast, expr, exprId, d, calleeName, expected, ref scope
      );
      if (funcType == TYPE_ERROR_ID) {
        return TYPE_ERROR_ID;   // instantiateCallee reported why
      }
    }
    default: {
      checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
      reportError(ref prog, `"${calleeName}" is not callable`, expr.sourceLoc);
      return TYPE_ERROR_ID;
    }
  }

  return checkArgsAgainstFunc(ref prog, ref tm, ref ast, expr, funcType, calleeName, ref scope);
}

// The arity and type check, against a Func type that is already resolved.
// Shared by an ordinary call and a trait-method call, which differ only in how
// they FIND the Func.
function checkArgsAgainstFunc(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  funcType: TypeId,
  calleeName: string,
  ref scope: LocalScope
): TypeId {
  let params: Vec<TypeId> = vec.vecNew(0);
  let ret: TypeId = TYPE_ERROR_ID;
  let variadic = false;
  switch (typeAt(ref prog, funcType)) {
    case Type.Func { params: p, ret: r, variadic: v }: {
      params = p;
      ret = r;
      variadic = v;
    }
    default: {
      checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
      return TYPE_ERROR_ID;
    }
  }

  let given: usize = 0;
  if (expr.childA != 0) {
    const args = nodeAt(ref ast, expr.childA);
    given = args.childCount;
    let a: usize = 0;
    while (a < args.childCount) {
      const argId = childAt(ref ast, args, a);
      // Past the declared parameters there is nothing to check against; the
      // arity error below says so once, rather than once per extra argument.
      let want: TypeId = TYPE_ERROR_ID;
      if (a < params.len) {
        want = vec.vecGet(ref params, a);
      }
      const got = checkExpr(ref prog, ref tm, ref ast, argId, want, ref scope);
      if (want != TYPE_ERROR_ID && got != TYPE_ERROR_ID && !typeAccepts(ref prog, want, got)) {
        reportError(
          ref prog,
          `argument ${a + 1} of "${calleeName}" is ${formatType(ref prog, want)}, not ${formatType(ref prog, got)}`,
          nodeAt(ref ast, argId).sourceLoc
        );
      }
      a += 1;
    }
  }

  // A variadic callee takes AT LEAST its declared parameters, and the extras
  // are unchecked - there is no parameter for them to be checked against. The
  // FIXED ones are checked exactly as any other call's are, which is the half
  // the JS reference gets wrong: it lets `myvar()` through typecheck and emits
  // a call with no format argument, which clang then rejects as "not enough
  // parameters specified for call". Refusing it here points at the call site.
  const wrongCount = given < params.len || (given > params.len && !variadic);
  if (wrongCount) {
    if (variadic) {
      reportError(
        ref prog,
        `"${calleeName}" takes at least ${params.len} argument(s), got ${given}`,
        expr.sourceLoc
      );
    } else {
      reportError(
        ref prog,
        `"${calleeName}" takes ${params.len} argument(s), got ${given}`,
        expr.sourceLoc
      );
    }
  }
  return ret;
}

// `ns.fn(...)` - a call reached through an `import * as ns`.
//
// The lookup goes to the source module's EXPORTS rather than its names, which
// is what keeps a namespace from being a way around `export`: `ns.hidden()`
// fails for the same reason `import { hidden }` does.
function checkQualifiedCall(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  const base = nodeAt(ref ast, expr.childB);

  // `errno.get()` / `errno.set(v)` / `errno.message(c)` - the libc errno
  // bridge, through the yoop runtime. An ambient namespace resolved by
  // SPELLING rather than by import, the same way the reference's
  // ERRNO_INTRINSIC is: there is nothing to import it from.
  if (base.kind == ASTNodeKind.IDENT && str.stringEq(base.name, ERRNO_NAMESPACE)) {
    return checkErrnoCall(ref prog, ref tm, ref ast, expr, ref scope);
  }

  // `m.ops.hash(key)` - an INDIRECT call through a function-typed field. The
  // base is a value rather than a name, and the thing being called is the
  // field's contents, so this is checked before anything looks for a module.
  //
  // Tried first because a base that resolves to a struct cannot be a namespace:
  // a namespace only ever lives at module level, and a local always shadows.
  const throughField = fieldFuncTypeOf(ref prog, ref tm, ref ast, expr, base, ref scope);
  if (throughField != TYPE_ERROR_ID) {
    return checkIndirectCall(ref prog, ref tm, ref ast, expr, exprId, throughField, expected, ref scope);
  }

  if (base.kind != ASTNodeKind.IDENT) {
    checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
    reportError(
      ref prog,
      "only an imported namespace may qualify a call so far - methods are not supported by the bootstrap typechecker yet",
      base.sourceLoc
    );
    return TYPE_ERROR_ID;
  }

  // `Display.toString(ref p)` - the base is a TRAIT, not a namespace, and the
  // method is found on the RECEIVER's concrete type rather than in a module.
  const traitType = traitTypeNamed(ref prog, ref tm, base.name);
  if (traitType != TYPE_ERROR_ID) {
    return checkTraitCall(ref prog, ref tm, ref ast, expr, exprId, base, traitType, ref scope);
  }

  let sourceIndex: ModuleId = 0;
  switch (namespaceModuleOf(ref prog, ref tm, base, ref scope)) {
    case Option.Some { value: mi }: { sourceIndex = mi; }
    case Option.None: {
      checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
      return TYPE_ERROR_ID;   // namespaceModuleOf reported why
    }
  }
  let source = vec.vecGet(ref prog.modules, sourceIndex);

  switch (map.mapGet(ref source.exports, expr.name)) {
    case Option.Some { value: symId }: {
      // The signature is the SOURCE module's, but the arguments are checked in
      // THIS module's scope - the types on both sides are program-wide TypeIds,
      // so nothing has to be translated between them.
      return checkAgainstSignature(ref prog, ref tm, ref ast, expr, exprId, symId, expr.name, expected, ref scope);
    }
    case Option.None: {
      checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
      if (lookupOwnName(ref source, expr.name) != SYMBOL_NONE_ID) {
        reportError(
          ref prog,
          `"${expr.name}" is declared in module ${source.moduleId} but not exported - add \`export\` to its declaration`,
          expr.sourceLoc
        );
      } else {
        reportError(
          ref prog,
          `"${base.name}" has no export "${expr.name}"`,
          expr.sourceLoc
        );
      }
      return TYPE_ERROR_ID;
    }
  }
}

// The module an IDENT names as a namespace. `None` with the reason already
// reported - an Option rather than a sentinel, because ModuleId 0 is the first
// module loaded and so is never spare.
function namespaceModuleOf(
  ref prog: Program,
  ref tm: TypedModule,
  base: ASTNode,
  ref scope: LocalScope
): Option<ModuleId> {
  // A LOCAL first, because `p.x()` on a struct value reaches this path too -
  // the parser cannot tell it from `ns.fn()`. Without this it would be reported
  // as an unknown name, since a namespace only ever lives at module level, and
  // the reader would go hunting for a typo in a name that is right there.
  switch (scopeLookup(ref scope, base.name)) {
    case Option.Some { value: localType }: {
      reportError(
        ref prog,
        `"${base.name}" is a local of type ${formatType(ref prog, localType)}, not an imported namespace - calling a method on a value is not supported by the bootstrap typechecker yet`,
        base.sourceLoc
      );
      return Option.None;
    }
    case Option.None: { }
  }

  const symId = lookupOwnName(ref tm, base.name);
  if (symId == SYMBOL_NONE_ID) {
    reportError(ref prog, `unknown name "${base.name}"`, base.sourceLoc);
    return Option.None;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Namespace { module: mi }: { return Option.Some { value: mi }; }
    // `PredVT.fromFn(f)` - the OTHER half of building a vtable value, and the
    // sibling of the `X.from(ref v)` the parser refuses by name. It reaches
    // here rather than the parser because `fromFn` is an ordinary IDENT, and
    // "is not an imported namespace" would be a true statement about the wrong
    // thing: the base is a vtable and the reader wants to know that BUILDING
    // one is what is missing.
    case Symbol.Vtable { typeId: vtId }: {
      reportError(
        ref prog,
        `"${base.name}" is a vtable, and building a vtable VALUE (\`${base.name}.from(ref v)\`, \`${base.name}.fromFn(...)\`) is not supported by the bootstrap yet - declaring and laying one out is`,
        base.sourceLoc
      );
      return Option.None;
    }
    default: {
      reportError(
        ref prog,
        `"${base.name}" is not an imported namespace, so it has no members to call`,
        base.sourceLoc
      );
      return Option.None;
    }
  }
}

// The type of a module-level `const` by name, or TYPE_ERROR_ID when the name is
// not one. Silent: the caller has the location and the better message.
function moduleConstType(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  const symId = lookupOwnName(ref tm, name);
  if (symId == SYMBOL_NONE_ID) {
    return TYPE_ERROR_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Value { typeId: t, intVal: v }: { return t; }
    // A mutable global reads the same way; what differs is that it can be
    // WRITTEN, which checkAssignment asks about separately.
    case Symbol.Global { typeId: t, intVal: v }: { return t; }
    default: { return TYPE_ERROR_ID; }
  }
}

// The type of a module-level name that may be ASSIGNED to - a `let` global and
// nothing else. TYPE_ERROR_ID for a const, which is what makes writing one an
// error rather than a silent no-op.
function moduleGlobalType(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  const symId = lookupOwnName(ref tm, name);
  if (symId == SYMBOL_NONE_ID) {
    return TYPE_ERROR_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Global { typeId: t, intVal: v }: { return t; }
    default: { return TYPE_ERROR_ID; }
  }
}

// `ref x` - a borrow of a NAMED binding.
//
// Restricted to a plain name on purpose: a borrow needs an address, and a local
// is the only thing the bootstrap has one for. `ref f()` would have to
// materialize a temporary and hand out a pointer to it, which outlives nothing
// useful and is a different feature.
function checkRefExpr(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  const target = nodeAt(ref ast, expr.childA);
  // A named binding, a FIELD of one, or an array ELEMENT.
  // `Disposable.dispose(ref self.data)` is how a container disposes what it
  // owns, and `Comparable.compare(ref xs[i], p)` is how a sort orders one.
  // All three have storage; a temporary does not, which is the whole rule.
  if (target.kind != ASTNodeKind.IDENT &&
      target.kind != ASTNodeKind.FIELD_ACCESS &&
      target.kind != ASTNodeKind.INDEX_EXPRESSION) {
    reportError(
      ref prog,
      "`ref` takes a named binding, a field of one, or an array element - there is no address for a temporary",
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  if (target.kind == ASTNodeKind.FIELD_ACCESS &&
      !fieldPathBottomsOutInAName(ref ast, expr.childA)) {
    reportError(
      ref prog,
      "`ref` on a field needs a path that bottoms out in a named binding - `ref f().x` and `ref xs[i].y` have no address the field walk can start from",
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  const inner = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  if (inner == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  return internRef(ref prog, inner);
}

// Walk a field path down to whatever it started from. `ref a.b.c` is fine at
// any depth - codegen's `emitFieldAddress` already recurses through a nested
// base, so the address is a gep on a gep and there is nothing new to build.
//
// What is refused is a path whose BOTTOM has no storage: `ref f().x` (a
// temporary has no address at all) and `ref xs[i].y` (an element address is a
// different gep, and the field walk does not build one). Both are named rather
// than left to fail in codegen, where the message would be about a slot lookup.
function fieldPathBottomsOutInAName(ref ast: AST, targetId: NodeId): bool {
  let atId = targetId;
  let node = nodeAt(ref ast, atId);
  while (node.kind == ASTNodeKind.FIELD_ACCESS) {
    atId = node.childA;
    node = nodeAt(ref ast, atId);
  }
  return node.kind == ASTNodeKind.IDENT;
}

// `Trait.method(ref receiver, ...)` - resolved STATICALLY by the receiver.
//
// The trait's own signature is only used to check the method EXISTS on it. What
// the call actually reaches is the receiver's own method, because that is the
// one with a body; two types implementing one trait are two symbols, and which
// of them this call means is decided here rather than at run time.
function checkTraitCall(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  base: ASTNode,
  traitType: TypeId,
  ref scope: LocalScope
): TypeId {
  if (lookupMethod(ref prog, traitType, expr.name) == TYPE_ERROR_ID) {
    checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
    reportError(
      ref prog,
      `trait "${base.name}" has no method "${expr.name}"`,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }

  // The RECEIVER is the first argument, and it is what picks the impl - so it
  // is checked before the rest, with no expectation, and its type read back.
  if (expr.childA == 0 || nodeAt(ref ast, expr.childA).childCount == 0) {
    reportError(
      ref prog,
      `"${base.name}.${expr.name}" needs a receiver - write \`${base.name}.${expr.name}(ref x, ...)\``,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  const args = nodeAt(ref ast, expr.childA);
  const receiverId = childAt(ref ast, args, 0);
  const receiverType = receiverTypeOf(ref prog,
    checkExpr(ref prog, ref tm, ref ast, receiverId, TYPE_ERROR_ID, ref scope));

  // An OPAQUE receiver - a type parameter inside a generic body. It has no
  // methods of its own and never will; what it has is BOUNDS, and a bound is
  // the promise that every type substituted for it does implement this. So the
  // signature comes from the bound, the call is checked against it once here,
  // and codegen picks the real symbol per instantiation.
  if (isTypeParam(ref prog, receiverType)) {
    const bound = boundMethodOn(ref prog, receiverType, traitType, expr.name);
    if (bound == TYPE_ERROR_ID) {
      reportError(
        ref prog,
        `type parameter "${typeParamNameOf(ref prog, receiverType)}" is not bound to trait "${base.name}" - add \`implements ${base.name}\` to its declaration`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    map.mapInsert(ref tm.calleeReceiver, uint64(exprId), receiverType);
    return checkArgsAgainstFunc(ref prog, ref tm, ref ast, expr, bound, expr.name, ref scope);
  }

  const method = lookupMethod(ref prog, receiverType, expr.name);
  if (method == TYPE_ERROR_ID) {
    reportError(
      ref prog,
      `${formatType(ref prog, receiverType)} does not implement "${base.name}.${expr.name}"`,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }

  // Which impl this call landed on, for codegen. The receiver's TYPE is the
  // answer, and the symbol name follows from it plus the method name.
  map.mapInsert(ref tm.calleeReceiver, uint64(exprId), receiverType);

  return checkArgsAgainstFunc(ref prog, ref tm, ref ast, expr, method, expr.name, ref scope);
}

// `printf` is a compiler builtin on both sides rather than an extern anyone has
// to declare - see the same carve-out in src/jsyooptypecheck/typecheck.js.
function isPrintfName(name: string): bool {
  return str.stringEq(name, "printf");
}

// `let x: T = expr;` / `const x = expr;`
//
// The annotation, when present, is what an untyped literal initializer pins to.
// Without one the initializer's own type is taken, which is how `const n = 42;`
// lands on int32.
function checkVarDecl(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  stmtId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  // `disposable reg: T = expr { ... }` - the binding OWNS a block, and the
  // block is its whole scope. So the name goes into a scope of its own rather
  // than into the enclosing one, and it is gone at the closing brace along with
  // whatever the kind asks for at scope end. Reading it afterwards is
  // `undefined variable` on both sides.
  //
  // Pushed BEFORE the initializer is checked, which costs nothing (the
  // initializer cannot see the name it is initializing) and means every exit
  // path below pops exactly once.
  const hasRegion = stmt.childD != 0;
  if (hasRegion) {
    scopePush(ref scope);
  }
  checkVarDeclInner(ref prog, ref tm, ref ast, stmt, stmtId, ref scope);
  if (hasRegion) {
    checkBlock(ref prog, ref tm, ref ast, stmt.childD, retType, ref scope);
    scopePop(ref scope);
  }
}

function checkVarDeclInner(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  stmtId: NodeId,
  ref scope: LocalScope
): void {
  let declared: TypeId = TYPE_ERROR_ID;
  if (stmt.childA != 0) {
    declared = resolveTypeAnnotation(ref prog, ref tm, ref ast, stmt.childA);
  }

  if (stmt.childB == 0) {
    // `let x: T;` with no initializer. Legal only with an annotation - there is
    // nothing to infer from otherwise.
    if (declared == TYPE_ERROR_ID) {
      reportError(ref prog, `"${stmt.name}" needs either a type annotation or an initializer`, stmt.sourceLoc);
    }
    bindLocal(ref prog, ref scope, stmt, declared);
    vec.vecSet(ref tm.resolvedTypes, stmtId, declared);
    return;
  }

  const initType = checkExpr(ref prog, ref tm, ref ast, stmt.childB, declared, ref scope);
  let finalType = initType;
  if (declared != TYPE_ERROR_ID) {
    finalType = declared;
    if (initType != TYPE_ERROR_ID && !typeAccepts(ref prog, declared, initType)) {
      reportError(ref prog, `initializer does not match the declared type of "${stmt.name}"`, stmt.sourceLoc);
    }
  }

  checkDisposableBinding(ref prog, ref tm, ref ast, stmt, finalType);
  bindLocal(ref prog, ref scope, stmt, finalType);
  vec.vecSet(ref tm.resolvedTypes, stmtId, finalType);
}

// A binding whose kind demands a scope-end call has to HAVE that method.
//
// Checked here rather than left to codegen because the promise is about the
// program: `disposable buf: Foo` where Foo has no `dispose` is a mistake in the
// source, and codegen meeting it would be a mistake in the compiler.
function checkDisposableBinding(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  typeId: TypeId
): void {
  if (stmt.childC == 0 || typeId == TYPE_ERROR_ID) {
    return;
  }
  const list = nodeAt(ref ast, stmt.childC);
  let i: usize = 0;
  while (i < list.childCount) {
    const prefix = nodeAt(ref ast, childAt(ref ast, list, i));
    switch (lookupKind(ref prog, prefix.name)) {
      case Option.Some { value: info }: {
        if (info.disposeMethod.len > 0 &&
            lookupMethod(ref prog, typeId, info.disposeMethod) == TYPE_ERROR_ID) {
          // No method of its own is not automatically a mistake: a type that
          // declares `propagates<disposable>` says the obligation belongs to
          // its FIELDS, and the scope-end call becomes one per field that
          // supplies the kind. See typecheck/propagate.yoop.
          if (propagatesMustCall(ref prog, typeId, info.disposeMethod)) {
            const problem = propagatedDisposeProblem(ref prog, typeId, info.disposeMethod);
            if (problem.len > 0) {
              reportError(
                ref prog,
                `"${stmt.name}" is ${prefix.name} and ${formatType(ref prog, typeId)} propagates it, but ${problem}`,
                stmt.sourceLoc
              );
            }
          } else {
            reportError(
              ref prog,
              `"${stmt.name}" is ${prefix.name}, which requires a "${info.disposeMethod}" method, but ${formatType(ref prog, typeId)} has none`,
              stmt.sourceLoc
            );
          }
        }
      }
      case Option.None: {
        reportError(
          ref prog,
          `unknown kind "${prefix.name}" on binding "${stmt.name}"`,
          prefix.sourceLoc
        );
      }
    }
    i += 1;
  }
}

function bindLocal(ref prog: Program, ref scope: LocalScope, stmt: ASTNode, typeId: TypeId): void {
  const mutable = stmt.kind == ASTNodeKind.LET_DECL;
  if (!scopeDeclare(ref scope, stmt.name, typeId, mutable)) {
    reportError(ref prog, `"${stmt.name}" is already declared in this function`, stmt.sourceLoc);
  }
}

// A condition has to be a bool. Reporting here rather than in codegen keeps the
// "codegen is total on well-formed input" contract honest.
function checkCondition(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  exprId: NodeId,
  ref scope: LocalScope
): void {
  const got = checkExpr(ref prog, ref tm, ref ast, exprId, primTypeId(PrimKind.BOOL), ref scope);
  if (got != TYPE_ERROR_ID && got != primTypeId(PrimKind.BOOL)) {
    reportError(ref prog, "condition must be a bool", nodeAt(ref ast, exprId).sourceLoc);
  }
}

// Operators whose RESULT is a bool regardless of what they compare.
function isComparison(tag: TokenTags): bool {
  switch (tag) {
    case TokenTags.EQEQ, TokenTags.NEQ, TokenTags.LT,
         TokenTags.GT, TokenTags.LTE, TokenTags.GTE: {
      return true;
    }
    default: { return false; }
  }
}

// Whether a field write's base has an ADDRESS to compute: a name, or a path of
// fields reaching one. `a.b.c = v` walks down to `a`; `f().x = v` does not,
// because a call's result lives in a temp with nowhere to store back to.
//
// A field READ needs none of this - it is an extractvalue on a loaded value, so
// it works on any struct expression. The asymmetry is the same one a struct
// field write already had, just applied one level at a time.
function isAddressableFieldBase(ref ast: AST, id: NodeId): bool {
  const node = nodeAt(ref ast, id);
  if (node.kind == ASTNodeKind.IDENT) {
    return true;
  }
  if (node.kind == ASTNodeKind.FIELD_ACCESS) {
    return isAddressableFieldBase(ref ast, node.childA);
  }
  return false;
}

// `target = value`. A name, a field of an addressable base, a deref and an
// index are assignable; anything else is refused by name.
function checkAssignment(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  const target = nodeAt(ref ast, expr.childA);
  let targetType: TypeId = TYPE_ERROR_ID;

  if (target.kind == ASTNodeKind.IDENT) {
    switch (scopeBinding(ref scope, target.name)) {
      case Option.Some { value: bound }: {
        targetType = bound.typeId;
        // The compound forms desugar to this same node in the parser, so
        // `a += 1` is covered here too and needs no second check.
        if (!bound.mutable) {
          reportError(ref prog, `cannot assign to const "${target.name}"`, target.sourceLoc);
          return TYPE_ERROR_ID;
        }
      }
      case Option.None: {
        // Not a local, so it may be a module-level `let`. A `const` reaches
        // here too and is refused by name: it has no storage to write to.
        targetType = moduleGlobalType(ref prog, ref tm, target.name);
        if (targetType == TYPE_ERROR_ID) {
          if (moduleConstType(ref prog, ref tm, target.name) != TYPE_ERROR_ID) {
            reportError(
              ref prog,
              `cannot assign to const "${target.name}" - a module-level const is inlined at every use, so there is nothing to write to`,
              target.sourceLoc
            );
          } else {
            reportError(ref prog, `unknown name "${target.name}"`, target.sourceLoc);
          }
          return TYPE_ERROR_ID;
        }
      }
    }
    vec.vecSet(ref tm.resolvedTypes, expr.childA, targetType);
  } else if (target.kind == ASTNodeKind.FIELD_ACCESS) {
    // `p.x = v`, and `a.b.c = v`. checkFieldAccess records the field's type,
    // which the store needs; the base has to have an ADDRESS, which means a
    // name or a path of fields reaching one. A call's result has no address to
    // store into, so `f().x = v` is still refused.
    if (!isAddressableFieldBase(ref ast, target.childA)) {
      reportError(
        ref prog,
        "only a field of a named binding, or of a field path reaching one, can be assigned to",
        target.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    targetType = checkFieldAccess(ref prog, ref tm, ref ast, target, TYPE_ERROR_ID, ref scope);
    vec.vecSet(ref tm.resolvedTypes, expr.childA, targetType);
  } else if (target.kind == ASTNodeKind.DEREF_EXPRESSION) {
    // `*p = v` - a store THROUGH a pointer. The target's type is the pointee,
    // which is the same thing a read of it produces.
    targetType = checkDeref(ref prog, ref tm, ref ast, target, ref scope);
    vec.vecSet(ref tm.resolvedTypes, expr.childA, targetType);
  } else if (target.kind == ASTNodeKind.INDEX_EXPRESSION) {
    // `xs[i] = v` - checkIndex records the element type on the node, which is
    // what the store needs.
    targetType = checkIndex(ref prog, ref tm, ref ast, target, ref scope);
    vec.vecSet(ref tm.resolvedTypes, expr.childA, targetType);
  } else {
    reportError(ref prog, `cannot assign to ${kindName(target.kind)}`, target.sourceLoc);
    return TYPE_ERROR_ID;
  }

  const valueType = checkExpr(ref prog, ref tm, ref ast, expr.childB, targetType, ref scope);
  if (valueType != TYPE_ERROR_ID && !typeAccepts(ref prog, targetType, valueType)) {
    reportError(ref prog, `cannot assign to "${target.name}": types do not match`, expr.sourceLoc);
  }
  // An assignment is a statement, not a value - nothing consumes its type.
  return TYPE_VOID_ID;
}

// `for (let i = 0; i < n; i = i + 1) { ... }`
//
// The counter lives in a scope of its OWN, wrapped around the body: it is
// visible to the condition, the step and the body, but not after the loop. When
// the init only steps an outer counter (`for (i = 0; ...)`) that name must
// already exist.
function checkForLoop(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  stmtId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  scopePush(ref scope);

  let counterType: TypeId = TYPE_ERROR_ID;
  if (stmt.childA != 0) {
    counterType = resolveTypeAnnotation(ref prog, ref tm, ref ast, stmt.childA);
  } else if (nodeAt(ref ast, stmt.childB).kind == ASTNodeKind.INT_LITERAL) {
    // An untyped literal initializer takes its type from the CONDITION, which
    // is what makes the idiomatic `for (let i = 0; i < xs.len; ...)` work: `i`
    // becomes usize so it can be compared against a length and used as an
    // index. Without this the literal would default to int32 and every such
    // loop would be a width mismatch. Same rule as the JS reference's
    // counterTypeFromCondition.
    counterType = counterTypeFromCondition(ref prog, ref tm, ref ast, stmt.childC, ref scope);
  }
  const initType = checkExpr(ref prog, ref tm, ref ast, stmt.childB, counterType, ref scope);
  if (counterType == TYPE_ERROR_ID) {
    counterType = initType;   // inferred from the initializer
  } else if (initType != TYPE_ERROR_ID && initType != counterType) {
    reportError(ref prog, `initializer does not match the declared type of "${stmt.name}"`, stmt.sourceLoc);
  }

  if (stmt.flagA) {
    // Declared with `let` by construction - the parser refuses `const` here,
    // because a counter that cannot be stepped is not a counter.
    if (!scopeDeclare(ref scope, stmt.name, counterType, true)) {
      reportError(ref prog, `"${stmt.name}" is already declared in this function`, stmt.sourceLoc);
    }
  } else {
    // Stepping an existing counter: it has to exist, and it decides the type.
    switch (scopeLookup(ref scope, stmt.name)) {
      case Option.Some { value: t }: { counterType = t; }
      case Option.None: {
        reportError(ref prog, `unknown name "${stmt.name}"`, stmt.sourceLoc);
      }
    }
  }
  vec.vecSet(ref tm.resolvedTypes, stmtId, counterType);

  checkCondition(ref prog, ref tm, ref ast, stmt.childC, ref scope);

  const stepType = checkExpr(ref prog, ref tm, ref ast, stmt.childD, counterType, ref scope);
  if (stepType != TYPE_ERROR_ID && counterType != TYPE_ERROR_ID && stepType != counterType) {
    reportError(ref prog, `for-loop step does not match the type of "${stmt.name}"`, stmt.sourceLoc);
  }

  scope.loopDepth += 1;
  checkBlock(ref prog, ref tm, ref ast, stmt.childE, retType, ref scope);
  scope.loopDepth -= 1;

  scopePop(ref scope);
}

// `for x in xs { ... }` - walk an array.
//
// The loop variable is bound to the ELEMENT type, which is the whole reason it
// takes no annotation. The statement node is decorated with that element type,
// because codegen needs it to size the loop variable's slot and to step the
// data pointer, and it has nowhere else to read it from.
//
// Only arrays are walked so far. A type implementing `Iterable<T>` is the other
// form, and it is refused BY NAME here rather than reported as "not an array" -
// the difference matters, because one is a missing feature and the other is a
// mistake.
function checkForInLoop(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  stmtId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  const iterableType = checkExpr(ref prog, ref tm, ref ast, stmt.childA, TYPE_ERROR_ID, ref scope);
  const elemType = forInElementType(ref prog, ref tm, ref ast, stmt, iterableType);
  vec.vecSet(ref tm.resolvedTypes, stmtId, elemType);

  // The loop variable is scoped to the loop, and shadowing an outer name is a
  // redeclaration the same way any other binding would be.
  scopePush(ref scope);
  // Immutable: the loop variable is a COPY of the element, so assigning to it
  // writes to something discarded at the end of the iteration. Refusing says
  // that, where allowing it silently does nothing.
  if (!scopeDeclare(ref scope, stmt.name, elemType, false)) {
    reportError(ref prog, `"${stmt.name}" is already declared in this function`, stmt.sourceLoc);
  }

  scope.loopDepth += 1;
  checkBlock(ref prog, ref tm, ref ast, stmt.childB, retType, ref scope);
  scope.loopDepth -= 1;
  scopePop(ref scope);
}

// What one step of `for x in <expr>` yields, or TYPE_ERROR_ID with a
// diagnostic. Split out so the two refusals read as the two different things
// they are.
function forInElementType(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  iterableType: TypeId
): TypeId {
  // The expression already failed and said so; a second diagnostic here would
  // only be noise.
  if (iterableType == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  switch (typeAt(ref prog, derefType(ref prog, iterableType))) {
    case Type.Array { elem: e }: { return e; }
    default: { }
  }

  // A type implementing `Iterable<T>` walks through its own `next`, which is a
  // static dispatch on a concrete receiver - see typecheck/iterable.yoop. The
  // ELEMENT type is whatever `Yield` carries.
  const iterated = derefType(ref prog, iterableType);
  const walk = iterableWalkOf(ref prog, iterated);
  if (walk.ok) {
    return walk.elemType;
  }
  if (walk.claimsIterable) {
    reportError(
      ref prog,
      `"${formatType(ref prog, iterated)}" implements Iterable, but its "next" must return an IterStep-shaped variant - the two cases "Yield { value: T }" and "Done"`,
      stmt.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  reportError(
    ref prog,
    `cannot walk a value of type "${formatType(ref prog, iterated)}" - "for ... in" needs an array or a type implementing Iterable<T>`,
    stmt.sourceLoc
  );
  return TYPE_ERROR_ID;
}

// `-x` keeps the operand's numeric type; `!x` takes a bool and gives a bool;
// `~x` keeps the operand's INTEGER type.
function checkUnary(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  // Bitwise NOT. The expectation flows through exactly as unary minus's does,
  // so `let w: uint8 = ~0` pins the 0 to uint8 and answers 255 rather than
  // defaulting to int32 and answering -1. An int-backed value ENUM is allowed
  // and keeps its own type (`~Flags.A` is a Flags), which is the same rule the
  // binary bitwise family follows; a string-backed one is not, and neither is
  // a bool, a float or anything else. All of that is the reference's behaviour,
  // established by probing it.
  if (expr.operator == TokenTags.TILDE) {
    const got = checkExpr(ref prog, ref tm, ref ast, expr.childA, expected, ref scope);
    if (got == TYPE_ERROR_ID) {
      return TYPE_ERROR_ID;
    }
    if (!isIntPrimType(ref prog, enumUnderlyingOf(ref prog, got))) {
      reportError(
        ref prog,
        `bitwise NOT operator requires an integer operand, found ${formatType(ref prog, got)}`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    return got;
  }

  if (expr.operator == TokenTags.BANG) {
    const got = checkExpr(ref prog, ref tm, ref ast, expr.childA, primTypeId(PrimKind.BOOL), ref scope);
    if (got != TYPE_ERROR_ID && got != primTypeId(PrimKind.BOOL)) {
      reportError(ref prog, "operand of ! must be bool", expr.sourceLoc);
      return TYPE_ERROR_ID;
    }
    return primTypeId(PrimKind.BOOL);
  }

  // Unary minus. The expectation flows through so `-1` in an int64 slot pins to
  // int64 rather than defaulting to int32, and `-1.5` in a float32 slot pins to
  // float32 the same way.
  const got = checkExpr(ref prog, ref tm, ref ast, expr.childA, expected, ref scope);
  if (got != TYPE_ERROR_ID &&
      !isIntPrimType(ref prog, got) &&
      !isFloatPrimType(ref prog, got)) {
    reportError(ref prog, "operand of unary - must be a number", expr.sourceLoc);
    return TYPE_ERROR_ID;
  }
  return got;
}

// `&&` / `||` - bool in, bool out, and short-circuiting in codegen.
function isLogical(tag: TokenTags): bool {
  switch (tag) {
    case TokenTags.ANDAND, TokenTags.OROR: { return true; }
    default: { return false; }
  }
}

// `[a, b, c]` - every element must agree, and an empty literal takes its element
// type from context.
function checkArrayLiteral(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  // An expected `T[]` tells the elements what to be, which is what lets
  // `let xs: int64[] = [1, 2]` pin its untyped literals to int64.
  let elemExpected: TypeId = TYPE_ERROR_ID;
  if (expected != TYPE_ERROR_ID) {
    switch (typeAt(ref prog, expected)) {
      case Type.Array { elem: e }: { elemExpected = e; }
      default: { }
    }
  }

  let elemType: TypeId = elemExpected;
  if (expr.childA != 0) {
    const list = nodeAt(ref ast, expr.childA);
    let i: usize = 0;
    while (i < list.childCount) {
      const got = checkExpr(ref prog, ref tm, ref ast, childAt(ref ast, list, i), elemType, ref scope);
      if (elemType == TYPE_ERROR_ID) {
        elemType = got;   // the first element sets the type
      } else if (got != TYPE_ERROR_ID && !typeAccepts(ref prog, elemType, got)) {
        reportError(ref prog, "array elements have different types", expr.sourceLoc);
      }
      i += 1;
    }
  }

  if (elemType == TYPE_ERROR_ID) {
    reportError(ref prog, "cannot infer the element type of an empty array literal - annotate the binding", expr.sourceLoc);
    return TYPE_ERROR_ID;
  }
  return internArray(ref prog, elemType);
}

// `xs[i]` - the base must be an array and the index an integer.
function checkIndex(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  const baseType = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  const idxType = checkExpr(ref prog, ref tm, ref ast, expr.childB, primTypeId(PrimKind.USIZE), ref scope);
  // An INTEGER-BACKED value enum indexes too, which is what makes a table keyed
  // by an enum (`AST_NODE_KIND_NAMES[kind]`) read the way it wants to. Nothing
  // is converted: an enum's value IS an integer, and gep takes any width.
  if (idxType != TYPE_ERROR_ID && !isIntPrimType(ref prog, enumUnderlyingOf(ref prog, idxType))) {
    reportError(
      ref prog,
      `an array index must be an integer, found ${formatType(ref prog, idxType)}`,
      expr.sourceLoc
    );
  }

  if (baseType == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  // A borrow of an array indexes like the array. Codegen opens it, because only
  // codegen knows whether this subscript is being read or written through.
  switch (typeAt(ref prog, derefType(ref prog, baseType))) {
    case Type.Array { elem: e }: { return e; }
    default: {
      reportError(ref prog, `cannot index ${formatType(ref prog, baseType)}`, expr.sourceLoc);
      return TYPE_ERROR_ID;
    }
  }
}

// `xs.len` is the only field access in the subset. Struct fields arrive with
// struct values.
function checkFieldAccess(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  // `Result.None` is a payload-less CONSTRUCTOR wearing a field access - the
  // same tokens as `p.x`. Checked before the base is checked as a value,
  // because a variant name is not one and would report as an unknown name.
  if (isPayloadlessConstructor(ref prog, ref tm, ref ast, expr, ref scope)) {
    return checkVariantConstructor(ref prog, ref tm, ref ast, expr, expr.childA, 0, expected, ref scope);
  }

  // `Color.Red` wears the same shape, and for the same reason: an enum name is
  // not a value, so the base must not be checked as one.
  if (isEnumCaseAccess(ref prog, ref tm, ref ast, expr, ref scope)) {
    return checkEnumCaseAccess(ref prog, ref tm, ref ast, expr);
  }

  const baseType = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  if (baseType == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  // A borrow reaches its fields like the thing it borrows - `cx.e.usesPrintf`
  // where `e: ref Emitter`, `srcRef.len` where `srcRef` came out of a
  // `ref uint8[]` field. The node KEEPS its `ref T` type, and codegen opens the
  // borrow, because a field READ wants the value and a field WRITE wants the
  // address - and only codegen knows which one this is.
  switch (typeAt(ref prog, derefType(ref prog, baseType))) {
    case Type.Array { elem: e }: {
      if (str.stringEq(expr.name, "len")) {
        return primTypeId(PrimKind.USIZE);
      }
      // `xs.ptr` - the DATA pointer, for handing a buffer to C. An array is
      // already a pointer plus a length, so this is a projection rather than a
      // conversion, and it borrows: the pointer is only valid while the array
      // is. Ungated on purpose - reading it is safe, and everything you can DO
      // with the result already needs `import.unsafe;`.
      if (str.stringEq(expr.name, "ptr")) {
        return internUnsafePtr(ref prog, e);
      }
      reportError(
        ref prog,
        `an array has no field "${expr.name}" - only "len" and "ptr"`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    case Type.Struct { decl: d, fields: f, methods: mm, implementsTraits: it, generic: g }: {
      const found = lookupField(ref prog, derefType(ref prog, baseType), expr.name);
      if (!found.found) {
        reportError(ref prog, `struct "${d.name}" has no field "${expr.name}"`, expr.sourceLoc);
        return TYPE_ERROR_ID;
      }
      return found.typeId;
    }
    // `s.len` - the string's BYTE length, which is what `strlen` returns and
    // what `stringAsBytes(s).len` would give. Not a character count: yoop has
    // no character type, and the byte length is the one every caller here
    // actually wants.
    case Type.Prim { prim: p }: {
      if (p == PrimKind.STRING && str.stringEq(expr.name, "len")) {
        return primTypeId(PrimKind.USIZE);
      }
      reportError(
        ref prog,
        `field access on ${formatType(ref prog, baseType)} is not supported by the bootstrap typechecker yet`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
    // The base is an enum VALUE rather than the enum's name - a local shadowing
    // it, or a struct field. An enum has no fields at all, so the only thing a
    // dot after one could have meant is a case, and saying that is what points
    // at the real mistake (`dir.len` on an `enum<string>` is reaching for the
    // string's length through a type that is not a string).
    case Type.ValueEnum { decl: d, underlying: u, cases: cs, isOpen: o,
                          methods: mm, implementsTraits: it }: {
      reportError(ref prog, `enum "${d.name}" has no case "${expr.name}"`, expr.sourceLoc);
      return TYPE_ERROR_ID;
    }
    default: {
      reportError(
        ref prog,
        `field access on ${formatType(ref prog, baseType)} is not supported by the bootstrap typechecker yet`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
  }
}

// The integer type a comparison in the loop condition implies for the counter,
// or TYPE_ERROR_ID when it implies nothing.
//
// Both sides are probed with diagnostics SUPPRESSED, because the counter is not
// declared yet - reading it here legitimately fails, and that failure is what
// identifies which side is the informative one. The real check runs afterwards
// and reports for real, so one mistake still produces one diagnostic.
function counterTypeFromCondition(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  condId: NodeId,
  ref scope: LocalScope
): TypeId {
  if (condId == 0) {
    return TYPE_ERROR_ID;
  }
  const cond = nodeAt(ref ast, condId);
  if (cond.kind != ASTNodeKind.BINARY_EXPRESSION || !isComparison(cond.operator)) {
    return TYPE_ERROR_ID;
  }

  const savedCount = prog.diagnostics.len;
  const lhs = checkExpr(ref prog, ref tm, ref ast, cond.childA, TYPE_ERROR_ID, ref scope);
  const rhs = checkExpr(ref prog, ref tm, ref ast, cond.childB, TYPE_ERROR_ID, ref scope);
  // Diagnostic is a plain struct with no owned storage, so dropping the tail
  // frees nothing and leaks nothing.
  prog.diagnostics.len = savedCount;

  if (isIntPrimType(ref prog, rhs)) {
    return rhs;
  }
  if (isIntPrimType(ref prog, lhs)) {
    return lhs;
  }
  return TYPE_ERROR_ID;
}

// `usize(n)` / `int32(x)` - a numeric primitive conversion.
//
// Exactly one operand, and it is checked against the target so an untyped
// literal pins straight to it (`int64(1)` needs no widening at all). Only
// numeric-to-numeric is allowed, which is the same restriction the JS reference
// states in its own message.
function checkCast(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  target: TypeId,
  ref scope: LocalScope
): TypeId {
  let argCount: usize = 0;
  if (expr.childA != 0) {
    argCount = nodeAt(ref ast, expr.childA).childCount;
  }
  if (argCount != 1) {
    reportError(ref prog, `cast "${expr.name}(...)" takes exactly one argument`, expr.sourceLoc);
    return target;
  }

  const list = nodeAt(ref ast, expr.childA);
  const argId = childAt(ref ast, list, 0);
  // NO expectation: a cast CONVERTS whatever it is given, so the target must
  // not reach in and pin the operand. Passing `target` here makes
  // `uint8(48 + (rest % 10))` pin the 48 to uint8 and then refuse to add it to
  // a uint64 - the cast's own job, done to its input before it runs.
  const argType = checkExpr(ref prog, ref tm, ref ast, argId, TYPE_ERROR_ID, ref scope);
  if (argType != TYPE_ERROR_ID && !isCastable(ref prog, argType, target)) {
    reportError(
      ref prog,
      `cannot cast ${formatType(ref prog, argType)} to ${formatType(ref prog, target)} - only numeric primitive casts are supported`,
      expr.sourceLoc
    );
  }
  return target;
}

// Number to number, in every combination: int to int, int to float, float to
// int, and float to float. A bool is not a number on either side, which is what
// `bool(x)` and `int32(b)` are refused for.
//
// The SOURCE looks through a value enum and the target does not, which is the
// asymmetry the reference has: `int32(c)` is the way to get an enum's number
// out, while there is no cast INTO one - an arbitrary integer names no case, and
// a cast name is a primitive spelling anyway, so `Color(i)` never reaches here.
// A string-backed enum falls out of the same rule: its underlying is not a
// number, so `string(dir)` is refused with the ordinary numeric-casts message.
//
// A float SOURCE is not unwrapped through `enumUnderlyingOf` because an enum can
// never be float-backed - the backing may only be an int width or `string`.
function isCastable(ref prog: Program, source: TypeId, target: TypeId): bool {
  return isNumericPrim(ref prog, enumUnderlyingOf(ref prog, source)) &&
    isNumericPrim(ref prog, target);
}

function isNumericPrim(ref prog: Program, id: TypeId): bool {
  return isIntPrimType(ref prog, id) || isFloatPrimType(ref prog, id);
}

// `switch (n) { case 1, 2: {...} default: {...} }` over an integer, or
// `switch (r) { case Result.Ok { value: v }: {...} ... }` over a variant.
//
// The two differ in exactly one way that matters here: an integer switch can
// never be exhaustive, so `default` is required, while a variant switch is
// exhaustive when every case appears and then a default would be dead code.
function checkSwitch(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  retType: TypeId,
  ref scope: LocalScope
): void {
  const scrutType = checkExpr(ref prog, ref tm, ref ast, stmt.childA, TYPE_ERROR_ID, ref scope);
  const overVariant = isVariantType(ref prog, scrutType);
  const isEnum = isValueEnumType(ref prog, scrutType);
  // A STRING-backed enum has no jump table to build, and says so. Its arms are
  // still walked as ordinary blocks, but their PATTERNS are not checked at all -
  // routing them to the integer checker would add "must be literals, not variant
  // cases" to every arm, so one mistake would produce N diagnostics.
  const overEnum = isEnum && checkEnumScrutinee(ref prog, stmt, scrutType);
  if (!isEnum && scrutType != TYPE_ERROR_ID && !overVariant &&
      !isIntPrimType(ref prog, scrutType)) {
    reportError(
      ref prog,
      `cannot switch over ${formatType(ref prog, scrutType)} - the bootstrap typechecker handles integers, enums and variants so far`,
      stmt.sourceLoc
    );
  }

  // Which case ordinals have been matched, so a missing one can be NAMED. The
  // enum switch carries a second list, of the VALUES matched: two cases may
  // share a value, and a jump table may not name one twice.
  disposable covered: Vec<bool> = vec.vecNew(0);
  disposable seenValues: Vec<int64> = vec.vecNew(0);
  let caseCount: usize = variantCaseCount(ref prog, scrutType);
  if (overEnum) {
    caseCount = enumCaseCount(ref prog, scrutType);
  }
  let c: usize = 0;
  while (c < caseCount) {
    vec.vecPush(ref covered, false);
    c += 1;
  }

  let sawDefault = false;
  let i: usize = 0;
  while (i < stmt.childCount) {
    const armId = childAt(ref ast, stmt, i);
    const arm = nodeAt(ref ast, armId);

    // The arm's scope opens BEFORE its patterns are checked, because a variant
    // pattern declares its payload bindings into it.
    scopePush(ref scope);
    if (arm.flagA) {
      if (sawDefault) {
        reportError(ref prog, "a switch may only have one default arm", arm.sourceLoc);
      }
      sawDefault = true;
    } else if (overVariant) {
      checkVariantArm(ref prog, ref tm, ref ast, arm, scrutType, ref covered, ref scope);
    } else if (overEnum) {
      checkEnumArm(ref prog, ref tm, ref ast, arm, scrutType, ref covered, ref seenValues);
    } else if (!isEnum) {
      checkArmPatterns(ref prog, ref tm, ref ast, arm, scrutType);
    }
    // A switch arm is a BREAKABLE scope - see the BREAK_STATEMENT case in
    // checkStatement. It does not supply a `continue` target, which is why this
    // is its own counter rather than a bump of `loopDepth`.
    scope.switchDepth += 1;
    checkBlock(ref prog, ref tm, ref ast, arm.childB, retType, ref scope);
    scope.switchDepth -= 1;
    scopePop(ref scope);
    i += 1;
  }

  if (overVariant) {
    checkExhaustive(ref prog, stmt, scrutType, ref covered, sawDefault);
    return;
  }
  if (overEnum) {
    checkEnumExhaustive(ref prog, stmt, scrutType, ref covered, sawDefault);
    return;
  }
  // A string-backed enum reached the refusal above; its arms are checked but
  // nothing is exhaustive about them, so it must not fall into the integer rule
  // and collect a second diagnostic.
  if (isEnum) {
    return;
  }
  if (!sawDefault) {
    reportError(
      ref prog,
      "a switch over an integer needs a default arm - it cannot be exhaustive",
      stmt.sourceLoc
    );
  }
}

// Every pattern of one variant arm. Several may share an arm, and each records
// the case it covers.
function checkVariantArm(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  arm: ASTNode,
  scrutType: TypeId,
  ref covered: Vec<bool>,
  ref scope: LocalScope
): void {
  if (arm.childA == 0) {
    return;
  }
  const list = nodeAt(ref ast, arm.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    const patternId = childAt(ref ast, list, i);
    if (nodeAt(ref ast, patternId).kind != ASTNodeKind.VARIANT_PATTERN) {
      reportError(
        ref prog,
        `this switch is over ${formatType(ref prog, scrutType)}, so its patterns must be variant cases, not literals`,
        nodeAt(ref ast, patternId).sourceLoc
      );
      i += 1;
      continue;
    }
    const ordinal = checkVariantPattern(ref prog, ref tm, ref ast, patternId, scrutType, ref scope);
    if (ordinal >= 0 && usize(ordinal) < covered.len) {
      if (vec.vecGet(ref covered, usize(ordinal))) {
        reportError(
          ref prog,
          `case "${nodeAt(ref ast, patternId).name}" is matched twice in this switch`,
          nodeAt(ref ast, patternId).sourceLoc
        );
      }
      vec.vecSet(ref covered, usize(ordinal), true);
    }
    i += 1;
  }
}

// A variant switch is exhaustive or it has a default - never neither, and never
// both. "Never both" is the part worth the diagnostic: a default that can never
// run is dead code, and usually means a case name is misspelled.
function checkExhaustive(
  ref prog: Program,
  stmt: ASTNode,
  scrutType: TypeId,
  ref covered: Vec<bool>,
  sawDefault: bool
): void {
  let missing: usize = 0;
  let firstMissing: usize = 0;
  let i: usize = 0;
  while (i < covered.len) {
    if (!vec.vecGet(ref covered, i)) {
      if (missing == 0) {
        firstMissing = i;
      }
      missing += 1;
    }
    i += 1;
  }

  if (missing == 0) {
    if (sawDefault) {
      reportError(
        ref prog,
        `this switch already covers every case of ${formatType(ref prog, scrutType)}, so the default arm can never run`,
        stmt.sourceLoc
      );
    }
    return;
  }
  if (sawDefault) {
    return;   // the default covers whatever is left
  }
  reportError(
    ref prog,
    `this switch does not cover "${variantCaseNameAt(ref prog, scrutType, firstMissing)}" (${missing} case(s) unhandled) - add it, or a default arm`,
    stmt.sourceLoc
  );
}

// Each pattern is decorated with the scrutinee's type, which is what tells
// codegen the width to emit the case value at.
function checkArmPatterns(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  arm: ASTNode,
  scrutType: TypeId
): void {
  if (arm.childA == 0) {
    return;
  }
  const list = nodeAt(ref ast, arm.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    const patternId = childAt(ref ast, list, i);
    if (nodeAt(ref ast, patternId).kind == ASTNodeKind.VARIANT_PATTERN) {
      reportError(
        ref prog,
        "this switch is over an integer, so its patterns must be literals, not variant cases",
        nodeAt(ref ast, patternId).sourceLoc
      );
      i += 1;
      continue;
    }
    vec.vecSet(ref tm.resolvedTypes, patternId, scrutType);
    i += 1;
  }
}

// `{ x: 1, y: 2 }` - which struct it is comes from CONTEXT, not from the
// literal, so `let p: Point = { ... }` is the only shape that works. A literal
// with nothing to take its type from is refused by name.
function checkStructLiteral(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  if (expected == TYPE_ERROR_ID || !isStructType(ref prog, expected)) {
    reportError(
      ref prog,
      "cannot tell which struct this literal is - annotate the binding or the parameter it goes to",
      expr.sourceLoc
    );
    // Still walk the field values so a mistake inside one is reported too.
    checkLiteralFieldValues(ref prog, ref tm, ref ast, expr, TYPE_ERROR_ID, ref scope);
    return TYPE_ERROR_ID;
  }

  const present = checkLiteralFieldValues(ref prog, ref tm, ref ast, expr, expected, ref scope);
  const needed = structFieldCount(ref prog, expected);
  if (present < needed) {
    reportError(
      ref prog,
      `struct literal is missing ${needed - present} of ${needed} fields - every field must be given a value`,
      expr.sourceLoc
    );
  }
  return expected;
}

// Checks each `name: value` against the struct's field of that name, and returns
// how many DISTINCT known fields were given a value.
function checkLiteralFieldValues(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  structType: TypeId,
  ref scope: LocalScope
): usize {
  let present: usize = 0;
  if (expr.childA == 0) {
    return present;
  }
  const list = nodeAt(ref ast, expr.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    const fieldId = childAt(ref ast, list, i);
    const fieldNode = nodeAt(ref ast, fieldId);

    let fieldType: TypeId = TYPE_ERROR_ID;
    if (structType != TYPE_ERROR_ID) {
      const found = lookupField(ref prog, structType, fieldNode.name);
      if (found.found) {
        fieldType = found.typeId;
        present += 1;
        // The field's POSITION is what codegen stores to, so record it on the
        // node rather than making codegen look it up again.
        vec.vecSet(ref tm.resolvedTypes, fieldId, found.typeId);
      } else {
        reportError(
          ref prog,
          `${formatType(ref prog, structType)} has no field "${fieldNode.name}"`,
          fieldNode.sourceLoc
        );
      }
    }

    const got = checkExpr(ref prog, ref tm, ref ast, fieldNode.childA, fieldType, ref scope);
    if (fieldType != TYPE_ERROR_ID && got != TYPE_ERROR_ID && !typeAccepts(ref prog, fieldType, got)) {
      reportError(
        ref prog,
        `field "${fieldNode.name}" expects ${formatType(ref prog, fieldType)}, found ${formatType(ref prog, got)}`,
        fieldNode.sourceLoc
      );
    }
    i += 1;
  }
  return present;
}

// Every `${...}` in a template literal, checked and decorated.
//
// A template literal BUILDS a string, so each interpolation has to become one.
// Refusing the shapes that cannot here, by name and pointing at the
// interpolation, is what keeps codegen from meeting a part it has no lowering
// for - `${somePoint}` should say so at the `${`, not surface as an internal
// error after the whole program typechecked.
function checkTemplateParts(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): void {
  let i: usize = 0;
  while (i < expr.childCount) {
    const partId = childAt(ref ast, expr, i);
    const part = nodeAt(ref ast, partId);
    // A literal run is already a string and has no expression to check.
    if (part.kind != ASTNodeKind.EXPR_PART) {
      vec.vecSet(ref tm.resolvedTypes, partId, primTypeId(PrimKind.STRING));
      i += 1;
      continue;
    }

    // TYPE_ERROR_ID doubles as "no expectation" here, the same way every other
    // free-standing expression in this file passes it: an interpolation takes
    // whatever the expression is.
    const inner = checkExpr(ref prog, ref tm, ref ast, part.childA, TYPE_ERROR_ID, ref scope);
    vec.vecSet(ref tm.resolvedTypes, partId, primTypeId(PrimKind.STRING));
    // An expression that already failed produced its own diagnostic; a second
    // one naming the error type would only be noise.
    if (inner != TYPE_ERROR_ID &&
        templatePartKind(ref prog, inner) == TemplatePartKind.UNSUPPORTED) {
      // A type carrying `@derive(display)` reads as "this prints" to whoever
      // wrote it, so the generic message would send them looking for a typo.
      // The attribute PARSES and is unwrapped; generating the `toString` is a
      // separate piece of work that needs Display dispatch in interpolation
      // first, and saying so is what keeps the gap from looking like a bug.
      if (carriesDeriveDisplay(ref prog, inner)) {
        reportError(
          ref prog,
          `"${formatType(ref prog, inner)}" carries @derive(display), which the bootstrap parses but does not expand yet - write \`toString\` by hand, or interpolate the fields`,
          part.sourceLoc
        );
      } else {
        reportError(
          ref prog,
          `cannot interpolate a value of type "${formatType(ref prog, inner)}" into a template literal - it is not a string, integer or bool, and carries no \`toString(ref self): string\``,
          part.sourceLoc
        );
      }
    }
    i += 1;
  }
}

// The Func type of `base.name` when `base` is a value with a function-typed
// field of that name, or TYPE_ERROR_ID when it is anything else.
//
// Deliberately silent: "not a function-typed field" is the ordinary case (every
// `ns.fn()` in the program reaches here first), so a diagnostic belongs to
// whoever fails AFTER this returns nothing.
function fieldFuncTypeOf(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  base: ASTNode,
  ref scope: LocalScope
): TypeId {
  // A bare IDENT base is only a value if it is a LOCAL - a module-level name
  // there is a namespace or a type, and neither has fields.
  if (base.kind == ASTNodeKind.IDENT) {
    switch (scopeLookup(ref scope, base.name)) {
      case Option.None: { return TYPE_ERROR_ID; }
      case Option.Some { value: t }: {
        const field = funcFieldOf(ref prog, t, expr.name);
        if (field != TYPE_ERROR_ID) {
          // DECORATE the base. Codegen reads the field out of this value, and
          // it needs both the aggregate's LLVM type and the field's position -
          // neither of which it can get without the base's resolved type.
          vec.vecSet(ref tm.resolvedTypes, expr.childB, t);
        }
        return field;
      }
    }
  }
  if (base.kind != ASTNodeKind.FIELD_ACCESS) {
    return TYPE_ERROR_ID;
  }
  // `m.ops.hash(...)`: the base is itself a field read, so check it to learn
  // its type. Checking it here also DECORATES it, which codegen needs.
  const baseType = checkExpr(ref prog, ref tm, ref ast, expr.childB, TYPE_ERROR_ID, ref scope);
  return funcFieldOf(ref prog, baseType, expr.name);
}

// The type of a struct's field, when that type is a Func. TYPE_ERROR_ID
// otherwise, including when the base is not a struct at all.
function funcFieldOf(ref prog: Program, ownerType: TypeId, fieldName: string): TypeId {
  const found = lookupField(ref prog, derefType(ref prog, ownerType), fieldName);
  if (!found.found) {
    return TYPE_ERROR_ID;
  }
  switch (typeAt(ref prog, found.typeId)) {
    case Type.Func { params: p, ret: r, variadic: v }: { return found.typeId; }
    default: { return TYPE_ERROR_ID; }
  }
}

// A call whose callee is a VALUE rather than a name. The arguments are checked
// against the signature exactly as a direct call's are - the only difference is
// where the signature came from.
function checkIndirectCall(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  funcType: TypeId,
  expected: TypeId,
  ref scope: LocalScope
): TypeId {
  // Recorded for codegen: the callee is the FIELD's contents, so there is no
  // symbol to look up and nothing else can tell it that.
  map.mapInsert(ref tm.indirectCalls, uint64(exprId), true);
  checkArgsAgainstFunc(ref prog, ref tm, ref ast, expr, funcType, expr.name, ref scope);
  switch (typeAt(ref prog, funcType)) {
    case Type.Func { params: p, ret: r, variadic: v }: { return r; }
    default: { return TYPE_ERROR_ID; }
  }
}

// The Func type of a module-level function NAME, or TYPE_ERROR_ID.
function moduleFuncType(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  switch (map.mapGet(ref tm.names, name)) {
    case Option.None: { return TYPE_ERROR_ID; }
    case Option.Some { value: symId }: {
      // No import to follow: an import binds the SOURCE module's SymbolId, the
      // same integer, so an imported function is already a Symbol.Func here.
      switch (symbolAt(ref prog, symId)) {
        case Symbol.Func { typeId: t }: { return t; }
        default: { return TYPE_ERROR_ID; }
      }
    }
  }
}

// `xs[a..b]` - a BORROWING view over part of an array.
//
// The result is the same array type as the base: a slice is a data pointer and
// a length, exactly like the thing it came from, and it shares the storage. So
// there is nothing to allocate and nothing to copy - and equally, nothing keeps
// the base alive, which is the caller's problem the same way it is for any
// borrow.
//
// Bounds are usize and are NOT checked here or at run time. The language does
// not specify a bounds check on an index either, and inventing one for slices
// alone would be the odd rule out.
function checkSlice(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  const baseType = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  const usize = primTypeId(PrimKind.USIZE);
  // An omitted bound is 0 - "from the beginning" / "to the end" - and there is
  // no expression to check.
  if (expr.childB != 0) {
    checkExpr(ref prog, ref tm, ref ast, expr.childB, usize, ref scope);
  }
  if (expr.childC != 0) {
    checkExpr(ref prog, ref tm, ref ast, expr.childC, usize, ref scope);
  }

  if (baseType == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  switch (typeAt(ref prog, derefType(ref prog, baseType))) {
    case Type.Array { elem: e }: { return derefType(ref prog, baseType); }
    default: {
      reportError(
        ref prog,
        `cannot slice a value of type "${formatType(ref prog, baseType)}" - only an array can be sliced`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
  }
}

// `&x` - the address of a binding, as a raw pointer.
//
// Distinct from `ref x`, which is a checked BORROW. `&` produces an
// `unsafe_ptr<T>` with none of a borrow's guarantees, and exists to hand a
// local to C - so it is gated on `import.unsafe;` exactly as the pointer type
// is. Handing out an address without saying the file is unsafe would let the
// gate be bypassed by one character.
//
// The target must be a NAMED binding: an address needs storage, and a
// temporary has none. Same limitation `ref` carries, and for the same reason.
function checkAddressOf(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  if (!tm.unsafeAllowed) {
    reportError(
      ref prog,
      `'&x' takes a raw address and requires 'import.unsafe;' at module top`,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  const target = nodeAt(ref ast, expr.childA);
  if (target.kind != ASTNodeKind.IDENT) {
    reportError(
      ref prog,
      "`&` takes a named binding - there is no address for a temporary",
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  const inner = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  if (inner == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  return internUnsafePtr(ref prog, inner);
}

// `*p` - the value a pointer points at.
//
// Only a TYPED pointer can be dereferenced. The opaque `unsafe_ptr` is "some
// pointer" and has no pointee to produce, so reading through one has no type -
// which is the practical cost of widening, and the reason the two are distinct.
function checkDeref(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  if (!tm.unsafeAllowed) {
    reportError(
      ref prog,
      `'*p' reads through a raw pointer and requires 'import.unsafe;' at module top`,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  const inner = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  if (inner == TYPE_ERROR_ID) {
    return TYPE_ERROR_ID;
  }
  switch (typeAt(ref prog, inner)) {
    case Type.UnsafePtr { pointee: p }: {
      if (p == TYPE_ERROR_ID) {
        reportError(
          ref prog,
          `cannot read through an opaque "unsafe_ptr" - it has no pointee type; use "unsafe_ptr<T>"`,
          expr.sourceLoc
        );
        return TYPE_ERROR_ID;
      }
      return p;
    }
    default: {
      reportError(
        ref prog,
        `cannot dereference a value of type "${formatType(ref prog, inner)}" - only a raw pointer can be`,
        expr.sourceLoc
      );
      return TYPE_ERROR_ID;
    }
  }
}

// A bare integer literal, which is what may still be re-pinned after it has
// been checked once. `-1` counts: the negation of a literal is still one.
function isIntLiteralNode(ref ast: AST, exprId: NodeId): bool {
  const node = nodeAt(ref ast, exprId);
  if (node.kind == ASTNodeKind.INT_LITERAL) {
    return true;
  }
  if (node.kind == ASTNodeKind.UNARY_EXPRESSION && node.operator == TokenTags.MINUS) {
    return nodeAt(ref ast, node.childA).kind == ASTNodeKind.INT_LITERAL;
  }
  return false;
}

// The ambient namespace of the libc errno bridge. Not an import: `errno.get()`
// resolves by spelling, the same way the reference's ERRNO_INTRINSIC does.
const ERRNO_NAMESPACE: string = "errno";

// `errno.get(): c_int`, `errno.set(v: c_int): void`, `errno.message(c: c_int):
// string`. Three fixed signatures, checked here rather than registered as
// symbols because there is no module to register them in.
function checkErrnoCall(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  const intType = primTypeId(PrimKind.INT32);
  let args: usize = 0;
  if (expr.childA != 0) {
    args = nodeAt(ref ast, expr.childA).childCount;
  }

  if (str.stringEq(expr.name, "get")) {
    if (args != 0) {
      reportError(ref prog, `errno.get() takes no arguments`, expr.sourceLoc);
    }
    return intType;
  }
  if (str.stringEq(expr.name, "set")) {
    checkErrnoArg(ref prog, ref tm, ref ast, expr, intType, ref scope);
    return TYPE_VOID_ID;
  }
  if (str.stringEq(expr.name, "message")) {
    checkErrnoArg(ref prog, ref tm, ref ast, expr, intType, ref scope);
    return primTypeId(PrimKind.STRING);
  }

  checkCallArgs(ref prog, ref tm, ref ast, expr, ref scope);
  reportError(
    ref prog,
    `"errno" has no member "${expr.name}" - the ones that exist are get, set and message`,
    expr.sourceLoc
  );
  return TYPE_ERROR_ID;
}

function checkErrnoArg(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  want: TypeId,
  ref scope: LocalScope
): void {
  if (expr.childA == 0) {
    reportError(ref prog, `errno.${expr.name}() takes one argument`, expr.sourceLoc);
    return;
  }
  const list = nodeAt(ref ast, expr.childA);
  if (list.childCount != 1) {
    reportError(ref prog, `errno.${expr.name}() takes one argument`, expr.sourceLoc);
    return;
  }
  checkExpr(ref prog, ref tm, ref ast, childAt(ref ast, list, 0), want, ref scope);
}

// `ephemeral arenaScope(N) { ... }` - an anonymous region.
//
// The subject is an ordinary expression, checked and decorated so codegen can
// give it a slot; the block is an ordinary block. What makes it a region is the
// kind, which has to be one declared `appliesTo region` and has to demand a
// scope-end call - a kind that asks for nothing would make this shape a plain
// block with extra words.
function checkKindRegion(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmt: ASTNode,
  stmtId: NodeId,
  retType: TypeId,
  ref scope: LocalScope
): void {
  const subjectType = checkExpr(ref prog, ref tm, ref ast, stmt.childA, TYPE_ERROR_ID, ref scope);
  vec.vecSet(ref tm.resolvedTypes, stmtId, subjectType);

  const list = nodeAt(ref ast, stmt.childC);
  let i: usize = 0;
  while (i < list.childCount) {
    const prefix = nodeAt(ref ast, childAt(ref ast, list, i));
    switch (lookupKind(ref prog, prefix.name)) {
      case Option.None: {
        reportError(ref prog, `unknown kind "${prefix.name}"`, prefix.sourceLoc);
      }
      case Option.Some { value: info }: {
        // The reference's rule, and its message names the alternative: a
        // binding kind used anonymously has nothing to be called ON later.
        if (!info.appliesToRegion) {
          reportError(
            ref prog,
            `kind "${prefix.name}" does not apply to a region - the anonymous "${prefix.name} EXPR { ... }" form needs a region kind. To use it as a named resource, write "${prefix.name} name: T = EXPR;"`,
            prefix.sourceLoc
          );
        } else if (info.disposeMethod.len == 0) {
          reportError(
            ref prog,
            `kind "${prefix.name}" asks for nothing at scope end, so "${prefix.name} EXPR { ... }" would be a plain block`,
            prefix.sourceLoc
          );
        } else if (subjectType != TYPE_ERROR_ID &&
                   lookupMethod(ref prog, subjectType, info.disposeMethod) == TYPE_ERROR_ID) {
          reportError(
            ref prog,
            `"${prefix.name}" requires a "${info.disposeMethod}" method, but ${formatType(ref prog, subjectType)} has none`,
            stmt.sourceLoc
          );
        }
      }
    }
    i += 1;
  }

  scopePush(ref scope);
  checkBlock(ref prog, ref tm, ref ast, stmt.childB, retType, ref scope);
  scopePop(ref scope);
}
