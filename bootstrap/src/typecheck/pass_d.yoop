module typecheck;

// Pass D - check function bodies and decorate every node codegen will read.
//
// Decoration is the dense `TypedModule.resolvedTypes` vector indexed by NodeId
// (decision D2): the AST stays the parser's immutable output and the types live
// beside it. Codegen may assume every node it visits has a concrete TypeId here.
//
// THIS FILE IS THE DRIVER, and nothing else. It walks a module's files, finds
// the things that HAVE bodies (functions, methods, and the initializer of a
// module-level `let`), works out the signature each body is checked against, and
// builds the `Cx` the walk runs on. The walk itself is split across the
// check_*.yoop files beside it, one per shape of thing being checked:
//
//   check_stmt.yoop       statements and the bindings they introduce
//   check_expr.yoop       the expression dispatch, operators, casts, borrows
//   check_call.yoop       a call against a signature, and generic inference
//   check_qualified.yoop  a call written with a dot on the left
//   check_access.yoop     paths that name storage: fields, elements, `ref`, `&`
//   check_literal.yoop    literals that have a SHAPE to check against a type
//   check_loop.yoop       the two loop forms
//   check_switch.yoop     switch, its arms, and exhaustiveness
//
// They are one module, so they see each other without importing; the split is
// for a reader, not for the linker. Everything below the driver takes `ref cx:
// Cx` - see context.yoop for what that carries and why.

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, nodeAt } from "../ast";
import { Module } from "../source_graph";
export function passDCheckBodies(ref prog: Program, ref tm: TypedModule, m: Module): void {
  // One decoration slot per arena node, so a NodeId indexes straight in.
  // TYPE_ERROR_ID doubles as "nothing resolved here".
  vec.vecClear(ref tm.resolvedTypes);
  let n: usize = 0;
  while (n < m.ast.nodes.len) {
    vec.vecPush(ref tm.resolvedTypes, TYPE_ERROR_ID);
    n += 1;
  }

  let f: usize = 0;
  while (f < m.files.len) {
    const file = vec.vecGet(ref m.files, f);
    beginFile(ref prog, file.absPath);
    checkFileBodies(ref prog, ref tm, m, file.root);
    f += 1;
  }

  // Which scope-end calls the bodies above already made BY HAND. A separate
  // walk rather than something threaded through the checks, because the answer
  // is a merge over paths and the checks run in source order - see
  // discharge.yoop.
  computeDischarges(ref prog, ref tm, m);
}

function checkFileBodies(ref prog: Program, ref tm: TypedModule, m: Module, root: NodeId): void {
  const programNode = nodeAt(ref m.ast, root);
  let i: usize = 0;
  while (i < programNode.childCount) {
    const declId = declOf(ref m.ast, childAt(ref m.ast, programNode, i));
    const declNode = nodeAt(ref m.ast, declId);
    if (declNode.kind == ASTNodeKind.FUNCTION_DECL) {
      checkFunctionBody(ref prog, ref tm, ref m.ast, declNode);
    }
    // A type's METHODS have bodies too, and they are not module-level names -
    // so the walk has to reach into the decl to find them.
    if (declNode.kind == ASTNodeKind.TYPE_DECL ||
        declNode.kind == ASTNodeKind.VARIANT_DECL ||
        declNode.kind == ASTNodeKind.ENUM_DECL) {
      checkMethodBodies(ref prog, ref tm, ref m.ast, declNode);
    }
    // A module-level `let` whose value is not BAKED into its LLVM global is
    // emitted as a store in the module's init function - so its initializer is
    // an ordinary expression that codegen will walk, and it needs checking and
    // decorating exactly like one in a body. See fillModuleGlobal in
    // pass_c.yoop for the split, and codegen/module_init.yoop for the store.
    if (declNode.kind == ASTNodeKind.LET_DECL || declNode.kind == ASTNodeKind.CONST_DECL) {
      checkModuleGlobalInit(ref prog, ref tm, ref m.ast, declNode);
    }
    // An `@precompile { ... }` block. Its statements are ordinary ones and the
    // comptime pass is going to WALK them, so they need checking and decorating
    // exactly as a body's do - an undecorated statement folds to zeros.
    if (declNode.kind == ASTNodeKind.BLOCK) {
      checkPrecompileBlock(ref prog, ref tm, ref m.ast, declId);
    }
    i += 1;
  }
}

// An `@precompile { ... }` block's statements.
//
// Not a body: there are no parameters and no enclosing function, so the scope
// starts empty and the ambient return type is void. Module-level names resolve
// the way they do anywhere else, which is what lets the block read and write
// the globals it exists to fill.
function checkPrecompileBlock(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  blockId: NodeId
): void {
  beginFunction(ref prog, "@precompile", TYPE_VOID_ID, false, false);
  disposable scope: LocalScope = scopeNew();
  let cx: Cx = { prog: ref prog, tm: ref tm, ast: ref ast, scope: ref scope };
  checkBlock(ref cx, blockId);
}

// The initializer of a module-level `let` or `const`.
//
// It is not a body: there are no parameters, no locals in scope, and no
// enclosing function for `?` or `await` to belong to - so the scope it is
// checked in is empty and the ambient return type is void, which is what makes
// a `?` written here refuse itself rather than propagate into nothing.
//
// EVERY initializer is walked, including one that will never be emitted because
// its const inlines. Decoration is the point rather than the check: the
// comptime evaluator reads an expression's resolved types, and an initializer
// nobody typed folds to zeros - silently, because every operation on an
// untyped slot is a mask by a width of nothing. The check itself is a
// no-op for a decl pass C already validated by shape.
function checkModuleGlobalInit(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): void {
  const declared = moduleLevelValueType(ref prog, ref tm, declNode.name);
  if (declared == TYPE_ERROR_ID || declNode.childB == 0) {
    return;
  }
  // A BAKED `let` is an integer literal whose value rides in the symbol. There
  // is no expression for codegen to walk and nothing for comptime to fold, so
  // it is the one initializer left undecorated.
  if (declNode.kind == ASTNodeKind.LET_DECL &&
      moduleGlobalIsBaked(ref prog, ref ast, declNode.childB, declared)) {
    return;
  }
  beginFunction(ref prog, declNode.name, TYPE_VOID_ID, false, false);
  disposable scope: LocalScope = scopeNew();
  let cx: Cx = { prog: ref prog, tm: ref tm, ast: ref ast, scope: ref scope };
  const got = checkExpr(ref cx, declNode.childB, declared);
  if (got != TYPE_ERROR_ID && !typeAccepts(ref prog, declared, got)) {
    // Named for the keyword that was actually written. This walk covers both
    // kinds now, and calling a `const` a `let` sends the reader looking for a
    // declaration that is not there.
    let keyword: string = "let";
    if (declNode.kind == ASTNodeKind.CONST_DECL) {
      keyword = "const";
    }
    reportError(
      ref prog,
      `module-level "${keyword} ${declNode.name}" is ${formatType(ref prog, declared)}, but its initializer is ${formatType(ref prog, got)}`,
      declNode.sourceLoc
    );
  }
}

// Every METHOD_DECL member of a type decl. Its signature is already in the
// owner's method table, so this is the same job checkFunctionBody does with the
// lookup replaced.
function checkMethodBodies(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): void {
  const ownerType = ownTypeOf(ref prog, ref tm, declNode.name);

  // A generic type's methods talk about `T` - in `ref self`, in their
  // parameters, and in any annotation inside the body - so its parameters go
  // into scope for the whole run, the same way a generic function's do.
  disposable names: Vec<string> = bodyTypeParamNames(ref ast, declNode);
  disposable params: Vec<TypeId> = bodyTypeParams(ref prog, ref tm, declNode);
  if (names.len > 0) {
    beginTypeParams(ref prog, ref params, ref names);
  }

  let i: usize = 0;
  while (i < declNode.childCount) {
    const memberId = childAt(ref ast, declNode, i);
    const member = nodeAt(ref ast, memberId);
    if (member.kind == ASTNodeKind.METHOD_DECL) {
      checkBodyAgainst(ref prog, ref tm, ref ast, member,
        lookupMethod(ref prog, ownerType, member.name));
    }
    i += 1;
  }

  if (names.len > 0) {
    endTypeParams(ref prog);
  }
}

// The type a decl's own name binds to. Only used to reach a method table.
function ownTypeOf(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  const symId = lookupOwnName(ref tm, name);
  if (symId == SYMBOL_NONE_ID) {
    return TYPE_ERROR_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Struct { typeId: t }: { return t; }
    case Symbol.VariantT { typeId: t }: { return t; }
    case Symbol.ValueEnum { typeId: t }: { return t; }
    // A GENERIC type's methods hang off its TEMPLATE. Without this the lookup
    // fails, the body is never checked, and its parameters are never decorated
    // - which codegen finds out about as an empty owner name and a void return.
    case Symbol.GenericDecl { decl: d, sort: srt }: { return genericAt(ref prog, d).template; }
    default: { return TYPE_ERROR_ID; }
  }
}

function checkFunctionBody(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): void {
  const symId = lookupOwnName(ref tm, declNode.name);
  if (symId == SYMBOL_NONE_ID) {
    return;
  }
  // A GENERIC function is checked ONCE, against its template - so its type
  // parameters stay opaque and its decoration is written in terms of them.
  // Codegen substitutes per instantiation rather than pass D re-checking, which
  // is sound precisely because a parameter has no bounds: an opaque `T` supports
  // nothing, so a body that checks generically checks for every instantiation.
  // When bounds land, this is the decision to revisit.
  let signature: TypeId = TYPE_ERROR_ID;
  let generic = false;
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Func { typeId: t }: { signature = t; }
    case Symbol.GenericDecl { decl: d, sort: s }: {
      if (s != GenericSort.FUNC) {
        return;
      }
      signature = genericAt(ref prog, d).template;
      generic = true;
    }
    default: { return; }
  }

  if (!generic) {
    checkBodyAgainst(ref prog, ref tm, ref ast, declNode, signature);
    return;
  }

  // The parameters have to be in scope for the BODY, not just the signature:
  // `let new_data: T[] = ...` is an annotation inside the body, and `T` means
  // nothing without them. Pass C does the same around a signature; this is the
  // half that was missing.
  disposable names: Vec<string> = bodyTypeParamNames(ref ast, declNode);
  disposable params: Vec<TypeId> = bodyTypeParams(ref prog, ref tm, declNode);
  beginTypeParams(ref prog, ref params, ref names);
  checkBodyAgainst(ref prog, ref tm, ref ast, declNode, signature);
  endTypeParams(ref prog);
}

// The declared type-parameter NAMES of a generic decl, in order.
function bodyTypeParamNames(ref ast: AST, declNode: ASTNode): Vec<string> propagates<disposable> {
  let names: Vec<string> = vec.vecNew(2);
  if (declNode.childA == 0) {
    return names;
  }
  const list = nodeAt(ref ast, declNode.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    vec.vecPush(ref names, nodeAt(ref ast, childAt(ref ast, list, i)).name);
    i += 1;
  }
  return names;
}

// The TypeParam ids pass A interned for it - the SAME ids the template's
// signature uses, so a body annotation and the signature agree.
function bodyTypeParams(
  ref prog: Program,
  ref tm: TypedModule,
  declNode: ASTNode
): Vec<TypeId> propagates<disposable> {
  const symId = lookupOwnName(ref tm, declNode.name);
  if (symId == SYMBOL_NONE_ID) {
    return vec.vecNew(0);
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.GenericDecl { decl: d, sort: s }: {
      let info = genericAt(ref prog, d);
      return vec.vecFromArray(vec.vecAsArray(ref info.params));
    }
    default: { return vec.vecNew(0); }
  }
}

// Bind the parameters from `signature` and check the body against its return
// type. Shared by a function and a method, which differ only in where the
// signature was found.
function checkBodyAgainst(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode,
  signature: TypeId
): void {
  let retType: TypeId = TYPE_VOID_ID;
  let paramTypes: Vec<TypeId> = vec.vecNew(0);
  switch (typeAt(ref prog, signature)) {
    case Type.Func { params: p, ret: r, variadic: v, isAsync: fnAsync }: {
      retType = r;
      paramTypes = p;
    }
    default: { return; }
  }

  if (declNode.childD != 0) {
    // `?` needs the enclosing function's return type, and it can sit at any
    // depth of an expression - so the answer is ambient rather than threaded
    // through every expression helper. See the fields on Program. `await` is
    // the second question with exactly that shape, so it rides along: whether
    // THIS body may suspend comes off the signature, not off a second walk of
    // the kind prefixes.
    beginFunction(
      ref prog, declNode.name, retType,
      funcTypeIsAsync(ref prog, signature),
      declIsTaskBody(ref tm, declNode)
    );
    disposable scope: LocalScope = scopeNew();
    let cx: Cx = { prog: ref prog, tm: ref tm, ast: ref ast, scope: ref scope };
    bindParams(ref cx, declNode, ref paramTypes);
    checkBlock(ref cx, declNode.childD);
  }
}

// Parameters are locals the caller filled in. Their types come from the Func
// type pass C built, not from re-resolving the annotations, so the signature
// stays the single source of truth.
function bindParams(ref cx: Cx, declNode: ASTNode, ref paramTypes: Vec<TypeId>): void {
  if (declNode.childB == 0) {
    return;
  }
  const list = nodeAt(cx.ast, declNode.childB);
  let i: usize = 0;
  while (i < list.childCount) {
    const paramId = childAt(cx.ast, list, i);
    const paramNode = nodeAt(cx.ast, paramId);
    let t: TypeId = TYPE_ERROR_ID;
    if (i < paramTypes.len) {
      t = vec.vecGet(ref paramTypes, i);
    }
    // A `ref v: Vec<T>` parameter is `ref Vec<T>` in the SIGNATURE - that is
    // what makes passing a bare `v` an error - but the BODY sees a plain
    // `Vec<T>`, because a borrow IS the thing it borrows as far as the callee
    // is concerned. Unwrapping here is what keeps every read, write and field
    // access in the body from needing to know about references at all.
    const bound = derefType(cx.prog, t);
    // A parameter is a local COPY, so writing to it is ordinary. A `ref`
    // parameter is mutable too - that is the whole point of the borrow.
    //
    // The binding REMEMBERS which of the two it was, because the unwrapping is
    // not total: a name that is already a borrow may be forwarded into another
    // `ref T` slot with no second `ref` written, and by then `bound` no longer
    // says so. See `reborrowIfWanted`.
    let declared = true;
    if (bound != t) {
      declared = scopeDeclareRefParam(cx.scope, paramNode.name, bound);
    } else {
      declared = scopeDeclare(cx.scope, paramNode.name, bound, true);
    }
    if (!declared) {
      reportError(cx.prog, `parameter "${paramNode.name}" is declared more than once`, paramNode.sourceLoc);
    }
    // The DECORATION keeps the signature type: it is what codegen emits the
    // parameter as, and a `ref` parameter arrives as a pointer.
    vec.vecSet(ref cx.tm.resolvedTypes, paramId, t);
    i += 1;
  }
}
