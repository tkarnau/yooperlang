module typecheck;

// `@derive(display)`, as far as the bootstrap takes it today.
//
// The attribute PARSES and `declOf` unwraps it, so a decorated declaration is
// an ordinary one to every pass - which is what lets the eight derived types in
// the bootstrap's own source compile. What is NOT built is the expansion: the
// reference generates a `toString` from the field annotations, reparses it, and
// grafts it in (src/jsyoopderive/expand.js).
//
// Three things have to exist before that expansion can, and none of them did
// when this was measured:
//
//   1. Display dispatch in TEMPLATE INTERPOLATION. The generated body is
//      entirely template literals over the fields, and `${self.sourceLoc}`
//      interpolates a struct. Today `templatePartKind` calls anything that is
//      not a string, int or bool UNSUPPORTED, so the generated code would not
//      typecheck even if it were generated perfectly.
//   2. A way to reach `Display`. It lives in std/core/traits.yoop, which the
//      reference AUTOLOADS into every module graph; the bootstrap has no
//      autoload, and none of the deriving files import it.
//   3. The graft itself - splice a method into a decl's member run, merge the
//      implements clause, restamp source locations onto the decl.
//
// So the gap is recorded rather than half-built, and this file exists to make
// it say so at the one place a user would notice.

import * as map from "std/collections/map.yoop";
import * as str from "std/core/strings.yoop";
import { Option } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, nodeAt } from "../ast";

const DERIVE_ATTRIBUTE: string = "derive";

// Record a decorated type's NAME while pass A walks the top level.
//
// Keyed by name because pass A runs before anything is interned, and the only
// consumer is a diagnostic - a wrong answer here costs a less helpful message,
// never a wrong program.
export function recordDeriveDisplay(
  ref prog: Program,
  ref ast: AST,
  childId: NodeId,
  declNode: ASTNode
): void {
  const outer = nodeAt(ref ast, childId);
  if (outer.kind != ASTNodeKind.ATTRIBUTE) {
    return;
  }
  if (!str.stringEq(outer.name, DERIVE_ATTRIBUTE)) {
    return;
  }
  if (declNode.name.len == 0) {
    return;
  }
  map.mapInsert(ref prog.derivedDisplay, declNode.name, true);
}

// Whether a type is one of those, asked with a TypeId because that is what the
// interpolation check has. `formatType` spells a nominal type as its declared
// name, which is the key pass A recorded.
export function carriesDeriveDisplay(ref prog: Program, t: TypeId): bool {
  const name = formatType(ref prog, t);
  switch (map.mapGet(ref prog.derivedDisplay, name)) {
    case Option.Some { value: found }: { return found; }
    case Option.None: { return false; }
  }
}
