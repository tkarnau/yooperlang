module typecheck;

// The integer handles the whole typecheck layer passes around.
//
// Everything is interned in one of a few arenas on `Program` and referenced by
// index, never by a nested value. That is what replaces the JS reference's
// "reference-share a shell object and mutate it in a later pass": here a pass
// re-SETS an arena slot, and every holder of the id sees the new contents.
//
// Type equality is `id == id`, which is only sound because the interner is the
// single point that hands ids out.

export type TypeId   = usize;   // index into Program.types  (0 = none/error sentinel)
export type SymbolId = usize;   // index into Program.symbols
export type ModuleId = usize;   // index into Program.modules
export type DeclId   = usize;   // stable per-decl id for a generic origin (0 = none)
export type KindId   = usize;   // index into the kinds table (0 = none)
// NodeId lives in the ast module - decoration is keyed by it.

// Reserved low TypeIds, allocated once by initProgram in declaration order.
// Reserving them means the singletons compare by id without a lookup.
export const TYPE_ERROR_ID: TypeId   = 0;   // also the "no type yet" sentinel
export const TYPE_VOID_ID: TypeId    = 1;
export const TYPE_UNTYPED_INT_ID: TypeId = 2;

// A symbol id of 0 means "not found". SymbolId 0 is never handed out - see
// initProgram, which seeds the arena with a dead entry at index 0.
export const SYMBOL_NONE_ID: SymbolId = 0;
