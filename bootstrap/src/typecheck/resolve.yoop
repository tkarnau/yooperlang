module typecheck;

// Type ANNOTATION (a piece of syntax) -> TypeId (a resolved type).
//
// Primitive spellings are canonicalized here, exactly as the JS reference does:
// `int` is int32, `float` is float32, and the c_* aliases are their LP64
// widths. The arena never holds a raw name.

import * as str from "std/core/strings.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, nodeAt, kindName } from "../ast";

export function resolveTypeAnnotation(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  annotId: NodeId
): TypeId {
  if (annotId == 0) {
    return TYPE_VOID_ID;   // no annotation at all
  }
  const annot = nodeAt(ref ast, annotId);
  switch (annot.kind) {
    case ASTNodeKind.TYPE_ANNOTATION_REF_TYPE: {
      const inner = resolveTypeAnnotation(ref prog, ref tm, ref ast, annot.childA);
      return internType(ref prog, Type.Ref { inner: inner });
    }
    case ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME: {
      return resolveTypeName(ref prog, ref tm, annot);
    }
    default: {
      reportError(ref prog, `not a type annotation: ${kindName(annot.kind)}`, annot.sourceLoc);
      return TYPE_ERROR_ID;
    }
  }
}

function resolveTypeName(ref prog: Program, ref tm: TypedModule, annot: ASTNode): TypeId {
  if (isVoidName(annot.name)) {
    return TYPE_VOID_ID;
  }
  switch (primKindOfName(annot.name)) {
    case Option.Some { value: k }: {
      return primTypeId(k);
    }
    case Option.None: {
      // Not a primitive, so it has to be a name the module declared. Pass A
      // registered a shell for every one of those, which is why a forward
      // reference resolves here.
      switch (map.mapGet(ref tm.names, annot.name)) {
        case Option.Some { value: symId }: {
          return typeIdOfSymbol(ref prog, symId, annot);
        }
        case Option.None: {
          reportError(ref prog, `unknown type "${annot.name}"`, annot.sourceLoc);
          return TYPE_ERROR_ID;
        }
      }
    }
  }
}

function typeIdOfSymbol(ref prog: Program, symId: SymbolId, annot: ASTNode): TypeId {
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Struct { typeId: t }:    { return t; }
    case Symbol.VariantT { typeId: t }:  { return t; }
    case Symbol.Union { typeId: t }:     { return t; }
    case Symbol.ValueEnum { typeId: t }: { return t; }
    case Symbol.Trait { typeId: t }:     { return t; }
    case Symbol.Vtable { typeId: t }:    { return t; }
    default: {
      reportError(ref prog, `"${annot.name}" is not a type`, annot.sourceLoc);
      return TYPE_ERROR_ID;
    }
  }
}

// The canonical spellings. `void` is absent on purpose: it is the ABSENCE of a
// type annotation as far as the arena is concerned, handled by the caller.
function primKindOfName(name: string): Option<PrimKind> {
  if (str.stringEq(name, "int") || str.stringEq(name, "int32") || str.stringEq(name, "c_int")) {
    return Option.Some { value: PrimKind.INT32 };
  }
  if (str.stringEq(name, "int8")) { return Option.Some { value: PrimKind.INT8 }; }
  if (str.stringEq(name, "int16")) { return Option.Some { value: PrimKind.INT16 }; }
  if (str.stringEq(name, "int64") || str.stringEq(name, "c_long")) {
    return Option.Some { value: PrimKind.INT64 };
  }
  if (str.stringEq(name, "isize")) { return Option.Some { value: PrimKind.ISIZE }; }
  if (str.stringEq(name, "uint8")) { return Option.Some { value: PrimKind.UINT8 }; }
  if (str.stringEq(name, "uint16")) { return Option.Some { value: PrimKind.UINT16 }; }
  if (str.stringEq(name, "uint32")) { return Option.Some { value: PrimKind.UINT32 }; }
  if (str.stringEq(name, "uint64")) { return Option.Some { value: PrimKind.UINT64 }; }
  if (str.stringEq(name, "usize") || str.stringEq(name, "c_size_t")) {
    return Option.Some { value: PrimKind.USIZE };
  }
  if (str.stringEq(name, "float") || str.stringEq(name, "float32")) {
    return Option.Some { value: PrimKind.FLOAT32 };
  }
  if (str.stringEq(name, "float64")) { return Option.Some { value: PrimKind.FLOAT64 }; }
  if (str.stringEq(name, "bool")) { return Option.Some { value: PrimKind.BOOL }; }
  if (str.stringEq(name, "string")) { return Option.Some { value: PrimKind.STRING }; }
  return Option.None;
}

// `void` reads as an annotation but resolves to the Void singleton.
export function isVoidName(name: string): bool {
  return str.stringEq(name, "void");
}
