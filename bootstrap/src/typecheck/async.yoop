module typecheck;

// `async` and `await` - the COLORING half. Codegen's half is codegen/coro.yoop.
//
// `async` is not a keyword; it is an ordinary kind declared in
// std/core/kinds.yoop carrying one clause the compiler reads:
//
//     export kind async { appliesTo function; pausable; }
//     export kind task  { appliesTo function; pausable; provides Task; }
//
// `pausable` is what makes the function a COROUTINE, and the three rules below
// are what make a suspend always have somewhere to propagate to. They are the
// reference's rules, unchanged:
//
//   1. `await e` is legal only inside a function carrying a pausable kind.
//   2. `e` must be a CALL to a function carrying one.
//   3. Such a function must be called THROUGH `await` - a bare call is refused.
//
// Together, 2 and 3 make coloring checkable one call at a time: there is no way
// to reach an async function except from inside another one, so a frame that
// suspends always has a caller frame able to suspend with it. That is the whole
// reason the language has to know about `async` at all rather than leaving it
// to the runtime - `llvm.coro.suspend` suspends the CURRENT frame only.
//
// `task` is deliberately NOT built: a task's call site is a SPAWN onto the
// scheduler rather than an inline drive, which is a different mechanism with
// its own handle struct and runtime ABI. Refused by name in codegen.

import * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, nodeAt, childAt, kindName } from "../ast";

// Whether a decl's kind prefixes include one declaring `pausable`. `childE` is
// the KIND_PREFIX list; a decl with none carries 0 there.
//
// By NAME against the graph-wide kind registry, not through the symbol table:
// a kind prefix is not imported, so `async fetch(...)` in std/http names a kind
// declared in std/core/kinds.yoop with nothing linking the two files. An
// UNKNOWN name is refused separately, by checkFunctionKinds / checkMethodKinds
// - this one only answers the question.
export function declIsPausable(ref prog: Program, ref ast: AST, declNode: ASTNode): bool {
  if (declNode.childE == 0) {
    return false;
  }
  const list = nodeAt(ref ast, declNode.childE);
  let i: usize = 0;
  while (i < list.childCount) {
    const prefix = nodeAt(ref ast, childAt(ref ast, list, i));
    switch (lookupKind(ref prog, prefix.name)) {
      case Option.Some { value: info }: {
        if (info.pausable) {
          return true;
        }
      }
      case Option.None: { }
    }
    i += 1;
  }
  return false;
}

// There is no `declProvidesTask` twin here on purpose. The `provides Task`
// clause is read where the KIND is already in hand - checkFunctionKinds and
// checkMethodKinds walk the prefixes to refuse an unknown one anyway - so
// asking a second time would be a second walk for the same answer. This one
// exists because pass C's signature fill has the decl and not the kind.

// Whether a resolved signature is a coroutine's.
export function funcTypeIsAsync(ref prog: Program, funcType: TypeId): bool {
  switch (typeAt(ref prog, funcType)) {
    case Type.Func { params: p, ret: r, variadic: v, isAsync: a }: { return a; }
    default: { return false; }
  }
}

// RULE 3, asked of every call the checker types. The `awaited` half was taken
// from the ambient flag by checkExpr before the callee was even resolved, which
// is what keeps `await f(g())` from reading as "g is awaited": the flag is a
// one-step handoff and the arguments are checked after it has been consumed.
export function checkCallColoring(
  ref prog: Program,
  ref tm: TypedModule,
  expr: ASTNode,
  exprId: NodeId,
  funcType: TypeId,
  calleeName: string,
  awaited: bool
): void {
  if (!funcTypeIsAsync(ref prog, funcType)) {
    return;
  }
  map.mapInsert(ref tm.asyncCalls, uint64(exprId), true);
  if (!awaited) {
    reportError(
      ref prog,
      `"${calleeName}" carries a pausable kind, so it is a coroutine and has to be called through "await"`,
      expr.sourceLoc
    );
  }
}

// `await g(args)` - rules 1 and 2, then the result type.
//
// The operand is checked with NO expectation: a coroutine's return type is its
// own, and there is nothing an untyped literal would pin to from here.
export function checkAwait(
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  ref scope: LocalScope
): TypeId {
  // Rule 1. Ambient rather than threaded, for the same reason `?` reads the
  // enclosing return type that way: an `await` may sit at any depth of an
  // expression, and every helper in between would otherwise carry the flag.
  if (!prog.currentIsAsync) {
    reportError(
      ref prog,
      `"await" is only legal inside a function carrying a pausable kind such as \`async\`, and "${prog.currentFn}" carries none`,
      expr.sourceLoc
    );
  }
  const operand = nodeAt(ref ast, expr.childA);
  // Rule 2, the SYNTACTIC half. `await x` on a binding, or on anything that is
  // not a call, has no coroutine to drive - the reference refuses it for that
  // reason rather than treating it as a no-op.
  if (operand.kind != ASTNodeKind.CALL_EXPRESSION) {
    reportError(
      ref prog,
      `"await" takes a CALL to an async function, and this operand is ${kindName(operand.kind)}`,
      expr.sourceLoc
    );
    return TYPE_ERROR_ID;
  }
  // The handoff. Taken by the very next CALL_EXPRESSION checkExpr reaches,
  // which is this operand.
  prog.awaitPending = true;
  const resultType = checkExpr(ref prog, ref tm, ref ast, expr.childA, TYPE_ERROR_ID, ref scope);
  prog.awaitPending = false;
  // Rule 2, the TYPE half. `asyncCalls` was stamped by checkCallColoring, which
  // is the one place the callee's resolved signature is in hand.
  if (!map.mapContainsKey(ref tm.asyncCalls, uint64(expr.childA))) {
    reportError(
      ref prog,
      `"await" takes a call to a function carrying a pausable kind, and "${operand.name}" is an ordinary function - drop the "await"`,
      expr.sourceLoc
    );
  }
  return resultType;
}
