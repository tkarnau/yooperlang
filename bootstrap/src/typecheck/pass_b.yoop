module typecheck;

/*
  Pass B - wire imports.

  An import binds the SOURCE module's SymbolId under a local name in this
  module's namespace. Not a copy, not a redirect: the same integer. That is the
  whole design, and it buys three things at once.

    * Type identity is free. Equality is `id == id`, so an imported `Point` IS
      the declared `Point` - there is no second nominal type to reconcile.
    * Every later lookup is unchanged. `lookupOwnName` in pass C and pass D, and
      `resolveTypeName` for annotations, already read `tm.names`; none of them
      need to learn what an import is.
    * A shell imported before pass C fills it stays correct, because filling is
      `setType` on the arena slot the id already points at.

  The one thing a shared SymbolId cannot answer is which module has to DEFINE
  the symbol, which codegen needs to mangle a call. `tm.importedFrom` records
  that separately.

  What makes this a lookup rather than a second fixpoint is the TOPOLOGICAL
  order of the graph: every module an import can name sits earlier in the list,
  so its pass A has already run. Within one module the order is A then B, which
  is why an import colliding with a local declaration reads that way round.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Option } from "std/core/types.yoop";
import * as str from "std/core/strings.yoop";
import { AST, ASTNode, childAt, nodeAt } from "../ast";
import { Module, ImportEdge } from "../source_graph";

export function passBWireImports(
  ref prog: Program,
  ref tm: TypedModule,
  m: Module
): void {
  let f: usize = 0;
  while (f < m.files.len) {
    const file = vec.vecGet(ref m.files, f);
    beginFile(ref prog, file.absPath);
    let i: usize = 0;
    while (i < file.imports.len) {
      wireImport(ref prog, ref tm, m, vec.vecGet(ref file.imports, i));
      i += 1;
    }
    f += 1;
  }
  // A module that DERIVES Display needs the name whether or not it imported it.
  // Last thing in the pass, so a real import of the same name wins. See
  // derive.yoop.
  bindDerivedDisplayTrait(ref prog, ref tm, m);
}

// The source module's TypedModule is read out of `prog.modules` by the index
// the graph walk recorded. Topological order is what guarantees it is there:
// a module's imports are loaded, and registered, before the module itself.
function wireImport(ref prog: Program, ref tm: TypedModule, m: Module, edge: ImportEdge): void {
  const decl = nodeAt(ref m.ast, edge.nodeId);
  if (edge.resolvedModuleIndex >= prog.modules.len) {
    reportError(
      ref prog,
      `internal: module ${edge.resolvedModuleId} is not registered yet`,
      decl.sourceLoc
    );
    return;
  }
  let source = vec.vecGet(ref prog.modules, edge.resolvedModuleIndex);

  // The namespace clause, when there is one. A combined import
  // (`import { A }, * as ns from ...`) carries BOTH, so this is not an
  // either/or with the specifier loop below.
  if (decl.name.len > 0) {
    bindNamespace(ref prog, ref tm, decl, edge.resolvedModuleIndex);
  }

  const fromStd = str.stringStartsWith(vec.vecGet(ref m.ast.strings, decl.strId), "std/");
  let s: usize = 0;
  while (s < decl.childCount) {
    const spec = nodeAt(ref m.ast, childAt(ref m.ast, decl, s));
    bindImportedName(ref prog, ref tm, ref source, ref m.ast, spec, fromStd);
    s += 1;
  }
}

// `import * as ns from "..."` binds ONE name to the whole module.
//
// A namespace symbol names the module by INDEX rather than copying its export
// table, so `ns.thing` is resolved at the use site against whatever that module
// exports - and an export added later needs nothing done here.
// A directory module's files EACH import what they use, so one alias is bound
// once per file that mentions it - `vec` twenty times in codegen. Re-binding it
// to the same module is the same import written again and is a no-op; binding
// it to a DIFFERENT module is the real mistake and stays refused.
//
// The line is where the reference draws it, established by probing: two files
// of one module may both write `import * as u from "./a.yoop"`, and may not
// write `* as u` for two different sources. So an import is not file-SCOPED -
// it is module-scoped and idempotent.
//
// The membership check comes before interning, because a symbol interned for a
// duplicate would be dead weight nothing ever names.
function bindNamespace(
  ref prog: Program,
  ref tm: TypedModule,
  decl: ASTNode,
  sourceIndex: ModuleId
): void {
  switch (map.mapGet(ref tm.names, decl.name)) {
    case Option.Some { value: existing }: {
      // Comparing SymbolIds would not do: every `import * as ns` interns its
      // OWN Namespace symbol, so two identical imports never share one. The
      // module index is the thing that says they mean the same import.
      switch (symbolAt(ref prog, existing)) {
        case Symbol.Namespace { module: mi }: {
          if (mi == sourceIndex) {
            return;
          }
        }
        default: { }
      }
      reportError(
        ref prog,
        `imported namespace "${decl.name}" collides with an existing declaration in this module`,
        decl.sourceLoc
      );
      return;
    }
    case Option.None: { }
  }
  const symId = internSymbol(ref prog, Symbol.Namespace { module: sourceIndex });
  map.mapInsert(ref tm.names, decl.name, symId);
}

// One `{ a }` or `{ a as b }` specifier: `spec.name` is the local name, and the
// export name is in the arena's string pool (see ast/slots.yoop).
function bindImportedName(
  ref prog: Program,
  ref tm: TypedModule,
  ref source: TypedModule,
  ref ast: AST,
  spec: ASTNode,
  fromStd: bool
): void {
  const exportName = vec.vecGet(ref ast.strings, spec.strId);

  let symId: SymbolId = SYMBOL_NONE_ID;
  switch (map.mapGet(ref source.exports, exportName)) {
    case Option.Some { value: found }: { symId = found; }
    case Option.None: {
      // A name the source module declares but does not export gets its own
      // message: "has no export X" would send the reader looking for a typo in
      // a name that is right there.
      if (lookupOwnName(ref source, exportName) != SYMBOL_NONE_ID) {
        reportError(
          ref prog,
          `"${exportName}" is declared in module ${source.moduleId} but not exported - add \`export\` to its declaration`,
          spec.sourceLoc
        );
      } else {
        reportError(
          ref prog,
          `module ${source.moduleId} has no export "${exportName}"`,
          spec.sourceLoc
        );
      }
      return;
    }
  }

  // std VALUES must come through a namespace. Common function names - `info`,
  // `error`, `panic`, `get` - would otherwise compete with the user's own
  // identifiers, and `log.error(...)` says where it came from at every call
  // site. Types are exempt: they are capitalized, there are far fewer of them,
  // and `Vec` reads worse as `vec.Vec`. Same rule, same reasoning, as
  // src/jsyooptypecheck/imports.js.
  if (fromStd && isValueSymbol(ref prog, symId)) {
    reportError(
      ref prog,
      `imports of value "${exportName}" from std must use the namespace form: write \`import * as <ns> from "..."\` and call as \`<ns>.${exportName}(...)\``,
      spec.sourceLoc
    );
    return;
  }

  // The same idempotence a namespace gets, and for the same reason: two files
  // of one directory module both writing `import { Vec }` is one import, not a
  // redeclaration. Here the SymbolId settles it directly - an import binds the
  // source module's own id, so the same export reached twice is the same
  // integer, and a different one really is a different thing under one name.
  switch (map.mapGet(ref tm.names, spec.name)) {
    case Option.Some { value: existing }: {
      if (existing == symId) {
        return;
      }
      reportError(
        ref prog,
        `imported name "${spec.name}" collides with an existing declaration in this module`,
        spec.sourceLoc
      );
      return;
    }
    case Option.None: { }
  }
  map.mapInsert(ref tm.names, spec.name, symId);
  map.mapInsert(ref tm.importedFrom, spec.name, {
    moduleId: source.moduleId,
    exportName: exportName,
  });
}
