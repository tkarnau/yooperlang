module typecheck;

// Names visible inside one function body, as a stack of blocks.
//
// It became a stack when `if` and `while` arrived: a name declared inside a
// branch must not be visible after the branch closes, or
// `if (c) { const a = 1; } return a;` would typecheck against a slot that only
// exists on one path.
//
// Shadowing an OUTER name is ALLOWED, and redeclaring one in the SAME block is
// not. That is the reference's rule: `let v = 7; if (c) { let v = 99; }` is two
// bindings and the outer one snaps back after the branch, while a second `let v`
// beside the first is "redeclaration of v". The two questions are different -
// one is a nested scope, the other is one scope contradicting itself - so the
// declare test reads the TOP block and the lookup walks the whole stack.
//
// A binding carries MUTABILITY as well as a type, because `const a = 1; a = 2;`
// has to be refused and the type alone cannot say so. It rides here rather than
// in a second table so there is one source of truth per name - a separate
// mutability map would be a thing to forget to update at a new declare site.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { disposable, Disposable } from "std/core/kinds.yoop";
import { Option } from "std/core/types.yoop";


// What a name in scope resolves to.
export type Binding {
  typeId: TypeId,
  // False for `const`, a for-in loop variable, and a pattern binding. True for
  // `let` and for parameters - a parameter is a local copy, so writing to it is
  // ordinary, and the reference agrees.
  mutable: bool,
  // True when the name arrived as a `ref T` PARAMETER. `typeId` is the plain
  // `T` the body sees, so this is the only record left that the name is already
  // a borrow - which is what lets it be forwarded into another `ref T` slot
  // with no second `ref` written. See `reborrowIfWanted` in pass_d.yoop.
  refParam: bool,
  // True when the name was declared with a kind stating `mustNotEscape scope`.
  // The bound is about THIS binding rather than about its type - the same type
  // is unbounded under a plain `let` - so the scope entry is the only place it
  // can be recorded. Read by typecheck/kind_use.yoop, which owns both rules
  // that enforce it.
  noEscape: bool,
  // The CLEARANCE markers the binding's annotation and prefixes declare, as the
  // two bitmasks typecheck/markers.yoop compares. `markKnown` is false until
  // something establishes them, and an unknown set satisfies every bound - see
  // the permissiveness note at the top of that file. They ride here rather than
  // in a side map for the reason `noEscape` does: the answer is about the
  // BINDING, and the same type under a different annotation carries different
  // markers.
  markConf: uint64,
  markRestr: uint64,
  markKnown: bool,
}

export type LocalScope propagates<disposable> {
  blocks: Vec<Map<string, Binding>>,
  // How many loops enclose the statement being checked. `break` and `continue`
  // are only legal when this is non-zero, and it rides here because it answers
  // the same question the block stack does: where am I in this body.
  loopDepth: usize,
  // How many SWITCH arms enclose it. A switch is a BREAKABLE scope - `break`
  // leaves the switch - so `break` is legal when either depth is non-zero. It
  // is a separate counter rather than a bump of `loopDepth` because the two
  // jumps are not symmetric: `continue` keeps targeting the enclosing LOOP and
  // a switch supplies none, so `continue` reads `loopDepth` alone.
  switchDepth: usize,
}

// Annotated rather than inline: `V` is not inferable from `stringKeyOps()`
// alone and there is no turbofish.
function newBlock(): Map<string, Binding> propagates<disposable> {
  let b: Map<string, Binding> = map.mapNew(0, map.stringKeyOps());
  return b;
}

export function scopeNew(): LocalScope propagates<disposable> {
  let blocks: Vec<Map<string, Binding>> = vec.vecNew(4);
  vec.vecPush(ref blocks, newBlock());
  return { blocks: blocks, loopDepth: 0, switchDepth: 0 };
}

export function scopePush(ref s: LocalScope): void {
  vec.vecPush(ref s.blocks, newBlock());
}

// std/core/vec.yoop has no `vecPop`, so the block map is disposed by hand
// before the length is dropped. Without that the map's storage would leak once
// per block, which is a lot of blocks over a compile.
export function scopePop(ref s: LocalScope): void {
  if (s.blocks.len <= 1) {
    return;
  }
  let top = vec.vecGet(ref s.blocks, s.blocks.len - 1);
  Disposable.dispose(ref top);
  s.blocks.len -= 1;
}

// False when the name is already declared in THIS block. An enclosing block's
// binding is shadowed rather than refused. The caller turns the false into the
// diagnostic, since only it has the location.
export function scopeDeclare(
  ref s: LocalScope,
  name: string,
  typeId: TypeId,
  mutable: bool
): bool {
  return scopeDeclareBinding(ref s, name,
    { typeId: typeId, mutable: mutable, refParam: false, noEscape: false,
      markConf: 0, markRestr: 0, markKnown: false });
}

// The same, for a binding whose kind bounds it to the declaring scope. Separate
// for the reason `scopeDeclareRefParam` is: one caller asks, and every other
// declaration would have to write `false` for a question it never poses.
export function scopeDeclareBound(
  ref s: LocalScope,
  name: string,
  typeId: TypeId,
  mutable: bool
): bool {
  return scopeDeclareBinding(ref s, name,
    { typeId: typeId, mutable: mutable, refParam: false, noEscape: true,
      markConf: 0, markRestr: 0, markKnown: false });
}

// The same, for a name that arrived as a `ref T` PARAMETER. Separate rather
// than a fourth argument on `scopeDeclare` because exactly one call site in the
// whole checker declares one, and every other declaration would have to write
// `false` for a question it never asks.
export function scopeDeclareRefParam(
  ref s: LocalScope,
  name: string,
  typeId: TypeId
): bool {
  return scopeDeclareBinding(ref s, name,
    { typeId: typeId, mutable: true, refParam: true, noEscape: false,
      markConf: 0, markRestr: 0, markKnown: false });
}

// Stamp the clearance markers onto a name THIS block just declared. Separate
// from the declare calls because only two of the six sites can answer - a
// parameter and a `let` / `const` read them off an annotation, while a pattern
// binding, a loop variable and a `?` handler binding have no annotation to read
// and are left unknown on purpose. See typecheck/markers.yoop.
export function scopeSetMarkers(ref s: LocalScope, name: string, m: MarkerSet): void {
  let top = vec.vecGet(ref s.blocks, s.blocks.len - 1);
  switch (map.mapGet(ref top, name)) {
    case Option.Some { value: existing }: {
      let updated = existing;
      updated.markConf = m.conf;
      updated.markRestr = m.restr;
      updated.markKnown = m.known;
      map.mapInsert(ref top, name, updated);
      vec.vecSet(ref s.blocks, s.blocks.len - 1, top);
    }
    case Option.None: { }
  }
}

function scopeDeclareBinding(ref s: LocalScope, name: string, b: Binding): bool {
  let top = vec.vecGet(ref s.blocks, s.blocks.len - 1);
  switch (map.mapGet(ref top, name)) {
    case Option.Some { value: existing }: { return false; }
    case Option.None: {
      map.mapInsert(ref top, name, b);
      vec.vecSet(ref s.blocks, s.blocks.len - 1, top);
      return true;
    }
  }
}

// The whole binding. Only the assignment check wants this; everything else
// wants the type, and scopeLookup below keeps giving it that.
export function scopeBinding(ref s: LocalScope, name: string): Option<Binding> {
  let i = s.blocks.len;
  while (i > 0) {
    i -= 1;
    let b = vec.vecGet(ref s.blocks, i);
    switch (map.mapGet(ref b, name)) {
      case Option.Some { value: bound }: { return Option.Some { value: bound }; }
      case Option.None: { }
    }
  }
  return Option.None;
}

// Innermost block first.
export function scopeLookup(ref s: LocalScope, name: string): Option<TypeId> {
  switch (scopeBinding(ref s, name)) {
    case Option.Some { value: bound }: { return Option.Some { value: bound.typeId }; }
    case Option.None: { }
  }
  return Option.None;
}
