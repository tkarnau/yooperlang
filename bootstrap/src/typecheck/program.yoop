module typecheck;

// The whole-program typecheck state, and the interners that grow it.
//
// Types and symbols are interned ONCE across the program, so a TypeId or a
// SymbolId means the same thing in every module. Per-module name maps point
// into the shared `symbols` arena, which is what reduces an import to a name
// binding rather than a table merge.
//
// Diagnostics are accumulated here rather than returned as a Result: the point
// of the typecheck layer is to report every error in one run.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Option } from "std/core/types.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Diagnostic, SourceLocation, errorAt } from "../diagnostics";
import { NodeId } from "../ast";

// One entry of TypedModule.importedFrom. Both halves are needed to name the
// symbol an imported call lands on: `import { tag as mathTag }` binds
// `mathTag` in this module and still has to call the `tag` that mathx defines.
@derive(display)
export type ImportOrigin {
  moduleId: string,     // the DEFINING module's mangling id
  exportName: string,   // the name it is declared under THERE
}

// Per-module typecheck state, indexed positionally by ModuleId (parallel to the
// driver's module list). This does NOT own the module's AST - the ModuleGraph
// does; decoration references nodes by NodeId (decision D2), so codegen reads
// the AST from the graph and the resolved types from here, correlated by index.
@derive(display)
export type TypedModule propagates<disposable> {
  moduleId: string,               // stable id copied from Module.id; mangling basis
  names: Map<string, SymbolId>,   // the one symbol namespace (replaces the 13 JS tables)
  exports: Map<string, SymbolId>, // the exported subset of `names`
  // Where an imported name came from, keyed by the LOCAL name. Pass B fills it;
  // a name absent from it belongs to this module. It exists because an import
  // binds the source module's SymbolId directly - which is what makes an
  // imported type compare equal to the original - and a shared SymbolId cannot
  // say which module has to define the symbol codegen calls.
  importedFrom: Map<string, ImportOrigin>,
  // Names declared in an `extern` block. Their symbol IS the linker's spelling,
  // so codegen must not mangle them - and it cannot tell from the Symbol, which
  // is an ordinary `Symbol.Func`.
  // `import.unsafe;` at the top of a file in this module. Raw pointers are
  // gated on it, so the flag has to travel from the PROGRAM node to the passes
  // that resolve `unsafe_ptr`.
  unsafeAllowed: bool,
  externNames: Map<string, bool>,
  // Functions carrying a PAUSABLE kind (`async fetch(...)`, `task worker(...)`).
  // They are coroutines, and the bootstrap has no coroutine lowering - so
  // codegen refuses them by name rather than emitting an ordinary function that
  // silently never suspends. Recorded here because the Symbol cannot say: a
  // pausable function is an ordinary `Symbol.Func`, the same way an extern is.
  pausableNames: Map<string, bool>,
  // The same, for METHODS, keyed by the METHOD_DECL's NodeId. A method's name is
  // not unique in a module - two types may each declare `read`, and a plain
  // function may be called `read` as well - so the name table cannot hold them.
  pausableMethods: Map<uint64, bool>,
  // The subset of the two above whose kind also `provides Task` - a `task`
  // body. Those are coroutines like every other pausable function, but their
  // CALL SITE is a spawn onto the scheduler rather than an inline drive, so
  // emitting the coroutine without the spawn would compile and never run.
  // Refused by name in codegen; see codegen/coro.yoop.
  taskNames: Map<string, bool>,
  taskMethods: Map<uint64, bool>,
  // CALL nodes whose callee is ASYNC. Two readers, which is why it is a
  // decoration rather than a question asked twice: pass D uses it for the
  // coloring rules (an async call outside an `await`, an `await` on an
  // ordinary call), and CODEGEN uses it to emit the coroutine ABI at the call -
  // an extra `ptr` result slot argument and a `ptr` handle back.
  // Sparse and keyed by `uint64(nodeId)`, like the other call decorations.
  asyncCalls: Map<uint64, bool>,
  // Call nodes whose callee is a VALUE - a function-typed struct field - rather
  // than a name. Codegen reads the field and calls through it; without this it
  // would look for a symbol named after the field and emit `call @hash`.
  // Sparse and keyed by `uint64(nodeId)`, like the other call decorations.
  indirectCalls: Map<uint64, bool>,
  // The three VTABLE decorations, all keyed by the CALL node and all recording
  // something only pass D could establish. `vtableBuilds` is which CONCRETE
  // type a `VT.from(ref x)` erases, so codegen knows whose method symbols to
  // store; `vtableFromFns` marks the shim form, whose slots hold generated
  // ctx-dropping wrappers around named functions; `vtableSlots` is the SLOT
  // INDEX of a dispatch, which is a property of the vtable's declaration order
  // and not of the call. See typecheck/vtable.yoop.
  vtableBuilds: Map<uint64, TypeId>,
  vtableFromFns: Map<uint64, bool>,
  vtableSlots: Map<uint64, usize>,
  // Expression nodes whose `ref T` value is consumed as a plain `T` - a borrow
  // OPENED because the position wanted the thing rather than the borrow. Pass D
  // is the only layer that can say so, because the answer is "what did the
  // context expect", and codegen turns each one into exactly one load.
  // Sparse and keyed by `uint64(nodeId)`, like the other node decorations.
  //
  // Only the EXPECTATION-driven conversions are in here (an argument, an
  // initializer, an assigned value, a returned value). A field or index BASE is
  // not, because there codegen already knows whether it wants the value or the
  // address, and a write wants the address - see `emitFieldAddress`.
  derefUses: Map<uint64, bool>,
  // The MIRROR of derefUses: IDENT nodes naming a `ref T` parameter in a
  // position that wanted the `ref T` rather than the `T` the body sees. The
  // body's view is a plain `T`, so the node would otherwise emit a load of the
  // borrowed object; codegen instead hands on the incoming pointer itself.
  // Sparse and keyed by `uint64(nodeId)`. A node is never in BOTH maps - one
  // asks for a load and the other asks for none.
  reborrowUses: Map<uint64, bool>,
  // TRY_OP nodes whose Err payload has to be CONVERTED on the way out - the
  // operand's error implements `Into<TargetErr>` and the two payload types
  // differ. Codegen calls the `into` method in the failure branch; it could
  // compare the two types itself, but "these differ" and "these differ and a
  // conversion exists" are different facts and only pass D established the
  // second. Sparse and keyed by `uint64(nodeId)`.
  tryIntoUses: Map<uint64, bool>,
  // TRY_OP nodes carrying a context string (`f()? "loading config"`) whose two
  // Err payloads are both `string`, so the note is CONCATENATED rather than
  // handed to a `WithContext` impl. Presence of the context expression is on
  // the node; this map is only which of the two shapes pass D picked, and it is
  // recorded for the same reason `tryIntoUses` is - codegen could compare the
  // types itself, but "both are strings" and "both are strings and that is why
  // no impl was looked for" are different facts. Sparse, keyed by
  // `uint64(nodeId)`.
  tryContextConcat: Map<uint64, bool>,
  // The intrinsic names THIS module declared, as opposed to `Program.intrinsics`
  // which is every one in the graph. Both are needed and they answer different
  // questions: the program-level one says "this name IS an intrinsic somewhere",
  // and this one says "an unqualified call to it here means that intrinsic".
  //
  // Without the second, a module declaring an ordinary function that happens to
  // share a name with one has its own calls lowered as the intrinsic -
  // std/tls/ffi.yoop declares `ctxFree(ref c: TlsCtx)` and got the allocator's
  // `ctxFree<T>(a: T[])` emitted for it, which is invalid IR at best and a
  // silent miscompile whenever the shapes happen to line up.
  intrinsicNames: Map<string, bool>,
  resolvedTypes: Vec<TypeId>,     // dense decoration, indexed by NodeId (0 = none / infer-later)
  // (exit site, binding) pairs saying "this binding's scope-end call was
  // already made by hand on every path reaching that exit". Codegen skips the
  // matching pending disposal, which is what keeps a hand-written
  // `Disposable.dispose(ref c)` from being followed by a second one at the
  // closing brace. See discharge.yoop; a LIST rather than a map because the
  // answer is empty for whole modules at a time.
  discharges: Vec<Discharge>,
  // Which monomorphized function a CALL node resolved to, when the callee was
  // generic. Sparse, because most calls are not - the shape program.yoop's
  // header describes for exactly this kind of decoration.
  // Keyed by `uint64(nodeId)`: std/collections/map has no usize KeyOps, and
  // usize and uint64 are distinct types even where they are the same width.
  calleeInstance: Map<uint64, usize>,
  // Which TYPE a trait-method call resolved its receiver to, keyed the same
  // way. Codegen needs it to name the symbol: `Display.toString(ref p)` becomes
  // `@m__Point__toString`, and only the receiver's type says which Point.
  calleeReceiver: Map<uint64, TypeId>,
  allowsUnsafe: bool,
  // Sparse decorations (calleeMangled, genericInstances, castTargets, ...) are
  // added as Map<NodeId, T> slots here when the checker needs them.
}

@derive(display)
export type Program propagates<disposable> {
  types: Vec<Type>,             // interned; indexed by TypeId (low ids reserved for singletons)
  symbols: Vec<Symbol>,         // interned; indexed by SymbolId
  modules: Vec<TypedModule>,    // by ModuleId; parallel to the driver's modules
  diagnostics: Vec<Diagnostic>,
  // Generic decls, by DeclId, and the (origin, args) instances of them. See
  // generics.yoop - the whole reason both live on Program is that instantiation
  // is TypeId arithmetic and must not need an AST.
  generics: Vec<GenericDeclInfo>,
  instances: Vec<Instance>,
  // Monomorphized generic FUNCTIONS. Separate from `instances` because they
  // produce a symbol rather than a type, and codegen walks them to decide what
  // bodies to emit.
  funcInstances: Vec<FuncInstance>,
  // The type-parameter names in scope while a generic decl's body is resolved.
  // Ambient for the same reason `currentFile` is; `beginTypeParams` is the one
  // writer.
  typeParams: Map<string, TypeId>,
  // The source file every pass below is currently walking, stamped onto each
  // diagnostic by `reportError`. Ambient rather than threaded because the
  // alternative is a `filePath` parameter on forty call sites that all want the
  // same answer - and because it has exactly one writer, `walkFile`.
  currentFile: string,
  // The function pass D is currently inside: its declared return type, and its
  // name for the diagnostic. Only `?` reads them, and it needs both - the
  // return type to check the Err against, the name to say whose it is.
  //
  // Ambient for the same reason `currentFile` is. The alternative was threading
  // the return type through `checkExpr`, and `?` can sit at any depth of an
  // expression, so that is a new parameter on every one of pass D's expression
  // helpers to answer a question all but one of them ignore. `beginFunction` is
  // the one writer.
  currentReturn: TypeId,
  currentFn: string,
  // Whether the body being checked belongs to a function carrying a PAUSABLE
  // kind. Ambient for the same reason `currentReturn` is: an `await` may sit at
  // any depth of an expression, so threading the flag would mean adding a
  // parameter to every expression helper between here and there.
  currentIsAsync: bool,
  // Whether that same body is a `task` body specifically - the subset of the
  // above whose kind also `provides Task`. One question reads it: `wait` is
  // refused inside a task body, because blocking a worker there is the thing
  // coroutines exist to avoid. `async` alone is not enough to refuse on - std's
  // `awaitTask` is async and ends in a `wait`.
  currentIsTask: bool,
  // Set by `await` immediately before its operand is checked, and taken by the
  // very next CALL_EXPRESSION that reaches checkExpr - which is that operand.
  // One bool rather than a node id because the handoff is exactly one step: a
  // call in an ARGUMENT is checked after the flag has already been taken, so
  // `await f(g())` awaits f and not g.
  awaitPending: bool,
  // The same flag, after the CALL took it: "this call is the operand of an
  // `await`". Separate from `awaitPending` because the two live for different
  // spans - the first for exactly one step, the second for the whole of one
  // call's checking, saved and restored around any call nested in an argument.
  callWasAwaited: bool,
  // Every `kind` declared anywhere in the graph, by NAME.
  //
  // Ambient rather than scoped, because a kind prefix is reached by name and
  // not through an import - `async fetch(...)` in std/http names a kind
  // declared in std/core/kinds.yoop with nothing linking the two files. The JS
  // reference has the same registry for the same reason.
  kinds: Map<string, KindInfo>,
  // Type names carrying `@derive(display)`, anywhere in the graph. The
  // attribute parses and is unwrapped, but generating its `toString` is not
  // built yet, so this exists purely so the refusal can say WHY a type that
  // looks printable is not - see the template-interpolation check in pass D.
  // Keyed by name rather than TypeId because pass A records it before any type
  // is interned.
  derivedDisplay: Map<string, bool>,
  // Names declared in an `extern "intrinsic"` block, anywhere in the graph.
  //
  // Program-level for the same reason `kinds` is: an intrinsic is identified by
  // NAME, and the module that CALLS `intr.stringAsBytes` is not the one that
  // declared it. Codegen lowers each call to instructions rather than emitting
  // a call, which is also why these are deliberately never in `externNames`.
  intrinsics: Map<string, bool>,
  // Function SYMBOLS whose kind `provides Task` - a `task` body. Program-level
  // and keyed by SymbolId rather than per-module and keyed by name, because the
  // question is asked at a CALL site in a module that may not be the one that
  // declared it. See the task-spawn carve-out in checkAgainstSignature.
  taskSymbols: Map<uint64, bool>,
  // registry: InstantiationRegistry - deferred until generics land in the bootstrap.
}

@derive(display)
// What the bootstrap understands about a declared kind, which is one clause.
//
// `pausable` is the clause that changes CODEGEN: a function carrying a pausable
// kind is a coroutine, and emitting it as an ordinary function would be a
// silent miscompile rather than a missing feature. Every other clause is
// recorded by the parser and read by nobody, because nothing enforces kinds.
export type KindInfo {
  name: string,
  pausable: bool,
  // `provides Task;` - the clause that makes a CALL to the function evaluate to
  // `Task<T>` rather than to T, which is the whole difference between `task`
  // and `async`. Both are pausable, so `pausable` alone cannot tell them apart,
  // and the two lower completely differently: an `async` call is driven inline
  // by `await`, a `task` call is a SPAWN. The bootstrap builds the first and
  // refuses the second by name.
  providesTask: bool,
  // `mustCall dispose beforeScopeEnd;` - the method a binding carrying this
  // kind gets called on it when its scope ends, or "" for a kind that asks for
  // nothing. This is the clause that makes a kind MEAN something at run time:
  // every other one is recorded and read by nobody.
  disposeMethod: string,
  // `refcounted retain release;` - the clause on `pooled`. A binding carrying
  // it holds a REFCOUNTED handle, so its storage is the heap and its scope end
  // is a release rather than a call. Read together with `disposeMethod` by
  // task.yoop, which is the one place either clause means something on a
  // `Task<T>`: a task handle is a compiler type with no methods at all, so the
  // compiler is the only thing that can supply what these two ask for.
  refcounted: bool,
  // `appliesTo region;` rather than `binding`. A region kind can be written
  // anonymously in front of a block (`ephemeral arenaScope(N) { ... }`); a
  // binding kind must be given a name.
  appliesToRegion: bool,
}

// Announce which file the pass is about to walk. Every pass that iterates
// `m.files` calls this first; a diagnostic raised outside one carries "".
export function beginFile(ref prog: Program, absPath: string): void {
  prog.currentFile = absPath;
}

// The function whose body pass D is about to walk. Paired with `currentFile`
// and set for the same reason - see the fields on Program.
export function beginFunction(
  ref prog: Program,
  name: string,
  retType: TypeId,
  isAsync: bool,
  isTask: bool
): void {
  prog.currentFn = name;
  prog.currentReturn = retType;
  prog.currentIsAsync = isAsync;
  prog.currentIsTask = isTask;
  prog.awaitPending = false;
  prog.callWasAwaited = false;
}

// The reserved singletons are pushed here, in the order ids.yoop declares them.
// Anything that changes this order has to change those constants too.
export function initProgram(): Program propagates<disposable> {
  let types: Vec<Type> = vec.vecNew(24);
  vec.vecPush(ref types, Type.ErrorT);      // TYPE_ERROR_ID
  vec.vecPush(ref types, Type.Void);        // TYPE_VOID_ID
  vec.vecPush(ref types, Type.UntypedInt);  // TYPE_UNTYPED_INT_ID
  vec.vecPush(ref types, Type.UntypedNull); // TYPE_UNTYPED_NULL_ID

  // PRIM_TYPE_BASE onward, in PrimKind declaration order. primTypeId() indexes
  // straight into this run, so the order here IS the contract.
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.INT8 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.INT16 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.INT32 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.INT64 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.ISIZE });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.UINT8 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.UINT16 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.UINT32 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.UINT64 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.USIZE });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.FLOAT32 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.FLOAT64 });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.BOOL });
  vec.vecPush(ref types, Type.Prim { prim: PrimKind.STRING });

  // SymbolId 0 must never be a real symbol, so a "not found" 0 stays
  // unambiguous. Burn index 0 on a dead entry.
  let symbols: Vec<Symbol> = vec.vecNew(8);
  vec.vecPush(ref symbols, Symbol.Value { typeId: TYPE_ERROR_ID, intVal: 0 });

  let typeParams: Map<string, TypeId> = map.mapNew(0, map.stringKeyOps());
  let kinds: Map<string, KindInfo> = map.mapNew(0, map.stringKeyOps());
  let taskSymbols: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let intrinsics: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let derivedDisplay: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let prog: Program = {
    types: types,
    symbols: symbols,
    modules: vec.vecNew(0),
    diagnostics: vec.vecNew(0),
    generics: vec.vecNew(4),
    instances: vec.vecNew(4),
    funcInstances: vec.vecNew(4),
    typeParams: typeParams,
    currentFile: "",
    currentReturn: TYPE_ERROR_ID,
    currentIsAsync: false,
    currentIsTask: false,
    awaitPending: false,
    callWasAwaited: false,
    currentFn: "",
    kinds: kinds,
    taskSymbols: taskSymbols,
    derivedDisplay: derivedDisplay,
    intrinsics: intrinsics,
  };
  initGenerics(ref prog);   // burns DeclId 0
  return prog;
}

export function initTypedModule(moduleId: string): TypedModule propagates<disposable> {
  // Annotated rather than inline: `V` is not inferable from stringKeyOps alone
  // and there is no turbofish.
  let names: Map<string, SymbolId> = map.mapNew(0, map.stringKeyOps());
  let exports: Map<string, SymbolId> = map.mapNew(0, map.stringKeyOps());
  let importedFrom: Map<string, ImportOrigin> = map.mapNew(0, map.stringKeyOps());
  let calleeInstance: Map<uint64, usize> = map.mapNew(0, map.uint64KeyOps());
  let externNames: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let pausableNames: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let pausableMethods: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let taskNames: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let taskMethods: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let asyncCalls: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let indirectCalls: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let vtableBuilds: Map<uint64, TypeId> = map.mapNew(0, map.uint64KeyOps());
  let vtableFromFns: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let vtableSlots: Map<uint64, usize> = map.mapNew(0, map.uint64KeyOps());
  let derefUses: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let reborrowUses: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let tryIntoUses: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let tryContextConcat: Map<uint64, bool> = map.mapNew(0, map.uint64KeyOps());
  let intrinsicNames: Map<string, bool> = map.mapNew(0, map.stringKeyOps());
  let calleeReceiver: Map<uint64, TypeId> = map.mapNew(0, map.uint64KeyOps());
  return {
    moduleId: moduleId,
    names: names,
    exports: exports,
    importedFrom: importedFrom,
    unsafeAllowed: false,
    externNames: externNames,
    pausableNames: pausableNames,
    pausableMethods: pausableMethods,
    taskNames: taskNames,
    taskMethods: taskMethods,
    asyncCalls: asyncCalls,
    indirectCalls: indirectCalls,
    vtableBuilds: vtableBuilds,
    vtableFromFns: vtableFromFns,
    vtableSlots: vtableSlots,
    derefUses: derefUses,
    reborrowUses: reborrowUses,
    tryIntoUses: tryIntoUses,
    tryContextConcat: tryContextConcat,
    intrinsicNames: intrinsicNames,
    calleeInstance: calleeInstance,
    calleeReceiver: calleeReceiver,
    resolvedTypes: vec.vecNew(0),
    discharges: vec.vecNew(0),
    allowsUnsafe: false,
  };
}

/*
  Interning

  Interning might not be familiar from outside systems work, but it is the same
  idea as JS Symbol: hand out one unique, shared handle for a value so everyone
  downstream compares handles instead of contents.

  STRUCTURAL types have to deduplicate, because type equality is `id == id`.
  Two separate `int[]` annotations that interned to two different TypeIds would
  compare unequal, and passing one to a function expecting the other would be a
  spurious error. `internArray` / `internRef` below scan for an existing entry
  first; nominal types need none of this, since they are unique by decl.

  A linear scan is fine at this scale (a few hundred types in the whole
  program). If it ever is not, the fix is a side map from shape to TypeId, not a
  change to the equality rule.
*/

export function internType(ref prog: Program, t: Type): TypeId {
  vec.vecPush(ref prog.types, t);
  return prog.types.len - 1;
}

// One TypeId per distinct element type, so `int[] == int[]`.
export function internArray(ref prog: Program, elem: TypeId): TypeId {
  let i: usize = 0;
  while (i < prog.types.len) {
    switch (typeAt(ref prog, i)) {
      case Type.Array { elem: existing }: {
        if (existing == elem) {
          return i;
        }
      }
      default: { }
    }
    i += 1;
  }
  return internType(ref prog, Type.Array { elem: elem });
}

// Same, for a FUNCTION type - one TypeId per distinct signature.
//
// This is what makes `{ hash: stringHash }` fit a field declared
// `(k: string) => uint64`: both sides intern to the same id, and type equality
// is `id == id`. A shell registered by pass A and later re-interned with its
// real signature lands on the same entry too, which is why filling one in place
// stays correct.
//
// The comparison is on parameter TYPES and the return type. Names never enter
// it - a function type is positional.
// ASYNCNESS is part of the comparison, which is what makes a sync function and
// an async one with otherwise identical signatures two different types. That
// falls straight out into the trait rule the reference states separately: a
// sync impl of an async trait method is a signature mismatch with no extra
// check anywhere.
export function internFunc(
  ref prog: Program,
  ref params: Vec<TypeId>,
  ret: TypeId,
  variadic: bool,
  isAsync: bool
): TypeId {
  let i: usize = 0;
  while (i < prog.types.len) {
    switch (typeAt(ref prog, i)) {
      case Type.Func { params: p, ret: r, variadic: v, isAsync: a }: {
        if (r == ret && v == variadic && a == isAsync && sameTypeList(ref p, ref params)) {
          return i;
        }
      }
      default: { }
    }
    i += 1;
  }
  // A fresh Vec rather than the caller's: the arena OWNS what it stores, and a
  // shallow copy sharing the caller's storage is the bug that already cost a
  // segfault once (see the VariantCase note in bootstrap/README.md).
  let owned: Vec<TypeId> = vec.vecFromArray(vec.vecAsArray(ref params));
  return internType(ref prog, Type.Func {
    params: owned, ret: ret, variadic: variadic, isAsync: isAsync,
  });
}

export function sameTypeList(ref a: Vec<TypeId>, ref b: Vec<TypeId>): bool {
  if (a.len != b.len) {
    return false;
  }
  let i: usize = 0;
  while (i < a.len) {
    if (vec.vecGet(ref a, i) != vec.vecGet(ref b, i)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Same, for `unsafe_ptr<T>` - one TypeId per pointee, and one for the opaque
// form, which is `pointee == TYPE_ERROR_ID` (id 0, the reserved "none").
export function internUnsafePtr(ref prog: Program, pointee: TypeId): TypeId {
  let i: usize = 0;
  while (i < prog.types.len) {
    switch (typeAt(ref prog, i)) {
      case Type.UnsafePtr { pointee: existing }: {
        if (existing == pointee) {
          return i;
        }
      }
      default: { }
    }
    i += 1;
  }
  return internType(ref prog, Type.UnsafePtr { pointee: pointee });
}

// Same, for `ref T`.
export function internRef(ref prog: Program, inner: TypeId): TypeId {
  let i: usize = 0;
  while (i < prog.types.len) {
    switch (typeAt(ref prog, i)) {
      case Type.Ref { inner: existing }: {
        if (existing == inner) {
          return i;
        }
      }
      default: { }
    }
    i += 1;
  }
  return internType(ref prog, Type.Ref { inner: inner });
}

export function internSymbol(ref prog: Program, s: Symbol): SymbolId {
  vec.vecPush(ref prog.symbols, s);
  return prog.symbols.len - 1;
}

// Replace an arena slot in place. This is the value-semantic stand-in for the
// JS reference mutating a shared shell object: pass A interns a shell, pass C
// calls this with the filled version, and every TypeId already pointing at the
// slot sees it.
export function setType(ref prog: Program, id: TypeId, t: Type): void {
  vec.vecSet(ref prog.types, id, t);
}

// Replace a symbol arena slot, the same way setType replaces a type's. Pass A
// binds a shell and pass C fills it; every holder of the id sees the new one.
export function setSymbol(ref prog: Program, id: SymbolId, s: Symbol): void {
  vec.vecSet(ref prog.symbols, id, s);
}

export function typeAt(ref prog: Program, id: TypeId): Type {
  return vec.vecGet(ref prog.types, id);
}

export function symbolAt(ref prog: Program, id: SymbolId): Symbol {
  return vec.vecGet(ref prog.symbols, id);
}

// A ModuleId back to the mangling id it names. Codegen asks this about the
// module a struct was DECLARED in, which is the one thing a TypeId knows about
// its home and the emitted name needs.
export function moduleIdOf(ref prog: Program, id: ModuleId): string {
  if (id >= prog.modules.len) {
    return "";
  }
  return vec.vecGet(ref prog.modules, id).moduleId;
}

export function reportError(ref prog: Program, message: string, sourceLoc: SourceLocation): void {
  let d = errorAt(message, sourceLoc);
  d.filePath = prog.currentFile;
  vec.vecPush(ref prog.diagnostics, d);
}

// Record a declared kind. A later declaration of the same name does not replace
// the first - a redeclaration is pass A's diagnostic, and overwriting here
// would make the registry disagree with the symbol table about which one won.
export function registerKind(ref prog: Program, info: KindInfo): void {
  if (map.mapContainsKey(ref prog.kinds, info.name)) {
    return;
  }
  map.mapInsert(ref prog.kinds, info.name, info);
}

// What a kind prefix names, or None when nothing in the graph declares it.
export function lookupKind(ref prog: Program, name: string): Option<KindInfo> {
  return map.mapGet(ref prog.kinds, name);
}

// Record an intrinsic's name. See `Program.intrinsics` for why it is global.
export function registerIntrinsic(ref prog: Program, name: string): void {
  map.mapInsert(ref prog.intrinsics, name, true);
}

// True when `name` is an intrinsic declared anywhere in the graph.
export function isIntrinsicName(ref prog: Program, name: string): bool {
  return map.mapContainsKey(ref prog.intrinsics, name);
}
