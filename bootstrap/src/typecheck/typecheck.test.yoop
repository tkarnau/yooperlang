// Tests for the `typecheck` module - currently pass A.
//
// These drive the real pipeline (lex -> parse -> typecheck) over source
// literals rather than poking Program by hand, so a change in the AST shape
// shows up here as a failing assertion instead of a stale test that still
// passes.

import.test;
import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import { Severity } from "../diagnostics";
import * as intr from "std/core/intrinsics.yoop";
import * as str from "std/core/strings.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ASTNodeKind, childAt, nodeAt } from "../ast";
import { Module, ModuleGraph, LoadModuleResult, moduleFromSource, singleModuleGraph } from "../source_graph";
import { Program, TypedModule, Symbol, Type, TypeId, TYPE_ERROR_ID, symbolAt, typeAt,
  lookupEnumCase, enumIsOpen, typecheckProgram, initProgram,
  isUnionType, lookupUnionField, unionDeclNameOf, unionPayloadSize,
  sizeOfType, alignOfType } from "../typecheck";
import { Diagnostic, errorAt } from "../diagnostics";

suite function passARegistersATopLevelFunction(): void {
  let prog = checkSource("function answer(): int { return 42; }");

  let test theory: Case = t.asserts("the function name is bound in the module namespace") {
    theory.isSuccessful = hasName(ref prog, "answer");
    theory.detail = `"answer" is not in the module namespace after pass A`;
  }
  let test theory: Case = t.asserts("a function inside the supported subset checks clean") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `reported ${prog.diagnostics.len} diagnostic(s) on a program that is entirely in the subset`;
  }
}

suite function parametersBindAsLocals(): void {
  let prog = checkSource("function add(a: int, b: int): int { return a + b; }");

  let test theory: Case = t.asserts("a parameter is readable in the body") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `reading a parameter reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }

  let dup = checkSource("function bad(a: int, a: int): int { return a; }");
  let test theory: Case = t.asserts("two parameters with the same name is a diagnostic") {
    theory.isSuccessful = dup.diagnostics.len > 0;
    theory.detail = "duplicate parameter name produced no diagnostic";
  }

  // The body is a nested block, so a local of the same name SHADOWS the
  // parameter rather than contradicting it. Same as the reference.
  let shadow = checkSource("function f(a: int): int { const a = 1; return a; }");
  let test theory: Case = t.asserts("a local may shadow a parameter") {
    theory.isSuccessful = shadow.diagnostics.len == 0;
    theory.detail = `shadowing a parameter reported ${shadow.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref shadow)}`;
  }
}

// Shadowing is a NESTED-block question and redeclaration is a same-block one.
// They are two questions rather than one: answering "any visible name refuses a
// declaration" would refuse `let v = 7; if (c) { let v = 99; }`.
suite function anInnerBlockShadowsAndAnOuterOneSnapsBack(): void {
  let inner = checkSource(
    "function main(): int { let v: int = 7; if (true) { let v: int = 9; return v; } return v; }"
  );
  let test theory: Case = t.asserts("a nested block may shadow an outer local") {
    theory.isSuccessful = inner.diagnostics.len == 0;
    theory.detail = `shadowing in a nested block reported ${inner.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref inner)}`;
  }

  let same = checkSource("function main(): int { let v: int = 7; let v: int = 9; return v; }");
  let test theory: Case = t.asserts("the SAME block still refuses a redeclaration") {
    theory.isSuccessful = same.diagnostics.len > 0;
    theory.detail = "redeclaring v beside itself produced no diagnostic";
  }

  // The head of a `for` is its own scope, so a counter may shadow too - and
  // the outer name has to be back in scope after the loop.
  let counter = checkSource(
    "function main(): int { let i: int = 9; for (let i = 0; i < 2; i += 1) { } return i; }"
  );
  let test theory: Case = t.asserts("a for-loop counter may shadow an outer local") {
    theory.isSuccessful = counter.diagnostics.len == 0;
    theory.detail = `a shadowing counter reported ${counter.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref counter)}`;
  }

  let forIn = checkSource(
    "function main(): int { let e: int = 9; const xs: int[] = [1]; for e in xs { } return e; }"
  );
  let test theory: Case = t.asserts("a for-in variable may shadow an outer local") {
    theory.isSuccessful = forIn.diagnostics.len == 0;
    theory.detail = `a shadowing for-in variable reported ${forIn.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref forIn)}`;
  }

  // The shadow ENDS with the block. Reading the inner name afterwards is an
  // unknown name, not a stale binding.
  let escaped = checkSource(
    "function main(): int { if (true) { let only: int = 1; } return only; }"
  );
  let test theory: Case = t.asserts("an inner-only binding does not leak past its block") {
    theory.isSuccessful = escaped.diagnostics.len > 0;
    theory.detail = "reading a name declared in a closed block produced no diagnostic";
  }
}

suite function passARegistersATypeDecl(): void {
  let prog = checkSource("type Point { }\nfunction main(): int { return 0; }");

  let test theory: Case = t.asserts("the type name is bound alongside the function") {
    theory.isSuccessful = hasName(ref prog, "Point") && hasName(ref prog, "main");
    theory.detail = `wanted both "Point" and "main" bound; the module namespace is missing one`;
  }
}

suite function passACatchesRedeclaration(): void {
  let prog = checkSource("function dup(): int { return 0; }\nfunction dup(): int { return 1; }");

  let test theory: Case = t.asserts("declaring the same name twice is a diagnostic, not a silent overwrite") {
    theory.isSuccessful = prog.diagnostics.len == 1;
    theory.detail = `wanted exactly 1 diagnostic for the duplicate "dup", got ${prog.diagnostics.len}`;
  }
}

suite function reservedTypeIdsComeFirst(): void {
  let prog = checkSource("function main(): int { return 0; }");

  let test theory: Case = t.asserts("the singleton types occupy the reserved low ids") {
    // ids.yoop pins these; initProgram pushes them in that order.
    theory.isSuccessful = prog.types.len >= 3;
    theory.detail = `the type arena has ${prog.types.len} entries, wanted at least the 3 reserved singletons`;
  }
  let test theory: Case = t.asserts("SymbolId 0 is never handed out") {
    // A real symbol at index 0 would make "not found" indistinguishable from
    // the first thing declared.
    theory.isSuccessful = prog.symbols.len >= 2;
    theory.detail = `the symbol arena has ${prog.symbols.len} entries; index 0 must be the dead slot`;
  }
}

// lex -> parse -> typecheck over a source literal. A parse failure comes back as
// an empty Program, which fails whichever assertion asked about it.
function checkSource(src: string): Program {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));

  switch (moduleFromSource("test", "test.yoop", srcBuf)) {
    case LoadModuleResult.Err { error: e }: {
      // A parse failure has to come back as a DIAGNOSTIC, not as an empty
      // Program. Otherwise a test asserting "this is refused" cannot tell
      // "refused by the parser" from "accepted silently" - both would read as
      // zero diagnostics, and the assertion would be meaningless.
      return parseFailureProgram(e);
    }
    case LoadModuleResult.Ok { value: m }: {
      let graph = singleModuleGraph(m);
      return typecheckProgram(ref graph);
    }
  }
}

function hasName(ref prog: Program, name: string): bool {
  if (prog.modules.len == 0) {
    return false;
  }
  let tm = vec.vecGet(ref prog.modules, 0);
  return map.mapContainsKey(ref tm.names, name);
}

// Locals: the parts that never reach an executable, so a slice fixture cannot
// cover them.
suite function localsInferAndBind(): void {
  let prog = checkSource("function main(): int { const n = 7; return n; }");

  let test theory: Case = t.asserts("a const with no annotation infers from its initializer") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `inferring const n = 7 reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }
}

suite function localsRejectBadPrograms(): void {
  let dup = checkSource("function main(): int { const n = 1; const n = 2; return n; }");
  let test theory: Case = t.asserts("declaring the same local twice is a diagnostic") {
    theory.isSuccessful = dup.diagnostics.len > 0;
    theory.detail = "redeclaring n produced no diagnostic";
  }

  let unknown = checkSource("function main(): int { return nope; }");
  let test theory: Case = t.asserts("reading an undeclared name is a diagnostic") {
    theory.isSuccessful = unknown.diagnostics.len > 0;
    theory.detail = "reading undeclared nope produced no diagnostic";
  }

  let mismatch = checkSource("function main(): int { const s: string = 1; return 0; }");
  let test theory: Case = t.asserts("an initializer that fights its annotation is a diagnostic") {
    theory.isSuccessful = mismatch.diagnostics.len > 0;
    theory.detail = "binding an int literal to a string-annotated local produced no diagnostic";
  }

  let bare = checkSource("function main(): int { let x; return 0; }");
  let test theory: Case = t.asserts("a local with neither annotation nor initializer is a diagnostic") {
    theory.isSuccessful = bare.diagnostics.len > 0;
    theory.detail = "let x; with nothing to infer from produced no diagnostic";
  }
}

// ----- module-level consts --------------------------------------------------

suite function moduleConstsAreImmutableValues(): void {
  let ok = checkSource("const N: int = 7;\nfunction main(): int { return N + 1; }");
  let test theory: Case = t.asserts("a module const is readable from a body") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reading a module const reported: ${firstDiagnostic(ref ok)}`;
  }

  // A LOCAL of the same name wins, which is the precedence every language gives
  // them and the one a reader assumes.
  let shadowed = checkSource("const N: int = 7;\nfunction main(): int { const N = 1; return N; }");
  let test theory: Case = t.asserts("a local of the same name shadows the const") {
    theory.isSuccessful = shadowed.diagnostics.len == 0;
    theory.detail = `shadowing a module const reported: ${firstDiagnostic(ref shadowed)}`;
  }

  // An initializer that is not something there IS to inline does not refuse the
  // const - it backs it with a real GLOBAL whose value is stored by the
  // module's init function, which is the only path open to a value like a call
  // result. `const` means IMMUTABLE; the inlining is a fast path for the
  // literal shapes and not the definition.
  let computed = checkSource("const N: int = other();\nfunction other(): int { return 1; }\nfunction main(): int { return N; }");
  let test theory: Case = t.asserts("a call initializer is accepted and backed by a global") {
    theory.isSuccessful = computed.diagnostics.len == 0;
    theory.detail = `a call-initialized const reported: ${firstDiagnostic(ref computed)}`;
  }

  let wrongShape = checkSource("type P { x: int }\nconst Q: P = { x: 1 };\nfunction main(): int { return Q.x; }");
  let test theory: Case = t.asserts("a struct-literal initializer is accepted the same way") {
    theory.isSuccessful = wrongShape.diagnostics.len == 0;
    theory.detail = `a struct-literal const reported: ${firstDiagnostic(ref wrongShape)}`;
  }

  // Backed by a global or not, it is still a const: there is no assignment to
  // it, and the reason has stopped being "it has no storage".
  let writeBacked = checkSource("const N: int32 = other();\nfunction other(): int32 { return 1; }\nfunction main(): int { N = 2; return 0; }");
  let test theory: Case = t.asserts("a const backed by a global still cannot be assigned") {
    theory.isSuccessful = diagnosticsMention(ref writeBacked, "cannot assign to const");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref writeBacked)}`;
  }

  // The declared TYPE is still what the initializer is checked against, so a
  // const cannot quietly become a zero of the wrong kind. It is the ORDINARY
  // mismatch now rather than a const-shaped one, because the initializer is an
  // ordinary expression pass D reads.
  let mismatched = checkSource(`const S: string = 5;\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("an initializer of the wrong type is still refused") {
    theory.isSuccessful = diagnosticsMention(ref mismatched, "cannot assign untyped int to string");
    theory.detail = `wanted a const-type refusal, got: ${firstDiagnostic(ref mismatched)}`;
  }

  // The shapes that DO inline: a string is a module-level string constant, an
  // array is a descriptor over a module-level payload, and a float is an
  // immediate at whichever width the annotation names.
  let inlinable = checkSource(`const S: string = "hi";\nconst A: uint8[] = [1, 2, 3];\nconst F: float64 = 1.5;\nconst B: bool = true;\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("string, array, float and bool consts are accepted") {
    theory.isSuccessful = inlinable.diagnostics.len == 0;
    theory.detail = `an inlinable const reported: ${firstDiagnostic(ref inlinable)}`;
  }

  let unannotated = checkSource("const N = 7;\nfunction main(): int { return N; }");
  let test theory: Case = t.asserts("a module const needs an annotation") {
    theory.isSuccessful = diagnosticsMention(ref unannotated, "needs a type annotation");
    theory.detail = `wanted an annotation diagnostic, got: ${firstDiagnostic(ref unannotated)}`;
  }

  // A module-level `let` is a MUTABLE GLOBAL now, not a refusal - see
  // moduleGlobalsAreRealStorage below.
  let mutable = checkSource("let N: int = 7;\nfunction main(): int { N = 8; return N; }");
  let test theory: Case = t.asserts("module-level `let` is a mutable global, and is writable") {
    theory.isSuccessful = mutable.diagnostics.len == 0;
    theory.detail = `reported ${mutable.diagnostics.len}: ${firstDiagnostic(ref mutable)}`;
  }

  // Cross-module: the VALUE travels, because there is no global to point at.
  let imported = checkTwoModules(
    "export const WIDTH: int = 80;",
    "import { WIDTH } from \"./lib.yoop\";\nfunction main(): int { return WIDTH; }"
  );
  let test theory: Case = t.asserts("an exported const is readable from another module") {
    theory.isSuccessful = imported.diagnostics.len == 0;
    theory.detail = `importing a const reported: ${firstDiagnostic(ref imported)}`;
  }
}

suite function discardBindsNothing(): void {
  const RES: string = "variant Res { Ok { value: int }, Err { code: int, detail: int } }\n";

  let ok = checkSource(`${RES}function f(r: Res): int { switch (r) { case Res.Ok { value: v }: { return v; } case Res.Err { code: c, detail: _ }: { return c; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("`_` names a field without binding it") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `a discard binding reported: ${firstDiagnostic(ref ok)}`;
  }

  // Named but not bound - so it does not become readable.
  let read = checkSource(`${RES}function f(r: Res): int { switch (r) { case Res.Ok { value: v }: { return v; } case Res.Err { code: c, detail: _ }: { return _; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a discarded field is not readable") {
    theory.isSuccessful = read.diagnostics.len > 0;
    theory.detail = "reading `_` after discarding it produced no diagnostic";
  }

  // Discarding is not the same as omitting: every field still has to be NAMED,
  // so a case that grows one breaks its patterns loudly.
  let omitted = checkSource(`${RES}function f(r: Res): int { switch (r) { case Res.Ok { value: v }: { return v; } case Res.Err { code: c }: { return c; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("omitting a field is still an error") {
    theory.isSuccessful = diagnosticsMention(ref omitted, "must bind all of them");
    theory.detail = `wanted a bind-all diagnostic, got: ${firstDiagnostic(ref omitted)}`;
  }

  // Two discards in one pattern must not collide the way two real bindings of
  // one name would.
  let twice = checkSource(`${RES}function f(r: Res): int { switch (r) { case Res.Ok { value: v }: { return v; } case Res.Err { code: _, detail: _ }: { return 0; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("two discards in one pattern do not collide") {
    theory.isSuccessful = twice.diagnostics.len == 0;
    theory.detail = `two discard bindings reported: ${firstDiagnostic(ref twice)}`;
  }
}

// ----- borrows --------------------------------------------------------------

suite function refIsADistinctTypeFromTheThingBorrowed(): void {
  const CLEAR: string = "function clear(ref n: int): void { n = 0; }\n";

  let ok = checkSource(`${CLEAR}function main(): int { let n: int = 1; clear(ref n); return n; }`);
  let test theory: Case = t.asserts("a borrow satisfies a `ref` parameter") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `passing a borrow reported: ${firstDiagnostic(ref ok)}`;
  }

  // Writing `ref` is REQUIRED, not inferred: the reader has to be able to see
  // at the call which arguments the callee may write through.
  let byValue = checkSource(`${CLEAR}function main(): int { let n: int = 1; clear(n); return n; }`);
  let test theory: Case = t.asserts("passing a value where a borrow is wanted is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref byValue, "is ref int32, not int32");
    theory.detail = `wanted a ref-vs-value diagnostic, got: ${firstDiagnostic(ref byValue)}`;
  }

  // And the other direction. `ref n` WRITTEN OUT never opens itself: the reason
  // writing it is required is that the call site shows what may be written
  // through, and quietly undoing it would make `f(ref n)` and `f(n)` the same
  // call. The reference draws the line in the same place.
  let byRef = checkSource("function takes(n: int): int { return n; }\nfunction main(): int { let n: int = 1; return takes(ref n); }");
  let test theory: Case = t.asserts("passing a borrow where a value is wanted is a diagnostic") {
    theory.isSuccessful = byRef.diagnostics.len > 0;
    theory.detail = "passing `ref n` to a by-value parameter produced no diagnostic";
  }

  // The BODY sees a plain `int`, not a `ref int` - a borrow IS the thing it
  // borrows as far as the callee is concerned, which is what keeps every read
  // and write in the body from needing to know about references.
  let body = checkSource("function addTo(ref n: int, by: int): void { n = n + by; }\nfunction main(): int { return 0; }");
  let test theory: Case = t.asserts("a `ref` parameter reads as its pointee inside the body") {
    theory.isSuccessful = body.diagnostics.len == 0;
    theory.detail = `arithmetic on a ref parameter reported: ${firstDiagnostic(ref body)}`;
  }

  // A borrow needs an ADDRESS, and only a named binding has one.
  let temp = checkSource("function f(ref n: int): void { }\nfunction g(): int { return 1; }\nfunction main(): int { f(ref g()); return 0; }");
  let test theory: Case = t.asserts("`ref` of a non-name is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref temp, "takes a named binding");
    theory.detail = `wanted a named-binding diagnostic, got: ${firstDiagnostic(ref temp)}`;
  }
}

// FORWARDING a `ref` parameter into another `ref` slot, with no second `ref`
// written. The body sees a plain `T`, so the name would otherwise be refused
// exactly the way a plain local is - and the whole compiler's own source is
// written against the reference's rule, which accepts it.
//
// The rule is about the name having ARRIVED as a borrow, not about its type: a
// plain local still has to write `ref`, because that is where a new borrow is
// created.
suite function aRefParameterForwardsAsABorrow(): void {
  const DECLS: string = "type Counter { hits: int32, }\ntype Holder { c: ref Counter, }\nfunction bump(ref c: Counter): void { c.hits = c.hits + 1; }\nfunction byVal(c: Counter): int32 { return c.hits; }\n";
  const MAIN: string = "\nfunction main(): int { return 0; }";

  let bare = checkSource(`${DECLS}function fwd(ref c: Counter): void { bump(c); }${MAIN}`);
  let test theory: Case = t.asserts("a `ref` parameter passes to a `ref` parameter with no `ref` written") {
    theory.isSuccessful = bare.diagnostics.len == 0;
    theory.detail = `forwarding a ref parameter reported: ${firstDiagnostic(ref bare)}`;
  }

  // The same call, written out. Both spellings have to work or the compiler's
  // own source would have to pick one.
  let spelled = checkSource(`${DECLS}function fwd(ref c: Counter): void { bump(ref c); }${MAIN}`);
  let test theory: Case = t.asserts("the same forward still accepts an explicit `ref`") {
    theory.isSuccessful = spelled.diagnostics.len == 0;
    theory.detail = `forwarding with an explicit ref reported: ${firstDiagnostic(ref spelled)}`;
  }

  // And by VALUE, which is the body's own view of the parameter.
  let opened = checkSource(`${DECLS}function fwd(ref c: Counter): int32 { return byVal(c); }${MAIN}`);
  let test theory: Case = t.asserts("a `ref` parameter still satisfies a by-value parameter") {
    theory.isSuccessful = opened.diagnostics.len == 0;
    theory.detail = `passing a ref parameter by value reported: ${firstDiagnostic(ref opened)}`;
  }

  // A `ref T` struct-literal FIELD is the other position, and three of the four
  // sites in the compiler's own source are this one rather than a call.
  let field = checkSource(`${DECLS}function fwd(ref c: Counter): int32 { let h: Holder = { c: c }; return 0; }${MAIN}`);
  let test theory: Case = t.asserts("a `ref` parameter fills a `ref` struct field with no `ref` written") {
    theory.isSuccessful = field.diagnostics.len == 0;
    theory.detail = `filling a ref field from a ref parameter reported: ${firstDiagnostic(ref field)}`;
  }

  // The narrow half, and the reason this is keyed on how the name ARRIVED
  // rather than on its type. A plain local creates a NEW borrow, so the call
  // site has to show it. The reference refuses this too.
  let plain = checkSource(`${DECLS}function fwd(): void { let c: Counter = { hits: 0 }; bump(c); }${MAIN}`);
  let test theory: Case = t.asserts("a PLAIN local still has to write `ref` at the call") {
    theory.isSuccessful = diagnosticsMention(ref plain, "is ref Counter, not Counter");
    theory.detail = `wanted a ref-vs-value diagnostic, got: ${firstDiagnostic(ref plain)}`;
  }

  // And a plain local into a `ref` FIELD, which is the same rule in the other
  // position.
  let plainField = checkSource(`${DECLS}function fwd(): void { let c: Counter = { hits: 0 }; let h: Holder = { c: c }; }${MAIN}`);
  let test theory: Case = t.asserts("a PLAIN local still has to write `ref` in a struct literal") {
    theory.isSuccessful = plainField.diagnostics.len > 0;
    theory.detail = "filling a ref field from a plain local produced no diagnostic";
  }

  // A BY-VALUE parameter is not a borrow either, however much it looks like one
  // at the call. Only `ref` on the declaration makes the name forwardable.
  let byValParam = checkSource(`${DECLS}function fwd(c: Counter): void { bump(c); }${MAIN}`);
  let test theory: Case = t.asserts("a by-value parameter is not forwardable") {
    theory.isSuccessful = byValParam.diagnostics.len > 0;
    theory.detail = "forwarding a by-value parameter produced no diagnostic";
  }
}

// A borrow that arrived as a VALUE - out of a `ref T` struct field, or through
// a local bound to one - reaches its fields and its elements exactly as the
// thing it borrows does. That is the same rule `bindParams` applies to a `ref`
// parameter, and the reason it needs saying twice is that a parameter is
// unwrapped once at its declaration while a field keeps its `ref T` type for
// as long as anything holds it.
suite function aBorrowHeldAsAValueOpensAtEveryUse(): void {
  const HOLDER: string = "type Holder { src: ref uint8[], }\ntype Point { x: int32, y: int32 }\ntype PointRef { p: ref Point, }\n";

  let len = checkSource(`${HOLDER}function f(ref h: Holder): usize { const s = h.src; return s.len; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("`.len` reaches through a borrowed array") {
    theory.isSuccessful = len.diagnostics.len == 0;
    theory.detail = `reading .len through a ref uint8[] reported: ${firstDiagnostic(ref len)}`;
  }

  let idx = checkSource(`${HOLDER}function f(ref h: Holder): uint8 { const s = h.src; return s[0]; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("indexing reaches through a borrowed array") {
    theory.isSuccessful = idx.diagnostics.len == 0;
    theory.detail = `indexing a ref uint8[] reported: ${firstDiagnostic(ref idx)}`;
  }

  let field = checkSource(`${HOLDER}function f(ref r: PointRef): int32 { const p = r.p; return p.x; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a field reaches through a borrowed struct") {
    theory.isSuccessful = field.diagnostics.len == 0;
    theory.detail = `reading a field through a ref Point reported: ${firstDiagnostic(ref field)}`;
  }

  let arg = checkSource(`${HOLDER}function byVal(xs: uint8[]): usize { return xs.len; }\nfunction f(ref h: Holder): usize { const s = h.src; return byVal(s); }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a held borrow satisfies a by-value parameter") {
    theory.isSuccessful = arg.diagnostics.len == 0;
    theory.detail = `passing a held borrow by value reported: ${firstDiagnostic(ref arg)}`;
  }

  // Still a borrow, though: handing it to a `ref` parameter passes the pointer
  // on rather than a pointer to a copy, so both directions have to work.
  let onward = checkSource(`${HOLDER}function byRef(ref xs: uint8[]): usize { return xs.len; }\nfunction f(ref h: Holder): usize { const s = h.src; return byRef(s); }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a held borrow also satisfies a `ref` parameter") {
    theory.isSuccessful = onward.diagnostics.len == 0;
    theory.detail = `passing a held borrow onward reported: ${firstDiagnostic(ref onward)}`;
  }

  // The field's own name still has to exist. Opening the borrow must not turn a
  // typo into "unsupported", which is what the old refusal did.
  let missing = checkSource(`${HOLDER}function f(ref r: PointRef): int32 { const p = r.p; return p.z; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a missing field through a borrow names the struct") {
    theory.isSuccessful = diagnosticsMention(ref missing, `struct "Point" has no field "z"`);
    theory.detail = `wanted a no-such-field diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }
}

// ----- calls ----------------------------------------------------------------

const ADD: string = "function add(a: int, b: int): int { return a + b; }\n";

suite function callArgumentsAreCheckedAgainstParameters(): void {
  let ok = checkSource(`${ADD}function main(): int { return add(1, 2); }`);
  let test theory: Case = t.asserts("a matching call checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `a well-formed call reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  let tooFew = checkSource(`${ADD}function main(): int { return add(1); }`);
  let test theory: Case = t.asserts("too few arguments is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref tooFew, "takes 2 argument(s), got 1");
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref tooFew)}`;
  }

  let tooMany = checkSource(`${ADD}function main(): int { return add(1, 2, 3); }`);
  let test theory: Case = t.asserts("too many arguments is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref tooMany, "takes 2 argument(s), got 3");
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref tooMany)}`;
  }

  // The POSITION is named, because "wrong argument type" on a five-argument
  // call is most of a message and none of the answer.
  let wrongType = checkSource(`${ADD}function main(): int { return add(1, "x"); }`);
  let test theory: Case = t.asserts("an argument of the wrong type names its position") {
    theory.isSuccessful = diagnosticsMention(ref wrongType, "argument 2 of \"add\"");
    theory.detail = `wanted a positional type diagnostic, got: ${firstDiagnostic(ref wrongType)}`;
  }

  // Each argument is checked AGAINST its parameter, so an untyped literal pins
  // to it. Without that, `wide(7)` would default the 7 to int32 and then
  // complain that int32 and int64 differ.
  let pinned = checkSource("function wide(n: int64): int64 { return n; }\nfunction main(): int { return 0; }\nfunction f(): int64 { return wide(7); }");
  let test theory: Case = t.asserts("an untyped literal pins to the parameter's width") {
    theory.isSuccessful = pinned.diagnostics.len == 0;
    theory.detail = `passing 7 to an int64 parameter reported: ${firstDiagnostic(ref pinned)}`;
  }

  // printf is variadic and has no signature to check against - it must keep
  // taking whatever it is given.
  let variadic = checkSource("function main(): int { printf(\"%d %s\\n\", 1, \"two\"); return 0; }");
  let test theory: Case = t.asserts("printf still takes any arguments") {
    theory.isSuccessful = variadic.diagnostics.len == 0;
    theory.detail = `printf with mixed arguments reported: ${firstDiagnostic(ref variadic)}`;
  }

  // A mistake INSIDE an argument must still be reported when the callee itself
  // is unknown, rather than hidden behind the unknown-name error.
  let both = checkSource("function main(): int { return nope(missing); }");
  let test theory: Case = t.asserts("an unknown callee does not hide errors in its arguments") {
    theory.isSuccessful = diagnosticsMention(ref both, "unknown function")
      && diagnosticsMention(ref both, "unknown name");
    theory.detail = `wanted both diagnostics, got ${both.diagnostics.len}: ${firstDiagnostic(ref both)}`;
  }
}

suite function qualifiedCallArgumentsAreCheckedToo(): void {
  // The signature is the SOURCE module's and the arguments are in THIS module's
  // scope; both sides are program-wide TypeIds, so nothing is translated.
  let wrong = checkTwoModules(
    "export function add(a: int, b: int): int { return a + b; }",
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { return lib.add(1); }"
  );
  let test theory: Case = t.asserts("a namespaced call checks arity") {
    theory.isSuccessful = diagnosticsMention(ref wrong, "takes 2 argument(s), got 1");
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref wrong)}`;
  }

  let imported = checkTwoModules(
    "export function add(a: int, b: int): int { return a + b; }",
    "import { add } from \"./lib.yoop\";\nfunction main(): int { return add(1, \"x\"); }"
  );
  let test theory: Case = t.asserts("an imported call checks argument types") {
    theory.isSuccessful = diagnosticsMention(ref imported, "argument 2");
    theory.detail = `wanted a positional type diagnostic, got: ${firstDiagnostic(ref imported)}`;
  }
}

// A type carrying `toString(ref self): string` interpolates. Having the METHOD
// is the test rather than naming Display: there are no inherent methods, so a
// `toString` is one some trait required, and checking the trait by name would
// need the importing module's scope for a question that is a property of the
// TYPE.
suite function aTypeWithToStringInterpolates(): void {
  const display = "trait Display { function toString(ref self): string; }\n";
  const point = "type P implements Display { x: int, function toString(ref self): string { return \"p\"; } }\n";

  let ok = checkSource(`${display}${point}function main(): int { const p: P = { x: 1 }; printf("%s", \`${"$"}{p}\`); return 0; }`);
  let test theory: Case = t.asserts("a type with toString can be interpolated") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The RETURN is checked, because the interpolation splices the result
  // straight into a string buffer - a `toString` returning an int would emit
  // wrong IR rather than a diagnostic, and the method table cannot rule it out.
  const wrongRet = "trait Wrong { function toString(ref self): int; }\ntype W implements Wrong { x: int, function toString(ref self): int { return 1; } }\n";
  let bad = checkSource(`${wrongRet}function main(): int { const w: W = { x: 1 }; printf("%s", \`${"$"}{w}\`); return 0; }`);
  let test theory: Case = t.asserts("a toString returning something else does NOT make a type printable") {
    theory.isSuccessful = diagnosticsMention(ref bad, "carries no `toString");
    theory.detail = `wanted an interpolation refusal, got: ${firstDiagnostic(ref bad)}`;
  }
}

// `@derive(display)` is EXPANDED: the generated `toString` is grafted into the
// declaration's member run and `Display` is merged into its implements clause,
// so a decorated type interpolates exactly like one whose author wrote the
// method out. The expansion itself runs at LOAD time (parse/derive.yoop); what
// is asserted here is the shape typecheck ends up seeing.
suite function deriveDisplayIsExpanded(): void {
  const display = "trait Display { function toString(ref self): string; }\n";

  let ok = checkSource(`${display}@derive(display)\ntype P { x: int }\nfunction main(): int { const p: P = { x: 1 }; return p.x; }`);
  let test theory: Case = t.asserts("a decorated type checks like any other") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let derived = checkSource(`${display}@derive(display)\ntype P { x: int }\nfunction main(): int { const p: P = { x: 1 }; printf("%s", \`${"$"}{p}\`); return 0; }`);
  let test theory: Case = t.asserts("interpolating one is accepted - the method is there") {
    theory.isSuccessful = derived.diagnostics.len == 0;
    theory.detail = `reported ${derived.diagnostics.len}: ${firstDiagnostic(ref derived)}`;
  }

  // The merged clause is a REAL implements, not a flag: a static trait dispatch
  // through it has to resolve, and there are no inherent methods, so the
  // grafted `toString` would be refused outright without it.
  let dispatch = checkSource(`${display}@derive(display)\ntype P { x: int }\nfunction main(): int { const p: P = { x: 1 }; printf("%s", Display.toString(ref p)); return 0; }`);
  let test theory: Case = t.asserts("the merged implements clause carries a static dispatch") {
    theory.isSuccessful = dispatch.diagnostics.len == 0;
    theory.detail = `reported ${dispatch.diagnostics.len}: ${firstDiagnostic(ref dispatch)}`;
  }

  // A VARIANT derives too, and its method is an arm-per-case switch.
  let sumType = checkSource(`${display}@derive(display)\nvariant S { A { n: int }, B }\nfunction main(): int { const s: S = S.B; printf("%s", \`${"$"}{s}\`); return 0; }`);
  let test theory: Case = t.asserts("a decorated variant interpolates too") {
    theory.isSuccessful = sumType.diagnostics.len == 0;
    theory.detail = `reported ${sumType.diagnostics.len}: ${firstDiagnostic(ref sumType)}`;
  }

  // An existing `implements Display` must NOT be duplicated - the clause is
  // merged rather than appended blindly.
  let listed = checkSource(`${display}@derive(display)\ntype P implements Display { x: int }\nfunction main(): int { const p: P = { x: 1 }; printf("%s", \`${"$"}{p}\`); return 0; }`);
  let test theory: Case = t.asserts("a type already claiming Display is not made to claim it twice") {
    theory.isSuccessful = listed.diagnostics.len == 0;
    theory.detail = `reported ${listed.diagnostics.len}: ${firstDiagnostic(ref listed)}`;
  }

  // The generic message has to survive for everything else, or the hint starts
  // claiming that any un-interpolatable struct was decorated.
  let plain = checkSource("type Q { x: int }\nfunction main(): int { const q: Q = { x: 1 }; printf(\"%s\", `${q}`); return 0; }");
  let test theory: Case = t.asserts("an UNdecorated struct still gets the ordinary refusal") {
    theory.isSuccessful = diagnosticsMention(ref plain, "carries no `toString");
    theory.detail = `wanted the generic interpolation refusal, got: ${firstDiagnostic(ref plain)}`;
  }
}

// The four refusals. Each is a real error rather than a silent skip: a decl
// carrying the attribute and getting no method fails later at an
// interpolation, which points at the USE instead of at the declaration.
suite function deriveDisplayRefusesWhatItCannotGenerate(): void {
  const display = "trait Display { function toString(ref self): string; }\n";

  let generic = checkSource(`${display}@derive(display)\ntype Box<T> { v: T }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a GENERIC type is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref generic, "is not yet supported - write the Display impl manually");
    theory.detail = `wanted the generic refusal, got: ${firstDiagnostic(ref generic)}`;
  }

  let genericVariant = checkSource(`${display}@derive(display)\nvariant Maybe<T> { Some { v: T }, None }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a generic VARIANT names itself a variant") {
    theory.isSuccessful = diagnosticsMention(ref genericVariant, "on generic variant \"Maybe\"");
    theory.detail = `wanted the generic variant refusal, got: ${firstDiagnostic(ref genericVariant)}`;
  }

  let alias = checkSource(`${display}@derive(display)\ntype NodeId = int;\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a transparent ALIAS is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref alias, "cannot apply to type alias");
    theory.detail = `wanted the alias refusal, got: ${firstDiagnostic(ref alias)}`;
  }

  let dup = checkSource(`${display}@derive(display)\ntype P implements Display { x: int, function toString(ref self): string { return "p"; } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a type that already writes toString is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref dup, "already defines \"toString\"");
    theory.detail = `wanted the duplicate refusal, got: ${firstDiagnostic(ref dup)}`;
  }
}

// Building a vtable VALUE. `vtable Name for Trait { ... }` has declared and laid
// out for a while; what these are about is the three spellings that USE one, and
// the refusals that keep a wrong one from compiling into a wrong indirect call.
suite function aVtableValueIsBuiltAndDispatchedThrough(): void {
  const VT = "trait H { function handle(ref self, n: int): int; } vtable D for H { handle: (n: int) => int, } type C implements H { v: int, function handle(ref self, n: int): int { return self.v; } } ";

  let ok = checkSource(`${VT}function main(): int { let c: C = { v: 1 }; let d: D = D.from(ref c); return D.handle(ref d, 2); }`);
  let test theory: Case = t.asserts("`from` erases a struct and the vtable dispatches") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The vtable stores the receiver's ADDRESS, so a by-value argument would
  // point at a temporary that is gone by the next statement.
  let byValue = checkSource(`${VT}function main(): int { let c: C = { v: 1 }; let d: D = D.from(c); return 0; }`);
  let test theory: Case = t.asserts("a by-value receiver is refused, naming the address") {
    theory.isSuccessful = diagnosticsMention(ref byValue, "needs a `ref` argument");
    theory.detail = `wanted the ref refusal, got: ${firstDiagnostic(ref byValue)}`;
  }

  let wrongImpl = checkSource(`${VT}type Q { n: int }\nfunction main(): int { let q: Q = { n: 1 }; let d: D = D.from(ref q); return 0; }`);
  let test theory: Case = t.asserts("erasing a type that does not implement the trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref wrongImpl, "does not implement");
    theory.detail = `wanted the implements refusal, got: ${firstDiagnostic(ref wrongImpl)}`;
  }

  let badSlot = checkSource(`${VT}function main(): int { let c: C = { v: 1 }; let d: D = D.from(ref c); return D.nope(ref d, 2); }`);
  let test theory: Case = t.asserts("a member that is not a slot is refused, naming what a vtable has") {
    theory.isSuccessful = diagnosticsMention(ref badSlot, "has no slot");
    theory.detail = `wanted the slot refusal, got: ${firstDiagnostic(ref badSlot)}`;
  }

  let badArity = checkSource(`${VT}function main(): int { let c: C = { v: 1 }; let d: D = D.from(ref c); return D.handle(ref d); }`);
  let test theory: Case = t.asserts("a dispatch counts the receiver in its arity") {
    theory.isSuccessful = diagnosticsMention(ref badArity, "the vtable receiver plus 1");
    theory.detail = `wanted the arity refusal, got: ${firstDiagnostic(ref badArity)}`;
  }
}

// `fromFn` erases NAMED FUNCTIONS instead of a receiver: one per slot, in slot
// order, and each one has to match its slot's signature.
suite function fromFnErasesNamedFunctions(): void {
  const VT = "trait P { function lo(ref self, n: int): int; function hi(ref self, n: int): int; } vtable PV for P { lo: (n: int) => int, hi: (n: int) => int, } function dbl(n: int): int { return n * 2; } function inc(n: int): int { return n + 1; } ";

  let ok = checkSource(`${VT}function main(): int { let v: PV = PV.fromFn(dbl, inc); return PV.lo(ref v, 3); }`);
  let test theory: Case = t.asserts("one function per slot builds a vtable") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let short = checkSource(`${VT}function main(): int { let v: PV = PV.fromFn(dbl); return 0; }`);
  let test theory: Case = t.asserts("too few functions is refused, naming the slot count") {
    theory.isSuccessful = diagnosticsMention(ref short, "one per slot");
    theory.detail = `wanted the arity refusal, got: ${firstDiagnostic(ref short)}`;
  }

  // A slot holds a SYMBOL's address, so a function-typed local has nothing to
  // take the address of and the shim has no target to forward to.
  let notNamed = checkSource(`${VT}function main(): int { let f: (n: int) => int = dbl; let v: PV = PV.fromFn(f, inc); return 0; }`);
  let test theory: Case = t.asserts("a function-typed LOCAL is refused, naming the symbol") {
    theory.isSuccessful = diagnosticsMention(ref notNamed, "has to be a named function");
    theory.detail = `wanted the named-function refusal, got: ${firstDiagnostic(ref notNamed)}`;
  }
}

// A vtable's slots are checked against the trait it erases. Getting one wrong is
// an indirect call through a mismatched signature - a crash rather than a
// diagnostic - so the check is at the DECLARATION, before anything can build one.
suite function aVtableDeclarationIsCheckedAgainstItsTrait(): void {
  const TR = "trait H { function handle(ref self, n: int): int; } ";

  let missing = checkSource(`${TR}vtable D for H { }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a missing slot is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref missing, "has no slot for \"handle\"");
    theory.detail = `wanted the coverage refusal, got: ${firstDiagnostic(ref missing)}`;
  }

  let extra = checkSource(`${TR}vtable D for H { handle: (n: int) => int, other: () => int, }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a slot the trait does not declare is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref extra, "which trait \"H\" does not declare");
    theory.detail = `wanted the unknown-slot refusal, got: ${firstDiagnostic(ref extra)}`;
  }

  // The slot signature is the trait method's with `ref self` STRIPPED, which is
  // what makes the count off by one on purpose.
  let wrongArity = checkSource(`${TR}vtable D for H { handle: (n: int, m: int) => int, }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a slot with the wrong parameter count is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref wrongArity, "beside `ref self`");
    theory.detail = `wanted the arity refusal, got: ${firstDiagnostic(ref wrongArity)}`;
  }

  let wrongRet = checkSource(`${TR}vtable D for H { handle: (n: int) => bool, }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a slot returning the wrong type is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref wrongRet, "but trait \"H.handle\" returns");
    theory.detail = `wanted the return refusal, got: ${firstDiagnostic(ref wrongRet)}`;
  }
}

// An import is module-scoped and IDEMPOTENT. A directory module's files each
// import what they use, so one alias gets bound once per file that mentions it;
// re-binding it to the same module is the same import written again. Binding it
// to a DIFFERENT module under one name is the real mistake and stays refused.
//
// Both halves were established by PROBING the reference, which draws the line in
// exactly this place - imports are not file-SCOPED there either.
suite function anImportIsIdempotentButAConflictIsNot(): void {
  const lib = "export type Thing { n: int }\nexport function val(): int { return 1; }\n";

  let twiceNs = checkTwoModules(
    lib,
    "import * as u from \"./lib.yoop\";\nimport * as u from \"./lib.yoop\";\nfunction main(): int { return u.val(); }"
  );
  let test theory: Case = t.asserts("the same namespace bound twice is one import") {
    theory.isSuccessful = twiceNs.diagnostics.len == 0;
    theory.detail = `reported ${twiceNs.diagnostics.len}: ${firstDiagnostic(ref twiceNs)}`;
  }

  let twiceNamed = checkTwoModules(
    lib,
    "import { Thing } from \"./lib.yoop\";\nimport { Thing } from \"./lib.yoop\";\nfunction main(): int { const t: Thing = { n: 2 }; return t.n; }"
  );
  let test theory: Case = t.asserts("and so is the same named import bound twice") {
    theory.isSuccessful = twiceNamed.diagnostics.len == 0;
    theory.detail = `reported ${twiceNamed.diagnostics.len}: ${firstDiagnostic(ref twiceNamed)}`;
  }

  // The half that must NOT be relaxed. One name cannot mean two things, and a
  // module declaring `Thing` is still a collision with importing one.
  let clash = checkTwoModules(
    lib,
    "import { Thing } from \"./lib.yoop\";\ntype Thing { z: int }\nfunction main(): int { return 0; }"
  );
  let test theory: Case = t.asserts("an import still collides with a declaration of the same name") {
    theory.isSuccessful = clash.diagnostics.len > 0;
    theory.detail = `importing over a local declaration reported nothing`;
  }
}

// `ns.Type` in annotation position. A namespace has always carried the module's
// exports; this is reaching a TYPE through one rather than a function.
suite function namespacesReachTypesAndNotJustFunctions(): void {
  const lib = "export type Point { x: int, y: int }\ntype Hidden { z: int }\n";

  let ok = checkTwoModules(
    lib,
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { const p: lib.Point = { x: 1, y: 2 }; return p.x; }"
  );
  let test theory: Case = t.asserts("a qualified type resolves against the module's exports") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The point of the whole feature: type equality is `id == id`, so a qualified
  // name and a named import have to reach ONE symbol. Two nominal types that
  // merely spell the same would fail this assignment.
  let sameType = checkTwoModules(
    lib,
    "import { Point }, * as lib from \"./lib.yoop\";\nfunction takes(p: lib.Point): int { return p.x; }\nfunction main(): int { const p: Point = { x: 1, y: 2 }; return takes(p); }"
  );
  let test theory: Case = t.asserts("a qualified name and a named import are the SAME type") {
    theory.isSuccessful = sameType.diagnostics.len == 0;
    theory.detail = `reported ${sameType.diagnostics.len}: ${firstDiagnostic(ref sameType)}`;
  }

  // Three distinct mistakes, three distinct messages - the fix for each is in a
  // different place, so they must not read alike.
  let notExported = checkTwoModules(
    lib,
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { const h: lib.Hidden = 0; return 0; }"
  );
  let test theory: Case = t.asserts("a declared-but-unexported type says so, and where to fix it") {
    theory.isSuccessful = diagnosticsMention(ref notExported, "not exported");
    theory.detail = `wanted an export diagnostic, got: ${firstDiagnostic(ref notExported)}`;
  }

  let noSuchExport = checkTwoModules(
    lib,
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { const n: lib.Nope = 0; return 0; }"
  );
  let test theory: Case = t.asserts("a misspelled type names the namespace it looked in") {
    theory.isSuccessful = diagnosticsMention(ref noSuchExport, "has no export");
    theory.detail = `wanted a missing-export diagnostic, got: ${firstDiagnostic(ref noSuchExport)}`;
  }

  let noSuchNs = checkTwoModules(
    lib,
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { const n: nope.Point = 0; return 0; }"
  );
  let test theory: Case = t.asserts("an unknown qualifier is reported as a namespace, not a type") {
    theory.isSuccessful = diagnosticsMention(ref noSuchNs, "unknown namespace");
    theory.detail = `wanted a namespace diagnostic, got: ${firstDiagnostic(ref noSuchNs)}`;
  }
}

// ----- generics -------------------------------------------------------------

const BOX: string = "type Box<T> { value: T }\n";

suite function genericTypesInstantiateOnDemand(): void {
  let ok = checkSource(`${BOX}function main(): int { const b: Box<int> = { value: 1 }; return b.value; }`);
  let test theory: Case = t.asserts("a generic applied to an argument checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `using Box<int> reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  // The substituted field really is the argument's type, not the parameter's.
  let wrong = checkSource(`${BOX}function main(): int { const b: Box<int> = { value: "x" }; return 0; }`);
  let test theory: Case = t.asserts("a field takes the SUBSTITUTED type") {
    theory.isSuccessful = wrong.diagnostics.len > 0;
    theory.detail = "assigning a string to Box<int>.value produced no diagnostic";
  }

  // Two applications of one decl must be two DISTINCT types, or a Box<string>
  // would be interchangeable with a Box<int>. Asserted through a RETURN rather
  // than a call argument, because call arguments are not matched against
  // parameters yet - for any type, not just these.
  let mixed = checkSource(`${BOX}function f(): Box<int> { const s: Box<string> = { value: "x" }; return s; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("two instantiations are different types") {
    theory.isSuccessful = diagnosticsMention(ref mixed, "cannot return");
    theory.detail = `wanted Box<string> and Box<int> to differ, got: ${firstDiagnostic(ref mixed)}`;
  }

  // And the SAME application twice is one type, or nothing could be passed
  // between two annotations that spell it the same way.
  let same = checkSource(`${BOX}function f(): Box<int> { const b: Box<int> = { value: 1 }; return b; }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("the same application twice is ONE type") {
    theory.isSuccessful = same.diagnostics.len == 0;
    theory.detail = `two Box<int> annotations disagreed: ${firstDiagnostic(ref same)}`;
  }
}

suite function genericApplicationsAreChecked(): void {
  let bare = checkSource(`${BOX}function main(): int { const b: Box = { value: 1 }; return 0; }`);
  let test theory: Case = t.asserts("a generic used without arguments says how many it needs") {
    theory.isSuccessful = diagnosticsMention(ref bare, "needs type arguments");
    theory.detail = `wanted a missing-arguments diagnostic, got: ${firstDiagnostic(ref bare)}`;
  }

  let tooMany = checkSource(`${BOX}function main(): int { const b: Box<int, int> = { value: 1 }; return 0; }`);
  let test theory: Case = t.asserts("the wrong number of arguments is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref tooMany, "type argument(s), got");
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref tooMany)}`;
  }

  let notGeneric = checkSource("type Point { x: int }\nfunction main(): int { const p: Point<int> = { x: 1 }; return 0; }");
  let test theory: Case = t.asserts("arguments on a non-generic type are a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref notGeneric, "is not generic");
    theory.detail = `wanted a not-generic diagnostic, got: ${firstDiagnostic(ref notGeneric)}`;
  }

  // A type parameter is in scope ONLY inside its own decl's body.
  let escaped = checkSource(`${BOX}function main(): int { const t: T = 1; return 0; }`);
  let test theory: Case = t.asserts("a type parameter is not visible outside its decl") {
    theory.isSuccessful = diagnosticsMention(ref escaped, "unknown type");
    theory.detail = `wanted an unknown-type diagnostic for T, got: ${firstDiagnostic(ref escaped)}`;
  }
}

suite function genericFunctionsInferTheirTypeArguments(): void {
  const ID: string = "function identity<T>(x: T): T { return x; }\n";

  // From the ARGUMENT: nothing else mentions T.
  let fromArg = checkSource(`${ID}function main(): int { const n: int = 1; return identity(n); }`);
  let test theory: Case = t.asserts("an argument determines the type parameter") {
    theory.isSuccessful = fromArg.diagnostics.len == 0;
    theory.detail = `inferring from an argument reported: ${firstDiagnostic(ref fromArg)}`;
  }

  // From the EXPECTED type: nothing but the RETURN mentions T. This is exactly
  // `Option.None` - a payload-less case of a generic variant carries no value
  // to infer from, so the annotation is the only thing that can say which
  // instantiation it is.
  const MAKE: string = "variant Maybe<T> { Some { value: T }, Nothing }\nfunction nothing<T>(): Maybe<T> { return Maybe.Nothing; }\n";
  let fromExpected = checkSource(`${MAKE}function main(): int { const m: Maybe<int> = nothing(); return 0; }`);
  let test theory: Case = t.asserts("the expected type determines a parameter the arguments do not") {
    theory.isSuccessful = fromExpected.diagnostics.len == 0;
    theory.detail = `inferring from the expected type reported: ${firstDiagnostic(ref fromExpected)}`;
  }

  // Neither source says anything, so it has to be REFUSED rather than guessed.
  let unanchored = checkSource(`${MAKE}function main(): int { const m = nothing(); return 0; }`);
  let test theory: Case = t.asserts("a parameter nothing determines names itself") {
    theory.isSuccessful = diagnosticsMention(ref unanchored, "cannot infer \"T\"");
    theory.detail = `wanted an inference diagnostic naming T, got: ${firstDiagnostic(ref unanchored)}`;
  }

  // An inferred signature is checked like any other: once T is int32, a string
  // argument is as wrong as it would be in a concrete function.
  let mismatch = checkSource("function pairUp<T>(a: T, b: T): T { return a; }\nfunction main(): int { const n: int = 1; const s: string = \"x\"; return pairUp(n, s); }");
  let test theory: Case = t.asserts("arguments are checked against the INFERRED signature") {
    theory.isSuccessful = mismatch.diagnostics.len > 0;
    theory.detail = "passing an int and a string to pairUp<T>(a: T, b: T) produced no diagnostic";
  }

  // The BODY is checked once with T opaque. That is what catches an operation
  // no instantiation could support, without re-checking per instance.
  let opaque = checkSource("function bad<T>(x: T): T { return x + 1; }\nfunction main(): int { return 0; }");
  let test theory: Case = t.asserts("an operation an opaque T cannot support is a diagnostic") {
    theory.isSuccessful = opaque.diagnostics.len > 0;
    theory.detail = "adding 1 to an unbounded T produced no diagnostic";
  }
}

suite function genericVariantsTakeTheirInstanceFromContext(): void {
  const RESULT: string = "variant Result<T, E> { Ok { value: T }, Err { error: E } }\n";

  let ok = checkSource(`${RESULT}function main(): int { const r: Result<int, int> = Result.Ok { value: 1 }; return 0; }`);
  let test theory: Case = t.asserts("an annotated constructor resolves its instantiation") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `constructing Result<int, int> reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  // `Result<int, string>` and `Result<int, int>` share the case name `Ok`, so
  // the constructor alone cannot say which instantiation it is.
  let unanchored = checkSource(`${RESULT}function main(): int { const r = Result.Ok { value: 1 }; return 0; }`);
  let test theory: Case = t.asserts("an unannotated constructor says it cannot tell which") {
    theory.isSuccessful = diagnosticsMention(ref unanchored, "cannot tell which");
    theory.detail = `wanted a which-instantiation diagnostic, got: ${firstDiagnostic(ref unanchored)}`;
  }

  let sw = checkSource(`${RESULT}function f(r: Result<int, int>): int { switch (r) { case Result.Ok { value: v }: { return v; } case Result.Err { error: e }: { return e; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("a switch over an instance takes its patterns from the scrutinee") {
    theory.isSuccessful = sw.diagnostics.len == 0;
    theory.detail = `switching over Result<int, int> reported ${sw.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref sw)}`;
  }

  // Substitution has to reach INTO each case's payload independently.
  let payload = checkSource(`${RESULT}function f(r: Result<int, string>): int { switch (r) { case Result.Ok { value: v }: { return v; } case Result.Err { error: e }: { return e; } } }\nfunction main(): int { return 0; }`);
  let test theory: Case = t.asserts("each case's payload substitutes its own parameter") {
    // `Err`'s payload is `string` here, so returning it from an int function is
    // the error - which only shows up if E substituted independently of T.
    theory.isSuccessful = payload.diagnostics.len > 0;
    theory.detail = "returning Result<int, string>'s string payload as an int produced no diagnostic";
  }
}

// ----- variants -------------------------------------------------------------

// Everything a fixture cannot reach, because the program has to be REFUSED.
const SHAPE: string = "variant Shape { Circle { r: int }, Rect { w: int, h: int }, Empty }\n";

suite function variantsCheckTheirConstructors(): void {
  let ok = checkSource(`${SHAPE}function main(): int { const c: Shape = Shape.Circle { r: 1 }; return 0; }`);
  let test theory: Case = t.asserts("a well-formed constructor checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `constructing a case reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  let bare = checkSource(`${SHAPE}function main(): int { const c: Shape = Shape.Empty; return 0; }`);
  let test theory: Case = t.asserts("a payload-less constructor is recognized through a field access") {
    theory.isSuccessful = bare.diagnostics.len == 0;
    theory.detail = `Shape.Empty reported ${bare.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref bare)}`;
  }

  let unknown = checkSource(`${SHAPE}function main(): int { const c: Shape = Shape.Oval { r: 1 }; return 0; }`);
  let test theory: Case = t.asserts("an unknown case names the variant") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "has no case");
    theory.detail = `wanted a no-such-case diagnostic, got: ${firstDiagnostic(ref unknown)}`;
  }

  let short = checkSource(`${SHAPE}function main(): int { const c: Shape = Shape.Rect { w: 1 }; return 0; }`);
  let test theory: Case = t.asserts("a payload missing a field is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref short, "field(s), got");
    theory.detail = `wanted a field-count diagnostic, got: ${firstDiagnostic(ref short)}`;
  }

  let wrongType = checkSource(`${SHAPE}function main(): int { const c: Shape = Shape.Circle { r: "x" }; return 0; }`);
  let test theory: Case = t.asserts("a payload field of the wrong type is a diagnostic") {
    theory.isSuccessful = wrongType.diagnostics.len > 0;
    theory.detail = "a string in an int field produced no diagnostic";
  }
}

suite function variantSwitchesMustBeExhaustive(): void {
  const covered = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Circle { r: r }: { return r; } case Shape.Rect { w: w, h: h }: { return w; } case Shape.Empty: { return 0; } } }\nfunction main(): int { return 0; }`;
  let ok = checkSource(covered);
  let test theory: Case = t.asserts("covering every case needs no default") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `an exhaustive switch reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  // The missing case is NAMED, because "not exhaustive" on a ten-case variant
  // is a worse message than the compiler can afford to give.
  const missing = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Circle { r: r }: { return r; } case Shape.Rect { w: w, h: h }: { return w; } } }\nfunction main(): int { return 0; }`;
  let gap = checkSource(missing);
  let test theory: Case = t.asserts("a missing case is named") {
    theory.isSuccessful = diagnosticsMention(ref gap, "does not cover \"Empty\"");
    theory.detail = `wanted the missing case named, got: ${firstDiagnostic(ref gap)}`;
  }

  // A default that can never run is dead code, and usually a misspelled case.
  const both = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Circle { r: r }: { return r; } case Shape.Rect { w: w, h: h }: { return w; } case Shape.Empty: { return 0; } default: { return -1; } } }\nfunction main(): int { return 0; }`;
  let dead = checkSource(both);
  let test theory: Case = t.asserts("a default on an exhaustive switch is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref dead, "can never run");
    theory.detail = `wanted a dead-default diagnostic, got: ${firstDiagnostic(ref dead)}`;
  }

  const twice = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Circle { r: r }: { return r; } case Shape.Circle { r: q }: { return q; } default: { return 0; } } }\nfunction main(): int { return 0; }`;
  let dup = checkSource(twice);
  let test theory: Case = t.asserts("matching one case twice is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref dup, "matched twice");
    theory.detail = `wanted a duplicate-case diagnostic, got: ${firstDiagnostic(ref dup)}`;
  }
}

suite function variantPatternsBindTheirPayload(): void {
  const usesBinding = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Rect { w: w, h: h }: { return w * h; } default: { return 0; } } }\nfunction main(): int { return 0; }`;
  let ok = checkSource(usesBinding);
  let test theory: Case = t.asserts("a bound payload field is readable in the arm") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reading a binding reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  // The binding is arm-LOCAL, exactly like any other name declared in a block.
  const escapes = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Circle { r: r }: { return r; } default: { return 0; } } return r; }\nfunction main(): int { return 0; }`;
  let leaked = checkSource(escapes);
  let test theory: Case = t.asserts("a binding is not visible after the switch") {
    theory.isSuccessful = leaked.diagnostics.len > 0;
    theory.detail = "a pattern binding survived its arm";
  }

  // A case that grows a field should break its patterns loudly rather than
  // leave one silently unbound.
  const partial = `${SHAPE}function f(s: Shape): int { switch (s) { case Shape.Rect { w: w }: { return w; } default: { return 0; } } }\nfunction main(): int { return 0; }`;
  let half = checkSource(partial);
  let test theory: Case = t.asserts("binding only some of a case's fields is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref half, "must bind all of them");
    theory.detail = `wanted a bind-all diagnostic, got: ${firstDiagnostic(ref half)}`;
  }
}

suite function variantAndIntegerSwitchesDoNotMix(): void {
  const intPattern = `${SHAPE}function f(s: Shape): int { switch (s) { case 1: { return 1; } default: { return 0; } } }\nfunction main(): int { return 0; }`;
  let wrong = checkSource(intPattern);
  let test theory: Case = t.asserts("a literal pattern on a variant switch is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref wrong, "must be variant cases");
    theory.detail = `wanted a pattern-kind diagnostic, got: ${firstDiagnostic(ref wrong)}`;
  }

  const casePattern = "function f(n: int): int { switch (n) { case Shape.Circle { r: r }: { return r; } default: { return 0; } } }\nfunction main(): int { return 0; }";
  let alsoWrong = checkSource(casePattern);
  let test theory: Case = t.asserts("a variant pattern on an integer switch is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref alsoWrong, "must be literals");
    theory.detail = `wanted a pattern-kind diagnostic, got: ${firstDiagnostic(ref alsoWrong)}`;
  }

  const otherVariant = `${SHAPE}variant Other { A, B }\nfunction f(s: Shape): int { switch (s) { case Other.A: { return 1; } default: { return 0; } } }\nfunction main(): int { return 0; }`;
  let mixed = checkSource(otherVariant);
  let test theory: Case = t.asserts("a pattern from another variant is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref mixed, "the pattern matches");
    theory.detail = `wanted a wrong-variant diagnostic, got: ${firstDiagnostic(ref mixed)}`;
  }
}

// The first diagnostic message, for failure detail. "" when there are none.
// How many of the accumulated diagnostics are ERRORS. A warning is not one,
// which is the whole point of the advisory ones.
function errorCount(ref prog: Program): usize {
  let n: usize = 0;
  let i: usize = 0;
  while (i < prog.diagnostics.len) {
    switch (vec.vecGet(ref prog.diagnostics, i).severity) {
      case Severity.ERROR: { n = n + 1; }
      default: {}
    }
    i = i + 1;
  }
  return n;
}

function firstDiagnostic(ref prog: Program): string {
  if (prog.diagnostics.len == 0) {
    return "";
  }
  return vec.vecGet(ref prog.diagnostics, 0).message;
}

// True when any diagnostic names `needle`. A refusal with the wrong message
// sends the reader somewhere else, so the text is part of the assertion.
function diagnosticsMention(ref prog: Program, needle: string): bool {
  let i: usize = 0;
  while (i < prog.diagnostics.len) {
    const message = vec.vecGet(ref prog.diagnostics, i).message;
    if (str.stringIndexOf(message, needle) < message.len) {
      return true;
    }
    i += 1;
  }
  return false;
}

// ----- pass B: imports -------------------------------------------------------

suite function importsBindTheSourceModulesSymbol(): void {
  let prog = checkTwoModules(
    "export function add(a: int, b: int): int { return a + b; }",
    "import { add } from \"./lib.yoop\";\nfunction main(): int { return add(1, 2); }"
  );

  let test theory: Case = t.asserts("an imported function is callable") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `calling an imported function reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }

  // The point of binding the SymbolId rather than copying anything: one symbol,
  // named from two modules.
  let test theory: Case = t.asserts("both modules name the same SymbolId") {
    theory.isSuccessful = symbolIdIn(ref prog, 0, "add") == symbolIdIn(ref prog, 1, "add")
      && symbolIdIn(ref prog, 1, "add") != 0;
    theory.detail = `lib has SymbolId ${symbolIdIn(ref prog, 0, "add")} for "add" and the entry has ${symbolIdIn(ref prog, 1, "add")}`;
  }
}

suite function importedTypesKeepTheirIdentity(): void {
  let prog = checkTwoModules(
    "export type Point { x: int, y: int }",
    "import { Point } from \"./lib.yoop\";\nfunction main(): int { const p: Point = { x: 1, y: 2 }; return p.x; }"
  );

  let test theory: Case = t.asserts("an imported type resolves in an annotation and a literal") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `using an imported type reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }

  // Type equality is `id == id`. A second nominal type for the imported Point
  // would make every value passed between the two modules a type error, so this
  // is the assertion the whole import design exists to satisfy.
  let test theory: Case = t.asserts("the imported Point IS the declared Point") {
    theory.isSuccessful = symbolIdIn(ref prog, 0, "Point") == symbolIdIn(ref prog, 1, "Point")
      && symbolIdIn(ref prog, 1, "Point") != 0;
    theory.detail = `lib has SymbolId ${symbolIdIn(ref prog, 0, "Point")} for "Point" and the entry has ${symbolIdIn(ref prog, 1, "Point")}`;
  }
}

suite function importAliasesBindTheLocalName(): void {
  let prog = checkTwoModules(
    "export function scale(n: int): int { return n * 2; }",
    "import { scale as times } from \"./lib.yoop\";\nfunction main(): int { return times(2); }"
  );

  let test theory: Case = t.asserts("the alias is callable") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `calling through an alias reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }

  let test theory: Case = t.asserts("the export name is NOT bound alongside the alias") {
    theory.isSuccessful = symbolIdIn(ref prog, 1, "scale") == 0;
    theory.detail = "`scale as times` bound `scale` too; an alias replaces the name, it does not add one";
  }

  let original = checkTwoModules(
    "export function scale(n: int): int { return n * 2; }",
    "import { scale as times } from \"./lib.yoop\";\nfunction main(): int { return scale(2); }"
  );
  let test theory: Case = t.asserts("calling the export name through an alias is a diagnostic") {
    theory.isSuccessful = original.diagnostics.len > 0;
    theory.detail = "calling `scale` when only `times` was bound produced no diagnostic";
  }
}

suite function importsOfNamesTheSourceDoesNotOfferAreRefused(): void {
  let unexported = checkTwoModules(
    "function hidden(): int { return 1; }\nexport function shown(): int { return 2; }",
    "import { hidden } from \"./lib.yoop\";\nfunction main(): int { return hidden(); }"
  );
  // "has no export hidden" would send the reader hunting for a typo in a name
  // that is right there in the file, so the two cases get different messages.
  let test theory: Case = t.asserts("importing a declared-but-unexported name says to add `export`") {
    theory.isSuccessful = diagnosticsMention(ref unexported, "not exported");
    theory.detail = `wanted a diagnostic about the missing \`export\`, got: ${firstDiagnostic(ref unexported)}`;
  }

  let missing = checkTwoModules(
    "export function shown(): int { return 2; }",
    "import { nope } from \"./lib.yoop\";\nfunction main(): int { return nope(); }"
  );
  let test theory: Case = t.asserts("importing a name that does not exist says the module has no such export") {
    theory.isSuccessful = diagnosticsMention(ref missing, "has no export");
    theory.detail = `wanted a "has no export" diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }
}

suite function stdValueImportsMustUseTheNamespaceForm(): void {
  // Common std function names - `info`, `error`, `panic`, `get` - would compete
  // with the user's own identifiers if they could be imported bare, and
  // `log.error(...)` says where it came from at every call site. Same rule, and
  // the same message, as src/jsyooptypecheck/imports.js.
  let value = checkTwoModules(
    "export function twice(n: int): int { return n * 2; }",
    "import { twice } from \"std/core/tiny.yoop\";\nfunction main(): int { return twice(1); }"
  );
  let test theory: Case = t.asserts("a bare value import from std is refused") {
    theory.isSuccessful = diagnosticsMention(ref value, "must use the namespace form");
    theory.detail = `wanted a namespace-form diagnostic, got: ${firstDiagnostic(ref value)}`;
  }

  // Types are exempt: capitalized, far fewer of them, and `Vec` reads worse as
  // `vec.Vec`.
  let typeImport = checkTwoModules(
    "export type Span { start: int, len: int }",
    "import { Span } from \"std/core/tiny.yoop\";\nfunction main(): int { const s: Span = { start: 1, len: 2 }; return s.len; }"
  );
  let test theory: Case = t.asserts("a TYPE import from std is allowed") {
    theory.isSuccessful = typeImport.diagnostics.len == 0;
    theory.detail = `importing a std type reported ${typeImport.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref typeImport)}`;
  }

  // The rule is about std, not about imports. A user module's values import
  // bare, which is what every other fixture here relies on.
  let user = checkTwoModules(
    "export function twice(n: int): int { return n * 2; }",
    "import { twice } from \"./lib.yoop\";\nfunction main(): int { return twice(1); }"
  );
  let test theory: Case = t.asserts("a bare value import from a USER module is fine") {
    theory.isSuccessful = user.diagnostics.len == 0;
    theory.detail = `a user-module value import reported ${user.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref user)}`;
  }
}

suite function namespacesReachAModulesExports(): void {
  let prog = checkTwoModules(
    "export function add(a: int, b: int): int { return a + b; }",
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { return lib.add(1, 2); }"
  );

  let test theory: Case = t.asserts("a qualified call resolves and types") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `calling through a namespace reported ${prog.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref prog)}`;
  }

  // A namespace binds ONE name. `add` on its own must still be unknown, or the
  // namespace would be a second, invisible way to import every export.
  let test theory: Case = t.asserts("a namespace does not bind its members") {
    theory.isSuccessful = symbolIdIn(ref prog, 1, "add") == 0 && symbolIdIn(ref prog, 1, "lib") != 0;
    theory.detail = "importing `* as lib` bound `add` directly too";
  }
}

suite function namespaceMembersRespectExport(): void {
  // The rule that makes a namespace safe: it reaches the source module's
  // EXPORTS, not its names, so `ns.hidden()` fails exactly as `import { hidden }`
  // does rather than being a way around the keyword.
  let hidden = checkTwoModules(
    "function hidden(): int { return 1; }\nexport function shown(): int { return 2; }",
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { return lib.hidden(); }"
  );
  let test theory: Case = t.asserts("an unexported member says to add `export`") {
    theory.isSuccessful = diagnosticsMention(ref hidden, "not exported");
    theory.detail = `wanted a diagnostic about the missing \`export\`, got: ${firstDiagnostic(ref hidden)}`;
  }

  let missing = checkTwoModules(
    "export function shown(): int { return 2; }",
    "import * as lib from \"./lib.yoop\";\nfunction main(): int { return lib.nope(); }"
  );
  let test theory: Case = t.asserts("a member that does not exist names the namespace") {
    theory.isSuccessful = diagnosticsMention(ref missing, "has no export");
    theory.detail = `wanted a "has no export" diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }

  // `p.x(...)` on a struct local reaches the qualified-call path too, since the
  // parser cannot tell the two apart. It has to say something better than
  // "has no export".
  let notNamespace = checkTwoModules(
    "export type Point { x: int, y: int }",
    "import { Point } from \"./lib.yoop\";\nfunction main(): int { const p: Point = { x: 1, y: 2 }; return p.x(); }"
  );
  let test theory: Case = t.asserts("qualifying a call with something that is not a namespace says so") {
    theory.isSuccessful = diagnosticsMention(ref notNamespace, "not an imported namespace");
    theory.detail = `wanted a not-a-namespace diagnostic, got: ${firstDiagnostic(ref notNamespace)}`;
  }

  let unknownBase = checkTwoModules(
    "export function shown(): int { return 2; }",
    "function main(): int { return nope.shown(); }"
  );
  let test theory: Case = t.asserts("an unknown qualifying name is an unknown name") {
    theory.isSuccessful = diagnosticsMention(ref unknownBase, "unknown name");
    theory.detail = `wanted an unknown-name diagnostic, got: ${firstDiagnostic(ref unknownBase)}`;
  }
}

suite function aNamespaceMayNotCollideWithALocalDeclaration(): void {
  let prog = checkTwoModules(
    "export function add(a: int, b: int): int { return a + b; }",
    "import * as tag from \"./lib.yoop\";\nfunction tag(): int { return 2; }\nfunction main(): int { return tag(); }"
  );

  let test theory: Case = t.asserts("a namespace name this module already declares is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref prog, "collides");
    theory.detail = `wanted a collision diagnostic, got: ${firstDiagnostic(ref prog)}`;
  }
}

suite function diagnosticsNameTheFileTheyCameFrom(): void {
  // A bare "12:5" is a real location in every file of the program at once. Once
  // a module can span files it is not even enough to know which MODULE, so the
  // path is stamped on rather than reconstructed by the reader.
  let prog = checkTwoModules(
    "export function shown(): int { return 2; }",
    "import { shown } from \"./lib.yoop\";\nfunction main(): int { return nope; }"
  );

  let test theory: Case = t.asserts("an error carries the file it was found in") {
    theory.isSuccessful = prog.diagnostics.len > 0
      && str.stringEq(vec.vecGet(ref prog.diagnostics, 0).filePath, "entry.yoop");
    theory.detail = `the diagnostic names file "${firstDiagnosticFile(ref prog)}", wanted "entry.yoop"`;
  }

  // The error is in the LIBRARY this time, so the two must not be confused.
  let inLib = checkTwoModules(
    "export function shown(): int { return nope; }",
    "import { shown } from \"./lib.yoop\";\nfunction main(): int { return shown(); }"
  );
  let test theory: Case = t.asserts("an error in an imported module names THAT file") {
    theory.isSuccessful = inLib.diagnostics.len > 0
      && str.stringEq(vec.vecGet(ref inLib.diagnostics, 0).filePath, "lib.yoop");
    theory.detail = `the diagnostic names file "${firstDiagnosticFile(ref inLib)}", wanted "lib.yoop"`;
  }
}

function firstDiagnosticFile(ref prog: Program): string {
  if (prog.diagnostics.len == 0) {
    return "";
  }
  return vec.vecGet(ref prog.diagnostics, 0).filePath;
}

suite function onlyTheEntryModuleMayDeclareMain(): void {
  let prog = checkTwoModules(
    "export function main(): int { return 1; }",
    "import { main as libMain } from \"./lib.yoop\";\nfunction main(): int { return libMain(); }"
  );

  // `main` is the one symbol that keeps its bare C name, so two of them emit
  // two `@main`. The linker would catch it, naming object files rather than
  // source lines.
  let test theory: Case = t.asserts("an imported module declaring main is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref prog, "only the entry module may declare");
    theory.detail = `wanted a diagnostic about a second main, got: ${firstDiagnostic(ref prog)}`;
  }
}

suite function anImportMayNotCollideWithALocalDeclaration(): void {
  let prog = checkTwoModules(
    "export function tag(): int { return 1; }",
    "import { tag } from \"./lib.yoop\";\nfunction tag(): int { return 2; }\nfunction main(): int { return tag(); }"
  );

  let test theory: Case = t.asserts("importing a name this module already declares is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref prog, "collides");
    theory.detail = `wanted a collision diagnostic, got: ${firstDiagnostic(ref prog)}`;
  }
}

// The SymbolId bound to `name` in module `index`, or 0 (the never-handed-out
// sentinel) when the name is not bound there.
function symbolIdIn(ref prog: Program, index: usize, name: string): usize {
  if (index >= prog.modules.len) {
    return 0;
  }
  let tm = vec.vecGet(ref prog.modules, index);
  switch (map.mapGet(ref tm.names, name)) {
    case Option.Some { value: symId }: { return symId; }
    case Option.None: { return 0; }
  }
}

// A two-module graph built by hand: the library at index 0 and the entry at
// index 1, with the entry's import edges pointed at index 0.
//
// That is exactly the shape walk.yoop produces from the filesystem, minus the
// filesystem - which is what lets pass B be driven from source literals here
// while the slice fixture covers the real path end to end.
function checkTwoModules(libSrc: string, entrySrc: string): Program propagates<disposable> {
  let lib: Module;
  switch (moduleFromSource("lib_0", "lib.yoop", bufferOf(libSrc))) {
    case LoadModuleResult.Err { error: e }: { return parseFailureProgram(e); }
    case LoadModuleResult.Ok { value: m }: { lib = m; }
  }
  let entry: Module;
  switch (moduleFromSource("entry_1", "entry.yoop", bufferOf(entrySrc))) {
    case LoadModuleResult.Err { error: e }: { return parseFailureProgram(e); }
    case LoadModuleResult.Ok { value: m }: { entry = m; }
  }

  // Every IMPORT_DECL in the entry resolves to the one library module. The edge
  // list belongs to the FILE, so it is read back out of the Vec and written
  // whole - pushing into a copy would leave the module with no edges at all.
  let entryFile = vec.vecGet(ref entry.files, 0);
  const program = nodeAt(ref entry.ast, entryFile.root);
  let i: usize = 0;
  while (i < program.childCount) {
    const declId = childAt(ref entry.ast, program, i);
    if (nodeAt(ref entry.ast, declId).kind != ASTNodeKind.IMPORT_DECL) {
      break;
    }
    vec.vecPush(ref entryFile.imports, {
      nodeId: declId,
      resolvedModuleIndex: 0,
      resolvedModuleId: "lib_0",
    });
    i += 1;
  }
  vec.vecSet(ref entry.files, 0, entryFile);

  let modules: Vec<Module> = vec.vecNew(2);
  vec.vecPush(ref modules, lib);
  vec.vecPush(ref modules, entry);
  let autoLoads: Map<string, string> = map.mapNew(0, map.stringKeyOps());
  let graph: ModuleGraph = {
    modules: modules,
    entryIndex: 1,
    autoLoadModuleIds: autoLoads,
  };
  return typecheckProgram(ref graph);
}

function bufferOf(src: string): Vec<uint8> propagates<disposable> {
  let buf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref buf, intr.stringAsBytes(src));
  return buf;
}

// A parse failure has to come back as a DIAGNOSTIC, not as an empty Program -
// see the note in checkSource.
function parseFailureProgram(message: string): Program propagates<disposable> {
  // A REAL Program with one diagnostic in it, rather than a hand-built literal.
  // initProgram is where the arenas and their reserved slots are decided, and a
  // literal here went stale every time one of them was added.
  let prog = initProgram();
  vec.vecPush(ref prog.diagnostics, errorAt(message, { pos: 0, line: 0, column: 0, length: 0 }));
  return prog;
}

// Control flow: the parts that never reach an executable.
suite function controlFlowChecksConditions(): void {
  let ok = checkSource("function main(): int { if (1 < 2) { return 1; } return 0; }");
  let test theory: Case = t.asserts("a comparison is a valid condition") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `a comparison condition reported ${ok.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref ok)}`;
  }

  let bad = checkSource("function main(): int { if (1) { return 1; } return 0; }");
  let test theory: Case = t.asserts("an int condition is a diagnostic") {
    theory.isSuccessful = bad.diagnostics.len > 0;
    theory.detail = "a non-bool condition produced no diagnostic";
  }

  let loop = checkSource("function main(): int { let i: int = 0; while (i < 3) { i = i + 1; } return i; }");
  let test theory: Case = t.asserts("a while loop with an assignment checks clean") {
    theory.isSuccessful = loop.diagnostics.len == 0;
    theory.detail = `the loop reported ${loop.diagnostics.len} diagnostic(s): ${firstDiagnostic(ref loop)}`;
  }
}

suite function blockScopingIsEnforced(): void {
  // A name declared inside a branch must not survive the branch, or codegen
  // would read a slot that only one path ever wrote.
  let leaked = checkSource("function main(): int { if (1 < 2) { const a = 1; } return a; }");
  let test theory: Case = t.asserts("a branch-local name is not visible after the branch") {
    theory.isSuccessful = leaked.diagnostics.len > 0;
    theory.detail = "reading a branch-local after the branch produced no diagnostic";
  }

  // Sibling branches are separate scopes, so reusing the name is fine.
  let siblings = checkSource("function main(): int { if (1 < 2) { const a = 1; } else { const a = 2; } return 0; }");
  let test theory: Case = t.asserts("sibling branches may reuse a name") {
    theory.isSuccessful = siblings.diagnostics.len == 0;
    theory.detail = `sibling branches reusing a name reported ${siblings.diagnostics.len}: ${firstDiagnostic(ref siblings)}`;
  }
}

suite function assignmentIsChecked(): void {
  let unknown = checkSource("function main(): int { nope = 1; return 0; }");
  let test theory: Case = t.asserts("assigning to an undeclared name is a diagnostic") {
    theory.isSuccessful = unknown.diagnostics.len > 0;
    theory.detail = "assigning to an undeclared name produced no diagnostic";
  }

  let mismatch = checkSource("function main(): int { let s: string = \"a\"; s = 1; return 0; }");
  let test theory: Case = t.asserts("assigning the wrong type is a diagnostic") {
    theory.isSuccessful = mismatch.diagnostics.len > 0;
    theory.detail = "assigning an int to a string local produced no diagnostic";
  }
}

suite function loopJumpsNeedALoop(): void {
  let outside = checkSource("function main(): int { break; return 0; }");
  let test theory: Case = t.asserts("break outside a loop is a diagnostic") {
    theory.isSuccessful = outside.diagnostics.len > 0;
    theory.detail = "break at function level produced no diagnostic";
  }

  let outsideCont = checkSource("function main(): int { continue; return 0; }");
  let test theory: Case = t.asserts("continue outside a loop is a diagnostic") {
    theory.isSuccessful = outsideCont.diagnostics.len > 0;
    theory.detail = "continue at function level produced no diagnostic";
  }

  // Inside an `if` that is itself inside a loop still counts as in the loop.
  let nested = checkSource("function main(): int { let i: int = 0; while (i < 3) { if (i == 1) { break; } i = i + 1; } return i; }");
  let test theory: Case = t.asserts("break inside a branch inside a loop is fine") {
    theory.isSuccessful = nested.diagnostics.len == 0;
    theory.detail = `break inside a nested branch reported ${nested.diagnostics.len}: ${firstDiagnostic(ref nested)}`;
  }

  // The depth has to come back down when the loop closes.
  let after = checkSource("function main(): int { let i: int = 0; while (i < 1) { i = i + 1; } break; return 0; }");
  let test theory: Case = t.asserts("break after a loop closes is still a diagnostic") {
    theory.isSuccessful = after.diagnostics.len > 0;
    theory.detail = "break after the loop produced no diagnostic - loopDepth did not unwind";
  }

  // A switch is a BREAKABLE scope with no loop anywhere in sight - `break`
  // leaves the switch, which is the reference's rule.
  let inSwitch = checkSource("function main(): int { let n: int32 = 1; switch (n) { case 1: { break; } default: { } } return 0; }");
  let test theory: Case = t.asserts("`break` in a switch arm needs no loop") {
    theory.isSuccessful = inSwitch.diagnostics.len == 0;
    theory.detail = `break in a switch arm reported ${inSwitch.diagnostics.len}: ${firstDiagnostic(ref inSwitch)}`;
  }

  // ...and a bare `break` with nothing around it is still a diagnostic, which
  // is what keeps the switch depth from being a blanket permit.
  let bare = checkSource("function main(): int { break; return 0; }");
  let test theory: Case = t.asserts("a bare `break` still needs a loop or a switch") {
    theory.isSuccessful = diagnosticsMention(ref bare, "is only legal inside a loop or a switch");
    theory.detail = `wanted the break message, got: ${firstDiagnostic(ref bare)}`;
  }

  // `continue` is the half that is NOT symmetric: a switch is a break target
  // only, so `continue` keeps needing a loop and the reference refuses it here
  // too. The two counters exist for exactly this pair of asserts.
  let contInSwitch = checkSource("function main(): int { let n: int32 = 1; switch (n) { case 1: { continue; } default: { } } return 0; }");
  let test theory: Case = t.asserts("`continue` in a switch arm still needs a loop") {
    theory.isSuccessful = diagnosticsMention(ref contInSwitch, "\"continue\" is only legal inside a loop");
    theory.detail = `wanted the loop message for continue, got: ${firstDiagnostic(ref contInSwitch)}`;
  }

  // ...and it is fine again as soon as there IS one around the switch, which is
  // the lookup past the switch frame rather than a permit.
  let contInSwitchInLoop = checkSource("function main(): int { let i: int32 = 0; while (i < 3) { i = i + 1; switch (i) { case 1: { continue; } default: { } } } return 0; }");
  let test theory: Case = t.asserts("`continue` in a switch arm inside a loop is fine") {
    theory.isSuccessful = contInSwitchInLoop.diagnostics.len == 0;
    theory.detail = `reported ${contInSwitchInLoop.diagnostics.len}: ${firstDiagnostic(ref contInSwitchInLoop)}`;
  }

  // The switch depth unwinds when the arm closes, the same way the loop depth
  // does - a `break` after the whole switch is back to needing a loop.
  let afterSwitch = checkSource("function main(): int { let n: int32 = 1; switch (n) { case 1: { } default: { } } break; return 0; }");
  let test theory: Case = t.asserts("a `break` after a switch closes is still a diagnostic") {
    theory.isSuccessful = afterSwitch.diagnostics.len > 0;
    theory.detail = "break after the switch produced no diagnostic - switchDepth did not unwind";
  }

  // The switch depth unwinds too: a `break` in a loop that CONTAINS a switch is
  // still fine, and one after the switch closes is still the loop message.
  let switchInLoop = checkSource("function main(): int { let i: int32 = 0; while (i < 1) { switch (i) { case 0: { i = 1; } default: { } } break; } return 0; }");
  let test theory: Case = t.asserts("a `break` after a switch inside a loop is unaffected") {
    theory.isSuccessful = switchInLoop.diagnostics.len == 0;
    theory.detail = `reported ${switchInLoop.diagnostics.len}: ${firstDiagnostic(ref switchInLoop)}`;
  }
}

suite function forLoopScopesItsCounter(): void {
  let ok = checkSource("function main(): int { let t: int = 0; for (let i = 0; i < 3; i = i + 1) { t = t + i; } return t; }");
  let test theory: Case = t.asserts("a for loop with a declared counter checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `the for loop reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let leaked = checkSource("function main(): int { for (let i = 0; i < 3; i = i + 1) { } return i; }");
  let test theory: Case = t.asserts("the counter is not visible after the loop") {
    theory.isSuccessful = leaked.diagnostics.len > 0;
    theory.detail = "reading the counter after the loop produced no diagnostic";
  }

  let constCounter = checkSource("function main(): int { for (const i = 0; i < 3; i = i + 1) { } return 0; }");
  let test theory: Case = t.asserts("a const counter is refused") {
    theory.isSuccessful = constCounter.diagnostics.len > 0;
    theory.detail = "a const for-loop counter produced no diagnostic";
  }
}

suite function logicalAndUnaryAreTyped(): void {
  let ok = checkSource("function main(): int { const a = true && !false; if (a) { return 1; } return 0; }");
  let test theory: Case = t.asserts("bool literals, ! and && compose cleanly") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let notInt = checkSource("function main(): int { const a = !5; return 0; }");
  let test theory: Case = t.asserts("! on an int is a diagnostic") {
    theory.isSuccessful = notInt.diagnostics.len > 0;
    theory.detail = "applying ! to an int produced no diagnostic";
  }

  let andInt = checkSource("function main(): int { const a = 1 && 2; return 0; }");
  let test theory: Case = t.asserts("&& on ints is a diagnostic") {
    theory.isSuccessful = andInt.diagnostics.len > 0;
    theory.detail = "&& over ints produced no diagnostic";
  }

  let negBool = checkSource("function main(): int { const a = -true; return 0; }");
  let test theory: Case = t.asserts("unary - on a bool is a diagnostic") {
    theory.isSuccessful = negBool.diagnostics.len > 0;
    theory.detail = "negating a bool produced no diagnostic";
  }

  // A comparison already yields bool, so this is the common real-world shape.
  let chained = checkSource("function main(): int { let n: int = 5; if (n > 1 && n < 10) { return 1; } return 0; }");
  let test theory: Case = t.asserts("a range check composes two comparisons") {
    theory.isSuccessful = chained.diagnostics.len == 0;
    theory.detail = `reported ${chained.diagnostics.len}: ${firstDiagnostic(ref chained)}`;
  }
}

suite function compoundAssignmentDesugars(): void {
  let ok = checkSource("function main(): int { let n: int = 1; n += 2; n *= 3; return n; }");
  let test theory: Case = t.asserts("compound assignment checks like the expanded form") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let badType = checkSource("function main(): int { let s: string = \"a\"; s += 1; return 0; }");
  let test theory: Case = t.asserts("compound assignment still type-checks the operands") {
    theory.isSuccessful = badType.diagnostics.len > 0;
    theory.detail = "adding an int to a string local produced no diagnostic";
  }
}

suite function arraysAreTyped(): void {
  // `.len` is usize, so it does not mix with an int32 element without a cast -
  // the JS reference rejects that too. Keep the widths apart here.
  let ok = checkSource("function main(): int { const xs: int[] = [1, 2, 3]; let n: usize = xs.len; return xs[0]; }");
  let test theory: Case = t.asserts("a literal, an index and .len compose") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Structural interning: two separate `int[]` annotations must be the SAME
  // TypeId, or passing one to the other is a spurious mismatch.
  let passed = checkSource("function take(xs: int[]): usize { return xs.len; } function main(): int { const ys: int[] = [1]; return 0; }");
  let test theory: Case = t.asserts("two int[] annotations are the same type") {
    theory.isSuccessful = passed.diagnostics.len == 0;
    theory.detail = `passing int[] to an int[] parameter reported ${passed.diagnostics.len}: ${firstDiagnostic(ref passed)}`;
  }

  let mixed = checkSource("function main(): int { const xs = [1, true]; return 0; }");
  let test theory: Case = t.asserts("mixed element types are a diagnostic") {
    theory.isSuccessful = mixed.diagnostics.len > 0;
    theory.detail = "an array of an int and a bool produced no diagnostic";
  }

  let emptyBare = checkSource("function main(): int { const xs = []; return 0; }");
  let test theory: Case = t.asserts("an unannotated empty literal is a diagnostic") {
    theory.isSuccessful = emptyBare.diagnostics.len > 0;
    theory.detail = "an empty literal with nothing to infer from produced no diagnostic";
  }

  let indexNonArray = checkSource("function main(): int { let n: int = 1; return n[0]; }");
  let test theory: Case = t.asserts("indexing a non-array is a diagnostic") {
    theory.isSuccessful = indexNonArray.diagnostics.len > 0;
    theory.detail = "indexing an int produced no diagnostic";
  }

  let badField = checkSource("function main(): int { const xs: int[] = [1]; return xs.size; }");
  let test theory: Case = t.asserts("an unknown array field is a diagnostic") {
    theory.isSuccessful = badField.diagnostics.len > 0;
    theory.detail = "xs.size produced no diagnostic";
  }

  // The desugaring re-reads the target, so it needs a SUBSCRIPT that is free
  // to read twice. A literal is, and so is a name.
  let compoundIndex = checkSource("function main(): int { let xs: int[] = [1]; xs[0] += 1; return xs[0]; }");
  let test theory: Case = t.asserts("compound assignment to an element with a literal subscript works") {
    theory.isSuccessful = compoundIndex.diagnostics.len == 0;
    theory.detail = `xs[0] += 1 reported: ${firstDiagnostic(ref compoundIndex)}`;
  }

  let compoundIndexName = checkSource(
    "function main(): int { let xs: int[] = [1]; let i: usize = 0; xs[i] += 1; return xs[i]; }"
  );
  let test theory: Case = t.asserts("a NAME subscript works too") {
    theory.isSuccessful = compoundIndexName.diagnostics.len == 0;
    theory.detail = `xs[i] += 1 reported: ${firstDiagnostic(ref compoundIndexName)}`;
  }
}

suite function integerWidthsStayApart(): void {
  // usize and int32 are different types, matching the JS reference. The
  // diagnostic has to NAME both, or a width mismatch is a guessing game.
  let mixed = checkSource("function main(): int { const xs: int[] = [1]; return xs[0] + xs.len; }");
  let test theory: Case = t.asserts("mixing int32 and usize in + is a diagnostic") {
    theory.isSuccessful = mixed.diagnostics.len > 0;
    theory.detail = "adding an int32 element to a usize length produced no diagnostic";
  }

  let badReturn = checkSource("function f(xs: int[]): int { return xs.len; } function main(): int { return 0; }");
  let test theory: Case = t.asserts("returning usize from an int function is a diagnostic") {
    theory.isSuccessful = badReturn.diagnostics.len > 0;
    theory.detail = "returning a usize as int32 produced no diagnostic";
  }
}

suite function castsAreChecked(): void {
  let ok = checkSource("function main(): int { const xs: int[] = [1]; return int(xs.len); }");
  let test theory: Case = t.asserts("a cast makes widths mix") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `int(xs.len) reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let twoArgs = checkSource("function main(): int { return int(1, 2); }");
  let test theory: Case = t.asserts("a cast takes exactly one argument") {
    theory.isSuccessful = twoArgs.diagnostics.len > 0;
    theory.detail = "int(1, 2) produced no diagnostic";
  }

  let fromBool = checkSource("function main(): int { return int(true); }");
  let test theory: Case = t.asserts("casting a bool to an int is a diagnostic") {
    theory.isSuccessful = fromBool.diagnostics.len > 0;
    theory.detail = "int(true) produced no diagnostic - only numeric casts are supported";
  }

  let fromArray = checkSource("function main(): int { const xs: int[] = [1]; return int(xs); }");
  let test theory: Case = t.asserts("casting an array is a diagnostic") {
    theory.isSuccessful = fromArray.diagnostics.len > 0;
    theory.detail = "int(xs) produced no diagnostic";
  }

  // A cast target is a TYPE name, so it must not be shadowed by the symbol
  // lookup that handles ordinary calls.
  let notACall = checkSource("function main(): int { let n: int64 = int64(1); return int(n); }");
  let test theory: Case = t.asserts("a primitive name is a cast, not an unknown function") {
    theory.isSuccessful = notACall.diagnostics.len == 0;
    theory.detail = `reported ${notACall.diagnostics.len}: ${firstDiagnostic(ref notACall)}`;
  }
}

suite function switchesAreChecked(): void {
  let ok = checkSource("function main(): int { switch (1) { case 1: { return 1; } default: { return 0; } } }");
  let test theory: Case = t.asserts("an integer switch with a default checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // An integer switch can never be exhaustive, so the default is required.
  let noDefault = checkSource("function main(): int { switch (1) { case 1: { return 1; } } return 0; }");
  let test theory: Case = t.asserts("an integer switch without a default is a diagnostic") {
    theory.isSuccessful = noDefault.diagnostics.len > 0;
    theory.detail = "a switch with no default produced no diagnostic";
  }

  let twoDefaults = checkSource("function main(): int { switch (1) { default: { return 1; } default: { return 2; } } }");
  let test theory: Case = t.asserts("two default arms is a diagnostic") {
    theory.isSuccessful = twoDefaults.diagnostics.len > 0;
    theory.detail = "two defaults produced no diagnostic";
  }

  let overBool = checkSource("function main(): int { switch (true) { case 1: { return 1; } default: { return 0; } } }");
  let test theory: Case = t.asserts("switching over a bool is refused for now") {
    theory.isSuccessful = overBool.diagnostics.len > 0;
    theory.detail = "switching over a bool produced no diagnostic";
  }

  // An arm body is a block, so it scopes like one.
  let armScope = checkSource("function main(): int { switch (1) { case 1: { const a = 1; } default: { } } return a; }");
  let test theory: Case = t.asserts("an arm-local name is not visible after the switch") {
    theory.isSuccessful = armScope.diagnostics.len > 0;
    theory.detail = "reading an arm-local after the switch produced no diagnostic";
  }
}

suite function structsAreChecked(): void {
  const decl = "type P { x: int, y: int } ";

  let ok = checkSource(`${decl}function main(): int { const p: P = { x: 1, y: 2 }; return p.x + p.y; }`);
  let test theory: Case = t.asserts("a literal, a field read and arithmetic compose") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Order does not matter, because fields are addressed by position.
  let reordered = checkSource(`${decl}function main(): int { const p: P = { y: 2, x: 1 }; return p.x; }`);
  let test theory: Case = t.asserts("literal fields may be written in any order") {
    theory.isSuccessful = reordered.diagnostics.len == 0;
    theory.detail = `reported ${reordered.diagnostics.len}: ${firstDiagnostic(ref reordered)}`;
  }

  let missing = checkSource(`${decl}function main(): int { const p: P = { x: 1 }; return p.x; }`);
  let test theory: Case = t.asserts("a literal missing a field is a diagnostic") {
    theory.isSuccessful = missing.diagnostics.len > 0;
    theory.detail = "a literal with only one of two fields produced no diagnostic";
  }

  let unknownField = checkSource(`${decl}function main(): int { const p: P = { x: 1, y: 2, z: 3 }; return p.x; }`);
  let test theory: Case = t.asserts("an unknown field in a literal is a diagnostic") {
    theory.isSuccessful = unknownField.diagnostics.len > 0;
    theory.detail = "a literal with an extra field produced no diagnostic";
  }

  let badFieldType = checkSource(`${decl}function main(): int { const p: P = { x: true, y: 2 }; return p.x; }`);
  let test theory: Case = t.asserts("a field value of the wrong type is a diagnostic") {
    theory.isSuccessful = badFieldType.diagnostics.len > 0;
    theory.detail = "assigning a bool to an int field produced no diagnostic";
  }

  let readMissing = checkSource(`${decl}function main(): int { const p: P = { x: 1, y: 2 }; return p.z; }`);
  let test theory: Case = t.asserts("reading an unknown field is a diagnostic") {
    theory.isSuccessful = readMissing.diagnostics.len > 0;
    theory.detail = "p.z produced no diagnostic";
  }

  // Which struct a literal is comes from context, so a bare one is ambiguous.
  let noContext = checkSource(`${decl}function main(): int { const p = { x: 1, y: 2 }; return p.x; }`);
  let test theory: Case = t.asserts("an unannotated literal is a diagnostic") {
    theory.isSuccessful = noContext.diagnostics.len > 0;
    theory.detail = "a literal with nothing to take its type from produced no diagnostic";
  }

  let assignField = checkSource(`${decl}function main(): int { let p: P = { x: 1, y: 2 }; p.x = 5; return p.x; }`);
  let test theory: Case = t.asserts("assigning to a field checks clean") {
    theory.isSuccessful = assignField.diagnostics.len == 0;
    theory.detail = `reported ${assignField.diagnostics.len}: ${firstDiagnostic(ref assignField)}`;
  }

  let assignBadType = checkSource(`${decl}function main(): int { let p: P = { x: 1, y: 2 }; p.x = true; return p.x; }`);
  let test theory: Case = t.asserts("assigning the wrong type to a field is a diagnostic") {
    theory.isSuccessful = assignBadType.diagnostics.len > 0;
    theory.detail = "p.x = true produced no diagnostic";
  }
}

// ----- traits ----------------------------------------------------------------

suite function traitsAreCheckedAgainstTheirImplementers(): void {
  const display = "trait Display { function toString(ref self): string; } ";

  let ok = checkSource(`${display}type P implements Display { x: int, function toString(ref self): string { return "p"; } } function main(): int { const p: P = { x: 1 }; printf("%s", Display.toString(ref p)); return 0; }`);
  let test theory: Case = t.asserts("a type that implements what it claims checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Claiming a trait is a promise. Unkept, it would otherwise surface at the
  // call site as a missing method on a type that says it has one.
  let missing = checkSource(`${display}type P implements Display { x: int, } function main(): int { return 0; }`);
  let test theory: Case = t.asserts("a claimed trait with no method is refused, by method name") {
    theory.isSuccessful = diagnosticsMention(ref missing, "toString");
    theory.detail = `wanted a diagnostic naming the missing method, got: ${firstDiagnostic(ref missing)}`;
  }

  // There are no inherent methods, so a method with no trait behind it can
  // never be called - `Trait.method(ref x)` is the only spelling there is.
  let inherent = checkSource(`${display}type P implements Display { x: int, function toString(ref self): string { return "p"; } function extra(ref self): int { return 1; } } function main(): int { return 0; }`);
  let test theory: Case = t.asserts("a method no trait requires is refused") {
    theory.isSuccessful = diagnosticsMention(ref inherent, "extra");
    theory.detail = `wanted a diagnostic naming the unrequired method, got: ${firstDiagnostic(ref inherent)}`;
  }

  let notTrait = checkSource("type Helper { n: int, } type P implements Helper { x: int, } function main(): int { return 0; }");
  let test theory: Case = t.asserts("implementing something that is not a trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref notTrait, "is not a trait");
    theory.detail = `wanted a diagnostic naming the non-trait, got: ${firstDiagnostic(ref notTrait)}`;
  }

  // The two things a method name is ALLOWED to collide with, and both are
  // ACCEPTANCES, which is why they are here rather than in examples/fail: what
  // a rule permits is as easy to get wrong as what it refuses, and the only
  // thing that had ever asserted these was a refusal that is no longer made.
  //
  // Two traits requiring the same name. Every call site qualifies through a
  // trait, so one method body satisfies both promises and there is nothing
  // ambiguous to resolve. A checker that keyed methods by NAME alone, or that
  // refused a second trait declaring a name the first already had, would refuse
  // this.
  let twoTraits = checkSource("trait A { function go(ref self): void; } trait B { function go(ref self): void; } type T implements (A, B) { n: int, function go(ref self): void { } } function main(): int { const t: T = { n: 1 }; A.go(ref t); B.go(ref t); return 0; }");
  let test theory: Case = t.asserts("two traits requiring one method name with one signature is allowed") {
    theory.isSuccessful = twoTraits.diagnostics.len == 0;
    theory.detail = `reported ${twoTraits.diagnostics.len}: ${firstDiagnostic(ref twoTraits)}`;
  }

  // ...and a module-level free function of the same name. A method is reached
  // only as `Trait.method(ref x)` and a free function only as `f(...)`, so the
  // two live in different namespaces and neither shadows the other. Both
  // spellings are called here, because "it compiled" would also be true of an
  // implementation that quietly resolved one to the other.
  let freeFn = checkSource("function dispose(x: int): void { } trait D { function dispose(ref self): void; } type F implements D { fd: int, function dispose(ref self): void { } } function main(): int { const h: F = { fd: 3 }; D.dispose(ref h); dispose(1); return 0; }");
  let test theory: Case = t.asserts("a trait method may share a name with a free function") {
    theory.isSuccessful = freeFn.diagnostics.len == 0;
    theory.detail = `reported ${freeFn.diagnostics.len}: ${firstDiagnostic(ref freeFn)}`;
  }
}

suite function traitCallsResolveThroughTheReceiver(): void {
  const decls = "trait Display { function toString(ref self): string; } type P implements Display { x: int, function toString(ref self): string { return \"p\"; } } ";

  // Static dispatch has nothing to dispatch ON without a receiver, so the
  // diagnostic has to say so rather than report an arity mismatch.
  let noReceiver = checkSource(`${decls}function main(): int { printf("%s", Display.toString()); return 0; }`);
  let test theory: Case = t.asserts("a trait call with no receiver is refused") {
    theory.isSuccessful = noReceiver.diagnostics.len > 0;
    theory.detail = "a receiverless trait call produced no diagnostic";
  }

  let unknownMethod = checkSource(`${decls}function main(): int { const p: P = { x: 1 }; return Display.width(ref p); }`);
  let test theory: Case = t.asserts("a method the trait does not declare is refused") {
    theory.isSuccessful = unknownMethod.diagnostics.len > 0;
    theory.detail = "calling an undeclared trait method produced no diagnostic";
  }

  // The receiver's CONCRETE type is what picks the method, so a receiver that
  // does not implement the trait has nothing to pick.
  let wrongReceiver = checkSource(`${decls}type Q { n: int, } function main(): int { const q: Q = { n: 1 }; printf("%s", Display.toString(ref q)); return 0; }`);
  let test theory: Case = t.asserts("a receiver without the method is refused") {
    theory.isSuccessful = wrongReceiver.diagnostics.len > 0;
    theory.detail = "a receiver that does not implement the trait produced no diagnostic";
  }

  // A method body is checked like any other function body. Nothing else does
  // this - the module walk only reaches top-level names, so a method body would
  // otherwise go unchecked all the way to codegen.
  let badBody = checkSource("trait Display { function toString(ref self): string; } type P implements Display { x: int, function toString(ref self): string { return self.x; } } function main(): int { return 0; }");
  let test theory: Case = t.asserts("a method body is checked against its own return type") {
    theory.isSuccessful = badBody.diagnostics.len > 0;
    theory.detail = "returning an int from a string method produced no diagnostic";
  }

  let unknownSelfField = checkSource("trait Display { function toString(ref self): string; } type P implements Display { x: int, function toString(ref self): string { return self.nope; } } function main(): int { return 0; }");
  let test theory: Case = t.asserts("self is typed as the enclosing type, so a bad field on it is caught") {
    theory.isSuccessful = diagnosticsMention(ref unknownSelfField, "nope");
    theory.detail = `wanted a diagnostic naming the unknown field, got: ${firstDiagnostic(ref unknownSelfField)}`;
  }
}

// ----- template literals -----------------------------------------------------

suite function templateLiteralsAreStringsAndCheckTheirParts(): void {
  let ok = checkSource("function f(n: int, s: string, b: bool): string { return `${s}: ${n} ${b}`; }");
  let test theory: Case = t.asserts("a string, an integer and a bool can all be interpolated") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // A template literal BUILDS a string, so it is one - which is what lets it be
  // returned from a `string` function and passed to `%s`.
  let wrongReturn = checkSource("function f(): int { return `text`; }");
  let test theory: Case = t.asserts("a template literal is typed as a string") {
    theory.isSuccessful = wrongReturn.diagnostics.len > 0;
    theory.detail = "returning a template literal from an int function produced no diagnostic";
  }

  // Refused in pass D, pointing at the interpolation, so codegen never meets a
  // part it has no lowering for.
  let structPart = checkSource("type P { x: int, } function f(p: P): string { return `${p}`; }");
  let test theory: Case = t.asserts("interpolating a struct is refused by type name") {
    theory.isSuccessful = diagnosticsMention(ref structPart, "P");
    theory.detail = `wanted a diagnostic naming the type, got: ${firstDiagnostic(ref structPart)}`;
  }

  // Floats interpolate as of 1.5, at BOTH widths - a float32 is widened to
  // double first, because the `%g` rendering takes one.
  let floatPart = checkSource("function f(x: float64): string { return `${x}`; }");
  let test theory: Case = t.asserts("interpolating a float64 is accepted") {
    theory.isSuccessful = floatPart.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref floatPart)}`;
  }

  let float32Part = checkSource("function f(x: float32): string { return `${x}`; }");
  let test theory: Case = t.asserts("interpolating a float32 is accepted") {
    theory.isSuccessful = float32Part.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref float32Part)}`;
  }

  // The expression inside an interpolation is checked like any other, so a
  // mistake in it is reported once, at its own location - not swallowed and not
  // doubled up with a "cannot interpolate" for the resulting error type.
  let badInner = checkSource("function f(): string { return `${nope}`; }");
  let test theory: Case = t.asserts("an unknown name inside an interpolation is reported once") {
    theory.isSuccessful = badInner.diagnostics.len == 1 && diagnosticsMention(ref badInner, "nope");
    theory.detail = `reported ${badInner.diagnostics.len}: ${firstDiagnostic(ref badInner)}`;
  }
}

// ----- for ... in ------------------------------------------------------------

suite function forInBindsTheElementType(): void {
  let ok = checkSource("function f(xs: int[]): int { let t: int = 0; for x in xs { t = t + x; } return t; }");
  let test theory: Case = t.asserts("the loop variable is usable as the element type") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The binding is the ELEMENT, not the array - the mistake a "for x in xs
  // binds xs" implementation would make, and one nothing else would catch.
  let wrongUse = checkSource("function f(xs: int[]): int { for x in xs { return x.len; } return 0; }");
  let test theory: Case = t.asserts("the loop variable is the element, not the array") {
    theory.isSuccessful = wrongUse.diagnostics.len > 0;
    theory.detail = "reading `.len` off an int element produced no diagnostic";
  }

  let structElem = checkSource("type E { n: int, } function f(es: E[]): int { let t: int = 0; for e in es { t = t + e.n; } return t; }");
  let test theory: Case = t.asserts("a struct element's fields are reachable") {
    theory.isSuccessful = structElem.diagnostics.len == 0;
    theory.detail = `reported ${structElem.diagnostics.len}: ${firstDiagnostic(ref structElem)}`;
  }

  // Scoped to the loop, so the name is gone afterwards.
  let escaped = checkSource("function f(xs: int[]): int { for x in xs { } return x; }");
  let test theory: Case = t.asserts("the loop variable does not outlive the loop") {
    theory.isSuccessful = diagnosticsMention(ref escaped, "x");
    theory.detail = `wanted an unknown-name diagnostic, got: ${firstDiagnostic(ref escaped)}`;
  }

  let jumps = checkSource("function f(xs: int[]): int { for x in xs { if (x == 1) { break; } continue; } return 0; }");
  let test theory: Case = t.asserts("break and continue count this as a loop") {
    theory.isSuccessful = jumps.diagnostics.len == 0;
    theory.detail = `reported ${jumps.diagnostics.len}: ${firstDiagnostic(ref jumps)}`;
  }

  let notArray = checkSource("function f(n: int): int { for x in n { } return 0; }");
  let test theory: Case = t.asserts("walking a non-array is refused by type name") {
    theory.isSuccessful = diagnosticsMention(ref notArray, "needs an array");
    theory.detail = `wanted a not-an-array refusal, got: ${firstDiagnostic(ref notArray)}`;
  }

  // An Iterable impl is a MISSING FEATURE, not a type error, and the two have
  // to read differently - one is a thing to go build, the other is a mistake.
  let iterable = checkSource("trait Iterable { function next(ref self): int; } type It implements Iterable { n: int, function next(ref self): int { return self.n; } } function f(it: It): int { for x in it { } return 0; }");
  let test theory: Case = t.asserts("an Iterable impl is refused as unimplemented, not as a type error") {
    theory.isSuccessful = diagnosticsMention(ref iterable, "implements Iterable");
    theory.detail = `wanted an Iterable-specific refusal, got: ${firstDiagnostic(ref iterable)}`;
  }
}

// ----- const enforcement -----------------------------------------------------

// A binding carries MUTABILITY as well as a type, because `const a = 1; a = 2;`
// has to be refused and the type alone cannot say so. Every one of these
// compiled clean before that existed, which is why they are all here rather
// than just the const case: what a rule ALLOWS is as easy to get wrong as what
// it refuses, and a rule that refused parameters would pass a const-only test.
suite function assignmentRespectsMutability(): void {
  let constLocal = checkSource("function main(): int { const a: int = 1; a = 2; return a; }");
  let test theory: Case = t.asserts("assigning to a const local is refused") {
    theory.isSuccessful = diagnosticsMention(ref constLocal, "cannot assign to const \"a\"");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref constLocal)}`;
  }

  // The compound forms desugar to a plain assignment in the PARSER, so one
  // check covers both. The JS reference misses this one - it refuses `a = 2`
  // and allows `a += 2` on the same binding.
  let compound = checkSource("function main(): int { const a: int = 1; a += 2; return a; }");
  let test theory: Case = t.asserts("compound assignment to a const is refused too") {
    theory.isSuccessful = diagnosticsMention(ref compound, "cannot assign to const \"a\"");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref compound)}`;
  }

  let letLocal = checkSource("function main(): int { let a: int = 1; a = 2; a += 3; return a; }");
  let test theory: Case = t.asserts("a let local stays assignable, in both forms") {
    theory.isSuccessful = letLocal.diagnostics.len == 0;
    theory.detail = `reported ${letLocal.diagnostics.len}: ${firstDiagnostic(ref letLocal)}`;
  }

  // A parameter is a local COPY, so writing to it is ordinary rather than a
  // mistake, and a `ref` parameter is mutable because that is the whole point
  // of the borrow. Refusing either would break real code.
  let param = checkSource("function f(a: int): int { a = 2; return a; }");
  let test theory: Case = t.asserts("a parameter is assignable") {
    theory.isSuccessful = param.diagnostics.len == 0;
    theory.detail = `reported ${param.diagnostics.len}: ${firstDiagnostic(ref param)}`;
  }

  let refParam = checkSource("function f(ref a: int): void { a = 2; }");
  let test theory: Case = t.asserts("a ref parameter is assignable - that is what a borrow is for") {
    theory.isSuccessful = refParam.diagnostics.len == 0;
    theory.detail = `reported ${refParam.diagnostics.len}: ${firstDiagnostic(ref refParam)}`;
  }

  let counter = checkSource("function main(): int { let t: int = 0; for (let i = 0; i < 2; i = i + 1) { t = t + 1; } return t; }");
  let test theory: Case = t.asserts("a counted loop's counter is assignable - it is stepped") {
    theory.isSuccessful = counter.diagnostics.len == 0;
    theory.detail = `reported ${counter.diagnostics.len}: ${firstDiagnostic(ref counter)}`;
  }

  // The loop variable is a COPY of the element, so assigning to it writes to
  // something discarded at the end of the iteration. Refusing says that;
  // allowing it silently does nothing.
  let loopVar = checkSource("function f(xs: int[]): int { for v in xs { v = 2; } return 0; }");
  let test theory: Case = t.asserts("a for-in loop variable is not assignable") {
    theory.isSuccessful = diagnosticsMention(ref loopVar, "cannot assign to const \"v\"");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref loopVar)}`;
  }

  let patternBinding = checkSource("variant V { A { n: int } } function f(v: V): int { switch (v) { case V.A { n: n }: { n = 2; return n; } } }");
  let test theory: Case = t.asserts("a pattern binding is not assignable") {
    theory.isSuccessful = diagnosticsMention(ref patternBinding, "cannot assign to const \"n\"");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref patternBinding)}`;
  }

  // `const` freezes the binding, and a field of the value it holds is part of
  // what was frozen. The whole field PATH is walked to its root, so a nested
  // write is refused the same way a one-level one is.
  let fieldWrite = checkSource("type P { x: int, } function main(): int { const p: P = { x: 1 }; p.x = 2; return p.x; }");
  let test theory: Case = t.asserts("a field of a const binding is not assignable") {
    theory.isSuccessful = diagnosticsMention(ref fieldWrite, "which is bound by const");
    theory.detail = `wanted a const field refusal, got: ${firstDiagnostic(ref fieldWrite)}`;
  }

  const frozenDecls = "type C { n: int, } type B { c: C, } ";
  let nestedConstWrite = checkSource(`${frozenDecls}function main(): int { const b: B = { c: { n: 1 } }; b.c.n = 5; return b.c.n; }`);
  let test theory: Case = t.asserts("a nested field of a const binding is not assignable") {
    theory.isSuccessful = diagnosticsMention(ref nestedConstWrite, "which is bound by const");
    theory.detail = `wanted a const field refusal, got: ${firstDiagnostic(ref nestedConstWrite)}`;
  }

  // An INDEX stops the walk. `const xs: T[]` freezes the name and not the
  // buffer behind it, so a write reached THROUGH one is storage the binding
  // never owned - which is why `xs[0] = 9` and `xs[0].n = 9` are both legal.
  let indexWrite = checkSource("function main(): int { const xs: int[] = [1, 2]; xs[0] = 9; return xs[0]; }");
  let test theory: Case = t.asserts("an element of a const array is still assignable") {
    theory.isSuccessful = indexWrite.diagnostics.len == 0;
    theory.detail = `reported ${indexWrite.diagnostics.len}: ${firstDiagnostic(ref indexWrite)}`;
  }

  let elemFieldWrite = checkSource(`${frozenDecls}function main(): int { const cs: C[] = [{ n: 1 }]; cs[0].n = 9; return cs[0].n; }`);
  let test theory: Case = t.asserts("a field reached through an index of a const array is still assignable") {
    theory.isSuccessful = elemFieldWrite.diagnostics.len == 0;
    theory.detail = `reported ${elemFieldWrite.diagnostics.len}: ${firstDiagnostic(ref elemFieldWrite)}`;
  }

  // A field write needs an ADDRESS, so its base has to bottom out in a named
  // binding. A path of fields does; a call's result does not - it lives in a
  // temp with nowhere to store back to. A field READ is unrestricted, because
  // it is an extractvalue on a loaded value and needs no address at all.
  const nestedDecls = "type C { n: int, } type B { c: C, } type A { b: B, } ";
  const mk = "function mk(): B { return { c: { n: 1 } }; } ";

  let nestedWrite = checkSource(`${nestedDecls}function main(): int { let a: A = { b: { c: { n: 1 } } }; a.b.c.n = 5; return a.b.c.n; }`);
  let test theory: Case = t.asserts("a nested field path is assignable") {
    theory.isSuccessful = nestedWrite.diagnostics.len == 0;
    theory.detail = `reported ${nestedWrite.diagnostics.len}: ${firstDiagnostic(ref nestedWrite)}`;
  }

  let callBase = checkSource(`${nestedDecls}${mk}function main(): int { mk().c.n = 5; return 0; }`);
  let test theory: Case = t.asserts("a field of a call's result is refused - there is nowhere to store") {
    theory.isSuccessful = diagnosticsMention(ref callBase, "can be assigned to");
    theory.detail = `wanted an addressability refusal, got: ${firstDiagnostic(ref callBase)}`;
  }

  let callRead = checkSource(`${nestedDecls}${mk}function main(): int { return mk().c.n; }`);
  let test theory: Case = t.asserts("but READING that same path is fine") {
    theory.isSuccessful = callRead.diagnostics.len == 0;
    theory.detail = `reported ${callRead.diagnostics.len}: ${firstDiagnostic(ref callRead)}`;
  }
}

// ----- kinds -----------------------------------------------------------------

suite function kindPrefixesResolveAgainstTheRegistry(): void {
  const decls = "kind tagged { appliesTo function; signature () => void; enumerable as \"tagged\"; } ";

  let ok = checkSource(`${decls}tagged run(): void { } function main(): int { run(); return 0; }`);
  let test theory: Case = t.asserts("a function carrying a declared kind checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // A prefix is not decoration. A typo in one would otherwise produce an
  // ordinary function and no complaint, which is the same message the JS
  // reference gives for the same reason.
  let unknown = checkSource("nope run(): void { } function main(): int { return 0; }");
  let test theory: Case = t.asserts("an undeclared kind on a function is refused, by both names") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "unknown kind \"nope\" on function \"run\"");
    theory.detail = `wanted an unknown-kind refusal, got: ${firstDiagnostic(ref unknown)}`;
  }

  // Kinds are ambient - reached BY NAME from a registry rather than through an
  // import - so declaration order does not matter, the same way a function
  // declared later is callable.
  let afterUse = checkSource(`tagged run(): void { } ${decls}function main(): int { return 0; }`);
  let test theory: Case = t.asserts("a kind declared after its use still resolves") {
    theory.isSuccessful = afterUse.diagnostics.len == 0;
    theory.detail = `reported ${afterUse.diagnostics.len}: ${firstDiagnostic(ref afterUse)}`;
  }

  // A kind's NAME binds like any other module-level declaration, which is what
  // makes `import { disposable } from "std/core/kinds.yoop"` resolve.
  let importable = checkTwoModules(
    "module k;\nexport kind tainted { appliesTo binding; }",
    "import { tainted } from \"./lib/k.yoop\";\nfunction main(): int { return 0; }"
  );
  let test theory: Case = t.asserts("an exported kind can be imported by name") {
    theory.isSuccessful = importable.diagnostics.len == 0;
    theory.detail = `reported ${importable.diagnostics.len}: ${firstDiagnostic(ref importable)}`;
  }
}

// ----- async coloring --------------------------------------------------------
//
// Three rules, and between them they are what makes a suspend safe:
//
//   1. `await e` only inside a function carrying a pausable kind
//   2. `e` must be a CALL to a function carrying one
//   3. such a function has to be called THROUGH `await`
//
// 2 and 3 together mean there is no way to reach an async function except from
// inside another one - so a frame that suspends always has a caller frame able
// to suspend with it. See typecheck/async.yoop.
//
// `async` is not a keyword here either: every source below declares the KIND,
// because that is all `async` is.

const ASYNC_KIND: string = "kind async { appliesTo function; pausable; } ";
const TASK_KIND: string = "kind task { appliesTo function; pausable; provides Task; } ";
const POOLED_KIND: string = "kind pooled { appliesTo binding; } ";

suite function asyncColoringRules(): void {
  let ok = checkSource(`${ASYNC_KIND}async inner(): int32 { return 1; } async outer(): int32 { return await inner(); }`);
  let test theory: Case = t.asserts("an async function awaiting another is clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // RULE 1.
  let outside = checkSource(`${ASYNC_KIND}async inner(): int32 { return 1; } function plain(): int32 { return await inner(); }`);
  let test theory: Case = t.asserts("`await` outside a pausable function is refused, naming the function") {
    theory.isSuccessful = diagnosticsMention(ref outside, "only legal inside a function carrying a pausable kind") &&
      diagnosticsMention(ref outside, "\"plain\"");
    theory.detail = `reported ${outside.diagnostics.len}: ${firstDiagnostic(ref outside)}`;
  }

  // RULE 2, the SYNTACTIC half - there is no coroutine to drive.
  let notACall = checkSource(`${ASYNC_KIND}async f(x: int32): int32 { return await x; }`);
  let test theory: Case = t.asserts("`await` on something that is not a call is refused") {
    theory.isSuccessful = diagnosticsMention(ref notACall, "takes a CALL to an async function");
    theory.detail = `reported ${notACall.diagnostics.len}: ${firstDiagnostic(ref notACall)}`;
  }

  // RULE 2, the TYPE half.
  let ordinary = checkSource(`${ASYNC_KIND}function plain(): int32 { return 1; } async f(): int32 { return await plain(); }`);
  let test theory: Case = t.asserts("`await` on an ORDINARY call is refused, and says to drop it") {
    theory.isSuccessful = diagnosticsMention(ref ordinary, "is an ordinary function - drop the \"await\"");
    theory.detail = `reported ${ordinary.diagnostics.len}: ${firstDiagnostic(ref ordinary)}`;
  }

  // RULE 3. The one that keeps an async call from silently never suspending.
  let bare = checkSource(`${ASYNC_KIND}async inner(): int32 { return 1; } async outer(): int32 { return inner(); }`);
  let test theory: Case = t.asserts("a bare call to an async function is refused, naming the callee") {
    theory.isSuccessful = diagnosticsMention(ref bare, "has to be called through \"await\"") &&
      diagnosticsMention(ref bare, "\"inner\"");
    theory.detail = `reported ${bare.diagnostics.len}: ${firstDiagnostic(ref bare)}`;
  }

  // The handoff is ONE STEP, which is what makes `await f(g())` mean "await f".
  // If the flag were an ambient mode, `g()` would read as awaited and the
  // missing-await on it would go unreported.
  let nested = checkSource(`${ASYNC_KIND}async g(): int32 { return 1; } function h(n: int32): int32 { return n; } async f(): int32 { return await asyncTake(h(g())); } async asyncTake(n: int32): int32 { return n; }`);
  let test theory: Case = t.asserts("an async call inside an awaited call's ARGUMENT is still refused") {
    theory.isSuccessful = diagnosticsMention(ref nested, "\"g\"") &&
      diagnosticsMention(ref nested, "has to be called through \"await\"");
    theory.detail = `reported ${nested.diagnostics.len}: ${firstDiagnostic(ref nested)}`;
  }
}

// THE TASK-SPAWN CARVE-OUT. A `task` body is pausable, so rule 3 would demand
// an `await` on `pooled h = worker(1)` - but a task's call site is a SPAWN, not
// an inline drive, and that is how every one of them is written. The reference
// makes the same carve-out.
suite function aTaskCallIsASpawnAndNotAnAwait(): void {
  const src = `${TASK_KIND}${POOLED_KIND}task worker(n: int32): int32 { return n; } function main(): int32 { pooled h = worker(1); return 0; }`;
  let prog = checkSource(src);
  let test theory: Case = t.asserts("spawning a task needs no `await`") {
    theory.isSuccessful = !diagnosticsMention(ref prog, "has to be called through \"await\"");
    theory.detail = `reported ${prog.diagnostics.len}: ${firstDiagnostic(ref prog)}`;
  }
}

// ----- the TASK half: `Task<T>`, the binding forms, and `wait` ---------------

const JOINED_KIND: string = "trait Joins { function join(ref self): void; } kind joined { appliesTo binding; requires Joins; mustCall join beforeScopeEnd; } ";
const POOLED_RC_KIND: string = "kind pooled { appliesTo binding; refcounted retain release; } ";

// `provides Task` rewrites the CALL, not the body: `task f(): T` still returns
// T from inside, and only its call site evaluates to `Task<T>`. Both halves
// matter - getting the first wrong makes every task body a type error, and the
// second is what makes `wait` have anything to join.
suite function aTaskCallEvaluatesToATaskHandle(): void {
  let body = checkSource(`${TASK_KIND}task worker(n: int32): int32 { return n; }`);
  let test theory: Case = t.asserts("the BODY still returns its declared type") {
    theory.isSuccessful = body.diagnostics.len == 0;
    theory.detail = `reported ${body.diagnostics.len}: ${firstDiagnostic(ref body)}`;
  }
  // The CALL is a handle, proved by joining it: `wait` refuses anything that is
  // not one, so an unannotated binding that waits cleanly is the whole claim.
  let handle = checkSource(`${TASK_KIND}task worker(n: int32): int32 { return n; } function main(): int32 { const h = worker(1); return wait h; }`);
  let test theory: Case = t.asserts("the CALL is a Task<T>, joinable with `wait`") {
    theory.isSuccessful = handle.diagnostics.len == 0;
    theory.detail = `reported ${handle.diagnostics.len}: ${firstDiagnostic(ref handle)}`;
  }
  // And it is NOT the declared return: `worker(1) * 2` would be arithmetic on a
  // handle, which has to be a type error rather than a silent int.
  let asInt = checkSource(`${TASK_KIND}task worker(n: int32): int32 { return n; } function main(): int32 { const h = worker(1); return h * 2; }`);
  let test theory: Case = t.asserts("a handle is not the T it will produce") {
    theory.isSuccessful = asInt.diagnostics.len > 0;
    theory.detail = `reported ${asInt.diagnostics.len}, wanted arithmetic on a handle to be refused`;
  }
}

// The three binding forms are told apart by the kind's CLAUSES, never by its
// name - the rule everything else about kinds follows. A `Task<T>` has no
// methods at all, so a clause naming one can only be honored by the compiler,
// which is exactly what makes the mapping unambiguous.
suite function theHandleBindingFormsComeFromTheKindsClauses(): void {
  const decl = `${TASK_KIND}${POOLED_RC_KIND}${JOINED_KIND}task worker(n: int32): int32 { return n; } `;
  let pooled = checkSource(`${decl}function main(): int32 { pooled h = worker(1); return 0; }`);
  let test theory: Case = t.asserts("a `refcounted` kind takes a handle with no complaint") {
    theory.isSuccessful = pooled.diagnostics.len == 0;
    theory.detail = `reported ${pooled.diagnostics.len}: ${firstDiagnostic(ref pooled)}`;
  }
  // A `mustCall join` kind would otherwise demand a `join` METHOD on the
  // binding's type, and `Task<T>` has none and cannot have one.
  let joined = checkSource(`${decl}function main(): int32 { joined d = worker(1); return 0; }`);
  let test theory: Case = t.asserts("a `mustCall` kind does not demand a method on Task<T>") {
    theory.isSuccessful = joined.diagnostics.len == 0;
    theory.detail = `reported ${joined.diagnostics.len}: ${firstDiagnostic(ref joined)}`;
  }
  // The IMMEDIATE form: annotated with the RESULT type, which is a mismatch on
  // its face and is exactly what says "spawn and join here".
  let immediate = checkSource(`${decl}function main(): int32 { const v: int32 = worker(1); return v; }`);
  let test theory: Case = t.asserts("an annotated binding takes the RESULT, not the handle") {
    theory.isSuccessful = immediate.diagnostics.len == 0;
    theory.detail = `reported ${immediate.diagnostics.len}: ${firstDiagnostic(ref immediate)}`;
  }
  // A COPY of an existing handle is legal for the REFCOUNTED form, which is the
  // only one with a count to take. Codegen emits the retain; without it, both
  // bindings release at their own scope end and the first frees a handle the
  // second still names.
  let copied = checkSource(`${decl}function main(): int32 { pooled a = worker(1); pooled b = a; return 0; }`);
  let test theory: Case = t.asserts("a pooled handle may be copied into a second binding") {
    theory.isSuccessful = copied.diagnostics.len == 0;
    theory.detail = `reported ${copied.diagnostics.len}: ${firstDiagnostic(ref copied)}`;
  }

  // A `joined` handle may NOT, and the reason is storage rather than policy: it
  // lives in the caller's frame with no count to take, so two bindings would
  // both join it and the second would wait on a freed sync pair.
  let copiedJoined = checkSource(`${decl}function main(): int32 { joined a = worker(1); joined b = a; return 0; }`);
  let test theory: Case = t.asserts("a joined handle may not be copied, and the message says why") {
    theory.isSuccessful = diagnosticsMention(ref copiedJoined, "only a `pooled` handle is refcounted");
    theory.detail = `reported ${copiedJoined.diagnostics.len}: ${firstDiagnostic(ref copiedJoined)}`;
  }
}

// `unhandled-disposable` - a binding that owes a cleanup and does nothing about
// it. ADVISORY: never an error, and the build opts in to seeing it.
//
// The three answers are asserted separately because each is a different piece
// of machinery: the keyword is syntax, a manual call is discharge.yoop's
// path-sensitive merge, and a transfer is the use walk.
suite function unhandledDisposableWarnsOnlyWhenNothingHandlesIt(): void {
  const DECL = "trait Disposable { function dispose(ref self): void; }\nkind disposable { appliesTo binding; requires Disposable; mustCall dispose beforeScopeEnd; }\ntype W implements Disposable propagates<disposable> { id: int32, function dispose(ref self): void {} }\nfunction make(): W propagates<disposable> { return { id: 1 }; }\n";

  let bare = checkSource(`${DECL}function main(): int32 { let w: W = make(); return 0; }`);
  let test theory: Case = t.asserts("a binding that owes and does nothing is warned about") {
    theory.isSuccessful = diagnosticsMention(ref bare, "carries kind 'disposable' but nothing handles it");
    theory.detail = `wanted an unhandled-disposable warning, got: ${firstDiagnostic(ref bare)}`;
  }

  // And it is a WARNING - the program is legal, so nothing about it is an
  // error and the compile is expected to succeed.
  let test theory: Case = t.asserts("it is advisory rather than an error") {
    theory.isSuccessful = errorCount(ref bare) == 0;
    theory.detail = "an unhandled obligation was reported as an error";
  }

  let keyword = checkSource(`${DECL}function main(): int32 { disposable w: W = make(); return 0; }`);
  let test theory: Case = t.asserts("the kind keyword answers it") {
    theory.isSuccessful = !diagnosticsMention(ref keyword, "nothing handles it");
    theory.detail = `an auto-cleaned binding was still warned about: ${firstDiagnostic(ref keyword)}`;
  }

  let manual = checkSource(`${DECL}function main(): int32 { disposable w: W = make(); Disposable.dispose(ref w); return 0; }`);
  let test theory: Case = t.asserts("a manual dispose answers it") {
    theory.isSuccessful = !diagnosticsMention(ref manual, "nothing handles it");
    theory.detail = `a hand-disposed binding was still warned about: ${firstDiagnostic(ref manual)}`;
  }

  // Handed to the caller: its cleanup is no longer this scope's business.
  let returned = checkSource(`${DECL}function keep(): W propagates<disposable> { let w: W = make(); return w; }\nfunction main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("returning it answers it") {
    theory.isSuccessful = !diagnosticsMention(ref returned, "nothing handles it");
    theory.detail = `a returned binding was still warned about: ${firstDiagnostic(ref returned)}`;
  }

  // A BORROW is not a handoff - it lends the value for a call and hands it
  // straight back. Without this distinction every method call on a local would
  // read as a transfer and the warning would never fire at all.
  let borrowed = checkSource(`${DECL}function look(ref w: W): int32 { return w.id; }\nfunction main(): int32 { let w: W = make(); return look(ref w); }`);
  let test theory: Case = t.asserts("passing it by `ref` is NOT a handoff") {
    theory.isSuccessful = diagnosticsMention(ref borrowed, "nothing handles it");
    theory.detail = "a binding that was only ever borrowed went unwarned";
  }
}

// `wait h` yields the handle's T, and refuses two things: an operand that is
// not a handle, and appearing inside a TASK body - where blocking the worker is
// the one thing the whole coroutine machinery exists to avoid.
suite function waitJoinsAHandle(): void {
  const decl = `${TASK_KIND}${POOLED_RC_KIND}${ASYNC_KIND}task worker(n: int32): int32 { return n; } `;
  let ok = checkSource(`${decl}function main(): int32 { pooled h = worker(1); return wait h; }`);
  let test theory: Case = t.asserts("`wait h` has the handle's result type") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }
  let notAHandle = checkSource(`${decl}function main(): int32 { const n: int32 = 1; return wait n; }`);
  let test theory: Case = t.asserts("waiting on something that is not a handle is refused") {
    theory.isSuccessful = diagnosticsMention(ref notAHandle, "joins a Task<T> handle");
    theory.detail = `reported ${notAHandle.diagnostics.len}: ${firstDiagnostic(ref notAHandle)}`;
  }
  let inTask = checkSource(`${decl}task joiner(): int32 { pooled h = worker(1); return wait h; }`);
  let test theory: Case = t.asserts("`wait` inside a task body is refused, pointing at `await`") {
    theory.isSuccessful = diagnosticsMention(ref inTask, "not allowed inside a task body");
    theory.detail = `reported ${inTask.diagnostics.len}: ${firstDiagnostic(ref inTask)}`;
  }
  // An `async` function that is NOT a task may wait freely - std's `awaitTask`
  // ends in one, as the fallback for being called off a worker.
  let inAsync = checkSource(`${decl}async joiner(): int32 { pooled h = worker(1); return wait h; }`);
  let test theory: Case = t.asserts("`wait` inside a plain async function is allowed") {
    theory.isSuccessful = !diagnosticsMention(ref inAsync, "not allowed inside a task body");
    theory.detail = `reported ${inAsync.diagnostics.len}: ${firstDiagnostic(ref inAsync)}`;
  }
}

// Two things a `task` declaration may not be, both the reference's rules. A
// void task is the one that matters most: the handle's result slot is sized by
// the declared return, and `void` has no LLVM spelling a struct field can take.
suite function aTaskDeclHasTwoRefusals(): void {
  let asMain = checkSource(`${TASK_KIND}task main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("`main` cannot be a task") {
    theory.isSuccessful = diagnosticsMention(ref asMain, "cannot be a task");
    theory.detail = `reported ${asMain.diagnostics.len}: ${firstDiagnostic(ref asMain)}`;
  }
  let voidTask = checkSource(`${TASK_KIND}task w(): void { return; }`);
  let test theory: Case = t.asserts("a task cannot return void") {
    theory.isSuccessful = diagnosticsMention(ref voidTask, "cannot return void");
    theory.detail = `reported ${voidTask.diagnostics.len}: ${firstDiagnostic(ref voidTask)}`;
  }
}

// `Task<T>` is spellable in an ANNOTATION - a builtin generic name like
// `unsafe_ptr<T>`, since nothing declares it and there is no symbol to look up.
suite function taskIsSpellableAsAnAnnotation(): void {
  const decl = `${TASK_KIND}${POOLED_RC_KIND}task worker(n: int32): int32 { return n; } `;
  let ok = checkSource(`${decl}function join(h: Task<int32>): int32 { return wait h; }`);
  let test theory: Case = t.asserts("a `Task<int32>` parameter joins to an int32") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }
  let wrongArity = checkSource(`${decl}function join(h: Task): int32 { return wait h; }`);
  let test theory: Case = t.asserts("a bare `Task` is refused - it takes one argument") {
    theory.isSuccessful = diagnosticsMention(ref wrongArity, "takes one type argument");
    theory.detail = `reported ${wrongArity.diagnostics.len}: ${firstDiagnostic(ref wrongArity)}`;
  }
}

// ASYNCNESS IS PART OF THE SIGNATURE, so a sync impl of an async trait method is
// an ordinary signature mismatch. That falls out of interning rather than being
// a rule anywhere: two Func types differing only in asyncness are two types.
suite function asyncnessIsPartOfASignature(): void {
  const readerTrait = "trait Reader { async read(ref self): int32; } ";
  let matching = checkSource(`${ASYNC_KIND}${readerTrait}type R implements Reader { n: int32, async read(ref self): int32 { return self.n; } }`);
  let test theory: Case = t.asserts("an async impl of an async trait method matches") {
    theory.isSuccessful = matching.diagnostics.len == 0;
    theory.detail = `reported ${matching.diagnostics.len}: ${firstDiagnostic(ref matching)}`;
  }
  let mismatched = checkSource(`${ASYNC_KIND}${readerTrait}type R implements Reader { n: int32, function read(ref self): int32 { return self.n; } }`);
  let test theory: Case = t.asserts("a SYNC impl of an async trait method is refused") {
    theory.isSuccessful = mismatched.diagnostics.len > 0;
    theory.detail = `reported ${mismatched.diagnostics.len}, wanted a signature mismatch`;
  }
}

// ----- intrinsics ------------------------------------------------------------

suite function intrinsicExternsAreTheirOwnThing(): void {
  const block = "extern \"intrinsic\" from \"compiler\" { function stringAsBytes(s: string): uint8[]; function arraySlice<T>(xs: T[], start: usize, end: usize): T[]; } ";

  let ok = checkSource(`${block}function main(): int { const b: uint8[] = stringAsBytes("hi"); return int(b.len); }`);
  let test theory: Case = t.asserts("an intrinsic call checks against its declared signature") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The name IS the lowering, so a fabricated one would typecheck and then fail
  // in codegen with nothing useful to say. The reference refuses it too.
  let fake = checkSource("extern \"intrinsic\" from \"compiler\" { function teleport(n: usize): usize; } function main(): int { return 0; }");
  let test theory: Case = t.asserts("an intrinsic codegen has no lowering for is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref fake, "unknown intrinsic \"teleport\"");
    theory.detail = `wanted an unknown-intrinsic refusal, got: ${firstDiagnostic(ref fake)}`;
  }

  let badArg = checkSource(`${block}function main(): int { const b: uint8[] = stringAsBytes(7); return 0; }`);
  let test theory: Case = t.asserts("an intrinsic's arguments are checked like any other call's") {
    theory.isSuccessful = badArg.diagnostics.len > 0;
    theory.detail = "passing an int where a string was declared produced no diagnostic";
  }

  // A generic intrinsic goes through the SAME inference every generic function
  // uses - `T` comes from the argument, and the result is the substituted type.
  let generic = checkSource(`${block}function main(): int { const xs: int32[] = [1, 2, 3]; const part: int32[] = arraySlice(xs, 0, 2); return int(part.len); }`);
  let test theory: Case = t.asserts("a generic intrinsic infers its type argument") {
    theory.isSuccessful = generic.diagnostics.len == 0;
    theory.detail = `reported ${generic.diagnostics.len}: ${firstDiagnostic(ref generic)}`;
  }

  let wrongElem = checkSource(`${block}function main(): int { const xs: int32[] = [1, 2, 3]; const part: uint8[] = arraySlice(xs, 0, 2); return 0; }`);
  let test theory: Case = t.asserts("and the inferred element type is enforced") {
    theory.isSuccessful = wrongElem.diagnostics.len > 0;
    theory.detail = "assigning an int32[] slice to a uint8[] produced no diagnostic";
  }

  // An intrinsic is implicitly exported - the block is the declaration, so
  // there is nowhere to write `export` - and every std module reaches them
  // through `import * as intr`. A C extern is NOT.
  let intrinsicImport = checkTwoModules(
    "extern \"intrinsic\" from \"compiler\" { function stringAsBytes(s: string): uint8[]; }",
    "import * as lib from \"./lib/k.yoop\";\nfunction main(): int { const b: uint8[] = lib.stringAsBytes(\"hi\"); return 0; }"
  );
  let test theory: Case = t.asserts("an intrinsic is visible through a namespace without `export`") {
    theory.isSuccessful = intrinsicImport.diagnostics.len == 0;
    theory.detail = `reported ${intrinsicImport.diagnostics.len}: ${firstDiagnostic(ref intrinsicImport)}`;
  }

  let cImport = checkTwoModules(
    "extern \"C\" from \"stdio.h\" { function puts(s: string): int; }",
    "import * as lib from \"./lib/k.yoop\";\nfunction main(): int { return lib.puts(\"hi\"); }"
  );
  let test theory: Case = t.asserts("a C extern is not, which is the difference") {
    theory.isSuccessful = cImport.diagnostics.len > 0;
    theory.detail = "an unexported C extern was reachable through a namespace";
  }

  let badAbi = checkSource("extern \"rust\" from \"lib\" { function f(): int; } function main(): int { return 0; }");
  let test theory: Case = t.asserts("an ABI that is neither C nor intrinsic is refused") {
    theory.isSuccessful = badAbi.diagnostics.len > 0;
    theory.detail = "an unknown extern ABI produced no diagnostic";
  }
}

// ----- variadic externs ------------------------------------------------------

// A variadic callee takes AT LEAST its declared parameters, and only those are
// checked. That split is the whole feature: the fixed half is an ordinary
// signature and gets ordinary treatment, and the tail has nothing to be checked
// against because C's calling convention is all that describes it.
suite function aVariadicExternChecksItsFixedParametersOnly(): void {
  const block = "extern \"C\" from \"stdio.h\" { function myprint(fmt: string, n: int32, ...): int32; } ";

  let extras = checkSource(`${block}function main(): int { myprint("a", 1, 2, "three", true); return 0; }`);
  let test theory: Case = t.asserts("arguments past the declared ones are accepted") {
    theory.isSuccessful = extras.diagnostics.len == 0;
    theory.detail = `three extra arguments reported: ${firstDiagnostic(ref extras)}`;
  }

  let none = checkSource(`${block}function main(): int { myprint("a", 1); return 0; }`);
  let test theory: Case = t.asserts("ZERO extra arguments is the same call") {
    theory.isSuccessful = none.diagnostics.len == 0;
    theory.detail = `the fixed arguments alone reported: ${firstDiagnostic(ref none)}`;
  }

  let short = checkSource(`${block}function main(): int { myprint("a"); return 0; }`);
  let test theory: Case = t.asserts("fewer than the declared parameters is still an arity error") {
    theory.isSuccessful = diagnosticsMention(ref short, "takes at least 2 argument(s), got 1");
    theory.detail = `wanted an at-least arity diagnostic, got: ${firstDiagnostic(ref short)}`;
  }

  // The half the JS reference gets wrong: there, a short variadic call reaches
  // clang and is rejected as "not enough parameters specified for call", which
  // names the generated IR rather than the program.
  let wrongFixed = checkSource(`${block}function main(): int { myprint("a", "b", 3); return 0; }`);
  let test theory: Case = t.asserts("a FIXED parameter is type-checked as usual") {
    theory.isSuccessful = wrongFixed.diagnostics.len > 0;
    theory.detail = "passing a string to the declared int32 parameter produced no diagnostic";
  }

  // `...` describes a calling convention, and neither of these has a call to
  // apply one to. Refused rather than recorded, because a variadic intrinsic
  // would compile and then silently drop everything past the fixed parameters.
  let onIntrinsic = checkSource(
    "extern \"intrinsic\" from \"compiler\" { function stringAsBytes(s: string, ...): uint8[]; } function main(): int { return 0; }"
  );
  let test theory: Case = t.asserts("an intrinsic may not be variadic") {
    theory.isSuccessful = diagnosticsMention(ref onIntrinsic, "only allowed on a non-generic `extern \"C\"` signature");
    theory.detail = `wanted a variadic-intrinsic refusal, got: ${firstDiagnostic(ref onIntrinsic)}`;
  }

  let onGeneric = checkSource(
    "extern \"C\" from \"lib\" { function each<T>(xs: T[], ...): int32; } function main(): int { return 0; }"
  );
  let test theory: Case = t.asserts("a generic signature may not be variadic either") {
    theory.isSuccessful = diagnosticsMention(ref onGeneric, "only allowed on a non-generic `extern \"C\"` signature");
    theory.detail = `wanted a variadic-generic refusal, got: ${firstDiagnostic(ref onGeneric)}`;
  }
}

// `printf` is a compiler builtin on BOTH sides, and a declaration of it wins.
//
// Probing the reference is what settled the precedence rather than reading its
// source: declaring a NON-variadic `printf` there makes `printf("a %d\n", 3)`
// an arity error, so the declared signature is what a call is checked against
// and the builtin is only the fallback for a program that declared nothing.
suite function aDeclaredPrintfShadowsTheBuiltin(): void {
  let builtin = checkSource("function main(): int { printf(\"%d %s\\n\", 1, \"two\"); return 0; }");
  let test theory: Case = t.asserts("undeclared printf still takes any arguments") {
    theory.isSuccessful = builtin.diagnostics.len == 0;
    theory.detail = `printf with mixed arguments reported: ${firstDiagnostic(ref builtin)}`;
  }

  const declared = "extern \"C\" from \"stdio.h\" { function printf(fmt: string, ...): int32; } ";
  let ok = checkSource(`${declared}function main(): int { printf("%d %s\\n", 1, "two"); return 0; }`);
  let test theory: Case = t.asserts("a declared variadic printf accepts the same call") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `the declared printf reported: ${firstDiagnostic(ref ok)}`;
  }

  let badFmt = checkSource(`${declared}function main(): int { printf(7, 8); return 0; }`);
  let test theory: Case = t.asserts("and its format parameter is now checked, which the builtin's is not") {
    theory.isSuccessful = badFmt.diagnostics.len > 0;
    theory.detail = "passing an int where the declared string parameter is produced no diagnostic";
  }

  // The clearest proof the declaration is what a call resolves against: make it
  // non-variadic and the extra argument becomes an error.
  let narrow = checkSource(
    "extern \"C\" from \"stdio.h\" { function printf(fmt: string): int32; } function main(): int { printf(\"a %d\\n\", 3); return 0; }"
  );
  let test theory: Case = t.asserts("a printf declared WITHOUT `...` refuses the extra argument") {
    theory.isSuccessful = diagnosticsMention(ref narrow, "takes 1 argument(s), got 2");
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref narrow)}`;
  }
}

// ----- function types --------------------------------------------------------

suite function functionValuesAreTheirSignatures(): void {
  const decls = "type Ops { hash: (k: string) => uint64, } function myHash(k: string): uint64 { return 1; } ";

  // The point of the whole feature: a declared function and an annotation
  // intern to the SAME Type.Func, so a named function drops into a
  // function-typed field with nothing to convert.
  let ok = checkSource(`${decls}function main(): int { const o: Ops = { hash: myHash }; return int(o.hash("x")); }`);
  let test theory: Case = t.asserts("a named function fits a matching function-typed field") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Two functions with identical signatures are interchangeable, and two with
  // different ones are not. A declared function's signature lives in the shell
  // pass A registered, so these compare STRUCTURALLY rather than by id.
  let wrongSig = checkSource("type Ops { hash: (k: string) => uint64, } function bad(n: int): uint64 { return 1; } function main(): int { const o: Ops = { hash: bad }; return 0; }");
  let test theory: Case = t.asserts("a function with the wrong signature is refused") {
    theory.isSuccessful = wrongSig.diagnostics.len > 0;
    theory.detail = "assigning a mismatched function to a field produced no diagnostic";
  }

  let wrongRet = checkSource("type Ops { hash: (k: string) => uint64, } function bad(k: string): bool { return true; } function main(): int { const o: Ops = { hash: bad }; return 0; }");
  let test theory: Case = t.asserts("the return type is part of the match") {
    theory.isSuccessful = wrongRet.diagnostics.len > 0;
    theory.detail = "a differing return type produced no diagnostic";
  }

  // Parameter NAMES are not: a function type is positional.
  let renamed = checkSource("type Ops { hash: (key: string) => uint64, } function myHash(k: string): uint64 { return 1; } function main(): int { const o: Ops = { hash: myHash }; return 0; }");
  let test theory: Case = t.asserts("parameter names do not participate in the match") {
    theory.isSuccessful = renamed.diagnostics.len == 0;
    theory.detail = `reported ${renamed.diagnostics.len}: ${firstDiagnostic(ref renamed)}`;
  }

  // An indirect call is checked against the FIELD's signature, like any call.
  let badArg = checkSource(`${decls}function main(): int { const o: Ops = { hash: myHash }; return int(o.hash(7)); }`);
  let test theory: Case = t.asserts("an indirect call's arguments are checked") {
    theory.isSuccessful = badArg.diagnostics.len > 0;
    theory.detail = "passing an int where a string was declared produced no diagnostic";
  }

  let arity = checkSource(`${decls}function main(): int { const o: Ops = { hash: myHash }; return int(o.hash("a", "b")); }`);
  let test theory: Case = t.asserts("and so is its arity") {
    theory.isSuccessful = arity.diagnostics.len > 0;
    theory.detail = "calling a one-parameter field with two arguments produced no diagnostic";
  }

  // A field that is not function-typed is not callable, and the diagnostic must
  // not claim it is a missing namespace.
  let notCallable = checkSource("type P { n: int, } function main(): int { const p: P = { n: 1 }; return p.n(); }");
  let test theory: Case = t.asserts("calling a non-function field is refused") {
    theory.isSuccessful = notCallable.diagnostics.len > 0;
    theory.detail = "calling an int field produced no diagnostic";
  }
}

// A Func has no canonical TypeId, so a Func WRAPPED in something structural has
// no canonical id either - and every wrapper has to be walked through to reach
// it. A compare that stops at the Array reports "X is not X" for
// `((a: int32) => int32)[]` written in two places.
//
// Every accepting case here is a pair of SEPARATE annotations, which is the
// whole point: one annotation used twice would compare equal by id and prove
// nothing.
suite function funcTypesCompareThroughEveryWrapper(): void {
  const fnArr = "((a: int32) => int32)[]";

  // The exact shape lex/chars.yoop uses, and the one that gated 100 files.
  let refArr = checkSource(`function inner(ref fns: ${fnArr}): int32 { return 0; } function outer(ref fns: ${fnArr}): int32 { return inner(ref fns); }`);
  let test theory: Case = t.asserts("a Func behind a `ref` and an array compares equal to itself") {
    theory.isSuccessful = refArr.diagnostics.len == 0;
    theory.detail = `reported ${refArr.diagnostics.len}: ${firstDiagnostic(ref refArr)}`;
  }

  let plainArr = checkSource(`function inner(fns: ${fnArr}): int32 { return 0; } function outer(fns: ${fnArr}): int32 { return inner(fns); }`);
  let test theory: Case = t.asserts("and so does one behind an array alone") {
    theory.isSuccessful = plainArr.diagnostics.len == 0;
    theory.detail = `reported ${plainArr.diagnostics.len}: ${firstDiagnostic(ref plainArr)}`;
  }

  let refOnly = checkSource("function inner(ref f: (a: int32) => int32): int32 { return 0; } function outer(ref f: (a: int32) => int32): int32 { return inner(ref f); }");
  let test theory: Case = t.asserts("and one behind a `ref` alone") {
    theory.isSuccessful = refOnly.diagnostics.len == 0;
    theory.detail = `reported ${refOnly.diagnostics.len}: ${firstDiagnostic(ref refOnly)}`;
  }

  // A Func inside a Func's own PARAMETER list, and a Func as its RETURN. The
  // reference accepts both, established by probing it.
  let nestedParam = checkSource("function inner(a: int32): int32 { return a; } function apply(g: (a: int32) => int32): int32 { return g(1); } function hof(h: (g: (a: int32) => int32) => int32): int32 { return h(inner); } function main(): int { return hof(apply); }");
  let test theory: Case = t.asserts("a Func nested in another Func's parameters compares structurally") {
    theory.isSuccessful = nestedParam.diagnostics.len == 0;
    theory.detail = `reported ${nestedParam.diagnostics.len}: ${firstDiagnostic(ref nestedParam)}`;
  }

  let nestedRet = checkSource("function inner(mk: () => ((a: int32) => int32)): int32 { return 0; } function outer(mk: () => ((a: int32) => int32)): int32 { return inner(mk); }");
  let test theory: Case = t.asserts("a Func in another Func's RETURN compares structurally") {
    theory.isSuccessful = nestedRet.diagnostics.len == 0;
    theory.detail = `reported ${nestedRet.diagnostics.len}: ${firstDiagnostic(ref nestedRet)}`;
  }

  // The refusals. This change makes a comparison MORE permissive, so the thing
  // to prove is that a genuine mismatch buried at the same depth is still a
  // mismatch: parameter type, return type and ARITY each on their own.
  let wrongParam = checkSource("function inner(ref fns: ((a: int64) => int64)[]): int32 { return 0; } function outer(ref fns: ((a: int32) => int32)[]): int32 { return inner(ref fns); }");
  let test theory: Case = t.asserts("a differing parameter width inside the wrappers is still refused") {
    theory.isSuccessful = wrongParam.diagnostics.len > 0;
    theory.detail = "int64 params where int32 was declared produced no diagnostic";
  }

  let wrongRet = checkSource("function inner(ref fns: ((a: int32) => int64)[]): int32 { return 0; } function outer(ref fns: ((a: int32) => int32)[]): int32 { return inner(ref fns); }");
  let test theory: Case = t.asserts("a differing return type inside the wrappers is still refused") {
    theory.isSuccessful = wrongRet.diagnostics.len > 0;
    theory.detail = "an int64 return where int32 was declared produced no diagnostic";
  }

  let wrongArity = checkSource("function inner(ref fns: ((a: int32, b: int32) => int32)[]): int32 { return 0; } function outer(ref fns: ((a: int32) => int32)[]): int32 { return inner(ref fns); }");
  let test theory: Case = t.asserts("a differing arity inside the wrappers is still refused") {
    theory.isSuccessful = wrongArity.diagnostics.len > 0;
    theory.detail = "two parameters where one was declared produced no diagnostic";
  }

  // A wrapper mismatch is still a mismatch: an array of Funcs is not a Func.
  let wrapperMismatch = checkSource("function inner(f: (a: int32) => int32): int32 { return 0; } function outer(fns: ((a: int32) => int32)[]): int32 { return inner(fns); }");
  let test theory: Case = t.asserts("an array of Funcs is not a Func") {
    theory.isSuccessful = wrapperMismatch.diagnostics.len > 0;
    theory.detail = "passing an array where a single function was declared produced no diagnostic";
  }

  // The walk stops at every NOMINAL type, which is both the correct answer and
  // the reason a self-referential declaration terminates rather than recursing
  // forever. Two structs with identical fields stay two types.
  let sameShape = checkSource("type A { x: int32, } type B { x: int32, } function takes(a: A): int32 { return a.x; } function main(): int { const b: B = { x: 1 }; return takes(b); }");
  let test theory: Case = t.asserts("two structs with identical fields are still two types") {
    theory.isSuccessful = sameShape.diagnostics.len > 0;
    theory.detail = "passing a B where an A was declared produced no diagnostic";
  }

  // `next: ref Node` is the shape that would make a walk into nominal members
  // recurse forever. It never enters one, so this terminates - and a test that
  // HANGS is how a regression here would show up. The BY-VALUE spelling of the
  // same cycle is a different question with its own answer
  // (aTypeCannotContainItselfByValue); the borrow is the one that has to both
  // compile and terminate.
  let selfRef = checkSource("type Node { v: int32, next: ref Node, } function takes(n: Node): int32 { return n.v; } function other(n: Node): int32 { return takes(n); }");
  let test theory: Case = t.asserts("a self-referential type compares without recursing forever") {
    theory.isSuccessful = selfRef.diagnostics.len == 0;
    theory.detail = `reported ${selfRef.diagnostics.len}: ${firstDiagnostic(ref selfRef)}`;
  }
}

// The two widenings the language has are ASSIGNABILITY rules, not equivalence,
// so they apply at the TOP LEVEL and nowhere inside a wrapper. Both halves match
// the reference, established by probing it: it accepts the bare widening and
// refuses the same widening under a `ref` or an array.
suite function pointerWideningIsTopLevelOnly(): void {
  let bare = checkSource("import.unsafe;\nfunction takes(p: unsafe_ptr): int { return 0; } function main(): int { let q: unsafe_ptr<uint8> = null; return takes(q); }");
  let test theory: Case = t.asserts("a typed pointer widens to the opaque one") {
    theory.isSuccessful = bare.diagnostics.len == 0;
    theory.detail = `reported ${bare.diagnostics.len}: ${firstDiagnostic(ref bare)}`;
  }

  // Under a `ref` the callee could STORE an opaque pointer through it, which
  // breaks the promise the caller still holds. So the widening must not recurse.
  let underRef = checkSource("import.unsafe;\nfunction takes(ref p: unsafe_ptr): int { return 0; } function main(): int { let q: unsafe_ptr<uint8> = null; return takes(ref q); }");
  let test theory: Case = t.asserts("it does NOT widen under a `ref`") {
    theory.isSuccessful = underRef.diagnostics.len > 0;
    theory.detail = "a ref to a typed pointer was accepted where a ref to the opaque one was declared";
  }

  let underArray = checkSource("import.unsafe;\nfunction takes(p: unsafe_ptr[]): int { return 0; } function main(): int { let q: unsafe_ptr<uint8>[] = [null]; return takes(q); }");
  let test theory: Case = t.asserts("and not inside an array") {
    theory.isSuccessful = underArray.diagnostics.len > 0;
    theory.detail = "an array of typed pointers was accepted where an array of opaque ones was declared";
  }

  // Two different pointees are two different types at every depth.
  let differentPointee = checkSource("import.unsafe;\nfunction takes(p: unsafe_ptr<uint8>): int { return 0; } function main(): int { let q: unsafe_ptr<int32> = null; return takes(q); }");
  let test theory: Case = t.asserts("two different pointees do not interchange") {
    theory.isSuccessful = differentPointee.diagnostics.len > 0;
    theory.detail = "an unsafe_ptr<int32> was accepted where an unsafe_ptr<uint8> was declared";
  }
}

// A type in a diagnostic has to READ as the type. One coming out as "<type>"
// turns a real mismatch into "X is not X" - the exact confusion the wrapper
// compare above is prone to.
suite function everyTypeRendersInADiagnostic(): void {
  let ptr = checkSource("import.unsafe;\nfunction takes(p: unsafe_ptr<uint8>): int { return 0; } function main(): int { let q: unsafe_ptr<int32> = null; return takes(q); }");
  let test theory: Case = t.asserts("a typed pointer renders with its pointee") {
    theory.isSuccessful = diagnosticsMention(ref ptr, "unsafe_ptr<uint8>") &&
      diagnosticsMention(ref ptr, "unsafe_ptr<int32>");
    theory.detail = `wanted both pointee spellings, got: ${firstDiagnostic(ref ptr)}`;
  }

  // A Func's PARAMETERS are part of its rendering. They were being dropped -
  // `formatTypeList` built into a `disposable` Text and returned `text.view` of
  // it, which is a borrow of freed storage - so every Func read as "() => R".
  let fn = checkSource("function inner(f: (a: int32, b: int32) => int32): int32 { return 0; } function outer(f: (a: int64) => int32): int32 { return inner(f); }");
  let test theory: Case = t.asserts("a Func renders with its parameter types") {
    theory.isSuccessful = diagnosticsMention(ref fn, "(int32, int32) => int32") &&
      diagnosticsMention(ref fn, "(int64) => int32");
    theory.detail = `wanted both signatures spelled out, got: ${firstDiagnostic(ref fn)}`;
  }
}

// `~x` - bitwise NOT. Prefix only, so it needs none of the position rule `&`
// and `*` need. Every rule here was established by probing the reference.
suite function bitwiseNotTakesAnInteger(): void {
  let widths = checkSource("function main(): int { let a: uint8 = 15; let b: int64 = 5; let c: usize = 1; let d: uint8 = ~a; let e: int64 = ~b; let f: usize = ~c; return 0; }");
  let test theory: Case = t.asserts("`~` keeps the operand's integer type at every width") {
    theory.isSuccessful = widths.diagnostics.len == 0;
    theory.detail = `reported ${widths.diagnostics.len}: ${firstDiagnostic(ref widths)}`;
  }

  // The expectation flows through, exactly as unary minus's does: `~0` in a
  // uint8 slot is a uint8 255, not an int32 -1 that then refuses to fit.
  let pins = checkSource("function main(): int { let w: uint8 = ~0; let n: int64 = ~5; return 0; }");
  let test theory: Case = t.asserts("an untyped literal under `~` pins to the context") {
    theory.isSuccessful = pins.diagnostics.len == 0;
    theory.detail = `reported ${pins.diagnostics.len}: ${firstDiagnostic(ref pins)}`;
  }

  // An INT-backed value enum keeps its own type, which is what makes
  // `~Flags.Sweet` a Flags. Same rule the binary bitwise family follows.
  let intEnum = checkSource("enum Flags<uint8> { A 1, B 2 }\nfunction main(): int { let x: Flags = ~Flags.A; return 0; }");
  let test theory: Case = t.asserts("an int-backed enum is an integer operand and keeps its type") {
    theory.isSuccessful = intEnum.diagnostics.len == 0;
    theory.detail = `reported ${intEnum.diagnostics.len}: ${firstDiagnostic(ref intEnum)}`;
  }

  // A STRING-backed one is not, and neither is anything else. The message is
  // the reference's, word for word.
  let strEnum = checkSource("enum Dir<string> { UP \"up\", DOWN \"down\" }\nfunction main(): int { let d: Dir = ~Dir.UP; return 0; }");
  let test theory: Case = t.asserts("a string-backed enum is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref strEnum, "bitwise NOT operator requires an integer operand");
    theory.detail = `wanted the integer-operand refusal, got: ${firstDiagnostic(ref strEnum)}`;
  }

  let onBool = checkSource("function main(): int { let b: bool = true; let c: bool = ~b; return 0; }");
  let test theory: Case = t.asserts("a bool is refused") {
    theory.isSuccessful = diagnosticsMention(ref onBool, "bitwise NOT operator requires an integer operand, found bool");
    theory.detail = `wanted the integer-operand refusal naming bool, got: ${firstDiagnostic(ref onBool)}`;
  }

  let onFloat = checkSource("function main(): int { let f: float64 = 1.5; let g: float64 = ~f; return 0; }");
  let test theory: Case = t.asserts("a float is refused") {
    theory.isSuccessful = diagnosticsMention(ref onFloat, "bitwise NOT operator requires an integer operand, found float64");
    theory.detail = `wanted the integer-operand refusal naming float64, got: ${firstDiagnostic(ref onFloat)}`;
  }

  let onString = checkSource("function main(): int { let s: string = \"a\"; let u: string = ~s; return 0; }");
  let test theory: Case = t.asserts("a string is refused") {
    theory.isSuccessful = diagnosticsMention(ref onString, "bitwise NOT operator requires an integer operand, found string");
    theory.detail = `wanted the integer-operand refusal naming string, got: ${firstDiagnostic(ref onString)}`;
  }

  let onStruct = checkSource("type P { x: int32, }\nfunction main(): int { let p: P = { x: 1 }; let q: P = ~p; return 0; }");
  let test theory: Case = t.asserts("a struct is refused") {
    theory.isSuccessful = diagnosticsMention(ref onStruct, "bitwise NOT operator requires an integer operand");
    theory.detail = `wanted the integer-operand refusal, got: ${firstDiagnostic(ref onStruct)}`;
  }
}

// Both spellings that BUILD a vtable value work now (see the three suites
// above); this one keeps the DECLARATION honest beside them - laying one out
// with nothing using it still has to check clean, and both build forms reach
// the vtable path rather than the namespace one.
suite function aVtableDeclarationStandsOnItsOwn(): void {
  const decls = "trait Pred { function test(ref self, c: uint8): bool; } type Star implements Pred { n: int32, function test(ref self, c: uint8): bool { return true; } } vtable PredVT for Pred { test: (c: uint8) => bool, } ";

  let declOnly = checkSource(`${decls}function main(): int { return 0; }`);
  let test theory: Case = t.asserts("DECLARING a vtable with nothing using it checks clean") {
    theory.isSuccessful = declOnly.diagnostics.len == 0;
    theory.detail = `reported ${declOnly.diagnostics.len}: ${firstDiagnostic(ref declOnly)}`;
  }

  let fromFn = checkSource(`${decls}function isX(c: uint8): bool { return true; } function main(): int { let vt: PredVT = PredVT.fromFn(isX); return 0; }`);
  let test theory: Case = t.asserts("`VT.fromFn(...)` builds one") {
    theory.isSuccessful = fromFn.diagnostics.len == 0;
    theory.detail = `reported ${fromFn.diagnostics.len}: ${firstDiagnostic(ref fromFn)}`;
  }

  let fromRef = checkSource(`${decls}function main(): int { let s: Star = { n: 1 }; let vt: PredVT = PredVT.from(ref s); return 0; }`);
  let test theory: Case = t.asserts("`VT.from(ref x)` builds one - `from` is a keyword and still reads as a member") {
    theory.isSuccessful = fromRef.diagnostics.len == 0;
    theory.detail = `reported ${fromRef.diagnostics.len}: ${firstDiagnostic(ref fromRef)}`;
  }
}

// ----- raw pointers, null, vtables, slices -----------------------------------

suite function rawPointersAreGatedAndTyped(): void {
  // The gate is the whole safety story: `unsafe_ptr` is unreachable without
  // `import.unsafe;`, so a file using raw pointers says so at the top.
  let ungated = checkSource("function f(p: unsafe_ptr): int { return 0; }");
  let test theory: Case = t.asserts("unsafe_ptr without `import.unsafe;` is refused") {
    theory.isSuccessful = diagnosticsMention(ref ungated, "import.unsafe");
    theory.detail = `wanted the gate diagnostic, got: ${firstDiagnostic(ref ungated)}`;
  }

  let gated = checkSource("import.unsafe;\nfunction f(p: unsafe_ptr<uint8>): unsafe_ptr { return p; }");
  let test theory: Case = t.asserts("a TYPED pointer widens to the opaque one") {
    theory.isSuccessful = gated.diagnostics.len == 0;
    theory.detail = `reported ${gated.diagnostics.len}: ${firstDiagnostic(ref gated)}`;
  }

  // ...and not back. `unsafe_ptr` is "some pointer"; narrowing it would be
  // inventing a promise about what it points at.
  let narrowing = checkSource("import.unsafe;\nfunction f(p: unsafe_ptr): unsafe_ptr<uint8> { return p; }");
  let test theory: Case = t.asserts("the opaque pointer does not narrow") {
    theory.isSuccessful = narrowing.diagnostics.len > 0;
    theory.detail = "narrowing an opaque pointer produced no diagnostic";
  }

  let mismatched = checkSource("import.unsafe;\nfunction f(p: unsafe_ptr<uint8>): unsafe_ptr<int32> { return p; }");
  let test theory: Case = t.asserts("pointee types must match") {
    theory.isSuccessful = mismatched.diagnostics.len > 0;
    theory.detail = "converting between pointee types produced no diagnostic";
  }

  let toPtr = checkSource("import.unsafe;\nfunction f(): unsafe_ptr<uint8> { return null; }");
  let test theory: Case = t.asserts("null fits any raw pointer") {
    theory.isSuccessful = toPtr.diagnostics.len == 0;
    theory.detail = `reported ${toPtr.diagnostics.len}: ${firstDiagnostic(ref toPtr)}`;
  }

  // And nothing else - null is not a general "empty" value.
  let toInt = checkSource("function f(): int { return null; }");
  let test theory: Case = t.asserts("null does not fit an integer") {
    theory.isSuccessful = toInt.diagnostics.len > 0;
    theory.detail = "returning null from an int function produced no diagnostic";
  }

  let toString = checkSource("function f(): string { return null; }");
  let test theory: Case = t.asserts("nor a string") {
    theory.isSuccessful = toString.diagnostics.len > 0;
    theory.detail = "returning null from a string function produced no diagnostic";
  }
}

suite function slicesAndVtablesAreChecked(): void {
  let ok = checkSource("function f(xs: int32[]): int32 { const s: int32[] = xs[1..3]; return s[0]; }");
  let test theory: Case = t.asserts("a slice of an array is the same array type") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let wrongElem = checkSource("function f(xs: int32[]): int { const s: uint8[] = xs[1..3]; return 0; }");
  let test theory: Case = t.asserts("and keeps its element type") {
    theory.isSuccessful = wrongElem.diagnostics.len > 0;
    theory.detail = "assigning an int32 slice to a uint8[] produced no diagnostic";
  }

  let notArray = checkSource("function f(n: int): int { const s: int[] = n[1..2]; return 0; }");
  let test theory: Case = t.asserts("slicing a non-array is refused by type name") {
    theory.isSuccessful = diagnosticsMention(ref notArray, "only an array can be sliced");
    theory.detail = `wanted a not-an-array refusal, got: ${firstDiagnostic(ref notArray)}`;
  }

  const readable = "trait Readable { function read(ref self): int; } ";
  let vt = checkSource(`${readable}vtable Reader for Readable { read: () => int, } function main(): int { return 0; }`);
  let test theory: Case = t.asserts("a vtable over a real trait checks clean") {
    theory.isSuccessful = vt.diagnostics.len == 0;
    theory.detail = `reported ${vt.diagnostics.len}: ${firstDiagnostic(ref vt)}`;
  }

  // Erasing something that is not a trait is the same class of mistake as
  // `implements` on a non-trait, and reads the same way.
  let notTrait = checkSource("type Helper { n: int, } vtable Reader for Helper { read: () => int, } function main(): int { return 0; }");
  let test theory: Case = t.asserts("a vtable over a non-trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref notTrait, "is not a trait");
    theory.detail = `wanted a non-trait refusal, got: ${firstDiagnostic(ref notTrait)}`;
  }

  // A vtable's NAME is a type, because a vtable is a struct of function
  // pointers - that is what lets it be a parameter.
  let asType = checkSource(`${readable}vtable Reader for Readable { read: () => int, } function take(r: Reader): int { return 0; } function main(): int { return 0; }`);
  let test theory: Case = t.asserts("a vtable name resolves as a type") {
    theory.isSuccessful = asType.diagnostics.len == 0;
    theory.detail = `reported ${asType.diagnostics.len}: ${firstDiagnostic(ref asType)}`;
  }
}

// ----- address-of and dereference --------------------------------------------

suite function addressOfAndDerefAreGatedAndTyped(): void {
  // Both are gated: handing out a raw address without saying the file is unsafe
  // would let the `unsafe_ptr` gate be bypassed by one character.
  let ungatedAddr = checkSource("function f(): int { let n: int32 = 1; const p: int = &n; return 0; }");
  let test theory: Case = t.asserts("`&x` without `import.unsafe;` is refused") {
    theory.isSuccessful = diagnosticsMention(ref ungatedAddr, "import.unsafe");
    theory.detail = `wanted the gate diagnostic, got: ${firstDiagnostic(ref ungatedAddr)}`;
  }

  let ok = checkSource("import.unsafe;\nfunction f(): int32 { let n: int32 = 1; const p: unsafe_ptr<int32> = &n; return *p; }");
  let test theory: Case = t.asserts("`&x` gives a pointer to x's type, and `*p` gives it back") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let wrongPointee = checkSource("import.unsafe;\nfunction f(): int { let n: int32 = 1; const p: unsafe_ptr<uint8> = &n; return 0; }");
  let test theory: Case = t.asserts("the pointee is the target's type, not any type") {
    theory.isSuccessful = wrongPointee.diagnostics.len > 0;
    theory.detail = "&int32 accepted as unsafe_ptr<uint8>";
  }

  // An address needs storage, and a temporary has none.
  let temporary = checkSource("import.unsafe;\nfunction f(): int { const p: unsafe_ptr<int32> = &(1 + 2); return 0; }");
  let test theory: Case = t.asserts("taking the address of a temporary is refused") {
    theory.isSuccessful = temporary.diagnostics.len > 0;
    theory.detail = "&(1 + 2) produced no diagnostic";
  }

  // The practical cost of widening: an opaque pointer has no pointee, so there
  // is nothing for a read through it to produce.
  let derefOpaque = checkSource("import.unsafe;\nfunction f(p: unsafe_ptr): int { return *p; }");
  let test theory: Case = t.asserts("an opaque pointer cannot be dereferenced") {
    theory.isSuccessful = diagnosticsMention(ref derefOpaque, "no pointee");
    theory.detail = `wanted a no-pointee refusal, got: ${firstDiagnostic(ref derefOpaque)}`;
  }

  let derefInt = checkSource("import.unsafe;\nfunction f(n: int32): int32 { return *n; }");
  let test theory: Case = t.asserts("dereferencing a non-pointer is refused by type name") {
    theory.isSuccessful = diagnosticsMention(ref derefInt, "only a raw pointer");
    theory.detail = `wanted a not-a-pointer refusal, got: ${firstDiagnostic(ref derefInt)}`;
  }

  // A store through a pointer targets the POINTEE, so the value is checked
  // against that rather than against the pointer.
  let storeThrough = checkSource("import.unsafe;\nfunction f(): void { let n: int32 = 1; const p: unsafe_ptr<int32> = &n; *p = 9; }");
  let test theory: Case = t.asserts("a store through a pointer checks against the pointee") {
    theory.isSuccessful = storeThrough.diagnostics.len == 0;
    theory.detail = `reported ${storeThrough.diagnostics.len}: ${firstDiagnostic(ref storeThrough)}`;
  }

  let storeWrongType = checkSource("import.unsafe;\nfunction f(): void { let n: int32 = 1; const p: unsafe_ptr<int32> = &n; *p = \"x\"; }");
  let test theory: Case = t.asserts("and refuses a value of the wrong type") {
    theory.isSuccessful = storeWrongType.diagnostics.len > 0;
    theory.detail = "storing a string through an int32 pointer produced no diagnostic";
  }
}

// ----- what real std code found ----------------------------------------------

// Every one of these was invisible until std hit it, and every one produced a
// message far from its cause. They are grouped because that is what they have
// in common: each is a place where a piece of context failed to travel.
suite function genericContextTravels(): void {
  // `ref self` inside a generic type is `Box<T>`, not bare `Box` - which
  // otherwise reports "Box is generic, so it needs type arguments" pointing at
  // the method, with nothing about `self` in it.
  let selfInGeneric = checkSource("trait Sized { function size(ref self): usize; } type Box<T> implements Sized { value: T, function size(ref self): usize { return 1; } } function main(): int { return 0; }");
  let test theory: Case = t.asserts("`ref self` in a generic type carries the type parameters") {
    theory.isSuccessful = selfInGeneric.diagnostics.len == 0;
    theory.detail = `reported ${selfInGeneric.diagnostics.len}: ${firstDiagnostic(ref selfInGeneric)}`;
  }

  // Trait satisfaction is checked in its own sweep because the GENERIC sweep
  // runs before traits are filled. Declaring the trait AFTER the generic type
  // is what exposes it.
  let traitAfter = checkSource("type Box<T> implements Sized { value: T, function size(ref self): usize { return 1; } } trait Sized { function size(ref self): usize; } function main(): int { return 0; }");
  let test theory: Case = t.asserts("a trait declared after a generic implementer still counts") {
    theory.isSuccessful = traitAfter.diagnostics.len == 0;
    theory.detail = `reported ${traitAfter.diagnostics.len}: ${firstDiagnostic(ref traitAfter)}`;
  }

  // ...and the check still FIRES, rather than being skipped into silence.
  let stillChecked = checkSource("trait Sized { function size(ref self): usize; } type Box<T> implements Sized { value: T, } function main(): int { return 0; }");
  let test theory: Case = t.asserts("and an unimplemented method is still refused") {
    theory.isSuccessful = diagnosticsMention(ref stillChecked, "size");
    theory.detail = `wanted a missing-method refusal, got: ${firstDiagnostic(ref stillChecked)}`;
  }

  // A generic function's BODY needs the parameters in scope, not just its
  // signature: `let xs: T[] = ...` is an annotation inside the body.
  let bodyParams = checkSource("function pair<T>(a: T, b: T): usize { const both: T[] = [a, b]; return both.len; } function main(): int { return 0; }");
  let test theory: Case = t.asserts("a generic body may annotate with its own type parameters") {
    theory.isSuccessful = bodyParams.diagnostics.len == 0;
    theory.detail = `reported ${bodyParams.diagnostics.len}: ${firstDiagnostic(ref bodyParams)}`;
  }
}

suite function literalsPinToTheirNeighbours(): void {
  // A cast CONVERTS what it is given, so the target must not reach in and pin
  // the operand - that made `uint8(48 + big)` refuse to add an int to a uint64.
  let castOperand = checkSource("function f(rest: uint64): uint8 { return uint8(48 + (rest % 10)); }");
  let test theory: Case = t.asserts("a cast does not pin its operand") {
    theory.isSuccessful = castOperand.diagnostics.len == 0;
    theory.detail = `reported ${castOperand.diagnostics.len}: ${firstDiagnostic(ref castOperand)}`;
  }

  // A LEADING literal has already defaulted to int32 by the time the right side
  // is known, so it gets re-pinned. The trailing case worked all along.
  let leading = checkSource("function f(n: uint64): uint64 { return 2 * n; }");
  let test theory: Case = t.asserts("a leading literal takes the other operand's type") {
    theory.isSuccessful = leading.diagnostics.len == 0;
    theory.detail = `reported ${leading.diagnostics.len}: ${firstDiagnostic(ref leading)}`;
  }

  let trailing = checkSource("function f(n: uint64): uint64 { return n * 2; }");
  let test theory: Case = t.asserts("as does a trailing one") {
    theory.isSuccessful = trailing.diagnostics.len == 0;
    theory.detail = `reported ${trailing.diagnostics.len}: ${firstDiagnostic(ref trailing)}`;
  }

  // Re-pinning must not paper over a REAL mismatch between two typed operands.
  let realMismatch = checkSource("function f(a: uint8, b: uint64): uint64 { return a + b; }");
  let test theory: Case = t.asserts("two typed operands of different widths are still refused") {
    theory.isSuccessful = realMismatch.diagnostics.len > 0;
    theory.detail = "uint8 + uint64 produced no diagnostic";
  }
}

suite function stringLenIsByteLength(): void {
  let ok = checkSource("function f(s: string): usize { return s.len; }");
  let test theory: Case = t.asserts("a string has `.len`") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let other = checkSource("function f(s: string): usize { return s.size; }");
  let test theory: Case = t.asserts("and nothing else") {
    theory.isSuccessful = other.diagnostics.len > 0;
    theory.detail = "`s.size` produced no diagnostic";
  }
}

// ----- the runtime bridge and generic methods --------------------------------

suite function errnoIsAnAmbientBridge(): void {
  // Resolved by SPELLING, not by import - there is nothing to import it from,
  // the same way the reference's ERRNO_INTRINSIC works.
  let ok = checkSource("function f(): int { errno.set(0); return int(errno.get()); }");
  let test theory: Case = t.asserts("errno.get and errno.set need no import") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let msg = checkSource("function f(c: c_int): string { return errno.message(c); }");
  let test theory: Case = t.asserts("errno.message gives a string") {
    theory.isSuccessful = msg.diagnostics.len == 0;
    theory.detail = `reported ${msg.diagnostics.len}: ${firstDiagnostic(ref msg)}`;
  }

  let arity = checkSource("function f(): int { return int(errno.get(1)); }");
  let test theory: Case = t.asserts("errno.get takes no arguments") {
    theory.isSuccessful = arity.diagnostics.len > 0;
    theory.detail = "errno.get(1) produced no diagnostic";
  }

  let unknown = checkSource("function f(): int { return int(errno.reset()); }");
  let test theory: Case = t.asserts("an unknown errno member is refused, by name") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "reset");
    theory.detail = `wanted an unknown-member refusal, got: ${firstDiagnostic(ref unknown)}`;
  }
}

suite function genericTypesCarryTheirMethods(): void {
  const decls = "trait Sized { function size(ref self): usize; } type Box<T> implements Sized { value: T, count: usize, function size(ref self): usize { return self.count; } } ";

  // `Vec<T>` INSIDE its own body names the TEMPLATE, not a second instance.
  // Without that, `self.count` is looked up on an empty `Box_T` and the method
  // is told its own type has no such field.
  let ok = checkSource(`${decls}function main(): int { const b: Box<int32> = { value: 1, count: 2 }; return int(Sized.size(ref b)); }`);
  let test theory: Case = t.asserts("a generic type's method reads its own fields") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The instance keeps the methods, so it keeps satisfying the trait.
  let dispatch = checkSource(`${decls}function main(): int { const b: Box<string> = { value: "x", count: 9 }; return int(Sized.size(ref b)); }`);
  let test theory: Case = t.asserts("an instantiation still implements what the template does") {
    theory.isSuccessful = dispatch.diagnostics.len == 0;
    theory.detail = `reported ${dispatch.diagnostics.len}: ${firstDiagnostic(ref dispatch)}`;
  }

  // A method body is CHECKED, which it was not while `ownTypeOf` had no
  // GenericDecl case - it silently did nothing.
  let badBody = checkSource("trait Sized { function size(ref self): usize; } type Box<T> implements Sized { value: T, function size(ref self): usize { return self.nope; } } function main(): int { return 0; }");
  let test theory: Case = t.asserts("and its body is actually checked") {
    theory.isSuccessful = diagnosticsMention(ref badBody, "nope");
    theory.detail = `wanted an unknown-field diagnostic, got: ${firstDiagnostic(ref badBody)}`;
  }
}

suite function borrowsAndArrayFieldsReachFurther(): void {
  let field = checkSource("type Inner { n: int, } type Outer { part: Inner, } function bump(ref i: Inner): void { i.n = 1; } function f(): void { let o: Outer = { part: { n: 0 } }; bump(ref o.part); }");
  let test theory: Case = t.asserts("`ref` takes a field of a named binding") {
    theory.isSuccessful = field.diagnostics.len == 0;
    theory.detail = `reported ${field.diagnostics.len}: ${firstDiagnostic(ref field)}`;
  }

  // A temporary still has no address, which is the rule the extension must not
  // lose.
  let temporary = checkSource("function g(ref n: int): void { } function f(): void { g(ref (1 + 2)); }");
  let test theory: Case = t.asserts("but not a temporary") {
    theory.isSuccessful = temporary.diagnostics.len > 0;
    theory.detail = "`ref (1 + 2)` produced no diagnostic";
  }

  let ptr = checkSource("import.unsafe;\nfunction f(xs: uint8[]): unsafe_ptr<uint8> { return xs.ptr; }");
  let test theory: Case = t.asserts("an array has `.ptr`, the data pointer") {
    theory.isSuccessful = ptr.diagnostics.len == 0;
    theory.detail = `reported ${ptr.diagnostics.len}: ${firstDiagnostic(ref ptr)}`;
  }

  let wrongElem = checkSource("import.unsafe;\nfunction f(xs: uint8[]): unsafe_ptr<int32> { return xs.ptr; }");
  let test theory: Case = t.asserts("whose pointee is the ELEMENT type") {
    theory.isSuccessful = wrongElem.diagnostics.len > 0;
    theory.detail = "a uint8[] gave an unsafe_ptr<int32>";
  }

  let neither = checkSource("function f(xs: uint8[]): usize { return xs.size; }");
  let test theory: Case = t.asserts("and nothing else") {
    theory.isSuccessful = diagnosticsMention(ref neither, "only \"len\" and \"ptr\"");
    theory.detail = `wanted the two-field message, got: ${firstDiagnostic(ref neither)}`;
  }
}

// ----- scope-end disposal ----------------------------------------------------

suite function kindsThatDemandAScopeEndCall(): void {
  const decls = "kind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; } trait Closer { function close(ref self): void; } type Res implements Closer { n: int, function close(ref self): void { } } ";

  let ok = checkSource(`${decls}function main(): int { tracked r: Res = { n: 1 }; return 0; }`);
  let test theory: Case = t.asserts("a binding whose type has the method checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // The promise is about the program: `disposable buf: Foo` where Foo has no
  // `dispose` is a mistake in the source, and codegen meeting it would be a
  // mistake in the compiler.
  let noMethod = checkSource("trait Closer { function close(ref self): void; } kind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; } type Bare { n: int, } function main(): int { tracked r: Bare = { n: 1 }; return 0; }");
  let test theory: Case = t.asserts("a binding whose type lacks the method is refused, naming both") {
    theory.isSuccessful = diagnosticsMention(ref noMethod, "close") &&
      diagnosticsMention(ref noMethod, "Bare");
    theory.detail = `wanted the method and the type named, got: ${firstDiagnostic(ref noMethod)}`;
  }

  let unknownKind = checkSource("type Res { n: int, } function main(): int { nosuch r: Res = { n: 1 }; return 0; }");
  let test theory: Case = t.asserts("an undeclared kind on a binding is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknownKind, "nosuch");
    theory.detail = `wanted an unknown-kind refusal, got: ${firstDiagnostic(ref unknownKind)}`;
  }

  // A kind with no `mustCall` records nothing and demands nothing - which is
  // what keeps `pooled` and `tainted` from needing a method.
  let noClause = checkSource("kind tainted { appliesTo binding; } type Bare { n: int, } function main(): int { tainted r: Bare = { n: 1 }; return 0; }");
  let test theory: Case = t.asserts("a kind that asks for nothing needs no method") {
    theory.isSuccessful = noClause.diagnostics.len == 0;
    theory.detail = `reported ${noClause.diagnostics.len}: ${firstDiagnostic(ref noClause)}`;
  }
}

suite function regionsNeedARegionKind(): void {
  const closerTrait = "trait Closer { function close(ref self): void; } ";
  const closer = `${closerTrait}type Res implements Closer { n: int, function close(ref self): void { } } function open(): Res { return { n: 1 }; } `;
  const regionKind = "kind region { appliesTo region; requires Closer; mustCall close beforeScopeEnd; ownsBlock; } ";

  let ok = checkSource(`${regionKind}${closer}function main(): int { region open() { } return 0; }`);
  let test theory: Case = t.asserts("an anonymous region over a region kind checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // A binding kind used anonymously has nothing to be called ON later, and the
  // message has to name the alternative - the reference's does.
  let bindingKind = checkSource(`kind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; } ${closer}function main(): int { tracked open() { } return 0; }`);
  let test theory: Case = t.asserts("a BINDING kind used anonymously is refused, pointing at the named form") {
    theory.isSuccessful = diagnosticsMention(ref bindingKind, "does not apply to a region") &&
      diagnosticsMention(ref bindingKind, "name: T = EXPR");
    theory.detail = `wanted the region refusal and the alternative, got: ${firstDiagnostic(ref bindingKind)}`;
  }

  let subjectLacks = checkSource(`${regionKind}${closerTrait}type Bare { n: int, } function open(): Bare { return { n: 1 }; } function main(): int { region open() { } return 0; }`);
  let test theory: Case = t.asserts("a region whose subject lacks the method is refused") {
    theory.isSuccessful = subjectLacks.diagnostics.len > 0;
    theory.detail = "a subject with no close method produced no diagnostic";
  }

  // A region kind that demands nothing would make the form a plain block with
  // extra words, which is worth saying rather than accepting.
  let noDemand = checkSource(`kind idle { appliesTo region; ownsBlock; } ${closer}function main(): int { idle open() { } return 0; }`);
  let test theory: Case = t.asserts("a region kind that asks for nothing is refused") {
    theory.isSuccessful = diagnosticsMention(ref noDemand, "plain block");
    theory.detail = `wanted the plain-block refusal, got: ${firstDiagnostic(ref noDemand)}`;
  }
}

// ----- mutable globals -------------------------------------------------------

// A module-level `const` is INLINED at every use; a module-level `let` is a
// real global with an address. That difference is the whole feature: a write in
// one function has to be visible in another, which inlining cannot express.
suite function moduleGlobalsAreRealStorage(): void {
  let ok = checkSource("let COUNT: int32 = 0;\nfunction bump(): void { COUNT = COUNT + 1; }\nfunction main(): int { bump(); return int(COUNT); }");
  let test theory: Case = t.asserts("a global is readable and writable from any function") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Writing a const is refused with a message that says WHY, and the why is
  // immutability rather than a missing address: a const may well have one now.
  let writeConst = checkSource("const K: int32 = 1;\nfunction main(): int { K = 2; return 0; }");
  let test theory: Case = t.asserts("a module const cannot be assigned, and the message says why") {
    theory.isSuccessful = diagnosticsMention(ref writeConst, "a module-level const is immutable");
    theory.detail = `wanted the immutability message, got: ${firstDiagnostic(ref writeConst)}`;
  }

  // An INTEGER literal initializer is baked into the LLVM global. Anything else
  // is a RUN-TIME initializer, stored by the module's init function before
  // `main` runs a line of user code. So the initializer is accepted and still
  // CHECKED - it is an ordinary expression pass D reads, so the annotation is
  // what it has to satisfy.
  let computed = checkSource("function f(): int32 { return 1; }\nlet N: int32 = f();\nfunction main(): int { return 0; }");
  let test theory: Case = t.asserts("a non-literal initializer is accepted") {
    theory.isSuccessful = computed.diagnostics.len == 0;
    theory.detail = `reported ${computed.diagnostics.len}: ${firstDiagnostic(ref computed)}`;
  }

  let wrongInit = checkSource("function f(): string { return \"x\"; }\nlet N: int32 = f();\nfunction main(): int { return 0; }");
  let test theory: Case = t.asserts("a run-time initializer is checked against the annotation") {
    theory.isSuccessful = diagnosticsMention(ref wrongInit, "its initializer is");
    theory.detail = `wanted a type mismatch, got: ${firstDiagnostic(ref wrongInit)}`;
  }

  let noAnnot = checkSource("let N = 7;\nfunction main(): int { return 0; }");
  let test theory: Case = t.asserts("a global needs a type annotation") {
    theory.isSuccessful = diagnosticsMention(ref noAnnot, "needs a type annotation");
    theory.detail = `wanted an annotation diagnostic, got: ${firstDiagnostic(ref noAnnot)}`;
  }

  let wrongWrite = checkSource("let N: int32 = 0;\nfunction main(): int { N = \"x\"; return 0; }");
  let test theory: Case = t.asserts("a write is checked against the global's type") {
    theory.isSuccessful = wrongWrite.diagnostics.len > 0;
    theory.detail = "storing a string into an int32 global produced no diagnostic";
  }

  // A LOCAL shadows a global, and the local's mutability rules still apply.
  let shadowed = checkSource("let N: int32 = 0;\nfunction main(): int { const N: int32 = 1; N = 2; return 0; }");
  let test theory: Case = t.asserts("a local shadows a global, keeping its own constness") {
    theory.isSuccessful = diagnosticsMention(ref shadowed, "cannot assign to const");
    theory.detail = `wanted a const-assignment refusal, got: ${firstDiagnostic(ref shadowed)}`;
  }
}

// `runSuite()` where `runSuite` is a LOCAL holding a function value - the same
// indirect call a function-typed field produces, reached through a name.
suite function functionValuesInLocalsAreCallable(): void {
  let ok = checkSource("function hello(): void { } function main(): int { const f: () => void = hello; f(); return 0; }");
  let test theory: Case = t.asserts("a local holding a function value is callable") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let badArgs = checkSource("function hello(): void { } function main(): int { const f: () => void = hello; f(1); return 0; }");
  let test theory: Case = t.asserts("and its arguments are checked against the local's signature") {
    theory.isSuccessful = badArgs.diagnostics.len > 0;
    theory.detail = "calling a no-argument function value with one produced no diagnostic";
  }

  // A local shadows a module function of the same name, so the local's TYPE is
  // what the call is checked against.
  let shadowing = checkSource("function f(n: int32): void { } function main(): int { const f: () => void = g; f(); return 0; } function g(): void { }");
  let test theory: Case = t.asserts("a local function value shadows a module function") {
    theory.isSuccessful = shadowing.diagnostics.len == 0;
    theory.detail = `reported ${shadowing.diagnostics.len}: ${firstDiagnostic(ref shadowing)}`;
  }
}

// ----- `?` error propagation --------------------------------------------------
//
// Every source below declares its own fallible variant inline. That is verbose,
// and it is deliberate: the SHAPE of that declaration is what most of these
// tests are about, so factoring it out would hide the thing under test.

// The FALLIBLE shape, which is narrower than it looks and was established by
// probing the JS reference rather than by reading it. Exactly two cases, named
// `Ok` and `Err`, each carrying zero or one field. Each clause below rejects
// something the reference also rejects, and each gets its own assertion because
// each is a plausible thing to get wrong while "it works on Result" still holds.
suite function tryOpNeedsAFallibleOperand(): void {
  let ok = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("`?` on a fallible variant inside a fallible function checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  // Not a variant at all.
  let notVariant = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction outer(n: int32): R { let x: int32 = n?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("`?` on an int is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref notVariant, "applied to non-fallible type");
    theory.detail = `wanted a non-fallible refusal, got: ${firstDiagnostic(ref notVariant)}`;
  }

  // A variant with no `Err`. This is the `Option<T>` shape, and the reference
  // refuses `?` on one - worth its own assertion, because "the optional works
  // too" is the natural assumption and it is wrong here.
  let noErr = checkSource("variant Maybe { Ok { value: int32 }, Nope, }\nvariant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): Maybe { return Maybe.Ok { value: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("a variant with no Err case is not fallible") {
    theory.isSuccessful = diagnosticsMention(ref noErr, "applied to non-fallible type");
    theory.detail = `wanted a non-fallible refusal, got: ${firstDiagnostic(ref noErr)}`;
  }

  // A THIRD case. Ok and Err are both present, so a test that only looked those
  // two up would pass this - and the value would be neither success nor failure.
  let threeCases = checkSource("variant T3 { Ok { value: int32 }, Err { error: int32 }, Pending, }\nvariant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): T3 { return T3.Ok { value: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("a third case makes it non-fallible") {
    theory.isSuccessful = diagnosticsMention(ref threeCases, "applied to non-fallible type");
    theory.detail = `wanted a non-fallible refusal, got: ${firstDiagnostic(ref threeCases)}`;
  }

  // TWO payload fields. There is no rule that would make one of them the value
  // `?` yields, so the reference refuses it and so does this.
  let wide = checkSource("variant W { Ok { a: int32, b: int32 }, Err { error: int32 }, }\nvariant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): W { return W.Ok { a: n, b: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("a case carrying two fields makes it non-fallible") {
    theory.isSuccessful = diagnosticsMention(ref wide, "applied to non-fallible type");
    theory.detail = `wanted a non-fallible refusal, got: ${firstDiagnostic(ref wide)}`;
  }

  // The field NAMES do not matter - one field is one field.
  let renamed = checkSource("variant N { Ok { v: int32 }, Err { e: int32 }, }\nfunction inner(n: int32): N { return N.Ok { v: n }; }\nfunction outer(n: int32): N { let x: int32 = inner(n)?; return N.Ok { v: x }; }");
  let test theory: Case = t.asserts("the payload field names are not part of the shape") {
    theory.isSuccessful = renamed.diagnostics.len == 0;
    theory.detail = `reported ${renamed.diagnostics.len}: ${firstDiagnostic(ref renamed)}`;
  }

  // Payload-LESS on both sides. `inner(n)?` yields nothing and propagates
  // nothing, and both halves come out of the same code as the carrying case
  // rather than needing a branch of their own.
  let bare = checkSource("variant B { Ok, Err, }\nfunction inner(n: int32): B { return B.Ok; }\nfunction outer(n: int32): B { inner(n)?; return B.Ok; }");
  let test theory: Case = t.asserts("a payload-less Ok/Err pair is fallible") {
    theory.isSuccessful = bare.diagnostics.len == 0;
    theory.detail = `reported ${bare.diagnostics.len}: ${firstDiagnostic(ref bare)}`;
  }
}

// The ENCLOSING function has to have somewhere to send the Err. This is the
// half a reader hits first, so the message names the function and what it
// returns rather than just saying no.
suite function tryOpNeedsAFallibleEnclosingReturn(): void {
  let plain = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)?; return x; }");
  let test theory: Case = t.asserts("`?` in a function returning int32 is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref plain, "only legal inside a function that returns a fallible variant");
    theory.detail = `wanted an enclosing-return refusal, got: ${firstDiagnostic(ref plain)}`;
  }

  let test theory: Case = t.asserts("and the message names the function it is talking about") {
    theory.isSuccessful = diagnosticsMention(ref plain, "\"outer\" returns int32");
    theory.detail = `wanted the function named, got: ${firstDiagnostic(ref plain)}`;
  }

  // A METHOD is an ordinary function by the time pass D sees it, so the same
  // check has to reach it. `checkBodyAgainst` is shared between the two, and
  // this asserts the ambient return type is set on that path too - forgetting
  // it would leave every method's `?` reading the last function's return type.
  let method = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\ntrait Doer { function run(ref self, n: int32): R; }\ntype Runner implements Doer { bump: int32, function run(ref self, n: int32): R { let v: int32 = inner(n)?; return R.Ok { value: v + self.bump }; } }");
  let test theory: Case = t.asserts("`?` works inside a method body") {
    theory.isSuccessful = method.diagnostics.len == 0;
    theory.detail = `reported ${method.diagnostics.len}: ${firstDiagnostic(ref method)}`;
  }
}

// The two Err payloads have to agree. The reference accepts a mismatch when the
// operand's error implements `Into<TargetErr>` and folds the conversion into
// the err branch; the bootstrap has no generic trait instantiation yet, so it
// refuses and SAYS SO rather than picking one of the two types and being wrong.
suite function tryOpChecksTheErrorTypesAgainstEachOther(): void {
  let mismatch = checkSource("variant A { Ok { value: int32 }, Err { error: int32 }, }\nvariant S { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): S { let x: int32 = inner(n)?; return S.Ok { value: x }; }");
  let test theory: Case = t.asserts("propagating an int32 Err into a string Err is refused") {
    theory.isSuccessful = diagnosticsMention(ref mismatch, "cannot propagate Err of");
    theory.detail = `wanted an error-type refusal, got: ${firstDiagnostic(ref mismatch)}`;
  }

  // And the message names the ROUTE OUT rather than just the mismatch: the two
  // payloads either match or the first implements Into<the second>, and a
  // reader who has neither wants to be told which two things are on offer.
  let test theory: Case = t.asserts("and the message names the Into route out") {
    theory.isSuccessful = diagnosticsMention(ref mismatch, "implement Into<string>");
    theory.detail = `wanted the Into route named, got: ${firstDiagnostic(ref mismatch)}`;
  }

  // With the impl present it is no longer a mismatch at all. The conversion is
  // a `ref self` method on the operand's error, called in the FAILURE branch,
  // so the success path costs nothing.
  const INTO: string = "trait Into<T> { function into(ref self): T; }\ntype AppErr { code: int32, }\ntype IoErr implements Into<AppErr> { code: int32,\n  function into(ref self): AppErr { return { code: self.code + 1 }; } }\nvariant A { Ok { value: int32 }, Err { error: IoErr }, }\nvariant S { Ok { value: int32 }, Err { error: AppErr }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): S { let x: int32 = inner(n)?; return S.Ok { value: x }; }\nfunction main(): int32 { return 0; }";
  let converts = checkSource(INTO);
  let test theory: Case = t.asserts("an Into impl on the operand's error makes the propagation legal") {
    theory.isSuccessful = converts.diagnostics.len == 0;
    theory.detail = `an Into conversion reported: ${firstDiagnostic(ref converts)}`;
  }

  // The impl has to be for the RIGHT target. `Into<Other>` is a promise about
  // a different type and does not make this propagation fit.
  const WRONG: string = "trait Into<T> { function into(ref self): T; }\ntype AppErr { code: int32, }\ntype Other { code: int32, }\ntype IoErr implements Into<Other> { code: int32,\n  function into(ref self): Other { return { code: self.code }; } }\nvariant A { Ok { value: int32 }, Err { error: IoErr }, }\nvariant S { Ok { value: int32 }, Err { error: AppErr }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): S { let x: int32 = inner(n)?; return S.Ok { value: x }; }\nfunction main(): int32 { return 0; }";
  let wrongTarget = checkSource(WRONG);
  let test theory: Case = t.asserts("an Into impl for a DIFFERENT target does not count") {
    theory.isSuccessful = diagnosticsMention(ref wrongTarget, "cannot propagate Err of");
    theory.detail = `wanted a refusal for the wrong Into target, got: ${firstDiagnostic(ref wrongTarget)}`;
  }

  // The two fallible TYPES need not match - only their Err payloads do. `?`
  // rebuilds the enclosing function's Err around the operand's error rather
  // than forwarding the operand's value, so the Ok halves are free to differ.
  let crossType = checkSource("variant A { Ok { value: int32 }, Err { error: int32 }, }\nvariant B { Ok { value: bool }, Err { error: int32 }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): B { let x: int32 = inner(n)?; return B.Ok { value: x > 0 }; }");
  let test theory: Case = t.asserts("two different fallible types agree if their Err payloads do") {
    theory.isSuccessful = crossType.diagnostics.len == 0;
    theory.detail = `reported ${crossType.diagnostics.len}: ${firstDiagnostic(ref crossType)}`;
  }
}

// `expr? "context"` - the note prefixed onto the error on the way out. Two
// shapes and one refusal, and the shapes are genuinely different mechanisms:
// two `string` payloads are concatenated by the compiler, anything else goes
// through a `WithContext<TargetErr>` impl on the operand's error type.
suite function tryOpTakesAContextString(): void {
  const STRINGS: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)? \"loading config\"; return R.Ok { value: x }; }";
  let concat = checkSource(STRINGS);
  let test theory: Case = t.asserts("two string Err payloads take a context with no impl at all") {
    theory.isSuccessful = concat.diagnostics.len == 0;
    theory.detail = `reported ${concat.diagnostics.len}: ${firstDiagnostic(ref concat)}`;
  }

  // The TEMPLATE spelling of the same thing. It lexes differently and gets its
  // own case for that reason; the interpolation is checked like any other.
  const TEMPLATE: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): R { let x: int32 = inner(n)? `reading ${n}`; return R.Ok { value: x }; }";
  let templated = checkSource(TEMPLATE);
  let test theory: Case = t.asserts("an interpolated context checks like any other template") {
    theory.isSuccessful = templated.diagnostics.len == 0;
    theory.detail = `reported ${templated.diagnostics.len}: ${firstDiagnostic(ref templated)}`;
  }

  // A structured payload with the impl: one call does the decoration AND the
  // conversion, which is why there is no `Into` anywhere in this source.
  const WITH_CONTEXT: string = "trait WithContext<T> { function withContext(ref self, context: string): T; }\ntype AppErr { detail: string, }\ntype IoErr implements WithContext<AppErr> { code: int32,\n  function withContext(ref self, context: string): AppErr { return { detail: context }; } }\nvariant A { Ok { value: int32 }, Err { error: IoErr }, }\nvariant S { Ok { value: int32 }, Err { error: AppErr }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): S { let x: int32 = inner(n)? \"loading header\"; return S.Ok { value: x }; }\nfunction main(): int32 { return 0; }";
  let viaImpl = checkSource(WITH_CONTEXT);
  let test theory: Case = t.asserts("a WithContext impl carries a context across two different Err types") {
    theory.isSuccessful = viaImpl.diagnostics.len == 0;
    theory.detail = `reported ${viaImpl.diagnostics.len}: ${firstDiagnostic(ref viaImpl)}`;
  }

  // Neither shape: a struct payload with no impl. The message ends in the
  // clause a reader would paste, which is the whole reason it names the target
  // type twice.
  const NEITHER: string = "type AppErr { detail: string, }\ntype IoErr { code: int32, }\nvariant A { Ok { value: int32 }, Err { error: IoErr }, }\nvariant S { Ok { value: int32 }, Err { error: AppErr }, }\nfunction inner(n: int32): A { return A.Ok { value: n }; }\nfunction outer(n: int32): S { let x: int32 = inner(n)? \"loading header\"; return S.Ok { value: x }; }";
  let neither = checkSource(NEITHER);
  let test theory: Case = t.asserts("a struct payload with no WithContext impl is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref neither, "needs a WithContext<");
    theory.detail = `wanted a WithContext refusal, got: ${firstDiagnostic(ref neither)}`;
  }

  let test theory: Case = t.asserts("and the message spells the clause to add") {
    theory.isSuccessful = diagnosticsMention(ref neither, "implements WithContext<AppErr>");
    theory.detail = `wanted the fix-it clause, got: ${firstDiagnostic(ref neither)}`;
  }
}

// `expr? e { ... }` - handling the failure instead of propagating it. The form
// exists to work where bare `?` cannot, so the first thing it has to do is stop
// asking about the enclosing function's return type.
suite function tryOpTakesAHandlerBlock(): void {
  const PLAIN_RETURN: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)? e { return -1; }; return x; }";
  let handled = checkSource(PLAIN_RETURN);
  let test theory: Case = t.asserts("a handler works in a function returning a plain value") {
    theory.isSuccessful = handled.diagnostics.len == 0;
    theory.detail = `reported ${handled.diagnostics.len}: ${firstDiagnostic(ref handled)}`;
  }

  // The binding names the Err PAYLOAD, so it has that type inside the block and
  // an operation the payload does not support is an ordinary type error.
  const WRONG_USE: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)? e { return e; }; return x; }";
  let wrongUse = checkSource(WRONG_USE);
  let test theory: Case = t.asserts("the binding really is the Err payload's type") {
    theory.isSuccessful = diagnosticsMention(ref wrongUse, "cannot return string");
    theory.detail = `wanted a type error on the binding, got: ${firstDiagnostic(ref wrongUse)}`;
  }

  // The block runs INSTEAD of producing a value, so falling out of the bottom
  // would leave the binding holding nothing. Refused by name.
  const FALLS_THROUGH: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)? e { let y: int32 = 1; }; return x; }";
  let fallsThrough = checkSource(FALLS_THROUGH);
  let test theory: Case = t.asserts("a handler block that falls through is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref fallsThrough, "must not fall through");
    theory.detail = `wanted a fall-through refusal, got: ${firstDiagnostic(ref fallsThrough)}`;
  }

  // An `if` with no `else` does not count: the false path falls out.
  const HALF_IF: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)? e { if (e.len > 0) { return -1; } }; return x; }";
  let halfIf = checkSource(HALF_IF);
  let test theory: Case = t.asserts("an `if` with no `else` does not count as leaving") {
    theory.isSuccessful = diagnosticsMention(ref halfIf, "must not fall through");
    theory.detail = `wanted a fall-through refusal, got: ${firstDiagnostic(ref halfIf)}`;
  }

  // Both halves of one does.
  const FULL_IF: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let x: int32 = inner(n)? e { if (e.len > 0) { return -1; } else { return -2; } }; return x; }";
  let fullIf = checkSource(FULL_IF);
  let test theory: Case = t.asserts("an if/else where both halves return does") {
    theory.isSuccessful = fullIf.diagnostics.len == 0;
    theory.detail = `reported ${fullIf.diagnostics.len}: ${firstDiagnostic(ref fullIf)}`;
  }

  // `continue` leaves the block just as permanently as a `return` does, as far
  // as the enclosing expression is concerned - which is what makes a handler
  // usable to skip a loop iteration.
  const CONTINUES: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): int32 { let total: int32 = 0; for (let i = 0; i < 3; i += 1) { let x: int32 = inner(i)? e { continue; }; total = total + x; } return total; }";
  let continues = checkSource(CONTINUES);
  let test theory: Case = t.asserts("`continue` counts as leaving the handler block") {
    theory.isSuccessful = continues.diagnostics.len == 0;
    theory.detail = `reported ${continues.diagnostics.len}: ${firstDiagnostic(ref continues)}`;
  }
}

// The COMPOUND shapes `alwaysDiverges` (typecheck/diverge.yoop) has to see
// through, asked at the one site that consults it: the `?` handler block.
//
// tryOpTakesAHandlerBlock above covers the flat answers - a bare `return`, a
// bare `continue`, an `if` with no `else`, an `if/else` where both halves
// return. What is here is the rest of the function's case list, and none of it
// is reachable any other way: divergence is not a value, so no program can
// print it, and the only consequence of getting it wrong is a diagnostic. The
// SWITCH arm in particular had no assertion at all, and a switch is the shape
// most likely to grow a bug, because "did every arm leave" is a loop over arms
// rather than a pair of slots.
//
// The dangerous direction is a false POSITIVE: a block wrongly called diverging
// falls out of the bottom into the Ok-payload read, with nothing in the slot
// the binding names. So every shape is asked in BOTH directions.
// The dead tail after a statement control never leaves.
//
// `alwaysDiverges` already answered "does control leave this statement"; this is
// the same question asked of a whole run, and the answer is a WARNING rather
// than an error - dead code is a smell, not a soundness problem, and stopping a
// build over it is hostile in the middle of editing.
//
// So every assertion here checks BOTH halves: the warning is present, and
// `errorCount` is still zero. A regression that promoted this to an error would
// otherwise pass a test that only looked for the message.
suite function deadCodeAfterADivergingStatementIsWarnedAbout(): void {
  const MAIN: string = "function main(): int32 { ";

  let afterReturn = checkSource(`${MAIN}return 0; let x: int32 = 1; }`);
  let test theory: Case = t.asserts("a statement after a return is flagged") {
    theory.isSuccessful = diagnosticsMention(ref afterReturn, "unreachable code");
    theory.detail = `wanted an unreachable warning, got: ${firstDiagnostic(ref afterReturn)}`;
  }
  let test theory: Case = t.asserts("and it is a warning, not an error") {
    theory.isSuccessful = errorCount(ref afterReturn) == 0;
    theory.detail = `dead code raised ${errorCount(ref afterReturn)} error(s)`;
  }

  // The ordinary shape of every function that ends in a return. Flagging this
  // would make the warning useless on the first program anybody wrote.
  let lastIsReturn = checkSource(`${MAIN}let x: int32 = 1; return x; }`);
  let test theory: Case = t.asserts("a block whose LAST statement diverges has no dead tail") {
    theory.isSuccessful = lastIsReturn.diagnostics.len == 0;
    theory.detail = `a clean function reported: ${firstDiagnostic(ref lastIsReturn)}`;
  }

  // break and continue leave the block as permanently as a return does, as far
  // as what follows them is concerned.
  let afterBreak = checkSource(
    `${MAIN}for (let i = 0; i < 3; i += 1) { break; let y: int32 = 2; } return 0; }`);
  let test theory: Case = t.asserts("a statement after a break is flagged") {
    theory.isSuccessful = diagnosticsMention(ref afterBreak, "unreachable code");
    theory.detail = `wanted an unreachable warning, got: ${firstDiagnostic(ref afterBreak)}`;
  }

  // The compound shapes are where this earns its place: the diverging statement
  // is not itself a terminator, so nothing simpler than alwaysDiverges could
  // see it.
  let afterIfElse = checkSource(
    "function f(a: bool): int32 { if (a) { return 1; } else { return 2; } let z: int32 = 3; }\nfunction main(): int32 { return f(true); }");
  let test theory: Case = t.asserts("a statement after an if whose BOTH arms return is flagged") {
    theory.isSuccessful = diagnosticsMention(ref afterIfElse, "unreachable code");
    theory.detail = `wanted an unreachable warning, got: ${firstDiagnostic(ref afterIfElse)}`;
  }

  // The dangerous direction. An `if` with no else always has a path that falls
  // through, so what follows it is live and flagging it would be a false
  // positive on correct code.
  let noElse = checkSource(
    "function f(a: bool): int32 { if (a) { return 1; } return 2; }\nfunction main(): int32 { return f(true); }");
  let test theory: Case = t.asserts("an if with no else leaves what follows it reachable") {
    theory.isSuccessful = noElse.diagnostics.len == 0;
    theory.detail = `an if with no else reported: ${firstDiagnostic(ref noElse)}`;
  }

  let afterSwitch = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } case false: { return 0; } } return -1; }\nfunction main(): int32 { return f(true); }");
  let test theory: Case = t.asserts("a statement after a switch whose every arm returns is flagged") {
    theory.isSuccessful = diagnosticsMention(ref afterSwitch, "unreachable code");
    theory.detail = `wanted an unreachable warning, got: ${firstDiagnostic(ref afterSwitch)}`;
  }

  // One mistake is one diagnostic: the tail is dead as a RUN, so reporting each
  // statement in it would bury the one line the reader has to act on.
  let longTail = checkSource(`${MAIN}return 0; let a: int32 = 1; let b: int32 = 2; let c: int32 = 3; }`);
  let test theory: Case = t.asserts("a dead run of three statements is reported once") {
    theory.isSuccessful = longTail.diagnostics.len == 1;
    theory.detail = `wanted exactly one diagnostic, got ${longTail.diagnostics.len}`;
  }

  // The statements in a dead tail are still CHECKED. Unreachable code that also
  // does not compile should say so, rather than hiding one mistake behind the
  // other.
  let deadAndBroken = checkSource(`${MAIN}return 0; let x: string = 1; }`);
  let test theory: Case = t.asserts("a dead statement is still typechecked") {
    theory.isSuccessful = errorCount(ref deadAndBroken) > 0;
    theory.detail = `a broken dead statement raised no error: ${firstDiagnostic(ref deadAndBroken)}`;
  }
}

suite function aHandlerBlockSeesThroughCompoundDivergence(): void {
  const DECLS: string = "variant R { Ok { value: int32 }, Err { error: string }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\n";
  const HANDLE: string = "function outer(n: int32): int32 { let x: int32 = inner(n)? e { ";
  const TAIL: string = " }; return x; }";

  // A switch every one of whose arms leaves. Exhaustive over a bool, so there
  // is no default to carry the answer.
  let allArms = checkSource(`${DECLS}${HANDLE}switch (e.len > 0) { case true: { return -1; } case false: { return -2; } }${TAIL}`);
  let test theory: Case = t.asserts("a switch whose every arm returns counts as leaving") {
    theory.isSuccessful = allArms.diagnostics.len == 0;
    theory.detail = `reported ${allArms.diagnostics.len}: ${firstDiagnostic(ref allArms)}`;
  }

  // ONE arm that falls out is enough to make the whole switch fall out. This is
  // the assertion an `||` where an `&&` belongs would fail.
  let oneArm = checkSource(`${DECLS}${HANDLE}switch (e.len > 0) { case true: { return -1; } case false: { let y: int32 = 1; } }${TAIL}`);
  let test theory: Case = t.asserts("one falling-through arm makes the switch fall through") {
    theory.isSuccessful = diagnosticsMention(ref oneArm, "must not fall through");
    theory.detail = `wanted a fall-through refusal, got: ${firstDiagnostic(ref oneArm)}`;
  }

  // The DEFAULT arm is an arm, so a switch that is nothing but one still
  // answers. A reader of the arm list that skipped the default would call this
  // "no arms" and refuse a block that plainly leaves.
  let defaultOnly = checkSource(`${DECLS}${HANDLE}switch (e.len) { default: { return -1; } }${TAIL}`);
  let test theory: Case = t.asserts("a default-only switch that returns counts as leaving") {
    theory.isSuccessful = defaultOnly.diagnostics.len == 0;
    theory.detail = `reported ${defaultOnly.diagnostics.len}: ${firstDiagnostic(ref defaultOnly)}`;
  }

  // An `else if` chain is a nested IF_STATEMENT in the else slot, so seeing
  // through one is the recursion working rather than a case of its own.
  let chain = checkSource(`${DECLS}${HANDLE}if (e.len > 2) { return -1; } else if (e.len > 1) { return -2; } else { return -3; }${TAIL}`);
  let test theory: Case = t.asserts("an else-if chain ending in an else counts as leaving") {
    theory.isSuccessful = chain.diagnostics.len == 0;
    theory.detail = `reported ${chain.diagnostics.len}: ${firstDiagnostic(ref chain)}`;
  }

  // The same chain with no final `else`. The tail falls out, and the recursion
  // has to carry that all the way back up.
  let openChain = checkSource(`${DECLS}${HANDLE}if (e.len > 2) { return -1; } else if (e.len > 1) { return -2; }${TAIL}`);
  let test theory: Case = t.asserts("an else-if chain with no final else falls through") {
    theory.isSuccessful = diagnosticsMention(ref openChain, "must not fall through");
    theory.detail = `wanted a fall-through refusal, got: ${firstDiagnostic(ref openChain)}`;
  }

  // An `else` that is PRESENT but falls out. Distinct from the missing-else
  // case above, and the one a test of "is there an else slot" would pass.
  let deadElse = checkSource(`${DECLS}${HANDLE}if (e.len > 0) { return -1; } else { let y: int32 = 1; }${TAIL}`);
  let test theory: Case = t.asserts("an else that falls through is not a leaving path") {
    theory.isSuccessful = diagnosticsMention(ref deadElse, "must not fall through");
    theory.detail = `wanted a fall-through refusal, got: ${firstDiagnostic(ref deadElse)}`;
  }

  // `break` is the third terminator, and the only one with no assertion of its
  // own - `return` and `continue` have theirs above.
  let breaks = checkSource(`${DECLS}function outer(n: int32): int32 { let total: int32 = 0; for (let i = 0; i < 3; i += 1) { let x: int32 = inner(i)? e { break; }; total = total + x; } return total; }`);
  let test theory: Case = t.asserts("`break` counts as leaving the handler block") {
    theory.isSuccessful = breaks.diagnostics.len == 0;
    theory.detail = `reported ${breaks.diagnostics.len}: ${firstDiagnostic(ref breaks)}`;
  }
}

// `?` yields the OPERAND's Ok payload, so it is an ordinary value of that type
// everywhere an expression may appear. These are the shapes a statement-level
// desugar in the parser would have missed.
suite function tryOpIsAnOrdinaryExpression(): void {
  let nested = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction twice(a: int32): int32 { return a * 2; }\nfunction outer(n: int32): R { return R.Ok { value: twice(inner(n)?) + inner(n)? }; }");
  let test theory: Case = t.asserts("`?` nests in a call argument and in a binary expression") {
    theory.isSuccessful = nested.diagnostics.len == 0;
    theory.detail = `reported ${nested.diagnostics.len}: ${firstDiagnostic(ref nested)}`;
  }

  // The result is the Ok PAYLOAD's type, not the fallible type - which is what
  // makes this a type error rather than something that quietly works.
  let wrongType = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): R { let x: string = inner(n)?; return R.Ok { value: 0 }; }");
  let test theory: Case = t.asserts("the unwrapped value is checked against its annotation") {
    theory.isSuccessful = wrongType.diagnostics.len > 0;
    theory.detail = "binding an unwrapped int32 to a string produced no diagnostic";
  }

  // `?` on a plain BINDING, not only on a call. The operand is an expression
  // like any other, and nothing about the lowering assumes a call.
  let onBinding = checkSource("variant R { Ok { value: int32 }, Err { error: int32 }, }\nfunction inner(n: int32): R { return R.Ok { value: n }; }\nfunction outer(n: int32): R { let r: R = inner(n); let x: int32 = r?; return R.Ok { value: x }; }");
  let test theory: Case = t.asserts("`?` applies to any expression, not only a call") {
    theory.isSuccessful = onBinding.diagnostics.len == 0;
    theory.detail = `reported ${onBinding.diagnostics.len}: ${firstDiagnostic(ref onBinding)}`;
  }
}

// ----- value enums -----------------------------------------------------------

// A value enum's cases are folded at pass C, so the CONSTANTS are checkable
// without producing a binary - which is the whole reason they are asserted here
// rather than only through a slice fixture. Every rule below was established by
// probing the JS reference, and the interesting ones are the counting rules: an
// implicit case counts on from whatever came before it, explicit or not.
suite function enumCasesFoldToConstants(): void {
  let prog = checkSource("enum Big<int64> { Zero 0, Big 1000, Eighteen 18, Auto, }");

  let test theory: Case = t.asserts("an enum with explicit and implicit cases checks clean") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `reported ${prog.diagnostics.len}: ${firstDiagnostic(ref prog)}`;
  }

  let test theory: Case = t.asserts("an explicit value is the case's value") {
    theory.isSuccessful = enumValueOf(ref prog, "Big", "Big") == 1000;
    theory.detail = `Big.Big folded to ${enumValueOf(ref prog, "Big", "Big")}, wanted 1000`;
  }

  // The counting rule, and the one that is easy to get wrong: an implicit case
  // is the PREVIOUS case's value plus one, not its position in the declaration.
  let test theory: Case = t.asserts("an implicit case counts on from the previous VALUE, not the ordinal") {
    theory.isSuccessful = enumValueOf(ref prog, "Big", "Auto") == 19;
    theory.detail = `Big.Auto folded to ${enumValueOf(ref prog, "Big", "Auto")}, wanted 19 (18 + 1)`;
  }

  let implicit = checkSource("enum Color { Red, Green, Blue }");
  let test theory: Case = t.asserts("with no explicit value at all, the cases count from 0") {
    theory.isSuccessful = enumValueOf(ref implicit, "Color", "Red") == 0
      && enumValueOf(ref implicit, "Color", "Blue") == 2;
    theory.detail = `Red=${enumValueOf(ref implicit, "Color", "Red")} Blue=${enumValueOf(ref implicit, "Color", "Blue")}`;
  }

  let negative = checkSource("enum N { A -3, B, C }");
  let test theory: Case = t.asserts("a negative value is allowed, and counting continues from it") {
    theory.isSuccessful = enumValueOf(ref negative, "N", "A") == -3
      && enumValueOf(ref negative, "N", "C") == -1;
    theory.detail = `A=${enumValueOf(ref negative, "N", "A")} C=${enumValueOf(ref negative, "N", "C")}`;
  }

  // A prior case by BARE name, and the bitwise operators over those. This is
  // the only place in the language where a bare case name resolves.
  let flags = checkSource("enum F { Sweet 1, Sour 2, Bitter 4, Both Sweet | Sour, Masked Both & Sour, Shifted Sweet << 3 }");
  let test theory: Case = t.asserts("a case value may name a PRIOR case and combine them bitwise") {
    theory.isSuccessful = flags.diagnostics.len == 0
      && enumValueOf(ref flags, "F", "Both") == 3
      && enumValueOf(ref flags, "F", "Masked") == 2
      && enumValueOf(ref flags, "F", "Shifted") == 8;
    theory.detail = `Both=${enumValueOf(ref flags, "F", "Both")} Masked=${enumValueOf(ref flags, "F", "Masked")} Shifted=${enumValueOf(ref flags, "F", "Shifted")}: ${firstDiagnostic(ref flags)}`;
  }

  // Deriving a value makes the enum OPEN, which is what a switch over it reads
  // to decide it can never be exhaustive.
  let test theory: Case = t.asserts("a derived case marks the enum open; a written one does not") {
    theory.isSuccessful = enumIsOpenNamed(ref flags, "F") && !enumIsOpenNamed(ref prog, "Big");
    theory.detail = `F open=${enumIsOpenNamed(ref flags, "F")}, Big open=${enumIsOpenNamed(ref prog, "Big")}`;
  }
}

// The refusals. Each is a form a reader arrives with from another language, so
// each has to say what is wrong rather than fail as a syntax error somewhere
// after it.
suite function enumDeclarationsRefuseWhatCannotBeConstant(): void {
  let forward = checkSource("enum C { Red Blue, Green, Blue 7 }");
  let test theory: Case = t.asserts("a FORWARD reference to a later case is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref forward, "does not name a prior case");
    theory.detail = `wanted a prior-case refusal, got: ${firstDiagnostic(ref forward)}`;
  }

  // Arithmetic could be folded; the reference refuses it, and two compilers
  // disagreeing about what a program MEANS is worse than a missing feature.
  let arith = checkSource("enum C { Red 3, Green Red + 2 }");
  let test theory: Case = t.asserts("arithmetic in a case value is refused, and names the allowed set") {
    theory.isSuccessful = diagnosticsMention(ref arith, "only | & ^ << >>");
    theory.detail = `wanted an operator refusal, got: ${firstDiagnostic(ref arith)}`;
  }

  // A payload is what makes something a VARIANT. `Red { r: int32 }` is a struct
  // literal to the parser, so the refusal has to come from the fold.
  let payload = checkSource("enum C { Red { r: int32 }, Green }");
  let test theory: Case = t.asserts("a payload on a case is refused as an unfoldable value") {
    theory.isSuccessful = diagnosticsMention(ref payload, "unsupported expression form in enum case value");
    theory.detail = `wanted a case-value refusal, got: ${firstDiagnostic(ref payload)}`;
  }

  let dup = checkSource("enum C { Red, Red, Blue }");
  let test theory: Case = t.asserts("two cases with the same NAME is a diagnostic") {
    theory.isSuccessful = diagnosticsMention(ref dup, "duplicate case name");
    theory.detail = `wanted a duplicate-name diagnostic, got: ${firstDiagnostic(ref dup)}`;
  }

  let empty = checkSource("enum C { }");
  let test theory: Case = t.asserts("an enum with no cases is refused") {
    theory.isSuccessful = diagnosticsMention(ref empty, "at least one case");
    theory.detail = `wanted an empty-enum refusal, got: ${firstDiagnostic(ref empty)}`;
  }

  // Truncating instead would make the case unreachable from its own switch,
  // which is a much harder failure to find than a refusal at the decl.
  let wide = checkSource("enum E { A 5000000000 }");
  let test theory: Case = t.asserts("a value too wide for the backing type is refused") {
    theory.isSuccessful = diagnosticsMention(ref wide, "does not fit in int32");
    theory.detail = `wanted a range refusal, got: ${firstDiagnostic(ref wide)}`;
  }

  let unsignedNeg = checkSource("enum E<uint8> { A -1 }");
  let test theory: Case = t.asserts("a negative value in an unsigned enum is refused") {
    theory.isSuccessful = diagnosticsMention(ref unsignedNeg, "does not fit in uint8");
    theory.detail = `wanted a range refusal, got: ${firstDiagnostic(ref unsignedNeg)}`;
  }

  let boolBacked = checkSource("enum B<bool> { No, Yes }");
  let test theory: Case = t.asserts("a backing type that is not an int width or string is refused") {
    theory.isSuccessful = diagnosticsMention(ref boolBacked, "int8..int64, uint8..uint64, or string");
    theory.detail = `wanted a backing-type refusal, got: ${firstDiagnostic(ref boolBacked)}`;
  }

  // A string-backed case has nothing to count on from, so an implicit one would
  // have to invent a string.
  let missingStr = checkSource("enum D<string> { Asc \"A\", Desc }");
  let test theory: Case = t.asserts("a string-backed case with no value is refused") {
    theory.isSuccessful = diagnosticsMention(ref missingStr, "needs an explicit string value");
    theory.detail = `wanted a missing-value refusal, got: ${firstDiagnostic(ref missingStr)}`;
  }

  let mixed = checkSource("enum D { Asc \"A\" }");
  let test theory: Case = t.asserts("a string value in an integer-backed enum is refused") {
    theory.isSuccessful = diagnosticsMention(ref mixed, "string literal in integer-backed enum");
    theory.detail = `wanted a mixed-value refusal, got: ${firstDiagnostic(ref mixed)}`;
  }
}

// An int literal has to FIT the type it was pinned to.
//
// The enum-case rule above is the same question at a declaration; this is it at
// every other slot, and it was missing entirely: `let a: uint8 = 256` compiled,
// emitted VALID IR, and printed 0. Nothing in the corpus could catch that -
// the program builds, links and runs, it just answers wrongly - which is why
// this is a unit test rather than a fixture.
//
// The boundaries are the point of the suite. Two's complement is asymmetric, so
// int8 takes -128 and refuses 128, and the sign lives on a DIFFERENT NODE from
// the magnitude in this parser - see typecheck/int_range.yoop.
suite function intLiteralsHaveToFitTheTypeTheyPinTo(): void {
  const MAIN: string = "function main(): int32 { ";

  let over = checkSource(`${MAIN}let a: uint8 = 256; return 0; }`);
  let test theory: Case = t.asserts("a literal past an unsigned width is refused") {
    theory.isSuccessful = diagnosticsMention(ref over, "256 does not fit in uint8");
    theory.detail = `wanted a range refusal, got: ${firstDiagnostic(ref over)}`;
  }

  let atMax = checkSource(`${MAIN}let a: uint8 = 255; return int32(a); }`);
  let test theory: Case = t.asserts("the largest value that fits is accepted") {
    theory.isSuccessful = atMax.diagnostics.len == 0;
    theory.detail = `uint8 = 255 reported: ${firstDiagnostic(ref atMax)}`;
  }

  // The asymmetry. Getting this backwards refuses a correct program at one end
  // or accepts a truncating one at the other, so both directions are asked.
  let negMin = checkSource(`${MAIN}let a: int8 = -128; return int32(a); }`);
  let test theory: Case = t.asserts("int8 accepts -128, which only the negative range reaches") {
    theory.isSuccessful = negMin.diagnostics.len == 0;
    theory.detail = `int8 = -128 reported: ${firstDiagnostic(ref negMin)}`;
  }

  let posOver = checkSource(`${MAIN}let a: int8 = 128; return 0; }`);
  let test theory: Case = t.asserts("int8 refuses 128, which it does not") {
    theory.isSuccessful = diagnosticsMention(ref posOver, "128 does not fit in int8");
    theory.detail = `wanted a range refusal, got: ${firstDiagnostic(ref posOver)}`;
  }

  // Not a value that wraps to 65535 - it is a mistake about the type.
  let unsignedNeg = checkSource(`${MAIN}let a: uint16 = -1; return 0; }`);
  let test theory: Case = t.asserts("nothing negative fits an unsigned slot") {
    theory.isSuccessful = diagnosticsMention(ref unsignedNeg, "-1 does not fit in uint16");
    theory.detail = `wanted a range refusal, got: ${firstDiagnostic(ref unsignedNeg)}`;
  }

  // The widest slots have no headroom above them to test with, so the boundary
  // values themselves are what say the 64-bit path does not overflow its own
  // arithmetic.
  let uMax = checkSource(`${MAIN}let a: uint64 = 18446744073709551615; return 0; }`);
  let test theory: Case = t.asserts("uint64 accepts its maximum") {
    theory.isSuccessful = uMax.diagnostics.len == 0;
    theory.detail = `uint64 max reported: ${firstDiagnostic(ref uMax)}`;
  }

  let iMin = checkSource(`${MAIN}let a: int64 = -9223372036854775808; return 0; }`);
  let test theory: Case = t.asserts("int64 accepts its minimum") {
    theory.isSuccessful = iMin.diagnostics.len == 0;
    theory.detail = `int64 min reported: ${firstDiagnostic(ref iMin)}`;
  }

  // The sign flag is set for exactly one step, so a minus in front of an
  // EXPRESSION must not mark the literals inside it. If it leaked, `-(a + 1)`
  // would range-check the 1 as if it were negative.
  let notALiteral = checkSource(`${MAIN}let a: int32 = 1; let b: int32 = -(a + 1); return b; }`);
  let test theory: Case = t.asserts("a minus over an expression does not mark the literals inside it") {
    theory.isSuccessful = notALiteral.diagnostics.len == 0;
    theory.detail = `-(a + 1) reported: ${firstDiagnostic(ref notALiteral)}`;
  }

  // An UNPINNED literal defaults to int32 like any other, and refusing it
  // against a width nobody wrote would refuse programs on a type the author
  // never named.
  let unpinned = checkSource(`${MAIN}let a = 200; return 0; }`);
  let test theory: Case = t.asserts("a literal with no expectation is not range-checked") {
    theory.isSuccessful = unpinned.diagnostics.len == 0;
    theory.detail = `an unpinned 200 reported: ${firstDiagnostic(ref unpinned)}`;
  }
}

// The operand-class table in typecheck/operands.yoop, both ways round: every
// combination that is legal stays legal, and every one that is not is refused.
//
// The refusals are the half that did not exist - two operands agreeing on a
// TypeId was the whole test, so `a + b` on two strings reached codegen and
// emitted `add ptr %t1, %t2`, which clang will not assemble. The ACCEPTANCES
// are asserted just as hard, because a table that is one row too strict breaks
// correct programs and nothing else here would notice.
suite function binaryOperatorsCheckTheirOperandCLASSNotJustAgreement(): void {
  const DECLS: string =
    "variant Sh { Circle { r: int32 }, Empty }\nenum EI { A 1, B 2 }\ntype P { x: int32 }\n";

  // STRINGS keep nothing, and `==` is the row that surprises people: a string
  // is a borrowed view, so comparing two of them compares ADDRESSES. That is
  // why std has text.equals and why examples/tour/strings.yoop says so.
  let strAdd = checkSource("function main(): int32 { let a: string = \"a\"; let b: string = \"b\"; let c: string = a + b; return 0; }");
  let test theory: Case = t.asserts("adding two strings is refused") {
    theory.isSuccessful = diagnosticsMention(ref strAdd, "cannot be applied to string and string");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref strAdd)}`;
  }

  let strEq = checkSource("function main(): int32 { let a: string = \"a\"; let b: string = \"b\"; if (a == b) { return 1; } return 0; }");
  let test theory: Case = t.asserts("comparing two strings with == is refused - it would compare pointers") {
    theory.isSuccessful = diagnosticsMention(ref strEq, "cannot be applied to string and string");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref strEq)}`;
  }

  // STRUCTS and ARRAYS keep nothing either, equality included.
  let structAdd = checkSource(`${DECLS}function main(): int32 { let a: P = { x: 1 }; let b: P = { x: 2 }; let c: P = a + b; return 0; }`);
  let test theory: Case = t.asserts("adding two structs is refused") {
    theory.isSuccessful = diagnosticsMention(ref structAdd, "cannot be applied to P and P");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref structAdd)}`;
  }

  let structEq = checkSource(`${DECLS}function main(): int32 { let a: P = { x: 1 }; let b: P = { x: 2 }; if (a == b) { return 1; } return 0; }`);
  let test theory: Case = t.asserts("comparing two structs is refused") {
    theory.isSuccessful = diagnosticsMention(ref structEq, "cannot be applied to P and P");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref structEq)}`;
  }

  let arrAdd = checkSource("function main(): int32 { let a: int32[] = [1]; let b: int32[] = [2]; let c: int32[] = a + b; return 0; }");
  let test theory: Case = t.asserts("adding two arrays is refused") {
    theory.isSuccessful = diagnosticsMention(ref arrAdd, "cannot be applied to int32[] and int32[]");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref arrAdd)}`;
  }

  // BOOLS keep equality and the logical pair, and nothing else. Both halves are
  // asked: refusing `true && false` would break every condition in the tree.
  let boolAdd = checkSource("function main(): int32 { let a: bool = true; let b: bool = false; let c: bool = a + b; return 0; }");
  let test theory: Case = t.asserts("adding two bools is refused") {
    theory.isSuccessful = diagnosticsMention(ref boolAdd, "cannot be applied to bool and bool");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref boolAdd)}`;
  }

  let boolLt = checkSource("function main(): int32 { let a: bool = true; let b: bool = false; if (a < b) { return 1; } return 0; }");
  let test theory: Case = t.asserts("ordering two bools is refused - there is no ordering on a truth value") {
    theory.isSuccessful = diagnosticsMention(ref boolLt, "cannot be applied to bool and bool");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref boolLt)}`;
  }

  let boolOk = checkSource("function main(): int32 { let a: bool = true; let b: bool = false; if ((a == b) || (a && b) || (a != b)) { return 1; } return 0; }");
  let test theory: Case = t.asserts("bools keep ==, != and the logical pair") {
    theory.isSuccessful = boolOk.diagnostics.len == 0;
    theory.detail = `reported ${boolOk.diagnostics.len}: ${firstDiagnostic(ref boolOk)}`;
  }

  // VARIANTS keep equality - it compares TAGS - and lose ordering.
  let varEq = checkSource(`${DECLS}function main(): int32 { let a: Sh = Sh.Empty; let b: Sh = Sh.Circle { r: 1 }; if (a == b) { return 1; } return 0; }`);
  let test theory: Case = t.asserts("two variants compare for equality, which is a tag comparison") {
    theory.isSuccessful = varEq.diagnostics.len == 0;
    theory.detail = `reported ${varEq.diagnostics.len}: ${firstDiagnostic(ref varEq)}`;
  }

  let varLt = checkSource(`${DECLS}function main(): int32 { let a: Sh = Sh.Empty; let b: Sh = Sh.Circle { r: 1 }; if (a < b) { return 1; } return 0; }`);
  let test theory: Case = t.asserts("ordering two variants is refused") {
    theory.isSuccessful = diagnosticsMention(ref varLt, "cannot be applied to Sh and Sh");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref varLt)}`;
  }

  // A `ref T` operand is a POINTER at run time, so `+` on two of them is the
  // same `add ptr` a string is. The borrow OPENS wherever a plain T is wanted,
  // which is why this needs a position that wants neither.
  let refAdd = checkSource("type H { r: ref int32 }\nfunction main(): int32 { let n: int32 = 5; let h: H = { r: ref n }; let c = h.r + h.r; return 0; }");
  let test theory: Case = t.asserts("adding two borrows is refused") {
    theory.isSuccessful = diagnosticsMention(ref refAdd, "cannot be applied to ref int32 and ref int32");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref refAdd)}`;
  }

  // The LEGAL rows, each asserted whole. An integer keeps everything but the
  // logical pair; a float loses the bitwise family and keeps the rest.
  let intAll = checkSource("function main(): int32 { let a: int32 = 6; let b: int32 = 3; let c: int32 = a + b - a * b / b % b; let d: int32 = (a & b) | (a ^ b) | (a << b) | (a >> b); if (a == b || a != b || a < b || a > b || a <= b || a >= b) { return c + d; } return 0; }");
  let test theory: Case = t.asserts("an integer keeps arithmetic, comparison and the bitwise family") {
    theory.isSuccessful = intAll.diagnostics.len == 0;
    theory.detail = `reported ${intAll.diagnostics.len}: ${firstDiagnostic(ref intAll)}`;
  }

  let intLogical = checkSource("function main(): int32 { let a: int32 = 1; let b: int32 = 2; if (a && b) { return 1; } return 0; }");
  let test theory: Case = t.asserts("&& on two integers is refused - the logical pair is bools only") {
    theory.isSuccessful = diagnosticsMention(ref intLogical, "cannot be applied to int32 and int32");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref intLogical)}`;
  }

  let floatAll = checkSource("function main(): int32 { let a: float64 = 6.0; let b: float64 = 3.0; let c: float64 = a + b - a * b / b % b; if (a == b || a != b || a < b || a > b || a <= b || a >= b) { return int32(c); } return 0; }");
  let test theory: Case = t.asserts("a float keeps arithmetic and comparison") {
    theory.isSuccessful = floatAll.diagnostics.len == 0;
    theory.detail = `reported ${floatAll.diagnostics.len}: ${firstDiagnostic(ref floatAll)}`;
  }

  // An int-backed value ENUM keeps equality, ordering and the bitwise family,
  // and that row is answered by typecheck/enum_use.yoop through this one - so
  // it is asked here too, to say the dispatch still reaches it.
  let enumOk = checkSource(`${DECLS}function main(): int32 { let a: EI = EI.A; let b: EI = EI.B; let c: EI = a | b; if (a < b && a != b) { return int32(c); } return 0; }`);
  let test theory: Case = t.asserts("an int-backed enum keeps equality, ordering and the bitwise family") {
    theory.isSuccessful = enumOk.diagnostics.len == 0;
    theory.detail = `reported ${enumOk.diagnostics.len}: ${firstDiagnostic(ref enumOk)}`;
  }

  // POINTERS answer identity and nothing else. Arithmetic on one is a separate
  // question with separate operands (typecheck/unsafe_ptr_ops.yoop), so the
  // rows here are `==` legal and `<` not.
  let ptrEq = checkSource("import.unsafe;\nfunction main(): int32 { let x: int32 = 1; let p: unsafe_ptr<int32> = &x; if (p == null || p != null) { return 1; } return 0; }");
  let test theory: Case = t.asserts("pointers compare for identity, against each other and against null") {
    theory.isSuccessful = ptrEq.diagnostics.len == 0;
    theory.detail = `reported ${ptrEq.diagnostics.len}: ${firstDiagnostic(ref ptrEq)}`;
  }

  let ptrLt = checkSource("import.unsafe;\nfunction main(): int32 { let x: int32 = 1; let y: int32 = 2; let p: unsafe_ptr<int32> = &x; let q: unsafe_ptr<int32> = &y; if (p < q) { return 1; } return 0; }");
  let test theory: Case = t.asserts("ordering two pointers is refused") {
    theory.isSuccessful = diagnosticsMention(ref ptrLt, "cannot be applied to unsafe_ptr<int32> and unsafe_ptr<int32>");
    theory.detail = `wanted an operand-class refusal, got: ${firstDiagnostic(ref ptrLt)}`;
  }

  let ptrArith = checkSource("import.unsafe;\nfunction main(): int32 { let xs: int32[] = [1, 2, 3]; let p: unsafe_ptr<int32> = xs.ptr; let q: unsafe_ptr<int32> = p + 2; let n: int64 = q - p; return int32(n); }");
  let test theory: Case = t.asserts("pointer arithmetic is untouched - its operands are not meant to agree") {
    theory.isSuccessful = ptrArith.diagnostics.len == 0;
    theory.detail = `reported ${ptrArith.diagnostics.len}: ${firstDiagnostic(ref ptrArith)}`;
  }

  // ONE diagnostic per mistake. Both operands here are already errors, and an
  // error has no class, so the table has to wave it through: reporting on it
  // would turn two unknown names into four diagnostics.
  let cascade = checkSource("function main(): int32 { return nope + nada; }");
  let test theory: Case = t.asserts("an already-failed operand does not collect a second diagnostic") {
    theory.isSuccessful = cascade.diagnostics.len == 2 &&
      !diagnosticsMention(ref cascade, "cannot be applied to");
    theory.detail = `wanted the two unknown names and nothing else, got ${cascade.diagnostics.len}: ${firstDiagnostic(ref cascade)}`;
  }
}

// A type that contains ITSELF by value has no size, and the refusal has to sit
// beside the four shapes that DO break the cycle - a `ref`, an array, a pointer
// and a generic holding one - because a self-referential type is the whole
// reason anyone writes a tree or a list. Refusing one of those would be worse
// than the bug this closes: LLVM at least says "identified structure type is
// recursive", while a wrongly refused `ref Node` says a correct program is
// wrong. See typecheck/recursion.yoop.
suite function aTypeCannotContainItselfByValue(): void {
  const MAIN: string = "function main(): int32 { return 0; }";

  let direct = checkSource(`type Node { next: Node }\n${MAIN}`);
  let test theory: Case = t.asserts("a field of the type being declared is refused") {
    theory.isSuccessful = diagnosticsMention(ref direct, "field \"next\" of \"Node\" reaches \"Node\" again by value");
    theory.detail = `wanted a recursion refusal, got: ${firstDiagnostic(ref direct)}`;
  }

  // The cycle spread over two declarations is the same type. Both ends report,
  // because a mutual cycle can be broken at either one.
  let mutual = checkSource(`type A { b: B }\ntype B { a: A }\n${MAIN}`);
  let test theory: Case = t.asserts("a mutual cycle is refused at both of its ends") {
    theory.isSuccessful = diagnosticsMention(ref mutual, "field \"b\" of \"A\" reaches \"A\"") &&
      diagnosticsMention(ref mutual, "field \"a\" of \"B\" reaches \"B\"");
    theory.detail = `wanted both ends refused, got ${mutual.diagnostics.len}: ${firstDiagnostic(ref mutual)}`;
  }

  // Length is not the test - closing is. A three-hop cycle has no member that
  // names itself, so a check that only compared a field against its own holder
  // would miss every one of these.
  let three = checkSource(`type A { b: B }\ntype B { c: C }\ntype C { a: A }\n${MAIN}`);
  let test theory: Case = t.asserts("a three-hop cycle is refused") {
    theory.isSuccessful = diagnosticsMention(ref three, "field \"a\" of \"C\" reaches \"C\" again by value");
    theory.detail = `wanted a recursion refusal, got: ${firstDiagnostic(ref three)}`;
  }

  // A variant case's payload is stored INLINE, so a case carrying the variant
  // is the same infinity a struct field is.
  let asVariant = checkSource(`variant Tree { Node { left: Tree, right: Tree }, Leaf }\n${MAIN}`);
  let test theory: Case = t.asserts("a variant case carrying its own variant by value is refused") {
    theory.isSuccessful = diagnosticsMention(ref asVariant, "field \"left\" of \"Tree\" reaches \"Tree\" again by value");
    theory.detail = `wanted a recursion refusal, got: ${firstDiagnostic(ref asVariant)}`;
  }

  // A GENERIC in between hides nothing: `Box<Node>` holds a `Node` by value, so
  // the cycle is one hop longer and just as infinite. This is also the case
  // that says the sweep runs after instances are materialized - before that,
  // `Box<Node>` is an empty shell and the walk finds nothing.
  let throughGeneric = checkSource(`type Box<T> { v: T }\ntype Node { b: Box<Node> }\n${MAIN}`);
  let test theory: Case = t.asserts("a cycle running through a generic instance is refused") {
    theory.isSuccessful = diagnosticsMention(ref throughGeneric, "field \"b\" of \"Node\" reaches \"Node\" again by value");
    theory.detail = `wanted a recursion refusal, got: ${firstDiagnostic(ref throughGeneric)}`;
  }

  // THE LEGAL NEIGHBOURS. Each of these is a pointer somewhere, so the type has
  // a finite size and the program is a program.
  let byRef = checkSource(`type Node { v: int32, next: ref Node }\nfunction head(ref n: Node): int32 { return n.v; }\n${MAIN}`);
  let test theory: Case = t.asserts("a `ref` to the same type is legal - a borrow is one address") {
    theory.isSuccessful = byRef.diagnostics.len == 0;
    theory.detail = `ref Node reported ${byRef.diagnostics.len}: ${firstDiagnostic(ref byRef)}`;
  }

  let byArray = checkSource(`type Node { v: int32, kids: Node[] }\n${MAIN}`);
  let test theory: Case = t.asserts("an array of the same type is legal - the elements are behind a pointer") {
    theory.isSuccessful = byArray.diagnostics.len == 0;
    theory.detail = `Node[] reported ${byArray.diagnostics.len}: ${firstDiagnostic(ref byArray)}`;
  }

  let byPointer = checkSource(`import.unsafe;\ntype Node { v: int32, next: unsafe_ptr<Node> }\n${MAIN}`);
  let test theory: Case = t.asserts("an unsafe_ptr to the same type is legal") {
    theory.isSuccessful = byPointer.diagnostics.len == 0;
    theory.detail = `unsafe_ptr<Node> reported ${byPointer.diagnostics.len}: ${firstDiagnostic(ref byPointer)}`;
  }

  // The `Vec<Node>` shape, with a locally declared holder standing in for Vec:
  // the generic stores its contents in an ARRAY, so the storage is behind a
  // pointer one level down and the cycle never closes. Vec is exactly this.
  let byGenericArray = checkSource(`type Holder<T> { items: T[] }\ntype Node { v: int32, kids: Holder<Node> }\n${MAIN}`);
  let test theory: Case = t.asserts("a generic holding the type in an ARRAY is legal - this is the Vec<Node> shape") {
    theory.isSuccessful = byGenericArray.diagnostics.len == 0;
    theory.detail = `Holder<Node> reported ${byGenericArray.diagnostics.len}: ${firstDiagnostic(ref byGenericArray)}`;
  }

  let variantByRef = checkSource(`variant Tree { Node { left: ref Tree }, Leaf }\n${MAIN}`);
  let test theory: Case = t.asserts("a variant case holding its own variant behind a `ref` is legal") {
    theory.isSuccessful = variantByRef.diagnostics.len == 0;
    theory.detail = `ref Tree reported ${variantByRef.diagnostics.len}: ${firstDiagnostic(ref variantByRef)}`;
  }

  // A `ref` ANYWHERE on the cycle breaks it. Only one of the three hops here is
  // a borrow, and that is enough - the check is about storage, not about how
  // many names are involved.
  let refBreaksALongCycle = checkSource(`type A { b: B }\ntype B { c: C }\ntype C { a: ref A }\n${MAIN}`);
  let test theory: Case = t.asserts("one `ref` anywhere on a long cycle breaks it") {
    theory.isSuccessful = refBreaksALongCycle.diagnostics.len == 0;
    theory.detail = `reported ${refBreaksALongCycle.diagnostics.len}: ${firstDiagnostic(ref refBreaksALongCycle)}`;
  }

  // Two types that MENTION each other in one direction only. Nothing here is a
  // cycle, and a check that stopped at "these two names appear in each other's
  // neighbourhood" would refuse the most ordinary composition there is.
  let oneDirection = checkSource(`type Inner { v: int32 }\ntype Outer { a: Inner, b: Inner }\ntype Third { o: Outer, i: Inner }\n${MAIN}`);
  let test theory: Case = t.asserts("plain composition, including the same type twice, stays legal") {
    theory.isSuccessful = oneDirection.diagnostics.len == 0;
    theory.detail = `reported ${oneDirection.diagnostics.len}: ${firstDiagnostic(ref oneDirection)}`;
  }

  // A forward reference is not a cycle. This is the shape that made the
  // reference's own walk crash before it learned about shells: `A` is filled
  // while `B` is still empty.
  let forward = checkSource(`type A { b: B }\ntype B { v: int32 }\n${MAIN}`);
  let test theory: Case = t.asserts("a forward reference is not a cycle") {
    theory.isSuccessful = forward.diagnostics.len == 0;
    theory.detail = `reported ${forward.diagnostics.len}: ${firstDiagnostic(ref forward)}`;
  }
}

// A value enum is a NOMINAL alias, so it neither accepts nor produces its own
// underlying type without a cast, and it keeps only some of that type's
// operators. Both halves matter: a silently-assignable enum would let an
// arbitrary integer name a case.
suite function enumsAreNominalAliasesNotIntegers(): void {
  const decl = "enum Color { Red, Green, Blue }\n";

  let ok = checkSource(`${decl}function f(): int32 { let c: Color = Color.Green; return int32(c); }`);
  let test theory: Case = t.asserts("a case is a value of the enum, and casts OUT to its width") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `reported ${ok.diagnostics.len}: ${firstDiagnostic(ref ok)}`;
  }

  let fromInt = checkSource(`${decl}function f(): int32 { let c: Color = 1; return 0; }`);
  let test theory: Case = t.asserts("an untyped int does not pin to an enum") {
    theory.isSuccessful = diagnosticsMention(ref fromInt, "cannot assign untyped int to enum Color");
    theory.detail = `wanted an assignability refusal, got: ${firstDiagnostic(ref fromInt)}`;
  }

  let mixedCompare = checkSource(`${decl}function f(i: int32): bool { let c: Color = Color.Red; return c == i; }`);
  let test theory: Case = t.asserts("an enum does not compare against its underlying type") {
    theory.isSuccessful = diagnosticsMention(ref mixedCompare, "cannot be applied to enum Color and int32");
    theory.detail = `wanted a mixed-comparison refusal, got: ${firstDiagnostic(ref mixedCompare)}`;
  }

  let bare = checkSource(`${decl}function f(): int32 { let c: Color = Red; return 0; }`);
  let test theory: Case = t.asserts("a case name is NOT in scope bare - it is reached through the enum") {
    theory.isSuccessful = diagnosticsMention(ref bare, "unknown name");
    theory.detail = `wanted an unknown-name diagnostic, got: ${firstDiagnostic(ref bare)}`;
  }

  let missing = checkSource(`${decl}function f(): int32 { let c: Color = Color.Purple; return 0; }`);
  let test theory: Case = t.asserts("naming a case that does not exist is refused") {
    theory.isSuccessful = diagnosticsMention(ref missing, "has no case \"Purple\"");
    theory.detail = `wanted a missing-case diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }

  // Adding two enums produces something that names no case, so the arithmetic
  // operators are gone even though the representation could carry them.
  let arith = checkSource(`${decl}function f(): int32 { let c: Color = Color.Red + Color.Green; return 0; }`);
  let test theory: Case = t.asserts("arithmetic on enums is refused") {
    theory.isSuccessful = diagnosticsMention(ref arith, "cannot be applied to enum Color and enum Color");
    theory.detail = `wanted an operator refusal, got: ${firstDiagnostic(ref arith)}`;
  }

  let bitwise = checkSource("enum F { A 1, B 2 }\nfunction f(): bool { let x: F = F.A | F.B; return x > F.A; }");
  let test theory: Case = t.asserts("bitwise and ordering survive on an INT-backed enum") {
    theory.isSuccessful = bitwise.diagnostics.len == 0;
    theory.detail = `reported ${bitwise.diagnostics.len}: ${firstDiagnostic(ref bitwise)}`;
  }

  // A string-backed enum keeps equality and loses everything else - there is no
  // ordering on the values it aliases.
  let strEq = checkSource("enum D<string> { Asc \"A\", Desc \"D\" }\nfunction f(): bool { let d: D = D.Asc; return d != D.Desc; }");
  let test theory: Case = t.asserts("a string-backed enum still compares for equality") {
    theory.isSuccessful = strEq.diagnostics.len == 0;
    theory.detail = `reported ${strEq.diagnostics.len}: ${firstDiagnostic(ref strEq)}`;
  }

  let strOrder = checkSource("enum D<string> { Asc \"A\", Desc \"D\" }\nfunction f(): bool { return D.Asc < D.Desc; }");
  let test theory: Case = t.asserts("but not for ordering") {
    theory.isSuccessful = diagnosticsMention(ref strOrder, "cannot be applied to enum D and enum D");
    theory.detail = `wanted an ordering refusal, got: ${firstDiagnostic(ref strOrder)}`;
  }

  let strCast = checkSource("enum D<string> { Asc \"A\" }\nfunction f(): string { return string(D.Asc); }");
  let test theory: Case = t.asserts("a string-backed enum does not cast to string") {
    theory.isSuccessful = diagnosticsMention(ref strCast, "only numeric primitive casts");
    theory.detail = `wanted a cast refusal, got: ${firstDiagnostic(ref strCast)}`;
  }

  // An INT-backed enum indexes an array, which is what a name table keyed by a
  // kind wants. A string-backed one does not.
  let indexed = checkSource(`${decl}function f(): string { let names: string[] = ["r", "g", "b"]; return names[Color.Blue]; }`);
  let test theory: Case = t.asserts("an int-backed enum is a valid array index") {
    theory.isSuccessful = indexed.diagnostics.len == 0;
    theory.detail = `reported ${indexed.diagnostics.len}: ${firstDiagnostic(ref indexed)}`;
  }

  let strIndex = checkSource("enum D<string> { Asc \"A\" }\nfunction f(): string { let names: string[] = [\"r\"]; return names[D.Asc]; }");
  let test theory: Case = t.asserts("a string-backed one is not") {
    theory.isSuccessful = diagnosticsMention(ref strIndex, "array index must be an integer");
    theory.detail = `wanted an index refusal, got: ${firstDiagnostic(ref strIndex)}`;
  }

  let crossAssign = checkSource("enum A { X }\nenum B { P }\nfunction f(): int32 { let a: A = B.P; return 0; }");
  let test theory: Case = t.asserts("two enums are two types, however alike their values") {
    theory.isSuccessful = crossAssign.diagnostics.len > 0;
    theory.detail = "assigning a B case to an A binding produced no diagnostic";
  }
}

// A switch over an enum is exhaustive-checked like a variant, with two rules
// that are NOT the variant's - both established by probing the reference.
suite function enumSwitchesAreExhaustiveButMayStillDefault(): void {
  const decl = "enum Color { Red, Green, Blue }\n";

  let missing = checkSource(`${decl}function f(c: Color): int32 { switch (c) { case Color.Red: { return 1; } case Color.Green: { return 2; } } return 0; }`);
  let test theory: Case = t.asserts("a switch missing a case is refused, and NAMES the case") {
    theory.isSuccessful = diagnosticsMention(ref missing, "does not cover \"Blue\"");
    theory.detail = `wanted an exhaustiveness diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }

  // The variant rule is "exhaustive or defaulted, never both". An enum's values
  // are integers, so one naming no case is representable and a default is never
  // provably dead - which makes both together legitimate here.
  let both = checkSource(`${decl}function f(c: Color): int32 { switch (c) { case Color.Red: { return 1; } case Color.Green: { return 2; } case Color.Blue: { return 3; } default: { return 9; } } }`);
  let test theory: Case = t.asserts("a default ALONGSIDE every case is allowed, unlike on a variant") {
    theory.isSuccessful = both.diagnostics.len == 0;
    theory.detail = `reported ${both.diagnostics.len}: ${firstDiagnostic(ref both)}`;
  }

  let multi = checkSource(`${decl}function f(c: Color): int32 { switch (c) { case Color.Red, Color.Green: { return 1; } default: { return 3; } } }`);
  let test theory: Case = t.asserts("several cases may share one arm") {
    theory.isSuccessful = multi.diagnostics.len == 0;
    theory.detail = `reported ${multi.diagnostics.len}: ${firstDiagnostic(ref multi)}`;
  }

  let open = checkSource("enum F { A 1, B 2, AB A | B }\nfunction f(x: F): int32 { switch (x) { case F.A: { return 1; } case F.B: { return 2; } case F.AB: { return 3; } } }");
  let test theory: Case = t.asserts("an OPEN enum needs a default even with every case covered") {
    theory.isSuccessful = diagnosticsMention(ref open, "switch over open enum F requires a default");
    theory.detail = `wanted an open-enum diagnostic, got: ${firstDiagnostic(ref open)}`;
  }

  // A DELIBERATE divergence: the reference emits a jump table with the value
  // twice and lets clang refuse it, naming no source line.
  let dupValue = checkSource("enum C { Red 1, Crimson 1, Blue 2 }\nfunction f(c: C): int32 { switch (c) { case C.Red: { return 1; } case C.Crimson: { return 2; } case C.Blue: { return 3; } } }");
  let test theory: Case = t.asserts("matching two cases that share a VALUE is refused") {
    theory.isSuccessful = diagnosticsMention(ref dupValue, "same value as a case already matched");
    theory.detail = `wanted a duplicate-value diagnostic, got: ${firstDiagnostic(ref dupValue)}`;
  }

  // Two cases sharing a value is legal at the DECL - only matching both in one
  // switch is not.
  let sharedDecl = checkSource("enum C { Red 1, Crimson 1, Blue 2 }\nfunction f(c: C): bool { return c == C.Crimson; }");
  let test theory: Case = t.asserts("but declaring two cases with one value is fine") {
    theory.isSuccessful = sharedDecl.diagnostics.len == 0;
    theory.detail = `reported ${sharedDecl.diagnostics.len}: ${firstDiagnostic(ref sharedDecl)}`;
  }

  let wrongEnum = checkSource("enum A { X, Y }\nenum B { P, Q }\nfunction f(a: A): int32 { switch (a) { case B.P: { return 1; } default: { return 0; } } }");
  let test theory: Case = t.asserts("a pattern from another enum is refused") {
    theory.isSuccessful = diagnosticsMention(ref wrongEnum, "but the pattern matches enum B");
    theory.detail = `wanted a wrong-enum diagnostic, got: ${firstDiagnostic(ref wrongEnum)}`;
  }

  let literalPattern = checkSource(`${decl}function f(c: Color): int32 { switch (c) { case 1: { return 1; } default: { return 0; } } }`);
  let test theory: Case = t.asserts("an integer literal is not a pattern for an enum") {
    theory.isSuccessful = diagnosticsMention(ref literalPattern, "must be enum cases, not literals");
    theory.detail = `wanted a pattern-kind diagnostic, got: ${firstDiagnostic(ref literalPattern)}`;
  }

  // There is no jump table over pointers. Refused BY NAME and with exactly ONE
  // diagnostic: routing the arms to the integer checker afterwards would add
  // "must be literals" to every one of them.
  let strSwitch = checkSource("enum D<string> { Asc \"A\", Desc \"D\" }\nfunction f(d: D): int32 { switch (d) { case D.Asc: { return 1; } case D.Desc: { return 2; } } }");
  let test theory: Case = t.asserts("a switch over a string-backed enum is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref strSwitch, "there is no jump table to build");
    theory.detail = `wanted a string-switch refusal, got: ${firstDiagnostic(ref strSwitch)}`;
  }

  let test theory: Case = t.asserts("and it produces exactly one diagnostic, not one per arm") {
    theory.isSuccessful = strSwitch.diagnostics.len == 1;
    theory.detail = `reported ${strSwitch.diagnostics.len} diagnostic(s) for one refusal`;
  }
}

// An enum takes methods exactly as a struct does, which is what makes
// `${kind}` render through `toString`. Nothing below pass C knows an enum is
// involved: a method is an ordinary function with a `ref self` by then.
suite function enumsTakeMethodsThroughTraits(): void {
  const src = "trait Display { function toString(ref self): string; }\nenum Color implements Display {\n  Red, Green,\n  function toString(ref self): string { switch (self) { case Color.Red: { return \"R\"; } case Color.Green: { return \"G\"; } } }\n}\n";

  let prog = checkSource(`${src}function f(): string { let c: Color = Color.Red; return \`${"$"}{c}\`; }`);
  let test theory: Case = t.asserts("an enum with a trait method checks clean, and switches on self") {
    theory.isSuccessful = prog.diagnostics.len == 0;
    theory.detail = `reported ${prog.diagnostics.len}: ${firstDiagnostic(ref prog)}`;
  }

  // No inherent methods, here as anywhere else.
  let inherent = checkSource("enum Color { Red, function bump(ref self): int32 { return 1; } }");
  let test theory: Case = t.asserts("a method no implemented trait requires is refused") {
    theory.isSuccessful = diagnosticsMention(ref inherent, "no implemented trait requires it");
    theory.detail = `wanted an inherent-method refusal, got: ${firstDiagnostic(ref inherent)}`;
  }

  let unsatisfied = checkSource("trait Display { function toString(ref self): string; }\nenum Color implements Display { Red, Green }");
  let test theory: Case = t.asserts("an unsatisfied implements clause on an enum is refused") {
    theory.isSuccessful = diagnosticsMention(ref unsatisfied, "has no \"toString\" method");
    theory.detail = `wanted a trait-satisfaction diagnostic, got: ${firstDiagnostic(ref unsatisfied)}`;
  }

  // Without a `toString`, an interpolated enum renders as its UNDERLYING value.
  // The precedence matters: a Display method WINS over the underlying, which is
  // what makes the two enums in one program print differently.
  let plain = checkSource("enum Color { Red, Green }\nfunction f(): string { let c: Color = Color.Red; return `x`; }");
  let test theory: Case = t.asserts("an enum with no toString still interpolates, as its value") {
    theory.isSuccessful = plain.diagnostics.len == 0;
    theory.detail = `reported ${plain.diagnostics.len}: ${firstDiagnostic(ref plain)}`;
  }
}

// The value a folded case holds, or a sentinel that fails whichever assertion
// asked. Reads it back out of the type arena, which is where every later pass
// finds it.
function enumValueOf(ref prog: Program, enumName: string, caseName: string): int64 {
  const enumType = testEnumTypeOf(ref prog, enumName);
  if (enumType == TYPE_ERROR_ID) {
    return -9999;
  }
  const found = lookupEnumCase(ref prog, enumType, caseName);
  if (!found.found) {
    return -9999;
  }
  return found.value;
}

function enumIsOpenNamed(ref prog: Program, enumName: string): bool {
  return enumIsOpen(ref prog, testEnumTypeOf(ref prog, enumName));
}

function testEnumTypeOf(ref prog: Program, enumName: string): TypeId {
  const symId = symbolIdIn(ref prog, 0, enumName);
  if (symId == 0) {
    return TYPE_ERROR_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.ValueEnum { typeId: t }: { return t; }
    default: { return TYPE_ERROR_ID; }
  }
}

// ----- floats ----------------------------------------------------------------

// Every rule here was established by compiling probe programs against the JS
// reference rather than by reading its source. The strictness is the striking
// part: nothing mixes with anything, in either direction.
suite function floatLiteralsPinLikeIntLiteralsDo(): void {
  let plain = checkSource("function f(): float32 { return 1.5; }");
  let test theory: Case = t.asserts("a float literal pins to the expected width") {
    theory.isSuccessful = plain.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref plain)}`;
  }

  // The mirror of the untyped-int rule, and the reference has both: an untyped
  // int does not reach a float slot, and an untyped float does not reach an int
  // one. `2` and `2.0` are different literals, not two spellings of one.
  let intToFloat = checkSource("function f(): float64 { const a: float64 = 2; return a; }");
  let test theory: Case = t.asserts("an untyped INT literal does not pin to a float") {
    theory.isSuccessful = diagnosticsMention(ref intToFloat, "cannot assign untyped int to float64");
    theory.detail = `got: ${firstDiagnostic(ref intToFloat)}`;
  }
  let floatToInt = checkSource("function f(): int32 { const a: int32 = 2.0; return a; }");
  let test theory: Case = t.asserts("an untyped FLOAT literal does not pin to an int") {
    theory.isSuccessful = diagnosticsMention(ref floatToInt, "cannot assign untyped float to int32");
    theory.detail = `got: ${firstDiagnostic(ref floatToInt)}`;
  }

  // Unconstrained, it defaults to float64. This is the same divergence the
  // untyped INT default is: the reference infers float64 for the binding and
  // then reports "this expression still has an unpinned literal type" out of
  // its own codegen, which is a compiler bug it still owes.
  let unconstrained = checkSource(
    "function narrow(x: float32): int32 { return 0; } function f(): int32 { const a = 1.5; return narrow(a); }"
  );
  let test theory: Case = t.asserts("an unconstrained float literal defaults to float64") {
    theory.isSuccessful = diagnosticsMention(ref unconstrained, "is float32, not float64");
    theory.detail = `got: ${firstDiagnostic(ref unconstrained)}`;
  }

  // A LEADING literal is re-pinned from the other operand, the same way a
  // leading int literal is. Without it `1.5 * s` on a float32 `s` would refuse
  // to mix the width the writer never wrote.
  let leading = checkSource("function f(s: float32): float32 { return 1.5 * s; }");
  let test theory: Case = t.asserts("a leading float literal takes the other operand's width") {
    theory.isSuccessful = leading.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref leading)}`;
  }
}

suite function floatWidthsDoNotMix(): void {
  let widths = checkSource("function f(a: float32, b: float64): float64 { return a + b; }");
  let test theory: Case = t.asserts("float32 and float64 do not mix") {
    theory.isSuccessful = diagnosticsMention(ref widths, "float32 and float64");
    theory.detail = `got: ${firstDiagnostic(ref widths)}`;
  }

  let withInt = checkSource("function f(a: float64, n: int32): float64 { return a + n; }");
  let test theory: Case = t.asserts("a float and an int do not mix") {
    theory.isSuccessful = diagnosticsMention(ref withInt, "float64 and int32");
    theory.detail = `got: ${firstDiagnostic(ref withInt)}`;
  }

  // No implicit widening either, which is what makes the cast the only route.
  let assign = checkSource("function f(a: float32): float64 { const b: float64 = a; return b; }");
  let test theory: Case = t.asserts("a float32 does not widen implicitly") {
    theory.isSuccessful = assign.diagnostics.len > 0;
    theory.detail = "assigning a float32 to a float64 produced no diagnostic";
  }
}

suite function floatsKeepArithmeticAndLoseTheBitwiseFamily(): void {
  let arith = checkSource("function f(a: float64, b: float64): float64 { return a + b - a * b / b % a; }");
  let test theory: Case = t.asserts("every arithmetic operator survives, modulus included") {
    theory.isSuccessful = arith.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref arith)}`;
  }

  let compare = checkSource("function f(a: float64, b: float64): bool { return a < b && a >= b || a == b && a != b; }");
  let test theory: Case = t.asserts("every comparison survives and yields a bool") {
    theory.isSuccessful = compare.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref compare)}`;
  }

  // The reference is inconsistent here and this side deliberately is not: `|`
  // is a typecheck error there while `&` reaches codegen and crashes it.
  let band = checkSource("function f(a: float64, b: float64): float64 { return a & b; }");
  let test theory: Case = t.asserts("bitwise and is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref band, "the bitwise family is integers only");
    theory.detail = `got: ${firstDiagnostic(ref band)}`;
  }
  let shift = checkSource("function f(a: float64, b: float64): float64 { return a << b; }");
  let test theory: Case = t.asserts("a shift is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref shift, "the bitwise family is integers only");
    theory.detail = `got: ${firstDiagnostic(ref shift)}`;
  }

  // Unary minus works; unary `!` does not, and that refusal already existed.
  let neg = checkSource("function f(a: float64): float64 { return -a; }");
  let test theory: Case = t.asserts("unary minus works on a float") {
    theory.isSuccessful = neg.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref neg)}`;
  }
  let notFloat = checkSource("function f(a: float64): bool { return !a; }");
  let test theory: Case = t.asserts("logical not still needs a bool") {
    theory.isSuccessful = notFloat.diagnostics.len > 0;
    theory.detail = "!float produced no diagnostic";
  }

  // An index and an `if` are both already type-checked against their own
  // requirement, so a float reaches neither.
  let index = checkSource("function f(xs: int32[], a: float64): int32 { return xs[a]; }");
  let test theory: Case = t.asserts("a float is not an array index") {
    theory.isSuccessful = index.diagnostics.len > 0;
    theory.detail = "indexing with a float produced no diagnostic";
  }
}

suite function floatCastsGoBothWays(): void {
  let both = checkSource(
    "function f(n: int32, a: float64): float64 { const x: float64 = float64(n); const y: int32 = int32(a); const z: float32 = float32(a); return x; }"
  );
  let test theory: Case = t.asserts("int to float, float to int, and float to float all cast") {
    theory.isSuccessful = both.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref both)}`;
  }

  // A bool is not a number on either side, and the message is the same one the
  // reference gives.
  let toBool = checkSource("function f(a: float64): bool { return bool(a); }");
  let test theory: Case = t.asserts("a float does not cast to bool") {
    theory.isSuccessful = diagnosticsMention(ref toBool, "cannot cast float64 to bool");
    theory.detail = `got: ${firstDiagnostic(ref toBool)}`;
  }
  let toString = checkSource("function f(a: float64): string { return string(a); }");
  let test theory: Case = t.asserts("a float does not cast to string") {
    theory.isSuccessful = diagnosticsMention(ref toString, "cannot cast float64 to string");
    theory.detail = `got: ${firstDiagnostic(ref toString)}`;
  }

  // The cast must not pin its operand, which is what keeps the operand's own
  // arithmetic checkable on its own terms. Same invariant the int casts carry.
  let nested = checkSource("function f(a: float64, b: float64): int32 { return int32(a * b); }");
  let test theory: Case = t.asserts("a cast does not reach into its operand") {
    theory.isSuccessful = nested.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref nested)}`;
  }
}

// A float enum backing is refused - an enum aliases an int width or `string`,
// and nothing else. Recorded here because it is the one place `isFloatPrimType`
// deliberately does NOT look through an enum.
suite function anEnumIsNeverFloatBacked(): void {
  let backed = checkSource("enum K<float64> { A, B }");
  let test theory: Case = t.asserts("a float enum backing is refused") {
    theory.isSuccessful = backed.diagnostics.len > 0;
    theory.detail = "enum K<float64> produced no diagnostic";
  }
}

// ----- type-parameter bounds ------------------------------------------------
//
// A bound is a promise made at the DECLARATION and verified at every
// instantiation. Both halves are asserted here, because either one alone is
// unsound in a different direction: the body may call the bound's methods on an
// opaque `T` only because every call site is checked to keep the promise.

const SHOWABLE_TRAIT: string = "trait Showable { function show(ref self): int32; }\n";
const SHOWABLE_IMPL: string = "type Lit implements Showable { n: int32, function show(ref self): int32 { return self.n; } }\ntype Plain { z: int32 }\n";
const TRAITS_AB: string = "trait A { function a(ref self): int32; }\ntrait B { function b(ref self): int32; }\n";
const CMP_TRAIT: string = "trait Cmp<U> { function compare(ref self, b: U): int8; }\n";

suite function aBoundMakesItsMethodsCallableOnTheParameter(): void {
  let ok = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}function describe<T implements Showable>(ref x: T): int32 { return Showable.show(ref x); }
function main(): int32 { let l: Lit = { n: 7 }; return describe(ref l); }`);
  let test theory: Case = t.asserts("a bounded body may call the bound's method on the parameter") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref ok)}`;
  }

  // The body is checked ONCE at the decl, so an UNBOUNDED parameter is refused
  // there rather than at whatever call site happens to come first. That is the
  // half which makes this design worth choosing: the error names the
  // declaration the author can fix, not every place it is used.
  let unbounded = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}function describe<T>(ref x: T): int32 { return Showable.show(ref x); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("an unbounded parameter has no methods, and the DECL says so") {
    theory.isSuccessful = diagnosticsMention(ref unbounded, `is not bound to trait "Showable"`);
    theory.detail = `wanted an unbound-parameter diagnostic, got: ${firstDiagnostic(ref unbounded)}`;
  }

  // ... and so is a trait the parameter is not bound to, even when it is bound
  // to another one. The bound is the whole promise, not "some trait somewhere".
  let wrongTrait = checkSource(`${TRAITS_AB}function f<T implements A>(ref x: T): int32 { return B.b(ref x); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("a trait outside the bound is refused at the decl") {
    theory.isSuccessful = diagnosticsMention(ref wrongTrait, `is not bound to trait "B"`);
    theory.detail = `wanted an unbound-parameter diagnostic for B, got: ${firstDiagnostic(ref wrongTrait)}`;
  }
}

suite function multipleBoundsNeedParentheses(): void {
  const IMPL_AB: string = "type W implements (A, B) { w: int32, function a(ref self): int32 { return 1; } function b(ref self): int32 { return 2; } }\n";

  let both = checkSource(`${TRAITS_AB}${IMPL_AB}function f<T implements (A, B)>(ref x: T): int32 { return A.a(ref x) + B.b(ref x); }
function main(): int32 { let w: W = { w: 0 }; return f(ref w); }`);
  let test theory: Case = t.asserts("both traits in a parenthesized bound are callable") {
    theory.isSuccessful = both.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref both)}`;
  }

  // A COMMA separates type PARAMETERS, so `<X implements A, B>` declares a
  // bounded X beside an unbounded parameter named B - it does not add a second
  // bound to X. The asymmetry with a type decl's `implements` clause is forced
  // rather than chosen, and it is the reference's rule.
  let comma = checkSource(`${TRAITS_AB}${IMPL_AB}function f<X implements A, B>(ref x: X, y: B): int32 { return B.b(ref x); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("a bare comma starts a new PARAMETER, not a second bound") {
    theory.isSuccessful = diagnosticsMention(ref comma, `is not bound to trait "B"`);
    theory.detail = `wanted X to be unbound by B, got: ${firstDiagnostic(ref comma)}`;
  }
}

suite function aBoundIsCheckedAtEveryInstantiation(): void {
  let badCall = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}function describe<T implements Showable>(ref x: T): int32 { return Showable.show(ref x); }
function main(): int32 { let p: Plain = { z: 1 }; return describe(ref p); }`);
  let test theory: Case = t.asserts("a call whose argument does not implement the bound is refused") {
    theory.isSuccessful = diagnosticsMention(ref badCall, `does not satisfy the bound "Showable"`);
    theory.detail = `wanted an unsatisfied-bound diagnostic, got: ${firstDiagnostic(ref badCall)}`;
  }

  // The same promise at the other place a generic is applied: an ANNOTATION.
  let badType = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}type Holder<T implements Showable> { v: T }
function main(): int32 { let h: Holder<Plain> = { v: { z: 1 } }; return 0; }`);
  let test theory: Case = t.asserts("a generic TYPE application checks its bounds too") {
    theory.isSuccessful = diagnosticsMention(ref badType, `does not satisfy the bound "Showable"`);
    theory.detail = `wanted an unsatisfied-bound diagnostic, got: ${firstDiagnostic(ref badType)}`;
  }

  // A type PARAMETER can satisfy a bound, and has to: a bounded generic calling
  // another bounded generic passes its own opaque `T` along.
  let forward = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}function inner<T implements Showable>(ref x: T): int32 { return Showable.show(ref x); }
function outer<T implements Showable>(ref x: T): int32 { return inner(ref x); }
function main(): int32 { let l: Lit = { n: 3 }; return outer(ref l); }`);
  let test theory: Case = t.asserts("a parameter satisfies a bound its OWN bounds cover") {
    theory.isSuccessful = forward.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref forward)}`;
  }

  let forwardBad = checkSource(`${TRAITS_AB}function inner<T implements A>(ref x: T): int32 { return A.a(ref x); }
function outer<T implements B>(ref x: T): int32 { return inner(ref x); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("a parameter whose bounds do not cover the callee's is refused") {
    theory.isSuccessful = diagnosticsMention(ref forwardBad, `does not satisfy the bound "A"`);
    theory.detail = `wanted an unsatisfied-bound diagnostic, got: ${firstDiagnostic(ref forwardBad)}`;
  }
}

suite function aBoundMustNameATrait(): void {
  let unknown = checkSource("function f<T implements Nope>(ref x: T): int32 { return 1; }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("an unknown name in a bound is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknown, `unknown trait "Nope" in bound on type parameter "T"`);
    theory.detail = `wanted an unknown-trait diagnostic, got: ${firstDiagnostic(ref unknown)}`;
  }

  let notTrait = checkSource("type Plain { z: int32 }\nfunction f<T implements Plain>(ref x: T): int32 { return 1; }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("a non-trait in a bound is a different message from a missing one") {
    theory.isSuccessful = diagnosticsMention(ref notTrait, `must be a trait, got "Plain"`);
    theory.detail = `wanted a not-a-trait diagnostic, got: ${firstDiagnostic(ref notTrait)}`;
  }
}

// A bound naming a GENERIC trait applied to the parameter itself. This is the
// shape `utils/sort.yoop` needs, and it is why 1.6 needed a slice of generic
// trait instantiation: the trait's own parameter has to be substituted, or the
// signature the body is checked against still talks about the trait's `U`.
suite function aGenericTraitBoundSubstitutesItsOwnParameter(): void {
  const CMP_IMPL: string = "type N implements Cmp<N> { v: int32, function compare(ref self, b: N): int8 { return 1; } }\n";

  let ok = checkSource(`${CMP_TRAIT}${CMP_IMPL}function pick<T implements Cmp<T>>(ref a: T, b: T): int8 { return Cmp.compare(ref a, b); }
function main(): int32 { let x: N = { v: 1 }; return int32(pick(ref x, x)); }`);
  let test theory: Case = t.asserts("a self-referential generic trait bound checks clean") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref ok)}`;
  }

  // The substitution is real rather than a name coincidence: the trait's own
  // parameter is `U`, and what the second argument is checked against is the
  // FUNCTION's `T`.
  let wrongArg = checkSource(`${CMP_TRAIT}${CMP_IMPL}function pick<T implements Cmp<T>>(ref a: T, b: T): int8 { let z: int32 = 4; return Cmp.compare(ref a, z); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("the bound's method signature is checked against the SUBSTITUTED parameter") {
    theory.isSuccessful = wrongArg.diagnostics.len > 0;
    theory.detail = "passing an int32 where the substituted T belongs produced no diagnostic";
  }

  // WHICH application a type implements is part of satisfying the bound. `N`
  // implementing `Cmp<int32>` does not satisfy `Cmp<N>`, and refusing that is a
  // deliberate divergence: the reference compares trait NAMES only and emits IR
  // clang rejects.
  let mismatched = checkSource(`${CMP_TRAIT}type N implements Cmp<int32> { v: int32, function compare(ref self, b: int32): int8 { return 1; } }
function pick<T implements Cmp<T>>(ref a: T, b: T): int8 { return Cmp.compare(ref a, b); }
function main(): int32 { let x: N = { v: 1 }; return int32(pick(ref x, x)); }`);
  let test theory: Case = t.asserts("a type implementing a DIFFERENT application does not satisfy the bound") {
    theory.isSuccessful = diagnosticsMention(ref mismatched, `does not satisfy the bound "Cmp<N>"`);
    theory.detail = `wanted an application mismatch, got: ${firstDiagnostic(ref mismatched)}`;
  }

  // The arity of a generic trait bound is checked, including the empty case.
  // The reference registers a generic trait under its spelled-out name and so
  // answers `unknown trait "Cmp"` here, which points the reader at a
  // declaration that is right in front of them.
  let noArgs = checkSource(`${CMP_TRAIT}${CMP_IMPL}function pick<T implements Cmp>(ref a: T, b: T): int8 { return 0; }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("a generic trait bound without arguments is an ARITY error") {
    theory.isSuccessful = diagnosticsMention(ref noArgs, `"Cmp" takes 1 type argument(s), got 0`);
    theory.detail = `wanted an arity diagnostic, got: ${firstDiagnostic(ref noArgs)}`;
  }
}

// `ref xs[i]` - an array element has an address, so it can be borrowed. Needed
// by any sort that hands an element to a comparison, which is what pulled it in
// alongside bounds.
suite function anArrayElementCanBeBorrowed(): void {
  let ok = checkSource(`${SHOWABLE_TRAIT}${SHOWABLE_IMPL}function f(xs: Lit[]): int32 { return Showable.show(ref xs[0]); }
function main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("`ref xs[i]` borrows the element") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `wanted no diagnostic, got: ${firstDiagnostic(ref ok)}`;
  }

  // A temporary still has no address, which is the rule the element case had to
  // widen without breaking.
  let temp = checkSource("function g(): int32 { return 1; }\nfunction f(): int32 { return g(ref g()); }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("a call result still has no address to borrow") {
    theory.isSuccessful = diagnosticsMention(ref temp, "there is no address for a temporary");
    theory.detail = `wanted a temporary diagnostic, got: ${firstDiagnostic(ref temp)}`;
  }
}

// `tracked r: Res = open() { ... }` - a kind-prefixed binding that OWNS a
// block. The block IS the binding's scope, which is the whole difference from a
// plain prefixed binding, and it is a typecheck fact before it is a codegen one.
suite function aBindingThatOwnsABlockIsScopedToIt(): void {
  const RES: string = "trait Closer { function close(ref self): void; }\nkind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; ownsBlock; }\ntype Res implements Closer { id: int32, function close(ref self): void { } }\nfunction open(): Res { return { id: 1 }; }\n";

  let inside = checkSource(`${RES}function f(): int32 { tracked r: Res = open() { return r.id; } return 0; }\nfunction main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("the binding is visible inside its block") {
    theory.isSuccessful = inside.diagnostics.len == 0;
    theory.detail = `reading the binding inside its block reported: ${firstDiagnostic(ref inside)}`;
  }

  // And gone after it. The reference answers `undefined variable` here, which
  // is what says the block is the scope rather than merely a block that happens
  // to follow the declaration.
  let after = checkSource(`${RES}function f(): int32 { tracked r: Res = open() { } return r.id; }\nfunction main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("the binding is gone after the block") {
    theory.isSuccessful = diagnosticsMention(ref after, `unknown name "r"`);
    theory.detail = `wanted an out-of-scope diagnostic, got: ${firstDiagnostic(ref after)}`;
  }

  // Two regions in a row may reuse a name, because neither outlives its block.
  let twice = checkSource(`${RES}function f(): int32 { tracked r: Res = open() { } tracked r: Res = open() { } return 0; }\nfunction main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("two regions may reuse one name") {
    theory.isSuccessful = twice.diagnostics.len == 0;
    theory.detail = `reusing a region's name reported: ${firstDiagnostic(ref twice)}`;
  }

  // The kind's promise is still checked: the block form does not skip the
  // "does the type have the method" test a plain binding gets.
  let noMethod = checkSource(`${RES}type Plain { n: int32 }\nfunction mk(): Plain { return { n: 1 }; }\nfunction f(): int32 { tracked p: Plain = mk() { } return 0; }\nfunction main(): int32 { return 0; }`);
  let test theory: Case = t.asserts("a region binding still needs the kind's method") {
    theory.isSuccessful = diagnosticsMention(ref noMethod, `requires a "close" method`);
    theory.detail = `wanted a missing-method diagnostic, got: ${firstDiagnostic(ref noMethod)}`;
  }
}

// A `type X = <annotation>;` is a TRANSPARENT alias: the name resolves to the
// RHS's own TypeId, so no new type is interned and `id == id` keeps deciding
// equality unchanged. That is what makes `NodeId` and `usize` interchangeable
// in BOTH directions, which is what the reference does.
suite function aTypeAliasIsTransparent(): void {
  let bothWays = checkSource(
    "type NodeId = usize;\nfunction takesUsize(n: usize): usize { return n; }\nfunction takesNodeId(n: NodeId): NodeId { return n; }\nfunction main(): int32 { let a: NodeId = 5; let b: usize = 7; let c: usize = takesNodeId(a); let d: NodeId = takesUsize(b); return 0; }"
  );
  let test theory: Case = t.asserts("an alias and its target are interchangeable both ways") {
    theory.isSuccessful = bothWays.diagnostics.len == 0;
    theory.detail = `reported ${bothWays.diagnostics.len}: ${firstDiagnostic(ref bothWays)}`;
  }

  // The half that was the critical path: an untyped int literal has to see an
  // INTEGER through the alias, or every `childA: 0` in the AST arena is
  // "cannot assign untyped int to NodeId" about a line that is fine.
  let literal = checkSource(
    "type NodeId = usize;\ntype Node { a: NodeId, b: NodeId }\nfunction main(): int32 { let n: Node = { a: 0, b: 1 }; let x: NodeId = 5; return 0; }"
  );
  let test theory: Case = t.asserts("an untyped int literal pins THROUGH an alias") {
    theory.isSuccessful = literal.diagnostics.len == 0;
    theory.detail = `reported ${literal.diagnostics.len}: ${firstDiagnostic(ref literal)}`;
  }

  // Resolution is LAZY, so an alias may name one declared further down the
  // file. Forcing them in source order would refuse this for naming a type
  // that is right there.
  let forward = checkSource(
    "type Coord = Pt;\ntype Pt = Point;\ntype Point { x: int32, y: int32 }\nfunction main(): int32 { let c: Coord = { x: 1, y: 2 }; return c.x; }"
  );
  let test theory: Case = t.asserts("an alias chain resolves regardless of declaration order") {
    theory.isSuccessful = forward.diagnostics.len == 0;
    theory.detail = `reported ${forward.diagnostics.len}: ${firstDiagnostic(ref forward)}`;
  }

  // An alias to a STRUCT is that struct, not a copy of it, so a literal
  // annotated with either name goes to the same place.
  let toStruct = checkSource(
    "type Point { x: int32 }\ntype Pt = Point;\nfunction takesPoint(p: Point): int32 { return p.x; }\nfunction main(): int32 { let a: Pt = { x: 1 }; return takesPoint(a); }"
  );
  let test theory: Case = t.asserts("an alias to a struct IS that struct") {
    theory.isSuccessful = toStruct.diagnostics.len == 0;
    theory.detail = `reported ${toStruct.diagnostics.len}: ${firstDiagnostic(ref toStruct)}`;
  }

  // An alias to an ARRAY of an alias - two levels of indirection in one
  // annotation, which is the shape `type IdList = NodeId[];` has.
  let ofArray = checkSource(
    "type NodeId = usize;\ntype IdList = NodeId[];\nfunction main(): int32 { let ids: IdList = [1, 2, 3]; let n: NodeId = ids[0]; return int32(ids.len); }"
  );
  let test theory: Case = t.asserts("an alias to an array of an alias resolves") {
    theory.isSuccessful = ofArray.diagnostics.len == 0;
    theory.detail = `reported ${ofArray.diagnostics.len}: ${firstDiagnostic(ref ofArray)}`;
  }

  // A cycle is named rather than left to hang. Lazy resolution has no order to
  // detect one from, so the guard is the only thing between this and a
  // compiler that never returns.
  let cycle = checkSource(
    "type A = B;\ntype B = A;\nfunction main(): int32 { let a: A = 0; return 0; }"
  );
  let test theory: Case = t.asserts("a self-referential alias is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref cycle, "is defined in terms of itself");
    theory.detail = `wanted the cycle message, got: ${firstDiagnostic(ref cycle)}`;
  }

  // A GENERIC alias needs the parameters in scope while the RHS resolves and a
  // template to instantiate on use. Nothing in the corpus writes one, so it is
  // refused BY NAME rather than half-built.
  let generic = checkSource(
    "type Box<T> { v: T }\ntype Pair<T> = Box<T>;\nfunction main(): int32 { return 0; }"
  );
  let test theory: Case = t.asserts("a generic type alias is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref generic, "is a GENERIC type alias");
    theory.detail = `wanted the generic-alias refusal, got: ${firstDiagnostic(ref generic)}`;
  }
}

// A STRUCT LITERAL handed to a generic function pins to the parameter type once
// the type argument is inferred from the OTHER arguments. It is skipped during
// inference - it has no type of its own to contribute - and checked on the
// re-check against the substituted signature.
suite function aStructLiteralPinsThroughAGenericCall(): void {
  const DECLS = "type Pair { a: int32, b: int32 }\nfunction record<T>(item: T, tag: int32): T { return item; }\nfunction pick<T>(first: T, second: T): T { return first; }\n";

  let inferred = checkSource(
    `${DECLS}function main(): int32 { let p: Pair = { a: 1, b: 2 }; let q: Pair = record({ a: 3, b: 4 }, 9); return q.a; }`
  );
  let test theory: Case = t.asserts("a struct literal argument pins to the inferred parameter") {
    theory.isSuccessful = inferred.diagnostics.len == 0;
    theory.detail = `reported ${inferred.diagnostics.len}: ${firstDiagnostic(ref inferred)}`;
  }

  // Inferred from a SIBLING argument rather than from the expected type, which
  // is the shape `vec.vecPush(ref out, { ... })` has.
  let fromSibling = checkSource(
    `${DECLS}function main(): int32 { let p: Pair = { a: 1, b: 2 }; let r = pick(p, { a: 3, b: 4 }); return r.a; }`
  );
  let test theory: Case = t.asserts("a struct literal pins from a SIBLING argument's type") {
    theory.isSuccessful = fromSibling.diagnostics.len == 0;
    theory.detail = `reported ${fromSibling.diagnostics.len}: ${firstDiagnostic(ref fromSibling)}`;
  }

  // With NOTHING else to pin the parameter, the message is about the type
  // parameter and not about the literal - the literal is fine, the call site
  // is what is short of information.
  let unpinnable = checkSource(
    `${DECLS}function main(): int32 { let r = record({ a: 1, b: 2 }, 9); return 0; }`
  );
  let test theory: Case = t.asserts("a literal that pins nothing reports the TYPE PARAMETER") {
    theory.isSuccessful = diagnosticsMention(ref unpinnable, "cannot infer \"T\"");
    theory.detail = `wanted the inference message, got: ${firstDiagnostic(ref unpinnable)}`;
  }

  // A field mistake INSIDE the literal is still reported once the literal has
  // a type to be checked against.
  let badField = checkSource(
    `${DECLS}function main(): int32 { let p: Pair = { a: 1, b: 2 }; let r = pick(p, { a: 3, zzz: 4 }); return r.a; }`
  );
  let test theory: Case = t.asserts("a wrong field in a pinned literal is still reported") {
    theory.isSuccessful = badField.diagnostics.len > 0;
    theory.detail = "a bad field name inside a generic-call struct literal produced no diagnostic";
  }
}

// `ref a.b.c` - a borrow of a NESTED field path. Codegen's field-address walk
// already recursed through a nested base, so this is a rule about where the
// path BOTTOMS OUT rather than about how deep it goes.
suite function aNestedFieldPathCanBeBorrowed(): void {
  const DECLS = "type Inner { n: int32 }\ntype Mid { inner: Inner }\ntype Outer { mid: Mid }\nfunction bump(ref i: Inner): void { i.n = i.n + 1; }\n";

  let deep = checkSource(
    `${DECLS}function main(): int32 { let o: Outer = { mid: { inner: { n: 1 } } }; bump(ref o.mid.inner); return o.mid.inner.n; }`
  );
  let test theory: Case = t.asserts("`ref a.b.c` borrows at any depth") {
    theory.isSuccessful = deep.diagnostics.len == 0;
    theory.detail = `reported ${deep.diagnostics.len}: ${firstDiagnostic(ref deep)}`;
  }

  // A path off a CALL has no storage at the bottom, so it is still refused -
  // and the message names the two shapes rather than the depth.
  let offCall = checkSource(
    `${DECLS}function mk(): Outer { return { mid: { inner: { n: 1 } } }; }\nfunction main(): int32 { bump(ref mk().mid.inner); return 0; }`
  );
  let test theory: Case = t.asserts("a field path off a CALL is still refused") {
    theory.isSuccessful = diagnosticsMention(ref offCall, "bottoms out in a named binding");
    theory.detail = `wanted the path-bottom refusal, got: ${firstDiagnostic(ref offCall)}`;
  }

  // A path off an ELEMENT bottoms out too. An element has an address, so the
  // walk starts from a gep on the descriptor's data pointer instead of from a
  // slot - one different first step, and the rest is the ordinary field walk.
  // `ref entries[i].dispatcher` in std/http's router is why it exists.
  let offElem = checkSource(
    `${DECLS}function main(): int32 { let os: Outer[] = [{ mid: { inner: { n: 1 } } }]; bump(ref os[0].mid.inner); return 0; }`
  );
  let test theory: Case = t.asserts("a field path off an ELEMENT borrows at any depth") {
    theory.isSuccessful = offElem.diagnostics.len == 0;
    theory.detail = `reported ${offElem.diagnostics.len}: ${firstDiagnostic(ref offElem)}`;
  }

  // Writing through one, which is the other half of having an address.
  let writeElem = checkSource(
    `${DECLS}function main(): int32 { let os: Outer[] = [{ mid: { inner: { n: 1 } } }]; os[0].mid.inner.n = 9; return os[0].mid.inner.n; }`
  );
  let test theory: Case = t.asserts("a field path off an ELEMENT is assignable too") {
    theory.isSuccessful = writeElem.diagnostics.len == 0;
    theory.detail = `reported ${writeElem.diagnostics.len}: ${firstDiagnostic(ref writeElem)}`;
  }
}

// `trait Child extends Parent`. Two merges and nothing else: the child's
// method TABLE absorbs its parents', and an `implements Child` clause claims
// the parents too. Everything downstream - dispatch, satisfaction, the
// "no inherent methods" rule - then works with no chain walk anywhere.
suite function aTraitCanExtendAnother(): void {
  const CHAIN: string = "trait Greeter { function greet(ref self): int32; }\ntrait Loud extends Greeter { function shout(ref self): int32; }\ntype Mega implements Loud { n: int32,\n  function greet(ref self): int32 { return self.n; }\n  function shout(ref self): int32 { return self.n * 10; } }\n";

  let through = checkSource(`${CHAIN}function main(): int32 { let m: Mega = { n: 1 }; return Loud.greet(ref m); }`);
  let test theory: Case = t.asserts("the CHILD trait dispatches a parent's method") {
    theory.isSuccessful = through.diagnostics.len == 0;
    theory.detail = `Loud.greet reported: ${firstDiagnostic(ref through)}`;
  }

  let parent = checkSource(`${CHAIN}function main(): int32 { let m: Mega = { n: 1 }; return Greeter.greet(ref m); }`);
  let test theory: Case = t.asserts("the PARENT trait still dispatches its own method") {
    theory.isSuccessful = parent.diagnostics.len == 0;
    theory.detail = `Greeter.greet reported: ${firstDiagnostic(ref parent)}`;
  }

  // The transitive half of the claim: `implements Loud` is also a promise about
  // Greeter, so a bound on the PARENT is satisfied.
  let bound = checkSource(
    `${CHAIN}function g<T implements Greeter>(ref t: T): int32 { return Greeter.greet(ref t); }\nfunction main(): int32 { let m: Mega = { n: 1 }; return g(ref m); }`
  );
  let test theory: Case = t.asserts("a bound on the PARENT is satisfied through extends") {
    theory.isSuccessful = bound.diagnostics.len == 0;
    theory.detail = `a parent bound reported: ${firstDiagnostic(ref bound)}`;
  }

  // And the promise still bites: a type implementing the child owes the
  // parent's methods too, named as the parent's.
  let missing = checkSource(
    "trait Greeter { function greet(ref self): int32; }\ntrait Loud extends Greeter { function shout(ref self): int32; }\ntype Mega implements Loud { n: int32,\n  function shout(ref self): int32 { return self.n; } }\nfunction main(): int32 { return 0; }"
  );
  let test theory: Case = t.asserts("a missing PARENT method is refused") {
    theory.isSuccessful = diagnosticsMention(ref missing, `has no "greet" method`);
    theory.detail = `wanted a missing-method diagnostic, got: ${firstDiagnostic(ref missing)}`;
  }

  // A parent declared BELOW its child would merge an empty method table, which
  // loses methods silently. Refused by name instead.
  let outOfOrder = checkSource(
    "trait Loud extends Greeter { function shout(ref self): int32; }\ntrait Greeter { function greet(ref self): int32; }\nfunction main(): int32 { return 0; }"
  );
  let test theory: Case = t.asserts("a parent declared AFTER its child is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref outOfOrder, "declare a parent trait before the child");
    theory.detail = `wanted the ordering refusal, got: ${firstDiagnostic(ref outOfOrder)}`;
  }
}

// `for x in <iterator>` over a type implementing `Iterable<T>`.
//
// The element type comes off the `Yield` case's `value` field of whatever
// `next` returns, rather than off the `Iterable<T>` application - which is what
// keeps it in step with the payload gep codegen emits. See
// typecheck/iterable.yoop.
suite function forInWalksAnIterable(): void {
  const ITER: string = "variant IterStep<T> { Yield { value: T }, Done, }\ntrait Iterable<T> { function next(ref self): IterStep<T>; }\ntype Counter implements Iterable<int32> { at: int32,\n  function next(ref self): IterStep<int32> { self.at = self.at + 1; return IterStep.Yield { value: self.at }; } }\n";

  let ok = checkSource(
    `${ITER}function main(): int32 { let c: Counter = { at: 0 }; let s: int32 = 0; for n in c { s = s + n; } return s; }`
  );
  let test theory: Case = t.asserts("an Iterable walks with `for ... in`") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `walking a Counter reported: ${firstDiagnostic(ref ok)}`;
  }

  // The loop variable is the YIELD payload's type, so using it as something
  // else is an ordinary type error rather than anything about iteration.
  let wrongElem = checkSource(
    `${ITER}function main(): int32 { let c: Counter = { at: 0 }; for n in c { let s: string = n; } return 0; }`
  );
  let test theory: Case = t.asserts("the loop variable is bound to the Yield payload type") {
    theory.isSuccessful = wrongElem.diagnostics.len > 0;
    theory.detail = "binding an int32 element to a string was accepted";
  }

  // A `next` that does not return an IterStep-shaped variant is refused BY
  // NAME, naming the shape rather than reporting a type mismatch three lines
  // away from the declaration that caused it.
  let badNext = checkSource(
    "trait Iterable<T> { function next(ref self): T; }\ntype Bad implements Iterable<int32> { at: int32,\n  function next(ref self): int32 { return self.at; } }\nfunction main(): int32 { let b: Bad = { at: 0 }; for n in b { } return 0; }"
  );
  let test theory: Case = t.asserts("a `next` with the wrong shape is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref badNext, "IterStep-shaped variant");
    theory.detail = `wanted the IterStep-shape refusal, got: ${firstDiagnostic(ref badNext)}`;
  }

  // And something that is neither an array nor an Iterable still gets the
  // ordinary refusal, now naming both routes.
  let neither = checkSource(
    "type Plain { n: int32 }\nfunction main(): int32 { let p: Plain = { n: 1 }; for x in p { } return 0; }"
  );
  let test theory: Case = t.asserts("a non-iterable non-array names both routes") {
    theory.isSuccessful = diagnosticsMention(ref neither, "an array or a type implementing Iterable<T>");
    theory.detail = `wanted the two-route refusal, got: ${firstDiagnostic(ref neither)}`;
  }
}

// `propagates<disposable>` on a type with no `dispose` of its own: the
// obligation belongs to the FIELDS. See typecheck/propagate.yoop.
suite function aPropagatingTypeDisposesItsFields(): void {
  const KIND: string = "kind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; }\ntrait Closer { function close(ref self): void; }\ntype Res implements Closer propagates<tracked> { id: int32,\n  function close(ref self): void { } }\n";

  let ok = checkSource(
    `${KIND}type Pair propagates<tracked> { a: Res, b: Res, plain: int32, }\nfunction main(): int32 { tracked p: Pair = { a: { id: 1 }, b: { id: 2 }, plain: 0 }; return p.plain; }`
  );
  let test theory: Case = t.asserts("a propagating type needs no method of its own") {
    theory.isSuccessful = ok.diagnostics.len == 0;
    theory.detail = `a propagated binding reported: ${firstDiagnostic(ref ok)}`;
  }

  // The clause is what makes the difference. Without it the type owes the
  // method itself, and the message is the one it always was.
  let noClause = checkSource(
    `${KIND}type Pair { a: Res, b: Res, }\nfunction main(): int32 { tracked p: Pair = { a: { id: 1 }, b: { id: 2 } }; return 0; }`
  );
  let test theory: Case = t.asserts("without the clause it still owes the method itself") {
    theory.isSuccessful = diagnosticsMention(ref noClause, `requires a "close" method`);
    theory.detail = `wanted the missing-method refusal, got: ${firstDiagnostic(ref noClause)}`;
  }

  // A clause with nothing to propagate TO promised a cleanup that would emit
  // no call at all - a leak that compiles. Refused by name.
  let noFields = checkSource(
    `${KIND}type Empty propagates<tracked> { n: int32, }\nfunction main(): int32 { tracked e: Empty = { n: 1 }; return e.n; }`
  );
  let test theory: Case = t.asserts("a propagating type with no carrying field is refused") {
    theory.isSuccessful = diagnosticsMention(ref noFields, "no field of");
    theory.detail = `wanted the no-carrying-field refusal, got: ${firstDiagnostic(ref noFields)}`;
  }

  // Chaining through a second level is a real feature and is refused by name
  // rather than half-built: the reference emits a call to a symbol that does
  // not exist.
  let chained = checkSource(
    `${KIND}type Pair propagates<tracked> { a: Res, }\ntype Outer propagates<tracked> { p: Pair, }\nfunction main(): int32 { tracked o: Outer = { p: { a: { id: 1 } } }; return 0; }`
  );
  let test theory: Case = t.asserts("a SECOND level of propagation is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref chained, "through a second level");
    theory.detail = `wanted the second-level refusal, got: ${firstDiagnostic(ref chained)}`;
  }
}

// The OTHER way a field supplies a propagated kind: it says so with a kind
// PREFIX in its own annotation, rather than its type propagating the kind.
//
// `Plain` here is the case that makes the two spellings distinguishable - it
// implements the trait OUTRIGHT and propagates nothing, so its type answers no
// and only the annotation can. That is `examples/pass/propagates_full`'s
// `handle: disposable FileHandle`.
suite function aFieldCarriesAKindByPrefix(): void {
  const KIND: string = "kind tracked { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; }\ntrait Closer { function close(ref self): void; }\ntype Plain implements Closer { id: int32,\n  function close(ref self): void { } }\n";

  let carried = checkSource(
    `${KIND}type Holder propagates<tracked> { h: tracked Plain, }\nfunction main(): int32 { tracked x: Holder = { h: { id: 1 } }; return 0; }`
  );
  let test theory: Case = t.asserts("a field carrying the kind by prefix supplies it") {
    theory.isSuccessful = carried.diagnostics.len == 0;
    theory.detail = `a carried-kind field reported: ${firstDiagnostic(ref carried)}`;
  }

  // The PREFIX is what does the work, and this is the assertion that proves it:
  // the same field, the same type, no prefix, and the refusal comes back.
  let noPrefix = checkSource(
    `${KIND}type Holder propagates<tracked> { h: Plain, }\nfunction main(): int32 { tracked x: Holder = { h: { id: 1 } }; return 0; }`
  );
  let test theory: Case = t.asserts("the same field with no prefix is still refused") {
    theory.isSuccessful = diagnosticsMention(ref noPrefix, "no field of");
    theory.detail = `wanted the no-carrying-field refusal, got: ${firstDiagnostic(ref noPrefix)}`;
  }

  // A prefix is a CLAIM, and a claim the type cannot honour is a bad annotation
  // rather than a missing feature - so it gets its own message instead of the
  // second-level one.
  let noMethod = checkSource(
    `${KIND}type Bare { n: int32, }\ntype Holder propagates<tracked> { h: tracked Bare, }\nfunction main(): int32 { tracked x: Holder = { h: { n: 1 } }; return 0; }`
  );
  let test theory: Case = t.asserts("a carried kind whose type has no such method is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref noMethod, "carries the kind in its annotation");
    theory.detail = `wanted the bad-annotation refusal, got: ${firstDiagnostic(ref noMethod)}`;
  }

  // An unrelated prefix supplies nothing. The kind the field names has to be the
  // kind the binding is asking about, not merely SOME kind.
  let otherKind = checkSource(
    `${KIND}kind noted { appliesTo binding; }\ntype Holder propagates<tracked> { h: noted Plain, }\nfunction main(): int32 { tracked x: Holder = { h: { id: 1 } }; return 0; }`
  );
  let test theory: Case = t.asserts("a prefix naming a DIFFERENT kind supplies nothing") {
    theory.isSuccessful = diagnosticsMention(ref otherKind, "no field of");
    theory.detail = `wanted the no-carrying-field refusal, got: ${firstDiagnostic(ref otherKind)}`;
  }
}

// `switch` over a BOOL. Exhaustiveness is the whole reason it is its own
// scrutinee kind rather than a one-bit integer: two values means `true` beside
// `false` covers everything, so the default arm becomes optional.
suite function aSwitchOverABoolIsExhaustiveOrDefaulted(): void {
  let both = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } case false: { return 0; } } }"
  );
  let test theory: Case = t.asserts("both cases need no default arm") {
    theory.isSuccessful = both.diagnostics.len == 0;
    theory.detail = `an exhaustive bool switch reported: ${firstDiagnostic(ref both)}`;
  }

  let defaulted = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("one case plus a default is exhaustive too") {
    theory.isSuccessful = defaulted.diagnostics.len == 0;
    theory.detail = `a defaulted bool switch reported: ${firstDiagnostic(ref defaulted)}`;
  }

  // Unlike the variant rule, BOTH is allowed - the reference accepts it.
  let bothAndDefault = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } case false: { return 2; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("a default beside both cases is not a diagnostic") {
    theory.isSuccessful = bothAndDefault.diagnostics.len == 0;
    theory.detail = `a redundant default reported: ${firstDiagnostic(ref bothAndDefault)}`;
  }

  let partial = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } } return 0; }"
  );
  let test theory: Case = t.asserts("one case and no default is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref partial, "switch over bool is not exhaustive");
    theory.detail = `wanted the non-exhaustive refusal, got: ${firstDiagnostic(ref partial)}`;
  }

  let dup = checkSource(
    "function f(b: bool): int32 { switch (b) { case true: { return 1; } case true: { return 2; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("the same value twice is refused") {
    theory.isSuccessful = diagnosticsMention(ref dup, "duplicate case value true");
    theory.detail = `wanted the duplicate refusal, got: ${firstDiagnostic(ref dup)}`;
  }

  // The two spellings do not mix in either direction, even though `true` and
  // `1` would land on the same jump-table value.
  let intPattern = checkSource(
    "function f(b: bool): int32 { switch (b) { case 1: { return 1; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("an integer pattern against a bool is refused") {
    theory.isSuccessful = diagnosticsMention(ref intPattern, "must be true or false");
    theory.detail = `wanted the bool-pattern refusal, got: ${firstDiagnostic(ref intPattern)}`;
  }

  let boolPattern = checkSource(
    "function f(n: int32): int32 { switch (n) { case true: { return 1; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("a bool pattern against an integer is refused") {
    theory.isSuccessful = diagnosticsMention(ref boolPattern, "must be an integer literal");
    theory.detail = `wanted the integer-pattern refusal, got: ${firstDiagnostic(ref boolPattern)}`;
  }

  let variantPattern = checkSource(
    "variant R { Ok { v: int32 }, Err { e: int32 } }\nfunction f(b: bool): int32 { switch (b) { case R.Ok { v: v }: { return v; } default: { return 0; } } }"
  );
  let test theory: Case = t.asserts("a variant pattern against a bool is refused") {
    theory.isSuccessful = diagnosticsMention(ref variantPattern, "must be true or false");
    theory.detail = `wanted the bool-pattern refusal, got: ${firstDiagnostic(ref variantPattern)}`;
  }
}

// `kind c = a & b;` - a COMPOSED kind is every operand's clauses at once.
//
// Recording nothing about the operands is what this replaces, and the failure
// it caused was SILENT: a binding carrying the composition promised a scope-end
// call and emitted none. So the assertions are about a `mustCall` arriving
// through the composition rather than about the syntax.
suite function aComposedKindCarriesItsOperandsClauses(): void {
  const KINDS: string = "trait Closer { function close(ref self): void; }\ntype Res implements Closer { id: int32,\n  function close(ref self): void { } }\nkind base { appliesTo binding; requires Closer; mustCall close beforeScopeEnd; }\nkind noescape { appliesTo binding; mustNotEscape scope; }\n";

  let named = checkSource(
    `${KINDS}kind composed = base & noescape;\nfunction main(): int32 { composed r: Res = { id: 1 }; return r.id; }`
  );
  let test theory: Case = t.asserts("a composition of NAMES checks clean") {
    theory.isSuccessful = named.diagnostics.len == 0;
    theory.detail = `a composed binding reported: ${firstDiagnostic(ref named)}`;
  }

  let inline = checkSource(
    `${KINDS}kind composed = base & { mustNotEscape scope; };\nfunction main(): int32 { composed r: Res = { id: 1 }; return r.id; }`
  );
  let test theory: Case = t.asserts("an INLINE operand body checks clean too") {
    theory.isSuccessful = inline.diagnostics.len == 0;
    theory.detail = `an inline-composed binding reported: ${firstDiagnostic(ref inline)}`;
  }

  // The merge is what makes this a diagnostic: the composed kind inherits
  // `mustCall close`, so a type with no `close` fails the same check a bare
  // `base` binding would.
  let missing = checkSource(
    `${KINDS}type Plain { n: int32 }\nkind composed = base & noescape;\nfunction main(): int32 { composed p: Plain = { n: 1 }; return p.n; }`
  );
  let test theory: Case = t.asserts("the operand's mustCall really arrives") {
    theory.isSuccessful = diagnosticsMention(ref missing, `requires a "close" method`);
    theory.detail = `wanted the missing-method refusal, got: ${firstDiagnostic(ref missing)}`;
  }

  // An operand nothing declares is refused BY NAME rather than contributing
  // nothing, which is the whole point.
  let unknown = checkSource(
    `${KINDS}kind composed = base & nosuchkind;\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("an undeclared operand is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "which no kind declares");
    theory.detail = `wanted the unknown-operand refusal, got: ${firstDiagnostic(ref unknown)}`;
  }

  // `appliesTo region` arrives through a composition too, which is what lets a
  // composed kind be written anonymously. Both operands are region kinds
  // because the composed sites are the INTERSECTION: composing this with
  // `noescape`, which applies to a binding, would leave nowhere to write it.
  let region = checkSource(
    `${KINDS}kind reg { appliesTo region; requires Closer; mustCall close beforeScopeEnd; ownsBlock; }\nkind regNoescape { appliesTo region; mustNotEscape scope; }\nkind composed = reg & regNoescape;\nfunction open(): Res { return { id: 1 }; }\nfunction main(): int32 { composed open() { } return 0; }`
  );
  let test theory: Case = t.asserts("appliesTo region arrives through a composition") {
    theory.isSuccessful = region.diagnostics.len == 0;
    theory.detail = `a composed region reported: ${firstDiagnostic(ref region)}`;
  }
}

// What a kind DECLARATION is allowed to say - see typecheck/kinds.yoop.
//
// Every assertion here is a program the compiler has to REFUSE. A kind whose
// clauses contradict each other still parses, so without these the declaration
// promises something no pass will keep and the program compiles anyway.
suite function kindDeclarationsWithContradictoryClausesAreRefused(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";

  // The positive control, and the reason it comes first: every rule below is a
  // refusal, so a check that is merely too eager would pass all of them.
  let legal = checkSource(`kind marker { appliesTo binding parameter field return; forbids io globalState; mustNotEscape scope; }${MAIN}`);
  let test theory: Case = t.asserts("a kind naming several sites and both effect categories checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `a well-formed kind reported: ${firstDiagnostic(ref legal)}`;
  }

  let noSite = checkSource(`kind k { appliesTo; }${MAIN}`);
  let test theory: Case = t.asserts("appliesTo naming no site is refused") {
    theory.isSuccessful = diagnosticsMention(ref noSite, "appliesTo on kind \"k\" names no site");
    theory.detail = `wanted the empty-appliesTo refusal, got: ${firstDiagnostic(ref noSite)}`;
  }

  let twice = checkSource(`kind k { appliesTo binding binding; }${MAIN}`);
  let test theory: Case = t.asserts("the same appliesTo site twice is refused") {
    theory.isSuccessful = diagnosticsMention(ref twice, "already applies to \"binding\"");
    theory.detail = `wanted the duplicate-site refusal, got: ${firstDiagnostic(ref twice)}`;
  }

  // A function kind marks the DECLARATION, so there is no value for a value
  // site to be about.
  let bothSorts = checkSource(`kind k { appliesTo binding function; }${MAIN}`);
  let test theory: Case = t.asserts("a function site combined with a value site is refused") {
    theory.isSuccessful = diagnosticsMention(ref bothSorts, "applies to a function and to a value site");
    theory.detail = `wanted the mixed-site refusal, got: ${firstDiagnostic(ref bothSorts)}`;
  }

  let noCategory = checkSource(`kind k { appliesTo binding; forbids; }${MAIN}`);
  let test theory: Case = t.asserts("forbids naming no category is refused") {
    theory.isSuccessful = diagnosticsMention(ref noCategory, "forbids on kind \"k\" names no category");
    theory.detail = `wanted the empty-forbids refusal, got: ${firstDiagnostic(ref noCategory)}`;
  }

  let badCategory = checkSource(`kind k { appliesTo binding; forbids memory; }${MAIN}`);
  let test theory: Case = t.asserts("an effect category the compiler does not have is refused") {
    theory.isSuccessful = diagnosticsMention(ref badCategory, "forbids \"memory\", which is not an effect category");
    theory.detail = `wanted the unknown-category refusal, got: ${firstDiagnostic(ref badCategory)}`;
  }

  let escapeFunction = checkSource(`kind k { appliesTo binding; mustNotEscape function; }${MAIN}`);
  let test theory: Case = t.asserts("mustNotEscape bounded by anything but a scope is refused") {
    theory.isSuccessful = diagnosticsMention(ref escapeFunction, "bounds mustNotEscape by something other than \"scope\"");
    theory.detail = `wanted the escape-bound refusal, got: ${firstDiagnostic(ref escapeFunction)}`;
  }

  let escapeTwice = checkSource(`kind k { appliesTo binding; mustNotEscape scope; mustNotEscape scope; }${MAIN}`);
  let test theory: Case = t.asserts("two mustNotEscape clauses on one kind are refused") {
    theory.isSuccessful = diagnosticsMention(ref escapeTwice, "states mustNotEscape twice");
    theory.detail = `wanted the duplicate-clause refusal, got: ${firstDiagnostic(ref escapeTwice)}`;
  }

  // A kind argument only ever reaches a layout clause, so a string parameter
  // has nowhere to be used.
  let stringParam = checkSource(`kind aligned(n: string) { appliesTo binding; }${MAIN}`);
  let test theory: Case = t.asserts("a kind parameter that is not a compile-time number is refused") {
    theory.isSuccessful = diagnosticsMention(ref stringParam, "is not a compile-time number");
    theory.detail = `wanted the parameter-type refusal, got: ${firstDiagnostic(ref stringParam)}`;
  }

  let noArgument = checkSource(
    "kind aligned(n: usize) { appliesTo binding; }\ntype V { a: int32, }\nfunction main(): int32 { aligned v: V = { a: 1 }; return v.a; }"
  );
  let test theory: Case = t.asserts("a parameterized kind applied with no arguments is refused") {
    theory.isSuccessful = diagnosticsMention(ref noArgument, "takes 1 argument(s), and the prefix on \"v\" supplies none");
    theory.detail = `wanted the missing-argument refusal, got: ${firstDiagnostic(ref noArgument)}`;
  }

  // An inline operand has no name, so there is nowhere it could be written and
  // nothing for its own appliesTo to say.
  let inlineSites = checkSource(`kind base { appliesTo binding; }\nkind bad = base & { appliesTo binding; mustNotEscape scope; };${MAIN}`);
  let test theory: Case = t.asserts("an inline composition operand declaring appliesTo is refused") {
    theory.isSuccessful = diagnosticsMention(ref inlineSites, "declares appliesTo - a composition takes its sites from its named operands");
    theory.detail = `wanted the inline-appliesTo refusal, got: ${firstDiagnostic(ref inlineSites)}`;
  }

  let noCommonSite = checkSource(
    `kind onlyBinding { appliesTo binding; }\nkind onlyType { appliesTo type; }\nkind bad = onlyBinding & onlyType;${MAIN}`
  );
  let test theory: Case = t.asserts("a composition whose operands share no site is refused") {
    theory.isSuccessful = diagnosticsMention(ref noCommonSite, "share no application site");
    theory.detail = `wanted the no-common-site refusal, got: ${firstDiagnostic(ref noCommonSite)}`;
  }

  let notATrait = checkSource(`kind k { appliesTo binding; requires NotATrait; }${MAIN}`);
  let test theory: Case = t.asserts("requires naming something that is not a trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref notATrait, "requires \"NotATrait\", which is not a trait");
    theory.detail = `wanted the unknown-trait refusal, got: ${firstDiagnostic(ref notATrait)}`;
  }

  let noRequires = checkSource(`kind k { appliesTo binding; mustCall dispose beforeScopeEnd; }${MAIN}`);
  let test theory: Case = t.asserts("mustCall on a kind that requires no trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref noRequires, "must call \"dispose\", but requires no trait");
    theory.detail = `wanted the no-requires refusal, got: ${firstDiagnostic(ref noRequires)}`;
  }

  // The route a scope-end call takes is the required trait, so a method none of
  // them declares could never be called.
  let unknownMethod = checkSource(
    `trait Disposable { function dispose(ref self): void; }\nkind k { appliesTo binding; requires Disposable; mustCall close beforeScopeEnd; }${MAIN}`
  );
  let test theory: Case = t.asserts("mustCall naming a method no required trait declares is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknownMethod, "must call \"close\", which none of the traits it requires declares");
    theory.detail = `wanted the unknown-method refusal, got: ${firstDiagnostic(ref unknownMethod)}`;
  }
}

// ----- unions ---------------------------------------------------------------
//
// A union is the one nominal type whose fields OVERLAP, so the two things worth
// asserting here follow from that: pass A binds a SHELL that pass C fills in
// place, and the LAYOUT is the widest field rather than the sum of them.

const MIXED_UNION: string =
  "type Bytes4 { b0: uint8, b1: uint8, b2: uint8, b3: uint8 }\nunion Word { word: uint32, wide: uint64, bytes: Bytes4 }\n";

suite function passARegistersAUnionShellAndPassCFillsIt(): void {
  let prog = checkSource(`${MIXED_UNION}function main(): int32 { return 0; }`);

  let test theory: Case = t.asserts("the union's name is bound in the module namespace") {
    theory.isSuccessful = hasName(ref prog, "Word");
    theory.detail = `"Word" is not in the module namespace after pass A`;
  }

  const unionType = unionTypeIdOf(ref prog, "Word");
  let test theory: Case = t.asserts("the name binds to a Symbol.Union carrying a Type.Union") {
    theory.isSuccessful = unionType != TYPE_ERROR_ID && isUnionType(ref prog, unionType);
    theory.detail = `"Word" did not resolve through a Symbol.Union to a union type`;
  }

  // The FILL is what pass C adds, and reading a field back is the only way to
  // tell a filled shell from the empty one pass A interned.
  let test theory: Case = t.asserts("pass C filled the shell in place, so the fields are reachable") {
    theory.isSuccessful = lookupUnionField(ref prog, unionType, "bytes").found
      && lookupUnionField(ref prog, unionType, "wide").found
      && lookupUnionField(ref prog, unionType, "word").found;
    theory.detail = "one of the three declared fields is missing from the filled union";
  }

  let test theory: Case = t.asserts("a field the union does not declare is not found") {
    theory.isSuccessful = !lookupUnionField(ref prog, unionType, "nope").found;
    theory.detail = "lookupUnionField claimed to find a field that was never declared";
  }

  let test theory: Case = t.asserts("the decl name comes back for a diagnostic to use") {
    theory.isSuccessful = str.stringEq(unionDeclNameOf(ref prog, unionType), "Word");
    theory.detail = `unionDeclNameOf gave "${unionDeclNameOf(ref prog, unionType)}", wanted "Word"`;
  }
}

// The layout, which is the half a slice fixture can only see indirectly: it
// sees the CONSEQUENCE of a wrong size (a stomped neighbouring field), and only
// when the neighbour happens to be observable.
suite function aUnionIsAsWideAsItsWidestField(): void {
  let prog = checkSource(`${MIXED_UNION}function main(): int32 { return 0; }`);
  const unionType = unionTypeIdOf(ref prog, "Word");

  // uint32 (4), uint64 (8), Bytes4 (4). Eight, not sixteen: the fields overlap.
  let test theory: Case = t.asserts("the size is the largest field's, not the sum") {
    theory.isSuccessful = sizeOfType(ref prog, unionType) == 8;
    theory.detail = `sizeOfType gave ${sizeOfType(ref prog, unionType)}, wanted 8`;
  }
  let test theory: Case = t.asserts("the emitted byte buffer is that same size") {
    theory.isSuccessful = unionPayloadSize(ref prog, unionType) == 8;
    theory.detail = `unionPayloadSize gave ${unionPayloadSize(ref prog, unionType)}, wanted 8`;
  }
  let test theory: Case = t.asserts("the alignment is the widest field's") {
    theory.isSuccessful = alignOfType(ref prog, unionType) == 8;
    theory.detail = `alignOfType gave ${alignOfType(ref prog, unionType)}, wanted 8`;
  }

  // A union of nothing but narrow fields is narrow and aligns to one byte, so
  // the answers above are being measured rather than defaulted to a pointer.
  let narrow = checkSource(
    "union Flags { lo: uint8, hi: int8 }\nfunction main(): int32 { return 0; }"
  );
  const narrowType = unionTypeIdOf(ref narrow, "Flags");
  let test theory: Case = t.asserts("a union of bytes is one byte wide and one-byte aligned") {
    theory.isSuccessful = sizeOfType(ref narrow, narrowType) == 1
      && alignOfType(ref narrow, narrowType) == 1;
    theory.detail = `a two-uint8 union measured ${sizeOfType(ref narrow, narrowType)} bytes at align ${alignOfType(ref narrow, narrowType)}`;
  }
}

suite function unionsRefuseTheShapesTheyCannotCarry(): void {
  // A literal names exactly one field. Two would be two values written over
  // each other, and which one survived would depend on emission order.
  let two = checkSource(
    `${MIXED_UNION}function main(): int32 { let w: Word = { word: 1, wide: 2 }; return 0; }`
  );
  let test theory: Case = t.asserts("a two-field union literal is refused") {
    theory.isSuccessful = diagnosticsMention(ref two, "initializes exactly one field");
    theory.detail = `wanted the one-field refusal, got: ${firstDiagnostic(ref two)}`;
  }

  let none = checkSource(
    `${MIXED_UNION}function main(): int32 { let w: Word = { }; return 0; }`
  );
  let test theory: Case = t.asserts("an empty union literal is refused too") {
    theory.isSuccessful = diagnosticsMention(ref none, "initializes exactly one field");
    theory.detail = `wanted the one-field refusal, got: ${firstDiagnostic(ref none)}`;
  }

  let unknown = checkSource(
    `${MIXED_UNION}function main(): int32 { let w: Word = { nope: 1 }; return 0; }`
  );
  let test theory: Case = t.asserts("a literal naming an undeclared field says which union") {
    theory.isSuccessful = diagnosticsMention(ref unknown, `union "Word" has no field "nope"`);
    theory.detail = `wanted the unknown-field refusal, got: ${firstDiagnostic(ref unknown)}`;
  }

  let readMissing = checkSource(
    `${MIXED_UNION}function main(): int32 { let w: Word = { word: 1 }; return int32(w.nope); }`
  );
  let test theory: Case = t.asserts("reading an undeclared field says which union") {
    theory.isSuccessful = diagnosticsMention(ref readMissing, `union "Word" has no field "nope"`);
    theory.detail = `wanted the unknown-field refusal, got: ${firstDiagnostic(ref readMissing)}`;
  }

  // Three things a union may not carry, all refused by the PARSER so they never
  // reach a pass that would have to invent an answer for them.
  let generic = checkSource("union Box<T> { a: T }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("a generic union is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref generic, "generic unions are not supported");
    theory.detail = `wanted the generic refusal, got: ${firstDiagnostic(ref generic)}`;
  }

  let empty = checkSource("union Nothing { }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("a union with no fields is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref empty, "must declare at least one field");
    theory.detail = `wanted the empty-union refusal, got: ${firstDiagnostic(ref empty)}`;
  }

  let method = checkSource(
    "union Word { word: uint32, function get(ref self): uint32 { return self.word; } }\nfunction main(): int32 { return 0; }"
  );
  let test theory: Case = t.asserts("a method on a union is refused by name") {
    theory.isSuccessful = diagnosticsMention(ref method, "cannot declare methods");
    theory.detail = `wanted the method refusal, got: ${firstDiagnostic(ref method)}`;
  }
}

// The TypeId a union NAME binds to, or TYPE_ERROR_ID when it binds to anything
// else. It checks the SYMBOL kind rather than only the type, because "pass A
// bound a Symbol.Union" is half of what the shell test asserts.
function unionTypeIdOf(ref prog: Program, name: string): TypeId {
  if (prog.modules.len == 0) {
    return TYPE_ERROR_ID;
  }
  let tm = vec.vecGet(ref prog.modules, 0);
  switch (map.mapGet(ref tm.names, name)) {
    case Option.None: { return TYPE_ERROR_ID; }
    case Option.Some { value: symId }: {
      switch (symbolAt(ref prog, symId)) {
        case Symbol.Union { typeId: t }: { return t; }
        default: { return TYPE_ERROR_ID; }
      }
    }
  }
}

// ----- traits: the promise an `implements` clause makes ----------------------
//
// Every rule here is about the shape of a method rather than about a call. They
// live together because they are checked together, at the two moments a method
// table is built: `collectMethods` for a type's own methods and
// `checkTraitsSatisfied` for the promise the `implements` clause made.

suite function traitMethodShapesThatCannotBeImplementedAreRefused(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const DISPOSABLE: string = "trait Disposable { function dispose(ref self): void; }\n";

  // The positive control, and the reason it comes first: every rule below is a
  // refusal, so a check that is merely too eager would pass all of them.
  let legal = checkSource(
    `${DISPOSABLE}type T implements Disposable { fd: int32, function dispose(ref self): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("a type whose method matches the trait's signature checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `a well-formed impl reported: ${firstDiagnostic(ref legal)}`;
  }

  // Two bodies under one name mangle to one symbol, so the second has nowhere
  // to be emitted and no call site could say which it meant.
  let twice = checkSource(
    `${DISPOSABLE}type T implements Disposable { fd: int32, function dispose(ref self): void { } function dispose(ref self): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("a method name declared twice in one type body is refused") {
    theory.isSuccessful = diagnosticsMention(ref twice, "declares method \"dispose\" twice");
    theory.detail = `wanted the duplicate-method refusal, got: ${firstDiagnostic(ref twice)}`;
  }

  // A by-value receiver is a COPY, so every write the body makes lands on the
  // copy and is thrown away at the closing brace.
  let sigByValue = checkSource(
    `trait Disposable { function dispose(self): void; }\ntype T implements Disposable { fd: int32, function dispose(ref self): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("a trait signature taking self by value is refused") {
    theory.isSuccessful = diagnosticsMention(ref sigByValue, "takes \"self\" by value");
    theory.detail = `wanted the by-value-receiver refusal, got: ${firstDiagnostic(ref sigByValue)}`;
  }

  let implByValue = checkSource(
    `${DISPOSABLE}type T implements Disposable { fd: int32, function dispose(self): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("an impl method taking self by value is refused") {
    theory.isSuccessful = diagnosticsMention(ref implByValue, "takes \"self\" by value");
    theory.detail = `wanted the by-value-receiver refusal, got: ${firstDiagnostic(ref implByValue)}`;
  }

  let noReceiver = checkSource(
    `trait Disposable { function dispose(): void; }${MAIN}`
  );
  let test theory: Case = t.asserts("a method declaring no receiver at all is refused") {
    theory.isSuccessful = diagnosticsMention(ref noReceiver, "declares no receiver");
    theory.detail = `wanted the missing-receiver refusal, got: ${firstDiagnostic(ref noReceiver)}`;
  }

  // The three halves of signature equality, one assertion each. The trait's
  // side has already had its type arguments substituted, so the comparison is
  // between two concrete signatures.
  let extraParam = checkSource(
    `${DISPOSABLE}type T implements Disposable { fd: int32, function dispose(ref self, extra: int32): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("an impl taking more parameters than the trait declares is refused") {
    theory.isSuccessful = diagnosticsMention(ref extraParam, "parameter(s) after the receiver");
    theory.detail = `wanted the parameter-count refusal, got: ${firstDiagnostic(ref extraParam)}`;
  }

  let wrongParam = checkSource(
    `trait Writer { function write(ref self, n: int32): void; }\ntype T implements Writer { fd: int32, function write(ref self, n: string): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("an impl whose parameter type differs from the trait's is refused") {
    theory.isSuccessful = diagnosticsMention(ref wrongParam, "parameter 1 of \"T.write\"");
    theory.detail = `wanted the parameter-type refusal, got: ${firstDiagnostic(ref wrongParam)}`;
  }

  let wrongReturn = checkSource(
    `${DISPOSABLE}type T implements Disposable { fd: int32, function dispose(ref self): int32 { return 0; } }${MAIN}`
  );
  let test theory: Case = t.asserts("an impl whose return type differs from the trait's is refused") {
    theory.isSuccessful = diagnosticsMention(ref wrongReturn, "returns int32, but \"Disposable.dispose\" declares void");
    theory.detail = `wanted the return-type refusal, got: ${firstDiagnostic(ref wrongReturn)}`;
  }
}

// ----- clearance kinds -------------------------------------------------------
//
// A marker kind is a BOUND rather than an obligation: `conferred` names a
// capability a value cannot forge, `restrictive` names a hazard it cannot
// silently drop. Two suites, because the rules split cleanly: what a marker
// DECLARATION may say, and who may move a value across one.

suite function clearanceMarkerDeclarationsThatContradictThemselvesAreRefused(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";

  let legal = checkSource(
    `trait Cleansable { function cleanse(ref self): void; }\nkind cleared { appliesTo binding parameter return; conferred; requires Cleansable; appliedBy cleanse; }${MAIN}`
  );
  let test theory: Case = t.asserts("a conferred kind naming its trait and its authority checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `a well-formed marker kind reported: ${firstDiagnostic(ref legal)}`;
  }

  let bothPolarities = checkSource(`kind k { appliesTo binding; conferred; restrictive; }${MAIN}`);
  let test theory: Case = t.asserts("a kind declared both conferred and restrictive is refused") {
    theory.isSuccessful = diagnosticsMention(ref bothPolarities, "is both conferred and restrictive");
    theory.detail = `wanted the two-polarity refusal, got: ${firstDiagnostic(ref bothPolarities)}`;
  }

  // A marker emits nothing, so there is no value to call anything on.
  let markerMustCall = checkSource(
    `trait Disposable { function dispose(ref self): void; }\nkind k { appliesTo binding; requires Disposable; conferred; mustCall dispose beforeScopeEnd; }${MAIN}`
  );
  let test theory: Case = t.asserts("a marker kind that also states mustCall is refused") {
    theory.isSuccessful = diagnosticsMention(ref markerMustCall, "is a marker and states mustCall");
    theory.detail = `wanted the marker-obligation refusal, got: ${firstDiagnostic(ref markerMustCall)}`;
  }

  // The two transition clauses belong to opposite polarities: `appliedBy` mints
  // a capability, `clearedBy` sheds a hazard.
  let clearedOnConferred = checkSource(`kind k { appliesTo binding; conferred; clearedBy f; }${MAIN}`);
  let test theory: Case = t.asserts("clearedBy on a conferred kind is refused") {
    theory.isSuccessful = diagnosticsMention(ref clearedOnConferred, "clearedBy, which is the restrictive half");
    theory.detail = `wanted the wrong-polarity refusal, got: ${firstDiagnostic(ref clearedOnConferred)}`;
  }

  let appliedOnRestrictive = checkSource(`kind k { appliesTo binding; restrictive; appliedBy f; }${MAIN}`);
  let test theory: Case = t.asserts("appliedBy on a restrictive kind is refused") {
    theory.isSuccessful = diagnosticsMention(ref appliedOnRestrictive, "appliedBy, which is the conferred half");
    theory.detail = `wanted the wrong-polarity refusal, got: ${firstDiagnostic(ref appliedOnRestrictive)}`;
  }

  let noPolarity = checkSource(`kind k { appliesTo binding; appliedBy f; }${MAIN}`);
  let test theory: Case = t.asserts("a transition clause on a kind with no polarity is refused") {
    theory.isSuccessful = diagnosticsMention(ref noPolarity, "is neither conferred nor restrictive");
    theory.detail = `wanted the no-polarity refusal, got: ${firstDiagnostic(ref noPolarity)}`;
  }

  // The authorized method is reached THROUGH the required trait, so naming one
  // without the other promises an authority nothing could ever be.
  let noRequires = checkSource(`kind k { appliesTo binding; conferred; appliedBy f; }${MAIN}`);
  let test theory: Case = t.asserts("a transition clause on a kind that requires no trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref noRequires, "states appliedBy but requires no trait");
    theory.detail = `wanted the no-requires refusal, got: ${firstDiagnostic(ref noRequires)}`;
  }
}

suite function onlyTheAuthorizedTraitImplMayCrossAClearanceMarker(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const KINDS: string =
    "trait Cleansable<T> { function cleanse(ref self): T; }\nkind cleared { appliesTo binding parameter field return; conferred; requires Cleansable; appliedBy cleanse; }\nkind tainted { appliesTo binding parameter field return; restrictive; requires Cleansable; clearedBy cleanse; }\n";
  const SAFE: string =
    "type SafeText implements Cleansable<SafeText> { body: string, function cleanse(ref self): SafeText { return { body: \"safe\" }; } }\n";

  let legal = checkSource(`${KINDS}${SAFE}${MAIN}`);
  let test theory: Case = t.asserts("the authorized trait impl checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `the authorized impl reported: ${firstDiagnostic(ref legal)}`;
  }

  // A capability anyone can mint is not a capability.
  let fakeConfer = checkSource(
    `${KINDS}${SAFE}function fakeConfer(s: SafeText): cleared SafeText { return s; }${MAIN}`
  );
  let test theory: Case = t.asserts("a free function whose return confers a conferred kind is refused") {
    theory.isSuccessful = diagnosticsMention(ref fakeConfer, "would confer kind \"cleared\"");
    theory.detail = `wanted the free-function conferral refusal, got: ${firstDiagnostic(ref fakeConfer)}`;
  }

  // A hazard anyone can drop is not a hazard.
  let fakeLaunder = checkSource(
    `${KINDS}${SAFE}function fakeLaunder(t: tainted SafeText): SafeText { return { body: "fake" }; }${MAIN}`
  );
  let test theory: Case = t.asserts("a free function that takes a restrictive kind and returns without it is refused") {
    theory.isSuccessful = diagnosticsMention(ref fakeLaunder, "would strip kind \"tainted\"");
    theory.detail = `wanted the free-function strip refusal, got: ${firstDiagnostic(ref fakeLaunder)}`;
  }

  // PASSTHROUGH is not a transition: the hazard travels with the value.
  let passthrough = checkSource(
    `${KINDS}${SAFE}function forward(t: tainted SafeText): tainted SafeText { return t; }${MAIN}`
  );
  let test theory: Case = t.asserts("a function that returns the restrictive kind it took checks clean") {
    theory.isSuccessful = passthrough.diagnostics.len == 0;
    theory.detail = `a passthrough reported: ${firstDiagnostic(ref passthrough)}`;
  }

  // A restrictive kind naming no `clearedBy` has named no authority at all, so
  // there is no impl a shed could be moved into.
  let noAuthority = checkSource(
    `kind bare { appliesTo parameter return; restrictive; }\nfunction drop(x: bare int32): void { }${MAIN}`
  );
  let test theory: Case = t.asserts("stripping a restrictive kind that names no clearedBy is refused") {
    theory.isSuccessful = diagnosticsMention(ref noAuthority, "which names no clearedBy");
    theory.detail = `wanted the no-authority refusal, got: ${firstDiagnostic(ref noAuthority)}`;
  }

  // The gate is STRUCTURAL: a method only counts when its type implements the
  // trait the kind requires.
  let wrongType = checkSource(
    `${KINDS}${SAFE}trait Faker { function scrub(ref self, n: tainted int32): void; }\ntype Plain implements Faker { count: int32, function scrub(ref self, n: tainted int32): void { } }${MAIN}`
  );
  let test theory: Case = t.asserts("a method on a type that does not implement the required trait is refused") {
    theory.isSuccessful = diagnosticsMention(ref wrongType, "does not implement \"Cleansable\"");
    theory.detail = `wanted the missing-trait refusal, got: ${firstDiagnostic(ref wrongType)}`;
  }
}

// ----- clearance at the USE sites --------------------------------------------
//
// The suites above are about DECLARATIONS - what a marker kind may say, and who
// is authorized to move a value across one. This one is about the places a
// value actually moves: a binding initializer and a call argument, where the
// two bounds are compared. See typecheck/markers.yoop.

suite function aValueMustSatisfyTheMarkerBoundsOfEverySlotItFlowsInto(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const KINDS: string =
    "trait Cleansable<T> { function cleanse(ref self): T; }\nkind cleared { appliesTo binding parameter field return; conferred; requires Cleansable; appliedBy cleanse; }\nkind tainted { appliesTo binding parameter field return; restrictive; requires Cleansable; clearedBy cleanse; }\n";
  const SAFE: string =
    "type SafeText implements Cleansable<SafeText> { body: string, function cleanse(ref self): SafeText { return { body: \"safe\" }; } }\n";
  const PLAIN: string = "function plain(): SafeText { return { body: \"p\" }; }\n";
  const SINK: string = "function sink(v: cleared SafeText): void { }\n";
  const SRC: string = "function src(): tainted SafeText { return { body: \"d\" }; }\n";

  // A CONFERRED kind cannot be forged by annotating the binding. The value on
  // the right came out of a signature that declares nothing.
  let forgedBinding = checkSource(
    `${KINDS}${SAFE}${PLAIN}function main(): int32 { let c: cleared SafeText = plain(); return 0; }`
  );
  let test theory: Case = t.asserts("annotating a binding with a conferred kind its initializer lacks is refused") {
    theory.isSuccessful = diagnosticsMention(ref forgedBinding, "binding \"c\" requires kind \"cleared\"");
    theory.detail = `wanted the forged-binding refusal, got: ${firstDiagnostic(ref forgedBinding)}`;
  }

  // The launder BOUNDARY is a trait-method call, whose markers this pass does
  // not model - so it reads as unknown and every bound accepts it. The
  // permissive direction, deliberately: see the header of markers.yoop.
  let laundered = checkSource(
    `${KINDS}${SAFE}function main(): int32 { let s: SafeText = { body: "x" }; let c: cleared SafeText = Cleansable.cleanse(ref s); return 0; }`
  );
  let test theory: Case = t.asserts("a value from the authorized launder reaches a conferred binding") {
    theory.isSuccessful = laundered.diagnostics.len == 0;
    theory.detail = `laundering into a conferred binding reported: ${firstDiagnostic(ref laundered)}`;
  }

  // The SINK half of the same rule, and the one that matters most: a gate
  // failing open looks exactly like a gate that works.
  let forgedArg = checkSource(
    `${KINDS}${SAFE}${SINK}function main(): int32 { let raw: SafeText = { body: "x" }; sink(raw); return 0; }`
  );
  let test theory: Case = t.asserts("passing an unmarked value into a conferred parameter is refused") {
    theory.isSuccessful = diagnosticsMention(ref forgedArg, "argument 1 of \"sink\" requires kind \"cleared\"");
    theory.detail = `wanted the unlaundered-sink refusal, got: ${firstDiagnostic(ref forgedArg)}`;
  }

  // A RESTRICTIVE kind runs the other way: the value carries a hazard the slot
  // says nothing about, so the slot is what refuses.
  let leaked = checkSource(
    `${KINDS}${SAFE}${SRC}function plainSink(v: SafeText): void { }\nfunction main(): int32 { let d: tainted SafeText = src(); plainSink(d); return 0; }`
  );
  let test theory: Case = t.asserts("passing a restrictive value into a plain parameter is refused") {
    theory.isSuccessful = diagnosticsMention(ref leaked, "argument 1 of \"plainSink\" does not accept kind \"tainted\"");
    theory.detail = `wanted the restrictive-leak refusal, got: ${firstDiagnostic(ref leaked)}`;
  }

  // The sink PASSES THE HAZARD ON rather than shedding it, which is what keeps
  // it out of the decl-authority rule and leaves only the flow under test.
  let kept = checkSource(
    `${KINDS}${SAFE}${SRC}function taintSink(v: tainted SafeText): tainted SafeText { return v; }\nfunction main(): int32 { let d: tainted SafeText = src(); let e: tainted SafeText = taintSink(d); return 0; }`
  );
  let test theory: Case = t.asserts("a restrictive value reaching a slot that names the kind checks clean") {
    theory.isSuccessful = kept.diagnostics.len == 0;
    theory.detail = `a legal restrictive flow reported: ${firstDiagnostic(ref kept)}`;
  }

  // A conferred value flows into a PLAIN slot happily - the marker constrains
  // sinks that name it and nothing else. Getting this backwards would refuse
  // every `printf` of an owned string.
  let widened = checkSource(
    `${KINDS}${SAFE}${SINK}function widen(v: SafeText): void { }\nfunction main(): int32 { let s: SafeText = { body: "x" }; let c: cleared SafeText = Cleansable.cleanse(ref s); widen(c); return 0; }`
  );
  let test theory: Case = t.asserts("a conferred value flows into a plain slot unchanged") {
    theory.isSuccessful = widened.diagnostics.len == 0;
    theory.detail = `widening a conferred value reported: ${firstDiagnostic(ref widened)}`;
  }

  // A binding with NO annotation INHERITS what its initializer carried, so the
  // marker survives a `let` that did not write it down.
  let inherited = checkSource(
    `${KINDS}${SAFE}${SINK}${PLAIN}function main(): int32 { let raw = plain(); sink(raw); return 0; }`
  );
  let test theory: Case = t.asserts("an unannotated binding carries its initializer's markers") {
    theory.isSuccessful = diagnosticsMention(ref inherited, "argument 1 of \"sink\" requires kind \"cleared\"");
    theory.detail = `wanted the inherited-marker refusal, got: ${firstDiagnostic(ref inherited)}`;
  }
}

// The other thing the expression markers make possible: a conferred kind that
// names NO authority at all. Nothing may confer it, so the only legal route to
// it is PASSTHROUGH - and establishing that needs every `return`'s value, which
// is a body walk rather than anything a signature can answer. std's `owned` is
// exactly this kind. See the passthrough section of typecheck/markers.yoop.

suite function aConferredKindWithNoAuthorityIsReachableOnlyByPassthrough(): void {
  const OWN: string = "kind own { appliesTo binding parameter return; conferred; }\n";

  let forged = checkSource(
    `${OWN}function fake(): own string { return "x"; }\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("returning a literal as a conferred kind nothing may confer is refused") {
    theory.isSuccessful = diagnosticsMention(ref forged, "\"fake\" returns kind \"own\"");
    theory.detail = `wanted the unauthorized-conferral refusal, got: ${firstDiagnostic(ref forged)}`;
  }

  let passthrough = checkSource(
    `${OWN}function fwd(s: own string): own string { return s; }\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("forwarding a value that already carries the kind checks clean") {
    theory.isSuccessful = passthrough.diagnostics.len == 0;
    theory.detail = `a conferred passthrough reported: ${firstDiagnostic(ref passthrough)}`;
  }

  // A local carries it too, as long as its own annotation says so.
  let viaLocal = checkSource(
    `${OWN}function fwd(s: own string): own string { let out: own string = s; return out; }\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("passthrough through a local that keeps the annotation checks clean") {
    theory.isSuccessful = viaLocal.diagnostics.len == 0;
    theory.detail = `passthrough through a local reported: ${firstDiagnostic(ref viaLocal)}`;
  }

  // EVERY return, not any: laundering on one path and forging on the other is
  // still forging.
  let mixed = checkSource(
    `${OWN}function sneaky(s: own string, f: bool): own string { if (f) { return s; } return "x"; }\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("a body that carries the kind on one path and forges on the other is refused") {
    theory.isSuccessful = diagnosticsMention(ref mixed, "\"sneaky\" returns kind \"own\"");
    theory.detail = `wanted the mixed-path refusal, got: ${firstDiagnostic(ref mixed)}`;
  }

  // A bodyless declaration is never subject to this: an `extern` has no return
  // to inspect, and the allocating intrinsic is precisely the thing that mints.
  let externMint = checkSource(
    `${OWN}extern "C" from "mint.h" { function mint(n: usize): own string; }\nfunction main(): int32 { return 0; }`
  );
  let test theory: Case = t.asserts("a bodyless extern returning the kind checks clean") {
    theory.isSuccessful = externMint.diagnostics.len == 0;
    theory.detail = `an extern minting the kind reported: ${firstDiagnostic(ref externMint)}`;
  }
}

// The THIRD escape route. kind_use.yoop owns the two that read the binding
// alone - a `return` of it, and an alias under an unbounded name. This one
// needs the CALLEE's parameter kinds, which is the same signature table the
// clearance use sites read.

suite function aScopeBoundBindingMayNotBePassedIntoAnUnboundedParameter(): void {
  const SCOPED: string =
    "trait Closer { function close(ref self): void; }\ntype Res implements Closer { id: int32, function close(ref self): void { } }\nkind scoped { appliesTo binding parameter; requires Closer; mustCall close beforeScopeEnd; mustNotEscape scope; }\n";

  let leaked = checkSource(
    `${SCOPED}function leak(h: ref Res): void { }\nfunction main(): int32 { scoped a: Res = { id: 1 }; leak(ref a); return 0; }`
  );
  let test theory: Case = t.asserts("passing a scope-bounded binding into an unbounded parameter is refused") {
    theory.isSuccessful = diagnosticsMention(ref leaked, "argument 1 of \"leak\" is bounded by the scope that declares it");
    theory.detail = `wanted the escape-by-argument refusal, got: ${firstDiagnostic(ref leaked)}`;
  }

  let kept = checkSource(
    `${SCOPED}function keep(scoped h: ref Res): void { }\nfunction main(): int32 { scoped a: Res = { id: 1 }; keep(ref a); return 0; }`
  );
  let test theory: Case = t.asserts("a parameter carrying the same bound accepts it") {
    theory.isSuccessful = kept.diagnostics.len == 0;
    theory.detail = `a bounded parameter reported: ${firstDiagnostic(ref kept)}`;
  }

  // An UNBOUNDED binding of the same type is free to go anywhere: the bound is
  // about the binding rather than about the type.
  let plainBinding = checkSource(
    `${SCOPED}function leak(h: ref Res): void { }\nfunction main(): int32 { let a: Res = { id: 1 }; leak(ref a); return 0; }`
  );
  let test theory: Case = t.asserts("the same type under a plain let is unbounded") {
    theory.isSuccessful = plainBinding.diagnostics.len == 0;
    theory.detail = `an unbounded binding reported: ${firstDiagnostic(ref plainBinding)}`;
  }
}

// ----- where a kind may be WRITTEN -------------------------------------------
//
// The other half of the kind rules: typecheck/kinds.yoop asks whether a kind
// DECLARATION says something coherent, and typecheck/kind_use.yoop asks whether
// a USE of one is somewhere the declaration allows. See that file's header for
// the four rules.

suite function aKindMayOnlyBeWrittenWhereItsDeclarationSaysItMay(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const PARAM_ONLY: string = "kind paramOnly { appliesTo parameter; }\n";
  const BINDING_ONLY: string = "kind bindingOnly { appliesTo binding; }\n";

  let legal = checkSource(
    `${PARAM_ONLY}function use(paramOnly n: int32): int32 { return n; }${MAIN}`
  );
  let test theory: Case = t.asserts("a kind written at a site it declares checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `a legal kind use reported: ${firstDiagnostic(ref legal)}`;
  }

  let onBinding = checkSource(
    `${PARAM_ONLY}function main(): int32 { paramOnly n: int32 = 1; return n; }`
  );
  let test theory: Case = t.asserts("a parameter-only kind on a binding is refused") {
    theory.isSuccessful = diagnosticsMention(ref onBinding, "does not apply to bindings");
    theory.detail = `wanted a binding-site refusal, got: ${firstDiagnostic(ref onBinding)}`;
  }

  let onParam = checkSource(
    `${BINDING_ONLY}function use(bindingOnly n: int32): int32 { return n; }${MAIN}`
  );
  let test theory: Case = t.asserts("a binding-only kind on a parameter is refused") {
    theory.isSuccessful = diagnosticsMention(ref onParam, "does not apply to parameters");
    theory.detail = `wanted a parameter-site refusal, got: ${firstDiagnostic(ref onParam)}`;
  }

  let onType = checkSource(`${BINDING_ONLY}type V bindingOnly { a: int32, }${MAIN}`);
  let test theory: Case = t.asserts("a binding-only kind in front of a type body is refused") {
    theory.isSuccessful = diagnosticsMention(ref onType, "does not apply to types");
    theory.detail = `wanted a type-site refusal, got: ${firstDiagnostic(ref onType)}`;
  }

  // The message names the declaration's own set, so the reader is told what to
  // change rather than only that something is wrong.
  let test theory: Case = t.asserts("the refusal spells the sites the declaration does name") {
    theory.isSuccessful = diagnosticsMention(ref onType, "it declares \"appliesTo binding\"");
    theory.detail = `wanted the declared site set quoted back, got: ${firstDiagnostic(ref onType)}`;
  }
}

suite function aTrailingBlockNeedsAKindThatOwnsOne(): void {
  const OWNER: string =
    "trait Disposable { function dispose(ref self): void; }\ntype H implements Disposable { fd: int32, function dispose(ref self): void { } }\n";

  let owns = checkSource(
    `${OWNER}kind owning { appliesTo binding; requires Disposable; ownsBlock; mustCall dispose beforeScopeEnd; }\nfunction main(): int32 { owning h: H = { fd: 1 } { return 0; } return 0; }`
  );
  let test theory: Case = t.asserts("a kind declaring ownsBlock may take a trailing block") {
    theory.isSuccessful = owns.diagnostics.len == 0;
    theory.detail = `a legal trailing block reported: ${firstDiagnostic(ref owns)}`;
  }

  // Without the clause nothing says the block is the binding's scope, so the
  // scope-end call has no brace to be placed at.
  let noClause = checkSource(
    `${OWNER}kind plain { appliesTo binding; requires Disposable; mustCall dispose beforeScopeEnd; }\nfunction main(): int32 { plain h: H = { fd: 1 } { return 0; } return 0; }`
  );
  let test theory: Case = t.asserts("a trailing block on a kind that does not own one is refused") {
    theory.isSuccessful = diagnosticsMention(ref noClause, "no kind on it declares ownsBlock");
    theory.detail = `wanted an ownsBlock refusal, got: ${firstDiagnostic(ref noClause)}`;
  }
}

// The same propagation rule reached through the field's TYPE rather than
// through a kind written in front of it. This is the far more common shape:
// nobody writes `disposable` on a `Vec` field, and the vector still has to be
// freed by somebody.
//
// The refcounted kind is DECLARED here rather than imported, because
// checkSource builds a single-module graph with no std - so `Program.refcountedKind`
// is empty unless the source under test fills it, and a test that assumed std
// would be asserting on a check that had silently switched itself off.
suite function aFieldsTypeCarriesItsKindIntoTheHolder(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const KIND: string =
    "trait Shared { function retain(ref self): void; }\nkind pooled { appliesTo binding parameter field; requires Shared; refcounted retain release; }\n";
  const HELD: string =
    "trait Disposable { function dispose(ref self): void; }\nkind held { appliesTo binding field; requires Disposable; mustCall dispose beforeScopeEnd; }\ntype R implements Disposable propagates<held> { fd: int32, function dispose(ref self): void { } }\n";

  // A task handle is the base case: a compiler type with no declaration to hang
  // a `propagates<>` on, so it carries the refcounted kind by being the storage
  // discipline that kind asked for.
  let taskUnheld = checkSource(`${KIND}type Job { work: Task<int32>, }${MAIN}`);
  let test theory: Case = t.asserts("a Task field in a type that propagates nothing is refused") {
    theory.isSuccessful = diagnosticsMention(ref taskUnheld, "carrying kind \"pooled\"");
    theory.detail = `wanted a pooled propagation refusal, got: ${firstDiagnostic(ref taskUnheld)}`;
  }

  let taskHeld = checkSource(`${KIND}type Job propagates<pooled> { work: Task<int32>, }${MAIN}`);
  let test theory: Case = t.asserts("a Task field in a type that propagates pooled checks clean") {
    theory.isSuccessful = taskHeld.diagnostics.len == 0;
    theory.detail = `a propagated Task field reported: ${firstDiagnostic(ref taskHeld)}`;
  }

  // Without a refcounted kind anywhere in the graph there is no name to report,
  // so the check stands down rather than inventing one. This is what makes the
  // std-less unit graph safe to run the rest of these in.
  let noKind = checkSource(`type Job { work: Task<int32>, }${MAIN}`);
  let test theory: Case = t.asserts("a Task field is accepted when the graph declares no refcounted kind") {
    theory.isSuccessful = noKind.diagnostics.len == 0;
    theory.detail = `wanted silence with no refcounted kind, got: ${firstDiagnostic(ref noKind)}`;
  }

  // The ordinary case, and the one the compiler's own source is full of: the
  // field's type propagates, so its holder has to.
  let ownedUnheld = checkSource(`${HELD}type W { r: R, }${MAIN}`);
  let test theory: Case = t.asserts("a field whose type propagates a kind the holder does not is refused") {
    theory.isSuccessful = diagnosticsMention(ref ownedUnheld, "which \"W\" does not propagate");
    theory.detail = `wanted a propagation refusal, got: ${firstDiagnostic(ref ownedUnheld)}`;
  }

  let ownedHeld = checkSource(`${HELD}type W propagates<held> { r: R, }${MAIN}`);
  let test theory: Case = t.asserts("a field whose type propagates a kind the holder also propagates checks clean") {
    theory.isSuccessful = ownedHeld.diagnostics.len == 0;
    theory.detail = `a propagated field type reported: ${firstDiagnostic(ref ownedHeld)}`;
  }

  // The chain is established one declaration at a time rather than by a walk,
  // so the holder of a holder has to say so too.
  let chain = checkSource(`${HELD}type W propagates<held> { r: R, }\ntype Outer { w: W, }${MAIN}`);
  let test theory: Case = t.asserts("propagation is transitive - the holder of a holder has to propagate too") {
    theory.isSuccessful = diagnosticsMention(ref chain, "which \"Outer\" does not propagate");
    theory.detail = `wanted a transitive refusal, got: ${firstDiagnostic(ref chain)}`;
  }

  // Pass A stamps the `propagates<>` word on the shell, so the field type does
  // not have to be declared first.
  let forward = checkSource(`${HELD}type Outer { r: R, }${MAIN}`);
  let test theory: Case = t.asserts("a field type declared after its holder is still read") {
    theory.isSuccessful = diagnosticsMention(ref forward, "which \"Outer\" does not propagate");
    theory.detail = `wanted a forward-reference refusal, got: ${firstDiagnostic(ref forward)}`;
  }

  // Both halves fire on one field otherwise, and one mistake is one
  // diagnostic.
  let written = checkSource(`${HELD}type W { held r: R, }${MAIN}`);
  let test theory: Case = t.asserts("a field that WRITES the kind its type carries is reported once") {
    theory.isSuccessful = written.diagnostics.len == 1;
    theory.detail = `wanted exactly one diagnostic, got ${written.diagnostics.len}: ${firstDiagnostic(ref written)}`;
  }

  // A variant CASE payload is deliberately outside the rule - the reference
  // accepts it and the corpus is written against that.
  let variantCase = checkSource(`${HELD}variant Slot { Held { r: R }, Empty }${MAIN}`);
  let test theory: Case = t.asserts("a variant case payload carrying a kind is accepted") {
    theory.isSuccessful = variantCase.diagnostics.len == 0;
    theory.detail = `a variant payload reported: ${firstDiagnostic(ref variantCase)}`;
  }
}

suite function aFieldsKindHasToBePropagatedByItsType(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";
  const KIND: string =
    "trait Disposable { function dispose(ref self): void; }\ntype H implements Disposable { fd: int32, function dispose(ref self): void { } }\nkind held { appliesTo binding field; requires Disposable; mustCall dispose beforeScopeEnd; }\n";

  let propagated = checkSource(`${KIND}type W propagates<held> { h: held H, }${MAIN}`);
  let test theory: Case = t.asserts("a field's kind that the type propagates checks clean") {
    theory.isSuccessful = propagated.diagnostics.len == 0;
    theory.detail = `a propagated field kind reported: ${firstDiagnostic(ref propagated)}`;
  }

  // The obligation has to have a holder. Without the clause the scope-end call
  // for that field is emitted by nobody, which is a leak that compiles.
  let unheld = checkSource(`${KIND}type W { h: held H, }${MAIN}`);
  let test theory: Case = t.asserts("a field carrying a kind its type does not propagate is refused") {
    theory.isSuccessful = diagnosticsMention(ref unheld, "which \"W\" does not propagate");
    theory.detail = `wanted a propagation refusal, got: ${firstDiagnostic(ref unheld)}`;
  }

  let unknown = checkSource(`type S propagates<bogus> { x: int32, }${MAIN}`);
  let test theory: Case = t.asserts("a propagates clause naming no declared kind is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "propagates \"bogus\", which no kind declares");
    theory.detail = `wanted an unknown-kind refusal, got: ${firstDiagnostic(ref unknown)}`;
  }
}

suite function aScopeBoundBindingMayNotLeaveItsScope(): void {
  const KIND: string =
    "trait Disposable { function dispose(ref self): void; }\ntype H implements Disposable { fd: int32, function dispose(ref self): void { } }\nkind scoped { appliesTo binding; requires Disposable; mustCall dispose beforeScopeEnd; mustNotEscape scope; }\n";
  const MAIN: string = "\nfunction main(): int32 { return 0; }";

  let stays = checkSource(
    `${KIND}function f(): int32 { scoped a: H = { fd: 1 }; return a.fd; }${MAIN}`
  );
  let test theory: Case = t.asserts("a bounded binding read inside its scope checks clean") {
    theory.isSuccessful = stays.diagnostics.len == 0;
    theory.detail = `a legal use of a bounded binding reported: ${firstDiagnostic(ref stays)}`;
  }

  let returned = checkSource(
    `${KIND}function f(): H { scoped a: H = { fd: 1 }; return a; }${MAIN}`
  );
  let test theory: Case = t.asserts("returning a scope-bounded binding is refused") {
    theory.isSuccessful = diagnosticsMention(ref returned, "cannot be returned out of one");
    theory.detail = `wanted an escape refusal, got: ${firstDiagnostic(ref returned)}`;
  }

  // The alias would outlive nothing the original did not, but it carries no
  // bound - so every later check on it, the return rule included, would pass.
  let aliased = checkSource(
    `${KIND}function f(): int32 { scoped a: H = { fd: 1 }; let b: H = a; return b.fd; }${MAIN}`
  );
  let test theory: Case = t.asserts("aliasing a bounded binding under an unbounded name is refused") {
    theory.isSuccessful = diagnosticsMention(ref aliased, "under a name that carries no such bound");
    theory.detail = `wanted an alias refusal, got: ${firstDiagnostic(ref aliased)}`;
  }

  let rebound = checkSource(
    `${KIND}function f(): int32 { scoped a: H = { fd: 1 }; scoped b: H = a; return b.fd; }${MAIN}`
  );
  let test theory: Case = t.asserts("an alias that carries the bound too checks clean") {
    theory.isSuccessful = rebound.diagnostics.len == 0;
    theory.detail = `a bounded alias reported: ${firstDiagnostic(ref rebound)}`;
  }
}

suite function aFunctionMayNotHandBackABorrow(): void {
  let refReturn = checkSource("function bad(): ref int32 { let x: int32 = 1; return ref x; }\nfunction main(): int32 { return 0; }");
  let test theory: Case = t.asserts("a function returning ref T is refused") {
    theory.isSuccessful = diagnosticsMention(ref refReturn, "returns a \"ref\"");
    theory.detail = `wanted a ref-return refusal, got: ${firstDiagnostic(ref refReturn)}`;
  }

  // An extern is exempt, and the difference is real: a C `ref FILE` is an
  // opaque pointer the library owns, with no yoop frame on either side.
  let externRef = checkSource(
    "extern \"C\" from \"stdio.h\" { type FILE; function fopen(path: string, mode: string): ref FILE; }\nfunction main(): int32 { return 0; }"
  );
  let test theory: Case = t.asserts("an extern returning ref T is still allowed") {
    theory.isSuccessful = externRef.diagnostics.len == 0;
    theory.detail = `an extern ref return reported: ${firstDiagnostic(ref externRef)}`;
  }
}

suite function aRefcountedKindNeedsSomethingToCount(): void {
  const TASKS: string =
    "kind task { appliesTo function; pausable; provides Task; }\nkind pooled { appliesTo binding; requires Shared; refcounted retain release; }\ntrait Shared { function retain(ref self): void; }\ntask work(n: int32): int32 { return n; }\n";

  let handle = checkSource(`${TASKS}function main(): int32 { pooled h = work(1); return wait h; }`);
  let test theory: Case = t.asserts("a refcounted kind on a real handle checks clean") {
    theory.isSuccessful = handle.diagnostics.len == 0;
    theory.detail = `a legal pooled handle reported: ${firstDiagnostic(ref handle)}`;
  }

  // There is nothing on an int32 to hold a count, so the binding promises a
  // release of something that was never retained.
  let scalar = checkSource(`${TASKS}function main(): int32 { pooled h = 7; return 0; }`);
  let test theory: Case = t.asserts("a refcounted kind on a non-handle initializer is refused") {
    theory.isSuccessful = diagnosticsMention(ref scalar, "there is nothing there to hold a count");
    theory.detail = `wanted a refcounted-binding refusal, got: ${firstDiagnostic(ref scalar)}`;
  }

  // A type that PROPAGATES the kind holds the handle in a field, so the release
  // is one per field rather than one on the binding.
  let propagating = checkSource(
    `${TASKS}type Job propagates<pooled> { w: Task<int32>, }\nfunction launch(): Job propagates<pooled> { pooled h = work(1); return { w: h }; }\nfunction main(): int32 { pooled j: Job = launch(); return 0; }`
  );
  let test theory: Case = t.asserts("a type propagating the kind may be bound with it") {
    theory.isSuccessful = propagating.diagnostics.len == 0;
    theory.detail = `a propagating handle type reported: ${firstDiagnostic(ref propagating)}`;
  }
}

suite function aKindClauseThisCompilerDoesNotKnowIsRefused(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";

  let unknown = checkSource(`kind k { appliesTo binding; restricts iteration { single; }; }${MAIN}`);
  let test theory: Case = t.asserts("a clause word outside the vocabulary is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknown, "which is not a kind clause this compiler knows");
    theory.detail = `wanted an unknown-clause refusal, got: ${firstDiagnostic(ref unknown)}`;
  }

  // A word this compiler records but acts on nowhere still belongs to the
  // language, so refusing it would turn a missing rule into a refused program.
  let deferred = checkSource(`kind k { appliesTo binding; mustNotShare; }${MAIN}`);
  let test theory: Case = t.asserts("a recorded-but-unenforced clause word is allowed") {
    theory.isSuccessful = deferred.diagnostics.len == 0;
    theory.detail = `a deferred clause word reported: ${firstDiagnostic(ref deferred)}`;
  }
}

suite function aLayoutBodyStatesAbiOrAlign(): void {
  const MAIN: string = "\nfunction main(): int32 { return 0; }";

  let legal = checkSource(`kind cLayout { appliesTo type; layout { abi "C"; }; }${MAIN}`);
  let test theory: Case = t.asserts("layout abi \"C\" checks clean") {
    theory.isSuccessful = legal.diagnostics.len == 0;
    theory.detail = `the one supported ABI reported: ${firstDiagnostic(ref legal)}`;
  }

  // A struct laid out to the wrong ABI is not a run-time diagnostic - it is a
  // garbled read across an FFI boundary.
  let otherAbi = checkSource(`kind weird { appliesTo type; layout { abi "Rust"; }; }${MAIN}`);
  let test theory: Case = t.asserts("a layout abi other than \"C\" is refused") {
    theory.isSuccessful = diagnosticsMention(ref otherAbi, "is the only ABI this compiler lays a type out for");
    theory.detail = `wanted an ABI refusal, got: ${firstDiagnostic(ref otherAbi)}`;
  }

  let unknownSub = checkSource(`kind packed { appliesTo type; layout { packing tight; }; }${MAIN}`);
  let test theory: Case = t.asserts("a layout sub-clause this compiler does not implement is refused") {
    theory.isSuccessful = diagnosticsMention(ref unknownSub, "layout sub-clause \"packing\"");
    theory.detail = `wanted a sub-clause refusal, got: ${firstDiagnostic(ref unknownSub)}`;
  }

  // Alignment is the one clause a composition cannot union: two alignments are
  // two different addresses for one value.
  let clash = checkSource(
    `kind a32 { appliesTo binding; layout { align 32; }; }\nkind a64 { appliesTo binding; layout { align 64; }; }\nkind bad = a32 & a64;${MAIN}`
  );
  let test theory: Case = t.asserts("a composition of two different alignments is refused") {
    theory.isSuccessful = diagnosticsMention(ref clash, "demand different alignments");
    theory.detail = `wanted an alignment contradiction, got: ${firstDiagnostic(ref clash)}`;
  }

  let agree = checkSource(
    `kind a32 { appliesTo binding; layout { align 32; }; }\nkind b32 { appliesTo binding; layout { align 32; }; }\nkind ok = a32 & b32;${MAIN}`
  );
  let test theory: Case = t.asserts("a composition of two matching alignments checks clean") {
    theory.isSuccessful = agree.diagnostics.len == 0;
    theory.detail = `matching alignments reported: ${firstDiagnostic(ref agree)}`;
  }
}

suite function aModulesMutableStateIsWrittenOnlyInsideIt(): void {
  let ownWrite = checkTwoModules(
    "export function unused(): int { return 0; }",
    "let counter: int = 0;\nfunction main(): int { counter = 99; return counter; }"
  );
  let test theory: Case = t.asserts("a module writes its own let") {
    theory.isSuccessful = ownWrite.diagnostics.len == 0;
    theory.detail = `a same-module write reported: ${firstDiagnostic(ref ownWrite)}`;
  }

  // The import makes the name VISIBLE, not writable: a write from outside is
  // invisible to every invariant the declaring module keeps about it.
  let crossWrite = checkTwoModules(
    "export let counter: int = 0;",
    "import { counter } from \"./lib.yoop\";\nfunction main(): int { counter = 99; return counter; }"
  );
  let test theory: Case = t.asserts("writing an imported module-level let is refused") {
    theory.isSuccessful = diagnosticsMention(ref crossWrite, "written only inside the module that declares it");
    theory.detail = `wanted a cross-module write refusal, got: ${firstDiagnostic(ref crossWrite)}`;
  }

  let crossRead = checkTwoModules(
    "export let counter: int = 7;",
    "import { counter } from \"./lib.yoop\";\nfunction main(): int { return counter; }"
  );
  let test theory: Case = t.asserts("reading an imported module-level let is still fine") {
    theory.isSuccessful = crossRead.diagnostics.len == 0;
    theory.detail = `a cross-module read reported: ${firstDiagnostic(ref crossRead)}`;
  }
}
