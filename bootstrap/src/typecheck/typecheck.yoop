module typecheck;

/*
  Author: Tom Karnau

  Layer 3. Takes the parsed, import-ordered module graph and produces the
  whole-program Program: interned types and symbols, per-module decoration, and
  accumulated diagnostics.

  Typechecking differs from lex and parse in its error channel. Those two fail
  fast and hand back one ParsingError; this layer never stops. Every problem it
  finds lands in Program.diagnostics so the user sees the whole picture in one
  compile.

  Passes, mirroring the JS reference but over the interned model:
    A - register decl shells (name -> SymbolId, shell Type) so cross-module and
        forward references resolve.                             [pass_a.yoop]
    B - wire imports: bind imported names into each module's `names` map.
                                                                [pass_b.yoop]
    C - fill the shells: struct fields, function signatures.  [pass_c.yoop]
    D - check bodies and decorate resolvedTypes.               [pass_d.yoop]

  C and D handle the subset the parser produces today and name what they do not
  handle.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ModuleGraph } from "../source_graph";

// The graph is BORROWED: the driver keeps it so codegen can read the ASTs after
// typecheck returns. Everything this layer produces is keyed by NodeId back into
// those ASTs (decision D2), never a copy of them.
export function typecheckProgram(ref graph: ModuleGraph): Program propagates<disposable> {
  let program = initProgram();

  // Modules are already topologically ordered, so a module's imports have their
  // shells (pass A) and their filled signatures (pass C) before it is reached -
  // which is what lets all four passes run in one walk per module rather than
  // four walks over the graph, and what makes pass B a lookup rather than a
  // second fixpoint.
  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    // Build the TypedModule as a LOCAL and push it once it is filled. A
    // TypedModule pulled back out of the Vec would be a copy, and the map
    // bookkeeping (len, and the arrays after a rehash) would be written to the
    // copy instead of to the entry in the Vec.
    let tm = initTypedModule(m.id);
    passARegisterShells(ref program, ref tm, m, i, i == graph.entryIndex);
    passBWireImports(ref program, ref tm, m);
    passCFillShells(ref program, ref tm, m, i);
    passDCheckBodies(ref program, ref tm, m);
    vec.vecPush(ref program.modules, tm);
    i += 1;
  }

  return program;
}
