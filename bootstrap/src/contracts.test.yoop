import.test;
import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import * as contracts from "./contracts.yoop";

suite function tokenPrecedenceTests(): void {
  let test theory: Case = t.asserts("Caret returns 37") {
    const got = contracts.getTokenPrecedence(contracts.TokenTags.CARET);
    theory.isSuccessful = got == 36;
    theory.detail = `getTokentPrecedence(TokenTags.CARET) gave ${got}, wanted 36`;
  }
}
