module ast;

// The AST arena itself: one owned Vec of nodes, one flat pool of child ids, and
// one string pool. A whole module's AST is a single value you can pass, dump,
// and diff against the JS reference.
//
// `childIds` is the variable-arity story. A node's own run of children is a
// (childStart, childCount) slice into this pool; any SECOND list a kind needs is
// reached through a named child slot pointing at a NODE_LIST node whose own
// slice holds it. That is what keeps ASTNode a fixed-size struct.

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { TokenTags } from "../lex";
import { SourceLocation } from "../diagnostics";

@derive(display)
export type AST propagates<disposable> {
  nodes: Vec<ASTNode>,
  childIds: Vec<NodeId>,
  strings: Vec<string>, // string pool: decoded string-literal text
  root: NodeId,
}

export function createASTNode(astNodeKind: ASTNodeKind, sourceLoc: SourceLocation): ASTNode {
  return {
    kind: astNodeKind,
    sourceLoc: sourceLoc,
    name: "",
    childStart: 0,
    childCount: 0,
    childA: 0,
    childB: 0,
    childC: 0,
    childD: 0,
    childE: 0,
    childF: 0,
    spanStart: 0,
    spanLen: 0,
    operator: TokenTags.NOTOKEN,
    strId: 0,
    intVal: 0,
    floatVal: 0.0,
    flagA: false,
  };
}

// A fresh, empty arena. NodeId 0 is reserved as the "none" sentinel: a 0 in any
// child slot means "absent", so we seed the arena with one dead node at index 0
// and real nodes begin at index 1. `root` is set by the parser once the PROGRAM
// node is pushed.
export function emptyArena(): AST propagates<disposable> {
  let nodes: Vec<ASTNode> = vec.vecNew(64);
  const sentinelLoc: SourceLocation = { pos: 0, line: 0, column: 0, length: 0 };
  vec.vecPush(ref nodes, createASTNode(ASTNodeKind.PROGRAM, sentinelLoc));
  let childIds: Vec<NodeId> = vec.vecNew(64);
  let strings: Vec<string> = vec.vecNew(16);
  return {
    nodes: nodes,
    childIds: childIds,
    strings: strings,
    root: 0,
  };
}

// The i'th child in a node's own childIds run. Callers are responsible for
// staying inside `node.childCount`.
export function childAt(ref ast: AST, node: ASTNode, i: usize): NodeId {
  return vec.vecGet(ref ast.childIds, node.childStart + i);
}

// The node a NodeId names. Reads better than the vecGet at every call site, and
// gives us one place to put a bounds assertion later.
export function nodeAt(ref ast: AST, id: NodeId): ASTNode {
  return vec.vecGet(ref ast.nodes, id);
}

// The DECL a top-level PROGRAM child names, looking through an `export` and
// through an ATTRIBUTE.
//
// `export function f() {}` parses as an EXPORT_DECL wrapping the FUNCTION_DECL
// (the shape the JS reference uses), so every pass that walks the top level -
// pass A, pass C, pass D, codegen - would otherwise repeat the same unwrap and
// one of them would eventually forget. Exportedness itself is a separate
// question, answered by `isExportDecl` at the one place that cares.
//
// An `@derive(display)` wrapper unwraps the same way and for the same reason.
// The two nest in one order only - the attribute is written ABOVE the `export`,
// so ATTRIBUTE wraps EXPORT_DECL wraps the decl - which is why this walks down
// rather than testing once.
export function declOf(ref ast: AST, id: NodeId): NodeId {
  let at = id;
  while (true) {
    const node = nodeAt(ref ast, at);
    if (node.kind == ASTNodeKind.EXPORT_DECL ||
        node.kind == ASTNodeKind.EXPORT_C_FUNCTION_DECL ||
        node.kind == ASTNodeKind.ATTRIBUTE) {
      at = node.childA;
      continue;
    }
    return at;
  }
}

// The ATTRIBUTE wrapping a top-level entry, by name, or "" when there is none.
//
// The twin of `declOf`, which walks past the wrapper to reach the decl. This
// one asks what the wrapper WAS, which is the question `@precompile` makes
// load-bearing: the same `const` means two different things depending on
// whether an attribute stands above it.
//
// One level only, and past an `export`, because that is the one nesting the
// parser produces: the attribute is written above the `export`, so ATTRIBUTE
// wraps EXPORT_DECL wraps the decl.
export function attributeNameOf(ref ast: AST, id: NodeId): string {
  const node = nodeAt(ref ast, id);
  if (node.kind == ASTNodeKind.ATTRIBUTE) {
    return node.name;
  }
  return "";
}

// ----- writing into a built arena -------------------------------------------
//
// The parser builds the arena through ParserState; these are for the one pass
// that writes into it AFTERWARDS. `@precompile` folds an initializer to a value
// and puts a LITERAL back in its place, so every layer below it - inlinability,
// const materialization, codegen - reads the answer the ordinary way and none
// of them learns that comptime exists.
//
// The alternative was a side table of folded values threaded through three
// layers, and a literal is what the fold produced anyway.

export function appendNode(ref ast: AST, node: ASTNode): NodeId {
  vec.vecPush(ref ast.nodes, node);
  return ast.nodes.len - 1;
}

// Overwrite a node in place. Used to REPOINT a decl at its folded initializer;
// nothing else in the compiler rewrites a node once it is built.
export function replaceNode(ref ast: AST, id: NodeId, node: ASTNode): void {
  vec.vecSet(ref ast.nodes, id, node);
}

// Point `node` at a run of children appended to the shared pool. The same
// contract the parser's splice has: the ids are collected FIRST, because a
// nested build appends to this pool too and a partial splice would interleave.
export function appendChildRun(ref ast: AST, ref node: ASTNode, ref ids: Vec<NodeId>): void {
  node.childStart = ast.childIds.len;
  node.childCount = ids.len;
  let i: usize = 0;
  while (i < ids.len) {
    vec.vecPush(ref ast.childIds, vec.vecGet(ref ids, i));
    i += 1;
  }
}

// A string into the arena's pool, returning the `strId` a literal node carries.
export function appendString(ref ast: AST, s: string): usize {
  vec.vecPush(ref ast.strings, s);
  return ast.strings.len - 1;
}

// A PROGRAM node's `intVal` is the module FLAG WORD. `import.unsafe;` and
// `import.test;` are module-level flags rather than imports - they bind no
// name, so the PROGRAM node is the only place they can be recorded - and
// `flagA` was already spoken for by the first of them. One bit each from here.
export const PROGRAM_FLAG_TEST: uint64 = 1;

// True when the file declared `import.test;`. A test module has no `main` of
// its own on purpose: `--test` collects its suites and generates one. See
// test_mode/.
export function isTestModuleProgram(ref ast: AST, root: NodeId): bool {
  return (nodeAt(ref ast, root).intVal & PROGRAM_FLAG_TEST) != 0;
}

// Whether a top-level child is exported, looking through an attribute - the
// `export` sits under the `@derive`, so a naive test on the outer node says no
// for every decorated declaration.
export function isExportDecl(ref ast: AST, id: NodeId): bool {
  return isExportKind(exportWrapperKindOf(ref ast, id));
}

// True when the wrapper is the `export "C"` one specifically. It is an export
// like any other AND its symbol keeps its bare spelling, so the two questions
// are asked separately.
export function isCExportDecl(ref ast: AST, id: NodeId): bool {
  return exportWrapperKindOf(ref ast, id) == ASTNodeKind.EXPORT_C_FUNCTION_DECL;
}

// The export wrapper's kind, looking through an attribute - the `export` sits
// under the `@derive`, so a naive test on the outer node says no for every
// decorated declaration.
function exportWrapperKindOf(ref ast: AST, id: NodeId): ASTNodeKind {
  const node = nodeAt(ref ast, id);
  if (node.kind == ASTNodeKind.ATTRIBUTE) {
    return nodeAt(ref ast, node.childA).kind;
  }
  return node.kind;
}

function isExportKind(k: ASTNodeKind): bool {
  return k == ASTNodeKind.EXPORT_DECL || k == ASTNodeKind.EXPORT_C_FUNCTION_DECL;
}
