module ast;

// What the fat node's reusable slots MEAN, per kind.
//
// ASTNode has four anonymous child slots and one anonymous flag (see node.yoop
// for why). These functions are the lookup table that turns `childB` back into
// `functionParamList` for a dump or an error message. They are documentation
// the compiler can execute - add a case here whenever a kind starts using a
// slot, or the dump will just say "undefined".

export function astNodeFlagAName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.INT_LITERAL: {
      return "negated";
    }
    case ASTNodeKind.PARAM: {
      return "isRef";
    }
    case ASTNodeKind.FOR_LOOP: {
      return "initDeclares";
    }
    case ASTNodeKind.SWITCH_ARM: {
      return "isDefault";
    }
    case ASTNodeKind.LITERAL_PATTERN: {
      return "negated";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildAName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.TYPE_DECL,
         ASTNodeKind.FUNCTION_DECL: {
      return "typeParams";
    }
    case ASTNodeKind.KIND_PREFIX: {
      return "argsList";
    }
    case ASTNodeKind.TYPE_ANNOTATION_REF_TYPE: {
      return "inner";
    }
    case ASTNodeKind.EXPORT_DECL: {
      return "exportedDecl";
    }
    case ASTNodeKind.UNARY_EXPRESSION,
         ASTNodeKind.REF_EXPRESSION: {
      return "operand";
    }
    case ASTNodeKind.INDEX_EXPRESSION,
         ASTNodeKind.FIELD_ACCESS: {
      return "base";
    }
    case ASTNodeKind.SWITCH_STATEMENT: {
      return "scrutinee";
    }
    case ASTNodeKind.SWITCH_ARM: {
      return "patternsList";
    }
    case ASTNodeKind.ARRAY_LITERAL: {
      return "elementsList";
    }
    // A NODE_LIST of STRUCT_LITERAL_FIELD, holding field VALUES in a
    // constructor and binding NAMES in a pattern. 0 when the case carries no
    // payload.
    case ASTNodeKind.VARIANT_CONSTRUCTOR,
         ASTNodeKind.VARIANT_PATTERN: {
      return "payloadFields";
    }
    case ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE: {
      return "elementType";
    }
    // `Vec<int>`: the NODE_LIST of argument annotations, 0 when the name is
    // used bare.
    case ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME: {
      return "typeArgsList";
    }
    case ASTNodeKind.PARAM,
         ASTNodeKind.CONST_DECL,
         ASTNodeKind.LET_DECL,
         ASTNodeKind.FIELD_DECL,
         ASTNodeKind.FOR_LOOP: {
      return "typeAnnotation";
    }
    case ASTNodeKind.BLOCK: {
      return "statementsList";
    }
    case ASTNodeKind.RETURN_STATEMENT: {
      return "returnExpression";
    }
    case ASTNodeKind.IF_STATEMENT,
         ASTNodeKind.WHILE_STATEMENT: {
      return "condition";
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return "leftNode";
    }
    case ASTNodeKind.ASSIGNMENT: {
      return "target";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildBName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.TYPE_DECL: {
      return "kindPrefix";
    }
    case ASTNodeKind.FUNCTION_DECL: {
      return "functionParamList";
    }
    case ASTNodeKind.CONST_DECL,
         ASTNodeKind.LET_DECL: {
      return "assignmentExpression";
    }
    // `ns.fn(args)`: the base the call was reached through, 0 for a plain
    // `fn(args)`. The member name is in `name` either way, so every unqualified
    // call path reads the same as it always did.
    //
    // A variant constructor and a variant pattern use the slot the same way,
    // for the same reason: the qualifier is a name the parser cannot resolve.
    case ASTNodeKind.CALL_EXPRESSION,
         ASTNodeKind.VARIANT_CONSTRUCTOR,
         ASTNodeKind.VARIANT_PATTERN: {
      return "qualifyingBase";
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return "rightNode";
    }
    case ASTNodeKind.ASSIGNMENT: {
      return "value";
    }
    case ASTNodeKind.INDEX_EXPRESSION: {
      return "index";
    }
    case ASTNodeKind.SWITCH_ARM: {
      return "armBlock";
    }
    case ASTNodeKind.FOR_LOOP: {
      return "initExpr";
    }
    case ASTNodeKind.IF_STATEMENT: {
      return "thenBlock";
    }
    case ASTNodeKind.WHILE_STATEMENT: {
      return "bodyBlock";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildCName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.FUNCTION_DECL: {
      return "returnTypeAnnotation";
    }
    case ASTNodeKind.TYPE_DECL: {
      return "aliasTypeAnnotation";
    }
    case ASTNodeKind.IF_STATEMENT: {
      return "elseBranch";
    }
    case ASTNodeKind.FOR_LOOP: {
      return "condition";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildDName(v: ASTNodeKind): string {
  switch(v) {
    case ASTNodeKind.FUNCTION_DECL,
         ASTNodeKind.METHOD_DECL: {
      return "functionBody";
    }
    case ASTNodeKind.TYPE_DECL: {
      return "implementsList";
    }
    case ASTNodeKind.FOR_LOOP: {
      return "stepExpr";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildEName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.FOR_LOOP: {
      return "bodyBlock";
    }
    default: {
      return "undefined";
    }
  }
}

// What a node's `strId` indexes in AST.strings, per kind. Unlike the child
// slots there is no "none" sentinel here - index 0 is a real pool entry - so a
// kind that uses `strId` must use it unconditionally.
export function astNodeStrIdName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.STRING_LITERAL: {
      return "decodedText";
    }
    case ASTNodeKind.IMPORT_DECL: {
      return "sourcePath";
    }
    // `name` carries the LOCAL name (what this module binds), because that is
    // what nearly every consumer wants; the export name is the one that needs
    // the pool. `import { a as b }` gives name = "b", exportName = "a", and a
    // plain `import { a }` interns "a" in both places.
    case ASTNodeKind.IMPORT_SPECIFIER: {
      return "exportName";
    }
    default: {
      return "undefined";
    }
  }
}

// What a node's OWN childStart/childCount run holds, per kind. Kinds absent
// here do not use their own run - their children hang off the named slots.
export function astNodeChildListName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.PROGRAM: {
      return "body";
    }
    // Fields AND methods, in one run - every consumer switches on the member's
    // kind anyway.
    case ASTNodeKind.TYPE_DECL: {
      return "members";
    }
    case ASTNodeKind.TRAIT_DECL: {
      return "methodSigs";
    }
    case ASTNodeKind.VARIANT_DECL: {
      return "cases";
    }
    // A payload-less case has an empty run rather than a missing one.
    case ASTNodeKind.VARIANT_CASE: {
      return "fields";
    }
    case ASTNodeKind.NODE_LIST: {
      return "items";
    }
    case ASTNodeKind.IMPORT_DECL: {
      // `name` on an IMPORT_DECL is the `* as ns` local name, empty when the
      // import has no namespace clause.
      return "specifiers";
    }
    case ASTNodeKind.SWITCH_STATEMENT: {
      return "arms";
    }
    default: {
      return "undefined";
    }
  }
}
