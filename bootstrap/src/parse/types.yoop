module parse;

// Type declarations and type annotations.

import { Result, Option } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, tagName, posToSourceLocation } from "../lex";
import { ParsingError } from "../diagnostics";

// The closing `>` of a type-parameter or type-argument list, splitting a `>>`
// in two when the lexer handed one over.
//
// `Box<Vec<int>>` ends in a single right-shift token. Consuming it here and
// remembering that one `>` is still owed is what lets the outer list close
// without the lexer needing to know anything about types.
export function consumeClosingGt(ref ps: ParserState): Result<usize, ParsingError> {
  if (ps.pendingGt) {
    ps.pendingGt = false;
    return Result.Ok { value: 0 };
  }
  const tag = ps.peek().tag;
  if (tag == TokenTags.GT) {
    ps.advance()?;
    return Result.Ok { value: 0 };
  }
  if (tag == TokenTags.RSHIFT) {
    ps.advance()?;
    ps.pendingGt = true;
    return Result.Ok { value: 0 };
  }
  return Result.Err { error: SelfLexing.createParsingError(
    ref ps,
    `expected '>', got ${tagName(tag)}`,
    peekLengthUsize(ref ps),
  )};
}

// `<T, U>` after a type name (generics, etc). Returns the NodeId of a NODE_LIST holding the
// TYPE_PARAM nodes, or 0 (the none sentinel) when there is no list.
export function parseTypeParamList(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (ps.peek().tag != TokenTags.LT) {
    return Result.Ok { value: 0 };
  }
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  ps.advance()?; // consume `<`

  if (ps.peek().tag == TokenTags.GT) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `empty type parameter list <> is not allowed`,
      peekLengthUsize(ref ps),
    )};
  }

  // Collect each TYPE_PARAM's NodeId in a scratch buffer, then splice the whole
  // run into the arena in one shot (see buildListNode).
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (true) {
    let tp = ps.buildSourcedNode(ASTNodeKind.TYPE_PARAM);
    tp.name = parseIdentAsName(ref ps)?;
    tp.childA = parseTypeParamBounds(ref ps)?; // bounds list-node (0 = none)
    ids.push(ps.pushNode(tp));
    // `<T implements Comparable<T>>` ends in a `>>` that the BOUND's own
    // argument list already consumed, leaving one `>` owed and the cursor past
    // this whole list. Same rule, same reason, as parseTypeArgList: while a `>`
    // is pending nothing may look at the real token stream, or a following
    // `(a: T, b: T)` reads its comma as another parameter separator.
    if (ps.pendingGt) {
      break;
    }
    if (ps.peek().tag != TokenTags.COMMA) {
      break;
    }
    ps.advance()?; // consume `,`
  }
  consumeClosingGt(ref ps)?;

  return Result.Ok { value: ps.buildListNode(ref ids, loc) };
}

// `implements Display` / `implements (Renderable, Named)` after a type
// parameter's name - the traits an argument must satisfy and the body may call
// through. Returns a NODE_LIST of type annotations, or 0 when there is none.
//
// The bare form takes exactly ONE trait, unlike the `implements` clause on a
// type decl, and that asymmetry is forced rather than chosen: a comma here
// separates PARAMETERS, so `<X implements A, Y>` is a bounded X beside an
// unbounded Y and not an X bounded by two traits. Parentheses are what say
// "these commas are mine" - which is the reference's rule, established by
// probing it.
function parseTypeParamBounds(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (ps.peek().tag != TokenTags.IMPLEMENTS) {
    return Result.Ok { value: 0 };
  }
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  ps.advance()?; // consume `implements`

  disposable ids: Vec<NodeId> = vec.vecNew(2);
  if (ps.peek().tag != TokenTags.LPAREN) {
    ids.push(parseTypeAnnotation(ref ps)?);
    return Result.Ok { value: ps.buildListNode(ref ids, loc) };
  }

  ps.advance()?; // consume `(`
  while (true) {
    ids.push(parseTypeAnnotation(ref ps)?);
    if (ps.peek().tag != TokenTags.COMMA) {
      break;
    }
    ps.advance()?; // consume `,`
  }
  ps.expect(TokenTags.RPAREN)?;
  return Result.Ok { value: ps.buildListNode(ref ids, loc) };
}

// The run of kind names before a type in an annotation, as a NODE_LIST of
// KIND_PREFIX nodes - or 0 when there is none, which is the common case.
//
// The rule is one token of lookahead: an IDENT followed by ANOTHER IDENT cannot
// be the type itself, so it is a prefix. That is the same ambiguity the type
// decl's own kind prefix resolves, and the same way.
function parseKindPrefixes(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (ps.peek().tag != TokenTags.IDENT) {
    return Result.Ok { value: 0 };
  }
  if (ps.peekAhead(1)?.tag != TokenTags.IDENT) {
    return Result.Ok { value: 0 };
  }

  // `Buf propagates<tracked>` is a TYPE followed by a clause, not a kind prefix
  // followed by a type - and both are two identifiers in a row. The clause
  // keywords are contextual, so telling them apart means reading the second
  // identifier's TEXT rather than its tag.
  if (peekAheadIsWord(ref ps, 1, PROPAGATES_KEYWORD)) {
    return Result.Ok { value: 0 };
  }

  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  disposable ids: Vec<NodeId> = vec.vecNew(2);
  while (
    ps.peek().tag == TokenTags.IDENT &&
    ps.peekAhead(1)?.tag == TokenTags.IDENT &&
    !peekAheadIsWord(ref ps, 1, PROPAGATES_KEYWORD)
  ) {
    let node = ps.buildSourcedNode(ASTNodeKind.KIND_PREFIX);
    node.name = parseIdentAsName(ref ps)?;
    ids.push(ps.pushNode(node));
  }
  return Result.Ok { value: ps.buildListNode(ref ids, loc) };
}

// `<int, string>` after a type name in an ANNOTATION: the arguments a generic
// is applied to. Returns a NODE_LIST of type annotations, or 0 when there is no
// list.
//
// The mirror of parseTypeParamList - that one reads the DECLARATION's `<T, U>`
// and produces names; this reads the USE's `<int, string>` and produces types.
function parseTypeArgList(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (ps.peek().tag != TokenTags.LT) {
    return Result.Ok { value: 0 };
  }
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  ps.advance()?; // consume `<`

  if (ps.peek().tag == TokenTags.GT) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `empty type argument list <> is not allowed`,
      peekLengthUsize(ref ps),
    )};
  }

  disposable ids: Vec<NodeId> = vec.vecNew(2);
  while (true) {
    ids.push(parseTypeAnnotation(ref ps)?);
    // A pending `>` CLOSES this list, so the real token stream must not be
    // consulted while one is owed. The element just parsed ended in a `>>` that
    // an inner list already consumed, which leaves the cursor sitting on
    // whatever follows the OUTER `>` - in `Box<Box<T>>, g: int` that is the
    // field separator, and peeking for a comma here reads it as another type
    // argument and swallows the next field.
    if (ps.pendingGt) {
      break;
    }
    if (ps.peek().tag != TokenTags.COMMA) {
      break;
    }
    ps.advance()?; // consume `,`
  }
  consumeClosingGt(ref ps)?;

  return Result.Ok { value: ps.buildListNode(ref ids, loc) };
}

export function parseTypeDecl(ref ps: ParserState): Result<NodeId, ParsingError> {
  ps.expect(TokenTags.TYPE)?; // don't care about the token
  let node = ps.buildSourcedNode(ASTNodeKind.TYPE_DECL);
  node.name = parseIdentAsName(ref ps)?;
  node.childA = parseTypeParamList(ref ps)?; // typeParams list-node (0 = none)

  // node.kindPrefix
  if (ps.peek().tag == TokenTags.IDENT) {
    let afterIdx: usize = 1;
    if (ps.peekAhead(1)?.tag == TokenTags.LPAREN) { // NOTE(tom): may be an incorrect to fail here
      const jRes = findMatchingRParen(ref ps, 1);
      switch (jRes) {
        case Option.None {}: {
          afterIdx = 0; // rparen not found, will fail next steps, that's not our problem here.
        }
        case Option.Some { value: j }: {
          afterIdx = j + 1;
        }
      }
    }
    if (afterIdx > 0) {
      // What may follow a kind prefix. `propagates` / `contains` are
      // contextual and lex as IDENT, so they are not listed by tag - an IDENT
      // here is already ambiguous with the prefix's own name and is resolved
      // by the LCURLY / EQ that eventually terminates the decl.
      const after = ps.peekAhead(afterIdx)?;
      if (
        after.tag == TokenTags.IMPLEMENTS ||
        after.tag == TokenTags.LCURLY ||
        after.tag == TokenTags.EQ
      ) {
        node.childB = consumeKindPrefix(ref ps)?;
      }
    }
  }
  // The clauses between the kind prefix and the body.
  node.childD = parseImplementsClause(ref ps)?;
  node.childF = parsePropagatesClause(ref ps)?;

  // Transparent alias: `type Name = <annotation>;`
  if (ps.peek().tag == TokenTags.EQ) {
    ps.advance()?;
    node.childC = parseTypeAnnotation(ref ps)?;
    ps.expect(TokenTags.SEMICOLON)?;
    return Result.Ok { value: ps.pushNode(node) };
  }

  // Struct body. The fields land in this node's OWN childIds run rather than
  // behind a NODE_LIST, because they are the TYPE_DECL's primary list - the
  // indirection is only for a kind's SECOND list (see arena.yoop).
  ps.expect(TokenTags.LCURLY)?;
  disposable fieldIds: Vec<NodeId> = vec.vecNew(4);
  while (untilClosing(ref ps, TokenTags.RCURLY)) {
    // Fields and METHODS share the run. Splitting them here would mean two
    // lists on a node that has one, and every later pass already switches on
    // the member's kind anyway.
    if (atStructMethod(ref ps)) {
      fieldIds.push(parseMethodDecl(ref ps, node.name, node.childA)?);
    } else {
      fieldIds.push(parseFieldDecl(ref ps)?);
    }
    // A trailing comma after the last field is allowed, so consume the
    // separator whenever there is one and let the loop condition decide.
    if (ps.peek().tag == TokenTags.COMMA) {
      ps.advance()?;
    }
  }
  ps.expect(TokenTags.RCURLY)?;

  spliceChildren(ref ps, ref node, ref fieldIds);

  return Result.Ok { value: ps.pushNode(node) };
}

// One `name: Type` inside a struct body, or inside a variant case's payload. A
// Is the member at the cursor a METHOD rather than a field?
//
// A field name may be a reserved word, `function` included - C-shaped code
// writes member names like that, and generated bindings would fail to parse on
// the first collision - so the keyword heads both members and cannot tell them
// apart on its own. The COLON does: a field is `function: T`, and a method is
// `function name(...)`, which can never show one there. Same rule as the
// reference, and a union body asks the same question.
export function atStructMethod(ref ps: ParserState): bool {
  if (atKindPrefixedMethod(ref ps, false)) {
    return true;
  }
  return ps.peek().tag == TokenTags.FUNCTION
    && !followingTokenIs(ref ps, TokenTags.COLON);
}

// `function` here is a METHOD and was dispatched by the caller before reaching
// this.
//
// The name may be a RESERVED WORD (`type: int32`). A field name is metadata - a
// keyword's grammar role does not reach a position where the next token is
// always a `:` - and a struct mirroring a C ABI has no say in its own spelling.
function parseFieldDecl(ref ps: ParserState): Result<NodeId, ParsingError> {
  let node = ps.buildSourcedNode(ASTNodeKind.FIELD_DECL);
  node.name = parseIdentOrKeywordAsName(ref ps)?;
  ps.expect(TokenTags.COLON)?;
  node.childA = parseTypeAnnotation(ref ps)?;

  return Result.Ok { value: ps.pushNode(node) };
}

// original js compiler had a custom shape for this, but we're going to fit it
// as a regular AST node
export function parseTypeAnnotation(ref ps: ParserState): Result<NodeId, ParsingError> {
  // TODO - clearance kind support like tainted uint8[], or cleared validated Foo
  // TODO - Function param types or wrapped type for attaching as an array
  // ref T
  let peekTag = ps.peek().tag;
  if (peekTag == TokenTags.REF) {
    ps.advance()?;
    let refNode = ps.buildSourcedNode(ASTNodeKind.TYPE_ANNOTATION_REF_TYPE);
    refNode.childA = parseTypeAnnotation(ref ps)?;
    return Result.Ok { value: ps.pushNode(refNode) };
  }
  // A `(` opens one of two things, and the token after it decides which:
  //
  //   ( )         ( ref x: T ...      ( name : T ...      a FUNCTION TYPE
  //   anything else                                       a parenthesized GROUP
  //
  // Parameters are REQUIRED to be named, which is what makes the fork decidable
  // at one token of lookahead - the unnamed form `(T) => R` would be
  // indistinguishable from a `(T)` group. The names are discarded; a parameter
  // list at the type level is purely positional.
  //
  // A group exists only to attach an array suffix. `(p: T) => R[]` binds the
  // `[]` to the RETURN type, because the return is parsed greedily, so
  // `((p: T) => R)[]` is the only way to spell an array of function pointers.
  if (peekTag == TokenTags.LPAREN) {
    if (atFunctionTypeParams(ref ps)) {
      return parseFunctionTypeAnnotation(ref ps);
    }
    ps.advance()?;
    let grouped = parseTypeAnnotation(ref ps)?;
    ps.expect(TokenTags.RPAREN)?;
    return parseArraySuffixes(ref ps, grouped);
  }

  // A KIND PREFIX: `owned string`, `cleared validated Foo`. Kinds are
  // contextual and lex as IDENT, so two IDENTs in a row is what identifies one
  // - the last is the type, everything before it is prefix.
  //
  // Recorded on the annotation rather than dropped. The bootstrap enforces no
  // kinds at all, so nothing reads it yet; keeping it means the limitation is
  // "not enforced" instead of "not parsed", and the day enforcement lands the
  // information is already where it needs to be.
  let typeNameNode = ps.buildSourcedNode(ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME);
  typeNameNode.childB = parseKindPrefixes(ref ps)?;
  let name = parseIdentAsName(ref ps)?;

  // `fs.DirIter` - a type reached through an imported NAMESPACE. A `.` here can
  // mean nothing else: annotation position has no field access and no method
  // call, so the first name is the namespace and the second is the type.
  //
  // The qualifier is interned rather than kept in a second `name` field, the
  // same way an import specifier keeps its export name. `flagA` is what says
  // there is one, because pool index 0 is a real string and so a `strId` of 0
  // cannot mean "absent".
  if (ps.peek().tag == TokenTags.DOT) {
    ps.advance()?; // consume `.`
    typeNameNode.flagA = true;
    typeNameNode.strId = internString(ref ps, name);
    name = parseIdentAsName(ref ps)?;
  }
  typeNameNode.name = name;
  // `Vec<int>`, `Result<int, string>` - the ARGUMENTS of a generic
  // application. Unambiguous here in a way it is not in an expression: `a < b`
  // cannot appear in annotation position, so a `<` after a type name is always
  // a type-argument list.
  typeNameNode.childA = parseTypeArgList(ref ps)?;
  let inner = ps.pushNode(typeNameNode);

  return parseArraySuffixes(ref ps, inner);
}

// Trailing `[]`, repeatable: `int[][]` is an array of arrays. Left to right, so
// each `[]` wraps what came before. Shared by the plain form and by a
// parenthesized group, which exists precisely to reach this.
function parseArraySuffixes(ref ps: ParserState, inner: NodeId): Result<NodeId, ParsingError> {
  let node = inner;
  while (ps.peek().tag == TokenTags.LBRACKET) {
    ps.advance()?;
    ps.expect(TokenTags.RBRACKET)?;
    let arrayNode = ps.buildSourcedNode(ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE);
    arrayNode.childA = node;
    node = ps.pushNode(arrayNode);
  }
  return Result.Ok { value: node };
}

// True when the `(` under the cursor opens a function type's parameter list
// rather than a parenthesized type group. See parseTypeAnnotation for the rule.
function atFunctionTypeParams(ref ps: ParserState): bool {
  switch (ps.peekAhead(1)) {
    case Result.Err { error: e }: { return false; }
    case Result.Ok { value: after }: {
      if (after.tag == TokenTags.RPAREN || after.tag == TokenTags.REF) {
        return true;
      }
      if (after.tag != TokenTags.IDENT) {
        return false;
      }
      switch (ps.peekAhead(2)) {
        case Result.Err { error: e2 }: { return false; }
        case Result.Ok { value: colon }: { return colon.tag == TokenTags.COLON; }
      }
    }
  }
}

// `(k: K) => uint64` - a function VALUE's type.
//
//   childA   the parameter list-node, of PARAM nodes
//   childB   the return annotation
//
// The same PARAM nodes a function declaration uses, so pass C resolves them
// with the same code. Their NAMES are parsed and then ignored by everything
// downstream: two function types match on parameter types and return type.
function parseFunctionTypeAnnotation(ref ps: ParserState): Result<NodeId, ParsingError> {
  let node = ps.buildSourcedNode(ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE);
  ps.expect(TokenTags.LPAREN)?;
  const loc = posToSourceLocation(ps.src, ps.pos, 1);

  disposable ids: Vec<NodeId> = vec.vecNew(2);
  while (untilClosing(ref ps, TokenTags.RPAREN)) {
    ids.push(parseFunctionParam(ref ps)?);
    if (ps.peek().tag == TokenTags.COMMA) {
      ps.advance()?;
    }
  }
  ps.expect(TokenTags.RPAREN)?;
  node.childA = ps.buildListNode(ref ids, loc);

  ps.expect(TokenTags.FATARROW)?;
  node.childB = parseTypeAnnotation(ref ps)?;
  return Result.Ok { value: ps.pushNode(node) };
}
