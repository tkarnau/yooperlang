module parse;

// Statements and blocks - the dispatch point from a leading token to the parse
// function that owns that statement form.

import { Result } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, posToSourceLocation } from "../lex";

function parseReturnStatement(ref ps: ParserState): ParsingResult {
  SelfLexing.expect(ref ps, TokenTags.RETURN)?;
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.RETURN_STATEMENT);
  if (SelfLexing.peek(ref ps).tag != TokenTags.SEMICOLON) {
    node.childA = parseExpression(ref ps, 0)?;
  }
  SelfLexing.expect(ref ps, TokenTags.SEMICOLON)?;
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node ) };
}

export function parseStatement(ref ps: ParserState): ParsingResult {
  const peekTag = SelfLexing.peek(ref ps).tag;
  switch (peekTag) {
    case TokenTags.LET, TokenTags.CONST: {
      return Result.Ok { value: parseVarDecl(ref ps)? };
    }
    case TokenTags.RETURN: {
      return Result.Ok { value: parseReturnStatement(ref ps)? };
    }
    default: {
      return Result.Ok { value: parseExpressionStatement(ref ps)? };
    }
  }
}

export function parseBlock(ref ps: ParserState): ParsingResult {
  // shape =>> { statements[] }
  SelfLexing.expect(ref ps, TokenTags.LCURLY)?;
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.BLOCK);

  // parse rest of statements
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (SelfLexing.peek(ref ps).tag != TokenTags.RCURLY && SelfLexing.peek(ref ps).tag != TokenTags.EOF) {
    // eat statements and add to body...
    vec.vecPush(ref ids, parseStatement(ref ps)?);
  }
  // child start nodeId...
  // child count
  node.childA = SelfLexing.buildListNode(ref ps, ref ids, loc);
  SelfLexing.expect(ref ps, TokenTags.RCURLY)?;

  // push node into ps...
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}