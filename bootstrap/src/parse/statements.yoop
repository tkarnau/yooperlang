module parse;

// Statements and blocks - the dispatch point from a leading token to the parse
// function that owns that statement form.

import { Result } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, posToSourceLocation } from "../lex";
import * as str from "std/core/strings.yoop";

function parseReturnStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.RETURN)?;
  let node = ps.buildSourcedNode(ASTNodeKind.RETURN_STATEMENT);
  if (ps.peek().tag != TokenTags.SEMICOLON) {
    node.childA = parseExpression(ref ps, 0)?;
  }
  ps.expect(TokenTags.SEMICOLON)?;
  return Result.Ok { value: ps.pushNode(node ) };
}

// `_ = expr;` - evaluate for its EFFECTS and throw the value away.
//
//   childA = the expression
//
// It is not the same statement as a bare `expr;`, even though both discard.
// `_ =` says the discard was deliberate, which is what makes it the spelling
// for a call whose result a reader would otherwise expect to see used. The two
// are checked and emitted identically from here on, so every pass past the
// parser handles the pair together.
function parseDiscardStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.DISCARD)?;
  let node = ps.buildSourcedNode(ASTNodeKind.DISCARD_STATEMENT);
  ps.expect(TokenTags.EQ)?;
  node.childA = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.SEMICOLON)?;
  return Result.Ok { value: ps.pushNode(node) };
}

export function parseStatement(ref ps: ParserState): ParsingResult {
  const peekTag = ps.peek().tag;

  // A kind can precede two things in statement position, and the token after
  // the name is what tells them apart.
  //
  // `disposable ids: Vec<NodeId> = ...` - a kind-prefixed BINDING. Two
  // identifiers then a `:` or `=`.
  if (atKindPrefixedBinding(ref ps)) {
    return Result.Ok { value: parseVarDecl(ref ps)? };
  }

  // `ephemeral arenaScope(N) { ... }` - an anonymous REGION. Two identifiers
  // then a `(`. The subject is built, the block runs, and the kind's
  // `mustCall` method fires at the closing brace.
  if (atKindPrefixedBlock(ref ps)) {
    return Result.Ok { value: parseKindRegion(ref ps)? };
  }

  switch (peekTag) {
    case TokenTags.LET, TokenTags.CONST: {
      return Result.Ok { value: parseVarDecl(ref ps)? };
    }
    case TokenTags.RETURN: {
      return Result.Ok { value: parseReturnStatement(ref ps)? };
    }
    case TokenTags.IF: {
      return Result.Ok { value: parseIfStatement(ref ps)? };
    }
    case TokenTags.WHILE: {
      return Result.Ok { value: parseWhileStatement(ref ps)? };
    }
    case TokenTags.FOR: {
      return Result.Ok { value: parseForStatement(ref ps)? };
    }
    case TokenTags.SWITCH: {
      return Result.Ok { value: parseSwitchStatement(ref ps)? };
    }
    case TokenTags.BREAK: {
      return Result.Ok { value: parseLoopJump(ref ps, ASTNodeKind.BREAK_STATEMENT)? };
    }
    case TokenTags.CONTINUE: {
      return Result.Ok { value: parseLoopJump(ref ps, ASTNodeKind.CONTINUE_STATEMENT)? };
    }
    case TokenTags.DISCARD: {
      return Result.Ok { value: parseDiscardStatement(ref ps)? };
    }
    default: {
      return Result.Ok { value: parseExpressionStatement(ref ps)? };
    }
  }
}

// `if (cond) { ... }` with an optional `else { ... }` or `else if ...`.
//
//   childA = condition
//   childB = then block
//   childC = else branch: a BLOCK, or another IF_STATEMENT for `else if`
//            (0 when there is no else)
function parseIfStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.IF)?;
  let node = ps.buildSourcedNode(ASTNodeKind.IF_STATEMENT);

  ps.expect(TokenTags.LPAREN)?;
  node.childA = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.RPAREN)?;
  node.childB = parseBlock(ref ps)?;

  if (ps.peek().tag == TokenTags.ELSE) {
    ps.advance()?;
    // `else if` chains by nesting an IF_STATEMENT in the else slot, so codegen
    // needs no special case for the chain.
    if (ps.peek().tag == TokenTags.IF) {
      node.childC = parseIfStatement(ref ps)?;
    } else {
      node.childC = parseBlock(ref ps)?;
    }
  }

  return Result.Ok { value: ps.pushNode(node) };
}

// `while (cond) { ... }`
//
//   childA = condition
//   childB = body block
function parseWhileStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.WHILE)?;
  let node = ps.buildSourcedNode(ASTNodeKind.WHILE_STATEMENT);

  ps.expect(TokenTags.LPAREN)?;
  node.childA = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.RPAREN)?;
  node.childB = parseBlock(ref ps)?;

  return Result.Ok { value: ps.pushNode(node) };
}

export function parseBlock(ref ps: ParserState): ParsingResult {
  // shape =>> { statements[] }
  ps.expect(TokenTags.LCURLY)?;
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  let node = ps.buildSourcedNode(ASTNodeKind.BLOCK);

  // parse rest of statements
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (untilClosing(ref ps, TokenTags.RCURLY)) {
    // eat statements and add to body...
    ids.push(parseStatement(ref ps)?);
  }
  // child start nodeId...
  // child count
  node.childA = ps.buildListNode(ref ids, loc);
  ps.expect(TokenTags.RCURLY)?;

  // push node into ps...
  return Result.Ok { value: ps.pushNode(node) };
}

// `for (let i = 0; i < n; i = i + 1) { ... }`
//
// Deliberately the same constrained shape as the JS reference rather than a
// general three-statement C loop: the init and the step both target ONE named
// counter. That keeps the node fixed-shape and matches what the language
// actually offers.
//
//   name   = the counter
//   flagA  = the init declares it (`let i = ...`) vs steps an outer one
//   childA = its type annotation (0 = inferred from the initializer)
//   childB = the initializer
//   childC = the condition
//   childD = the step expression
//   childE = the body block
function parseForStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.FOR)?;

  // Two loops share the keyword, and the token right after it is what tells
  // them apart: `for (` is the counted form, anything else is `for x in xs`.
  // Cheaper and clearer than a lookahead for `in`, since the counted form
  // ALWAYS parenthesizes.
  if (ps.peek().tag != TokenTags.LPAREN) {
    return parseForInLoop(ref ps);
  }

  let node = ps.buildSourcedNode(ASTNodeKind.FOR_LOOP);
  ps.expect(TokenTags.LPAREN)?;

  // `const` cannot be stepped, so refuse it by name rather than letting the
  // step fail later with something less obvious.
  if (ps.peek().tag == TokenTags.CONST) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `a for-loop counter must be declared with "let" - "const" cannot be stepped`,
      peekLengthUsize(ref ps),
    )};
  }

  node.flagA = ps.peek().tag == TokenTags.LET;
  if (node.flagA) {
    ps.advance()?;
  }
  node.name = parseIdentAsName(ref ps)?;
  if (node.flagA && ps.peek().tag == TokenTags.COLON) {
    ps.advance()?;
    node.childA = parseTypeAnnotation(ref ps)?;
  }
  ps.expect(TokenTags.EQ)?;
  node.childB = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.SEMICOLON)?;

  node.childC = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.SEMICOLON)?;

  // The step is an implicit assignment to the counter, so only the right-hand
  // side is stored. `i = i + 1` today; the compound forms (`i += 1`) lower to
  // the same shape once they parse.
  const stepName = parseIdentAsName(ref ps)?;
  if (!str.stringEq(stepName, node.name)) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `for-loop step must assign to the counter "${node.name}"`,
      peekLengthUsize(ref ps),
    )};
  }
  // `i = i + 1` or the compound form `i += 1`. Both end up as the same stored
  // right-hand side, so the compound spelling needs no new node kind - the same
  // trick the JS reference uses in its step slot.
  const stepCompound = binaryOpOfCompound(ps.peek().tag);
  if (stepCompound != TokenTags.NOTOKEN) {
    ps.advance()?;
    let counterRead = ps.buildSourcedNode(ASTNodeKind.IDENT);
    counterRead.name = node.name;
    let combined = ps.buildSourcedNode(ASTNodeKind.BINARY_EXPRESSION);
    combined.operator = stepCompound;
    combined.childA = ps.pushNode(counterRead);
    combined.childB = parseExpression(ref ps, 0)?;
    node.childD = ps.pushNode(combined);
  } else {
    ps.expect(TokenTags.EQ)?;
    node.childD = parseExpression(ref ps, 0)?;
  }

  ps.expect(TokenTags.RPAREN)?;
  node.childE = parseBlock(ref ps)?;

  return Result.Ok { value: ps.pushNode(node) };
}

// `for name in <expr> { ... }` - walk an array, element by element.
//
//   name      the loop variable
//   childA    the iterable expression
//   childB    the body block
//
// The loop variable takes no annotation: its type is the element type of
// whatever is being walked, so there is nothing for the writer to say and
// nothing for a mismatch to mean. It is also always a fresh binding, so there
// is no `let` to write either.
function parseForInLoop(ref ps: ParserState): ParsingResult {
  let node = ps.buildSourcedNode(ASTNodeKind.FOR_IN_LOOP);
  node.name = parseIdentAsName(ref ps)?;
  ps.expect(TokenTags.IN)?;
  // The iterable runs right up to the body's `{`, so a trailing `a.b` path
  // must not take that brace for a variant payload. See ParserState's
  // inForInIterExpr.
  const savedForIn = ps.inForInIterExpr;
  ps.inForInIterExpr = true;
  const iterableId = parseExpression(ref ps, 0)?;
  ps.inForInIterExpr = savedForIn;
  node.childA = iterableId;
  node.childB = parseBlock(ref ps)?;
  return Result.Ok { value: ps.pushNode(node) };
}

// `break;` / `continue;` - just the keyword. Whether one is legal HERE is a
// typecheck question (it needs an enclosing loop), not a parse one.
function parseLoopJump(ref ps: ParserState, kind: ASTNodeKind): ParsingResult {
  let node = ps.buildSourcedNode(kind);
  ps.advance()?;
  ps.expect(TokenTags.SEMICOLON)?;
  return Result.Ok { value: ps.pushNode(node) };
}

// `switch (expr) { case A, B: { ... } default: { ... } }`
//
//   childA = the scrutinee
//   own childIds run = the SWITCH_ARM nodes, in source order
//
// An arm is:
//   childA = a NODE_LIST of the arm's patterns (empty for `default`)
//   childB = the arm's block
//   flagA  = this is the `default` arm
//
// Arms do NOT fall through - each is its own block - so no `break` is needed or
// accepted as an arm terminator.
function parseSwitchStatement(ref ps: ParserState): ParsingResult {
  ps.expect(TokenTags.SWITCH)?;
  let node = ps.buildSourcedNode(ASTNodeKind.SWITCH_STATEMENT);
  ps.expect(TokenTags.LPAREN)?;
  node.childA = parseExpression(ref ps, 0)?;
  ps.expect(TokenTags.RPAREN)?;
  ps.expect(TokenTags.LCURLY)?;

  disposable armIds: Vec<NodeId> = vec.vecNew(4);
  while (untilClosing(ref ps, TokenTags.RCURLY)) {
    armIds.push(parseSwitchArm(ref ps)?);
  }
  ps.expect(TokenTags.RCURLY)?;

  spliceChildren(ref ps, ref node, ref armIds);

  return Result.Ok { value: ps.pushNode(node) };
}

function parseSwitchArm(ref ps: ParserState): ParsingResult {
  let arm = ps.buildSourcedNode(ASTNodeKind.SWITCH_ARM);
  const loc = posToSourceLocation(ps.src, ps.pos, 1);

  if (ps.peek().tag == TokenTags.DEFAULT) {
    ps.advance()?;
    arm.flagA = true;
    disposable none: Vec<NodeId> = vec.vecNew(0);
    arm.childA = ps.buildListNode(ref none, loc);
  } else {
    ps.expect(TokenTags.CASE)?;
    // `case 1, 2:` and `case Result.Ok { value: v }, Result.None:` - several
    // patterns share one arm either way.
    disposable patternIds: Vec<NodeId> = vec.vecNew(2);
    while (true) {
      if (peekIsVariantPattern(ref ps)) {
        patternIds.push(parseVariantPattern(ref ps)?);
      } else {
        patternIds.push(parseLiteralPattern(ref ps)?);
      }
      if (ps.peek().tag != TokenTags.COMMA) {
        break;
      }
      ps.advance()?;
    }
    arm.childA = ps.buildListNode(ref patternIds, loc);
  }

  ps.expect(TokenTags.COLON)?;
  arm.childB = parseBlock(ref ps)?;
  return Result.Ok { value: ps.pushNode(arm) };
}

// Integer literals, and char literals - which ARE integer literals, already
// decoded to their codepoint by the lexer. `case '0', '1':` is the readable
// spelling of a digit test and appears throughout std.
//
// `true` and `false` come here too, as 1 and 0. What makes them different from
// `case 1:` is recorded in `operator`, which holds the TOKEN the pattern was
// written as: pass D refuses a bool pattern against an integer scrutinee and an
// integer pattern against a bool one, and the value alone cannot tell them
// apart. Nothing else on a LITERAL_PATTERN uses that slot.
function parseLiteralPattern(ref ps: ParserState): ParsingResult {
  let node = ps.buildSourcedNode(ASTNodeKind.LITERAL_PATTERN);
  let negate = false;
  if (ps.peek().tag == TokenTags.TRUE || ps.peek().tag == TokenTags.FALSE) {
    const boolTok = ps.advance()?;
    node.operator = boolTok.tag;
    if (boolTok.tag == TokenTags.TRUE) {
      node.intVal = 1;
    }
    return Result.Ok { value: ps.pushNode(node) };
  }
  if (ps.peek().tag == TokenTags.MINUS) {
    ps.advance()?;
    negate = true;
  }
  if (ps.peek().tag == TokenTags.CHARLITERAL) {
    node.intVal = ps.advance()?.intVal;
    node.flagA = negate;
    return Result.Ok { value: ps.pushNode(node) };
  }
  // A float pattern is refused BY NAME, matching the reference. A jump table
  // dispatches on an integer, and testing floats for equality is a different
  // operation with a different answer - `case 0.1` would never match a value
  // arrived at by arithmetic.
  if (ps.peek().tag == TokenTags.FLOATLITERAL) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      "float literals are not allowed in switch patterns",
      peekLengthUsize(ref ps),
    )};
  }
  const tok = ps.expect(TokenTags.INTLITERAL)?;
  node.intVal = tok.intVal;
  node.flagA = negate;
  return Result.Ok { value: ps.pushNode(node) };
}

// Two identifiers then a `:` or `=`: a kind-prefixed binding.
function atKindPrefixedBinding(ref ps: ParserState): bool {
  if (ps.peek().tag != TokenTags.IDENT) {
    return false;
  }
  // Walk the prefix run - several kinds may stack - and look at what follows
  // the last identifier.
  let i: usize = 1;
  while (true) {
    switch (ps.peekAhead(i)) {
      case Result.Err { error: e }: { return false; }
      case Result.Ok { value: tok }: {
        if (tok.tag == TokenTags.COLON || tok.tag == TokenTags.EQ) {
          // At least one prefix had to precede the name for this to be one.
          return i >= 2;
        }
        if (tok.tag != TokenTags.IDENT) {
          return false;
        }
      }
    }
    i += 1;
  }
}

// Two identifiers then a `(` or a `.` in STATEMENT position: a kind-prefixed
// block.
//
// The `.` is what makes `ephemeral mem.arenaScope(1024) { ... }` one. The
// subject is an ordinary EXPRESSION, so it may be a qualified call as easily as
// a bare one, and stopping at `(` would refuse the spelling every std user
// actually writes - values from std must come through a namespace.
function atKindPrefixedBlock(ref ps: ParserState): bool {
  if (ps.peek().tag != TokenTags.IDENT) {
    return false;
  }
  switch (ps.peekAhead(1)) {
    case Result.Err { error: e }: { return false; }
    case Result.Ok { value: second }: {
      if (second.tag != TokenTags.IDENT) {
        return false;
      }
      switch (ps.peekAhead(2)) {
        case Result.Err { error: e2 }: { return false; }
        case Result.Ok { value: third }: {
          return third.tag == TokenTags.LPAREN || third.tag == TokenTags.DOT;
        }
      }
    }
  }
}

// `ephemeral arenaScope(N) { ... }` and `ephemeral makeGuard(1);`
//
//   childC   the kind prefix list, the same slot a prefixed binding uses
//   childA   the subject expression
//   childB   the block, or 0 for the IMPLICIT form
//
// The subject is anonymous on purpose: a region is held for the block's
// duration and nothing inside names it. A kind that wants a name declares
// `appliesTo binding` instead.
//
// Two spellings and one difference between them: with braces the region owns
// the block and its scope-end call fires at the closing `}`; with a `;` it
// owns the REST OF THE ENCLOSING SCOPE and the call fires where that ends, in
// the ordinary reverse-declaration order beside every other disposal there.
// The `;` form is what `ephemeral makeGuard(1); ephemeral makeGuard(2);` needs
// to pop 2 before 1.
function parseKindRegion(ref ps: ParserState): ParsingResult {
  let node = ps.buildSourcedNode(ASTNodeKind.KIND_REGION);
  node.childC = parseKindPrefixes(ref ps)?;
  node.childA = parseExpression(ref ps, 0)?;
  if (ps.peek().tag == TokenTags.SEMICOLON) {
    ps.advance()?;
    return Result.Ok { value: ps.pushNode(node) };
  }
  node.childB = parseBlock(ref ps)?;
  return Result.Ok { value: ps.pushNode(node) };
}
