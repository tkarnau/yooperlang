module parse;

// What every parse function is handed: the cursor, the arena being built, and
// the source it reads from.
//
// The parser lexes ON DEMAND (one token of lookahead in `currentLex`, more via
// `peekAhead`) rather than consuming a materialized token stream. That is a
// deliberate deviation from the layer contract's `parse(tokens)` shape - the
// boundary still holds, since `tokenize` exists and produces the same stream.
//
// `SelfLexing` is a trait rather than plain functions so the cursor operations
// read as methods on the state; ParserState is its only implementer.

import { Result, Option } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";

import { AST, ASTNode, ASTNodeKind, NodeId, createASTNode } from "../ast";
import { TokenTags, tagName, Token, LexedVal, LexTables, lexNext, posToSourceLocation } from "../lex";
import { SourceLocation, ParsingError } from "../diagnostics";

// What a parse function hands back: the NodeId it appended to the arena, or the
// first error it hit. Parsing fails fast; typecheck is the layer that
// accumulates (see diagnostics/diagnostic.yoop).
export type ParsingResult = Result<NodeId, ParsingError>;

export trait SelfLexing {
  function advance(ref self): Result<Token, ParsingError>;
  function peek(ref self): Token;
  function peekAhead(ref self, n: usize): Result<Token, ParsingError>;
  function expect(ref self, tag: TokenTags): Result<Token, ParsingError>;
  function createParsingError(ref self, message: string, length: Option<usize>): ParsingError;
  function buildSourcedNode(ref self, astNodeKind: ASTNodeKind): ASTNode;
  function pushNode(ref self, node: ASTNode): NodeId;
  function buildListNode(ref self, ref ids: Vec<NodeId>, loc: SourceLocation): NodeId;
  // function
}

export function peekLengthUsize(ref pState: ParserState): Option<usize> {
  return Option.Some { value: usize(SelfLexing.peek(ref pState).length) };
}

// True while the cursor is inside a run that ends at `closer`.
//
// Every bracketed list in the parser walks until its closing token OR end of
// file, and the EOF half is the part that matters: without it an unterminated
// `{` spins forever instead of raising, because `peek` at EOF keeps handing back
// EOF. The loop does not report anything - the `expect(closer)` after it does,
// which is what makes the diagnostic point at the closer rather than at EOF.
//
// Seventeen sites spelled this out as a five-line condition that called `peek`
// twice per iteration.
export function untilClosing(ref ps: ParserState, closer: TokenTags): bool {
  const t = SelfLexing.peek(ref ps).tag;
  return t != closer && t != TokenTags.EOF;
}

// Point `node` at a run of children in the arena's one flat `childIds` table.
//
// The scratch-Vec-then-splice build pattern, and the reason it exists: a list's
// length is not known until it has been parsed, but `childStart`/`childCount`
// index into a table SHARED by every node. So children are collected into a
// local Vec first and copied in as one contiguous run at the end - a partial
// splice would interleave with the runs a nested parse appended in the meantime.
//
// Thirteen parse sites wrote these three lines out by hand. The ORDER is the
// part worth having in one place: `childStart` has to be read BEFORE the extend,
// and a version that reads it after points the node at the end of its own run,
// which parses without complaint and then walks nothing.
//
// `buildListNode` is the sibling for the other case - a slot that HOLDS a list
// (`node.childB = ...`) rather than a node that IS one.
export function spliceChildren(ref ps: ParserState, ref node: ASTNode, ref ids: Vec<NodeId>): void {
  node.childStart = ps.ast.childIds.len;
  vec.vecExtendFrom(ref ps.ast.childIds, vec.vecAsArray(ref ids));
  node.childCount = ids.len;
}

export type ParserState implements SelfLexing propagates<disposable> {
  currentLex: LexedVal,
  pos: usize,
  ast: AST,
  src: ref uint8[],
  // The lexer's two scan tables, built once by whoever created this state.
  // BORROWED rather than owned: the state is copied around by value in a few
  // places and the tables are not cursor state, so `parseInto` keeps them for
  // the length of the parse. See scan_tables.yoop for why there is no global.
  tables: ref LexTables,
  // `Vec<Map<string, TypeId>>` ends in a `>>`, which the lexer hands over as
  // ONE right-shift token. Closing the inner list consumes it and leaves a
  // virtual `>` behind for the outer one; `consumeClosingGt` is the only thing
  // that ever reads this, so every other parse site sees the tokens as they
  // are. Same trick, same reason, as the JS reference's pendingGtFromRshift.
  pendingGt: bool,
  // True once this FILE has written an `a..b` anywhere in it. The range
  // lowering needs a namespace import of std/core/range.yoop, and only a file
  // that used one should pay for pulling that module into the graph. See
  // range.yoop.
  usedRange: bool,
  // True while the RHS of a `for x in <expr> {` is being parsed. The iterable
  // runs right up to the body's `{`, so an `a.b` path at the end of it would
  // otherwise swallow that brace as a variant PAYLOAD - `for i in 0..xs.len {`
  // reads `xs.len { ... }` as `Enum.Case { ... }`. Inside the RHS a `{` only
  // starts a payload when it LOOKS like one, which is `{ <name> :` and is
  // something no block can be. Same flag, same rule, as the reference's
  // inForInIterExpr.
  inForInIterExpr: bool,
  function buildSourcedNode(ref self, astNodeKind: ASTNodeKind): ASTNode {
    // Node loc is the CURRENT token's start (self.pos tracks where the NEXT
    // lex begins, which is past the current token).
    return createASTNode(
      astNodeKind,
      posToSourceLocation(
        self.src,
        self.currentLex.token.start,
        usize(self.currentLex.token.length)
      )
    );
  }
  // Append a fully-built node to the arena and hand back its NodeId (its index).
  // Parents are typically pushed AFTER their children, so a parent gets a higher
  // NodeId than its children - fine, ids need not follow tree order.
  function pushNode(ref self, node: ASTNode): NodeId {
    const id: NodeId = self.ast.nodes.len;
    vec.vecPush(ref self.ast.nodes, node);
    return id;
  }
  // Splice a scratch run of child NodeIds into the shared childIds pool as one
  // contiguous block, wrap it in a NODE_LIST node, and return that node's id.
  // The scratch Vec must be built fully BEFORE calling this: parsing a child can
  // itself append runs to childIds, so a partial splice would interleave.
  function buildListNode(ref self, ref ids: Vec<NodeId>, loc: SourceLocation): NodeId {
    const start: usize = self.ast.childIds.len;
    vec.vecExtendFrom(ref self.ast.childIds, vec.vecAsArray(ref ids));
    let listNode = createASTNode(ASTNodeKind.NODE_LIST, loc);
    listNode.childStart = start;
    listNode.childCount = ids.len;
    return SelfLexing.pushNode(ref self, listNode);
  }
  function peek(ref self): Token {
    return self.currentLex.token;
  }
  // peeks ahead 'n' tokens without disturbing parser state. peekAhead(0) is
  // equivalent to peek(); peekAhead(1) is the token following 'currentLex'
  // used for certain statement disambiguation, like kind prefixes with multi
  // ident tokens
  function peekAhead(ref self, n: usize): Result<Token, ParsingError> {
    if (n == 0) {
      return Result.Ok { value: self.currentLex.token };
    }
    let p = self.pos;
    let i: usize = 0;
    let token: Token;
    while (i < n) {
      const lexRes = lexNext(self.tables, self.src, p)?;
      token = lexRes.token;
      p = lexRes.nextPos;
      i += 1;
    }

    return Result.Ok { value: token };
  }
  function createParsingError(ref self, message: string, length: Option<usize>): ParsingError {
    const sourceLoc = posToSourceLocation(self.src, self.pos, 1);
    // No AST dump here. It was a bring-up aid, and once imports reached real
    // files it printed the whole partial arena above every syntax error - tens
    // of kilobytes between the reader and the one line that mattered. `--dump-ast`
    // is the place for that, when it exists.
    return {
      sourceLoc: sourceLoc,
      isParseError: true,
      rawMessage: message,
      src: self.src,
      err: message, // for now...
    };
  }
  function expect(ref self, tag: TokenTags): Result<Token, ParsingError> {
    if (self.currentLex.token.tag != tag) {
      return Result.Err { error: SelfLexing.createParsingError(
        ref self,
        `expected ${tagName(tag)}, got ${tagName(self.currentLex.token.tag)}`,
        peekLengthUsize(ref self),
      )};
    }
    const tok = self.currentLex.token;
    SelfLexing.advance(ref self)?;

    return Result.Ok { value:  tok };
  }
  function advance(ref self): Result<Token, ParsingError> {
    const tok = self.currentLex.token;
    const lexedVal = lexNext(self.tables, self.src, self.pos)?;
    self.currentLex = lexedVal;
    self.pos = lexedVal.nextPos;
    return Result.Ok { value: tok };
  }
}