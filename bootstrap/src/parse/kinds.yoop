module parse;

// The kind prefix in front of a decl (`disposable buf: ...`, `tainted Foo`).

import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, posToSourceLocation } from "../lex";
import { ParsingError } from "../diagnostics";

export function consumeKindPrefixWithArgs(ref ps: ParserState): Result<NodeId, ParsingError> {
  const kindTok = SelfLexing.expect(ref ps, TokenTags.IDENT)?;
  const name = parseIdentAsName(ref ps)?;

  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.KIND_PREFIX);
  node.name = name;
  const sourceLoc = posToSourceLocation(ps.src, ps.pos, 1);
  if (SelfLexing.peek(ref ps).tag == TokenTags.LPAREN) {
    SelfLexing.advance(ref ps);
    let peekTag = SelfLexing.peek(ref ps).tag;
    disposable argNodeIds: Vec<NodeId> = vec.vecNew(4);
    while (peekTag != TokenTags.RPAREN && peekTag != TokenTags.EOF) {
      // push into "args" nodes as a node list
      // ... todo vec.vecPush(ref argNodeIds, SelfLexing.pushNode(ref ps, tp));
      if (peekTag == TokenTags.COMMA) {
        SelfLexing.advance(ref ps);
        peekTag = SelfLexing.peek(ref ps).tag;
      }
    }
    SelfLexing.expect(ref ps, TokenTags.RPAREN)?;
    node.childA = SelfLexing.buildListNode(ref ps, ref argNodeIds, sourceLoc);
  }
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}