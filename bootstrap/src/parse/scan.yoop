module parse;

// Lookahead helpers that answer a shape question without consuming anything.

import { Result, Option } from "std/core/types.yoop";
import { TokenTags } from "../lex";

export function findMatchingRParen(ref ps: ParserState, lParentIdx: usize): Option<usize> {
  let depth = 1;
  let i = lParentIdx + 1;
  while (depth > 0) {
    const peekAheadResult = SelfLexing.peekAhead(ref ps, 1);
    switch (peekAheadResult) {
      case Result.Err { error: e }: {
        return Option.None {}; // ignore this error, as we may peek too far and that's ok
      }
      case Result.Ok { value: tok }: {
        if (tok.tag == TokenTags.EOF) {
          return Option.None {};
        }
        if (tok.tag == TokenTags.LPAREN) {
          depth += 1;
        } else if (tok.tag == TokenTags.RPAREN) {
          depth -= 1;
        }
      }
    }
    i += 1;
  }

  return Option.Some { value: i - 1 };
}