module parse;

// Layer 2 entry point: source bytes -> one AST arena rooted at a PROGRAM node.
//
// Everything below this file is a recursive descent over the same ParserState;
// the files are split by what they parse (types, functions, statements,
// expressions, ...), not by layering, and they all see each other because they
// are one directory module.

import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNodeKind, NodeId, emptyArena } from "../ast";
import { TokenTags, tagName, createLexedVal } from "../lex";
import { ParsingError } from "../diagnostics";
import * as str from "std/core/strings.yoop";


// main parsing logic, starts with top level and handles all child levels
function parseAST(ref ps: ParserState): Result<NodeId, ParsingError> {
  let program = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.PROGRAM);

  // `module <name>;`, when the file has one. It lands on the PROGRAM node's
  // `name` - empty for a file with no header, which is what makes it a
  // single-file module. The graph has already read the header (see
  // header.yoop); parsing it again here is what puts it in the AST, where pass
  // A can check the file agrees with the directory it was loaded as part of.
  program.name = parseModuleHeader(ref ps)?;

  // Collect each top-level decl's NodeId in a scratch buffer, then splice the
  // whole run into the arena's shared childIds pool as the PROGRAM body.
  disposable body: Vec<NodeId> = vec.vecNew(8);
  // The imports-first rule. Every consumer of the AST reads the leading run of
  // IMPORT_DECLs and stops at the first decl (the module graph does it to find
  // the edges, pass B to bind them), so an import further down would be
  // silently ignored rather than misunderstood. Refuse it here instead.
  let seenNonImport = false;
  let peekTag = SelfLexing.peek(ref ps).tag;
  while (peekTag != TokenTags.EOF) {
    if (peekTag != TokenTags.IMPORT) {
      seenNonImport = true;
    } else if (seenNonImport) {
      return Result.Err { error: SelfLexing.createParsingError(
        ref ps,
        "imports must come first: every `import` belongs above the first declaration in the file",
        peekLengthUsize(ref ps),
      )};
    }
    switch (peekTag) {
      case TokenTags.IMPORT: {
        // `import.unsafe;` is a module FLAG, not an import. Same keyword; the
        // `.` is what tells them apart, so the fork is here.
        if (SelfLexing.peekAhead(ref ps, 1)?.tag == TokenTags.DOT) {
          const directive = parseImportDirective(ref ps)?;
          if (str.stringEq(directive, "unsafe")) {
            program.flagA = true;
          }
          // `import.test` needs nothing recorded: a test module's suites are
          // the harness's business, and the bootstrap does not run them.
        } else {
          vec.vecPush(ref body, parseImportDecl(ref ps)?);
        }
      }
      case TokenTags.EXTERN: {
        vec.vecPush(ref body, parseExternBlock(ref ps)?);
      }
      case TokenTags.EXPORT: {
        vec.vecPush(ref body, parseExportDecl(ref ps)?);
      }
      case TokenTags.TYPE: {
        vec.vecPush(ref body, parseTypeDecl(ref ps)?);
      }
      case TokenTags.CONST, TokenTags.LET: {
        // Module-level `const NAME: T = <literal>;`. The same parser as the
        // statement form - what differs is only where the name is bound, which
        // is pass A's business and not the parser's.
        //
        // `let` is parsed here too, and refused in pass A. The difference
        // between a constant and a mutable global is semantic, so the message
        // that names it belongs where the semantics are - "unexpected token at
        // top level: LET" says nothing about what to do instead.
        vec.vecPush(ref body, parseVarDecl(ref ps)?);
      }
      case TokenTags.VARIANT: {
        vec.vecPush(ref body, parseVariantDecl(ref ps)?);
      }
      case TokenTags.TRAIT: {
        vec.vecPush(ref body, parseTraitDecl(ref ps)?);
      }
      case TokenTags.VTABLE: {
        vec.vecPush(ref body, parseVtableDecl(ref ps)?);
      }
      case TokenTags.FUNCTION /*, TokenTags.TASK */: {
        vec.vecPush(ref body, parseFunctionDecl(ref ps)?);
      }
      // TODO: rest of tags...
      default: {
        // A header below the first declaration. Checked BEFORE the kind forms
        // because `module lex;` is two identifiers in a row and would
        // otherwise be read as a kind-prefixed declaration, which reports a
        // missing `(` instead of the real mistake.
        if (peekIsWord(ref ps, "module")) {
          return Result.Err { error: SelfLexing.createParsingError(
            ref ps,
            "a `module <name>;` header must be the FIRST thing in the file, above the imports",
            peekLengthUsize(ref ps),
          )};
        }
        // `kind async { ... }` - a kind DECLARATION. Contextual, so it arrives
        // as an IDENT like everything else here.
        if (atKindDecl(ref ps)) {
          vec.vecPush(ref body, parseKindDecl(ref ps)?);
          peekTag = SelfLexing.peek(ref ps).tag;
          continue;
        }
        // `async fetch(...)` - a declaration CARRYING a kind. A kind prefix
        // stands where the `function` keyword would, so there is no keyword to
        // dispatch on and the two-identifier shape is what says so.
        if (atKindPrefixedDecl(ref ps)) {
          vec.vecPush(ref body, parseKindPrefixedDecl(ref ps)?);
          peekTag = SelfLexing.peek(ref ps).tag;
          continue;
        }
        return Result.Err { error: SelfLexing.createParsingError(
          ref ps,
          `unexpected token at top level: ${tagName(peekTag)}`,
          peekLengthUsize(ref ps),
        )};
      }
    }
    peekTag = SelfLexing.peek(ref ps).tag;
  }

  const start: usize = ps.ast.childIds.len;
  // copy the dynamic body into the childIds so we can destroy
  // the scratch buffer (body: Vec<NodeId>)
  vec.vecExtendFrom(ref ps.ast.childIds, vec.vecAsArray(ref body));
  program.childStart = start;
  program.childCount = body.len;
  ps.ast.root = SelfLexing.pushNode(ref ps, program);

  return Result.Ok { value: ps.ast.root };
}

// One parsed source file: the arena it went into, and its own PROGRAM node.
//
// The arena is handed back rather than borrowed because ParserState OWNS it for
// the duration - it is moved in and moved out, which is what lets several files
// of a directory module accumulate into one arena without any of them holding a
// reference to it.
export type ParsedFile propagates<disposable> {
  ast: AST,
  root: NodeId,
}

// Parse `src` into an EXISTING arena, appending to it.
//
// This is what makes a directory module one module: every source file in it
// parses into the same arena, so NodeIds are unique across the whole module and
// the typecheck decoration stays one dense vector indexed by NodeId. Each file
// keeps its own PROGRAM root.
export function parseInto(ast: AST, src: uint8[]): Result<ParsedFile, ParsingError> propagates<disposable> {
  let pState: ParserState = {
    currentLex: createLexedVal(), // EOF placeholder; primed by the advance below
    pos: 0,
    ast: ast,
    src: ref src,
    pendingGt: false,
  };

  SelfLexing.advance(ref pState)?; // prime: load the first real token into currentLex

  const root = parseAST(ref pState)?;
  return Result.Ok { value: { ast: pState.ast, root: root } };
}

// Parse one file into an arena of its own. The single-file case, and what tests
// and tools want.
export function parse(src: uint8[]): Result<AST, ParsingError> propagates<disposable> {
  const parsed = parseInto(emptyArena(), src)?;
  return Result.Ok { value: parsed.ast };
}
