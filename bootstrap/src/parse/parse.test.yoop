// Tests for the `parse` module - the import and export declarations.
//
// These assert the ARENA SHAPE, because that shape is a contract every later
// layer reads: the module graph pulls a source path out of `strId`, pass B
// walks the specifier run, and four separate walks look through an EXPORT_DECL.
// A test that only checked "it parses" would let any of those drift.
//
// The refusals are here for the same reason as the acceptances. Every form
// outside the subset has to fail BY NAME - a silently dropped import resurfaces
// much later as "unknown function", pointing at the wrong file.

import.test;
import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import * as intr from "std/core/intrinsics.yoop";
import * as str from "std/core/strings.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Result } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, childAt, declOf, emptyArena, isExportDecl, nodeAt } from "../ast";
import { parse } from "../parse";

suite function namedImportsBuildSpecifierNodes(): void {
  let ast = parseOk("import { add, scale as times } from \"./lib/mathx.yoop\";");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("an import is an IMPORT_DECL at the top level") {
    theory.isSuccessful = decl.kind == ASTNodeKind.IMPORT_DECL;
    theory.detail = `the first top-level node is ${decl.kind}, wanted IMPORT_DECL`;
  }

  let test theory: Case = t.asserts("the decoded source path lands in the string pool") {
    const path = poolString(ref ast, decl.strId);
    theory.isSuccessful = str.stringEq(path, "./lib/mathx.yoop");
    theory.detail = `the interned source path is "${path}", wanted "./lib/mathx.yoop"`;
  }

  let test theory: Case = t.asserts("each specifier is one node in the decl's own child run") {
    theory.isSuccessful = decl.childCount == 2;
    theory.detail = `the import has ${decl.childCount} specifier(s), wanted 2`;
  }

  const plain = nodeAt(ref ast, childAt(ref ast, decl, 0));
  let test theory: Case = t.asserts("a bare specifier binds the export name locally") {
    theory.isSuccessful = plain.kind == ASTNodeKind.IMPORT_SPECIFIER
      && str.stringEq(plain.name, "add")
      && str.stringEq(poolString(ref ast, plain.strId), "add");
    theory.detail = `{ add } gave local "${plain.name}" / export "${poolString(ref ast, plain.strId)}"`;
  }

  // The half that a single `name` slot could not carry, and the reason
  // IMPORT_SPECIFIER exists at all.
  const aliased = nodeAt(ref ast, childAt(ref ast, decl, 1));
  let test theory: Case = t.asserts("an aliased specifier keeps BOTH names") {
    theory.isSuccessful = str.stringEq(aliased.name, "times")
      && str.stringEq(poolString(ref ast, aliased.strId), "scale");
    theory.detail = `{ scale as times } gave local "${aliased.name}" / export "${poolString(ref ast, aliased.strId)}", wanted times / scale`;
  }
}

suite function theModuleHeaderLandsOnTheProgramNode(): void {
  // The header is what makes a file part of a DIRECTORY module. The graph reads
  // it with three tokens of lexing before choosing an arena (see header.yoop);
  // this is the same name, recorded in the AST.
  let ast = parseOk("module lex;\nimport { A } from \"./a.yoop\";\nfunction f(): int { return 1; }");
  const program = nodeAt(ref ast, ast.root);

  let test theory: Case = t.asserts("the declared name lands on PROGRAM") {
    theory.isSuccessful = str.stringEq(program.name, "lex");
    theory.detail = `the program declares module "${program.name}", wanted "lex"`;
  }
  let test theory: Case = t.asserts("the header is not a top-level declaration") {
    theory.isSuccessful = program.childCount == 2;
    theory.detail = `the header file has ${program.childCount} top-level nodes, wanted 2 (the import and the function)`;
  }

  let bare = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("a file with no header declares no module") {
    theory.isSuccessful = nodeAt(ref bare, bare.root).name.len == 0;
    theory.detail = `a headerless file declared module "${nodeAt(ref bare, bare.root).name}"`;
  }

  // It has to be FIRST, above the imports - which is where the graph looks.
  const late = "import { A } from \"./a.yoop\";\nmodule lex;";
  let test theory: Case = t.asserts("a header below anything else is refused") {
    theory.isSuccessful = refusalMentions(late, "must be the FIRST thing");
    theory.detail = `wanted a header-position refusal, got: ${parseError(late)}`;
  }
}

suite function namespaceImportsBindOneNameToTheModule(): void {
  let ast = parseOk("import * as mathx from \"./lib/mathx.yoop\";");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("the namespace local name lands on the decl") {
    theory.isSuccessful = str.stringEq(decl.name, "mathx");
    theory.detail = `the import bound namespace "${decl.name}", wanted "mathx"`;
  }
  let test theory: Case = t.asserts("a namespace clause produces no specifiers") {
    theory.isSuccessful = decl.childCount == 0;
    theory.detail = `a bare \`* as\` import produced ${decl.childCount} specifier(s), wanted 0`;
  }

  // Both clauses, one source path. The order they are written in is free, which
  // is why the parser reads them as two independent optional clauses.
  let both = parseOk("import { Point }, * as mathx from \"./lib/mathx.yoop\";");
  const combined = topLevel(ref both, 0);
  let test theory: Case = t.asserts("the combined form carries a namespace AND specifiers") {
    theory.isSuccessful = str.stringEq(combined.name, "mathx") && combined.childCount == 1;
    theory.detail = `\`{ Point }, * as mathx\` gave namespace "${combined.name}" and ${combined.childCount} specifier(s)`;
  }

  let reversed = parseOk("import * as mathx, { Point } from \"./lib/mathx.yoop\";");
  const flipped = topLevel(ref reversed, 0);
  let test theory: Case = t.asserts("the clauses may be written in either order") {
    theory.isSuccessful = str.stringEq(flipped.name, "mathx") && flipped.childCount == 1;
    theory.detail = `\`* as mathx, { Point }\` gave namespace "${flipped.name}" and ${flipped.childCount} specifier(s)`;
  }

  let named = parseOk("import { Point } from \"./lib/mathx.yoop\";");
  let test theory: Case = t.asserts("a plain named import leaves the namespace name empty") {
    theory.isSuccessful = topLevel(ref named, 0).name.len == 0;
    theory.detail = `a named-only import bound namespace "${topLevel(ref named, 0).name}", wanted none`;
  }
}

suite function aQualifiedCallIsACallNotAFieldRead(): void {
  // The parser cannot tell `mathx.add(1, 2)` from a field holding a function -
  // that needs name resolution - so it records the SHAPE and pass D decides.
  let ast = parseOk("function f(): int { return mathx.add(1, 2); }");
  const call = returnedExpression(ref ast);

  let test theory: Case = t.asserts("`ns.fn(args)` parses as a CALL_EXPRESSION") {
    theory.isSuccessful = call.kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = `mathx.add(1, 2) parsed as ${call.kind}, wanted CALL_EXPRESSION`;
  }
  let test theory: Case = t.asserts("the member is in `name`, exactly like an unqualified call") {
    theory.isSuccessful = str.stringEq(call.name, "add");
    theory.detail = `the call name is "${call.name}", wanted the member "add"`;
  }
  let test theory: Case = t.asserts("the base it was reached through is in childB") {
    const base = nodeAt(ref ast, call.childB);
    theory.isSuccessful = call.childB != 0
      && base.kind == ASTNodeKind.IDENT
      && str.stringEq(base.name, "mathx");
    theory.detail = `childB is a ${base.kind} named "${base.name}", wanted IDENT mathx`;
  }

  // The regression this could easily cause: a field READ must stay a field read.
  let field = parseOk("function f(): int { return p.x; }");
  const read = returnedExpression(ref field);
  let test theory: Case = t.asserts("a dotted name with no arguments is still a FIELD_ACCESS") {
    theory.isSuccessful = read.kind == ASTNodeKind.FIELD_ACCESS && str.stringEq(read.name, "x");
    theory.detail = `p.x parsed as ${read.kind} named "${read.name}", wanted FIELD_ACCESS x`;
  }

  let plain = parseOk("function f(): int { return add(1, 2); }");
  let test theory: Case = t.asserts("an unqualified call has no base") {
    theory.isSuccessful = returnedExpression(ref plain).childB == 0;
    theory.detail = "add(1, 2) carries a qualifying base; only ns.fn() should";
  }
}

suite function variantDeclsCarryTheirCasesInOrder(): void {
  let ast = parseOk("variant Shape { Circle { r: int }, Rect { w: int, h: int }, Empty }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a variant decl holds one node per case") {
    theory.isSuccessful = decl.kind == ASTNodeKind.VARIANT_DECL && decl.childCount == 3;
    theory.detail = `parsed a ${decl.kind} with ${decl.childCount} cases, wanted VARIANT_DECL with 3`;
  }

  // DECLARATION ORDER is the tag order, and the tag is ABI - so the order the
  // arena holds them in is the thing worth pinning.
  let test theory: Case = t.asserts("cases keep their declaration order") {
    const first = nodeAt(ref ast, childAt(ref ast, decl, 0));
    const last = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = str.stringEq(first.name, "Circle") && str.stringEq(last.name, "Empty");
    theory.detail = `the first and last cases are "${first.name}" and "${last.name}", wanted Circle and Empty`;
  }

  let test theory: Case = t.asserts("a case carries its own fields") {
    const rect = nodeAt(ref ast, childAt(ref ast, decl, 1));
    theory.isSuccessful = rect.kind == ASTNodeKind.VARIANT_CASE && rect.childCount == 2;
    theory.detail = `Rect is a ${rect.kind} with ${rect.childCount} field(s), wanted VARIANT_CASE with 2`;
  }

  let test theory: Case = t.asserts("a payload-less case has an empty field run") {
    const empty = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = empty.childCount == 0;
    theory.detail = `Empty carries ${empty.childCount} field(s), wanted 0`;
  }
}

suite function variantConstructorsAndPatternsShareOneShape(): void {
  // The braces are what make a constructor unambiguous at parse time.
  let ast = parseOk("function f(): int { return Shape.Circle { r: 2 }; }");
  const ctor = returnedExpression(ref ast);

  let test theory: Case = t.asserts("`V.Case { ... }` parses as a VARIANT_CONSTRUCTOR") {
    theory.isSuccessful = ctor.kind == ASTNodeKind.VARIANT_CONSTRUCTOR
      && str.stringEq(ctor.name, "Circle");
    theory.detail = `parsed a ${ctor.kind} named "${ctor.name}", wanted VARIANT_CONSTRUCTOR Circle`;
  }
  let test theory: Case = t.asserts("the variant name is the qualifying base") {
    const base = nodeAt(ref ast, ctor.childB);
    theory.isSuccessful = base.kind == ASTNodeKind.IDENT && str.stringEq(base.name, "Shape");
    theory.detail = `childB is a ${base.kind} named "${base.name}", wanted IDENT Shape`;
  }

  // A payload-LESS constructor is the same tokens as a field read, so the
  // parser leaves it alone and pass D decides once names resolve.
  let bare = parseOk("function f(): int { return Shape.Empty; }");
  let test theory: Case = t.asserts("a payload-less constructor stays a FIELD_ACCESS") {
    theory.isSuccessful = returnedExpression(ref bare).kind == ASTNodeKind.FIELD_ACCESS;
    theory.detail = `Shape.Empty parsed as ${returnedExpression(ref bare).kind}, wanted FIELD_ACCESS`;
  }

  let sw = parseOk("function f(): int { switch (s) { case Shape.Circle { r: v }: { return v; } } }");
  const pattern = firstSwitchPattern(ref sw);
  let test theory: Case = t.asserts("a case pattern is a VARIANT_PATTERN with the same slots") {
    theory.isSuccessful = pattern.kind == ASTNodeKind.VARIANT_PATTERN
      && str.stringEq(pattern.name, "Circle")
      && str.stringEq(nodeAt(ref sw, pattern.childB).name, "Shape");
    theory.detail = `parsed a ${pattern.kind} named "${pattern.name}"`;
  }
  let test theory: Case = t.asserts("a pattern's payload holds BINDING names") {
    const list = nodeAt(ref sw, pattern.childA);
    const field = nodeAt(ref sw, childAt(ref sw, list, 0));
    const binding = nodeAt(ref sw, field.childA);
    theory.isSuccessful = str.stringEq(field.name, "r")
      && binding.kind == ASTNodeKind.IDENT && str.stringEq(binding.name, "v");
    theory.detail = `{ r: v } gave field "${field.name}" bound to a ${binding.kind} named "${binding.name}"`;
  }

  // The regression the constructor could easily cause.
  let literal = parseOk("function f(): int { const p: Point = { x: 1 }; return 0; }");
  let test theory: Case = t.asserts("a plain struct literal is untouched") {
    theory.isSuccessful = !refusalMentions("function f(): int { const p: Point = { x: 1 }; return 0; }", "expected");
    theory.detail = "an unqualified struct literal stopped parsing";
  }
}

suite function typeArgumentsParseInAnnotations(): void {
  // `<` in annotation position is never a comparison - nothing else can appear
  // there - which is what makes this unambiguous where an expression's `a < b`
  // would not be.
  let ast = parseOk("function f(): int { const v: Result<int, string> = 0; return 0; }");
  const annot = firstVarDeclAnnotation(ref ast);

  let test theory: Case = t.asserts("a generic application carries its argument list") {
    theory.isSuccessful = annot.kind == ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME
      && str.stringEq(annot.name, "Result")
      && annot.childA != 0;
    theory.detail = `parsed a ${annot.kind} named "${annot.name}" with argsList ${annot.childA}`;
  }
  let test theory: Case = t.asserts("each argument is its own annotation node") {
    const list = nodeAt(ref ast, annot.childA);
    const first = nodeAt(ref ast, childAt(ref ast, list, 0));
    const second = nodeAt(ref ast, childAt(ref ast, list, 1));
    theory.isSuccessful = list.childCount == 2
      && str.stringEq(first.name, "int") && str.stringEq(second.name, "string");
    theory.detail = `got ${list.childCount} argument(s): "${first.name}", "${second.name}"`;
  }

  // Arguments are full annotations, so they nest.
  let nested = parseOk("function f(): int { const v: Box<Vec<int>> = 0; return 0; }");
  let test theory: Case = t.asserts("arguments nest") {
    const outer = firstVarDeclAnnotation(ref nested);
    const args = nodeAt(ref nested, outer.childA);
    const inner = nodeAt(ref nested, childAt(ref nested, args, 0));
    theory.isSuccessful = str.stringEq(inner.name, "Vec") && inner.childA != 0;
    theory.detail = `the inner argument is "${inner.name}" with argsList ${inner.childA}`;
  }

  let bare = parseOk("function f(): int { const v: int = 0; return 0; }");
  let test theory: Case = t.asserts("a plain annotation has no argument list") {
    theory.isSuccessful = firstVarDeclAnnotation(ref bare).childA == 0;
    theory.detail = "a non-generic annotation carries a type-argument list";
  }

  let test theory: Case = t.asserts("an empty argument list is refused") {
    const src = "function f(): int { const v: Box<> = 0; return 0; }";
    theory.isSuccessful = refusalMentions(src, "empty type argument list");
    theory.detail = `wanted an empty-list refusal, got: ${parseError(src)}`;
  }
}

suite function externBlocksDeclareSignaturesWithNoBody(): void {
  let ast = parseOk("extern \"C\" from \"stdio.h\" { function puts(s: string): int; function fflush(f: int): int; }");
  const block = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("an extern block holds one node per signature") {
    theory.isSuccessful = block.kind == ASTNodeKind.EXTERN_BLOCK && block.childCount == 2;
    theory.detail = `parsed a ${block.kind} with ${block.childCount} signature(s), wanted EXTERN_BLOCK with 2`;
  }
  let test theory: Case = t.asserts("the library name is recorded, not dropped") {
    theory.isSuccessful = str.stringEq(poolString(ref ast, block.strId), "stdio.h");
    theory.detail = `the library is "${poolString(ref ast, block.strId)}", wanted "stdio.h"`;
  }
  let test theory: Case = t.asserts("a signature has params and a return but NO body") {
    const fn = nodeAt(ref ast, childAt(ref ast, block, 0));
    theory.isSuccessful = fn.kind == ASTNodeKind.EXTERN_FUNCTION_DECL
      && str.stringEq(fn.name, "puts") && fn.childB != 0 && fn.childC != 0 && fn.childD == 0;
    theory.detail = `puts parsed as ${fn.kind} with body slot ${fn.childD}, which must be empty`;
  }

  // `from` is required, matching the JS reference - a program written against a
  // looser rule would not compile with the other compiler.
  let test theory: Case = t.asserts("the `from` clause is required") {
    const src = "extern \"C\" { function puts(s: string): int; }";
    theory.isSuccessful = refusalMentions(src, "expected FROM");
    theory.detail = `wanted a missing-from refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("an ABI other than C is refused by name") {
    const src = "extern \"rust\" from \"x\" { function f(): int; }";
    theory.isSuccessful = refusalMentions(src, "unsupported extern ABI");
    theory.detail = `wanted an ABI refusal, got: ${parseError(src)}`;
  }
}

suite function importDirectivesAreFlagsNotImports(): void {
  // Same keyword as an import; the `.` is the whole difference.
  let ast = parseOk("import.unsafe;\nfunction f(): int { return 1; }");
  const program = nodeAt(ref ast, ast.root);

  let test theory: Case = t.asserts("`import.unsafe;` sets a flag and declares nothing") {
    theory.isSuccessful = program.flagA && program.childCount == 1;
    theory.detail = `unsafe=${program.flagA} with ${program.childCount} top-level node(s), wanted true and 1`;
  }

  let plain = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("a module without the directive is not unsafe") {
    theory.isSuccessful = !nodeAt(ref plain, plain.root).flagA;
    theory.detail = "a module with no import.unsafe came out flagged";
  }

  let test theory: Case = t.asserts("an unknown directive lists the ones that exist") {
    theory.isSuccessful = refusalMentions("import.wat;", "import.unsafe");
    theory.detail = `wanted the known directives listed, got: ${parseError("import.wat;")}`;
  }
}

suite function kindPrefixesInAnnotationsAreKept(): void {
  // `owned string` - the kind is contextual, so two IDENTs in a row is what
  // identifies one. Recorded rather than dropped, even though nothing enforces
  // kinds yet: the limitation is "not enforced", not "not parsed".
  let ast = parseOk("function f(s: owned string): int { return 1; }");
  const annot = firstParamAnnotation(ref ast);

  let test theory: Case = t.asserts("the type is still the type") {
    theory.isSuccessful = str.stringEq(annot.name, "string");
    theory.detail = `the annotation resolved to "${annot.name}", wanted "string"`;
  }
  let test theory: Case = t.asserts("the prefix is recorded on the annotation") {
    const list = nodeAt(ref ast, annot.childB);
    const prefix = nodeAt(ref ast, childAt(ref ast, list, 0));
    theory.isSuccessful = annot.childB != 0 && str.stringEq(prefix.name, "owned");
    theory.detail = `the recorded prefix is "${prefix.name}", wanted "owned"`;
  }

  let bare = parseOk("function f(s: string): int { return 1; }");
  let test theory: Case = t.asserts("an unprefixed annotation records none") {
    theory.isSuccessful = firstParamAnnotation(ref bare).childB == 0;
    theory.detail = "a plain annotation came out with a kind prefix";
  }
}

suite function exportWrapsTheDeclItDecorates(): void {
  let ast = parseOk("export function f(): int { return 1; }");
  const childId = childAt(ref ast, nodeAt(ref ast, ast.root), 0);

  let test theory: Case = t.asserts("`export function` is an EXPORT_DECL, not a flag") {
    theory.isSuccessful = isExportDecl(ref ast, childId);
    theory.detail = `the top-level node is ${nodeAt(ref ast, childId).kind}, wanted EXPORT_DECL`;
  }

  let test theory: Case = t.asserts("declOf looks through the wrapper to the decl") {
    const inner = nodeAt(ref ast, declOf(ref ast, childId));
    theory.isSuccessful = inner.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(inner.name, "f");
    theory.detail = `declOf gave a ${inner.kind} named "${inner.name}", wanted FUNCTION_DECL f`;
  }

  let typeAst = parseOk("export type Point { x: int, y: int }");
  const typeChild = childAt(ref typeAst, nodeAt(ref typeAst, typeAst.root), 0);
  let test theory: Case = t.asserts("`export type` wraps the same way") {
    const inner = nodeAt(ref typeAst, declOf(ref typeAst, typeChild));
    theory.isSuccessful = inner.kind == ASTNodeKind.TYPE_DECL && inner.childCount == 2;
    theory.detail = `declOf gave a ${inner.kind} with ${inner.childCount} field(s), wanted TYPE_DECL with 2`;
  }

  let test theory: Case = t.asserts("declOf is the identity on an unwrapped decl") {
    let bare = parseOk("function g(): int { return 1; }");
    const only = childAt(ref bare, nodeAt(ref bare, bare.root), 0);
    theory.isSuccessful = declOf(ref bare, only) == only;
    theory.detail = "declOf moved a decl that was never wrapped in an export";
  }
}

suite function importFormsOutsideTheSubsetAreRefusedByName(): void {
  let test theory: Case = t.asserts("a side-effect import says so") {
    theory.isSuccessful = refusalMentions("import \"./x.yoop\";", "side-effect imports");
    theory.detail = `wanted a refusal naming side-effect imports, got: ${parseError("import \"./x.yoop\";")}`;
  }

  let test theory: Case = t.asserts("`export let` is refused rather than half-parsed") {
    theory.isSuccessful = refusalMentions("export let x: int = 1;", "export function");
    theory.detail = `wanted a refusal naming the supported export forms, got: ${parseError("export let x: int = 1;")}`;
  }

  // Module-level `let` parses - it is the same decl parser - and is refused in
  // pass A instead, where the difference between a const and a mutable global
  // is a semantic one rather than a syntactic one.
  let test theory: Case = t.asserts("`export const` is a supported form") {
    theory.isSuccessful = parseError("export const X: int = 1;").len == 0;
    theory.detail = `export const failed to parse: ${parseError("export const X: int = 1;")}`;
  }
}

suite function importsMustComeFirst(): void {
  // The whole graph layer reads the LEADING run of IMPORT_DECLs and stops at
  // the first declaration, so an import below one would be silently ignored.
  const src = "function f(): int { return 1; }\nimport { a } from \"./x.yoop\";";

  let test theory: Case = t.asserts("an import below a declaration is refused") {
    theory.isSuccessful = refusalMentions(src, "imports must come first");
    theory.detail = `wanted the imports-first refusal, got: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("several imports in a row are fine") {
    let ast = parseOk("import { a } from \"./a.yoop\";\nimport { b } from \"./b.yoop\";\nfunction f(): int { return 1; }");
    const program = nodeAt(ref ast, ast.root);
    theory.isSuccessful = program.childCount == 3
      && topLevel(ref ast, 0).kind == ASTNodeKind.IMPORT_DECL
      && topLevel(ref ast, 1).kind == ASTNodeKind.IMPORT_DECL;
    theory.detail = `wanted two imports then a function, got ${program.childCount} top-level nodes`;
  }
}

suite function traitDeclCarriesItsMethodSignatures(): void {
  let ast = parseOk("trait Display { function toString(ref self): string; function width(ref self, pad: int): int; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a trait is a TRAIT_DECL at the top level") {
    theory.isSuccessful = decl.kind == ASTNodeKind.TRAIT_DECL && str.stringEq(decl.name, "Display");
    theory.detail = `the first top-level node is ${decl.kind} named "${decl.name}", wanted TRAIT_DECL "Display"`;
  }

  let test theory: Case = t.asserts("each signature is one node in the trait's own child run") {
    theory.isSuccessful = decl.childCount == 2;
    theory.detail = `the trait has ${decl.childCount} method signature(s), wanted 2`;
  }

  const sig = nodeAt(ref ast, childAt(ref ast, decl, 0));
  let test theory: Case = t.asserts("a signature is a METHOD_SIG, not a FUNCTION_DECL") {
    theory.isSuccessful = sig.kind == ASTNodeKind.METHOD_SIG && str.stringEq(sig.name, "toString");
    theory.detail = `the first member is ${sig.kind} named "${sig.name}", wanted METHOD_SIG "toString"`;
  }

  let test theory: Case = t.asserts("a signature has no body, which is what separates it from a method") {
    theory.isSuccessful = sig.childD == 0;
    theory.detail = `the signature's body slot is ${sig.childD}, wanted 0`;
  }
}

// The one thing the parser does that nothing else could: `self` is written
// WITHOUT a type, and the annotation is synthesized from the enclosing type.
// Every later layer depends on it, and none of them would notice it missing
// until a receiver silently typed as the error type.
suite function selfGetsTheEnclosingTypeAsItsAnnotation(): void {
  let ast = parseOk("type Point implements Display { x: int, function toString(ref self): string { return \"p\"; } }");
  const method = typeMember(ref ast, 1);

  let test theory: Case = t.asserts("a method in a type body is a METHOD_DECL with a body") {
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_DECL && method.childD != 0;
    theory.detail = `the member is ${method.kind} with body slot ${method.childD}, wanted METHOD_DECL and non-zero`;
  }

  const params = nodeAt(ref ast, method.childB);
  let test theory: Case = t.asserts("the receiver is an ordinary parameter, so a method is an ordinary function") {
    theory.isSuccessful = params.childCount == 1;
    theory.detail = `the method has ${params.childCount} parameter(s), wanted 1`;
  }

  const receiver = nodeAt(ref ast, childAt(ref ast, params, 0));
  let test theory: Case = t.asserts("the receiver is named self and is marked ref") {
    theory.isSuccessful = str.stringEq(receiver.name, "self") && receiver.flagA;
    theory.detail = `the receiver is "${receiver.name}" with isRef=${receiver.flagA}, wanted "self" and true`;
  }

  const annot = nodeAt(ref ast, receiver.childA);
  let test theory: Case = t.asserts("self's annotation is filled in with the enclosing type's name") {
    theory.isSuccessful = str.stringEq(annot.name, "Point");
    theory.detail = `self annotates as "${annot.name}", wanted "Point"`;
  }
}

suite function implementsClauseIsAListOfAnnotations(): void {
  let bare = parseOk("type Point implements Display, Ord { x: int, }");
  const list = nodeAt(ref bare, topLevel(ref bare, 0).childD);

  let test theory: Case = t.asserts("every named trait lands in the clause's list") {
    theory.isSuccessful = list.childCount == 2;
    theory.detail = `the clause names ${list.childCount} trait(s), wanted 2`;
  }

  let test theory: Case = t.asserts("the first named trait keeps its name") {
    const first = nodeAt(ref bare, childAt(ref bare, list, 0));
    theory.isSuccessful = str.stringEq(first.name, "Display");
    theory.detail = `the first trait is "${first.name}", wanted "Display"`;
  }

  // Both spellings are one clause. The parenthesized form appears throughout
  // std, so a parser that took only the bare one would reject real code.
  let parens = parseOk("type Point implements (Display, Ord) { x: int, }");
  let test theory: Case = t.asserts("the parenthesized form is the same list") {
    const parenList = nodeAt(ref parens, topLevel(ref parens, 0).childD);
    theory.isSuccessful = parenList.childCount == 2;
    theory.detail = `the parenthesized clause names ${parenList.childCount} trait(s), wanted 2`;
  }

  let none = parseOk("type Point { x: int, }");
  let test theory: Case = t.asserts("no clause is 0, not an empty list") {
    theory.isSuccessful = topLevel(ref none, 0).childD == 0;
    theory.detail = `a type with no clause has childD ${topLevel(ref none, 0).childD}, wanted 0`;
  }
}

// A variant's methods share the member run with its cases. The cases keep their
// declaration-order tags either way, and that ordering is ABI.
suite function variantMethodsShareTheMemberRunWithCases(): void {
  let ast = parseOk("variant Status implements Describe { Idle, Done { n: int }, function code(ref self): int { return 0; } }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a variant takes an implements clause the same way a type does") {
    theory.isSuccessful = decl.childD != 0;
    theory.detail = `the variant's implements slot is ${decl.childD}, wanted non-zero`;
  }

  let test theory: Case = t.asserts("cases and methods are all members of the one run") {
    theory.isSuccessful = decl.childCount == 3;
    theory.detail = `the variant has ${decl.childCount} member(s), wanted 3`;
  }

  let test theory: Case = t.asserts("the method is a METHOD_DECL, told apart by the keyword alone") {
    const method = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the third member is ${method.kind}, wanted METHOD_DECL`;
  }
}

suite function selfReadsAsAnOrdinaryLocalInsideABody(): void {
  let ast = parseOk("type Point implements Display { x: int, function get(ref self): int { return self.x; } }");
  const method = typeMember(ref ast, 1);
  const block = nodeAt(ref ast, method.childD);
  const statements = nodeAt(ref ast, block.childA);
  const returned = nodeAt(ref ast, nodeAt(ref ast, childAt(ref ast, statements, 0)).childA);
  const base = nodeAt(ref ast, returned.childA);

  let test theory: Case = t.asserts("self.x is an ordinary field access on an ordinary IDENT") {
    theory.isSuccessful = base.kind == ASTNodeKind.IDENT && str.stringEq(base.name, "self");
    theory.detail = `the access base is ${base.kind} named "${base.name}", wanted IDENT "self"`;
  }
}

suite function templateLiteralsSplitIntoPartsInSourceOrder(): void {
  let plain = parseOk("function f(): string { return `just text`; }");
  const noInterp = returnedExpression(ref plain);

  let test theory: Case = t.asserts("a template literal is a TEMPLATE_LITERAL") {
    theory.isSuccessful = noInterp.kind == ASTNodeKind.TEMPLATE_LITERAL;
    theory.detail = `the returned expression is ${noInterp.kind}, wanted TEMPLATE_LITERAL`;
  }

  let test theory: Case = t.asserts("no interpolation is a single literal run") {
    theory.isSuccessful = noInterp.childCount == 1;
    theory.detail = `an uninterpolated template has ${noInterp.childCount} part(s), wanted 1`;
  }

  let test theory: Case = t.asserts("a literal run holds its DECODED text in the string pool") {
    const part = nodeAt(ref plain, childAt(ref plain, noInterp, 0));
    const text = poolString(ref plain, part.strId);
    theory.isSuccessful = part.kind == ASTNodeKind.STRING_PART && str.stringEq(text, "just text");
    theory.detail = `the part is ${part.kind} holding "${text}", wanted STRING_PART "just text"`;
  }

  let ast = parseOk("function f(): string { return `a${x}b`; }");
  const mixed = returnedExpression(ref ast);

  let test theory: Case = t.asserts("literal runs and interpolations alternate in source order") {
    theory.isSuccessful = mixed.childCount == 3 &&
      nodeAt(ref ast, childAt(ref ast, mixed, 0)).kind == ASTNodeKind.STRING_PART &&
      nodeAt(ref ast, childAt(ref ast, mixed, 1)).kind == ASTNodeKind.EXPR_PART &&
      nodeAt(ref ast, childAt(ref ast, mixed, 2)).kind == ASTNodeKind.STRING_PART;
    theory.detail = `\`a\${x}b\` produced ${mixed.childCount} part(s), wanted STRING_PART, EXPR_PART, STRING_PART`;
  }

  let test theory: Case = t.asserts("an interpolation holds a real expression") {
    const exprPart = nodeAt(ref ast, childAt(ref ast, mixed, 1));
    const inner = nodeAt(ref ast, exprPart.childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.IDENT && str.stringEq(inner.name, "x");
    theory.detail = `the interpolation holds ${inner.kind} named "${inner.name}", wanted IDENT "x"`;
  }

  // An empty literal run would cost a concat operand contributing nothing, so
  // it is never emitted - which is also why the part count is worth asserting.
  let bare = parseOk("function f(): string { return `${x}`; }");
  let test theory: Case = t.asserts("an interpolation alone produces no empty literal runs") {
    theory.isSuccessful = returnedExpression(ref bare).childCount == 1;
    theory.detail = `\`\${x}\` produced ${returnedExpression(ref bare).childCount} part(s), wanted 1`;
  }

  let empty = parseOk("function f(): string { return ``; }");
  let test theory: Case = t.asserts("the empty template has no parts at all") {
    theory.isSuccessful = returnedExpression(ref empty).childCount == 0;
    theory.detail = `the empty template produced ${returnedExpression(ref empty).childCount} part(s), wanted 0`;
  }
}

// Where an interpolation ENDS is decided by the expression parser, not by
// matching braces in the raw text. These are the cases that separate the two:
// brace matching gets every one of them wrong.
suite function interpolationEndsWhereItsExpressionEnds(): void {
  let braces = parseOk("function f(): string { return `v=${g({ x: 1, y: 2 })}!`; }");
  const withBraces = returnedExpression(ref braces);

  let test theory: Case = t.asserts("braces inside an interpolation do not close it") {
    theory.isSuccessful = withBraces.childCount == 3;
    theory.detail = `an interpolated struct literal produced ${withBraces.childCount} part(s), wanted 3`;
  }

  let test theory: Case = t.asserts("the literal run after such an interpolation is intact") {
    const tail = nodeAt(ref braces, childAt(ref braces, withBraces, 2));
    const text = poolString(ref braces, tail.strId);
    theory.isSuccessful = str.stringEq(text, "!");
    theory.detail = `the trailing run is "${text}", wanted "!"`;
  }

  // A `}` inside a nested STRING. The JS reference cannot lex this one at all.
  let quoted = parseOk("function f(): string { return `v=${g(\"}\")}!`; }");
  let test theory: Case = t.asserts("a brace inside a nested string literal does not close it") {
    theory.isSuccessful = returnedExpression(ref quoted).childCount == 3;
    theory.detail = `an interpolated \"}\" produced ${returnedExpression(ref quoted).childCount} part(s), wanted 3`;
  }

  // The parser is repositioned mid-template while interpolations are parsed, so
  // whether it lands back on the token AFTER the template is a real question.
  let resumes = parseOk("function f(): int { const s: string = `a${x}b`; return 1; }");
  let test theory: Case = t.asserts("the parser resumes at the token after the closing backtick") {
    const fn = topLevel(ref resumes, 0);
    const block = nodeAt(ref resumes, fn.childD);
    const statements = nodeAt(ref resumes, block.childA);
    theory.isSuccessful = statements.childCount == 2;
    theory.detail = `the body parsed ${statements.childCount} statement(s) after a template, wanted 2`;
  }
}

suite function templateEscapesAreDecodedNotInterpreted(): void {
  // `\${` is a literal dollar-brace. Without this the escape scan and the
  // interpolation scan disagree, and the text silently becomes an expression.
  let escaped = parseOk("function f(): string { return `\\${x}`; }");
  const node = returnedExpression(ref escaped);

  let test theory: Case = t.asserts("an escaped dollar-brace opens no interpolation") {
    theory.isSuccessful = node.childCount == 1 &&
      nodeAt(ref escaped, childAt(ref escaped, node, 0)).kind == ASTNodeKind.STRING_PART;
    theory.detail = `\`\\\${x}\` produced ${node.childCount} part(s), wanted one STRING_PART`;
  }

  let test theory: Case = t.asserts("and decodes to the literal characters") {
    const part = nodeAt(ref escaped, childAt(ref escaped, node, 0));
    const text = poolString(ref escaped, part.strId);
    theory.isSuccessful = str.stringEq(text, "${x}");
    theory.detail = `the run decoded to "${text}", wanted "\${x}"`;
  }

  let tick = parseOk("function f(): string { return `a\\`b`; }");
  let test theory: Case = t.asserts("a template can escape its own delimiter") {
    const part = nodeAt(ref tick, childAt(ref tick, returnedExpression(ref tick), 0));
    const text = poolString(ref tick, part.strId);
    theory.isSuccessful = str.stringEq(text, "a`b");
    theory.detail = `the run decoded to "${text}", wanted "a\`b"`;
  }

  let test theory: Case = t.asserts("an interpolation with no expression is refused") {
    theory.isSuccessful = parseError("function f(): string { return `${}`; }").len > 0;
    theory.detail = "`${}` parsed without a diagnostic";
  }
}

suite function forInLoopsAreTheirOwnStatement(): void {
  let ast = parseOk("function f(): int { for x in xs { return x; } return 0; }");
  const loop = firstStatement(ref ast);

  let test theory: Case = t.asserts("`for x in xs` is a FOR_IN_LOOP, not a FOR_LOOP") {
    theory.isSuccessful = loop.kind == ASTNodeKind.FOR_IN_LOOP;
    theory.detail = `the statement is ${loop.kind}, wanted FOR_IN_LOOP`;
  }

  let test theory: Case = t.asserts("the loop variable lands on the node's name") {
    theory.isSuccessful = str.stringEq(loop.name, "x");
    theory.detail = `the loop variable is "${loop.name}", wanted "x"`;
  }

  let test theory: Case = t.asserts("the iterable is a real expression, not just a name") {
    let call = parseOk("function f(): int { for e in view(ref h) { return 1; } return 0; }");
    const iterable = nodeAt(ref call, firstStatement(ref call).childA);
    theory.isSuccessful = iterable.kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = `the iterable is ${iterable.kind}, wanted CALL_EXPRESSION`;
  }

  // The keyword is shared, and the token right after it is the whole fork. A
  // counted loop must still reach the counted parser.
  let counted = parseOk("function f(): int { for (let i = 0; i < 3; i = i + 1) { return i; } return 0; }");
  let test theory: Case = t.asserts("the counted form still parses as a FOR_LOOP") {
    theory.isSuccessful = firstStatement(ref counted).kind == ASTNodeKind.FOR_LOOP;
    theory.detail = `the counted form parsed as ${firstStatement(ref counted).kind}, wanted FOR_LOOP`;
  }

  // A loop variable takes no annotation - its type is the element type, so
  // there is nothing to say and a mismatch could not mean anything.
  let test theory: Case = t.asserts("an annotated loop variable is refused") {
    theory.isSuccessful = parseError("function f(): int { for x: int in xs { return x; } return 0; }").len > 0;
    theory.detail = "`for x: int in xs` parsed without a diagnostic";
  }
}

suite function kindDeclarationsRecordTheirClauses(): void {
  let ast = parseOk("kind disposable { appliesTo binding; requires Disposable; mustCall dispose beforeScopeEnd; ownsBlock; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("`kind NAME { ... }` is a KIND_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.KIND_DECL && str.stringEq(decl.name, "disposable");
    theory.detail = `the first top-level node is ${decl.kind} named "${decl.name}", wanted KIND_DECL "disposable"`;
  }

  let test theory: Case = t.asserts("each clause is one node in the decl's own child run") {
    theory.isSuccessful = decl.childCount == 4;
    theory.detail = `the kind has ${decl.childCount} clause(s), wanted 4`;
  }

  // A clause is a run of tokens ending in `;`, recorded by its LEADING WORD.
  // Some of these words are keywords in this lexer and some are not, so the
  // name comes from the source text rather than the tag - otherwise the two
  // spellings would record differently.
  let test theory: Case = t.asserts("a clause is named for its leading word, keyword or not") {
    const first = nodeAt(ref ast, childAt(ref ast, decl, 0));
    const last = nodeAt(ref ast, childAt(ref ast, decl, 3));
    theory.isSuccessful = str.stringEq(first.name, "appliesTo") && str.stringEq(last.name, "ownsBlock");
    theory.detail = `clauses recorded as "${first.name}" ... "${last.name}", wanted "appliesTo" ... "ownsBlock"`;
  }

  let test theory: Case = t.asserts("a multi-word clause is still one clause") {
    const third = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = str.stringEq(third.name, "mustCall");
    theory.detail = `the third clause is "${third.name}", wanted "mustCall"`;
  }

  let params = parseOk("kind aligned(n: usize) { appliesTo binding; }");
  let test theory: Case = t.asserts("a parameterized kind keeps its parameter list") {
    theory.isSuccessful = topLevel(ref params, 0).childA != 0;
    theory.detail = "`kind aligned(n: usize)` recorded no parameter list";
  }

  // A clause body can be a braced block, so a clause ends at the `;` at DEPTH
  // ZERO. Stopping at the first `;` leaves a stray `}` that surfaces much later
  // as "unexpected token at top level".
  let braced = parseOk("kind c_layout { appliesTo type; layout { abi \"C\"; }; }\nfunction f(): int { return 1; }");
  let test theory: Case = t.asserts("a braced clause body does not end the clause early") {
    theory.isSuccessful = topLevel(ref braced, 0).childCount == 2 &&
      topLevel(ref braced, 1).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `recorded ${topLevel(ref braced, 0).childCount} clause(s), and the next decl is ${topLevel(ref braced, 1).kind}`;
  }

  // A kind on a TYPE is written AFTER the name, unlike the one on a function.
  let onType = parseOk("type SockAddrIn c_layout { x: int, }");
  let test theory: Case = t.asserts("a type takes its kind after the name") {
    const decl = topLevel(ref onType, 0);
    theory.isSuccessful = decl.kind == ASTNodeKind.TYPE_DECL && decl.childB != 0 && decl.childCount == 1;
    theory.detail = `the decl is ${decl.kind} with kind slot ${decl.childB} and ${decl.childCount} field(s)`;
  }

  let withArgs = parseOk("type Buf aligned(16) { x: int, }");
  let test theory: Case = t.asserts("a kind's arguments are consumed, not left to confuse the body") {
    theory.isSuccessful = topLevel(ref withArgs, 0).childCount == 1;
    theory.detail = `the decl recorded ${topLevel(ref withArgs, 0).childCount} field(s), wanted 1`;
  }

  let composed = parseOk("kind scoped = disposable_base & noescape;\nfunction f(): int { return 1; }");
  let test theory: Case = t.asserts("a composition parses and does not swallow what follows") {
    theory.isSuccessful = topLevel(ref composed, 0).kind == ASTNodeKind.KIND_DECL &&
      topLevel(ref composed, 1).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `after a composition the next decl is ${topLevel(ref composed, 1).kind}, wanted FUNCTION_DECL`;
  }
}

// `async` is a kind, not a keyword - so a kind prefix stands where `function`
// would rather than in front of it, and the parser needs no list of blessed
// words to recognize one.
suite function kindPrefixesReplaceTheFunctionKeyword(): void {
  let ast = parseOk("async fetch(u: string): string { return u; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a kind-prefixed declaration is an ordinary FUNCTION_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(decl.name, "fetch");
    theory.detail = `the node is ${decl.kind} named "${decl.name}", wanted FUNCTION_DECL "fetch"`;
  }

  let test theory: Case = t.asserts("the prefix is recorded rather than dropped") {
    const prefixes = nodeAt(ref ast, decl.childE);
    const first = nodeAt(ref ast, childAt(ref ast, prefixes, 0));
    theory.isSuccessful = prefixes.childCount == 1 && str.stringEq(first.name, "async");
    theory.detail = `recorded ${prefixes.childCount} prefix(es), first "${first.name}", wanted 1 and "async"`;
  }

  let test theory: Case = t.asserts("the parameters and return type survive the shared path") {
    const params = nodeAt(ref ast, decl.childB);
    theory.isSuccessful = params.childCount == 1 && decl.childC != 0 && decl.childD != 0;
    theory.detail = `${params.childCount} param(s), return slot ${decl.childC}, body slot ${decl.childD}`;
  }

  let several = parseOk("pooled tainted buf(): int { return 1; }");
  let test theory: Case = t.asserts("several prefixes all land in the list") {
    theory.isSuccessful = nodeAt(ref several, topLevel(ref several, 0).childE).childCount == 2;
    theory.detail = `recorded ${nodeAt(ref several, topLevel(ref several, 0).childE).childCount} prefix(es), wanted 2`;
  }

  // The plain form has to keep working: the two spellings share everything from
  // the name onward, so a change to one is a change to both.
  let plain = parseOk("function fetch(u: string): string { return u; }");
  let test theory: Case = t.asserts("a plain `function` still parses, with no prefixes") {
    theory.isSuccessful = topLevel(ref plain, 0).kind == ASTNodeKind.FUNCTION_DECL &&
      topLevel(ref plain, 0).childE == 0;
    theory.detail = `plain function recorded prefix slot ${topLevel(ref plain, 0).childE}, wanted 0`;
  }

  let exported = parseOk("export async fetch(): int { return 1; }");
  let test theory: Case = t.asserts("`export async` reaches the same parser") {
    const inner = nodeAt(ref exported, topLevel(ref exported, 0).childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.FUNCTION_DECL && inner.childE != 0;
    theory.detail = `the exported decl is ${inner.kind} with prefix slot ${inner.childE}`;
  }

  let exportedKind = parseOk("export kind async { appliesTo function; pausable; }");
  let test theory: Case = t.asserts("`export kind` reaches the kind parser") {
    const inner = nodeAt(ref exportedKind, topLevel(ref exportedKind, 0).childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.KIND_DECL;
    theory.detail = `the exported decl is ${inner.kind}, wanted KIND_DECL`;
  }

  // The one async form the bootstrap's own std closure needs, and the one that
  // needs no codegen at all - a signature has no body to emit.
  let sig = parseOk("trait Readable { async read(ref self, ref buf: uint8[]): int; }");
  let test theory: Case = t.asserts("a trait method signature takes a kind prefix too") {
    const method = nodeAt(ref sig, childAt(ref sig, topLevel(ref sig, 0), 0));
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_SIG && method.childE != 0 && method.childD == 0;
    theory.detail = `the member is ${method.kind}, prefix slot ${method.childE}, body slot ${method.childD}`;
  }
}

suite function propagatesClausesAreRecorded(): void {
  let fn = parseOk("function vecNew(n: usize): int propagates<disposable> { return 1; }");
  const decl = topLevel(ref fn, 0);

  let test theory: Case = t.asserts("a function's clause lands in its own slot") {
    theory.isSuccessful = decl.childF != 0;
    theory.detail = `the function's propagates slot is ${decl.childF}, wanted non-zero`;
  }

  let test theory: Case = t.asserts("the clause is a list of the kinds it names") {
    const list = nodeAt(ref fn, decl.childF);
    const first = nodeAt(ref fn, childAt(ref fn, list, 0));
    theory.isSuccessful = list.childCount == 1 && str.stringEq(first.name, "disposable");
    theory.detail = `recorded ${list.childCount} kind(s), first "${first.name}", wanted 1 and "disposable"`;
  }

  let test theory: Case = t.asserts("the body still parses after the clause") {
    theory.isSuccessful = decl.childD != 0;
    theory.detail = `the body slot is ${decl.childD}, wanted non-zero`;
  }

  let several = parseOk("function f(): int propagates<disposable, tainted> { return 1; }");
  let test theory: Case = t.asserts("several kinds all land in the list") {
    theory.isSuccessful = nodeAt(ref several, topLevel(ref several, 0).childF).childCount == 2;
    theory.detail = `recorded ${nodeAt(ref several, topLevel(ref several, 0).childF).childCount} kind(s), wanted 2`;
  }

  let none = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("no clause is 0, not an empty list") {
    theory.isSuccessful = topLevel(ref none, 0).childF == 0;
    theory.detail = `a function with no clause has childF ${topLevel(ref none, 0).childF}, wanted 0`;
  }

  let onType = parseOk("type Buf propagates<disposable> { n: int, }");
  let test theory: Case = t.asserts("a type takes the clause after its name") {
    const t2 = topLevel(ref onType, 0);
    theory.isSuccessful = t2.kind == ASTNodeKind.TYPE_DECL && t2.childF != 0 && t2.childCount == 1;
    theory.detail = `the decl is ${t2.kind} with clause slot ${t2.childF} and ${t2.childCount} field(s)`;
  }

  // The clauses have a fixed order, and a parser that took them in the wrong
  // one would read `propagates` as a trait name.
  let both = parseOk("variant R implements Disposable propagates<disposable> { A, B }");
  let test theory: Case = t.asserts("a variant takes implements and propagates, in that order") {
    const v = topLevel(ref both, 0);
    theory.isSuccessful = v.childD != 0 && v.childF != 0 && v.childCount == 2;
    theory.detail = `implements slot ${v.childD}, propagates slot ${v.childF}, ${v.childCount} case(s)`;
  }
}

// `Buf propagates<tracked>` and `disposable Buf` are both two identifiers in a
// row: one is a type followed by a clause, the other a kind prefix followed by
// a type. `propagates` is contextual, so telling them apart means reading the
// second identifier's TEXT rather than its tag - and getting it wrong makes
// `propagates` itself the type name, which reads as "unknown type propagates".
suite function aClauseKeywordIsNotAKindPrefix(): void {
  let ast = parseOk("function make(): Buf propagates<tracked> { return 1; }");
  const decl = topLevel(ref ast, 0);
  const ret = nodeAt(ref ast, decl.childC);

  let test theory: Case = t.asserts("the return type is the type, not the clause keyword") {
    theory.isSuccessful = str.stringEq(ret.name, "Buf");
    theory.detail = `the return type parsed as "${ret.name}", wanted "Buf"`;
  }

  let test theory: Case = t.asserts("and the clause is still recorded") {
    theory.isSuccessful = decl.childF != 0;
    theory.detail = `the clause slot is ${decl.childF}, wanted non-zero`;
  }

  // The real kind-prefix form has to keep working, or the guard above is just
  // breaking prefixes to fix clauses.
  let prefixed = parseOk("type Handle disposable { n: int, }");
  let test theory: Case = t.asserts("a genuine kind on a type still parses") {
    theory.isSuccessful = topLevel(ref prefixed, 0).childB != 0;
    theory.detail = `the kind slot is ${topLevel(ref prefixed, 0).childB}, wanted non-zero`;
  }
}

suite function charLiteralsAreIntegerLiterals(): void {
  let ast = parseOk("function f(): int { return 'a'; }");
  const node = returnedExpression(ref ast);

  // The lexer already decoded the codepoint, so there is nothing for a separate
  // node kind to carry - and making one would give the typechecker a second
  // literal to pin, for no gain.
  let test theory: Case = t.asserts("a char literal builds an INT_LITERAL") {
    theory.isSuccessful = node.kind == ASTNodeKind.INT_LITERAL;
    theory.detail = `'a' parsed as ${node.kind}, wanted INT_LITERAL`;
  }

  let test theory: Case = t.asserts("carrying the codepoint as its value") {
    theory.isSuccessful = node.intVal == 97;
    theory.detail = `'a' has value ${node.intVal}, wanted 97`;
  }

  let escaped = parseOk("function f(): int { return '\\n'; }");
  let test theory: Case = t.asserts("an escape decodes to its byte") {
    theory.isSuccessful = returnedExpression(ref escaped).intVal == 10;
    theory.detail = `'\\n' has value ${returnedExpression(ref escaped).intVal}, wanted 10`;
  }

  let quote = parseOk("function f(): int { return '\\''; }");
  let test theory: Case = t.asserts("a char literal can escape its own delimiter") {
    theory.isSuccessful = returnedExpression(ref quote).intVal == 39;
    theory.detail = `'\\'' has value ${returnedExpression(ref quote).intVal}, wanted 39`;
  }

  // In a PATTERN too. `case '0', '1':` is how std spells a digit test, and the
  // pattern parser has its own literal path that would otherwise reject it.
  let pattern = parseOk("function f(b: uint8): int { switch (b) { case '0': { return 1; } default: { return 0; } } }");
  let test theory: Case = t.asserts("a char literal works as a switch pattern") {
    theory.isSuccessful = firstSwitchPattern(ref pattern).intVal == 48;
    theory.detail = `case '0' has value ${firstSwitchPattern(ref pattern).intVal}, wanted 48`;
  }
}

suite function functionTypeAnnotationsParse(): void {
  let ast = parseOk("type Ops { hash: (k: string, n: usize) => uint64, }");
  const field = nodeAt(ref ast, childAt(ref ast, topLevel(ref ast, 0), 0));
  const annot = nodeAt(ref ast, field.childA);

  let test theory: Case = t.asserts("a `=>` annotation is a FUNC_TYPE") {
    theory.isSuccessful = annot.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE;
    theory.detail = `the field's annotation is ${annot.kind}, wanted TYPE_ANNOTATION_FUNC_TYPE`;
  }

  let test theory: Case = t.asserts("its parameters land in a list, its return in childB") {
    const params = nodeAt(ref ast, annot.childA);
    theory.isSuccessful = params.childCount == 2 && annot.childB != 0;
    theory.detail = `${params.childCount} param(s), return slot ${annot.childB}`;
  }

  let none = parseOk("type Ops { run: () => void, }");
  let test theory: Case = t.asserts("an empty parameter list is legal") {
    const a2 = nodeAt(ref none, nodeAt(ref none, childAt(ref none, topLevel(ref none, 0), 0)).childA);
    theory.isSuccessful = a2.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE &&
      nodeAt(ref none, a2.childA).childCount == 0;
    theory.detail = `an empty parameter list parsed as ${a2.kind}`;
  }

  let refParam = parseOk("type Ops { fill: (ref buf: uint8[]) => void, }");
  let test theory: Case = t.asserts("a ref parameter is part of the signature") {
    const a3 = nodeAt(ref refParam, nodeAt(ref refParam, childAt(ref refParam, topLevel(ref refParam, 0), 0)).childA);
    const p0 = nodeAt(ref refParam, childAt(ref refParam, nodeAt(ref refParam, a3.childA), 0));
    theory.isSuccessful = p0.flagA;
    theory.detail = `the parameter's isRef is ${p0.flagA}, wanted true`;
  }
}

// A return type is parsed GREEDILY, so `(k: K) => V[]` is a function returning
// an array. A parenthesized group is the only way to lift the array out, and it
// exists for exactly that.
suite function parenthesizedTypeGroupsAttachArraySuffixes(): void {
  let grouped = parseOk("type T { fns: ((k: string) => uint64)[], }");
  const outer = nodeAt(ref grouped, nodeAt(ref grouped, childAt(ref grouped, topLevel(ref grouped, 0), 0)).childA);

  let test theory: Case = t.asserts("a group lifts the array out to the whole function type") {
    theory.isSuccessful = outer.kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE &&
      nodeAt(ref grouped, outer.childA).kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE;
    theory.detail = `outer is ${outer.kind}, inner is ${nodeAt(ref grouped, outer.childA).kind}`;
  }

  let greedy = parseOk("type T { f: (k: string) => uint64[], }");
  let test theory: Case = t.asserts("without a group the array binds to the RETURN type") {
    const a = nodeAt(ref greedy, nodeAt(ref greedy, childAt(ref greedy, topLevel(ref greedy, 0), 0)).childA);
    theory.isSuccessful = a.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE &&
      nodeAt(ref greedy, a.childB).kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE;
    theory.detail = `annotation is ${a.kind}, its return is ${nodeAt(ref greedy, a.childB).kind}`;
  }

  // The fork is decided at one token of lookahead, which is why parameters must
  // be named: `(T)` and `(T) => R` would otherwise be indistinguishable.
  let plainGroup = parseOk("type T { xs: (uint8)[], }");
  let test theory: Case = t.asserts("a group with no `=>` is just a parenthesized type") {
    const a = nodeAt(ref plainGroup, nodeAt(ref plainGroup, childAt(ref plainGroup, topLevel(ref plainGroup, 0), 0)).childA);
    theory.isSuccessful = a.kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE;
    theory.detail = `(uint8)[] parsed as ${a.kind}, wanted an array`;
  }
}

// A call through anything but a name or a field used to be accepted and then
// SILENTLY miscompiled - the arguments were dropped and the function pointer
// itself became the value. It only became reachable when `((k: K) => V)[]`
// started parsing.
suite function callingAValueThatIsNotANameOrFieldIsRefused(): void {
  let test theory: Case = t.asserts("calling an indexed element is refused") {
    theory.isSuccessful = refusalMentions(
      "function f(): int { return fns[0](1); }",
      "can only be called through a name or a field"
    );
    theory.detail = "`fns[0](1)` parsed without a diagnostic";
  }

  let test theory: Case = t.asserts("so is calling a call's result") {
    theory.isSuccessful = refusalMentions(
      "function f(): int { return g()(1); }",
      "can only be called through a name or a field"
    );
    theory.detail = "`g()(1)` parsed without a diagnostic";
  }

  // The two supported spellings must still work, or the refusal above is just
  // breaking calls.
  let test theory: Case = t.asserts("a plain call and a field call still parse") {
    theory.isSuccessful = parseError("function f(): int { return g(1); }").len == 0 &&
      parseError("function f(): int { return ops.hash(1); }").len == 0;
    theory.detail = "a supported call form was refused";
  }
}

suite function sliceExpressionsAreNotIndexes(): void {
  let both = parseOk("function f(): int { return xs[1..3]; }");
  const sliced = returnedExpression(ref both);

  // An index and a slice open the same way, so the index expression is parsed
  // FIRST and reinterpreted when a `..` follows - not looked ahead for.
  let test theory: Case = t.asserts("`xs[a..b]` is a SLICE_EXPRESSION") {
    theory.isSuccessful = sliced.kind == ASTNodeKind.SLICE_EXPRESSION &&
      sliced.childB != 0 && sliced.childC != 0;
    theory.detail = `parsed as ${sliced.kind}, start ${sliced.childB}, end ${sliced.childC}`;
  }

  let indexed = parseOk("function f(): int { return xs[1]; }");
  let test theory: Case = t.asserts("`xs[a]` is still an INDEX_EXPRESSION") {
    theory.isSuccessful = returnedExpression(ref indexed).kind == ASTNodeKind.INDEX_EXPRESSION;
    theory.detail = `parsed as ${returnedExpression(ref indexed).kind}, wanted INDEX_EXPRESSION`;
  }

  // An omitted bound is 0 rather than a synthesized literal: "to the end" is
  // the base's length, and codegen is the only layer that has it.
  let openEnd = parseOk("function f(): int { return xs[1..]; }");
  let test theory: Case = t.asserts("an omitted END is 0, not a synthesized bound") {
    const n = returnedExpression(ref openEnd);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB != 0 && n.childC == 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted a start and 0`;
  }

  let openStart = parseOk("function f(): int { return xs[..2]; }");
  let test theory: Case = t.asserts("an omitted START is 0 too") {
    const n = returnedExpression(ref openStart);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB == 0 && n.childC != 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted 0 and an end`;
  }

  let openBoth = parseOk("function f(): int { return xs[..]; }");
  let test theory: Case = t.asserts("both bounds may be omitted") {
    const n = returnedExpression(ref openBoth);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB == 0 && n.childC == 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted 0 and 0`;
  }

  // A slice is a postfix like any other, so it chains.
  let chained = parseOk("function f(): int { return xs[1..3][0]; }");
  let test theory: Case = t.asserts("a slice chains with an index") {
    const n = returnedExpression(ref chained);
    theory.isSuccessful = n.kind == ASTNodeKind.INDEX_EXPRESSION &&
      nodeAt(ref chained, n.childA).kind == ASTNodeKind.SLICE_EXPRESSION;
    theory.detail = `outer ${n.kind}, inner ${nodeAt(ref chained, n.childA).kind}`;
  }
}

suite function vtablesAndNullParse(): void {
  let ast = parseOk("vtable Reader for Readable { read: () => int, }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("`vtable N for T { ... }` is a VTABLE_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.VTABLE_DECL && str.stringEq(decl.name, "Reader");
    theory.detail = `parsed as ${decl.kind} named "${decl.name}"`;
  }

  let test theory: Case = t.asserts("the erased trait and the fields both land") {
    theory.isSuccessful = decl.childA != 0 && decl.childCount == 1;
    theory.detail = `trait slot ${decl.childA}, ${decl.childCount} field(s)`;
  }

  let exported = parseOk("export vtable Reader for Readable { read: () => int, }");
  let test theory: Case = t.asserts("`export vtable` reaches the same parser") {
    theory.isSuccessful = nodeAt(ref exported, topLevel(ref exported, 0).childA).kind == ASTNodeKind.VTABLE_DECL;
    theory.detail = `the exported decl is ${nodeAt(ref exported, topLevel(ref exported, 0).childA).kind}`;
  }

  let nul = parseOk("function f(): int { return null; }");
  let test theory: Case = t.asserts("`null` is its own literal, carrying no value") {
    theory.isSuccessful = returnedExpression(ref nul).kind == ASTNodeKind.NULL_LITERAL;
    theory.detail = `null parsed as ${returnedExpression(ref nul).kind}`;
  }
}

// `&` and `*` are each both a prefix and a binary operator. The prefix position
// is where a binary operator cannot appear, so there is no ambiguity and no
// lookahead - but the two readings have to actually come out different.
suite function prefixAmpAndStarAreNotTheBinaryOnes(): void {
  let addr = parseOk("function f(): int { return &n; }");
  let test theory: Case = t.asserts("a leading `&` is ADDRESS_OF") {
    theory.isSuccessful = returnedExpression(ref addr).kind == ASTNodeKind.ADDRESS_OF_EXPRESSION;
    theory.detail = `&n parsed as ${returnedExpression(ref addr).kind}`;
  }

  let deref = parseOk("function f(): int { return *p; }");
  let test theory: Case = t.asserts("a leading `*` is DEREF") {
    theory.isSuccessful = returnedExpression(ref deref).kind == ASTNodeKind.DEREF_EXPRESSION;
    theory.detail = `*p parsed as ${returnedExpression(ref deref).kind}`;
  }

  let band = parseOk("function f(): int { return a & b; }");
  let test theory: Case = t.asserts("an infix `&` is still a binary expression") {
    theory.isSuccessful = returnedExpression(ref band).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `a & b parsed as ${returnedExpression(ref band).kind}`;
  }

  let mul = parseOk("function f(): int { return a * b; }");
  let test theory: Case = t.asserts("an infix `*` is still a binary expression") {
    theory.isSuccessful = returnedExpression(ref mul).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `a * b parsed as ${returnedExpression(ref mul).kind}`;
  }

  // The one that actually bit: assignment binds LOOSEST, so a prefix operand
  // must not swallow it. Without the guard `*p = 9` becomes `*(p = 9)`, which
  // reports "cannot assign to const p" and points at the wrong thing.
  let store = parseOk("function f(): void { *p = 9; }");
  let test theory: Case = t.asserts("`*p = 9` assigns THROUGH the pointer") {
    const stmt = nodeAt(ref store, firstStatement(ref store).childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.ASSIGNMENT &&
      nodeAt(ref store, stmt.childA).kind == ASTNodeKind.DEREF_EXPRESSION;
    theory.detail = `the statement is ${stmt.kind} with target ${nodeAt(ref store, stmt.childA).kind}`;
  }

  let compound = parseOk("function f(): void { *p = *p * 3; }");
  let test theory: Case = t.asserts("and the right-hand side may deref too") {
    const stmt = nodeAt(ref compound, firstStatement(ref compound).childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.ASSIGNMENT &&
      nodeAt(ref compound, stmt.childB).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `the value is ${nodeAt(ref compound, stmt.childB).kind}`;
  }
}

// ----- helpers ---------------------------------------------------------------

// Parses, or hands back an empty arena so the assertion that asked fails rather
// than the test crashing.
function parseOk(src: string): AST propagates<disposable> {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parse(vec.vecAsArray(ref srcBuf))) {
    case Result.Ok { value: ast }: { return ast; }
    case Result.Err { error: e }: { return emptyArena(); }
  }
}

// The parse error's message, or "" when the source parsed clean.
function parseError(src: string): string {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parse(vec.vecAsArray(ref srcBuf))) {
    case Result.Ok { value: ast }: { return ""; }
    case Result.Err { error: e }: { return e.rawMessage; }
  }
}

// True when `src` is refused AND the message names `needle`. Both halves
// matter: a refusal with the wrong message sends the reader somewhere else.
function refusalMentions(src: string, needle: string): bool {
  const message = parseError(src);
  if (message.len == 0) {
    return false;
  }
  return str.stringIndexOf(message, needle) < message.len;
}

// Total on purpose. A failed `parseOk` hands back an EMPTY arena, and indexing
// a PROGRAM with no children walked off the end of the arena and took the whole
// test binary down with a segfault - so a broken source literal killed the run
// instead of failing one assertion. Every navigation helper below stops at the
// sentinel node instead.
function topLevel(ref ast: AST, i: usize): ASTNode {
  const program = nodeAt(ref ast, ast.root);
  if (i >= program.childCount) {
    return nodeAt(ref ast, 0);
  }
  return nodeAt(ref ast, childAt(ref ast, program, i));
}

// The expression in `function f(): int { return <expr>; }` - the shortest route
// from a source literal to an expression node.
function returnedExpression(ref ast: AST): ASTNode {
  return nodeAt(ref ast, firstStatement(ref ast).childA);
}

// The first pattern of the first arm of `function f(): int { switch ... }`.
function firstSwitchPattern(ref ast: AST): ASTNode {
  const sw = firstStatement(ref ast);
  const arm = nodeAt(ref ast, childAt(ref ast, sw, 0));
  const patterns = nodeAt(ref ast, arm.childA);
  return nodeAt(ref ast, childAt(ref ast, patterns, 0));
}

// The annotation on `const v: <annot> = ...` in the first statement.
function firstVarDeclAnnotation(ref ast: AST): ASTNode {
  return nodeAt(ref ast, firstStatement(ref ast).childA);
}

// The annotation on the first parameter of `function f(x: <annot>)`.
function firstParamAnnotation(ref ast: AST): ASTNode {
  const fn = topLevel(ref ast, 0);
  const params = nodeAt(ref ast, fn.childB);
  return nodeAt(ref ast, nodeAt(ref ast, childAt(ref ast, params, 0)).childA);
}

function firstStatement(ref ast: AST): ASTNode {
  const fn = topLevel(ref ast, 0);
  const block = nodeAt(ref ast, fn.childD);
  const statements = nodeAt(ref ast, block.childA);
  return nodeAt(ref ast, childAt(ref ast, statements, 0));
}

// The i-th member of `type T { ... }` at the top of the file.
function typeMember(ref ast: AST, i: usize): ASTNode {
  const decl = topLevel(ref ast, 0);
  if (i >= decl.childCount) {
    return nodeAt(ref ast, 0);
  }
  return nodeAt(ref ast, childAt(ref ast, decl, i));
}

function poolString(ref ast: AST, id: usize): string {
  if (id >= ast.strings.len) {
    return "";
  }
  return vec.vecGet(ref ast.strings, id);
}
