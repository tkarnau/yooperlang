// Tests for the `parse` module - the import and export declarations.
//
// These assert the ARENA SHAPE, because that shape is a contract every later
// layer reads: the module graph pulls a source path out of `strId`, pass B
// walks the specifier run, and four separate walks look through an EXPORT_DECL.
// A test that only checked "it parses" would let any of those drift.
//
// The refusals are here for the same reason as the acceptances. Every form
// outside the subset has to fail BY NAME - a silently dropped import resurfaces
// much later as "unknown function", pointing at the wrong file.

import.test;
import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import * as intr from "std/core/intrinsics.yoop";
import * as str from "std/core/strings.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Result } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, emptyArena, isExportDecl, isCExportDecl, nodeAt } from "../ast";
import { parse, parseInto, expandDerives } from "../parse";
import { TokenTags, tagName } from "../lex";

suite function namedImportsBuildSpecifierNodes(): void {
  let ast = parseOk("import { add, scale as times } from \"./lib/mathx.yoop\";");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("an import is an IMPORT_DECL at the top level") {
    theory.isSuccessful = decl.kind == ASTNodeKind.IMPORT_DECL;
    theory.detail = `the first top-level node is ${decl.kind}, wanted IMPORT_DECL`;
  }

  let test theory: Case = t.asserts("the decoded source path lands in the string pool") {
    const path = poolString(ref ast, decl.strId);
    theory.isSuccessful = str.stringEq(path, "./lib/mathx.yoop");
    theory.detail = `the interned source path is "${path}", wanted "./lib/mathx.yoop"`;
  }

  let test theory: Case = t.asserts("each specifier is one node in the decl's own child run") {
    theory.isSuccessful = decl.childCount == 2;
    theory.detail = `the import has ${decl.childCount} specifier(s), wanted 2`;
  }

  const plain = nodeAt(ref ast, childAt(ref ast, decl, 0));
  let test theory: Case = t.asserts("a bare specifier binds the export name locally") {
    theory.isSuccessful = plain.kind == ASTNodeKind.IMPORT_SPECIFIER
      && str.stringEq(plain.name, "add")
      && str.stringEq(poolString(ref ast, plain.strId), "add");
    theory.detail = `{ add } gave local "${plain.name}" / export "${poolString(ref ast, plain.strId)}"`;
  }

  // The half that a single `name` slot could not carry, and the reason
  // IMPORT_SPECIFIER exists at all.
  const aliased = nodeAt(ref ast, childAt(ref ast, decl, 1));
  let test theory: Case = t.asserts("an aliased specifier keeps BOTH names") {
    theory.isSuccessful = str.stringEq(aliased.name, "times")
      && str.stringEq(poolString(ref ast, aliased.strId), "scale");
    theory.detail = `{ scale as times } gave local "${aliased.name}" / export "${poolString(ref ast, aliased.strId)}", wanted times / scale`;
  }
}

suite function theModuleHeaderLandsOnTheProgramNode(): void {
  // The header is what makes a file part of a DIRECTORY module. The graph reads
  // it with three tokens of lexing before choosing an arena (see header.yoop);
  // this is the same name, recorded in the AST.
  let ast = parseOk("module lex;\nimport { A } from \"./a.yoop\";\nfunction f(): int { return 1; }");
  const program = nodeAt(ref ast, ast.root);

  let test theory: Case = t.asserts("the declared name lands on PROGRAM") {
    theory.isSuccessful = str.stringEq(program.name, "lex");
    theory.detail = `the program declares module "${program.name}", wanted "lex"`;
  }
  let test theory: Case = t.asserts("the header is not a top-level declaration") {
    theory.isSuccessful = program.childCount == 2;
    theory.detail = `the header file has ${program.childCount} top-level nodes, wanted 2 (the import and the function)`;
  }

  let bare = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("a file with no header declares no module") {
    theory.isSuccessful = nodeAt(ref bare, bare.root).name.len == 0;
    theory.detail = `a headerless file declared module "${nodeAt(ref bare, bare.root).name}"`;
  }

  // It has to be FIRST, above the imports - which is where the graph looks.
  const late = "import { A } from \"./a.yoop\";\nmodule lex;";
  let test theory: Case = t.asserts("a header below anything else is refused") {
    theory.isSuccessful = refusalMentions(late, "must be the FIRST thing");
    theory.detail = `wanted a header-position refusal, got: ${parseError(late)}`;
  }
}

suite function namespaceImportsBindOneNameToTheModule(): void {
  let ast = parseOk("import * as mathx from \"./lib/mathx.yoop\";");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("the namespace local name lands on the decl") {
    theory.isSuccessful = str.stringEq(decl.name, "mathx");
    theory.detail = `the import bound namespace "${decl.name}", wanted "mathx"`;
  }
  let test theory: Case = t.asserts("a namespace clause produces no specifiers") {
    theory.isSuccessful = decl.childCount == 0;
    theory.detail = `a bare \`* as\` import produced ${decl.childCount} specifier(s), wanted 0`;
  }

  // Both clauses, one source path. The order they are written in is free, which
  // is why the parser reads them as two independent optional clauses.
  let both = parseOk("import { Point }, * as mathx from \"./lib/mathx.yoop\";");
  const combined = topLevel(ref both, 0);
  let test theory: Case = t.asserts("the combined form carries a namespace AND specifiers") {
    theory.isSuccessful = str.stringEq(combined.name, "mathx") && combined.childCount == 1;
    theory.detail = `\`{ Point }, * as mathx\` gave namespace "${combined.name}" and ${combined.childCount} specifier(s)`;
  }

  let reversed = parseOk("import * as mathx, { Point } from \"./lib/mathx.yoop\";");
  const flipped = topLevel(ref reversed, 0);
  let test theory: Case = t.asserts("the clauses may be written in either order") {
    theory.isSuccessful = str.stringEq(flipped.name, "mathx") && flipped.childCount == 1;
    theory.detail = `\`* as mathx, { Point }\` gave namespace "${flipped.name}" and ${flipped.childCount} specifier(s)`;
  }

  let named = parseOk("import { Point } from \"./lib/mathx.yoop\";");
  let test theory: Case = t.asserts("a plain named import leaves the namespace name empty") {
    theory.isSuccessful = topLevel(ref named, 0).name.len == 0;
    theory.detail = `a named-only import bound namespace "${topLevel(ref named, 0).name}", wanted none`;
  }
}

suite function aQualifiedCallIsACallNotAFieldRead(): void {
  // The parser cannot tell `mathx.add(1, 2)` from a field holding a function -
  // that needs name resolution - so it records the SHAPE and pass D decides.
  let ast = parseOk("function f(): int { return mathx.add(1, 2); }");
  const call = returnedExpression(ref ast);

  let test theory: Case = t.asserts("`ns.fn(args)` parses as a CALL_EXPRESSION") {
    theory.isSuccessful = call.kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = `mathx.add(1, 2) parsed as ${call.kind}, wanted CALL_EXPRESSION`;
  }
  let test theory: Case = t.asserts("the member is in `name`, exactly like an unqualified call") {
    theory.isSuccessful = str.stringEq(call.name, "add");
    theory.detail = `the call name is "${call.name}", wanted the member "add"`;
  }
  let test theory: Case = t.asserts("the base it was reached through is in childB") {
    const base = nodeAt(ref ast, call.childB);
    theory.isSuccessful = call.childB != 0
      && base.kind == ASTNodeKind.IDENT
      && str.stringEq(base.name, "mathx");
    theory.detail = `childB is a ${base.kind} named "${base.name}", wanted IDENT mathx`;
  }

  // The regression this could easily cause: a field READ must stay a field read.
  let field = parseOk("function f(): int { return p.x; }");
  const read = returnedExpression(ref field);
  let test theory: Case = t.asserts("a dotted name with no arguments is still a FIELD_ACCESS") {
    theory.isSuccessful = read.kind == ASTNodeKind.FIELD_ACCESS && str.stringEq(read.name, "x");
    theory.detail = `p.x parsed as ${read.kind} named "${read.name}", wanted FIELD_ACCESS x`;
  }

  let plain = parseOk("function f(): int { return add(1, 2); }");
  let test theory: Case = t.asserts("an unqualified call has no base") {
    theory.isSuccessful = returnedExpression(ref plain).childB == 0;
    theory.detail = "add(1, 2) carries a qualifying base; only ns.fn() should";
  }
}

suite function variantDeclsCarryTheirCasesInOrder(): void {
  let ast = parseOk("variant Shape { Circle { r: int }, Rect { w: int, h: int }, Empty }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a variant decl holds one node per case") {
    theory.isSuccessful = decl.kind == ASTNodeKind.VARIANT_DECL && decl.childCount == 3;
    theory.detail = `parsed a ${decl.kind} with ${decl.childCount} cases, wanted VARIANT_DECL with 3`;
  }

  // DECLARATION ORDER is the tag order, and the tag is ABI - so the order the
  // arena holds them in is the thing worth pinning.
  let test theory: Case = t.asserts("cases keep their declaration order") {
    const first = nodeAt(ref ast, childAt(ref ast, decl, 0));
    const last = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = str.stringEq(first.name, "Circle") && str.stringEq(last.name, "Empty");
    theory.detail = `the first and last cases are "${first.name}" and "${last.name}", wanted Circle and Empty`;
  }

  let test theory: Case = t.asserts("a case carries its own fields") {
    const rect = nodeAt(ref ast, childAt(ref ast, decl, 1));
    theory.isSuccessful = rect.kind == ASTNodeKind.VARIANT_CASE && rect.childCount == 2;
    theory.detail = `Rect is a ${rect.kind} with ${rect.childCount} field(s), wanted VARIANT_CASE with 2`;
  }

  let test theory: Case = t.asserts("a payload-less case has an empty field run") {
    const empty = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = empty.childCount == 0;
    theory.detail = `Empty carries ${empty.childCount} field(s), wanted 0`;
  }
}

// A case and the member after it are told apart by the COMMA and by nothing
// else, so a case written with a bare TYPE where its payload belongs -
// `Special MyType,` - is two payload-less cases and not one case with a
// payload. Refused by name, because accepting it is silent: the payload the
// writer meant is dropped, a case named after the payload TYPE appears beside
// it, and the only symptom anywhere downstream is a switch that will not go
// exhaustive until an arm is added for a case nobody wrote. Verified end to
// end before the check landed - the program compiled, ran, and printed from
// the wrong shape.
suite function aVariantCasePayloadMustBeARecord(): void {
  const bare = "type MyType { q: int }\nvariant V { Normal { p: int }, Special MyType, }";
  let test theory: Case = t.asserts("a bare-type payload is refused, and the message names both words") {
    theory.isSuccessful = refusalMentions(bare, "\"Special\" is followed by \"MyType\" with no separator")
      && refusalMentions(bare, "Special { value: MyType }");
    theory.detail = `wanted the no-separator refusal with its fix-it, got: ${parseError(bare)}`;
  }

  // The record spelling is what the refusal points at, so it has to keep
  // working - otherwise the check is just breaking payloads to catch one.
  let record = parseOk("type MyType { q: int }\nvariant V { Normal { p: int }, Special { value: MyType }, }");
  let test theory: Case = t.asserts("the record payload form still parses as ONE case with a field") {
    const decl = topLevel(ref record, 1);
    const special = nodeAt(ref record, childAt(ref record, decl, 1));
    theory.isSuccessful = decl.childCount == 2
      && special.kind == ASTNodeKind.VARIANT_CASE
      && str.stringEq(special.name, "Special")
      && special.childCount == 1;
    theory.detail = `the variant has ${decl.childCount} member(s); "${special.name}" carries ${special.childCount} field(s)`;
  }

  // The last member may still omit its trailing comma, and a METHOD still
  // follows a case with the ordinary comma in front of it - the two shapes the
  // check has to leave alone.
  let terse = parseOk("variant V { A, B { x: int } }");
  let test theory: Case = t.asserts("the last case needs no trailing comma") {
    theory.isSuccessful = topLevel(ref terse, 0).childCount == 2;
    theory.detail = `the variant has ${topLevel(ref terse, 0).childCount} member(s), wanted 2`;
  }

  let withMethod = parseOk("variant V implements D { A, B { x: int }, function f(ref self): int { return 1; } }");
  let test theory: Case = t.asserts("a method after a case is unaffected") {
    const decl = topLevel(ref withMethod, 0);
    theory.isSuccessful = decl.childCount == 3
      && nodeAt(ref withMethod, childAt(ref withMethod, decl, 2)).kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the variant has ${decl.childCount} member(s), wanted 3 ending in a METHOD_DECL`;
  }
}

suite function variantConstructorsAndPatternsShareOneShape(): void {
  // The braces are what make a constructor unambiguous at parse time.
  let ast = parseOk("function f(): int { return Shape.Circle { r: 2 }; }");
  const ctor = returnedExpression(ref ast);

  let test theory: Case = t.asserts("`V.Case { ... }` parses as a VARIANT_CONSTRUCTOR") {
    theory.isSuccessful = ctor.kind == ASTNodeKind.VARIANT_CONSTRUCTOR
      && str.stringEq(ctor.name, "Circle");
    theory.detail = `parsed a ${ctor.kind} named "${ctor.name}", wanted VARIANT_CONSTRUCTOR Circle`;
  }
  let test theory: Case = t.asserts("the variant name is the qualifying base") {
    const base = nodeAt(ref ast, ctor.childB);
    theory.isSuccessful = base.kind == ASTNodeKind.IDENT && str.stringEq(base.name, "Shape");
    theory.detail = `childB is a ${base.kind} named "${base.name}", wanted IDENT Shape`;
  }

  // A payload-LESS constructor is the same tokens as a field read, so the
  // parser leaves it alone and pass D decides once names resolve.
  let bare = parseOk("function f(): int { return Shape.Empty; }");
  let test theory: Case = t.asserts("a payload-less constructor stays a FIELD_ACCESS") {
    theory.isSuccessful = returnedExpression(ref bare).kind == ASTNodeKind.FIELD_ACCESS;
    theory.detail = `Shape.Empty parsed as ${returnedExpression(ref bare).kind}, wanted FIELD_ACCESS`;
  }

  let sw = parseOk("function f(): int { switch (s) { case Shape.Circle { r: v }: { return v; } } }");
  const pattern = firstSwitchPattern(ref sw);
  let test theory: Case = t.asserts("a case pattern is a VARIANT_PATTERN with the same slots") {
    theory.isSuccessful = pattern.kind == ASTNodeKind.VARIANT_PATTERN
      && str.stringEq(pattern.name, "Circle")
      && str.stringEq(nodeAt(ref sw, pattern.childB).name, "Shape");
    theory.detail = `parsed a ${pattern.kind} named "${pattern.name}"`;
  }
  let test theory: Case = t.asserts("a pattern's payload holds BINDING names") {
    const list = nodeAt(ref sw, pattern.childA);
    const field = nodeAt(ref sw, childAt(ref sw, list, 0));
    const binding = nodeAt(ref sw, field.childA);
    theory.isSuccessful = str.stringEq(field.name, "r")
      && binding.kind == ASTNodeKind.IDENT && str.stringEq(binding.name, "v");
    theory.detail = `{ r: v } gave field "${field.name}" bound to a ${binding.kind} named "${binding.name}"`;
  }

  // SHORTHAND: `{ r }` is `{ r: r }` and lands in the arena identically, so
  // nothing after the parser can tell which spelling was written.
  let short = parseOk("function f(): int { switch (s) { case Shape.Circle { r }: { return r; } } }");
  const shortPattern = firstSwitchPattern(ref short);
  let test theory: Case = t.asserts("a shorthand pattern field binds its own name") {
    const list = nodeAt(ref short, shortPattern.childA);
    const field = nodeAt(ref short, childAt(ref short, list, 0));
    const binding = nodeAt(ref short, field.childA);
    theory.isSuccessful = str.stringEq(field.name, "r")
      && binding.kind == ASTNodeKind.IDENT && str.stringEq(binding.name, "r");
    theory.detail = `{ r } gave field "${field.name}" bound to a ${binding.kind} named "${binding.name}"`;
  }

  let mixed = parseOk(
    "function f(): int { switch (s) { case Shape.Rect { w, h: tall, d: _ }: { return w; } } }"
  );
  const mixedPattern = firstSwitchPattern(ref mixed);
  let test theory: Case = t.asserts("shorthand, explicit and discard mix in one pattern") {
    const list = nodeAt(ref mixed, mixedPattern.childA);
    const f0 = nodeAt(ref mixed, childAt(ref mixed, list, 0));
    const f1 = nodeAt(ref mixed, childAt(ref mixed, list, 1));
    const f2 = nodeAt(ref mixed, childAt(ref mixed, list, 2));
    theory.isSuccessful = list.childCount == 3
      && str.stringEq(nodeAt(ref mixed, f0.childA).name, "w")
      && str.stringEq(nodeAt(ref mixed, f1.childA).name, "tall")
      && str.stringEq(nodeAt(ref mixed, f2.childA).name, "_");
    theory.detail = `{ w, h: tall, d: _ } gave ${list.childCount} field(s)`;
  }

  // The regression the constructor could easily cause.
  let literal = parseOk("function f(): int { const p: Point = { x: 1 }; return 0; }");
  let test theory: Case = t.asserts("a plain struct literal is untouched") {
    theory.isSuccessful = !refusalMentions("function f(): int { const p: Point = { x: 1 }; return 0; }", "expected");
    theory.detail = "an unqualified struct literal stopped parsing";
  }
}

suite function typeArgumentsParseInAnnotations(): void {
  // `<` in annotation position is never a comparison - nothing else can appear
  // there - which is what makes this unambiguous where an expression's `a < b`
  // would not be.
  let ast = parseOk("function f(): int { const v: Result<int, string> = 0; return 0; }");
  const annot = firstVarDeclAnnotation(ref ast);

  let test theory: Case = t.asserts("a generic application carries its argument list") {
    theory.isSuccessful = annot.kind == ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME
      && str.stringEq(annot.name, "Result")
      && annot.childA != 0;
    theory.detail = `parsed a ${annot.kind} named "${annot.name}" with argsList ${annot.childA}`;
  }
  let test theory: Case = t.asserts("each argument is its own annotation node") {
    const list = nodeAt(ref ast, annot.childA);
    const first = nodeAt(ref ast, childAt(ref ast, list, 0));
    const second = nodeAt(ref ast, childAt(ref ast, list, 1));
    theory.isSuccessful = list.childCount == 2
      && str.stringEq(first.name, "int") && str.stringEq(second.name, "string");
    theory.detail = `got ${list.childCount} argument(s): "${first.name}", "${second.name}"`;
  }

  // Arguments are full annotations, so they nest.
  let nested = parseOk("function f(): int { const v: Box<Vec<int>> = 0; return 0; }");
  let test theory: Case = t.asserts("arguments nest") {
    const outer = firstVarDeclAnnotation(ref nested);
    const args = nodeAt(ref nested, outer.childA);
    const inner = nodeAt(ref nested, childAt(ref nested, args, 0));
    theory.isSuccessful = str.stringEq(inner.name, "Vec") && inner.childA != 0;
    theory.detail = `the inner argument is "${inner.name}" with argsList ${inner.childA}`;
  }

  // A nested application ends in `>>`, which is ONE token. The inner list
  // consumes it and leaves a virtual `>` owed to the outer one, so between
  // those two moments the cursor already sits on whatever follows the whole
  // annotation. If the outer list peeks at the real token stream there, a
  // following `,` reads as another type argument and the list eats the next
  // field, parameter or argument. These pin the three places that can follow.
  let fields = parseOk("type T { a: Box<Vec<int>>, b: int }");
  let test theory: Case = t.asserts("a `>>` field does not swallow the field after it") {
    const decl = topLevel(ref fields, 0);
    const second = nodeAt(ref fields, childAt(ref fields, decl, 1));
    theory.isSuccessful = decl.childCount == 2 && str.stringEq(second.name, "b");
    theory.detail = `the type has ${decl.childCount} field(s), the second named "${second.name}", wanted 2 and "b"`;
  }

  let params = parseOk("function f(a: Box<Vec<int>>, b: int): int { return 0; }");
  let test theory: Case = t.asserts("a `>>` parameter does not swallow the parameter after it") {
    const list = nodeAt(ref params, topLevel(ref params, 0).childB);
    const second = nodeAt(ref params, childAt(ref params, list, 1));
    theory.isSuccessful = list.childCount == 2 && str.stringEq(second.name, "b");
    theory.detail = `the function has ${list.childCount} parameter(s), the second named "${second.name}", wanted 2 and "b"`;
  }

  let mid = parseOk("function f(): int { const v: Map<Box<Vec<int>>, string> = 0; return 0; }");
  let test theory: Case = t.asserts("a `>>` argument closes its own list, not the enclosing one") {
    const list = nodeAt(ref mid, firstVarDeclAnnotation(ref mid).childA);
    const second = nodeAt(ref mid, childAt(ref mid, list, 1));
    theory.isSuccessful = list.childCount == 2 && str.stringEq(second.name, "string");
    theory.detail = `Map got ${list.childCount} argument(s), the second "${second.name}", wanted 2 and "string"`;
  }

  let bare = parseOk("function f(): int { const v: int = 0; return 0; }");
  let test theory: Case = t.asserts("a plain annotation has no argument list") {
    theory.isSuccessful = firstVarDeclAnnotation(ref bare).childA == 0;
    theory.detail = "a non-generic annotation carries a type-argument list";
  }

  // `fs.DirIter` - a type reached through an imported namespace. The QUALIFIER
  // is interned rather than kept in a second name field, and `flagA` is what
  // says there is one: pool index 0 is a real string, so a `strId` of 0 cannot
  // mean "absent".
  let qualified = parseOk("function f(): int { const v: fs.DirIter = 0; return 0; }");
  let test theory: Case = t.asserts("a qualified annotation keeps the TYPE as its name") {
    const annot = firstVarDeclAnnotation(ref qualified);
    theory.isSuccessful = annot.flagA && str.stringEq(annot.name, "DirIter");
    theory.detail = `qualified=${annot.flagA}, name="${annot.name}", wanted true and "DirIter"`;
  }

  let test theory: Case = t.asserts("and the namespace in the string pool") {
    const annot = firstVarDeclAnnotation(ref qualified);
    theory.isSuccessful = str.stringEq(poolString(ref qualified, annot.strId), "fs");
    theory.detail = `the qualifier interned as "${poolString(ref qualified, annot.strId)}", wanted "fs"`;
  }

  let test theory: Case = t.asserts("an UNqualified annotation is not marked as one") {
    theory.isSuccessful = !firstVarDeclAnnotation(ref bare).flagA;
    theory.detail = "a plain `int` annotation came back marked qualified";
  }

  // The qualifier is part of the type NAME, so everything that attaches to a
  // plain one attaches here too, in the same order.
  let qualGeneric = parseOk("function f(): int { const v: vec.Vec<int>[] = 0; return 0; }");
  let test theory: Case = t.asserts("a qualified name still takes type arguments and an array suffix") {
    const arr = firstVarDeclAnnotation(ref qualGeneric);
    const inner = nodeAt(ref qualGeneric, arr.childA);
    theory.isSuccessful = arr.kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE
      && inner.flagA && str.stringEq(inner.name, "Vec") && inner.childA != 0;
    theory.detail = `outer ${arr.kind}, inner "${inner.name}" qualified=${inner.flagA} args=${inner.childA}`;
  }

  let test theory: Case = t.asserts("an empty argument list is refused") {
    const src = "function f(): int { const v: Box<> = 0; return 0; }";
    theory.isSuccessful = refusalMentions(src, "empty type argument list");
    theory.detail = `wanted an empty-list refusal, got: ${parseError(src)}`;
  }
}

suite function externBlocksDeclareSignaturesWithNoBody(): void {
  let ast = parseOk("extern \"C\" from \"stdio.h\" { function puts(s: string): int; function fflush(f: int): int; }");
  const block = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("an extern block holds one node per signature") {
    theory.isSuccessful = block.kind == ASTNodeKind.EXTERN_BLOCK && block.childCount == 2;
    theory.detail = `parsed a ${block.kind} with ${block.childCount} signature(s), wanted EXTERN_BLOCK with 2`;
  }
  let test theory: Case = t.asserts("the library name is recorded, not dropped") {
    theory.isSuccessful = str.stringEq(poolString(ref ast, block.strId), "stdio.h");
    theory.detail = `the library is "${poolString(ref ast, block.strId)}", wanted "stdio.h"`;
  }
  let test theory: Case = t.asserts("a signature has params and a return but NO body") {
    const fn = nodeAt(ref ast, childAt(ref ast, block, 0));
    theory.isSuccessful = fn.kind == ASTNodeKind.EXTERN_FUNCTION_DECL
      && str.stringEq(fn.name, "puts") && fn.childB != 0 && fn.childC != 0 && fn.childD == 0;
    theory.detail = `puts parsed as ${fn.kind} with body slot ${fn.childD}, which must be empty`;
  }

  // `from` is required, matching the JS reference - a program written against a
  // looser rule would not compile with the other compiler.
  let test theory: Case = t.asserts("the `from` clause is required") {
    const src = "extern \"C\" { function puts(s: string): int; }";
    theory.isSuccessful = refusalMentions(src, "expected FROM");
    theory.detail = `wanted a missing-from refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("an ABI other than C is refused by name") {
    const src = "extern \"rust\" from \"x\" { function f(): int; }";
    theory.isSuccessful = refusalMentions(src, "unsupported extern ABI");
    theory.detail = `wanted an ABI refusal, got: ${parseError(src)}`;
  }
}

// `from library "m"` versus `from "math.h"`. Two spellings of one clause, and
// they mean different things: the first is a LINK instruction (`-lm` on the
// clang line) and the second is a header name nothing reads.
suite function theLibraryFormOfTheFromClauseIsALinkInstruction(): void {
  let lib = parseOk("extern \"C\" from library \"m\" { function cos(x: float64): float64; }");
  const block = topLevel(ref lib, 0);

  let test theory: Case = t.asserts("the library name lands in the same slot a header does") {
    theory.isSuccessful = str.stringEq(poolString(ref lib, block.strId), "m");
    theory.detail = `the source is "${poolString(ref lib, block.strId)}", wanted "m"`;
  }
  // The two have to be TOLD APART, or every `from "stdio.h"` would become
  // `-lstdio.h` and every program that has one would stop linking.
  let test theory: Case = t.asserts("`library` is recorded so the link step can see it") {
    theory.isSuccessful = block.operator == TokenTags.LIBRARY;
    theory.detail = `the block's source marker is ${tagName(block.operator)}, wanted LIBRARY`;
  }
  let plain = parseOk("extern \"C\" from \"stdio.h\" { function puts(s: string): int; }");
  let test theory: Case = t.asserts("a bare header name is NOT marked as a library") {
    theory.isSuccessful = topLevel(ref plain, 0).operator != TokenTags.LIBRARY;
    theory.detail = `a header block's source marker is ${tagName(topLevel(ref plain, 0).operator)}`;
  }

  // `library` is CONTEXTUAL - it lexes as an ordinary IDENT on both sides - so
  // it stays usable as a name everywhere else.
  let asName = parseOk("function f(library: int): int { return library; }");
  let test theory: Case = t.asserts("`library` is still a legal identifier elsewhere") {
    theory.isSuccessful = topLevel(ref asName, 0).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `a parameter named "library" parsed as ${topLevel(ref asName, 0).kind}`;
  }

  // A STRING is required after it, on both sides.
  let test theory: Case = t.asserts("`from library m` without quotes is refused") {
    const src = "extern \"C\" from library m { function cos(x: float64): float64; }";
    theory.isSuccessful = refusalMentions(src, "expected STRLITERAL");
    theory.detail = `wanted a missing-string refusal, got: ${parseError(src)}`;
  }
}

// `function printf(fmt: string, ...): int32;`
//
// The `...` is a MARKER ON THE SIGNATURE, not a parameter: it produces no PARAM
// node, so the fixed parameters are exactly what the list holds and every later
// pass can count them without knowing about varargs. Where it may appear was
// settled by probing the JS reference, which parses `...` inside an extern and
// nowhere else, and only ever immediately before the `)`.
suite function variadicMarksTheSignatureRatherThanAddingAParameter(): void {
  let ast = parseOk("extern \"C\" from \"stdio.h\" { function printf(fmt: string, ...): int32; function puts(s: string): int; }");
  const block = topLevel(ref ast, 0);
  const variadic = nodeAt(ref ast, childAt(ref ast, block, 0));
  const plain = nodeAt(ref ast, childAt(ref ast, block, 1));

  let test theory: Case = t.asserts("`...` sets the signature's variadic flag") {
    theory.isSuccessful = variadic.flagA;
    theory.detail = `printf parsed with flagA=${variadic.flagA}, wanted true`;
  }
  let test theory: Case = t.asserts("a signature without `...` is not variadic") {
    theory.isSuccessful = !plain.flagA;
    theory.detail = `puts parsed with flagA=${plain.flagA}, wanted false`;
  }
  let test theory: Case = t.asserts("`...` contributes no PARAM node of its own") {
    const params = nodeAt(ref ast, variadic.childB);
    theory.isSuccessful = params.childCount == 1;
    theory.detail = `printf has ${params.childCount} parameter node(s), wanted just the 1 for fmt`;
  }

  // `function weird(...): int32;` is legal C and the reference accepts it, so
  // an empty fixed half has to be representable rather than an error.
  let bare = parseOk("extern \"C\" from \"x\" { function weird(...): int32; }");
  const bareFn = nodeAt(ref bare, childAt(ref bare, topLevel(ref bare, 0), 0));
  let test theory: Case = t.asserts("`...` may be the ONLY parameter") {
    theory.isSuccessful = bareFn.flagA && nodeAt(ref bare, bareFn.childB).childCount == 0;
    theory.detail = `weird parsed with flagA=${bareFn.flagA} and ${nodeAt(ref bare, bareFn.childB).childCount} parameter(s)`;
  }

  // Everything below is a refusal, and each one is a shape the reference also
  // refuses. They are here because the failure mode without them is silence:
  // a `...` quietly dropped is a call that stops being checked.
  let test theory: Case = t.asserts("nothing may follow `...`") {
    const src = "extern \"C\" from \"x\" { function f(a: int, ..., b: int): int; }";
    theory.isSuccessful = refusalMentions(src, "must be the LAST parameter");
    theory.detail = `wanted a trailing-parameter refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("a trailing comma after `...` is refused too") {
    const src = "extern \"C\" from \"x\" { function f(a: int, ...,): int; }";
    theory.isSuccessful = refusalMentions(src, "must be the LAST parameter");
    theory.detail = `wanted a trailing-comma refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("an ordinary function may not be variadic") {
    const src = "function f(a: int, ...): int { return a; }";
    theory.isSuccessful = refusalMentions(src, "only allowed as the LAST parameter of an `extern \"C\"` signature");
    theory.detail = `wanted a not-an-extern refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("`...` alone in an ordinary function is refused the same way") {
    const src = "function f(...): int { return 1; }";
    theory.isSuccessful = refusalMentions(src, "only allowed as the LAST parameter of an `extern \"C\"` signature");
    theory.detail = `wanted a not-an-extern refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("a trait method may not be variadic") {
    const src = "trait T { function m(ref self, a: int, ...): int; }";
    theory.isSuccessful = refusalMentions(src, "only allowed as the LAST parameter of an `extern \"C\"` signature");
    theory.detail = `wanted a not-an-extern refusal, got: ${parseError(src)}`;
  }
  let test theory: Case = t.asserts("a function TYPE annotation may not be variadic") {
    const src = "function f(): int { const g: (a: int, ...) => int = f; return 1; }";
    theory.isSuccessful = refusalMentions(src, "only allowed as the LAST parameter of an `extern \"C\"` signature");
    theory.detail = `wanted a not-an-extern refusal, got: ${parseError(src)}`;
  }
}

suite function importDirectivesAreFlagsNotImports(): void {
  // Same keyword as an import; the `.` is the whole difference.
  let ast = parseOk("import.unsafe;\nfunction f(): int { return 1; }");
  const program = nodeAt(ref ast, ast.root);

  let test theory: Case = t.asserts("`import.unsafe;` sets a flag and declares nothing") {
    theory.isSuccessful = program.flagA && program.childCount == 1;
    theory.detail = `unsafe=${program.flagA} with ${program.childCount} top-level node(s), wanted true and 1`;
  }

  let plain = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("a module without the directive is not unsafe") {
    theory.isSuccessful = !nodeAt(ref plain, plain.root).flagA;
    theory.detail = "a module with no import.unsafe came out flagged";
  }

  let test theory: Case = t.asserts("an unknown directive lists the ones that exist") {
    theory.isSuccessful = refusalMentions("import.wat;", "import.unsafe");
    theory.detail = `wanted the known directives listed, got: ${parseError("import.wat;")}`;
  }
}

suite function kindPrefixesInAnnotationsAreKept(): void {
  // `owned string` - the kind is contextual, so two IDENTs in a row is what
  // identifies one. Recorded rather than dropped, even though nothing enforces
  // kinds yet: the limitation is "not enforced", not "not parsed".
  let ast = parseOk("function f(s: owned string): int { return 1; }");
  const annot = firstParamAnnotation(ref ast);

  let test theory: Case = t.asserts("the type is still the type") {
    theory.isSuccessful = str.stringEq(annot.name, "string");
    theory.detail = `the annotation resolved to "${annot.name}", wanted "string"`;
  }
  let test theory: Case = t.asserts("the prefix is recorded on the annotation") {
    const list = nodeAt(ref ast, annot.childB);
    const prefix = nodeAt(ref ast, childAt(ref ast, list, 0));
    theory.isSuccessful = annot.childB != 0 && str.stringEq(prefix.name, "owned");
    theory.detail = `the recorded prefix is "${prefix.name}", wanted "owned"`;
  }

  let bare = parseOk("function f(s: string): int { return 1; }");
  let test theory: Case = t.asserts("an unprefixed annotation records none") {
    theory.isSuccessful = firstParamAnnotation(ref bare).childB == 0;
    theory.detail = "a plain annotation came out with a kind prefix";
  }
}

suite function exportWrapsTheDeclItDecorates(): void {
  let ast = parseOk("export function f(): int { return 1; }");
  const childId = childAt(ref ast, nodeAt(ref ast, ast.root), 0);

  let test theory: Case = t.asserts("`export function` is an EXPORT_DECL, not a flag") {
    theory.isSuccessful = isExportDecl(ref ast, childId);
    theory.detail = `the top-level node is ${nodeAt(ref ast, childId).kind}, wanted EXPORT_DECL`;
  }

  let test theory: Case = t.asserts("declOf looks through the wrapper to the decl") {
    const inner = nodeAt(ref ast, declOf(ref ast, childId));
    theory.isSuccessful = inner.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(inner.name, "f");
    theory.detail = `declOf gave a ${inner.kind} named "${inner.name}", wanted FUNCTION_DECL f`;
  }

  let typeAst = parseOk("export type Point { x: int, y: int }");
  const typeChild = childAt(ref typeAst, nodeAt(ref typeAst, typeAst.root), 0);
  let test theory: Case = t.asserts("`export type` wraps the same way") {
    const inner = nodeAt(ref typeAst, declOf(ref typeAst, typeChild));
    theory.isSuccessful = inner.kind == ASTNodeKind.TYPE_DECL && inner.childCount == 2;
    theory.detail = `declOf gave a ${inner.kind} with ${inner.childCount} field(s), wanted TYPE_DECL with 2`;
  }

  let test theory: Case = t.asserts("declOf is the identity on an unwrapped decl") {
    let bare = parseOk("function g(): int { return 1; }");
    const only = childAt(ref bare, nodeAt(ref bare, bare.root), 0);
    theory.isSuccessful = declOf(ref bare, only) == only;
    theory.detail = "declOf moved a decl that was never wrapped in an export";
  }
}

suite function importFormsOutsideTheSubsetAreRefusedByName(): void {
  // A side-effect import binds NOTHING and has no `from`, so the path follows
  // the keyword directly. It is still an ordinary IMPORT_DECL - the node's job
  // is to name a module the graph has to load.
  let test theory: Case = t.asserts("a side-effect import parses") {
    theory.isSuccessful = parseError("import \"./x.yoop\";").len == 0;
    theory.detail = `a side-effect import failed to parse: ${parseError("import \"./x.yoop\";")}`;
  }

  let test theory: Case = t.asserts("a side-effect import binds no specifier and no namespace") {
    let ast = parseOk("import \"./x.yoop\";");
    const node = topLevel(ref ast, 0);
    theory.isSuccessful =
      node.kind == ASTNodeKind.IMPORT_DECL && node.childCount == 0 && node.name.len == 0;
    theory.detail = "a side-effect import bound something";
  }

  let test theory: Case = t.asserts("`export let` is a supported form") {
    theory.isSuccessful = parseError("export let x: int = 1;").len == 0;
    theory.detail = `export let failed to parse: ${parseError("export let x: int = 1;")}`;
  }

  let test theory: Case = t.asserts("`export const` is a supported form") {
    theory.isSuccessful = parseError("export const X: int = 1;").len == 0;
    theory.detail = `export const failed to parse: ${parseError("export const X: int = 1;")}`;
  }

  // `export "C" function` gets its OWN wrapper kind, which is what tells pass A
  // to record the name as one keeping its bare C spelling.
  let cexport = parseOk("export \"C\" function f(): void { }");
  let test theory: Case = t.asserts("`export \"C\" function` wraps in its own kind") {
    const wrapper = topLevel(ref cexport, 0);
    theory.isSuccessful = wrapper.kind == ASTNodeKind.EXPORT_C_FUNCTION_DECL
      && isExportDecl(ref cexport, topLevelId(ref cexport, 0))
      && isCExportDecl(ref cexport, topLevelId(ref cexport, 0))
      && nodeAt(ref cexport, declOf(ref cexport, topLevelId(ref cexport, 0))).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `parsed a ${wrapper.kind}`;
  }

  // "C" is the only ABI a DEFINITION can carry - an intrinsic has no body for
  // `export` to do anything with.
  let test theory: Case = t.asserts("any other export ABI is refused by name") {
    const src = "export \"intrinsic\" function f(): void { }";
    theory.isSuccessful = refusalMentions(src, "unsupported export ABI");
    theory.detail = `wanted an ABI refusal, got: ${parseError(src)}`;
  }
}

// `_ = expr;` - a DISCARD statement. Its own node kind, so the spelling
// survives into the AST, but checked and emitted exactly as a bare `expr;`.
suite function aDiscardStatementParses(): void {
  const SRC: string = "function f(): int { _ = g(); return 0; }";

  let test theory: Case = t.asserts("`_ = expr;` is a DISCARD_STATEMENT") {
    let ast = parseOk(SRC);
    const stmt = firstStatement(ref ast);
    theory.isSuccessful = stmt.kind == ASTNodeKind.DISCARD_STATEMENT;
    theory.detail = "`_ = g();` did not parse as a DISCARD_STATEMENT";
  }

  let test theory: Case = t.asserts("the discarded expression is in childA") {
    let ast = parseOk(SRC);
    const stmt = firstStatement(ref ast);
    theory.isSuccessful =
      stmt.childA != 0 && nodeAt(ref ast, stmt.childA).kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = "the discarded expression is not in childA";
  }

  // `_` without the `=` is not a statement. It is a PATTERN spelling elsewhere,
  // so failing to require the `=` here would silently swallow one.
  let test theory: Case = t.asserts("`_;` on its own is refused") {
    theory.isSuccessful = parseError("function f(): int { _; return 0; }").len > 0;
    theory.detail = "`_;` parsed as a statement";
  }
}

// `trait Child extends Parent` - one parent or several, comma separated. The
// list goes in the same slot an `implements` clause uses on a type, because
// both are "a list of traits this declaration promises about".
suite function aTraitCanExtendAnother(): void {
  let test theory: Case = t.asserts("a single parent parses") {
    const src = "trait A { function a(ref self): int; }\ntrait B extends A { function b(ref self): int; }";
    theory.isSuccessful = parseError(src).len == 0;
    theory.detail = `trait extends failed to parse: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("two parents parse") {
    const src = "trait A { function a(ref self): int; }\ntrait B { function b(ref self): int; }\ntrait C extends A, B { function c(ref self): int; }";
    theory.isSuccessful = parseError(src).len == 0;
    theory.detail = `two parents failed to parse: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("the parents land in the trait's implements slot") {
    let ast = parseOk("trait A { function a(ref self): int; }\ntrait B extends A { function b(ref self): int; }");
    const program = nodeAt(ref ast, ast.root);
    const child = nodeAt(ref ast, childAt(ref ast, program, 1));
    theory.isSuccessful = child.childD != 0 && nodeAt(ref ast, child.childD).childCount == 1;
    theory.detail = "the extends list is not in childD";
  }

  // A generic trait still takes its parameters first, so the two clauses do not
  // collide.
  let test theory: Case = t.asserts("a generic trait can extend") {
    const src = "trait A { function a(ref self): int; }\ntrait B<T> extends A { function b(ref self): T; }";
    theory.isSuccessful = parseError(src).len == 0;
    theory.detail = `a generic trait with extends failed to parse: ${parseError(src)}`;
  }
}

suite function importsMustComeFirst(): void {
  // The whole graph layer reads the LEADING run of IMPORT_DECLs and stops at
  // the first declaration, so an import below one would be silently ignored.
  const src = "function f(): int { return 1; }\nimport { a } from \"./x.yoop\";";

  let test theory: Case = t.asserts("an import below a declaration is refused") {
    theory.isSuccessful = refusalMentions(src, "imports must come first");
    theory.detail = `wanted the imports-first refusal, got: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("several imports in a row are fine") {
    let ast = parseOk("import { a } from \"./a.yoop\";\nimport { b } from \"./b.yoop\";\nfunction f(): int { return 1; }");
    const program = nodeAt(ref ast, ast.root);
    theory.isSuccessful = program.childCount == 3
      && topLevel(ref ast, 0).kind == ASTNodeKind.IMPORT_DECL
      && topLevel(ref ast, 1).kind == ASTNodeKind.IMPORT_DECL;
    theory.detail = `wanted two imports then a function, got ${program.childCount} top-level nodes`;
  }
}

suite function traitDeclCarriesItsMethodSignatures(): void {
  let ast = parseOk("trait Display { function toString(ref self): string; function width(ref self, pad: int): int; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a trait is a TRAIT_DECL at the top level") {
    theory.isSuccessful = decl.kind == ASTNodeKind.TRAIT_DECL && str.stringEq(decl.name, "Display");
    theory.detail = `the first top-level node is ${decl.kind} named "${decl.name}", wanted TRAIT_DECL "Display"`;
  }

  let test theory: Case = t.asserts("each signature is one node in the trait's own child run") {
    theory.isSuccessful = decl.childCount == 2;
    theory.detail = `the trait has ${decl.childCount} method signature(s), wanted 2`;
  }

  const sig = nodeAt(ref ast, childAt(ref ast, decl, 0));
  let test theory: Case = t.asserts("a signature is a METHOD_SIG, not a FUNCTION_DECL") {
    theory.isSuccessful = sig.kind == ASTNodeKind.METHOD_SIG && str.stringEq(sig.name, "toString");
    theory.detail = `the first member is ${sig.kind} named "${sig.name}", wanted METHOD_SIG "toString"`;
  }

  let test theory: Case = t.asserts("a signature has no body, which is what separates it from a method") {
    theory.isSuccessful = sig.childD == 0;
    theory.detail = `the signature's body slot is ${sig.childD}, wanted 0`;
  }
}

// The one thing the parser does that nothing else could: `self` is written
// WITHOUT a type, and the annotation is synthesized from the enclosing type.
// Every later layer depends on it, and none of them would notice it missing
// until a receiver silently typed as the error type.
suite function selfGetsTheEnclosingTypeAsItsAnnotation(): void {
  let ast = parseOk("type Point implements Display { x: int, function toString(ref self): string { return \"p\"; } }");
  const method = typeMember(ref ast, 1);

  let test theory: Case = t.asserts("a method in a type body is a METHOD_DECL with a body") {
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_DECL && method.childD != 0;
    theory.detail = `the member is ${method.kind} with body slot ${method.childD}, wanted METHOD_DECL and non-zero`;
  }

  const params = nodeAt(ref ast, method.childB);
  let test theory: Case = t.asserts("the receiver is an ordinary parameter, so a method is an ordinary function") {
    theory.isSuccessful = params.childCount == 1;
    theory.detail = `the method has ${params.childCount} parameter(s), wanted 1`;
  }

  const receiver = nodeAt(ref ast, childAt(ref ast, params, 0));
  let test theory: Case = t.asserts("the receiver is named self and is marked ref") {
    theory.isSuccessful = str.stringEq(receiver.name, "self") && receiver.flagA;
    theory.detail = `the receiver is "${receiver.name}" with isRef=${receiver.flagA}, wanted "self" and true`;
  }

  const annot = nodeAt(ref ast, receiver.childA);
  let test theory: Case = t.asserts("self's annotation is filled in with the enclosing type's name") {
    theory.isSuccessful = str.stringEq(annot.name, "Point");
    theory.detail = `self annotates as "${annot.name}", wanted "Point"`;
  }
}

suite function implementsClauseIsAListOfAnnotations(): void {
  let bare = parseOk("type Point implements Display, Ord { x: int, }");
  const list = nodeAt(ref bare, topLevel(ref bare, 0).childD);

  let test theory: Case = t.asserts("every named trait lands in the clause's list") {
    theory.isSuccessful = list.childCount == 2;
    theory.detail = `the clause names ${list.childCount} trait(s), wanted 2`;
  }

  let test theory: Case = t.asserts("the first named trait keeps its name") {
    const first = nodeAt(ref bare, childAt(ref bare, list, 0));
    theory.isSuccessful = str.stringEq(first.name, "Display");
    theory.detail = `the first trait is "${first.name}", wanted "Display"`;
  }

  // Both spellings are one clause. The parenthesized form appears throughout
  // std, so a parser that took only the bare one would reject real code.
  let parens = parseOk("type Point implements (Display, Ord) { x: int, }");
  let test theory: Case = t.asserts("the parenthesized form is the same list") {
    const parenList = nodeAt(ref parens, topLevel(ref parens, 0).childD);
    theory.isSuccessful = parenList.childCount == 2;
    theory.detail = `the parenthesized clause names ${parenList.childCount} trait(s), wanted 2`;
  }

  let none = parseOk("type Point { x: int, }");
  let test theory: Case = t.asserts("no clause is 0, not an empty list") {
    theory.isSuccessful = topLevel(ref none, 0).childD == 0;
    theory.detail = `a type with no clause has childD ${topLevel(ref none, 0).childD}, wanted 0`;
  }
}

// A variant's methods share the member run with its cases. The cases keep their
// declaration-order tags either way, and that ordering is ABI.
suite function variantMethodsShareTheMemberRunWithCases(): void {
  let ast = parseOk("variant Status implements Describe { Idle, Done { n: int }, function code(ref self): int { return 0; } }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a variant takes an implements clause the same way a type does") {
    theory.isSuccessful = decl.childD != 0;
    theory.detail = `the variant's implements slot is ${decl.childD}, wanted non-zero`;
  }

  let test theory: Case = t.asserts("cases and methods are all members of the one run") {
    theory.isSuccessful = decl.childCount == 3;
    theory.detail = `the variant has ${decl.childCount} member(s), wanted 3`;
  }

  let test theory: Case = t.asserts("the method is a METHOD_DECL") {
    const method = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the third member is ${method.kind}, wanted METHOD_DECL`;
  }
}

// A case name is metadata and may be spelled with a reserved word, `function`
// included - so the keyword is at the head of both kinds of member and cannot
// tell them apart on its own. What does is the token after it. C-shaped code
// writes case names like this, and generated bindings would otherwise fail to
// parse on the first collision.
suite function functionAsACaseNameIsToldFromAMethodByWhatFollowsIt(): void {
  let bare = parseOk("variant Shape { function, type { kind: int } }");
  const bareDecl = topLevel(ref bare, 0);

  let test theory: Case = t.asserts("a bare case named `function` is a case, not a method") {
    const first = nodeAt(ref bare, childAt(ref bare, bareDecl, 0));
    theory.isSuccessful = bareDecl.childCount == 2
      && first.kind == ASTNodeKind.VARIANT_CASE
      && str.stringEq(first.name, "function");
    theory.detail = `member 0 of ${bareDecl.childCount} is ${first.kind} named "${first.name}", wanted VARIANT_CASE "function"`;
  }

  // A method cannot be nameless, so `function {` is unambiguous the other way.
  let payload = parseOk("variant Shape { function { n: int }, Empty }");
  const payloadDecl = topLevel(ref payload, 0);

  let test theory: Case = t.asserts("a case named `function` may carry a payload") {
    const first = nodeAt(ref payload, childAt(ref payload, payloadDecl, 0));
    theory.isSuccessful = first.kind == ASTNodeKind.VARIANT_CASE && first.childCount == 1;
    theory.detail = `member 0 is ${first.kind} with ${first.childCount} field(s), wanted VARIANT_CASE with 1`;
  }

  // And the disambiguation does not cost the ordinary reading: a real method
  // still parses as one when it sits beside a case wearing its keyword.
  let both = parseOk("variant Shape { function, function code(ref self): int { return 0; } }");
  const bothDecl = topLevel(ref both, 0);

  let test theory: Case = t.asserts("a real method beside it still parses as a method") {
    const second = nodeAt(ref both, childAt(ref both, bothDecl, 1));
    theory.isSuccessful = bothDecl.childCount == 2 && second.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `member 1 of ${bothDecl.childCount} is ${second.kind}, wanted METHOD_DECL`;
  }
}

// The struct and union half of the same rule, told apart by the COLON rather
// than by the `{` / `,` / `}` a variant body reads.
suite function functionAsAFieldNameIsToldFromAMethodByTheColon(): void {
  let structBody = parseOk("type S implements Get { function: int32, function get(ref self): int32 { return 0; } }");
  const structDecl = topLevel(ref structBody, 0);

  let test theory: Case = t.asserts("`function: T` is a field") {
    const first = nodeAt(ref structBody, childAt(ref structBody, structDecl, 0));
    theory.isSuccessful = first.kind == ASTNodeKind.FIELD_DECL
      && str.stringEq(first.name, "function");
    theory.detail = `member 0 is ${first.kind} named "${first.name}", wanted FIELD_DECL "function"`;
  }

  let test theory: Case = t.asserts("`function name(...)` beside it is still a method") {
    const second = nodeAt(ref structBody, childAt(ref structBody, structDecl, 1));
    theory.isSuccessful = structDecl.childCount == 2 && second.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `member 1 of ${structDecl.childCount} is ${second.kind}, wanted METHOD_DECL`;
  }

  // A union has no methods at all, so the colon is the whole of the question
  // there: with one it is storage, and without one it is the thing a union
  // cannot declare.
  let unionBody = parseOk("union U { function: int32, b: int32 }");
  const unionDecl = topLevel(ref unionBody, 0);

  let test theory: Case = t.asserts("a union field may be named `function` too") {
    const first = nodeAt(ref unionBody, childAt(ref unionBody, unionDecl, 0));
    theory.isSuccessful = first.kind == ASTNodeKind.FIELD_DECL
      && str.stringEq(first.name, "function");
    theory.detail = `member 0 is ${first.kind} named "${first.name}", wanted FIELD_DECL "function"`;
  }

  let test theory: Case = t.asserts("a union that really does declare a method is still refused by name") {
    const src = "union U { function fn(ref self): int32 { return 0; }, b: int32 }";
    theory.isSuccessful = refusalMentions(src, "a union cannot declare methods");
    theory.detail = `wanted a union-method refusal, got: ${parseError(src)}`;
  }
}

suite function selfReadsAsAnOrdinaryLocalInsideABody(): void {
  let ast = parseOk("type Point implements Display { x: int, function get(ref self): int { return self.x; } }");
  const method = typeMember(ref ast, 1);
  const block = nodeAt(ref ast, method.childD);
  const statements = nodeAt(ref ast, block.childA);
  const returned = nodeAt(ref ast, nodeAt(ref ast, childAt(ref ast, statements, 0)).childA);
  const base = nodeAt(ref ast, returned.childA);

  let test theory: Case = t.asserts("self.x is an ordinary field access on an ordinary IDENT") {
    theory.isSuccessful = base.kind == ASTNodeKind.IDENT && str.stringEq(base.name, "self");
    theory.detail = `the access base is ${base.kind} named "${base.name}", wanted IDENT "self"`;
  }
}

suite function templateLiteralsSplitIntoPartsInSourceOrder(): void {
  let plain = parseOk("function f(): string { return `just text`; }");
  const noInterp = returnedExpression(ref plain);

  let test theory: Case = t.asserts("a template literal is a TEMPLATE_LITERAL") {
    theory.isSuccessful = noInterp.kind == ASTNodeKind.TEMPLATE_LITERAL;
    theory.detail = `the returned expression is ${noInterp.kind}, wanted TEMPLATE_LITERAL`;
  }

  let test theory: Case = t.asserts("no interpolation is a single literal run") {
    theory.isSuccessful = noInterp.childCount == 1;
    theory.detail = `an uninterpolated template has ${noInterp.childCount} part(s), wanted 1`;
  }

  let test theory: Case = t.asserts("a literal run holds its DECODED text in the string pool") {
    const part = nodeAt(ref plain, childAt(ref plain, noInterp, 0));
    const text = poolString(ref plain, part.strId);
    theory.isSuccessful = part.kind == ASTNodeKind.STRING_PART && str.stringEq(text, "just text");
    theory.detail = `the part is ${part.kind} holding "${text}", wanted STRING_PART "just text"`;
  }

  let ast = parseOk("function f(): string { return `a${x}b`; }");
  const mixed = returnedExpression(ref ast);

  let test theory: Case = t.asserts("literal runs and interpolations alternate in source order") {
    theory.isSuccessful = mixed.childCount == 3 &&
      nodeAt(ref ast, childAt(ref ast, mixed, 0)).kind == ASTNodeKind.STRING_PART &&
      nodeAt(ref ast, childAt(ref ast, mixed, 1)).kind == ASTNodeKind.EXPR_PART &&
      nodeAt(ref ast, childAt(ref ast, mixed, 2)).kind == ASTNodeKind.STRING_PART;
    theory.detail = `\`a\${x}b\` produced ${mixed.childCount} part(s), wanted STRING_PART, EXPR_PART, STRING_PART`;
  }

  let test theory: Case = t.asserts("an interpolation holds a real expression") {
    const exprPart = nodeAt(ref ast, childAt(ref ast, mixed, 1));
    const inner = nodeAt(ref ast, exprPart.childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.IDENT && str.stringEq(inner.name, "x");
    theory.detail = `the interpolation holds ${inner.kind} named "${inner.name}", wanted IDENT "x"`;
  }

  // An empty literal run would cost a concat operand contributing nothing, so
  // it is never emitted - which is also why the part count is worth asserting.
  let bare = parseOk("function f(): string { return `${x}`; }");
  let test theory: Case = t.asserts("an interpolation alone produces no empty literal runs") {
    theory.isSuccessful = returnedExpression(ref bare).childCount == 1;
    theory.detail = `\`\${x}\` produced ${returnedExpression(ref bare).childCount} part(s), wanted 1`;
  }

  let empty = parseOk("function f(): string { return ``; }");
  let test theory: Case = t.asserts("the empty template has no parts at all") {
    theory.isSuccessful = returnedExpression(ref empty).childCount == 0;
    theory.detail = `the empty template produced ${returnedExpression(ref empty).childCount} part(s), wanted 0`;
  }
}

// Where an interpolation ENDS is decided by the expression parser, not by
// matching braces in the raw text. These are the cases that separate the two:
// brace matching gets every one of them wrong.
suite function interpolationEndsWhereItsExpressionEnds(): void {
  let braces = parseOk("function f(): string { return `v=${g({ x: 1, y: 2 })}!`; }");
  const withBraces = returnedExpression(ref braces);

  let test theory: Case = t.asserts("braces inside an interpolation do not close it") {
    theory.isSuccessful = withBraces.childCount == 3;
    theory.detail = `an interpolated struct literal produced ${withBraces.childCount} part(s), wanted 3`;
  }

  let test theory: Case = t.asserts("the literal run after such an interpolation is intact") {
    const tail = nodeAt(ref braces, childAt(ref braces, withBraces, 2));
    const text = poolString(ref braces, tail.strId);
    theory.isSuccessful = str.stringEq(text, "!");
    theory.detail = `the trailing run is "${text}", wanted "!"`;
  }

  // A `}` inside a nested STRING. The JS reference cannot lex this one at all.
  let quoted = parseOk("function f(): string { return `v=${g(\"}\")}!`; }");
  let test theory: Case = t.asserts("a brace inside a nested string literal does not close it") {
    theory.isSuccessful = returnedExpression(ref quoted).childCount == 3;
    theory.detail = `an interpolated \"}\" produced ${returnedExpression(ref quoted).childCount} part(s), wanted 3`;
  }

  // The parser is repositioned mid-template while interpolations are parsed, so
  // whether it lands back on the token AFTER the template is a real question.
  let resumes = parseOk("function f(): int { const s: string = `a${x}b`; return 1; }");
  let test theory: Case = t.asserts("the parser resumes at the token after the closing backtick") {
    const fn = topLevel(ref resumes, 0);
    const block = nodeAt(ref resumes, fn.childD);
    const statements = nodeAt(ref resumes, block.childA);
    theory.isSuccessful = statements.childCount == 2;
    theory.detail = `the body parsed ${statements.childCount} statement(s) after a template, wanted 2`;
  }
}

suite function templateEscapesAreDecodedNotInterpreted(): void {
  // `\${` is a literal dollar-brace. Without this the escape scan and the
  // interpolation scan disagree, and the text silently becomes an expression.
  let escaped = parseOk("function f(): string { return `\\${x}`; }");
  const node = returnedExpression(ref escaped);

  let test theory: Case = t.asserts("an escaped dollar-brace opens no interpolation") {
    theory.isSuccessful = node.childCount == 1 &&
      nodeAt(ref escaped, childAt(ref escaped, node, 0)).kind == ASTNodeKind.STRING_PART;
    theory.detail = `\`\\\${x}\` produced ${node.childCount} part(s), wanted one STRING_PART`;
  }

  let test theory: Case = t.asserts("and decodes to the literal characters") {
    const part = nodeAt(ref escaped, childAt(ref escaped, node, 0));
    const text = poolString(ref escaped, part.strId);
    theory.isSuccessful = str.stringEq(text, "${x}");
    theory.detail = `the run decoded to "${text}", wanted "\${x}"`;
  }

  let tick = parseOk("function f(): string { return `a\\`b`; }");
  let test theory: Case = t.asserts("a template can escape its own delimiter") {
    const part = nodeAt(ref tick, childAt(ref tick, returnedExpression(ref tick), 0));
    const text = poolString(ref tick, part.strId);
    theory.isSuccessful = str.stringEq(text, "a`b");
    theory.detail = `the run decoded to "${text}", wanted "a\`b"`;
  }

  let test theory: Case = t.asserts("an interpolation with no expression is refused") {
    theory.isSuccessful = parseError("function f(): string { return `${}`; }").len > 0;
    theory.detail = "`${}` parsed without a diagnostic";
  }
}

suite function forInLoopsAreTheirOwnStatement(): void {
  let ast = parseOk("function f(): int { for x in xs { return x; } return 0; }");
  const loop = firstStatement(ref ast);

  let test theory: Case = t.asserts("`for x in xs` is a FOR_IN_LOOP, not a FOR_LOOP") {
    theory.isSuccessful = loop.kind == ASTNodeKind.FOR_IN_LOOP;
    theory.detail = `the statement is ${loop.kind}, wanted FOR_IN_LOOP`;
  }

  let test theory: Case = t.asserts("the loop variable lands on the node's name") {
    theory.isSuccessful = str.stringEq(loop.name, "x");
    theory.detail = `the loop variable is "${loop.name}", wanted "x"`;
  }

  let test theory: Case = t.asserts("the iterable is a real expression, not just a name") {
    let call = parseOk("function f(): int { for e in view(ref h) { return 1; } return 0; }");
    const iterable = nodeAt(ref call, firstStatement(ref call).childA);
    theory.isSuccessful = iterable.kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = `the iterable is ${iterable.kind}, wanted CALL_EXPRESSION`;
  }

  // The keyword is shared, and the token right after it is the whole fork. A
  // counted loop must still reach the counted parser.
  let counted = parseOk("function f(): int { for (let i = 0; i < 3; i = i + 1) { return i; } return 0; }");
  let test theory: Case = t.asserts("the counted form still parses as a FOR_LOOP") {
    theory.isSuccessful = firstStatement(ref counted).kind == ASTNodeKind.FOR_LOOP;
    theory.detail = `the counted form parsed as ${firstStatement(ref counted).kind}, wanted FOR_LOOP`;
  }

  // A loop variable takes no annotation - its type is the element type, so
  // there is nothing to say and a mismatch could not mean anything.
  let test theory: Case = t.asserts("an annotated loop variable is refused") {
    theory.isSuccessful = parseError("function f(): int { for x: int in xs { return x; } return 0; }").len > 0;
    theory.detail = "`for x: int in xs` parsed without a diagnostic";
  }
}

suite function kindDeclarationsRecordTheirClauses(): void {
  let ast = parseOk("kind disposable { appliesTo binding; requires Disposable; mustCall dispose beforeScopeEnd; ownsBlock; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("`kind NAME { ... }` is a KIND_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.KIND_DECL && str.stringEq(decl.name, "disposable");
    theory.detail = `the first top-level node is ${decl.kind} named "${decl.name}", wanted KIND_DECL "disposable"`;
  }

  let test theory: Case = t.asserts("each clause is one node in the decl's own child run") {
    theory.isSuccessful = decl.childCount == 4;
    theory.detail = `the kind has ${decl.childCount} clause(s), wanted 4`;
  }

  // A clause is a run of tokens ending in `;`, recorded by its LEADING WORD.
  // Some of these words are keywords in this lexer and some are not, so the
  // name comes from the source text rather than the tag - otherwise the two
  // spellings would record differently.
  let test theory: Case = t.asserts("a clause is named for its leading word, keyword or not") {
    const first = nodeAt(ref ast, childAt(ref ast, decl, 0));
    const last = nodeAt(ref ast, childAt(ref ast, decl, 3));
    theory.isSuccessful = str.stringEq(first.name, "appliesTo") && str.stringEq(last.name, "ownsBlock");
    theory.detail = `clauses recorded as "${first.name}" ... "${last.name}", wanted "appliesTo" ... "ownsBlock"`;
  }

  let test theory: Case = t.asserts("a multi-word clause is still one clause") {
    const third = nodeAt(ref ast, childAt(ref ast, decl, 2));
    theory.isSuccessful = str.stringEq(third.name, "mustCall");
    theory.detail = `the third clause is "${third.name}", wanted "mustCall"`;
  }

  let params = parseOk("kind aligned(n: usize) { appliesTo binding; }");
  let test theory: Case = t.asserts("a parameterized kind keeps its parameter list") {
    theory.isSuccessful = topLevel(ref params, 0).childA != 0;
    theory.detail = "`kind aligned(n: usize)` recorded no parameter list";
  }

  // A clause body can be a braced block, so a clause ends at the `;` at DEPTH
  // ZERO. Stopping at the first `;` leaves a stray `}` that surfaces much later
  // as "unexpected token at top level".
  let braced = parseOk("kind c_layout { appliesTo type; layout { abi \"C\"; }; }\nfunction f(): int { return 1; }");
  let test theory: Case = t.asserts("a braced clause body does not end the clause early") {
    theory.isSuccessful = topLevel(ref braced, 0).childCount == 2 &&
      topLevel(ref braced, 1).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `recorded ${topLevel(ref braced, 0).childCount} clause(s), and the next decl is ${topLevel(ref braced, 1).kind}`;
  }

  // A kind on a TYPE is written AFTER the name, unlike the one on a function.
  let onType = parseOk("type SockAddrIn c_layout { x: int, }");
  let test theory: Case = t.asserts("a type takes its kind after the name") {
    const decl = topLevel(ref onType, 0);
    theory.isSuccessful = decl.kind == ASTNodeKind.TYPE_DECL && decl.childB != 0 && decl.childCount == 1;
    theory.detail = `the decl is ${decl.kind} with kind slot ${decl.childB} and ${decl.childCount} field(s)`;
  }

  let withArgs = parseOk("type Buf aligned(16) { x: int, }");
  let test theory: Case = t.asserts("a kind's arguments are consumed, not left to confuse the body") {
    theory.isSuccessful = topLevel(ref withArgs, 0).childCount == 1;
    theory.detail = `the decl recorded ${topLevel(ref withArgs, 0).childCount} field(s), wanted 1`;
  }

  let composed = parseOk("kind scoped = disposable_base & noescape;\nfunction f(): int { return 1; }");
  let test theory: Case = t.asserts("a composition parses and does not swallow what follows") {
    theory.isSuccessful = topLevel(ref composed, 0).kind == ASTNodeKind.KIND_DECL &&
      topLevel(ref composed, 1).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `after a composition the next decl is ${topLevel(ref composed, 1).kind}, wanted FUNCTION_DECL`;
  }

  // A composition is a FLAT intersection. Consuming a parenthesis silently
  // parsed `(b & c) & d` as `b & c & d`, which reads as a grouping the grammar
  // does not have and quietly agreed with whatever the writer meant by it.
  let test theory: Case = t.asserts("a parenthesized composition operand is refused") {
    const err = parseError("kind a = (b & c) & d;");
    theory.isSuccessful = str.stringIndexOf(err, "parenthesizes its composition operands") < err.len;
    theory.detail = `wanted a grouping refusal, got: ${err}`;
  }

  // A layout body holds SUB-CLAUSES, not loose words: `abi "C"` is a leading
  // word plus its own argument, the same shape the outer level has. Recorded
  // that way so a rule can tell which argument belongs to which sub-clause.
  let layout = parseOk("kind c_layout { appliesTo type; layout { abi \"C\"; align 8; }; }");
  let test theory: Case = t.asserts("a layout body is recorded as sub-clauses on the clause") {
    const clause = nodeAt(ref layout, childAt(ref layout, topLevel(ref layout, 0), 1));
    const body = nodeAt(ref layout, clause.childA);
    theory.isSuccessful = clause.childA != 0 && body.childCount == 2;
    theory.detail = `the layout body recorded ${body.childCount} sub-clause(s), wanted 2`;
  }
  let test theory: Case = t.asserts("a sub-clause keeps its argument's source spelling, quotes included") {
    const clause = nodeAt(ref layout, childAt(ref layout, topLevel(ref layout, 0), 1));
    const body = nodeAt(ref layout, clause.childA);
    const abi = nodeAt(ref layout, childAt(ref layout, body, 0));
    const marker = nodeAt(ref layout, childAt(ref layout, abi, 0));
    theory.isSuccessful = str.stringEq(abi.name, "abi") && str.stringEq(marker.name, "\"C\"");
    theory.detail = `recorded "${abi.name}" with argument ${marker.name}, wanted abi with "C" quoted`;
  }
}

// `disposable reg: T = expr { ... }` - a kind-prefixed binding that OWNS a
// block. The block is the binding's whole SCOPE, which is what makes it
// different from a plain `disposable` binding whose disposal waits for the
// enclosing function to end.
suite function aKindPrefixedBindingMayOwnABlock(): void {
  let ast = parseOk("function f(): int { disposable a: H = make() { g(a); } return 0; }");
  const body = nodeAt(ref ast, nodeAt(ref ast, topLevel(ref ast, 0).childD).childA);
  const decl = nodeAt(ref ast, childAt(ref ast, body, 0));

  let test theory: Case = t.asserts("the binding is an ordinary CONST_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.CONST_DECL && str.stringEq(decl.name, "a");
    theory.detail = `the statement is ${decl.kind} named "${decl.name}"`;
  }
  let test theory: Case = t.asserts("the block lands in its own slot, beside the initializer") {
    theory.isSuccessful = decl.childB != 0 && decl.childD != 0 &&
      nodeAt(ref ast, decl.childD).kind == ASTNodeKind.BLOCK;
    theory.detail = `initializer slot ${decl.childB}, block slot ${decl.childD}`;
  }
  let test theory: Case = t.asserts("the statement after the block is still the function's") {
    theory.isSuccessful = body.childCount == 2 &&
      nodeAt(ref ast, childAt(ref ast, body, 1)).kind == ASTNodeKind.RETURN_STATEMENT;
    theory.detail = `the body has ${body.childCount} statement(s)`;
  }

  // No block is the ordinary binding, and it must not have grown one.
  let plain = parseOk("function f(): int { disposable a: H = make(); return 0; }");
  let test theory: Case = t.asserts("a prefixed binding without a block records none") {
    const d = nodeAt(ref plain, childAt(ref plain, nodeAt(ref plain, nodeAt(ref plain, topLevel(ref plain, 0).childD).childA), 0));
    theory.isSuccessful = d.childD == 0;
    theory.detail = `a plain disposable binding recorded block slot ${d.childD}`;
  }

  // The form is GATED on there being a kind prefix. Without one, a `{` after
  // the initializer is a separate block statement and the `;` is required - so
  // an ordinary binding cannot silently swallow the block after it.
  let test theory: Case = t.asserts("an unprefixed binding still requires its semicolon") {
    const src = "function f(): int { const a: H = make() { g(); } return 0; }";
    theory.isSuccessful = refusalMentions(src, "expected SEMICOLON");
    theory.detail = `wanted a missing-semicolon refusal, got: ${parseError(src)}`;
  }

  // The ANONYMOUS form beside it, whose subject may be a QUALIFIED call:
  // `ephemeral mem.arenaScope(1024) { ... }`. Values from std must come through
  // a namespace, so stopping the lookahead at `(` would refuse the spelling
  // every std user actually writes.
  let region = parseOk("function f(): int { ephemeral mem.arenaScope(1024) { g(); } return 0; }");
  let test theory: Case = t.asserts("an anonymous region takes a qualified subject") {
    const body = nodeAt(ref region, nodeAt(ref region, topLevel(ref region, 0).childD).childA);
    const stmt = nodeAt(ref region, childAt(ref region, body, 0));
    theory.isSuccessful = stmt.kind == ASTNodeKind.KIND_REGION && stmt.childB != 0;
    theory.detail = `the statement is ${stmt.kind}, block slot ${stmt.childB}`;
  }
}

// `async` is a kind, not a keyword - so a kind prefix stands where `function`
// would rather than in front of it, and the parser needs no list of blessed
// words to recognize one.
suite function kindPrefixesReplaceTheFunctionKeyword(): void {
  let ast = parseOk("async fetch(u: string): string { return u; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("a kind-prefixed declaration is an ordinary FUNCTION_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(decl.name, "fetch");
    theory.detail = `the node is ${decl.kind} named "${decl.name}", wanted FUNCTION_DECL "fetch"`;
  }

  let test theory: Case = t.asserts("the prefix is recorded rather than dropped") {
    const prefixes = nodeAt(ref ast, decl.childE);
    const first = nodeAt(ref ast, childAt(ref ast, prefixes, 0));
    theory.isSuccessful = prefixes.childCount == 1 && str.stringEq(first.name, "async");
    theory.detail = `recorded ${prefixes.childCount} prefix(es), first "${first.name}", wanted 1 and "async"`;
  }

  let test theory: Case = t.asserts("the parameters and return type survive the shared path") {
    const params = nodeAt(ref ast, decl.childB);
    theory.isSuccessful = params.childCount == 1 && decl.childC != 0 && decl.childD != 0;
    theory.detail = `${params.childCount} param(s), return slot ${decl.childC}, body slot ${decl.childD}`;
  }

  let several = parseOk("pooled tainted buf(): int { return 1; }");
  let test theory: Case = t.asserts("several prefixes all land in the list") {
    theory.isSuccessful = nodeAt(ref several, topLevel(ref several, 0).childE).childCount == 2;
    theory.detail = `recorded ${nodeAt(ref several, topLevel(ref several, 0).childE).childCount} prefix(es), wanted 2`;
  }

  // The plain form has to keep working: the two spellings share everything from
  // the name onward, so a change to one is a change to both.
  let plain = parseOk("function fetch(u: string): string { return u; }");
  let test theory: Case = t.asserts("a plain `function` still parses, with no prefixes") {
    theory.isSuccessful = topLevel(ref plain, 0).kind == ASTNodeKind.FUNCTION_DECL &&
      topLevel(ref plain, 0).childE == 0;
    theory.detail = `plain function recorded prefix slot ${topLevel(ref plain, 0).childE}, wanted 0`;
  }

  let exported = parseOk("export async fetch(): int { return 1; }");
  let test theory: Case = t.asserts("`export async` reaches the same parser") {
    const inner = nodeAt(ref exported, topLevel(ref exported, 0).childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.FUNCTION_DECL && inner.childE != 0;
    theory.detail = `the exported decl is ${inner.kind} with prefix slot ${inner.childE}`;
  }

  let exportedKind = parseOk("export kind async { appliesTo function; pausable; }");
  let test theory: Case = t.asserts("`export kind` reaches the kind parser") {
    const inner = nodeAt(ref exportedKind, topLevel(ref exportedKind, 0).childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.KIND_DECL;
    theory.detail = `the exported decl is ${inner.kind}, wanted KIND_DECL`;
  }

  // The one async form the bootstrap's own std closure needs, and the one that
  // needs no codegen at all - a signature has no body to emit.
  let sig = parseOk("trait Readable { async read(ref self, ref buf: uint8[]): int; }");
  let test theory: Case = t.asserts("a trait method signature takes a kind prefix too") {
    const method = nodeAt(ref sig, childAt(ref sig, topLevel(ref sig, 0), 0));
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_SIG && method.childE != 0 && method.childD == 0;
    theory.detail = `the member is ${method.kind}, prefix slot ${method.childE}, body slot ${method.childD}`;
  }
}

// A kind prefix may stand BESIDE the `function` keyword as well as instead of
// it - `suite function addsNumbers(): void { }`, which is how every file in
// examples/testing/ and every *.test.yoop in this tree declares a suite.
//
// The two spellings had drifted apart: a METHOD accepted both because
// `parseKindPrefixRun` consumes the keyword when it is there, and a top-level
// declaration went through `parseKindPrefixes`, which stops on IDENT-then-
// FUNCTION and left the run empty. So `suite function f()` reported "unexpected
// token at top level: IDENT" on a declaration that is perfectly well formed.
suite function kindPrefixesBesideTheFunctionKeyword(): void {
  let ast = parseOk("suite function addsNumbers(): void { return; }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("prefix-and-keyword is an ordinary FUNCTION_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(decl.name, "addsNumbers");
    theory.detail = `the node is ${decl.kind} named "${decl.name}", wanted FUNCTION_DECL "addsNumbers"`;
  }

  let test theory: Case = t.asserts("the prefix is recorded, not eaten by the keyword") {
    const prefixes = nodeAt(ref ast, decl.childE);
    const first = nodeAt(ref ast, childAt(ref ast, prefixes, 0));
    theory.isSuccessful = prefixes.childCount == 1 && str.stringEq(first.name, "suite");
    theory.detail = `recorded ${prefixes.childCount} prefix(es), first "${first.name}", wanted 1 and "suite"`;
  }

  // The keyword is consumed rather than left for the name parser, so the body
  // is where it belongs. A run that stopped one token early would name the
  // function "function" and then fail on the parameter list.
  let test theory: Case = t.asserts("the body and return type survive the keyword") {
    theory.isSuccessful = decl.childC != 0 && decl.childD != 0;
    theory.detail = `return slot ${decl.childC}, body slot ${decl.childD}, wanted both non-zero`;
  }

  let several = parseOk("pooled tainted function buf(): int { return 1; }");
  let test theory: Case = t.asserts("several prefixes and a keyword all land in the list") {
    theory.isSuccessful = nodeAt(ref several, topLevel(ref several, 0).childE).childCount == 2;
    theory.detail = `recorded ${nodeAt(ref several, topLevel(ref several, 0).childE).childCount} prefix(es), wanted 2`;
  }

  let exported = parseOk("export suite function addsNumbers(): void { return; }");
  let test theory: Case = t.asserts("`export suite function` reaches the same parser") {
    const inner = nodeAt(ref exported, topLevel(ref exported, 0).childA);
    theory.isSuccessful = inner.kind == ASTNodeKind.FUNCTION_DECL && inner.childE != 0;
    theory.detail = `the exported decl is ${inner.kind} with prefix slot ${inner.childE}`;
  }

  // The METHOD side of the same spelling, which is what it was already doing -
  // asserted here so the two stay one mechanism rather than two.
  let method = parseOk("type Echo { n: int, traced function area(ref self): int { return self.n; } }");
  let test theory: Case = t.asserts("a method takes prefix-and-keyword too") {
    const m = nodeAt(ref method, childAt(ref method, topLevel(ref method, 0), 1));
    theory.isSuccessful = m.kind == ASTNodeKind.METHOD_DECL && m.childE != 0 && str.stringEq(m.name, "area");
    theory.detail = `the member is ${m.kind} named "${m.name}", prefix slot ${m.childE}`;
  }

  // A bare `function` with nothing in front of it is still a plain function -
  // accepting IDENT-then-FUNCTION at top level must not make one of those into
  // a prefixed declaration with an empty prefix list.
  let plain = parseOk("function addsNumbers(): void { return; }");
  let test theory: Case = t.asserts("a plain `function` records no prefix list") {
    theory.isSuccessful = topLevel(ref plain, 0).childE == 0;
    theory.detail = `plain function recorded prefix slot ${topLevel(ref plain, 0).childE}, wanted 0`;
  }
}

// A method is a function one scope in, so a kind prefix stands where `function`
// would there too. The synthesized `ref self` has to survive it, which is the
// half a "does it parse" check would miss.
suite function kindPrefixesOnAMethod(): void {
  let ast = parseOk("type Echo { greeting: string, async handle(ref self, n: int): int { return n; } }");
  const decl = topLevel(ref ast, 0);
  const method = nodeAt(ref ast, childAt(ref ast, decl, 1));

  let test theory: Case = t.asserts("a kind-prefixed method is an ordinary METHOD_DECL") {
    theory.isSuccessful = method.kind == ASTNodeKind.METHOD_DECL && str.stringEq(method.name, "handle");
    theory.detail = `the member is ${method.kind} named "${method.name}"`;
  }

  let test theory: Case = t.asserts("the prefix lands in the same slot a function's does") {
    const prefixes = nodeAt(ref ast, method.childE);
    theory.isSuccessful = method.childE != 0 && prefixes.childCount == 1 &&
      str.stringEq(nodeAt(ref ast, childAt(ref ast, prefixes, 0)).name, "async");
    theory.detail = `prefix slot ${method.childE}`;
  }

  // The receiver's annotation is SYNTHESIZED from the enclosing type, and the
  // prefix must not knock that off the path.
  let test theory: Case = t.asserts("`ref self` is still annotated with the type's name") {
    const params = nodeAt(ref ast, method.childB);
    const receiver = nodeAt(ref ast, childAt(ref ast, params, 0));
    theory.isSuccessful = receiver.flagA && str.stringEq(nodeAt(ref ast, receiver.childA).name, "Echo");
    theory.detail = `self's annotation is "${nodeAt(ref ast, receiver.childA).name}", isRef=${receiver.flagA}`;
  }

  // The reference accepts the prefix and the keyword TOGETHER, in a struct body
  // where a bare identifier cannot be a member on its own.
  let both = parseOk("type Echo { async function handle(ref self): int { return 1; } }");
  let test theory: Case = t.asserts("a prefix and `function` together also parse") {
    const m = nodeAt(ref both, childAt(ref both, topLevel(ref both, 0), 0));
    theory.isSuccessful = m.kind == ASTNodeKind.METHOD_DECL && m.childE != 0;
    theory.detail = `the member is ${m.kind}, prefix slot ${m.childE}`;
  }

  // A variant takes one the same way a struct does.
  let variantBody = parseOk("variant Shape { Circle { r: int }, async area(ref self): int { return 1; } }");
  let test theory: Case = t.asserts("a variant method takes a kind prefix") {
    const m = nodeAt(ref variantBody, childAt(ref variantBody, topLevel(ref variantBody, 0), 1));
    theory.isSuccessful = m.kind == ASTNodeKind.METHOD_DECL && m.childE != 0;
    theory.detail = `the member is ${m.kind}, prefix slot ${m.childE}`;
  }

  // And an ENUM case followed by a method with no comma still reads as two
  // members. `Green function toString` is IDENT FUNCTION, the same two tokens
  // `async function handle` opens with - the body decides which.
  let enumBody = parseOk("enum C { Red, Green function toString(ref self): int { return 1; } }");
  let test theory: Case = t.asserts("an enum case before a method is still a case") {
    const d = topLevel(ref enumBody, 0);
    const last = nodeAt(ref enumBody, childAt(ref enumBody, d, 2));
    theory.isSuccessful = d.childCount == 3 && last.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the enum has ${d.childCount} member(s), last is ${last.kind}`;
  }
}

// `scoped h: ref FileHandle` - the kind a PARAMETER carries, written before its
// name rather than inside its annotation.
suite function kindPrefixesOnAParameter(): void {
  let ast = parseOk("function use(scoped h: int, n: int): void { }");
  const params = nodeAt(ref ast, topLevel(ref ast, 0).childB);
  const first = nodeAt(ref ast, childAt(ref ast, params, 0));
  const second = nodeAt(ref ast, childAt(ref ast, params, 1));

  let test theory: Case = t.asserts("the prefix is recorded and the name is still the name") {
    theory.isSuccessful = first.childE != 0 && str.stringEq(first.name, "h");
    theory.detail = `parameter "${first.name}" recorded prefix slot ${first.childE}`;
  }

  let test theory: Case = t.asserts("a plain parameter beside it records nothing") {
    theory.isSuccessful = second.childE == 0 && str.stringEq(second.name, "n");
    theory.detail = `parameter "${second.name}" recorded prefix slot ${second.childE}`;
  }

  // `ref` comes AFTER the kind, which is what keeps the two-identifier test
  // decidable: `ref h: T` opens with REF and never reaches it.
  let borrowed = parseOk("function use(scoped ref h: int): void { }");
  let test theory: Case = t.asserts("a prefix and `ref` compose") {
    const p = nodeAt(ref borrowed, childAt(ref borrowed, nodeAt(ref borrowed, topLevel(ref borrowed, 0).childB), 0));
    theory.isSuccessful = p.childE != 0 && p.flagA;
    theory.detail = `prefix slot ${p.childE}, isRef=${p.flagA}`;
  }

  // At most ONE, which is the reference's rule and not the grammar's.
  let test theory: Case = t.asserts("two prefixes on one parameter are refused by name") {
    theory.isSuccessful = refusalMentions("function use(scoped pooled h: int): void { }", "at most one kind prefix");
    theory.detail = `wanted a one-prefix refusal, got: ${parseError("function use(scoped pooled h: int): void { }")}`;
  }

  // A method's parameters go through their own parser, so they need their own
  // check.
  let method = parseOk("type B { function get(ref self, scoped n: int): int { return n; } }");
  let test theory: Case = t.asserts("a method parameter takes one too") {
    const m = nodeAt(ref method, childAt(ref method, topLevel(ref method, 0), 0));
    const p = nodeAt(ref method, childAt(ref method, nodeAt(ref method, m.childB), 1));
    theory.isSuccessful = p.childE != 0 && str.stringEq(p.name, "n");
    theory.detail = `parameter "${p.name}" recorded prefix slot ${p.childE}`;
  }
}

suite function propagatesClausesAreRecorded(): void {
  let fn = parseOk("function vecNew(n: usize): int propagates<disposable> { return 1; }");
  const decl = topLevel(ref fn, 0);

  let test theory: Case = t.asserts("a function's clause lands in its own slot") {
    theory.isSuccessful = decl.childF != 0;
    theory.detail = `the function's propagates slot is ${decl.childF}, wanted non-zero`;
  }

  let test theory: Case = t.asserts("the clause is a list of the kinds it names") {
    const list = nodeAt(ref fn, decl.childF);
    const first = nodeAt(ref fn, childAt(ref fn, list, 0));
    theory.isSuccessful = list.childCount == 1 && str.stringEq(first.name, "disposable");
    theory.detail = `recorded ${list.childCount} kind(s), first "${first.name}", wanted 1 and "disposable"`;
  }

  let test theory: Case = t.asserts("the body still parses after the clause") {
    theory.isSuccessful = decl.childD != 0;
    theory.detail = `the body slot is ${decl.childD}, wanted non-zero`;
  }

  let several = parseOk("function f(): int propagates<disposable, tainted> { return 1; }");
  let test theory: Case = t.asserts("several kinds all land in the list") {
    theory.isSuccessful = nodeAt(ref several, topLevel(ref several, 0).childF).childCount == 2;
    theory.detail = `recorded ${nodeAt(ref several, topLevel(ref several, 0).childF).childCount} kind(s), wanted 2`;
  }

  let none = parseOk("function f(): int { return 1; }");
  let test theory: Case = t.asserts("no clause is 0, not an empty list") {
    theory.isSuccessful = topLevel(ref none, 0).childF == 0;
    theory.detail = `a function with no clause has childF ${topLevel(ref none, 0).childF}, wanted 0`;
  }

  let onType = parseOk("type Buf propagates<disposable> { n: int, }");
  let test theory: Case = t.asserts("a type takes the clause after its name") {
    const t2 = topLevel(ref onType, 0);
    theory.isSuccessful = t2.kind == ASTNodeKind.TYPE_DECL && t2.childF != 0 && t2.childCount == 1;
    theory.detail = `the decl is ${t2.kind} with clause slot ${t2.childF} and ${t2.childCount} field(s)`;
  }

  // The clauses have a fixed order, and a parser that took them in the wrong
  // one would read `propagates` as a trait name.
  let both = parseOk("variant R implements Disposable propagates<disposable> { A, B }");
  let test theory: Case = t.asserts("a variant takes implements and propagates, in that order") {
    const v = topLevel(ref both, 0);
    theory.isSuccessful = v.childD != 0 && v.childF != 0 && v.childCount == 2;
    theory.detail = `implements slot ${v.childD}, propagates slot ${v.childF}, ${v.childCount} case(s)`;
  }
}

// `Buf propagates<tracked>` and `disposable Buf` are both two identifiers in a
// row: one is a type followed by a clause, the other a kind prefix followed by
// a type. `propagates` is contextual, so telling them apart means reading the
// second identifier's TEXT rather than its tag - and getting it wrong makes
// `propagates` itself the type name, which reads as "unknown type propagates".
suite function aClauseKeywordIsNotAKindPrefix(): void {
  let ast = parseOk("function make(): Buf propagates<tracked> { return 1; }");
  const decl = topLevel(ref ast, 0);
  const ret = nodeAt(ref ast, decl.childC);

  let test theory: Case = t.asserts("the return type is the type, not the clause keyword") {
    theory.isSuccessful = str.stringEq(ret.name, "Buf");
    theory.detail = `the return type parsed as "${ret.name}", wanted "Buf"`;
  }

  let test theory: Case = t.asserts("and the clause is still recorded") {
    theory.isSuccessful = decl.childF != 0;
    theory.detail = `the clause slot is ${decl.childF}, wanted non-zero`;
  }

  // The real kind-prefix form has to keep working, or the guard above is just
  // breaking prefixes to fix clauses.
  let prefixed = parseOk("type Handle disposable { n: int, }");
  let test theory: Case = t.asserts("a genuine kind on a type still parses") {
    theory.isSuccessful = topLevel(ref prefixed, 0).childB != 0;
    theory.detail = `the kind slot is ${topLevel(ref prefixed, 0).childB}, wanted non-zero`;
  }
}

suite function charLiteralsAreIntegerLiterals(): void {
  let ast = parseOk("function f(): int { return 'a'; }");
  const node = returnedExpression(ref ast);

  // The lexer already decoded the codepoint, so there is nothing for a separate
  // node kind to carry - and making one would give the typechecker a second
  // literal to pin, for no gain.
  let test theory: Case = t.asserts("a char literal builds an INT_LITERAL") {
    theory.isSuccessful = node.kind == ASTNodeKind.INT_LITERAL;
    theory.detail = `'a' parsed as ${node.kind}, wanted INT_LITERAL`;
  }

  let test theory: Case = t.asserts("carrying the codepoint as its value") {
    theory.isSuccessful = node.intVal == 97;
    theory.detail = `'a' has value ${node.intVal}, wanted 97`;
  }

  let escaped = parseOk("function f(): int { return '\\n'; }");
  let test theory: Case = t.asserts("an escape decodes to its byte") {
    theory.isSuccessful = returnedExpression(ref escaped).intVal == 10;
    theory.detail = `'\\n' has value ${returnedExpression(ref escaped).intVal}, wanted 10`;
  }

  // A FLOAT literal, unlike a char, does get its own node kind - it pins to a
  // different set of types and lowers to different opcodes - and it carries its
  // value in `floatVal` rather than in the int slot.
  let flt = parseOk("function f(): float64 { return 1.5; }");
  let test theory: Case = t.asserts("a float literal builds a FLOAT_LITERAL") {
    theory.isSuccessful = returnedExpression(ref flt).kind == ASTNodeKind.FLOAT_LITERAL;
    theory.detail = `1.5 parsed as ${returnedExpression(ref flt).kind}, wanted FLOAT_LITERAL`;
  }
  let test theory: Case = t.asserts("carrying the decoded value in floatVal") {
    theory.isSuccessful = returnedExpression(ref flt).floatVal == 1.5;
    theory.detail = `1.5 has floatVal ${returnedExpression(ref flt).floatVal}`;
  }
  let test theory: Case = t.asserts("and leaving the int slot alone") {
    theory.isSuccessful = returnedExpression(ref flt).intVal == 0;
    theory.detail = `1.5 has intVal ${returnedExpression(ref flt).intVal}, wanted 0`;
  }

  // A jump table dispatches on an integer, so a float pattern is refused by
  // name - the reference refuses it with this same sentence.
  let test theory: Case = t.asserts("a float in a switch pattern is refused by name") {
    theory.isSuccessful = refusalMentions(
      "function f(x: float64): int { switch (x) { case 1.5: { return 1; } default: { return 0; } } }",
      "float literals are not allowed in switch patterns"
    );
    theory.detail = `wanted a float-pattern refusal, got: ${parseError("function f(x: float64): int { switch (x) { case 1.5: { return 1; } default: { return 0; } } }")}`;
  }

  let quote = parseOk("function f(): int { return '\\''; }");
  let test theory: Case = t.asserts("a char literal can escape its own delimiter") {
    theory.isSuccessful = returnedExpression(ref quote).intVal == 39;
    theory.detail = `'\\'' has value ${returnedExpression(ref quote).intVal}, wanted 39`;
  }

  // In a PATTERN too. `case '0', '1':` is how std spells a digit test, and the
  // pattern parser has its own literal path that would otherwise reject it.
  let pattern = parseOk("function f(b: uint8): int { switch (b) { case '0': { return 1; } default: { return 0; } } }");
  let test theory: Case = t.asserts("a char literal works as a switch pattern") {
    theory.isSuccessful = firstSwitchPattern(ref pattern).intVal == 48;
    theory.detail = `case '0' has value ${firstSwitchPattern(ref pattern).intVal}, wanted 48`;
  }
}

suite function functionTypeAnnotationsParse(): void {
  let ast = parseOk("type Ops { hash: (k: string, n: usize) => uint64, }");
  const field = nodeAt(ref ast, childAt(ref ast, topLevel(ref ast, 0), 0));
  const annot = nodeAt(ref ast, field.childA);

  let test theory: Case = t.asserts("a `=>` annotation is a FUNC_TYPE") {
    theory.isSuccessful = annot.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE;
    theory.detail = `the field's annotation is ${annot.kind}, wanted TYPE_ANNOTATION_FUNC_TYPE`;
  }

  let test theory: Case = t.asserts("its parameters land in a list, its return in childB") {
    const params = nodeAt(ref ast, annot.childA);
    theory.isSuccessful = params.childCount == 2 && annot.childB != 0;
    theory.detail = `${params.childCount} param(s), return slot ${annot.childB}`;
  }

  let none = parseOk("type Ops { run: () => void, }");
  let test theory: Case = t.asserts("an empty parameter list is legal") {
    const a2 = nodeAt(ref none, nodeAt(ref none, childAt(ref none, topLevel(ref none, 0), 0)).childA);
    theory.isSuccessful = a2.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE &&
      nodeAt(ref none, a2.childA).childCount == 0;
    theory.detail = `an empty parameter list parsed as ${a2.kind}`;
  }

  let refParam = parseOk("type Ops { fill: (ref buf: uint8[]) => void, }");
  let test theory: Case = t.asserts("a ref parameter is part of the signature") {
    const a3 = nodeAt(ref refParam, nodeAt(ref refParam, childAt(ref refParam, topLevel(ref refParam, 0), 0)).childA);
    const p0 = nodeAt(ref refParam, childAt(ref refParam, nodeAt(ref refParam, a3.childA), 0));
    theory.isSuccessful = p0.flagA;
    theory.detail = `the parameter's isRef is ${p0.flagA}, wanted true`;
  }
}

// A return type is parsed GREEDILY, so `(k: K) => V[]` is a function returning
// an array. A parenthesized group is the only way to lift the array out, and it
// exists for exactly that.
suite function parenthesizedTypeGroupsAttachArraySuffixes(): void {
  let grouped = parseOk("type T { fns: ((k: string) => uint64)[], }");
  const outer = nodeAt(ref grouped, nodeAt(ref grouped, childAt(ref grouped, topLevel(ref grouped, 0), 0)).childA);

  let test theory: Case = t.asserts("a group lifts the array out to the whole function type") {
    theory.isSuccessful = outer.kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE &&
      nodeAt(ref grouped, outer.childA).kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE;
    theory.detail = `outer is ${outer.kind}, inner is ${nodeAt(ref grouped, outer.childA).kind}`;
  }

  let greedy = parseOk("type T { f: (k: string) => uint64[], }");
  let test theory: Case = t.asserts("without a group the array binds to the RETURN type") {
    const a = nodeAt(ref greedy, nodeAt(ref greedy, childAt(ref greedy, topLevel(ref greedy, 0), 0)).childA);
    theory.isSuccessful = a.kind == ASTNodeKind.TYPE_ANNOTATION_FUNC_TYPE &&
      nodeAt(ref greedy, a.childB).kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE;
    theory.detail = `annotation is ${a.kind}, its return is ${nodeAt(ref greedy, a.childB).kind}`;
  }

  // The fork is decided at one token of lookahead, which is why parameters must
  // be named: `(T)` and `(T) => R` would otherwise be indistinguishable.
  let plainGroup = parseOk("type T { xs: (uint8)[], }");
  let test theory: Case = t.asserts("a group with no `=>` is just a parenthesized type") {
    const a = nodeAt(ref plainGroup, nodeAt(ref plainGroup, childAt(ref plainGroup, topLevel(ref plainGroup, 0), 0)).childA);
    theory.isSuccessful = a.kind == ASTNodeKind.TYPE_ANNOTATION_ARRAY_TYPE;
    theory.detail = `(uint8)[] parsed as ${a.kind}, wanted an array`;
  }
}

// A call through anything but a name or a field has no lowering, and accepting
// one SILENTLY miscompiles - the arguments are dropped and the function pointer
// itself becomes the value.
suite function callingAValueThatIsNotANameOrFieldIsRefused(): void {
  let test theory: Case = t.asserts("calling an indexed element is refused") {
    theory.isSuccessful = refusalMentions(
      "function f(): int { return fns[0](1); }",
      "can only be called through a name or a field"
    );
    theory.detail = "`fns[0](1)` parsed without a diagnostic";
  }

  let test theory: Case = t.asserts("so is calling a call's result") {
    theory.isSuccessful = refusalMentions(
      "function f(): int { return g()(1); }",
      "can only be called through a name or a field"
    );
    theory.detail = "`g()(1)` parsed without a diagnostic";
  }

  // The two supported spellings must still work, or the refusal above is just
  // breaking calls.
  let test theory: Case = t.asserts("a plain call and a field call still parse") {
    theory.isSuccessful = parseError("function f(): int { return g(1); }").len == 0 &&
      parseError("function f(): int { return ops.hash(1); }").len == 0;
    theory.detail = "a supported call form was refused";
  }
}

suite function sliceExpressionsAreNotIndexes(): void {
  let both = parseOk("function f(): int { return xs[1..3]; }");
  const sliced = returnedExpression(ref both);

  // An index and a slice open the same way, so the index expression is parsed
  // FIRST and reinterpreted when a `..` follows - not looked ahead for.
  let test theory: Case = t.asserts("`xs[a..b]` is a SLICE_EXPRESSION") {
    theory.isSuccessful = sliced.kind == ASTNodeKind.SLICE_EXPRESSION &&
      sliced.childB != 0 && sliced.childC != 0;
    theory.detail = `parsed as ${sliced.kind}, start ${sliced.childB}, end ${sliced.childC}`;
  }

  let indexed = parseOk("function f(): int { return xs[1]; }");
  let test theory: Case = t.asserts("`xs[a]` is still an INDEX_EXPRESSION") {
    theory.isSuccessful = returnedExpression(ref indexed).kind == ASTNodeKind.INDEX_EXPRESSION;
    theory.detail = `parsed as ${returnedExpression(ref indexed).kind}, wanted INDEX_EXPRESSION`;
  }

  // An omitted bound is 0 rather than a synthesized literal: "to the end" is
  // the base's length, and codegen is the only layer that has it.
  let openEnd = parseOk("function f(): int { return xs[1..]; }");
  let test theory: Case = t.asserts("an omitted END is 0, not a synthesized bound") {
    const n = returnedExpression(ref openEnd);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB != 0 && n.childC == 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted a start and 0`;
  }

  let openStart = parseOk("function f(): int { return xs[..2]; }");
  let test theory: Case = t.asserts("an omitted START is 0 too") {
    const n = returnedExpression(ref openStart);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB == 0 && n.childC != 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted 0 and an end`;
  }

  let openBoth = parseOk("function f(): int { return xs[..]; }");
  let test theory: Case = t.asserts("both bounds may be omitted") {
    const n = returnedExpression(ref openBoth);
    theory.isSuccessful = n.kind == ASTNodeKind.SLICE_EXPRESSION && n.childB == 0 && n.childC == 0;
    theory.detail = `start ${n.childB}, end ${n.childC}, wanted 0 and 0`;
  }

  // A slice is a postfix like any other, so it chains.
  let chained = parseOk("function f(): int { return xs[1..3][0]; }");
  let test theory: Case = t.asserts("a slice chains with an index") {
    const n = returnedExpression(ref chained);
    theory.isSuccessful = n.kind == ASTNodeKind.INDEX_EXPRESSION &&
      nodeAt(ref chained, n.childA).kind == ASTNodeKind.SLICE_EXPRESSION;
    theory.detail = `outer ${n.kind}, inner ${nodeAt(ref chained, n.childA).kind}`;
  }
}

suite function vtablesAndNullParse(): void {
  let ast = parseOk("vtable Reader for Readable { read: () => int, }");
  const decl = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("`vtable N for T { ... }` is a VTABLE_DECL") {
    theory.isSuccessful = decl.kind == ASTNodeKind.VTABLE_DECL && str.stringEq(decl.name, "Reader");
    theory.detail = `parsed as ${decl.kind} named "${decl.name}"`;
  }

  let test theory: Case = t.asserts("the erased trait and the fields both land") {
    theory.isSuccessful = decl.childA != 0 && decl.childCount == 1;
    theory.detail = `trait slot ${decl.childA}, ${decl.childCount} field(s)`;
  }

  let exported = parseOk("export vtable Reader for Readable { read: () => int, }");
  let test theory: Case = t.asserts("`export vtable` reaches the same parser") {
    theory.isSuccessful = nodeAt(ref exported, topLevel(ref exported, 0).childA).kind == ASTNodeKind.VTABLE_DECL;
    theory.detail = `the exported decl is ${nodeAt(ref exported, topLevel(ref exported, 0).childA).kind}`;
  }

  let nul = parseOk("function f(): int { return null; }");
  let test theory: Case = t.asserts("`null` is its own literal, carrying no value") {
    theory.isSuccessful = returnedExpression(ref nul).kind == ASTNodeKind.NULL_LITERAL;
    theory.detail = `null parsed as ${returnedExpression(ref nul).kind}`;
  }
}

// `&` and `*` are each both a prefix and a binary operator. The prefix position
// is where a binary operator cannot appear, so there is no ambiguity and no
// lookahead - but the two readings have to actually come out different.
suite function prefixAmpAndStarAreNotTheBinaryOnes(): void {
  let addr = parseOk("function f(): int { return &n; }");
  let test theory: Case = t.asserts("a leading `&` is ADDRESS_OF") {
    theory.isSuccessful = returnedExpression(ref addr).kind == ASTNodeKind.ADDRESS_OF_EXPRESSION;
    theory.detail = `&n parsed as ${returnedExpression(ref addr).kind}`;
  }

  let deref = parseOk("function f(): int { return *p; }");
  let test theory: Case = t.asserts("a leading `*` is DEREF") {
    theory.isSuccessful = returnedExpression(ref deref).kind == ASTNodeKind.DEREF_EXPRESSION;
    theory.detail = `*p parsed as ${returnedExpression(ref deref).kind}`;
  }

  let band = parseOk("function f(): int { return a & b; }");
  let test theory: Case = t.asserts("an infix `&` is still a binary expression") {
    theory.isSuccessful = returnedExpression(ref band).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `a & b parsed as ${returnedExpression(ref band).kind}`;
  }

  let mul = parseOk("function f(): int { return a * b; }");
  let test theory: Case = t.asserts("an infix `*` is still a binary expression") {
    theory.isSuccessful = returnedExpression(ref mul).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `a * b parsed as ${returnedExpression(ref mul).kind}`;
  }

  // The one that actually bit: assignment binds LOOSEST, so a prefix operand
  // must not swallow it. Without the guard `*p = 9` becomes `*(p = 9)`, which
  // reports "cannot assign to const p" and points at the wrong thing.
  let store = parseOk("function f(): void { *p = 9; }");
  let test theory: Case = t.asserts("`*p = 9` assigns THROUGH the pointer") {
    const stmt = nodeAt(ref store, firstStatement(ref store).childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.ASSIGNMENT &&
      nodeAt(ref store, stmt.childA).kind == ASTNodeKind.DEREF_EXPRESSION;
    theory.detail = `the statement is ${stmt.kind} with target ${nodeAt(ref store, stmt.childA).kind}`;
  }

  let compound = parseOk("function f(): void { *p = *p * 3; }");
  let test theory: Case = t.asserts("and the right-hand side may deref too") {
    const stmt = nodeAt(ref compound, firstStatement(ref compound).childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.ASSIGNMENT &&
      nodeAt(ref compound, stmt.childB).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `the value is ${nodeAt(ref compound, stmt.childB).kind}`;
  }
}

// `~` is PREFIX ONLY, which is what makes it simpler than `&` and `*`: there is
// no binary `~` for position to have to tell it apart from.
suite function bitwiseNotIsAPrefixOperator(): void {
  let not = parseOk("function f(): int { return ~a; }");
  let test theory: Case = t.asserts("`~a` is a UNARY_EXPRESSION carrying the TILDE") {
    const e = returnedExpression(ref not);
    theory.isSuccessful = e.kind == ASTNodeKind.UNARY_EXPRESSION && e.operator == TokenTags.TILDE;
    theory.detail = `~a parsed as ${e.kind} with operator ${tagName(e.operator)}`;
  }

  // 70 binds tighter than every binary operator, so `~a & b` is `(~a) & b`.
  // The reference agrees: `~2 & 7` prints 5, not -3.
  let mixed = parseOk("function f(): int { return ~a & b; }");
  let test theory: Case = t.asserts("`~a & b` groups as `(~a) & b`") {
    const e = returnedExpression(ref mixed);
    theory.isSuccessful = e.kind == ASTNodeKind.BINARY_EXPRESSION &&
      nodeAt(ref mixed, e.childA).kind == ASTNodeKind.UNARY_EXPRESSION;
    theory.detail = `the top node is ${e.kind} with left ${nodeAt(ref mixed, e.childA).kind}`;
  }

  // Stacking prefixes still works, and `~` is not a binary operator: with
  // nothing on its left, `a ~ b` cannot parse.
  let stacked = parseOk("function f(): int { return ~-a; }");
  let test theory: Case = t.asserts("prefixes stack") {
    const e = returnedExpression(ref stacked);
    theory.isSuccessful = e.kind == ASTNodeKind.UNARY_EXPRESSION &&
      nodeAt(ref stacked, e.childA).kind == ASTNodeKind.UNARY_EXPRESSION;
    theory.detail = `~-a parsed as ${e.kind} over ${nodeAt(ref stacked, e.childA).kind}`;
  }

  let test theory: Case = t.asserts("there is no INFIX `~`") {
    theory.isSuccessful = refusalMentions("function f(): int { return a ~ b; }", "expected SEMICOLON");
    theory.detail = `"a ~ b" was not refused as a statement that never ended: ${parseError("function f(): int { return a ~ b; }")}`;
  }
}

// `Reader.from(ref s)` ERASES a concrete type into a vtable value. `from` is a
// keyword token, so the generic "expected IDENT, got FROM" pointed a reader at
// punctuation on a line that is perfectly well formed.
suite function fromParsesAsAMemberNameOnACall(): void {
  // `from` is a KEYWORD token, and the right of a `.` accepts one because that
  // position is a pure name lookup. What comes out is an ordinary
  // CALL_EXPRESSION with the base in childB - the same shape `ns.fn()`
  // produces, since the parser cannot tell a vtable from a namespace and does
  // not try.
  let ast = parseOk("function f(): int { let r: Reader = Reader.from(ref s); return 0; }");
  let test theory: Case = t.asserts("`X.from(ref v)` is a qualified CALL, not a parse error") {
    const decl = firstStatement(ref ast);
    const call = nodeAt(ref ast, decl.childB);
    theory.isSuccessful = call.kind == ASTNodeKind.CALL_EXPRESSION
      && str.stringEq(call.name, "from")
      && str.stringEq(nodeAt(ref ast, call.childB).name, "Reader");
    theory.detail = `parsed a ${call.kind} named "${call.name}"`;
  }

  // DECLARING one still parses, and the refusal must not have swallowed it.
  let decl = parseOk("vtable Reader for Readable { read: () => int, }");
  let test theory: Case = t.asserts("declaring a vtable is untouched") {
    theory.isSuccessful = topLevel(ref decl, 0).kind == ASTNodeKind.VTABLE_DECL;
    theory.detail = `the decl parsed as ${topLevel(ref decl, 0).kind}`;
  }

  // NOT gated on the `(`. A plain member read spelled `from` is the same
  // question - the right of a `.` is a name lookup either way - so it parses as
  // an ordinary FIELD_ACCESS rather than being tied to vtables at all. It is
  // legal, and so is the declaration of a field spelled `from`.
  let read = parseOk("function f(): int { return l.from.x; }");
  let test theory: Case = t.asserts("a plain member read spelled `from` is a field access") {
    const outer = returnedExpression(ref read);
    const inner = nodeAt(ref read, outer.childA);
    theory.isSuccessful = outer.kind == ASTNodeKind.FIELD_ACCESS
      && str.stringEq(outer.name, "x")
      && inner.kind == ASTNodeKind.FIELD_ACCESS
      && str.stringEq(inner.name, "from");
    theory.detail = `l.from.x parsed as ${outer.kind}."${outer.name}" over ${inner.kind}."${inner.name}"`;
  }
}

// The compound forms have no node of their own - they desugar in the parser
// into `target = target <op> value`, which is why one const check covers both
// spellings. That desugaring names the target TWICE, so it is only sound on a
// target that costs nothing to read: a name, a path of fields reaching one, or
// an element whose subscript is itself a name or a literal.
suite function compoundAssignmentDesugarsOnPlaceTargetsOnly(): void {
  let field = parseOk("function f(): void { a.b.c += 1; }");
  let test theory: Case = t.asserts("a nested field path desugars to a plain assignment") {
    const stmt = nodeAt(ref field, firstStatement(ref field).childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.ASSIGNMENT
      && nodeAt(ref field, stmt.childA).kind == ASTNodeKind.FIELD_ACCESS
      && nodeAt(ref field, stmt.childB).kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `got ${stmt.kind} with target ${nodeAt(ref field, stmt.childA).kind}`;
  }

  // The read half is a COPY, not the same NodeId. The arena is a tree: sharing
  // one node between the read and the write would have pass D decorate it from
  // two directions and codegen walk it twice under one entry.
  let test theory: Case = t.asserts("the re-read is a separate node, not the target itself") {
    const stmt = nodeAt(ref field, firstStatement(ref field).childA);
    const combined = nodeAt(ref field, stmt.childB);
    theory.isSuccessful = combined.childA != stmt.childA;
    theory.detail = `the re-read is node ${combined.childA} and the target is ${stmt.childA}`;
  }

  let test theory: Case = t.asserts("the copy keeps the whole path, not just its last field") {
    const stmt = nodeAt(ref field, firstStatement(ref field).childA);
    const reread = nodeAt(ref field, nodeAt(ref field, stmt.childB).childA);
    const base = nodeAt(ref field, reread.childA);
    theory.isSuccessful = str.stringEq(reread.name, "c")
      && base.kind == ASTNodeKind.FIELD_ACCESS && str.stringEq(base.name, "b");
    theory.detail = `the re-read is "${reread.name}" over a ${base.kind} named "${base.name}"`;
  }

  // An ELEMENT target is a place too, as long as the subscript is free to read
  // twice. The re-read copies BOTH halves - a shared subscript node would be
  // decorated from two directions.
  let elem = parseOk("function f(): void { xs[i] += 1; }");
  let test theory: Case = t.asserts("an element target desugars, subscript and all") {
    const assign = nodeAt(ref elem, firstStatement(ref elem).childA);
    const combined = nodeAt(ref elem, assign.childB);
    const reread = nodeAt(ref elem, combined.childA);
    const target = nodeAt(ref elem, assign.childA);
    theory.isSuccessful = assign.kind == ASTNodeKind.ASSIGNMENT
      && target.kind == ASTNodeKind.INDEX_EXPRESSION
      && reread.kind == ASTNodeKind.INDEX_EXPRESSION
      && reread.childB != target.childB
      && str.stringEq(nodeAt(ref elem, reread.childB).name, "i");
    theory.detail = `xs[i] += 1 gave a ${assign.kind} over a ${reread.kind}`;
  }

  // A subscript that could be evaluated twice OBSERVABLY stays refused: the
  // desugaring would call `g` once to read and again to write.
  let test theory: Case = t.asserts("a call in the subscript is refused rather than evaluated twice") {
    const src = "function f(): void { xs[g()] += 1; }";
    theory.isSuccessful = refusalMentions(src, "free to read twice");
    theory.detail = `wanted a place-target refusal, got: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("so is a call's result") {
    const src = "function f(): void { g() += 1; }";
    theory.isSuccessful = refusalMentions(src, "free to read twice");
    theory.detail = `wanted a place-target refusal, got: ${parseError(src)}`;
  }
}

// `@derive(display)` parses and WRAPS its target, and `declOf` looks through
// the wrapper the same way it looks through an `export`. Generating the
// `toString` is a separate, unbuilt piece - see typecheck/derive.yoop for what
// it waits on.
suite function attributesWrapTheDeclarationTheyDecorate(): void {
  let ast = parseOk("@derive(display)\ntype P { x: int }");
  const outer = topLevel(ref ast, 0);

  let test theory: Case = t.asserts("an attribute is its own node, naming itself") {
    theory.isSuccessful = outer.kind == ASTNodeKind.ATTRIBUTE && str.stringEq(outer.name, "derive");
    theory.detail = `parsed a ${outer.kind} named "${outer.name}", wanted ATTRIBUTE / "derive"`;
  }

  // Arguments are EXPRESSIONS in the node's own childIds run, not a single
  // interned name. `@derive(display)` passes one identifier, but the shape is
  // the reference's general list - an attribute wanting `@align(16)` needs it,
  // and reading only an identifier would make the arg shape a property of `@`.
  let test theory: Case = t.asserts("its arguments are expressions in its own run") {
    const arg = nodeAt(ref ast, childAt(ref ast, outer, 0));
    theory.isSuccessful = outer.childCount == 1
      && arg.kind == ASTNodeKind.IDENT && str.stringEq(arg.name, "display");
    theory.detail = `got ${outer.childCount} arg(s), the first a ${arg.kind} named "${arg.name}"`;
  }

  let test theory: Case = t.asserts("the decorated decl hangs off it") {
    const target = nodeAt(ref ast, outer.childA);
    theory.isSuccessful = target.kind == ASTNodeKind.TYPE_DECL && str.stringEq(target.name, "P");
    theory.detail = `the target is a ${target.kind} named "${target.name}"`;
  }

  // The two wrappers nest in one order - the `@` is written above the `export` -
  // and every pass reaches the decl through declOf, so this is the assertion
  // that keeps a decorated declaration from being invisible to pass A.
  let exported = parseOk("@derive(display)\nexport type P { x: int }");
  let test theory: Case = t.asserts("declOf looks through the attribute AND the export") {
    const decl = nodeAt(ref exported, declOf(ref exported, topLevelId(ref exported, 0)));
    theory.isSuccessful = decl.kind == ASTNodeKind.TYPE_DECL && str.stringEq(decl.name, "P");
    theory.detail = `declOf gave a ${decl.kind} named "${decl.name}"`;
  }

  let test theory: Case = t.asserts("and the decl is still seen as exported") {
    theory.isSuccessful = isExportDecl(ref exported, topLevelId(ref exported, 0));
    theory.detail = "a decorated `export type` came back unexported";
  }

  let test theory: Case = t.asserts("a variant may be decorated too") {
    let v = parseOk("@derive(display)\nvariant S { A, B }");
    const target = nodeAt(ref v, topLevel(ref v, 0).childA);
    theory.isSuccessful = target.kind == ASTNodeKind.VARIANT_DECL;
    theory.detail = `the target is a ${target.kind}, wanted VARIANT_DECL`;
  }

  // The TARGET set is a property of the syntax and matches the reference's:
  // a block, a let/const decl, a type or variant (optionally exported), or a
  // bare `;`. Which of those a given attribute allows is a separate question,
  // checked per attribute - collapsing the two would make "@derive takes a
  // type" a fact about `@`, which it is not.
  let test theory: Case = t.asserts("a target outside the syntactic set is refused, listing the set") {
    const src = "@derive(display)\nfunction f(): int { return 0; }";
    theory.isSuccessful = refusalMentions(src, "requires a '{ ... }' block");
    theory.detail = `wanted the target-shape refusal, got: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("an unknown attribute names the ones that exist") {
    const src = "@bogus(x)\ntype P { n: int }";
    theory.isSuccessful = refusalMentions(src, "Known attributes: @precompile, @derive.");
    theory.detail = `wanted an unknown-attribute refusal, got: ${parseError(src)}`;
  }

  // A derive the language RESERVES but has not built is a different mistake
  // from a typo, and the fix differs - wait for it versus fix the spelling.
  let test theory: Case = t.asserts("a reserved-but-unbuilt derive says so") {
    const src = "@derive(debug)\ntype P { n: int }";
    theory.isSuccessful = refusalMentions(src, "is not yet supported");
    theory.detail = `wanted a deferred-derive refusal, got: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("a misspelled one is a different message") {
    const src = "@derive(dispaly)\ntype P { n: int }";
    theory.isSuccessful = refusalMentions(src, "unknown derive");
    theory.detail = `wanted an unknown-derive refusal, got: ${parseError(src)}`;
  }

  // `@precompile` on a const parses and is ACCEPTED - the fold itself happens
  // between typecheck and codegen, so nothing here has an opinion about it
  // beyond the target being a const. See comptime/precompile.yoop.
  let test theory: Case = t.asserts("@precompile on a const parses") {
    const src = "@precompile const X: int = 6 * 7;";
    theory.isSuccessful = parseError(src).len == 0;
    theory.detail = `a precompiled const was refused: ${parseError(src)}`;
  }

  // The BLOCK form is a different mechanism rather than the same one with a
  // different target: it runs statements and keeps what they wrote to the
  // module's globals. Both parse; comptime/precompile.yoop tells them apart.
  let test theory: Case = t.asserts("the @precompile block form parses too") {
    const src = "@precompile { let a: int = 1; }";
    theory.isSuccessful = parseError(src).len == 0;
    theory.detail = `a precompile block was refused: ${parseError(src)}`;
  }

  let test theory: Case = t.asserts("@precompile on something that is not a const is refused by name") {
    const src = "@precompile type P { n: int }";
    theory.isSuccessful = refusalMentions(src, "decorates a const declaration");
    theory.detail = `wanted a target refusal, got: ${parseError(src)}`;
  }
}

// The GRAFT. `@derive(display)` generates the method as source text, reparses
// it into the same arena, and splices the METHOD_DECL onto the end of the
// declaration's member run - so what the later passes read is a declaration
// that looks written by hand.
//
// Asserted on the ARENA rather than on the rendered string for the same reason
// every other suite here is: the member run and the implements list are the
// shapes pass A, pass C and codegen walk, and a rendering test would not notice
// either of them being spliced wrong.
suite function deriveDisplayGraftsAMethodIntoTheDecl(): void {
  let ast = expandOk("trait Display { function toString(ref self): string; }\n@derive(display)\ntype P { x: int, y: int }");
  const decl = nodeAt(ref ast, declOf(ref ast, topLevelId(ref ast, 1)));

  let test theory: Case = t.asserts("the member run grows by one and keeps its fields in order") {
    const f0 = nodeAt(ref ast, childAt(ref ast, decl, 0));
    const f1 = nodeAt(ref ast, childAt(ref ast, decl, 1));
    theory.isSuccessful = decl.childCount == 3
      && f0.kind == ASTNodeKind.FIELD_DECL && str.stringEq(f0.name, "x")
      && f1.kind == ASTNodeKind.FIELD_DECL && str.stringEq(f1.name, "y");
    theory.detail = `the run holds ${decl.childCount} member(s)`;
  }

  let test theory: Case = t.asserts("the last member is a METHOD_DECL named toString") {
    const m = nodeAt(ref ast, childAt(ref ast, decl, decl.childCount - 1));
    theory.isSuccessful = m.kind == ASTNodeKind.METHOD_DECL && str.stringEq(m.name, "toString");
    theory.detail = `the last member is a ${m.kind} named "${m.name}"`;
  }

  // A diagnostic from generated code has to land on the line the USER wrote.
  // Without the restamp it points into a source buffer that no longer exists.
  let test theory: Case = t.asserts("the grafted method carries the DECL's source location") {
    const m = nodeAt(ref ast, childAt(ref ast, decl, decl.childCount - 1));
    theory.isSuccessful = m.sourceLoc.pos == decl.sourceLoc.pos
      && m.sourceLoc.line == decl.sourceLoc.line;
    theory.detail = `the method points at line ${m.sourceLoc.line}, the decl at ${decl.sourceLoc.line}`;
  }

  let test theory: Case = t.asserts("`implements Display` is added to a decl that had no clause") {
    const list = nodeAt(ref ast, decl.childD);
    const first = nodeAt(ref ast, childAt(ref ast, list, 0));
    theory.isSuccessful = decl.childD != 0 && list.childCount == 1
      && str.stringEq(first.name, "Display");
    theory.detail = `the clause holds ${list.childCount} trait(s)`;
  }

  // Merged, not appended: a type already claiming Display must not claim it
  // twice, or the impl check runs over the same trait a second time.
  let listed = expandOk("trait Display { function toString(ref self): string; }\n@derive(display)\ntype P implements Display { x: int }");
  let test theory: Case = t.asserts("a clause already naming Display is left alone") {
    const d = nodeAt(ref listed, declOf(ref listed, topLevelId(ref listed, 1)));
    const list = nodeAt(ref listed, d.childD);
    theory.isSuccessful = list.childCount == 1;
    theory.detail = `the clause holds ${list.childCount} trait(s), wanted 1`;
  }

  // An existing clause naming something else KEEPS it and gains Display beside.
  let both = expandOk("trait Display { function toString(ref self): string; }\ntrait Named { function name(ref self): string; }\n@derive(display)\ntype P implements Named { x: int, function name(ref self): string { return \"p\"; } }");
  let test theory: Case = t.asserts("an unrelated clause keeps its trait and gains Display") {
    const d = nodeAt(ref both, declOf(ref both, topLevelId(ref both, 2)));
    const list = nodeAt(ref both, d.childD);
    const a = nodeAt(ref both, childAt(ref both, list, 0));
    const b = nodeAt(ref both, childAt(ref both, list, 1));
    theory.isSuccessful = list.childCount == 2
      && str.stringEq(a.name, "Named") && str.stringEq(b.name, "Display");
    theory.detail = `the clause holds ${list.childCount}: "${a.name}", "${b.name}"`;
  }

  // A VARIANT grafts the same way, onto a run that holds its CASES.
  let sumType = expandOk("trait Display { function toString(ref self): string; }\n@derive(display)\nvariant S { A { n: int }, B }");
  let test theory: Case = t.asserts("a variant's cases survive the splice and the method lands last") {
    const d = nodeAt(ref sumType, declOf(ref sumType, topLevelId(ref sumType, 1)));
    const c0 = nodeAt(ref sumType, childAt(ref sumType, d, 0));
    const m = nodeAt(ref sumType, childAt(ref sumType, d, d.childCount - 1));
    theory.isSuccessful = d.childCount == 3
      && c0.kind == ASTNodeKind.VARIANT_CASE
      && m.kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the run holds ${d.childCount} member(s), the first a ${c0.kind}`;
  }

  let test theory: Case = t.asserts("a GENERIC decl is refused by name rather than left underived") {
    const src = "@derive(display)\ntype Box<T> { v: T }";
    const message = expandError(src);
    theory.isSuccessful = str.stringIndexOf(message, "is not yet supported") < message.len;
    theory.detail = `wanted the generic refusal, got: ${message}`;
  }

  let test theory: Case = t.asserts("an ALIAS is refused by name") {
    const src = "@derive(display)\ntype NodeId = int;";
    const message = expandError(src);
    theory.isSuccessful = str.stringIndexOf(message, "cannot apply to type alias") < message.len;
    theory.detail = `wanted the alias refusal, got: ${message}`;
  }

  let test theory: Case = t.asserts("a hand-written toString is refused rather than duplicated") {
    const src = "@derive(display)\ntype P { x: int, function toString(ref self): string { return \"p\"; } }";
    const message = expandError(src);
    theory.isSuccessful = str.stringIndexOf(message, "already defines") < message.len;
    theory.detail = `wanted the duplicate refusal, got: ${message}`;
  }
}

// `expr?` is a POSTFIX operator, and everything below follows from that one
// choice. A statement-level rewrite would cover `let x = f()?;` and nothing
// else; being in the postfix loop is what makes `f(g()?)`, `a? + b?` and
// `f()?.field` fall out with no extra code.
suite function tryOpIsPostfixAndWrapsItsOperand(): void {
  let ast = parseOk("function f(): R { return g()?; }");
  const returned = returnedExpression(ref ast);

  let test theory: Case = t.asserts("`g()?` is a TRY_OP, not a call") {
    theory.isSuccessful = returned.kind == ASTNodeKind.TRY_OP;
    theory.detail = `g()? parsed as ${returned.kind}, wanted TRY_OP`;
  }

  let test theory: Case = t.asserts("the operand hangs off childA") {
    const operand = nodeAt(ref ast, returned.childA);
    theory.isSuccessful = operand.kind == ASTNodeKind.CALL_EXPRESSION
      && str.stringEq(operand.name, "g");
    theory.detail = `the operand is ${nodeAt(ref ast, returned.childA).kind}, wanted a CALL_EXPRESSION for g`;
  }

  // A bare call must NOT pick up a TRY_OP, or the node would mean nothing.
  let bare = parseOk("function f(): R { return g(); }");
  let test theory: Case = t.asserts("a call with no `?` is left alone") {
    theory.isSuccessful = returnedExpression(ref bare).kind == ASTNodeKind.CALL_EXPRESSION;
    theory.detail = `a bare call parsed as ${returnedExpression(ref bare).kind}`;
  }

  // `f()?.y` - the `?` binds TIGHTER than the dot, because it is consumed
  // first and the loop then folds the field access around the TRY_OP. Reading
  // a field of the wrapped Result instead would be a silent wrong answer.
  let chained = parseOk("function f(): R { return g()?.y; }");
  const field = returnedExpression(ref chained);
  let test theory: Case = t.asserts("`f()?.y` is a field access OF the try, not a try OF the field") {
    theory.isSuccessful = field.kind == ASTNodeKind.FIELD_ACCESS
      && nodeAt(ref chained, field.childA).kind == ASTNodeKind.TRY_OP;
    theory.detail = `outer node is ${field.kind}, inner is ${nodeAt(ref chained, field.childA).kind}`;
  }

  // `??` unwraps twice. Nothing special makes this work - the loop just runs
  // again - and that is the point of the test.
  let twice = parseOk("function f(): R { return g()??; }");
  const outer = returnedExpression(ref twice);
  let test theory: Case = t.asserts("`g()??` nests two TRY_OPs") {
    theory.isSuccessful = outer.kind == ASTNodeKind.TRY_OP
      && nodeAt(ref twice, outer.childA).kind == ASTNodeKind.TRY_OP;
    theory.detail = `outer is ${outer.kind}, inner is ${nodeAt(ref twice, outer.childA).kind}`;
  }

  // Nested in a call ARGUMENT - the shape a statement-level desugar cannot
  // reach, and the reason this is an expression node at all.
  let arg = parseOk("function f(): R { return h(g()?); }");
  const call = returnedExpression(ref arg);
  let test theory: Case = t.asserts("`h(g()?)` puts the TRY_OP in the argument list") {
    const args = nodeAt(ref arg, call.childA);
    theory.isSuccessful = call.kind == ASTNodeKind.CALL_EXPRESSION
      && args.childCount == 1
      && nodeAt(ref arg, childAt(ref arg, args, 0)).kind == ASTNodeKind.TRY_OP;
    theory.detail = `the call has ${nodeAt(ref arg, call.childA).childCount} argument(s)`;
  }

  // The two OTHER things a `?` starts, each told apart from plain propagation
  // by the ONE token after the `?`. Both hang off the same TRY_OP node - the
  // context in childB, the handler block in childC with its binding in `name` -
  // so a reader of the arena can see which form was written without consulting
  // a side table.
  let ctx = parseOk("function f(): R { let x: int = g()? \"loading config\"; }");
  let test theory: Case = t.asserts("`expr? \"context\"` hangs the string off childB") {
    const t0 = firstLetInitializer(ref ctx);
    theory.isSuccessful = t0.kind == ASTNodeKind.TRY_OP
      && t0.childB != 0
      && nodeAt(ref ctx, t0.childB).kind == ASTNodeKind.STRING_LITERAL
      && t0.childC == 0;
    theory.detail = `childB is ${nodeAt(ref ctx, t0.childB).kind}`;
  }

  // The template-literal spelling of the same form, which lexes differently and
  // so needs its own case: the note may interpolate.
  let tmplCtx = parseOk("function f(): R { let x: int = g()? `reading ${n}`; }");
  let test theory: Case = t.asserts("the template spelling of the context form parses") {
    const t0 = firstLetInitializer(ref tmplCtx);
    theory.isSuccessful = t0.kind == ASTNodeKind.TRY_OP
      && t0.childB != 0
      && nodeAt(ref tmplCtx, t0.childB).kind == ASTNodeKind.TEMPLATE_LITERAL;
    theory.detail = `childB is ${nodeAt(ref tmplCtx, t0.childB).kind}`;
  }

  let handler = parseOk("function f(): R { let x: int = g()? e { return 0; }; }");
  let test theory: Case = t.asserts("`expr? e { ... }` binds the name and takes the block") {
    const t0 = firstLetInitializer(ref handler);
    theory.isSuccessful = t0.kind == ASTNodeKind.TRY_OP
      && str.stringEq(t0.name, "e")
      && t0.childC != 0
      && nodeAt(ref handler, t0.childC).kind == ASTNodeKind.BLOCK
      && t0.childB == 0;
    theory.detail = `binding "${t0.name}", childC is ${nodeAt(ref handler, t0.childC).kind}`;
  }

  // A `?` followed by neither is still plain propagation, which is the whole
  // reason the decision is one token deep: nothing that legitimately follows a
  // postfix `?` is a string or an `IDENT {`.
  let plainQ = parseOk("function f(): R { let x: int = g()?; }");
  let test theory: Case = t.asserts("a plain `?` fills neither slot") {
    const t0 = firstLetInitializer(ref plainQ);
    theory.isSuccessful = t0.kind == ASTNodeKind.TRY_OP && t0.childB == 0 && t0.childC == 0;
    theory.detail = `childB=${t0.childB} childC=${t0.childC}`;
  }
}

// The two shapes that make `?`'s suffixes decidable at ONE token, asserted from
// the other side: what a `?` must NOT swallow. Both are the reason for a rule
// stated in expressions.yoop and neither had a test, because neither is written
// anywhere in std, examples or this tree - so nothing that compiles today would
// notice either rule being relaxed, and relaxing one is a SILENT wrong parse
// rather than an error.
suite function tryOpSuffixesDoNotSwallowWhatFollowsThem(): void {
  // A general expression after the `?` would make this a context clause on a
  // negated `x` instead of a subtraction - which is why the context is
  // restricted to the two LITERAL token forms. A string can never continue an
  // expression; a `-` always can.
  let sub = parseOk("function f(): R { return g()? - x; }");
  let test theory: Case = t.asserts("`g()? - x` is a subtraction, not a context clause") {
    const outer = returnedExpression(ref sub);
    const left = nodeAt(ref sub, outer.childA);
    theory.isSuccessful = outer.kind == ASTNodeKind.BINARY_EXPRESSION
      && outer.operator == TokenTags.MINUS
      && left.kind == ASTNodeKind.TRY_OP
      && left.childB == 0;
    theory.detail = `the outer node is ${outer.kind} over ${left.kind}, whose context slot is ${left.childB}`;
  }

  // The handler form's BINDING is what keeps this a loop. A bare `? { ... }`
  // would be these exact tokens, so an optional binding would take the loop
  // BODY as the handler block and leave the loop with none - and the body is
  // then simply gone, which no later pass can see.
  let loop = parseOk("function f(): R { for x in items()? { g(x); } }");
  let test theory: Case = t.asserts("`for x in items()? { ... }` keeps the brace as the loop body") {
    const stmt = firstStatement(ref loop);
    const iterable = nodeAt(ref loop, stmt.childA);
    theory.isSuccessful = stmt.kind == ASTNodeKind.FOR_IN_LOOP
      && iterable.kind == ASTNodeKind.TRY_OP
      && iterable.childC == 0
      && stmt.childB != 0
      && nodeAt(ref loop, stmt.childB).kind == ASTNodeKind.BLOCK;
    theory.detail = `the statement is ${stmt.kind} over ${iterable.kind}, whose handler slot is ${iterable.childC}`;
  }
}

// The initializer of `let x: int = <expr>;` in the first statement. The `?`
// forms are written in a binding rather than in a `return`, because the handler
// form's block ends in a `;` that only a declaration has.
function firstLetInitializer(ref ast: AST): ASTNode {
  return nodeAt(ref ast, firstStatement(ref ast).childB);
}

// A value `enum` is the third nominal decl, and the one whose arena shape is
// easiest to get subtly wrong: it puts its BACKING type where a TYPE_DECL puts
// an alias annotation and NOT where one puts type parameters, and it shares one
// member run between cases and methods.
suite function enumDeclsCarryTheirBackingCasesAndMethods(): void {
  let plain = parseOk("enum Severity { ERROR, WARNING }");
  const decl = topLevel(ref plain, 0);

  let test theory: Case = t.asserts("an enum is an ENUM_DECL at the top level") {
    theory.isSuccessful = decl.kind == ASTNodeKind.ENUM_DECL
      && str.stringEq(decl.name, "Severity");
    theory.detail = `the first top-level node is ${decl.kind} named "${decl.name}"`;
  }

  let test theory: Case = t.asserts("each case is one node in the decl's own child run") {
    theory.isSuccessful = decl.childCount == 2
      && nodeAt(ref plain, childAt(ref plain, decl, 0)).kind == ASTNodeKind.ENUM_CASE
      && str.stringEq(nodeAt(ref plain, childAt(ref plain, decl, 1)).name, "WARNING");
    theory.detail = `the enum has ${decl.childCount} member(s)`;
  }

  // childA is "type parameters" on every other decl and an enum has none. If
  // the backing type moved there, every "is this generic" test in pass C would
  // start answering yes for an `enum<uint8>`.
  let test theory: Case = t.asserts("an enum with no backing clause leaves childA and childC empty") {
    theory.isSuccessful = decl.childA == 0 && decl.childC == 0 && decl.childD == 0;
    theory.detail = `childA=${decl.childA} childC=${decl.childC} childD=${decl.childD}, wanted all 0`;
  }

  let backed = parseOk("enum K<uint8> { A, B }");
  const backedDecl = topLevel(ref backed, 0);
  let test theory: Case = t.asserts("`<uint8>` lands in childC as a type annotation") {
    const annot = nodeAt(ref backed, backedDecl.childC);
    theory.isSuccessful = backedDecl.childA == 0
      && annot.kind == ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME
      && str.stringEq(annot.name, "uint8");
    theory.detail = `childA=${backedDecl.childA}, childC holds ${annot.kind} named "${annot.name}"`;
  }

  // Written by JUXTAPOSITION, not with `=`. The value is an ordinary expression
  // so the parser needs no constant grammar of its own - what may be folded is
  // pass C's answer.
  let valued = parseOk("enum F { Sweet 1, Both Sweet | Sour, Sour \"s\" }");
  const valuedDecl = topLevel(ref valued, 0);
  let test theory: Case = t.asserts("an explicit value lands in the case's childA") {
    const first = nodeAt(ref valued, childAt(ref valued, valuedDecl, 0));
    theory.isSuccessful = nodeAt(ref valued, first.childA).kind == ASTNodeKind.INT_LITERAL;
    theory.detail = `Sweet's value node is ${nodeAt(ref valued, first.childA).kind}`;
  }

  let test theory: Case = t.asserts("a value may be a whole expression, and a string") {
    const both = nodeAt(ref valued, childAt(ref valued, valuedDecl, 1));
    const sour = nodeAt(ref valued, childAt(ref valued, valuedDecl, 2));
    theory.isSuccessful = nodeAt(ref valued, both.childA).kind == ASTNodeKind.BINARY_EXPRESSION
      && nodeAt(ref valued, sour.childA).kind == ASTNodeKind.STRING_LITERAL;
    theory.detail = `Both is ${nodeAt(ref valued, both.childA).kind}, Sour is ${nodeAt(ref valued, sour.childA).kind}`;
  }

  let test theory: Case = t.asserts("a case with no value leaves childA at the none sentinel") {
    let implicit = parseOk("enum E { A, B }");
    const e = topLevel(ref implicit, 0);
    theory.isSuccessful = nodeAt(ref implicit, childAt(ref implicit, e, 0)).childA == 0;
    theory.detail = "an implicit case carried a value node";
  }

  // Cases and methods share ONE run, and a method needs no comma before it -
  // which is why `function` has to terminate a case's value expression.
  let withMethod = parseOk("enum C implements Display {\n  Red,\n  Green\n  function toString(ref self): string { return \"x\"; }\n}");
  const methodDecl = topLevel(ref withMethod, 0);
  let test theory: Case = t.asserts("cases and methods share the decl's member run") {
    theory.isSuccessful = methodDecl.childCount == 3
      && nodeAt(ref withMethod, childAt(ref withMethod, methodDecl, 2)).kind == ASTNodeKind.METHOD_DECL;
    theory.detail = `the enum has ${methodDecl.childCount} member(s), last is ${nodeAt(ref withMethod, childAt(ref withMethod, methodDecl, 2)).kind}`;
  }

  // The same slot a TYPE_DECL and a VARIANT_DECL use, so pass C reads the clause
  // exactly one way for all three.
  let test theory: Case = t.asserts("`implements` lands in childD, as it does on a type") {
    theory.isSuccessful = methodDecl.childD != 0
      && nodeAt(ref withMethod, methodDecl.childD).childCount == 1;
    theory.detail = `childD=${methodDecl.childD}`;
  }

  // `ref self` is synthesized from the enclosing decl's name here exactly as it
  // is inside a type body - which is the whole reason an enum method needs no
  // path of its own below the parser.
  let test theory: Case = t.asserts("a method's `ref self` is annotated with the ENUM's name") {
    const method = nodeAt(ref withMethod, childAt(ref withMethod, methodDecl, 2));
    const params = nodeAt(ref withMethod, method.childB);
    const selfParam = nodeAt(ref withMethod, childAt(ref withMethod, params, 0));
    const annot = nodeAt(ref withMethod, selfParam.childA);
    theory.isSuccessful = selfParam.flagA && str.stringEq(annot.name, "C");
    theory.detail = `self's annotation is "${annot.name}", isRef=${selfParam.flagA}`;
  }

  let exported = parseOk("export enum Severity { ERROR }");
  let test theory: Case = t.asserts("`export enum` wraps the decl like every other export") {
    const wrapper = topLevel(ref exported, 0);
    theory.isSuccessful = wrapper.kind == ASTNodeKind.EXPORT_DECL
      && isExportDecl(ref exported, topLevelId(ref exported, 0))
      && nodeAt(ref exported, declOf(ref exported, topLevelId(ref exported, 0))).kind == ASTNodeKind.ENUM_DECL;
    theory.detail = `the wrapper is ${wrapper.kind}`;
  }

  // `=` is the shape a reader arrives with from C, and it is not the syntax.
  // The refusal is the ordinary expression one, which points at the `=`.
  let test theory: Case = t.asserts("`Red = 1` is refused, since a value is juxtaposed") {
    theory.isSuccessful = refusalMentions("enum C { Red = 1 }", "unexpected token in expression");
    theory.detail = `wanted a refusal at the equals sign, got: ${parseError("enum C { Red = 1 }")}`;
  }
}

// ----- helpers ---------------------------------------------------------------

// A type parameter's `implements` BOUND: the traits an argument must satisfy
// and the body may call through. It rides in the TYPE_PARAM's childA, as a
// NODE_LIST of type annotations - annotations rather than bare names so a
// generic trait (`Comparable<T>`) needs nothing extra here.
suite function typeParameterBoundsRideInChildA(): void {
  let ast = parseOk("function f<T implements Display>(x: T): int { return 0; }");
  const params = nodeAt(ref ast, topLevel(ref ast, 0).childA);
  const param = nodeAt(ref ast, childAt(ref ast, params, 0));

  let test theory: Case = t.asserts("a bare bound is one annotation in the parameter's bound list") {
    theory.isSuccessful = param.kind == ASTNodeKind.TYPE_PARAM
      && str.stringEq(param.name, "T")
      && param.childA != 0
      && nodeAt(ref ast, param.childA).childCount == 1;
    theory.detail = `parsed a ${param.kind} named "${param.name}" with bounds ${param.childA}`;
  }
  let test theory: Case = t.asserts("the bound is a type ANNOTATION, not a bare name") {
    const bound = nodeAt(ref ast, childAt(ref ast, nodeAt(ref ast, param.childA), 0));
    theory.isSuccessful = bound.kind == ASTNodeKind.TYPE_ANNOTATION_TYPE_NAME
      && str.stringEq(bound.name, "Display");
    theory.detail = `the bound parsed as a ${bound.kind} named "${bound.name}"`;
  }

  // An unbounded parameter keeps an empty slot, which is what every earlier
  // pass already reads as "no bounds".
  let plain = parseOk("function f<T>(x: T): int { return 0; }");
  const plainParam = nodeAt(ref plain, childAt(ref plain, nodeAt(ref plain, topLevel(ref plain, 0).childA), 0));
  let test theory: Case = t.asserts("an unbounded parameter has an empty bound slot") {
    theory.isSuccessful = plainParam.childA == 0;
    theory.detail = `an unbounded T carries bounds ${plainParam.childA}, wanted 0`;
  }
}

// PARENTHESES are what make a comma belong to the bound list. Without them a
// comma separates type PARAMETERS, so `<X implements A, B>` is two parameters
// and not two bounds - the asymmetry with a type decl's `implements` clause is
// forced by the surrounding grammar rather than chosen, and it is what the
// reference does.
suite function parenthesesDecideWhoOwnsTheComma(): void {
  let ast = parseOk("function f<T implements (A, B)>(x: T): int { return 0; }");
  const params = nodeAt(ref ast, topLevel(ref ast, 0).childA);

  let test theory: Case = t.asserts("a parenthesized bound list is ONE parameter with two bounds") {
    const param = nodeAt(ref ast, childAt(ref ast, params, 0));
    theory.isSuccessful = params.childCount == 1
      && param.childA != 0
      && nodeAt(ref ast, param.childA).childCount == 2;
    theory.detail = `parsed ${params.childCount} parameter(s)`;
  }

  let bare = parseOk("function f<X implements A, B>(x: X, y: B): int { return 0; }");
  const bareParams = nodeAt(ref bare, topLevel(ref bare, 0).childA);
  let test theory: Case = t.asserts("a bare comma starts a second PARAMETER") {
    const second = nodeAt(ref bare, childAt(ref bare, bareParams, 1));
    theory.isSuccessful = bareParams.childCount == 2
      && str.stringEq(second.name, "B")
      && second.childA == 0;
    theory.detail = `parsed ${bareParams.childCount} parameter(s), second named "${second.name}"`;
  }
}

// `<T implements Comparable<T>>` ends in a `>>` that the BOUND's own argument
// list consumes, leaving one `>` owed. While one is pending nothing may look at
// the real token stream, or the `(` list that follows reads its comma as
// another parameter separator - the same trap `parseTypeArgList` documents.
suite function aSelfReferentialGenericBoundClosesItsList(): void {
  let ast = parseOk("function quickSort<T implements Comparable<T>>(arr: T[], lo: usize, hi: usize): void { return; }");
  const decl = topLevel(ref ast, 0);
  const params = nodeAt(ref ast, decl.childA);

  let test theory: Case = t.asserts("the `>>` splits and the parameter list closes at one parameter") {
    theory.isSuccessful = params.childCount == 1;
    theory.detail = `parsed ${params.childCount} type parameter(s), wanted 1`;
  }
  let test theory: Case = t.asserts("the value parameters after it are not swallowed") {
    const valueParams = nodeAt(ref ast, decl.childB);
    theory.isSuccessful = valueParams.childCount == 3;
    theory.detail = `parsed ${valueParams.childCount} value parameter(s), wanted 3`;
  }
  let test theory: Case = t.asserts("the bound keeps its own type argument") {
    const bound = nodeAt(ref ast, childAt(ref ast, nodeAt(ref ast, nodeAt(ref ast, childAt(ref ast, params, 0)).childA), 0));
    theory.isSuccessful = str.stringEq(bound.name, "Comparable") && bound.childA != 0;
    theory.detail = `the bound parsed as "${bound.name}" with argsList ${bound.childA}`;
  }
}

// A bound parses on every declaration that takes type parameters, which is what
// keeps `type Holder<T implements Display>` from being a special case.
suite function boundsParseOnEveryGenericDeclaration(): void {
  let test theory: Case = t.asserts("a generic TYPE takes a bound") {
    theory.isSuccessful = parseError("type Holder<T implements Display> { v: T }").len == 0;
    theory.detail = `a bounded type decl was refused: ${parseError("type Holder<T implements Display> { v: T }")}`;
  }
  let test theory: Case = t.asserts("a generic VARIANT takes a bound") {
    theory.isSuccessful = parseError("variant Maybe<T implements Display> { Some { v: T }, None }").len == 0;
    theory.detail = `a bounded variant decl was refused: ${parseError("variant Maybe<T implements Display> { Some { v: T }, None }")}`;
  }
  let test theory: Case = t.asserts("a generic TRAIT takes a bound") {
    theory.isSuccessful = parseError("trait Holder<T implements Display> { function get(ref self): T; }").len == 0;
    theory.detail = `a bounded trait decl was refused: ${parseError("trait Holder<T implements Display> { function get(ref self): T; }")}`;
  }
}

// Parses, or hands back an empty arena so the assertion that asked fails rather
// than the test crashing.
function parseOk(src: string): AST propagates<disposable> {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parse(vec.vecAsArray(ref srcBuf))) {
    case Result.Ok { value: ast }: { return ast; }
    case Result.Err { error: e }: { return emptyArena(); }
  }
}

// Parse AND expand, the way the loader does. `@derive(display)` runs between
// the two, so a test that wants the grafted method has to come through here
// rather than through parseOk - which is deliberate, since every other suite in
// this file is about what the PARSER alone produces.
function expandOk(src: string): AST propagates<disposable> {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parseInto(emptyArena(), vec.vecAsArray(ref srcBuf))) {
    case Result.Err { error: e }: { return emptyArena(); }
    case Result.Ok { value: file }: {
      switch (expandDerives(file.ast, file.root)) {
        case Result.Err { error: de }: { return emptyArena(); }
        case Result.Ok { value: ast }: { return ast; }
      }
    }
  }
}

// The expansion's refusal message, or "" when it expanded clean.
function expandError(src: string): string propagates<disposable> {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parseInto(emptyArena(), vec.vecAsArray(ref srcBuf))) {
    case Result.Err { error: e }: { return e.rawMessage; }
    case Result.Ok { value: file }: {
      switch (expandDerives(file.ast, file.root)) {
        case Result.Err { error: de }: { return de.message; }
        case Result.Ok { value: ast }: { return ""; }
      }
    }
  }
}

// The parse error's message, or "" when the source parsed clean.
function parseError(src: string): string {
  let srcBuf: Vec<uint8> = vec.vecNew(src.len + 1);
  vec.vecExtendFrom(ref srcBuf, intr.stringAsBytes(src));
  switch (parse(vec.vecAsArray(ref srcBuf))) {
    case Result.Ok { value: ast }: { return ""; }
    case Result.Err { error: e }: { return e.rawMessage; }
  }
}

// True when `src` is refused AND the message names `needle`. Both halves
// matter: a refusal with the wrong message sends the reader somewhere else.
function refusalMentions(src: string, needle: string): bool {
  const message = parseError(src);
  if (message.len == 0) {
    return false;
  }
  return str.stringIndexOf(message, needle) < message.len;
}

// Total on purpose. A failed `parseOk` hands back an EMPTY arena, and indexing
// a PROGRAM with no children walked off the end of the arena and took the whole
// test binary down with a segfault - so a broken source literal killed the run
// instead of failing one assertion. Every navigation helper below stops at the
// sentinel node instead.
function topLevel(ref ast: AST, i: usize): ASTNode {
  return nodeAt(ref ast, topLevelId(ref ast, i));
}

// The same child as an ID, for the assertions that have to hand it to declOf /
// isExportDecl rather than read its fields.
function topLevelId(ref ast: AST, i: usize): NodeId {
  const program = nodeAt(ref ast, ast.root);
  if (i >= program.childCount) {
    return 0;
  }
  return childAt(ref ast, program, i);
}

// The expression in `function f(): int { return <expr>; }` - the shortest route
// from a source literal to an expression node.
function returnedExpression(ref ast: AST): ASTNode {
  return nodeAt(ref ast, firstStatement(ref ast).childA);
}

// The first pattern of the first arm of `function f(): int { switch ... }`.
function firstSwitchPattern(ref ast: AST): ASTNode {
  const sw = firstStatement(ref ast);
  const arm = nodeAt(ref ast, childAt(ref ast, sw, 0));
  const patterns = nodeAt(ref ast, arm.childA);
  return nodeAt(ref ast, childAt(ref ast, patterns, 0));
}

// The annotation on `const v: <annot> = ...` in the first statement.
function firstVarDeclAnnotation(ref ast: AST): ASTNode {
  return nodeAt(ref ast, firstStatement(ref ast).childA);
}

// The annotation on the first parameter of `function f(x: <annot>)`.
function firstParamAnnotation(ref ast: AST): ASTNode {
  const fn = topLevel(ref ast, 0);
  const params = nodeAt(ref ast, fn.childB);
  return nodeAt(ref ast, nodeAt(ref ast, childAt(ref ast, params, 0)).childA);
}

function firstStatement(ref ast: AST): ASTNode {
  return firstStatementOfDecl(ref ast, 0);
}

// The same, for a file whose function is not the FIRST declaration - which is
// every file that wrote a range, since the lowering prepends an import.
function firstStatementOfDecl(ref ast: AST, index: usize): ASTNode {
  const fn = topLevel(ref ast, index);
  const block = nodeAt(ref ast, fn.childD);
  const statements = nodeAt(ref ast, block.childA);
  return nodeAt(ref ast, childAt(ref ast, statements, 0));
}

// ----- `await`, and the `wait` it is not ------------------------------------

// `await g(args)` is a PREFIX operator at 70 - the same tight precedence `-`,
// `!` and `~` take. What that buys is stated in expressions.yoop; what is
// checked here is that it produces its own node kind and that the operand it
// captures stops where it should.
suite function awaitIsAPrefixExpression(): void {
  let ast = parseOk("async f(): int { return await g(1); }");
  let test theory: Case = t.asserts("`await g(1)` is an AWAIT_EXPRESSION over the call") {
    const await1 = returnedExpression(ref ast);
    const operand = nodeAt(ref ast, await1.childA);
    theory.isSuccessful = await1.kind == ASTNodeKind.AWAIT_EXPRESSION &&
      operand.kind == ASTNodeKind.CALL_EXPRESSION && str.stringEq(operand.name, "g");
    theory.detail = `the expression is ${await1.kind} over ${operand.kind} "${operand.name}"`;
  }

  // 70 binds tighter than every binary operator, so the `+` is the OUTER node
  // and the await captures only the call. Getting this wrong would await the
  // sum, which is not a call at all.
  let sum = parseOk("async f(): int { return await g(1) + 2; }");
  let test theory: Case = t.asserts("`await g(1) + 2` is `(await g(1)) + 2`") {
    const top = returnedExpression(ref sum);
    const left = nodeAt(ref sum, top.childA);
    theory.isSuccessful = top.kind == ASTNodeKind.BINARY_EXPRESSION &&
      left.kind == ASTNodeKind.AWAIT_EXPRESSION;
    theory.detail = `the outer node is ${top.kind} with ${left.kind} on the left`;
  }

  let stmt = parseOk("async f(): void { await g(); }");
  let test theory: Case = t.asserts("`await g();` stands alone as a statement") {
    const first = firstStatement(ref stmt);
    const inner = nodeAt(ref stmt, first.childA);
    theory.isSuccessful = first.kind == ASTNodeKind.EXPRESSION_STATEMENT &&
      inner.kind == ASTNodeKind.AWAIT_EXPRESSION;
    theory.detail = `the statement is ${first.kind} holding ${inner.kind}`;
  }
}

// `await f(x)?` has to come out as `(await f(x))?` and not `await (f(x)?)`.
//
// The postfix `?` binds INSIDE the operand parse, so the natural result is the
// backwards one: propagate first, then await whatever is left. `f(x)` is the
// thing to await and the `?` applies to its RESULT. The reference swaps the two
// nodes for the same reason, and 15 sites in std spell it this way - so getting
// it wrong is not an edge case, it is most of std/http.
suite function awaitAndTryOpSwap(): void {
  let ast = parseOk("async f(): int { return await g(1)?; }");
  let test theory: Case = t.asserts("the OUTER node is the `?`") {
    const top = returnedExpression(ref ast);
    theory.isSuccessful = top.kind == ASTNodeKind.TRY_OP;
    theory.detail = `the outer node is ${top.kind}, wanted TRY_OP`;
  }
  let test theory: Case = t.asserts("the `?` wraps the await, which wraps the call") {
    const top = returnedExpression(ref ast);
    const await1 = nodeAt(ref ast, top.childA);
    const call = nodeAt(ref ast, await1.childA);
    theory.isSuccessful = await1.kind == ASTNodeKind.AWAIT_EXPRESSION &&
      call.kind == ASTNodeKind.CALL_EXPRESSION && str.stringEq(call.name, "g");
    theory.detail = `TRY_OP over ${await1.kind} over ${call.kind} "${call.name}"`;
  }
}

// `wait h` JOINS a task handle - a different MECHANISM from `await`, and the
// parser's only job is to keep them apart: same prefix shape, same precedence,
// its own node kind.
suite function waitIsAPrefixExpression(): void {
  let ast = parseOk("function main(): int { return wait h; }");
  let test theory: Case = t.asserts("`wait h` is a WAIT_EXPRESSION over its operand") {
    const w = returnedExpression(ref ast);
    const operand = nodeAt(ref ast, w.childA);
    theory.isSuccessful = w.kind == ASTNodeKind.WAIT_EXPRESSION &&
      operand.kind == ASTNodeKind.IDENT && str.stringEq(operand.name, "h");
    theory.detail = `the expression is ${w.kind} over ${operand.kind} "${operand.name}"`;
  }

  // Precedence 70, the same as `await`, so a binary operator after the operand
  // belongs to the enclosing expression rather than to the join.
  let sum = parseOk("function main(): int { return wait h + 2; }");
  let test theory: Case = t.asserts("`wait h + 2` is `(wait h) + 2`") {
    const top = returnedExpression(ref sum);
    const left = nodeAt(ref sum, top.childA);
    theory.isSuccessful = top.kind == ASTNodeKind.BINARY_EXPRESSION &&
      left.kind == ASTNodeKind.WAIT_EXPRESSION;
    theory.detail = `the outer node is ${top.kind} with ${left.kind} on the left`;
  }

  // NO `?` swap, unlike `await`. `await f(x)?` has to become `(await f(x))?`
  // because the `?` belongs to the call's RESULT; a `wait` operand is a handle
  // and the natural nesting is already the right one.
  let tryOp = parseOk("function main(): int { return wait h?; }");
  let test theory: Case = t.asserts("`wait h?` keeps the `?` INSIDE, unlike await") {
    const top = returnedExpression(ref tryOp);
    const inner = nodeAt(ref tryOp, top.childA);
    theory.isSuccessful = top.kind == ASTNodeKind.WAIT_EXPRESSION &&
      inner.kind == ASTNodeKind.TRY_OP;
    theory.detail = `the outer node is ${top.kind} over ${inner.kind}`;
  }
}

// The SUSPEND PRIMITIVE is an intrinsic and it has to be async, so an extern
// signature takes a kind prefix. All three spellings a method takes work here
// for the same reason - it is the same helper.
suite function anExternSignatureTakesAKindPrefix(): void {
  let ast = parseOk("extern \"intrinsic\" from \"compiler\" { async function suspendNow(): void; }");
  let test theory: Case = t.asserts("`async function suspendNow()` parses inside an extern block") {
    const block = topLevel(ref ast, 0);
    const sig = nodeAt(ref ast, childAt(ref ast, block, 0));
    theory.isSuccessful = sig.kind == ASTNodeKind.EXTERN_FUNCTION_DECL &&
      str.stringEq(sig.name, "suspendNow") && sig.childE != 0;
    theory.detail = `the member is ${sig.kind} "${sig.name}" with prefix slot ${sig.childE}`;
  }
  let bare = parseOk("extern \"intrinsic\" from \"compiler\" { async suspendNow(): void; }");
  let test theory: Case = t.asserts("the prefix may REPLACE the `function` keyword too") {
    const sig = nodeAt(ref bare, childAt(ref bare, topLevel(ref bare, 0), 0));
    theory.isSuccessful = sig.kind == ASTNodeKind.EXTERN_FUNCTION_DECL && sig.childE != 0;
    theory.detail = `the member is ${sig.kind} with prefix slot ${sig.childE}`;
  }
  let plain = parseOk("extern \"C\" from \"stdio.h\" { function puts(s: string): int; }");
  let test theory: Case = t.asserts("an unprefixed signature still carries no prefix list") {
    const sig = nodeAt(ref plain, childAt(ref plain, topLevel(ref plain, 0), 0));
    theory.isSuccessful = sig.kind == ASTNodeKind.EXTERN_FUNCTION_DECL && sig.childE == 0;
    theory.detail = `prefix slot ${sig.childE}, wanted 0`;
  }
}

// The i-th member of `type T { ... }` at the top of the file.
function typeMember(ref ast: AST, i: usize): ASTNode {
  const decl = topLevel(ref ast, 0);
  if (i >= decl.childCount) {
    return nodeAt(ref ast, 0);
  }
  return nodeAt(ref ast, childAt(ref ast, decl, i));
}

function poolString(ref ast: AST, id: usize): string {
  if (id >= ast.strings.len) {
    return "";
  }
  return vec.vecGet(ref ast.strings, id);
}

// `a..b` - the RANGE operator, lowered in the parser into the call it means.
// Nothing above the parser learns that `..` exists, which is why these
// assertions are about a CALL rather than about a range node.
suite function aRangeLowersToACall(): void {
  let ast = parseOk("function f(): void { for i in 0..n { } }");
  let test theory: Case = t.asserts("`a..b` becomes a qualified call to exclusive") {
    const forIn = firstStatementOfDecl(ref ast, 1);
    const call = nodeAt(ref ast, forIn.childA);
    theory.isSuccessful = call.kind == ASTNodeKind.CALL_EXPRESSION
      && str.stringEq(call.name, "exclusive")
      && str.stringEq(nodeAt(ref ast, call.childB).name, "$range")
      && nodeAt(ref ast, call.childA).childCount == 2;
    theory.detail = `0..n parsed as a ${call.kind} named "${call.name}"`;
  }

  // The synthesized import goes FIRST, because every consumer reads the
  // leading run of IMPORT_DECLs and stops at the first other declaration.
  let test theory: Case = t.asserts("a file using a range gets the range import, first") {
    const first = topLevel(ref ast, 0);
    theory.isSuccessful = first.kind == ASTNodeKind.IMPORT_DECL
      && str.stringEq(first.name, "$range");
    theory.detail = `the first decl is a ${first.kind} named "${first.name}"`;
  }

  // ...and a file that used no range pays nothing.
  let plain = parseOk("function f(): void { }");
  let test theory: Case = t.asserts("a file with no range gets no import") {
    theory.isSuccessful = topLevel(ref plain, 0).kind == ASTNodeKind.FUNCTION_DECL;
    theory.detail = `the first decl is a ${topLevel(ref plain, 0).kind}`;
  }

  // `..` binds LOOSER than arithmetic, so the right bound is the whole `n - 1`.
  let looser = parseOk("function f(): void { for i in 1..n - 1 { } }");
  let test theory: Case = t.asserts("`..` binds looser than arithmetic") {
    const forIn = firstStatementOfDecl(ref looser, 1);
    const call = nodeAt(ref looser, forIn.childA);
    const args = nodeAt(ref looser, call.childA);
    const end = nodeAt(ref looser, childAt(ref looser, args, 1));
    theory.isSuccessful = end.kind == ASTNodeKind.BINARY_EXPRESSION;
    theory.detail = `the end bound is a ${end.kind}, wanted BINARY_EXPRESSION`;
  }

  // The SAME token in a subscript is still a slice - the bound is parsed AT
  // range precedence, so the `..` closes it instead of being folded in.
  let slice = parseOk("function f(): void { const v = xs[1..3]; }");
  let test theory: Case = t.asserts("a subscript range is still a SLICE") {
    theory.isSuccessful = !refusalMentions("function f(): void { const v = xs[1..3]; }", "expected");
    theory.detail = "xs[1..3] stopped parsing";
  }

  // The loop body's `{` is not a variant payload, even though the iterable
  // ends on an `a.b` path - which is exactly the shape one opens with.
  let path = parseOk("function f(): void { for i in 0..xs.len { g(); } }");
  let test theory: Case = t.asserts("the loop body's brace is not swallowed as a payload") {
    const forIn = firstStatementOfDecl(ref path, 1);
    theory.isSuccessful = forIn.kind == ASTNodeKind.FOR_IN_LOOP && forIn.childB != 0;
    theory.detail = `for i in 0..xs.len parsed as a ${forIn.kind}`;
  }

  // Outside a for-in the payload form is untouched.
  let payload = parseOk("function f(): void { const s = Shape.Circle { r: 2 }; }");
  let test theory: Case = t.asserts("an ordinary variant payload still parses") {
    theory.isSuccessful = !refusalMentions("function f(): void { const s = Shape.Circle { r: 2 }; }", "expected");
    theory.detail = "Shape.Circle { r: 2 } stopped parsing";
  }
}

// ----- reserved words as NAMES ----------------------------------------------

// A reserved word is refused wherever a name is a BINDING, and accepted in the
// handful of positions where a name is METADATA: a struct, variant or enum
// FIELD or CASE name, an extern PARAMETER name, the right of a `.`, and a
// struct-literal field name.
//
// The asymmetry is the point rather than an oversight. C headers are full of
// arguments spelled `type`, `kind` and `enum`, and an extern signature mirrors
// a C ABI it does not get to rename, so refusing one makes a generated binding
// need a hand edit on the first collision. Ordinary Yoop source picks its own
// names, so `function f(type: int32)` stays refused - and says why.
suite function aReservedWordIsAName_InMetadataPositions(): void {
  // The line the whole item exists for.
  let ext = parseOk("extern \"C\" from \"stdio.h\" { function fputs(type: string, kind: ref FILE): int32; }");
  let test theory: Case = t.asserts("an extern parameter may be spelled with a reserved word") {
    const sig = nodeAt(ref ext, childAt(ref ext, topLevel(ref ext, 0), 0));
    const params = nodeAt(ref ext, sig.childB);
    const first = nodeAt(ref ext, childAt(ref ext, params, 0));
    const second = nodeAt(ref ext, childAt(ref ext, params, 1));
    theory.isSuccessful = sig.kind == ASTNodeKind.EXTERN_FUNCTION_DECL
      && params.childCount == 2
      && str.stringEq(first.name, "type")
      && str.stringEq(second.name, "kind")
      && nodeAt(ref ext, second.childA).kind == ASTNodeKind.TYPE_ANNOTATION_REF_TYPE;
    theory.detail = `the extern took ${params.childCount} parameters, named "${first.name}" and "${second.name}"`;
  }

  let st = parseOk("type Rec { type: int32, enum: int32, in: int32 }");
  let test theory: Case = t.asserts("a struct FIELD may be spelled with a reserved word") {
    theory.isSuccessful = topLevel(ref st, 0).childCount == 3
      && str.stringEq(typeMember(ref st, 0).name, "type")
      && str.stringEq(typeMember(ref st, 1).name, "enum")
      && str.stringEq(typeMember(ref st, 2).name, "in");
    theory.detail = `the struct's fields are "${typeMember(ref st, 0).name}", "${typeMember(ref st, 1).name}", "${typeMember(ref st, 2).name}"`;
  }

  let va = parseOk("variant Ev { type { in: int32 }, default }");
  let test theory: Case = t.asserts("a variant CASE and its payload field may be reserved words") {
    const decl = topLevel(ref va, 0);
    const payload = nodeAt(ref va, childAt(ref va, decl, 0));
    const field = nodeAt(ref va, childAt(ref va, payload, 0));
    const bare = nodeAt(ref va, childAt(ref va, decl, 1));
    theory.isSuccessful = payload.kind == ASTNodeKind.VARIANT_CASE
      && str.stringEq(payload.name, "type")
      && str.stringEq(field.name, "in")
      && str.stringEq(bare.name, "default");
    theory.detail = `cases "${payload.name}" (field "${field.name}") and "${bare.name}"`;
  }

  let en = parseOk("enum Kind { type, union, variant }");
  let test theory: Case = t.asserts("an enum CASE may be spelled with a reserved word") {
    const decl = topLevel(ref en, 0);
    theory.isSuccessful = decl.childCount == 3
      && str.stringEq(nodeAt(ref en, childAt(ref en, decl, 0)).name, "type")
      && str.stringEq(nodeAt(ref en, childAt(ref en, decl, 1)).name, "union")
      && str.stringEq(nodeAt(ref en, childAt(ref en, decl, 2)).name, "variant");
    theory.detail = `the enum declared ${decl.childCount} case(s), the first named "${nodeAt(ref en, childAt(ref en, decl, 0)).name}"`;
  }

  // The right of a `.` is a pure name lookup, so the keyword's grammar role
  // never reaches it.
  let acc = parseOk("function f(): int { return r.type; }");
  let test theory: Case = t.asserts("the right of a field access may be a reserved word") {
    const field = returnedExpression(ref acc);
    theory.isSuccessful = field.kind == ASTNodeKind.FIELD_ACCESS
      && str.stringEq(field.name, "type")
      && str.stringEq(nodeAt(ref acc, field.childA).name, "r");
    theory.detail = `r.type parsed as ${field.kind} named "${field.name}"`;
  }

  let lit = parseOk("function f(): int { const v: Rec = { type: 1, enum: 2 }; return 0; }");
  let test theory: Case = t.asserts("a struct-literal field may be a reserved word") {
    const fields = nodeAt(ref lit, nodeAt(ref lit, firstStatement(ref lit).childB).childA);
    const first = nodeAt(ref lit, childAt(ref lit, fields, 0));
    const second = nodeAt(ref lit, childAt(ref lit, fields, 1));
    theory.isSuccessful = fields.childCount == 2
      && str.stringEq(first.name, "type")
      && str.stringEq(second.name, "enum");
    theory.detail = `the literal's fields are "${first.name}" and "${second.name}"`;
  }

  // A pattern has to be able to write back whatever the DECLARATION spelled, so
  // both halves of `case Ev.type { in: n }` accept one.
  let pat = parseOk("function f(): int { switch (e) { case Ev.type { in: n }: { return n; } } }");
  let test theory: Case = t.asserts("a variant PATTERN takes a reserved case and field name") {
    const p = firstSwitchPattern(ref pat);
    const binding = nodeAt(ref pat, childAt(ref pat, nodeAt(ref pat, p.childA), 0));
    theory.isSuccessful = p.kind == ASTNodeKind.VARIANT_PATTERN
      && str.stringEq(p.name, "type")
      && str.stringEq(nodeAt(ref pat, p.childB).name, "Ev")
      && str.stringEq(binding.name, "in")
      && str.stringEq(nodeAt(ref pat, binding.childA).name, "n");
    theory.detail = `the pattern is ${p.kind} "${p.name}" binding field "${binding.name}"`;
  }
}

// The other half, and it matters as much: everywhere the name is a BINDING the
// word stays refused, and the refusal NAMES it. "expected IDENT, got FROM"
// reports the parser's state, points at a word the reader has stopped seeing as
// a word, and is often several lines from where they are looking.
suite function aReservedWordIsRefusedAsABinding(): void {
  const RESERVED: string = "is a reserved word and cannot be used as a name";

  // The asymmetry against the extern above, on the same word.
  const param = "function f(type: int32): int32 { return 1; }";
  let test theory: Case = t.asserts("an ORDINARY function parameter is refused by name") {
    theory.isSuccessful = refusalMentions(param, `"type" ${RESERVED}`);
    theory.detail = `wanted the reserved-word refusal, got: ${parseError(param)}`;
  }

  // Without `atReservedUsedAsName` the parameter loop never enters and this
  // reads "expected RPAREN, got TYPE", which describes the parser rather than
  // the mistake. So the absence of that wording is the assertion.
  let test theory: Case = t.asserts("the parameter refusal is not reported as a missing `)`") {
    theory.isSuccessful = !refusalMentions(param, "expected RPAREN");
    theory.detail = `the refusal was: ${parseError(param)}`;
  }

  // Three words carry real grammar where an identifier is also legal, so they
  // cannot be demoted to contextual ones. Each gets a hint saying what it does.
  const hinted = "function f(in: int32): int32 { return 1; }";
  let test theory: Case = t.asserts("`in`, `from` and `as` say what they are needed for") {
    theory.isSuccessful = refusalMentions(hinted, "it separates the two halves of `for x in xs`")
      && refusalMentions("import { a } from \"./x.yoop\"; function from(): int { return 1; }",
                         "it introduces the path in `import ... from`")
      && refusalMentions("function f(): int { let as: int = 1; return as; }",
                         "it names the binding in `import * as ns`");
    theory.detail = `the hinted refusal was: ${parseError(hinted)}`;
  }

  const local = "function f(): int { let type: int = 1; return 0; }";
  let test theory: Case = t.asserts("a LOCAL is refused by name") {
    theory.isSuccessful = refusalMentions(local, `"type" ${RESERVED}`);
    theory.detail = `wanted the reserved-word refusal, got: ${parseError(local)}`;
  }

  const decl = "type type { a: int32 }";
  let test theory: Case = t.asserts("a TYPE DECL's own name is refused by name") {
    theory.isSuccessful = refusalMentions(decl, `"type" ${RESERVED}`);
    theory.detail = `wanted the reserved-word refusal, got: ${parseError(decl)}`;
  }

  const fnName = "function enum(): int32 { return 1; }";
  let test theory: Case = t.asserts("a FUNCTION's own name is refused by name") {
    theory.isSuccessful = refusalMentions(fnName, `"enum" ${RESERVED}`);
    theory.detail = `wanted the reserved-word refusal, got: ${parseError(fnName)}`;
  }

  // A pattern's field name mirrors a declaration; the RENAME target is a new
  // local in the arm's scope, so the two sides of the `:` answer differently.
  const rename = "function f(): int { switch (e) { case Ev.type { in: enum }: { return 1; } } }";
  let test theory: Case = t.asserts("a pattern's RENAME target is refused by name") {
    theory.isSuccessful = refusalMentions(rename, `"enum" ${RESERVED}`);
    theory.detail = `wanted the reserved-word refusal, got: ${parseError(rename)}`;
  }
}
