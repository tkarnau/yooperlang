module parse;

// Function declarations and their parameter lists.

import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, posToSourceLocation } from "../lex";
import { ParsingError } from "../diagnostics";

export function parseFunctionDecl(ref ps: ParserState): Result<NodeId, ParsingError> {
  SelfLexing.expect(ref ps, TokenTags.FUNCTION)?;
  return parseFunctionRest(ref ps, 0);
}

// A function declaration whose `function` keyword has already been consumed -
// or was never there.
//
// `async fetch(u: string): string { ... }` is a function with the kind `async`
// on it, and a kind prefix REPLACES the keyword rather than preceding it. So
// the two spellings differ only in what the caller ate before getting here,
// and everything from the name onward is shared. `prefixes` is the KIND_PREFIX
// list node, or 0 for a plain `function`.
export function parseFunctionRest(
  ref ps: ParserState,
  prefixes: NodeId
): Result<NodeId, ParsingError> {
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.FUNCTION_DECL);
  node.childE = prefixes;
  node.name = parseIdentAsName(ref ps)?;
  // function {name}<{typeparams}>({args}){{body}}

  node.childA = parseTypeParamList(ref ps)?;
  SelfLexing.expect(ref ps, TokenTags.LPAREN)?;
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  let peekTag = SelfLexing.peek(ref ps).tag;
  // No POOLED case: `pooled` is contextual and lexes as IDENT, which the
  // first arm already covers. DOTDOTDOT is here only so `function f(...)`
  // reaches parseFunctionParam and gets the named refusal below, instead of
  // falling out of the loop and being reported as a missing `)`.
  // `atReservedUsedAsName` is there for the same reason: `f(type: int32)` would
  // otherwise fall out of the loop and report a missing `)` instead of naming
  // the reserved word.
  while (
    peekTag == TokenTags.IDENT ||
    peekTag == TokenTags.REF ||
    peekTag == TokenTags.COMMA ||
    peekTag == TokenTags.DOTDOTDOT ||
    atReservedUsedAsName(ref ps)
  ) {
    if (peekTag == TokenTags.COMMA) {
      SelfLexing.advance(ref ps)?;
      peekTag = SelfLexing.peek(ref ps).tag;
    }
    if (peekTag != TokenTags.RPAREN && peekTag != TokenTags.EOF) {
      vec.vecPush(ref ids, parseFunctionParam(ref ps)?);
      peekTag = SelfLexing.peek(ref ps).tag;
    }
  }
  node.childB = SelfLexing.buildListNode(ref ps, ref ids, loc);
  SelfLexing.expect(ref ps, TokenTags.RPAREN)?;
  SelfLexing.expect(ref ps, TokenTags.COLON)?;
  node.childC = parseTypeAnnotation(ref ps)?;
  node.childF = parsePropagatesClause(ref ps)?;

  // parse function body as a block
  node.childD = parseBlock(ref ps)?;

  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

export function parseFunctionParam(ref ps: ParserState): Result<NodeId, ParsingError> {
  return parseParamWithName(ref ps, false);
}

// The same parameter, in an `extern` signature. The only difference is that the
// NAME may be a reserved word: the C ABI passes positionally, so the name here
// is documentation, and a header the binding was generated from is free to call
// its argument `type`. See parseIdentOrKeywordAsName for the whole rule.
export function parseExternFunctionParam(ref ps: ParserState): Result<NodeId, ParsingError> {
  return parseParamWithName(ref ps, true);
}

function parseParamWithName(
  ref ps: ParserState,
  keywordNameOk: bool
): Result<NodeId, ParsingError> {
  if (SelfLexing.peek(ref ps).tag == TokenTags.DOTDOTDOT) {
    return Result.Err { error: variadicNotAllowedHere(ref ps) };
  }
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.PARAM);
  node.childE = parseParamKindPrefix(ref ps)?;
  if (SelfLexing.peek(ref ps).tag == TokenTags.REF) {
    SelfLexing.advance(ref ps)?;
    node.flagA = true; // isRef
  } else {
    node.flagA = false;
  }

  if (keywordNameOk) {
    node.name = parseIdentOrKeywordAsName(ref ps)?;
  } else {
    node.name = parseIdentAsName(ref ps)?;
  }
  SelfLexing.expect(ref ps, TokenTags.COLON)?;
  // type annotation stuff
  node.childA = parseTypeAnnotation(ref ps)?;
  // isRef and refType stuff
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

// `scoped h: ref FileHandle` - the kind a PARAMETER carries, written before its
// name.
//
// The tell is one token of lookahead, the same rule every other kind-prefix
// site uses, widened by one tag: an identifier followed by another IDENTIFIER
// or by `ref` cannot be the parameter's own name, because a name is always
// followed by `:`. So `marker h: H` and `marker ref h: H` are both prefixed and
// `ref h: H` is not - it opens with REF and never reaches the test.
//
// Exactly one prefix, which is a rule of the reference's rather than of the
// grammar: `marker other h: T` is refused there with "a parameter may carry at
// most one kind prefix", and refusing it here means the two agree on what a
// program MEANS rather than only on what it looks like.
export function parseParamKindPrefix(ref ps: ParserState): Result<NodeId, ParsingError> {
  if (!atParamKindPrefix(ref ps)) {
    return Result.Ok { value: 0 };
  }
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  disposable ids: Vec<NodeId> = vec.vecNew(1);
  let prefix = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.KIND_PREFIX);
  prefix.name = parseIdentAsName(ref ps)?;
  vec.vecPush(ref ids, SelfLexing.pushNode(ref ps, prefix));

  if (atParamKindPrefix(ref ps)) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      "a parameter may carry at most one kind prefix",
      peekLengthUsize(ref ps),
    )};
  }
  return Result.Ok { value: SelfLexing.buildListNode(ref ps, ref ids, loc) };
}

function atParamKindPrefix(ref ps: ParserState): bool {
  if (SelfLexing.peek(ref ps).tag != TokenTags.IDENT) {
    return false;
  }
  switch (SelfLexing.peekAhead(ref ps, 1)) {
    case Result.Err { error: e }: { return false; }
    case Result.Ok { value: tok }: {
      return tok.tag == TokenTags.IDENT || tok.tag == TokenTags.REF;
    }
  }
}

// `...` is legal in exactly ONE place: the tail of an `extern "C"` parameter
// list, which parse/externs.yoop consumes before anything reaches here. Every
// other parameter list - an ordinary function, a trait method, a function TYPE
// annotation, a kind decl's operation - refuses it, which is also what the JS
// reference does (it parses `...` only inside an extern block).
//
// The reason is not arbitrary. `...` means "the C calling convention puts the
// rest of the arguments wherever varargs go"; there is nothing in a yoop
// function for it to mean, and accepting it would need a rest-parameter feature
// that does not exist. Refusing it by name here beats a "expected IDENT" that
// sends the reader looking for a typo.
export function variadicNotAllowedHere(ref ps: ParserState): ParsingError {
  return SelfLexing.createParsingError(
    ref ps,
    "`...` is only allowed as the LAST parameter of an `extern \"C\"` signature",
    peekLengthUsize(ref ps),
  );
}
