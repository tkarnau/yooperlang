module parse;

// `extern` blocks, and the `import.<directive>;` module flags.
//
//   extern "C" from "yoop_runtime" {
//     function yoop_log_info(msg: string): void;
//   }
//
// An extern block declares functions that exist SOMEWHERE ELSE - libc, or the
// yoop runtime. They are the one kind of function whose symbol keeps its
// spelling exactly: `yoop_log_info` has to be the name the linker sees, so an
// extern is never mangled (see mangle.yoop) and never has a body.
//
// Two ABIs. "C" means the symbol exists in a library and keeps its spelling.
// "intrinsic" means the COMPILER is the implementation:
//
//   extern "intrinsic" from "compiler" {
//     function heapAlloc<T>(n: usize): T[];
//     function stringAsBytes(s: string): uint8[];
//   }
//
// An intrinsic names an operation codegen lowers directly to IR - a malloc plus
// a fat pointer, a field projection - rather than a call to anything. There is
// no symbol, so the `from` library is documentation, and the signature exists
// so the TYPECHECKER has something to check calls against. Several are generic,
// which an ordinary extern never is.
//
// The `from` clause has two spellings and they mean DIFFERENT things:
//
//   extern "C" from "stdio.h"    { ... }   a HEADER name - documentation
//   extern "C" from library "m"  { ... }   a LIBRARY name - `-lm` at link time
//
// The first is recorded and read by nobody. The second is collected
// program-wide by codegen and handed to the link step, which is exactly what
// the reference does with it - established by probing, since a program using
// `cos` links there and fails to link with the bare-string form.

import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { NodeId, ASTNodeKind } from "../ast";
import { TokenTags, tagName, posToSourceLocation } from "../lex";
import * as str from "std/core/strings.yoop";
import { ParsingError } from "../diagnostics";

// The contextual keyword that turns a `from` clause into a LINK instruction.
export const LIBRARY_KEYWORD: string = "library";

// `extern "C" from "lib" { ... }`
//
//   strId             the `from` source name, interned
//   operator          LIBRARY when the source was written `from library "m"`,
//                     and NONE when it was a bare `from "stdio.h"`. The two are
//                     not the same thing: a bare name is a HEADER and documents
//                     where the declaration came from, while `library "m"`
//                     names something the LINKER has to be told about. See the
//                     link-flag note below.
//   own childIds run  the EXTERN_FUNCTION_DECLs
export function parseExternBlock(ref ps: ParserState): Result<NodeId, ParsingError> {
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.EXTERN_BLOCK);
  SelfLexing.expect(ref ps, TokenTags.EXTERN)?;

  const abiTok = SelfLexing.expect(ref ps, TokenTags.STRLITERAL)?;
  const abi = decodeStringLiteral(ref ps, abiTok)?;
  if (!str.stringEq(abi, ABI_C) && !str.stringEq(abi, ABI_INTRINSIC)) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `unsupported extern ABI "${abi}" - the ones that exist are "C" and "intrinsic"`,
      peekLengthUsize(ref ps),
    )};
  }
  // The ABI decides whether a call becomes a CALL or becomes instructions, so
  // it rides on the block for pass A to read.
  node.flagA = str.stringEq(abi, ABI_INTRINSIC);

  // `from "lib"` is REQUIRED, matching the JS reference. Making it optional was
  // the first attempt and it was a divergence for nothing: a program written
  // against the looser rule would not compile with the other compiler, and the
  // library name is the thing layer 6 will need the day it links anything but
  // libc. std spells it `"stdio.h"`, `"yoop_runtime"`, and so on.
  SelfLexing.expect(ref ps, TokenTags.FROM)?;
  // `from library "m"` is the LINKING form: it lowers to `-lm` on the clang
  // line, program-wide. `from "math.h"` is the documenting form and lowers to
  // nothing at all. Both are recorded in the same slot, and `operator` is what
  // says which one was written - so the link step reads a flag rather than
  // guessing from a name that could be either.
  //
  // `library` is CONTEXTUAL - it lexes as an ordinary IDENT on both sides, so
  // it is recognized by its TEXT the way `kind` and `propagates` are, and a
  // variable called `library` stays legal everywhere else.
  //
  // It must be followed by a STRING; `from library m` is refused on both sides,
  // which was established by probing the reference.
  if (peekIsWord(ref ps, LIBRARY_KEYWORD)) {
    SelfLexing.advance(ref ps)?;
    node.operator = TokenTags.LIBRARY;
  }
  const libTok = SelfLexing.expect(ref ps, TokenTags.STRLITERAL)?;
  node.strId = internString(ref ps, decodeStringLiteral(ref ps, libTok)?);

  SelfLexing.expect(ref ps, TokenTags.LCURLY)?;
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (
    SelfLexing.peek(ref ps).tag != TokenTags.RCURLY &&
    SelfLexing.peek(ref ps).tag != TokenTags.EOF
  ) {
    if (SelfLexing.peek(ref ps).tag == TokenTags.TYPE) {
      vec.vecPush(ref ids, parseExternType(ref ps)?);
    } else {
      vec.vecPush(ref ids, parseExternFunction(ref ps)?);
    }
  }
  SelfLexing.expect(ref ps, TokenTags.RCURLY)?;

  const start: usize = ps.ast.childIds.len;
  vec.vecExtendFrom(ref ps.ast.childIds, vec.vecAsArray(ref ids));
  node.childStart = start;
  node.childCount = ids.len;

  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

// `type FILE;` - an OPAQUE type. It names something whose layout lives in a C
// header the compiler never reads, so there are no fields to give it and no
// value of it is ever built: every use is behind a `ref` or a pointer, which is
// the same size whatever it points at.
//
// It is a struct with an EMPTY field list, which is exactly what the reference
// makes of it. That is not a placeholder - a type with no fields is precisely a
// type nothing can read a field out of, so the "opaque" part needs no
// enforcement of its own.
function parseExternType(ref ps: ParserState): Result<NodeId, ParsingError> {
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.EXTERN_TYPE_DECL);
  SelfLexing.expect(ref ps, TokenTags.TYPE)?;
  node.name = parseIdentAsName(ref ps)?;
  SelfLexing.expect(ref ps, TokenTags.SEMICOLON)?;
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

// `function name<T>(a: T, b: U): R;` - a signature and nothing else. The same
// slots a FUNCTION_DECL uses for its type params, params and return, so pass C
// fills it with the same code; what it does NOT have is childD, the body.
//
// Type parameters are here for the intrinsics: `heapAlloc<T>(n: usize): T[]` is
// generic over what it allocates, and a C extern never is.
//
//   flagA   the signature is VARIADIC - it ended in `...`
//   childE  the KIND_PREFIX list, for `async function suspendNow(): void;`
//
// KIND PREFIXES are allowed here for one reason: the suspend PRIMITIVE is an
// intrinsic and it has to be async, because `await intr.suspendNow()` is how
// library code parks a task. That is the same three spellings a method takes
// (`function f`, `async f`, `async function f`), so it reuses the same helper -
// which is also what makes `async function suspendNow` parse rather than
// reporting "expected FUNCTION, got IDENT" about a line std actually writes.
function parseExternFunction(ref ps: ParserState): Result<NodeId, ParsingError> {
  const prefixes = parseKindPrefixRun(ref ps)?;
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.EXTERN_FUNCTION_DECL);
  node.childE = prefixes;
  node.name = parseIdentAsName(ref ps)?;
  node.childA = parseTypeParamList(ref ps)?;

  SelfLexing.expect(ref ps, TokenTags.LPAREN)?;
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  disposable ids: Vec<NodeId> = vec.vecNew(4);
  node.flagA = false;
  while (
    SelfLexing.peek(ref ps).tag != TokenTags.RPAREN &&
    SelfLexing.peek(ref ps).tag != TokenTags.EOF
  ) {
    // `printf(fmt: string, ...)`. The `...` CLOSES the list - it is a marker on
    // the signature rather than a parameter, so it produces no PARAM node and
    // nothing after it could be one. Probing the JS reference confirms the same
    // rule: `..., x: int32` there is "expected rparen, got comma", and so is a
    // trailing comma or a second `...`.
    if (SelfLexing.peek(ref ps).tag == TokenTags.DOTDOTDOT) {
      SelfLexing.advance(ref ps)?;
      node.flagA = true;
      if (SelfLexing.peek(ref ps).tag != TokenTags.RPAREN) {
        return Result.Err { error: SelfLexing.createParsingError(
          ref ps,
          `\`...\` must be the LAST parameter, so nothing may follow it - got ${tagName(SelfLexing.peek(ref ps).tag)}`,
          peekLengthUsize(ref ps),
        )};
      }
      break;
    }
    vec.vecPush(ref ids, parseExternFunctionParam(ref ps)?);
    if (SelfLexing.peek(ref ps).tag == TokenTags.COMMA) {
      SelfLexing.advance(ref ps)?;
    }
  }
  node.childB = SelfLexing.buildListNode(ref ps, ref ids, loc);
  SelfLexing.expect(ref ps, TokenTags.RPAREN)?;
  SelfLexing.expect(ref ps, TokenTags.COLON)?;
  node.childC = parseTypeAnnotation(ref ps)?;
  SelfLexing.expect(ref ps, TokenTags.SEMICOLON)?;

  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

// `import.unsafe;` / `import.test;` - a module-level FLAG rather than an
// import. Same keyword, and the `.` is what tells them apart, which is why this
// is decided at the `import` and not by the import parser.
//
// `unsafe` opts the module into raw pointers; `test` marks a test module (no
// main, and the harness runs its suites). Both land on the PROGRAM node's flags
// rather than producing a decl, because neither declares anything.
export function parseImportDirective(ref ps: ParserState): Result<string, ParsingError> {
  SelfLexing.expect(ref ps, TokenTags.IMPORT)?;
  SelfLexing.expect(ref ps, TokenTags.DOT)?;
  const name = parseIdentAsName(ref ps)?;
  SelfLexing.expect(ref ps, TokenTags.SEMICOLON)?;

  if (!str.stringEq(name, "unsafe") && !str.stringEq(name, "test")) {
    return Result.Err { error: SelfLexing.createParsingError(
      ref ps,
      `unknown import directive "import.${name};" - the ones that exist are \`import.unsafe;\` and \`import.test;\``,
      peekLengthUsize(ref ps),
    )};
  }
  return Result.Ok { value: name };
}

export const ABI_C: string = "C";
export const ABI_INTRINSIC: string = "intrinsic";
