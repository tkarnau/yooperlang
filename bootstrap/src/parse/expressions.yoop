module parse;

// Expressions, by precedence climbing: parse a prefix, then keep folding in
// binary operators while the next one binds tighter than the caller allows.

import { Result } from "std/core/types.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ASTNode, ASTNodeKind, NodeId, nodeAt } from "../ast";
import { TokenTags, tagName, getTokenPrecedence, posToSourceLocation } from "../lex";
import { ParsingError } from "../diagnostics";
import * as str from "std/core/strings.yoop";

export function parseExpressionStatement(ref ps: ParserState): ParsingResult {
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.EXPRESSION_STATEMENT);
  node.childA = parseExpression(ref ps, 0)?;
  SelfLexing.expect(ref ps, TokenTags.SEMICOLON)?;

  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

export function parseExpression(ref ps: ParserState, minPrecedence: int): ParsingResult {
  let node: ASTNode;
  const peekTag = SelfLexing.peek(ref ps).tag;
  // prefix first
  switch (peekTag) {
    // Prefix operators. 70 binds tighter than every binary operator, so
    // `-a * b` is `(-a) * b` and `!a && b` is `(!a) && b`. `~` joins them at
    // the same precedence, which is what makes `~2 & 7` mean `(~2) & 7` - the
    // reference's answer, established by probing (it prints 5, not -3).
    //
    // Unlike `&` and `*`, `~` is prefix ONLY, so it needs no position rule:
    // there is no binary `~` for it to be confused with.
    case TokenTags.MINUS, TokenTags.BANG, TokenTags.TILDE: {
      SelfLexing.advance(ref ps)?;
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.UNARY_EXPRESSION);
      node.operator = peekTag;
      node.childA = parseExpression(ref ps, 70)?;
    }
    // A char literal IS an int literal - the lexer already decoded `'a'` to its
    // codepoint - so it becomes the same node and pins to context the same way.
    // That is what lets `src[i] == '\\'` compare against a uint8 and
    // `text.pushByte(ref t, '0')` pass one, with no conversion at either site.
    case TokenTags.INTLITERAL, TokenTags.CHARLITERAL: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.INT_LITERAL);
      node.intVal = SelfLexing.advance(ref ps)?.intVal;
    }
    // A float literal is its own node rather than an INT_LITERAL with a flag:
    // it pins to a different set of types, lowers to different opcodes, and
    // carries a value the int slot cannot hold. The lexer already decoded it.
    case TokenTags.FLOATLITERAL: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.FLOAT_LITERAL);
      node.floatVal = SelfLexing.advance(ref ps)?.floatVal;
    }
    case TokenTags.LBRACKET: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.ARRAY_LITERAL);
      node.childA = parseArrayElements(ref ps)?;
    }
    case TokenTags.LCURLY: {
      // A `{` in expression position is a struct literal, never a block - a
      // bare block is not a statement in this language.
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.STRUCT_LITERAL);
      node.childA = parseStructLiteralFields(ref ps)?;
    }
    case TokenTags.LPAREN: {
      // Grouping. The inner expression is already in the arena, so this reads
      // it back as the current node. That leaves the original copy unreferenced
      // in the arena - harmless (nothing walks the arena linearly) and cheaper
      // than restructuring this function to carry a NodeId instead of a node.
      SelfLexing.advance(ref ps)?;
      const innerId = parseExpression(ref ps, 0)?;
      SelfLexing.expect(ref ps, TokenTags.RPAREN)?;
      node = nodeAt(ref ps.ast, innerId);
    }
    // `null` - a raw null pointer. It carries no value: the TYPE is the whole
    // content, and it pins to whatever `unsafe_ptr` the context wants.
    case TokenTags.NULL: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.NULL_LITERAL);
      SelfLexing.advance(ref ps)?;
    }
    case TokenTags.TRUE, TokenTags.FALSE: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.BOOL_LITERAL);
      SelfLexing.advance(ref ps)?;
      if (peekTag == TokenTags.TRUE) {
        node.intVal = 1;
      } else {
        node.intVal = 0;
      }
    }
    // `&x` - the ADDRESS of a binding, as a raw pointer. Distinct from `ref x`,
    // which is a checked borrow: `&` exists for handing a local to C, and its
    // result is an `unsafe_ptr` with none of a borrow's guarantees.
    //
    // `&` is also the binary bitwise-and operator. There is no ambiguity: this
    // is the PREFIX position, where a binary operator cannot appear.
    // `*p` - read THROUGH a pointer, the inverse of `&`. Also the binary
    // multiply operator, and told apart the same way `&` is: this is the prefix
    // position, where a binary operator cannot appear.
    case TokenTags.MULT: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.DEREF_EXPRESSION);
      SelfLexing.advance(ref ps)?;
      node.childA = parseExpression(ref ps, 70)?;
    }
    case TokenTags.AMP: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.ADDRESS_OF_EXPRESSION);
      SelfLexing.advance(ref ps)?;
      node.childA = parseExpression(ref ps, 70)?;
    }
    // `await g(args)` - run an async callee and let its suspension propagate
    // into this frame. A PREFIX operator at 70, the same tight precedence
    // `-`, `!` and `~` take, so `await f(x) + 1` is `(await f(x)) + 1`.
    //
    // The operand is parsed at 70 rather than at 0 so a binary operator after
    // it belongs to the enclosing expression.
    //
    // `await f(x)?` needs a SWAP, and the reference does the same thing for the
    // same reason: the postfix `?` binds inside the operand parse, so what
    // comes back is `await (f(x)?)` - propagate first, then await the value
    // that is left - which is backwards. `f(x)` is the thing to await and the
    // `?` applies to its RESULT. 15 sites in std spell it this way.
    case TokenTags.AWAIT: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.AWAIT_EXPRESSION);
      SelfLexing.advance(ref ps)?;
      const operandId = parseExpression(ref ps, 70)?;
      const operand = nodeAt(ref ps.ast, operandId);
      if (operand.kind == ASTNodeKind.TRY_OP) {
        node.childA = operand.childA;
        let tryNode = operand;
        tryNode.childA = SelfLexing.pushNode(ref ps, node);
        node = tryNode;
      } else {
        node.childA = operandId;
      }
    }
    // `wait h` - JOIN a task handle. A different mechanism from `await`, not a
    // variant of it: `await` drives a coroutine inline from inside another one,
    // `wait` blocks an ORDINARY function until a task the scheduler is running
    // finishes. Same PREFIX shape and the same precedence as `await`, so
    // `wait h + 1` is `(wait h) + 1`.
    //
    // No `?` swap here, unlike `await`. `wait h?` would mean "join, then
    // propagate the Err out of the joined value", and that reading is already
    // the right one - the operand is a handle, not a call whose result the `?`
    // belongs to.
    case TokenTags.WAIT: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.WAIT_EXPRESSION);
      SelfLexing.advance(ref ps)?;
      node.childA = parseExpression(ref ps, 70)?;
    }
    case TokenTags.REF: {
      // `ref x` at a call site: a BORROW, which is a distinct type from `x`.
      // Writing it is required rather than inferred - the whole point is that
      // the reader can see which arguments the callee may write through.
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.REF_EXPRESSION);
      SelfLexing.advance(ref ps)?;
      node.childA = parseExpression(ref ps, 0)?;
    }
    case TokenTags.STRLITERAL: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.STRING_LITERAL);
      const tok = SelfLexing.advance(ref ps)?;
      // The lexer hands back the literal RAW, quotes included. Decoding is the
      // parser's job, and the decoded text goes in the arena's string pool so
      // the node stays a fixed-size struct.
      node.strId = internString(ref ps, decodeStringLiteral(ref ps, tok)?);
    }
    // `self` inside a method body. It is a keyword rather than an IDENT, but it
    // reads as an ordinary local: the parameter list already bound the name, so
    // everything downstream - `self.w`, `ref self` - is the usual machinery.
    case TokenTags.SELF: {
      node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.IDENT);
      SelfLexing.advance(ref ps)?;
      node.name = SELF_PARAM;
    }
    case TokenTags.TEMPLATELITERAL: {
      node = parseTemplateLiteral(ref ps)?;
    }
    case TokenTags.IDENT: {
      const name = parseIdentAsName(ref ps)?;
      // handle errno stuff...
      // `unsafe_ptr.cast<T>(p)` and its three siblings. `unsafe_ptr` is a TYPE
      // NAME rather than a namespace, so this is a spelling the parser has to
      // recognize by text - there is nothing to resolve it against. An
      // `unsafe_ptr` followed by a `.` and anything else falls through to the
      // ordinary IDENT path, which is what keeps the name usable as a local.
      if (str.stringEq(name, UNSAFE_PTR_NAME) && atUnsafePtrOp(ref ps)) {
        node = parseUnsafePtrOpRest(ref ps)?;
        break;
      }
      if (SelfLexing.peek(ref ps).tag == TokenTags.LPAREN) {
        node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.CALL_EXPRESSION);
        node.name = name;
        node.childA = parseCallArgs(ref ps)?;
      } else {
        node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.IDENT);
        node.name = name;
      }
    }
    default: {
      return Result.Err { error: SelfLexing.createParsingError(
        ref ps,
        `unexpected token in expression: ${tagName(peekTag)}`,
        peekLengthUsize(ref ps),
      )};
    }
  }

  // Postfix, in a loop so `xs[0][1]` and `xs.len` chain.
  while (true) {
    const postfixTag = SelfLexing.peek(ref ps).tag;
    if (postfixTag == TokenTags.LBRACKET) {
      SelfLexing.advance(ref ps)?;
      const baseId = SelfLexing.pushNode(ref ps, node);

      // `xs[..2]` - a slice with no start. The `[` is followed straight by the
      // `..`, so there is no expression to parse first.
      if (SelfLexing.peek(ref ps).tag == TokenTags.DOTDOT) {
        node = parseSliceRest(ref ps, baseId, 0)?;
        continue;
      }

      // AT range precedence, so the bound stops at the `..` rather than
      // consuming it as a range operator. That is the reference's rule too -
      // `xs[a..b]` is a slice and `a..b` is a Range, and the only thing that
      // separates them is that a slice's bounds are parsed this way.
      const firstId = parseExpression(ref ps, RANGE_PRECEDENCE)?;
      // `xs[a..b]` / `xs[a..]` - a SLICE, not an index. Told apart by the `..`
      // after the first expression, which is why the index is parsed first and
      // reinterpreted rather than looked ahead for.
      if (SelfLexing.peek(ref ps).tag == TokenTags.DOTDOT) {
        node = parseSliceRest(ref ps, baseId, firstId)?;
        continue;
      }

      let indexNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.INDEX_EXPRESSION);
      indexNode.childA = baseId;
      indexNode.childB = firstId;
      SelfLexing.expect(ref ps, TokenTags.RBRACKET)?;
      node = indexNode;
      continue;
    }
    // `expr?` - propagate the Err, yield the Ok. Postfix, so it chains with
    // everything else in this loop for free: `f()?.field` reads a field of the
    // unwrapped value, and `f()??` unwraps twice. Being IN the loop is also what
    // puts it inside an arbitrary expression - `g(f()?)` and `a? + b?` need no
    // special case anywhere.
    //
    // There is no ternary `a ? b : c` in this language, so a `?` in expression
    // position is never anything else and no lookahead is needed.
    if (postfixTag == TokenTags.QUESTION) {
      let tryNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.TRY_OP);
      SelfLexing.advance(ref ps)?;
      tryNode.childA = SelfLexing.pushNode(ref ps, node);

      // Three things a `?` can start, told apart by the ONE token after it and
      // with no real lookahead: what legitimately follows a plain postfix `?` is
      // an operator, a closer, a `.` or a `;`, and never a string or an IDENT.
      //
      // `expr? "context"` - a note prefixed onto the Err on the way out.
      // Deliberately restricted to the two literal token forms rather than any
      // expression, which is the reference's rule and its reason: `f()? -x`
      // would otherwise be ambiguous with a subtraction, while a string can
      // never continue an expression.
      const afterQuestion = SelfLexing.peek(ref ps).tag;
      if (afterQuestion == TokenTags.STRLITERAL ||
          afterQuestion == TokenTags.TEMPLATELITERAL) {
        tryNode.childB = parseTryContext(ref ps)?;
        node = tryNode;
        continue;
      }
      // `expr? e { ... }` - HANDLE the failure here instead of returning it.
      // The binding is required: a bare `? { ... }` would be indistinguishable
      // from a `for x in items()? { ... }` body.
      if (afterQuestion == TokenTags.IDENT &&
          SelfLexing.peekAhead(ref ps, 1)?.tag == TokenTags.LCURLY) {
        tryNode.name = parseIdentAsName(ref ps)?;
        tryNode.childC = parseBlock(ref ps)?;
        node = tryNode;
        continue;
      }
      node = tryNode;
      continue;
    }
    // A `(` HERE is a call through a value that is neither a bare name nor a
    // field - `fns[0]("a")`, `f()()`. Both of those are handled earlier: a name
    // in the prefix switch, a field in the DOT branch below. So reaching this
    // means the callee is an arbitrary expression, which nothing lowers.
    //
    // Refused rather than left alone, because leaving it produced a SILENT
    // miscompile: the arguments were dropped and the function pointer itself
    // was the value. It only became reachable when function-type annotations
    // landed and `((k: K) => V)[]` started parsing.
    if (postfixTag == TokenTags.LPAREN) {
      return Result.Err { error: SelfLexing.createParsingError(
        ref ps,
        "a function value can only be called through a name or a field so far - assign it to a local first",
        peekLengthUsize(ref ps),
      )};
    }
    if (postfixTag == TokenTags.DOT) {
      SelfLexing.advance(ref ps)?;
      const baseId = SelfLexing.pushNode(ref ps, node);

      // The right of a `.` is a pure NAME LOOKUP, so a reserved word is
      // unambiguous there and is read as the member it spells: `r.type` on a
      // struct with a `type` field, and `Reader.from(ref s)` - the vtable
      // erasure, whose member really is spelled with the `from` keyword.
      //
      // Whether the base is a vtable, a namespace or a struct is pass D's to
      // answer; the parser cannot tell them apart, exactly as it cannot for
      // `ns.fn()`.
      const member = parseIdentOrKeywordAsName(ref ps)?;

      // `ns.fn(...)` is a QUALIFIED CALL, not a field read of a function value.
      // The parser cannot tell a namespace from a struct local - that needs name
      // resolution - so it records the shape and pass D decides: a
      // CALL_EXPRESSION carries the member in `name` exactly like an unqualified
      // call, plus the base it was reached through in `childB`.
      if (SelfLexing.peek(ref ps).tag == TokenTags.LPAREN) {
        let callNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.CALL_EXPRESSION);
        callNode.name = member;
        callNode.childB = baseId;
        callNode.childA = parseCallArgs(ref ps)?;
        node = callNode;
        continue;
      }

      // `Result.Ok { value: 1 }` - a variant constructor with a payload. The
      // braces are what make it unambiguous; a payload-less `Result.None` is
      // the same tokens as `p.x` and stays a FIELD_ACCESS for pass D to sort
      // out once names resolve.
      if (SelfLexing.peek(ref ps).tag == TokenTags.LCURLY &&
          (!ps.inForInIterExpr || looksLikeVariantPayload(ref ps))) {
        let ctorNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.VARIANT_CONSTRUCTOR);
        ctorNode.name = member;
        ctorNode.childB = baseId;
        ctorNode.childA = parseStructLiteralFields(ref ps)?;
        node = ctorNode;
        continue;
      }

      let fieldNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.FIELD_ACCESS);
      fieldNode.childA = baseId;
      fieldNode.name = member;
      node = fieldNode;
      continue;
    }
    break;
  }

  // Assignment, before the binary loop so `=` is never folded in as an
  // operator. Right-associative, which is what `a = b = c` needs.
  //
  // Only at minPrecedence 0 - the TOP of an expression. Assignment binds
  // loosest of anything, so a prefix operand must not swallow one: without this
  // `*p = 9` parses as `*(p = 9)`, which then reports "cannot assign to const
  // p" and points at the wrong thing entirely.
  if (minPrecedence == 0 && SelfLexing.peek(ref ps).tag == TokenTags.EQ) {
    SelfLexing.advance(ref ps)?;
    let assign = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.ASSIGNMENT);
    assign.childA = SelfLexing.pushNode(ref ps, node);
    assign.childB = parseExpression(ref ps, 0)?;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, assign) };
  }

  // Compound assignment, desugared here into `target = target <op> value`.
  //
  // The JS reference keeps a dedicated COMPOUND_ASSIGNMENT node so the lvalue
  // is addressed once. Desugaring instead NAMES THE TARGET TWICE, so it is only
  // sound when reading the target has no side effect and costs nothing - a
  // name, a path of field accesses reaching one, and an ELEMENT whose subscript
  // is itself a name or an integer literal. Those are what `isPlaceExpr`
  // admits, and everything else is refused rather than silently evaluated
  // twice.
  const compoundOp = binaryOpOfCompound(SelfLexing.peek(ref ps).tag);
  if (compoundOp != TokenTags.NOTOKEN) {
    // `xs[f()] += 1` is the case this protects: re-reading the target would
    // call `f` once to read and again to write. It stays refused until a real
    // COMPOUND_ASSIGNMENT node lands, rather than miscompiling.
    if (!isPlaceExpr(ref ps, node)) {
      return Result.Err { error: SelfLexing.createParsingError(
        ref ps,
        `compound assignment needs a target that is free to read twice - a name, a field path, or an element whose subscript is a name or a literal. Write it out as "target = target <op> value"`,
        peekLengthUsize(ref ps),
      )};
    }
    SelfLexing.advance(ref ps)?;
    const targetId = SelfLexing.pushNode(ref ps, node);

    const rereadId = clonePlaceExpr(ref ps, targetId)?;
    let combined = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.BINARY_EXPRESSION);
    combined.operator = compoundOp;
    combined.childA = rereadId;
    combined.childB = parseExpression(ref ps, 0)?;

    let assign = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.ASSIGNMENT);
    assign.childA = targetId;
    assign.childB = SelfLexing.pushNode(ref ps, combined);
    return Result.Ok { value: SelfLexing.pushNode(ref ps, assign) };
  }

  // binary ops
  while (true) {
    let opToken = SelfLexing.peek(ref ps);
    const precedence = getTokenPrecedence(opToken.tag);
    if (precedence <= minPrecedence) {
      break;
    }

    SelfLexing.advance(ref ps)?; // consumer operator token
    // recurse through, finding the side - actually using the precedence here
    const right = parseExpression(ref ps, precedence)?;

    // `a..b` is not arithmetic - it builds a Range VALUE, and it is lowered
    // right here into the call to std/core/range.yoop that it means. See
    // range.yoop; nothing above the parser learns that `..` exists.
    if (opToken.tag == TokenTags.DOTDOT) {
      node = buildRangeCall(ref ps, SelfLexing.pushNode(ref ps, node), right)?;
      continue;
    }

    let binNode = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.BINARY_EXPRESSION);
    binNode.operator = opToken.tag;
    // push the current node onto the left
    binNode.childA = SelfLexing.pushNode(ref ps, node);
    binNode.childB = right;
    // set the current node to the binnode, and eventually push the final one
    node = binNode;
  }
  // return
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}

// Whether an expression is a PLACE that can be read twice for free: a name, or
// a path of field accesses reaching one. `self.cur` and `cx.loops.frames.len`
// qualify; `xs[i]`, a call, and anything computed do not.
//
// This is the whole safety argument for desugaring the compound forms. It is
// deliberately about SIDE EFFECTS rather than about what is assignable - pass D
// still decides that, and refuses the targets this admits but cannot store to.
function isPlaceExpr(ref ps: ParserState, node: ASTNode): bool {
  if (node.kind == ASTNodeKind.IDENT) {
    return true;
  }
  if (node.kind == ASTNodeKind.FIELD_ACCESS) {
    return isPlaceExpr(ref ps, nodeAt(ref ps.ast, node.childA));
  }
  // `xs[i]` and `w.sectors[i].ceiling` - an ELEMENT, as long as the SUBSCRIPT
  // is re-readable for free. A name and an integer literal both are; anything
  // else - a call, arithmetic, another index - is refused, because the
  // desugaring names the target twice and would evaluate the subscript twice
  // with it. That is a narrower rule than the reference's (it addresses the
  // lvalue once and so admits any subscript), and it is the safe direction: a
  // program the bootstrap accepts means the same thing on both sides.
  if (node.kind == ASTNodeKind.INDEX_EXPRESSION) {
    return isCheapSubscript(nodeAt(ref ps.ast, node.childB))
      && isPlaceExpr(ref ps, nodeAt(ref ps.ast, node.childA));
  }
  return false;
}

// A subscript that costs nothing to read twice and cannot observe being read
// twice.
function isCheapSubscript(node: ASTNode): bool {
  return node.kind == ASTNodeKind.IDENT || node.kind == ASTNodeKind.INT_LITERAL;
}

// A fresh copy of a place expression, for the read half of a desugared compound
// assignment.
//
// The arena is a TREE, so the read and the write cannot share one NodeId: pass D
// decorates by NodeId and would reach the same node from two directions, and
// codegen would walk it twice under one entry. Copying keeps every node with
// exactly one parent.
//
// The source location travels with the copy, so a diagnostic about the re-read
// points at what the writer wrote rather than at the operator.
function clonePlaceExpr(ref ps: ParserState, id: NodeId): Result<NodeId, ParsingError> {
  const src = nodeAt(ref ps.ast, id);
  if (src.kind == ASTNodeKind.IDENT) {
    let copy = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.IDENT);
    copy.name = src.name;
    copy.sourceLoc = src.sourceLoc;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, copy) };
  }
  if (src.kind == ASTNodeKind.FIELD_ACCESS) {
    // The base is copied FIRST: pushing it may grow the arena, and `src` is
    // already a value copy, so nothing here reads through a stale index.
    const baseId = clonePlaceExpr(ref ps, src.childA)?;
    let copy = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.FIELD_ACCESS);
    copy.name = src.name;
    copy.sourceLoc = src.sourceLoc;
    copy.childA = baseId;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, copy) };
  }
  if (src.kind == ASTNodeKind.INDEX_EXPRESSION) {
    // The SUBSCRIPT is copied as well as the base. isPlaceExpr already proved
    // it is a name or an integer literal, so the copy is one node and reading
    // it a second time is free.
    const baseId = clonePlaceExpr(ref ps, src.childA)?;
    const subscriptId = cloneCheapSubscript(ref ps, src.childB)?;
    let copy = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.INDEX_EXPRESSION);
    copy.sourceLoc = src.sourceLoc;
    copy.childA = baseId;
    copy.childB = subscriptId;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, copy) };
  }
  // isPlaceExpr gates every caller, so reaching here is a parser bug rather
  // than anything the writer did.
  return Result.Err { error: SelfLexing.createParsingError(
    ref ps,
    `internal: cannot copy ${src.kind} as a compound-assignment target`,
    peekLengthUsize(ref ps),
  )};
}

// The subscript half of the copy above. One node, always - isCheapSubscript is
// what makes that true.
function cloneCheapSubscript(ref ps: ParserState, id: NodeId): Result<NodeId, ParsingError> {
  const src = nodeAt(ref ps.ast, id);
  if (src.kind == ASTNodeKind.IDENT) {
    let copy = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.IDENT);
    copy.name = src.name;
    copy.sourceLoc = src.sourceLoc;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, copy) };
  }
  if (src.kind == ASTNodeKind.INT_LITERAL) {
    let copy = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.INT_LITERAL);
    copy.intVal = src.intVal;
    copy.sourceLoc = src.sourceLoc;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, copy) };
  }
  return Result.Err { error: SelfLexing.createParsingError(
    ref ps,
    `internal: cannot copy ${src.kind} as a compound-assignment subscript`,
    peekLengthUsize(ref ps),
  )};
}

// `( arg, arg )` after a callee name. Returns a NODE_LIST NodeId; an empty
// argument list still gets one, so codegen never special-cases zero args.
function parseCallArgs(ref ps: ParserState): Result<NodeId, ParsingError> {
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  SelfLexing.expect(ref ps, TokenTags.LPAREN)?;

  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (
    SelfLexing.peek(ref ps).tag != TokenTags.RPAREN &&
    SelfLexing.peek(ref ps).tag != TokenTags.EOF
  ) {
    vec.vecPush(ref ids, parseExpression(ref ps, 0)?);
    if (SelfLexing.peek(ref ps).tag == TokenTags.COMMA) {
      SelfLexing.advance(ref ps)?;
    }
  }
  SelfLexing.expect(ref ps, TokenTags.RPAREN)?;

  return Result.Ok { value: SelfLexing.buildListNode(ref ps, ref ids, loc) };
}

// The binary operator a compound assignment stands for, or NOTOKEN when the tag
// is not one. `x += y` means `x = x + y`.
function binaryOpOfCompound(tag: TokenTags): TokenTags {
  switch (tag) {
    case TokenTags.PLUSEQ: { return TokenTags.PLUS; }
    case TokenTags.MINUSEQ: { return TokenTags.MINUS; }
    case TokenTags.MULTEQ: { return TokenTags.MULT; }
    case TokenTags.DIVIDEEQ: { return TokenTags.DIVIDE; }
    case TokenTags.MODULUSEQ: { return TokenTags.MODULUS; }
    default: { return TokenTags.NOTOKEN; }
  }
}

// `[a, b, c]` - the elements, as a NODE_LIST. An empty literal is allowed and
// takes its element type from context.
function parseArrayElements(ref ps: ParserState): Result<NodeId, ParsingError> {
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  SelfLexing.expect(ref ps, TokenTags.LBRACKET)?;

  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (
    SelfLexing.peek(ref ps).tag != TokenTags.RBRACKET &&
    SelfLexing.peek(ref ps).tag != TokenTags.EOF
  ) {
    vec.vecPush(ref ids, parseExpression(ref ps, 0)?);
    if (SelfLexing.peek(ref ps).tag == TokenTags.COMMA) {
      SelfLexing.advance(ref ps)?;
    }
  }
  SelfLexing.expect(ref ps, TokenTags.RBRACKET)?;

  return Result.Ok { value: SelfLexing.buildListNode(ref ps, ref ids, loc) };
}

// `{ x: 1, y: 2 }` - the fields, as a NODE_LIST of STRUCT_LITERAL_FIELD.
//
// Each field node carries its NAME and its value in childA. Which struct this
// is comes from context, so the parser never has to know - which is also why a
// RESERVED WORD is legal as a field name here: the name mirrors a declaration
// that was free to spell it that way, and the `:` after it leaves nothing
// ambiguous.
function parseStructLiteralFields(ref ps: ParserState): Result<NodeId, ParsingError> {
  const loc = posToSourceLocation(ps.src, ps.pos, 1);
  SelfLexing.expect(ref ps, TokenTags.LCURLY)?;

  disposable ids: Vec<NodeId> = vec.vecNew(4);
  while (
    SelfLexing.peek(ref ps).tag != TokenTags.RCURLY &&
    SelfLexing.peek(ref ps).tag != TokenTags.EOF
  ) {
    let field = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.STRUCT_LITERAL_FIELD);
    field.name = parseIdentOrKeywordAsName(ref ps)?;
    SelfLexing.expect(ref ps, TokenTags.COLON)?;
    field.childA = parseExpression(ref ps, 0)?;
    vec.vecPush(ref ids, SelfLexing.pushNode(ref ps, field));
    if (SelfLexing.peek(ref ps).tag == TokenTags.COMMA) {
      SelfLexing.advance(ref ps)?;
    }
  }
  SelfLexing.expect(ref ps, TokenTags.RCURLY)?;

  return Result.Ok { value: SelfLexing.buildListNode(ref ps, ref ids, loc) };
}

// The `..end]` half of a slice, with the base and start already parsed.
//
//   childA   the array being sliced
//   childB   the start, or 0 for "from the beginning"
//   childC   the end, or 0 for "to the end"
//
// Half-open: `xs[1..3]` is elements 1 and 2. An omitted bound is 0 rather than
// a synthesized literal, because "to the end" is `xs.len` and codegen is the
// only layer that has it.
function parseSliceRest(
  ref ps: ParserState,
  baseId: NodeId,
  startId: NodeId
): Result<ASTNode, ParsingError> {
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.SLICE_EXPRESSION);
  SelfLexing.expect(ref ps, TokenTags.DOTDOT)?;
  node.childA = baseId;
  node.childB = startId;
  if (SelfLexing.peek(ref ps).tag != TokenTags.RBRACKET) {
    node.childC = parseExpression(ref ps, RANGE_PRECEDENCE)?;
  }
  SelfLexing.expect(ref ps, TokenTags.RBRACKET)?;
  return Result.Ok { value: node };
}

// True when the `{` at the cursor looks like a variant constructor's PAYLOAD
// rather than a loop body: a payload always opens `{ <name> :`, and no block
// can. Only asked inside a for-in RHS, so the ordinary constructor path keeps
// accepting the empty `Shape.Dot {}` form. A NESTED payload still matches, so
// `for x in iterOf(Shape.Circle { r: 5 })` is unaffected. The reference's rule
// and its reason.
function looksLikeVariantPayload(ref ps: ParserState): bool {
  switch (SelfLexing.peekAhead(ref ps, 1)) {
    case Result.Err { error: e }: { return false; }
    case Result.Ok { value: first }: {
      if (first.tag == TokenTags.RCURLY) {
        return false;
      }
    }
  }
  switch (SelfLexing.peekAhead(ref ps, 2)) {
    case Result.Err { error: e2 }: { return false; }
    case Result.Ok { value: second }: { return second.tag == TokenTags.COLON; }
  }
}

// The optional string after a `?` - `f()? "loading config"` or
// `f()? `field ${n}``. Only the two LITERAL token forms, which is the
// reference's rule and its reason: a general expression would make `f()? -x`
// ambiguous with subtraction, while a string can never continue an expression.
//
// The caller has already decided the next token is one of the two, so this only
// has to build the node.
function parseTryContext(ref ps: ParserState): ParsingResult {
  if (SelfLexing.peek(ref ps).tag == TokenTags.TEMPLATELITERAL) {
    const tmpl = parseTemplateLiteral(ref ps)?;
    return Result.Ok { value: SelfLexing.pushNode(ref ps, tmpl) };
  }
  let node = SelfLexing.buildSourcedNode(ref ps, ASTNodeKind.STRING_LITERAL);
  const tok = SelfLexing.advance(ref ps)?;
  node.strId = internString(ref ps, decodeStringLiteral(ref ps, tok)?);
  return Result.Ok { value: SelfLexing.pushNode(ref ps, node) };
}
