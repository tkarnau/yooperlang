import.test;

// The language server's three testable seams, none of which needs a pipe or a
// running editor:
//
//   * the Content-Length FRAMING, which is what hangs an editor when it is
//     wrong rather than failing loudly,
//   * the compiler location -> editor POSITION conversion, which is where an
//     off-by-one puts the squiggle under the wrong token,
//   * the exact BYTES of the messages that go out.
//
// The fourth seam - an editor really talking to the built binary - is
// src/lsp.test.js, because only a spawned process can say that.

import * as t from "std/test.yoop";
import { suite, test, Case } from "std/test.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { disposable } from "std/core/kinds.yoop";
import * as intr from "std/core/intrinsics.yoop";
import * as json from "modules/json";
import { JsonDoc, ParseResult } from "modules/json";

import { FrameStatus, HeaderScan, FrameReader, scanHeader, readFrame,
         frameReaderFromBytes, frameMessage } from "../lsp";
import { Position, Range, positionOfByte, rangeOfSpan } from "../lsp";
import { Document, DocumentStore, storeNew, storeUpsert, storeIndexOf,
         storeGet, storeClose, storeNextPending, storeMarkPublished,
         uriToPath } from "../lsp";
import { LspDiagnostic, Analysis, analysisNew, ensureAnalysis } from "../lsp";
import { byteOfPosition, pathToUri, signatureLine } from "../lsp";
import { Located, OutlineEntry, locateNode, collectOutline } from "../lsp";
import { buildPublishDiagnostics, buildInitializeResponse, buildNullResponse,
         buildErrorResponse, buildHoverResponse, buildLocationResponse,
         buildDocumentSymbolResponse, ERR_METHOD_NOT_FOUND } from "../lsp";
import { Result } from "std/core/types.yoop";
import { AST } from "../ast";
import { parse } from "../parse";

// ----- helpers -------------------------------------------------------------

// Read one message out of `wire` and hand its body back as text. A status
// other than MESSAGE renders as a marker, so an assertion compares one string
// either way rather than branching.
function firstBody(wire: string): Text propagates<disposable> {
  disposable r: FrameReader = frameReaderFromBytes(intr.stringAsBytes(wire));
  disposable body: Vec<uint8> = vec.vecNew(64);
  switch (readFrame(ref r, ref body)) {
    case FrameStatus.MESSAGE: {
      return text.fromBytes(body.asArray());
    }
    case FrameStatus.ENDED: {
      return text.fromString("<ended>");
    }
    case FrameStatus.MALFORMED: {
      return text.fromString("<malformed>");
    }
  }
}

// The status of the Nth read from `wire`, as a word.
function statusAfter(wire: string, skip: usize): Text propagates<disposable> {
  disposable r: FrameReader = frameReaderFromBytes(intr.stringAsBytes(wire));
  disposable body: Vec<uint8> = vec.vecNew(64);
  let i: usize = 0;
  while (i < skip) {
    const _s = readFrame(ref r, ref body);
    i += 1;
  }
  switch (readFrame(ref r, ref body)) {
    case FrameStatus.MESSAGE: { return text.fromString("message"); }
    case FrameStatus.ENDED: { return text.fromString("ended"); }
    case FrameStatus.MALFORMED: { return text.fromString("malformed"); }
  }
}

function checkText(ref theory: Case, ref got: Text, want: string): void {
  theory.isSuccessful = text.equals(got.view(), want);
  theory.detail = `got "${got.view()}", wanted "${want}"`;
}

// The JSON a built message serializes to.
function rendered(ref d: JsonDoc): Text propagates<disposable> {
  return json.serializeDoc(ref d);
}

// ----- framing -------------------------------------------------------------

suite function readsTheContentLengthFraming(): void {
  let test theory: Case = t.asserts("a header names exactly how many bytes follow") {
    const scan = scanHeader(intr.stringAsBytes("Content-Length: 5\r\n\r\nhello"), 0);
    theory.isSuccessful = scan.valid && scan.complete
      && scan.contentLength == 5 && scan.headerEnd == 21;
    theory.detail = `valid=${scan.valid} complete=${scan.complete} len=${scan.contentLength} end=${scan.headerEnd}`;
  }

  let test theory: Case = t.asserts("a header split mid-way is INCOMPLETE, not invalid") {
    // The distinction the whole file exists for: an editor's write may land in
    // two reads, and answering "invalid" would drop a perfectly good message.
    const scan = scanHeader(intr.stringAsBytes("Content-Len"), 0);
    theory.isSuccessful = scan.valid && !scan.complete;
    theory.detail = `valid=${scan.valid} complete=${scan.complete}`;
  }

  let test theory: Case = t.asserts("a header with no blank line yet is incomplete") {
    const scan = scanHeader(intr.stringAsBytes("Content-Length: 5\r\n"), 0);
    theory.isSuccessful = scan.valid && !scan.complete;
    theory.detail = `valid=${scan.valid} complete=${scan.complete}`;
  }

  let test theory: Case = t.asserts("the field name is case insensitive") {
    const scan = scanHeader(intr.stringAsBytes("content-LENGTH: 7\r\n\r\n"), 0);
    theory.isSuccessful = scan.valid && scan.complete && scan.contentLength == 7;
    theory.detail = `len=${scan.contentLength}`;
  }

  let test theory: Case = t.asserts("other header fields are read and ignored") {
    const wire = "Content-Type: application/vscode-jsonrpc; charset=utf-8\r\nContent-Length: 2\r\n\r\n{}";
    disposable got: Text = firstBody(wire);
    checkText(ref theory, ref got, "{}");
  }

  let test theory: Case = t.asserts("a lone \\n terminator is accepted") {
    disposable got: Text = firstBody("Content-Length: 2\n\n{}");
    checkText(ref theory, ref got, "{}");
  }

  let test theory: Case = t.asserts("a header with no Content-Length is refused") {
    const scan = scanHeader(intr.stringAsBytes("Content-Type: x\r\n\r\n"), 0);
    theory.isSuccessful = !scan.valid;
    theory.detail = "a header with no length was accepted";
  }

  let test theory: Case = t.asserts("a Content-Length that is not a number is refused") {
    const a = scanHeader(intr.stringAsBytes("Content-Length: abc\r\n\r\n"), 0);
    const b = scanHeader(intr.stringAsBytes("Content-Length: 12x\r\n\r\n"), 0);
    const c = scanHeader(intr.stringAsBytes("Content-Length:\r\n\r\n"), 0);
    theory.isSuccessful = !a.valid && !b.valid && !c.valid;
    theory.detail = `a=${a.valid} b=${b.valid} c=${c.valid}`;
  }

  let test theory: Case = t.asserts("a header line with no colon is refused") {
    const scan = scanHeader(intr.stringAsBytes("garbage\r\n\r\n"), 0);
    theory.isSuccessful = !scan.valid;
    theory.detail = "a header line with no colon was accepted";
  }

  let test theory: Case = t.asserts("the COUNT is what ends a body, not a scan for a blank line") {
    // The body itself contains `\r\n\r\n`. A reader that looked for the
    // separator instead of counting would cut the message in half here.
    const body = "{\"a\":\"x\\r\\n\\r\\ny\"}";
    disposable got: Text = firstBody(`Content-Length: 18\r\n\r\n${body}`);
    checkText(ref theory, ref got, body);
  }

  let test theory: Case = t.asserts("the count is BYTES, not characters") {
    // A two-byte codepoint written as a JSON escape decodes to two bytes, so a
    // 12-byte body is 11 characters. Counting characters would read one byte
    // short and desynchronize every message after it.
    disposable want: Text = text.make(16);
    want.push("{\"k\":\"");
    want.pushChar(233);          // U+00E9, two bytes in UTF-8
    want.push("\"}");
    disposable wire: Text = text.make(64);
    wire.push("Content-Length: ");
    wire.pushUint(uint64(want.bytes().len));
    wire.push("\r\n\r\n");
    wire.pushText(ref want);
    disposable got: Text = firstBody(wire.view());
    checkText(ref theory, ref got, want.view());
  }

  let test theory: Case = t.asserts("two messages back to back are read as two") {
    const wire = "Content-Length: 5\r\n\r\nfirstContent-Length: 6\r\n\r\nsecond";
    disposable r: FrameReader = frameReaderFromBytes(intr.stringAsBytes(wire));
    disposable body: Vec<uint8> = vec.vecNew(64);
    const s1 = readFrame(ref r, ref body);
    disposable one: Text = text.fromBytes(body.asArray());
    const s2 = readFrame(ref r, ref body);
    disposable two: Text = text.fromBytes(body.asArray());
    const s3 = readFrame(ref r, ref body);
    theory.isSuccessful = s1 == FrameStatus.MESSAGE && s2 == FrameStatus.MESSAGE
      && s3 == FrameStatus.ENDED
      && text.equals(one.view(), "first")
      && text.equals(two.view(), "second");
    theory.detail = `got "${one.view()}" then "${two.view()}"`;
  }

  let test theory: Case = t.asserts("empty input ends cleanly") {
    disposable got: Text = statusAfter("", 0);
    checkText(ref theory, ref got, "ended");
  }

  let test theory: Case = t.asserts("a body cut short is malformed, not a message") {
    disposable got: Text = statusAfter("Content-Length: 10\r\n\r\nshort", 0);
    checkText(ref theory, ref got, "malformed");
  }

  let test theory: Case = t.asserts("a header cut short is malformed at end of input") {
    disposable got: Text = statusAfter("Content-Length: 10\r\n", 0);
    checkText(ref theory, ref got, "malformed");
  }

  let test theory: Case = t.asserts("a zero-length body is a message") {
    disposable got: Text = firstBody("Content-Length: 0\r\n\r\n");
    checkText(ref theory, ref got, "");
  }
}

suite function writesTheContentLengthFraming(): void {
  let test theory: Case = t.asserts("a written frame is a header, a blank line and the body") {
    disposable got: Text = frameMessage(intr.stringAsBytes("{\"a\":1}"));
    checkText(ref theory, ref got, "Content-Length: 7\r\n\r\n{\"a\":1}");
  }

  let test theory: Case = t.asserts("what is written reads back as what went in") {
    const body = "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}";
    disposable wire: Text = frameMessage(intr.stringAsBytes(body));
    disposable back: Text = firstBody(wire.view());
    checkText(ref theory, ref back, body);
  }
}

// ----- positions -----------------------------------------------------------

suite function convertsCompilerLocationsToEditorPositions(): void {
  let test theory: Case = t.asserts("the first line is line 0, and its first byte is character 0") {
    const p = positionOfByte(intr.stringAsBytes("abc\ndef"), 0);
    theory.isSuccessful = p.line == 0 && p.character == 0;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("a byte on the first line keeps its own offset") {
    // The compiler's own `SourceLocation.column` is 0-based here and 1-based
    // on every line below, which is exactly why this file recomputes from the
    // byte offset instead of reading it.
    const p = positionOfByte(intr.stringAsBytes("abc\ndef"), 2);
    theory.isSuccessful = p.line == 0 && p.character == 2;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("the byte after a newline is character 0 of the next line") {
    const p = positionOfByte(intr.stringAsBytes("abc\ndef"), 4);
    theory.isSuccessful = p.line == 1 && p.character == 0;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("a third line counts from zero like every other") {
    const p = positionOfByte(intr.stringAsBytes("a\nbb\nccc"), 7);
    theory.isSuccessful = p.line == 2 && p.character == 2;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("a CRLF terminator costs no column") {
    const p = positionOfByte(intr.stringAsBytes("ab\r\ncd"), 5);
    theory.isSuccessful = p.line == 1 && p.character == 1;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("a two-byte codepoint is ONE UTF-16 unit") {
    // "<U+00E9>x" - the x is at byte 2 and at character 1.
    disposable src: Text = text.make(8);
    src.pushChar(233);
    src.push("x");
    const p = positionOfByte(src.bytes(), 2);
    theory.isSuccessful = p.line == 0 && p.character == 1;
    theory.detail = `got ${p.line}:${p.character}, wanted 0:1`;
  }

  let test theory: Case = t.asserts("a codepoint above the BMP is TWO UTF-16 units") {
    // "<U+1F600>x" - the x is at byte 4 and at character 2, because an editor
    // counts the emoji as a surrogate pair.
    disposable src: Text = text.make(8);
    src.pushChar(128512);
    src.push("x");
    const p = positionOfByte(src.bytes(), 4);
    theory.isSuccessful = p.line == 0 && p.character == 2;
    theory.detail = `got ${p.line}:${p.character}, wanted 0:2`;
  }

  let test theory: Case = t.asserts("an offset past the end clamps to the end") {
    const p = positionOfByte(intr.stringAsBytes("ab\ncd"), 999);
    theory.isSuccessful = p.line == 1 && p.character == 2;
    theory.detail = `got ${p.line}:${p.character}`;
  }

  let test theory: Case = t.asserts("a span becomes a range of the right width") {
    const r = rangeOfSpan(intr.stringAsBytes("let nope = 1;"), 4, 4);
    theory.isSuccessful = r.start.line == 0 && r.start.character == 4
      && r.end.line == 0 && r.end.character == 8;
    theory.detail = `got ${r.start.character}..${r.end.character}, wanted 4..8`;
  }

  let test theory: Case = t.asserts("a zero-width span is widened to one character") {
    // A range whose start equals its end draws nothing in most editors, which
    // reads as a missing diagnostic rather than a precise one.
    const r = rangeOfSpan(intr.stringAsBytes("abc"), 1, 0);
    theory.isSuccessful = r.start.character == 1 && r.end.character == 2;
    theory.detail = `got ${r.start.character}..${r.end.character}, wanted 1..2`;
  }
}

// ----- URIs ----------------------------------------------------------------

suite function turnsAUriIntoAPath(): void {
  let test theory: Case = t.asserts("a plain file URI is its path") {
    disposable got: Text = uriToPath("file:///home/a/b.yoop");
    checkText(ref theory, ref got, "/home/a/b.yoop");
  }

  let test theory: Case = t.asserts("percent escapes are decoded") {
    disposable got: Text = uriToPath("file:///home/a%20b/c%2Bd.yoop");
    checkText(ref theory, ref got, "/home/a b/c+d.yoop");
  }

  let test theory: Case = t.asserts("an authority is skipped") {
    disposable got: Text = uriToPath("file://localhost/tmp/x.yoop");
    checkText(ref theory, ref got, "/tmp/x.yoop");
  }

  let test theory: Case = t.asserts("a stray percent is a literal percent") {
    disposable got: Text = uriToPath("file:///tmp/100%.yoop");
    checkText(ref theory, ref got, "/tmp/100%.yoop");
  }

  let test theory: Case = t.asserts("something that is not a file URI is passed through") {
    disposable got: Text = uriToPath("/tmp/plain.yoop");
    checkText(ref theory, ref got, "/tmp/plain.yoop");
  }
}

// ----- the document store --------------------------------------------------

suite function tracksWhatTheEditorIsHolding(): void {
  let test theory: Case = t.asserts("an opened document is found by its URI and carries its path") {
    disposable s: DocumentStore = storeNew();
    const slot = storeUpsert(ref s, "file:///tmp/a.yoop", intr.stringAsBytes("xy"), 3);
    let d: Document = storeGet(ref s, slot);
    theory.isSuccessful = slot == 1
      && storeIndexOf(ref s, "file:///tmp/a.yoop") == 1
      && storeIndexOf(ref s, "file:///tmp/b.yoop") == 0
      && text.equals(d.path.view(), "/tmp/a.yoop")
      && d.version == 3
      && d.content.len == 2;
    theory.detail = `slot=${slot} path="${d.path.view()}" len=${d.content.len}`;
  }

  let test theory: Case = t.asserts("a second edit replaces the text rather than appending") {
    disposable s: DocumentStore = storeNew();
    const _a = storeUpsert(ref s, "file:///tmp/a.yoop", intr.stringAsBytes("first"), 1);
    const slot = storeUpsert(ref s, "file:///tmp/a.yoop", intr.stringAsBytes("second one"), 2);
    let d: Document = storeGet(ref s, slot);
    disposable got: Text = text.fromBytes(d.content.asArray());
    theory.isSuccessful = slot == 1 && d.version == 2
      && text.equals(got.view(), "second one");
    theory.detail = `content is "${got.view()}" at version ${d.version}`;
  }

  let test theory: Case = t.asserts("an edited document is pending until it is published") {
    disposable s: DocumentStore = storeNew();
    const slot = storeUpsert(ref s, "file:///tmp/a.yoop", intr.stringAsBytes("x"), 1);
    const before = storeNextPending(ref s);
    storeMarkPublished(ref s, slot);
    const after = storeNextPending(ref s);
    theory.isSuccessful = before == slot && after == 0;
    theory.detail = `pending was ${before}, then ${after}`;
  }

  let test theory: Case = t.asserts("a closed document is no longer pending") {
    disposable s: DocumentStore = storeNew();
    const _slot = storeUpsert(ref s, "file:///tmp/a.yoop", intr.stringAsBytes("x"), 1);
    const closed = storeClose(ref s, "file:///tmp/a.yoop");
    theory.isSuccessful = closed == 1 && storeNextPending(ref s) == 0
      && storeClose(ref s, "file:///tmp/never.yoop") == 0;
    theory.detail = `close answered ${closed}`;
  }
}

// ----- the messages --------------------------------------------------------

suite function buildsTheMessagesTheProtocolExpects(): void {
  let test theory: Case = t.asserts("the initialize result advertises only what is built") {
    disposable req: JsonDoc = parseOrEmpty("{\"id\":1}");
    disposable out: JsonDoc = json.docNew();
    const _r = buildInitializeResponse(ref out, ref req, json.member(ref req, req.root, "id"));
    disposable got: Text = rendered(ref out);
    // Four capabilities, and every one of them is answered: full-text sync
    // with open/close and save, and the three position-and-file queries. A
    // capability announced and not implemented is a client waiting forever on
    // a reply, which is why this asserts the whole object rather than that the
    // ones it names are present.
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true},\"serverInfo\":{\"name\":\"yoopiler_boot\"}}}");
  }

  let test theory: Case = t.asserts("a hover carries markdown and the span it is about") {
    // The range is what makes an editor underline the whole name while the
    // tooltip is up, instead of guessing at a word boundary.
    disposable req: JsonDoc = parseOrEmpty("{\"id\":4}");
    disposable out: JsonDoc = json.docNew();
    let span: Range = {
      start: { line: 2, character: 6 },
      end: { line: 2, character: 11 },
    };
    const _r = buildHoverResponse(ref out, ref req, json.member(ref req, req.root, "id"),
                                  "```yoop\ntwice\n```", span);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```yoop\\ntwice\\n```\"},\"range\":{\"start\":{\"line\":2,\"character\":6},\"end\":{\"line\":2,\"character\":11}}}}");
  }

  let test theory: Case = t.asserts("a definition is ONE location, not a list of one") {
    // A name in this language resolves to exactly one declaration. The
    // protocol would accept an array; handing one back would only make every
    // client unpack it.
    disposable req: JsonDoc = parseOrEmpty("{\"id\":5}");
    disposable out: JsonDoc = json.docNew();
    let span: Range = {
      start: { line: 9, character: 9 },
      end: { line: 9, character: 14 },
    };
    const _r = buildLocationResponse(ref out, ref req, json.member(ref req, req.root, "id"),
                                     "file:///w/a.yoop", span);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":{\"uri\":\"file:///w/a.yoop\",\"range\":{\"start\":{\"line\":9,\"character\":9},\"end\":{\"line\":9,\"character\":14}}}}");
  }

  let test theory: Case = t.asserts("a member follows its type into that type's children") {
    // The entries go in FLAT with a depth; the nesting is rebuilt here. What
    // this asserts is that a depth-1 entry lands inside the depth-0 entry
    // before it rather than beside it.
    disposable req: JsonDoc = parseOrEmpty("{\"id\":6}");
    disposable out: JsonDoc = json.docNew();
    disposable entries: Vec<OutlineEntry> = vec.vecNew(2);
    let one: Range = { start: { line: 0, character: 5 }, end: { line: 0, character: 10 } };
    let two: Range = { start: { line: 1, character: 2 }, end: { line: 1, character: 3 } };
    entries.push({ name: "Point", kind: 23, range: one, depth: 0 });
    entries.push({ name: "x", kind: 8, range: two, depth: 1 });
    const _r = buildDocumentSymbolResponse(ref out, ref req,
                                           json.member(ref req, req.root, "id"), ref entries);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"id\":6,\"result\":[{\"name\":\"Point\",\"kind\":23,\"range\":{\"start\":{\"line\":0,\"character\":5},\"end\":{\"line\":0,\"character\":10}},\"selectionRange\":{\"start\":{\"line\":0,\"character\":5},\"end\":{\"line\":0,\"character\":10}},\"children\":[{\"name\":\"x\",\"kind\":8,\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":3}},\"selectionRange\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":3}}}]}]}");
  }

  let test theory: Case = t.asserts("a STRING request id comes back as the same string") {
    // The protocol allows either, and a response whose id is not identical to
    // the request's is one the client throws away.
    disposable req: JsonDoc = parseOrEmpty("{\"id\":\"abc-1\"}");
    disposable out: JsonDoc = json.docNew();
    const _r = buildNullResponse(ref out, ref req, json.member(ref req, req.root, "id"));
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got, "{\"jsonrpc\":\"2.0\",\"id\":\"abc-1\",\"result\":null}");
  }

  let test theory: Case = t.asserts("an error response carries the code and the reason") {
    disposable req: JsonDoc = parseOrEmpty("{\"id\":9}");
    disposable out: JsonDoc = json.docNew();
    const _r = buildErrorResponse(ref out, ref req, json.member(ref req, req.root, "id"),
                                  ERR_METHOD_NOT_FOUND, "nope");
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32601,\"message\":\"nope\"}}");
  }

  let test theory: Case = t.asserts("a diagnostic renders with a zero-based range") {
    disposable diags: Vec<LspDiagnostic> = vec.vecNew(2);
    let d: LspDiagnostic = {
      message: "unknown name \"nope\"",
      code: "",
      severity: 1,
      range: { start: { line: 1, character: 19 }, end: { line: 1, character: 23 } },
    };
    diags.push(d);
    disposable out: JsonDoc = json.docNew();
    const _p = buildPublishDiagnostics(ref out, "file:///tmp/a.yoop", 4, ref diags);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///tmp/a.yoop\",\"version\":4,\"diagnostics\":[{\"range\":{\"start\":{\"line\":1,\"character\":19},\"end\":{\"line\":1,\"character\":23}},\"severity\":1,\"source\":\"yoopiler\",\"message\":\"unknown name \\\"nope\\\"\"}]}}");
  }

  let test theory: Case = t.asserts("a warning carries severity 2 and its code") {
    disposable diags: Vec<LspDiagnostic> = vec.vecNew(2);
    let d: LspDiagnostic = {
      message: "unused",
      code: "unhandled-disposable",
      severity: 2,
      range: { start: { line: 0, character: 0 }, end: { line: 0, character: 1 } },
    };
    diags.push(d);
    disposable out: JsonDoc = json.docNew();
    const _p = buildPublishDiagnostics(ref out, "file:///x", 0, ref diags);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///x\",\"version\":0,\"diagnostics\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":1}},\"severity\":2,\"code\":\"unhandled-disposable\",\"source\":\"yoopiler\",\"message\":\"unused\"}]}}");
  }

  let test theory: Case = t.asserts("an empty list is still published, because that is what clears squiggles") {
    disposable diags: Vec<LspDiagnostic> = vec.vecNew(2);
    disposable out: JsonDoc = json.docNew();
    const _p = buildPublishDiagnostics(ref out, "file:///x", 1, ref diags);
    disposable got: Text = rendered(ref out);
    checkText(ref theory, ref got,
      "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///x\",\"version\":1,\"diagnostics\":[]}}");
  }
}

// ----- the compiler's answer ----------------------------------------------

suite function reportsWhatTheCompilerSaysAboutTheBuffer(): void {
  let test theory: Case = t.asserts("a syntax error in the buffer is reported where it is") {
    // The buffer, not the file: nothing is written to disk here and the path
    // below does not exist. A syntax error is caught by parsing the bytes the
    // editor sent, which is why this half is live for every document.
    disposable s: DocumentStore = storeNew();
    const slot = storeUpsert(ref s, "file:///tmp/nonexistent_lsp_probe.yoop",
      intr.stringAsBytes("function main(): int32 {\n  return 1\n}\n"), 1);
    let doc: Document = storeGet(ref s, slot);
    disposable an: Analysis = analysisNew();
    ensureAnalysis(ref an, ref doc, "");
    const first = an.diags.get(0);
    theory.isSuccessful = an.diags.len == 1 && first.severity == 1
      && first.range.start.line == 2;
    theory.detail = `got ${an.diags.len} diagnostic(s), first at line ${first.range.start.line}: ${first.message}`;
  }

  let test theory: Case = t.asserts("a buffer that parses produces no syntax diagnostic") {
    // The graph load below it FAILS (nothing resolves against an empty std
    // root), so what this asserts is that the parse half said nothing and the
    // whole-file fallback is what spoke.
    disposable s: DocumentStore = storeNew();
    const slot = storeUpsert(ref s, "file:///tmp/nonexistent_lsp_probe.yoop",
      intr.stringAsBytes("function main(): int32 {\n  return 1;\n}\n"), 1);
    let doc: Document = storeGet(ref s, slot);
    disposable an: Analysis = analysisNew();
    ensureAnalysis(ref an, ref doc, "");
    let sawSyntaxDiagnostic: bool = false;
    let i: usize = 0;
    while (i < an.diags.len) {
      const d = an.diags.get(i);
      if (d.range.start.line > 0) {
        sawSyntaxDiagnostic = true;
      }
      i += 1;
    }
    theory.isSuccessful = !sawSyntaxDiagnostic;
    theory.detail = `a well formed buffer produced a diagnostic past line 0`;
  }

  let test theory: Case = t.asserts("a second request against the same buffer reuses the compile") {
    // The point of holding one: `ensureAnalysis` is the entry every request
    // goes through, and only the first of them may pay. A recompile would
    // CLEAR and refill `diags`, so a doubled list is what a cache miss would
    // look like and an unchanged one is what a hit looks like.
    disposable s: DocumentStore = storeNew();
    const slot = storeUpsert(ref s, "file:///tmp/nonexistent_lsp_probe.yoop",
      intr.stringAsBytes("function main(): int32 {\n  return 1\n}\n"), 7);
    let doc: Document = storeGet(ref s, slot);
    disposable an: Analysis = analysisNew();
    ensureAnalysis(ref an, ref doc, "");
    const afterFirst = an.diags.len;
    ensureAnalysis(ref an, ref doc, "");
    theory.isSuccessful = an.version == 7 && an.diags.len == afterFirst && afterFirst == 1;
    theory.detail = `held version ${an.version}, ${afterFirst} diagnostic(s) then ${an.diags.len}`;
  }
}

// ----- positions, both ways ------------------------------------------------

suite function convertsBetweenOffsetsAndEditorPositions(): void {
  let test theory: Case = t.asserts("an offset and a position name the same place, both ways") {
    // `let a = 1;\nlet <e-acute> = naive;\n`, with the accented letter written
    // as the two UTF-8 bytes it is: the lexer has no \u escape, and those two
    // bytes ARE what the test is about. Line 1 then counts one unit for two
    // bytes, so a byte offset and an editor column disagree from there on.
    //
    // `naive` starts at byte 20 - `let a = 1;\n` is 11, `let ` is 4, the
    // letter is 2, and ` = ` is 3 - and at column 8, which counts the letter
    // once.
    disposable buf: Vec<uint8> = vec.vecNew(32);
    buf.extendFrom(intr.stringAsBytes("let a = 1;\nlet "));
    buf.push(195);
    buf.push(169);
    buf.extendFrom(intr.stringAsBytes(" = naive;\n"));
    const src = buf.asArray();
    const p = positionOfByte(src, 20);
    const back = byteOfPosition(src, p.line, p.character);
    theory.isSuccessful = p.line == 1 && p.character == 8 && back == 20;
    theory.detail = `byte 20 is ${p.line}:${p.character}, and back again ${back}`;
  }

  let test theory: Case = t.asserts("a character past the end of a line stops at its terminator") {
    // An editor may ask about a column that was there before the last edit.
    // Landing on the newline is the end of what there is; running into the
    // NEXT line would answer about a different line entirely.
    const src = intr.stringAsBytes("ab\ncdef\n");
    theory.isSuccessful = byteOfPosition(src, 0, 99) == 2;
    theory.detail = `column 99 of a two-character line resolved to ${byteOfPosition(src, 0, 99)}`;
  }

  let test theory: Case = t.asserts("a line past the end of the file clamps to the end") {
    const src = intr.stringAsBytes("ab\n");
    theory.isSuccessful = byteOfPosition(src, 40, 0) == 3;
    theory.detail = `line 40 of a one-line file resolved to ${byteOfPosition(src, 40, 0)}`;
  }
}

// ----- a path and a URI ----------------------------------------------------

suite function convertsBetweenPathsAndUris(): void {
  let test theory: Case = t.asserts("a path with a space round-trips through a URI") {
    disposable uri: Text = pathToUri("/home/a/b c.yoop");
    disposable back: Text = uriToPath(uri.view());
    theory.isSuccessful = text.equals(uri.view(), "file:///home/a/b%20c.yoop")
      && text.equals(back.view(), "/home/a/b c.yoop");
    theory.detail = `"${uri.view()}" -> "${back.view()}"`;
  }

  let test theory: Case = t.asserts("separators survive and a hash is escaped") {
    // A `#` in a path is a FRAGMENT marker in a URI, so leaving it alone names
    // a different file; a `/` is the one reserved character that has to stay.
    disposable uri: Text = pathToUri("/a/b#c/d.yoop");
    theory.isSuccessful = text.equals(uri.view(), "file:///a/b%23c/d.yoop");
    theory.detail = `got "${uri.view()}"`;
  }
}

// ----- what is under the cursor --------------------------------------------

// The offset of `needle` in `src`, so a test names a position by what is
// written there rather than by a number nobody can check.
function offsetOf(src: string, needle: string): usize {
  return text.indexOf(src, needle);
}

const LOCATE_SRC: string = "type Point {\n  x: int32,\n}\n\nfunction twice(n: int32): int32 {\n  return n + n;\n}\n";

suite function findsTheNodeUnderAnOffset(): void {
  let test theory: Case = t.asserts("an offset inside a name finds the node that name is on") {
    switch (parse(intr.stringAsBytes(LOCATE_SRC))) {
      case Result.Err { error: e }: {
        theory.isSuccessful = false;
        theory.detail = `the fixture did not parse: ${e.rawMessage}`;
      }
      case Result.Ok { value: parsed }: {
        disposable ast: AST = parsed;
        // The `n` of `n + n`, which is the first one after `return `.
        const at = offsetOf(LOCATE_SRC, "return n") + 7;
        const found = locateNode(ref ast, ast.root, at);
        theory.isSuccessful = found.found && text.equals(found.name, "n")
          && found.pos == at && found.length == 1;
        theory.detail = `offset ${at} found "${found.name}" at ${found.pos}+${found.length}`;
      }
    }
  }

  let test theory: Case = t.asserts("a declaration is found by its own name, not by its keyword") {
    // The whole reason the parser locates a node at its NAME: an offset on
    // `twice` has to reach the declaration, and one on `function` must not
    // reach something else by being one token to the left.
    switch (parse(intr.stringAsBytes(LOCATE_SRC))) {
      case Result.Err { error: e }: {
        theory.isSuccessful = false;
        theory.detail = `the fixture did not parse: ${e.rawMessage}`;
      }
      case Result.Ok { value: parsed }: {
        disposable ast: AST = parsed;
        const at = offsetOf(LOCATE_SRC, "twice");
        const found = locateNode(ref ast, ast.root, at);
        theory.isSuccessful = found.found && text.equals(found.name, "twice")
          && found.pos == at && found.length == 5;
        theory.detail = `offset ${at} found "${found.name}" at ${found.pos}+${found.length}`;
      }
    }
  }

  let test theory: Case = t.asserts("an offset on whitespace finds nothing") {
    switch (parse(intr.stringAsBytes(LOCATE_SRC))) {
      case Result.Err { error: e }: {
        theory.isSuccessful = false;
        theory.detail = `the fixture did not parse: ${e.rawMessage}`;
      }
      case Result.Ok { value: parsed }: {
        disposable ast: AST = parsed;
        // The blank line between the type and the function.
        const at = offsetOf(LOCATE_SRC, "\n\nfunction") + 1;
        const found = locateNode(ref ast, ast.root, at);
        theory.isSuccessful = !found.found;
        theory.detail = `offset ${at} found "${found.name}" instead of nothing`;
      }
    }
  }
}

// ----- the outline ---------------------------------------------------------

suite function listsWhatIsInTheFile(): void {
  let test theory: Case = t.asserts("top-level declarations come out in source order, with members under them") {
    switch (parse(intr.stringAsBytes(LOCATE_SRC))) {
      case Result.Err { error: e }: {
        theory.isSuccessful = false;
        theory.detail = `the fixture did not parse: ${e.rawMessage}`;
      }
      case Result.Ok { value: parsed }: {
        disposable ast: AST = parsed;
        disposable entries: Vec<OutlineEntry> = vec.vecNew(8);
        collectOutline(ref ast, ast.root, intr.stringAsBytes(LOCATE_SRC), ref entries);
        // Point (a struct, depth 0), its field x (depth 1), then twice (a
        // function, depth 0). SymbolKind 23 is Struct, 8 is Field, 12 is
        // Function - the protocol's numbers, not this compiler's.
        const a = entries.get(0);
        const b = entries.get(1);
        const c = entries.get(2);
        theory.isSuccessful = entries.len == 3
          && text.equals(a.name, "Point") && a.kind == 23 && a.depth == 0
          && text.equals(b.name, "x") && b.kind == 8 && b.depth == 1
          && text.equals(c.name, "twice") && c.kind == 12 && c.depth == 0;
        theory.detail = `${entries.len} entries: ${a.name}/${a.kind}, ${b.name}/${b.kind}, ${c.name}/${c.kind}`;
      }
    }
  }
}

// ----- a declaration as one line -------------------------------------------

suite function rendersADeclarationAsOneLine(): void {
  let test theory: Case = t.asserts("a signature stops at the body and keeps the whole line") {
    const src = "export function twice(n: int32): int32 {\n  return n + n;\n}\n";
    disposable got: Text = signatureLine(intr.stringAsBytes(src), text.indexOf(src, "twice"));
    theory.isSuccessful = text.equals(got.view(), "export function twice(n: int32): int32");
    theory.detail = `got "${got.view()}"`;
  }

  let test theory: Case = t.asserts("a signature written over several lines collapses to one") {
    // The shape half this compiler's own signatures are written in. Reading it
    // back with the indentation left in would be a tooltip four lines tall.
    const src = "function wide(\n  a: int32,\n  b: int32\n): int32 {\n  return a;\n}\n";
    disposable got: Text = signatureLine(intr.stringAsBytes(src), text.indexOf(src, "wide"));
    theory.isSuccessful = text.equals(got.view(), "function wide(a: int32, b: int32): int32");
    theory.detail = `got "${got.view()}"`;
  }

  let test theory: Case = t.asserts("a declaration with no body stops at its semicolon") {
    const src = "type NodeId = usize;\n";
    disposable got: Text = signatureLine(intr.stringAsBytes(src), text.indexOf(src, "NodeId"));
    theory.isSuccessful = text.equals(got.view(), "type NodeId = usize");
    theory.detail = `got "${got.view()}"`;
  }

  let test theory: Case = t.asserts("a brace inside a generic argument does not end the signature") {
    // `<` and `>` are counted, so the `{` that ends this one is the body's.
    const src = "function pick(v: Vec<int32>): int32 {\n  return 0;\n}\n";
    disposable got: Text = signatureLine(intr.stringAsBytes(src), text.indexOf(src, "pick"));
    theory.isSuccessful = text.equals(got.view(), "function pick(v: Vec<int32>): int32");
    theory.detail = `got "${got.view()}"`;
  }
}

function parseOrEmpty(src: string): JsonDoc propagates<disposable> {
  switch (json.parseString(src)) {
    case ParseResult.Err { error: e }: {
      return json.docNew();
    }
    case ParseResult.Ok { value: parsed }: {
      return parsed;
    }
  }
}
