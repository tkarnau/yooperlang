module lsp;

/*
  Running the compiler over one open document, and turning what it says into
  what an editor draws.

  HOW AN UNSAVED BUFFER REACHES THE COMPILER. The compiler reads files by path;
  the editor is holding text that is not on disk. The loader has one place
  where a path becomes bytes, so the buffer goes in as an OVERLAY over that one
  read - see source_graph/overlay.yoop. The module the document belongs to is
  found and loaded exactly as a build would find it, every other file is read
  off the disk as usual, and the ONE path the editor is holding is answered
  from the buffer.

  That is what makes a file of a DIRECTORY module work, which is most of this
  compiler's own source. The module is the compilation unit there, so a
  document cannot simply BE the entry module the way a single-file program can:
  seeding it from one file's bytes produces a module missing every declaration
  its siblings make, and the editor fills with "unknown name" on code that is
  fine. An overlay leaves the module whole and replaces one file inside it.

  A buffer with no file behind it - an editor's "untitled" - has no module to
  belong to, so it is compiled as its own entry from its own bytes. That is the
  one shape that still cannot see a directory module's siblings, and it cannot
  be in one.

  WHAT IS PUBLISHED. Only the diagnostics belonging to this document's own
  path, plus any that carry no path at all. A diagnostic in a file the document
  imports is dropped rather than published against the wrong URI, which would
  put a squiggle on an unrelated line. Publishing those as well needs the
  server to remember which URIs it has published to so that it can clear them
  again, and nothing here does that yet.

  WARNINGS ARE NOT FILTERED, unlike a build's. `unhandled-disposable` and
  `unhandled-owned` are silenced in a build unless `--warn-disposable` says
  otherwise, because the first has two known false-positive classes and
  teaching people to stop reading warnings costs more than it finds. An editor is the other case: it is where an
  advisory belongs, the reader can see the line, and the path filter above
  already drops everything std says about itself.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import * as text from "std/core/text.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import * as str from "std/core/strings.yoop";
import * as fs from "std/fs.yoop";

import { AST } from "../ast";
import { parse } from "../parse";
import { LoadGraphResult, ModuleGraph, SourceOverlay, loadModuleGraphWithOverlay,
         loadModuleGraphFromSource } from "../source_graph";
import { typecheckProgram } from "../typecheck";
import { Diagnostic, Severity } from "../diagnostics";
import { runPrecompilePass } from "../comptime";

// The LSP severity numbers. There is no enum for them here because they go
// straight into JSON as integers and naming them twice would be the only
// difference.
const SEVERITY_ERROR: int64 = 1;
const SEVERITY_WARNING: int64 = 2;

/*
  One diagnostic, already in the editor's coordinates.

  `message` and `code` are BORROWED from the compiler's own strings. That is
  sound because nothing in this tree ever frees a `string` - see
  docs/writing_yoop.md 3.1 - and it is why this type is not disposable. It is
  also the leak this server has, stated plainly: every compile mallocs its
  diagnostic messages and nothing reclaims them. It is bounded by the number of
  DIAGNOSTICS rather than by the size of the program, and removing it means
  giving the compiler's messages an allocator to come out of - which is a
  change to how the whole compiler builds a string, not anything this file can
  do on its own.
*/
export type LspDiagnostic {
  message: string,
  code: string,
  severity: int64,
  range: Range,
}

/*
  Make `an` hold a compile of `doc`, compiling only if it does not already.

  This is the single entry every request goes through - the publish, a hover, a
  definition, an outline - so that the first of them pays for the compile and
  the rest are lookups. See analysis.yoop for what is held and why.
*/
export function ensureAnalysis(ref an: Analysis, ref doc: Document, stdRoot: string): void {
  const uri = text.view(ref doc.uri);
  if (analysisIsFor(ref an, uri, doc.version)) {
    return;
  }
  releaseCompile(ref an);
  vec.vecClear(ref an.diags);
  compileDocument(ref an, ref doc, stdRoot);
  analysisIdentify(ref an, uri, text.view(ref doc.path), doc.version);
}

/*
  Compile the document and fill `an` with the program and the diagnostics.

  Always succeeds in the sense that matters to an editor: a compiler that
  refuses the document produces diagnostics, which is the point, and a compiler
  that cannot even find the file produces one diagnostic saying so.
*/
function compileDocument(ref an: Analysis, ref doc: Document, stdRoot: string): void {
  const src = vec.vecAsArray(ref doc.content);
  const path = text.view(ref doc.path);
  // The name the LOADER will know this file by, which is not always the one
  // the editor's URI spelled: the loader canonicalizes a path before it opens
  // anything, and on a filesystem with a symlinked directory in it - a temp
  // directory is the ordinary case - the two differ. Everything downstream
  // that has to match the loader's spelling uses this one: the overlay, the
  // search for the document in the graph, and the diagnostic filter.
  const absPath = canonicalOr(path);

  // Parse the BUFFER first, on its own. What it buys is the SPAN of a syntax
  // error: the graph loader reports one as a pre-formatted
  // "path:line:col: message" string with no range in it, which an editor can
  // only show against the whole file.
  switch (parse(src)) {
    case Result.Err { error: e }: {
      vec.vecPush(ref an.diags, {
        message: e.rawMessage,
        code: "",
        severity: SEVERITY_ERROR,
        range: rangeOfSpan(src, e.sourceLoc.pos, e.sourceLoc.length),
      });
      return;
    }
    case Result.Ok { value: parsed }: {
      // Thrown away: what it proves is that the graph load below will not fail
      // on THIS file's syntax, and the graph builds its own arena.
      disposable ast: AST = parsed;
    }
  }

  switch (loadGraphFor(ref doc, path, absPath, stdRoot)) {
    case LoadGraphResult.Err { error: e }: {
      // A missing import, an import cycle, a sibling of a directory module
      // that does not parse. None of these has a location in THIS file, so
      // they land on its first character, which is where an editor shows a
      // whole-file problem.
      vec.vecPush(ref an.diags, {
        message: e,
        code: "",
        severity: SEVERITY_ERROR,
        range: { start: { line: 0, character: 0 }, end: { line: 0, character: 1 } },
      });
    }
    case LoadGraphResult.Ok { value: g }: {
      an.graph = g;
      an.prog = typecheckProgram(ref an.graph);
      runPrecompilePass(ref an.prog, ref an.graph);
      // From here the compile is storage somebody has to release, whether or
      // not the document turns out to be findable inside it.
      an.held = true;
      // Where the document sits in the graph, which is what every query walks
      // from. Not finding it is not a failure to report: the diagnostics below
      // are filtered by PATH and are right either way, and all it means is that
      // hover and definition have nothing to walk.
      an.typed = analysisLocateDocument(ref an, absPath);
      collectDiagnostics(ref an, src, absPath);
    }
  }
}

// Everything the compile said about THIS file, in the editor's coordinates.
function collectDiagnostics(ref an: Analysis, src: uint8[], absPath: string): void {
  let i: usize = 0;
  while (i < an.prog.diagnostics.len) {
    const d = vec.vecGet(ref an.prog.diagnostics, i);
    if (belongsToDocument(ref d, absPath)) {
      vec.vecPush(ref an.diags, {
        message: d.message,
        code: d.code,
        severity: lspSeverity(d.severity),
        range: rangeOfSpan(src, d.sourceLoc.pos, d.sourceLoc.length),
      });
    }
    i += 1;
  }
}

/*
  Load the document's module, with the document itself read from the buffer.

  The overlay's path has to be the one `readSource` will be handed, which is
  the NORMALIZED path - the loader canonicalizes the entry before it opens
  anything, and builds a directory module's file paths by joining that
  directory back together. `documentPath` normalizes the same way, so the two
  agree.
*/
function loadGraphFor(
  ref doc: Document,
  path: string,
  absPath: string,
  stdRoot: string
): LoadGraphResult {
  if (fs.exists(path)) {
    let overlay: SourceOverlay = {
      path: absPath,
      src: vec.vecAsArray(ref doc.content),
    };
    return loadModuleGraphWithOverlay(path, stdRoot, overlay);
  }
  // A buffer with no file behind it. There is no module to overlay onto, so
  // the document IS the entry module - which is right for anything that is not
  // one file of a directory module, and a file of one cannot be here.
  //
  // The loader MOVES the bytes it is given into the module it seeds, and the
  // spans in the AST point into exactly those bytes for as long as the graph
  // lives - so the document keeps its own copy and hands over a fresh one.
  let seed: Vec<uint8> = vec.vecNew(doc.content.len + 1);
  vec.vecExtendFrom(ref seed, vec.vecAsArray(ref doc.content));
  return loadModuleGraphFromSource(seed, path, stdRoot);
}

// A diagnostic with no file is one raised before any file was being walked, so
// it is shown on whatever the editor is looking at rather than nowhere.
function belongsToDocument(ref d: Diagnostic, absPath: string): bool {
  if (d.filePath.len == 0) {
    return true;
  }
  return str.stringEq(d.filePath, absPath);
}

// The canonical spelling of a path, or the path itself when there is no file
// to canonicalize - which is an editor buffer that has never been saved.
export function canonicalOr(path: string): string {
  if (!fs.exists(path)) {
    return path;
  }
  const abs = fs.normalizePath(path);
  if (abs.len == 0) {
    return path;
  }
  return abs;
}

function lspSeverity(s: Severity): int64 {
  switch (s) {
    case Severity.ERROR: { return SEVERITY_ERROR; }
    case Severity.WARNING: { return SEVERITY_WARNING; }
  }
}
