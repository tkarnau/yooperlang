import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, SourceLocation } from "../contracts.yoop";

export function createASTNode(astNodeKind: ASTNodeKind, sourceLoc: SourceLocation): ASTNode {
  return {
    kind: astNodeKind,
    sourceLoc: sourceLoc,
    name: "",
    childStart: 0,
    childCount: 0,
    childA: 0,
    childB: 0,
    childC: 0,
    spanStart: 0,
    spanLen: 0,
    strId: 0,
    intVal: 0,
    flagA: false,
  };
}

// A fresh, empty arena. NodeId 0 is reserved as the "none" sentinel: a 0 in any
// child slot means "absent", so we seed the arena with one dead node at index 0
// and real nodes begin at index 1. `root` is set by the parser once the PROGRAM
// node is pushed.
export function emptyArena(): AST propagates<disposable> {
  let nodes: Vec<ASTNode> = vec.vec_new(64);
  const sentinelLoc: SourceLocation = { pos: 0, line: 0, column: 0, length: 0 };
  vec.vec_push(ref nodes, createASTNode(ASTNodeKind.PROGRAM, sentinelLoc));
  let childIds: Vec<NodeId> = vec.vec_new(64);
  let strings: Vec<string> = vec.vec_new(16);
  return {
    nodes: nodes,
    childIds: childIds,
    strings: strings,
    root: 0,
  };
}
