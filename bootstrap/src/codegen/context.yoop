module codegen;


// What every codegen function needs, in one value.
//
// These five things travel together through the whole walk, so passing them
// separately meant seven-parameter signatures that buried the one argument that
// actually varied. `ref` fields make the bundle a view, not a copy - mutations
// to the emitter and the locals map land on the originals.
//
// It also puts the typecheck -> codegen handoff in one place. Codegen reads
// exactly three things from that boundary and nothing else:
//   * the AST     (shape: what to emit)
//   * resolvedTypes via `typeOf` (what type each node ended up)
//   * the symbol table via `returnTypeOf` (a callee's return type)
// Everything else on Program/TypedModule is typecheck's business.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { Option } from "std/core/types.yoop";
import { AST, NodeId } from "../ast";
import { Program, TypedModule, TypeId, Type, Symbol, symbolAt, typeAt, TYPE_VOID_ID, TYPE_ERROR_ID,
  primTypeIdOfName, primBitWidth, primIsSigned } from "../typecheck";

export type Cx {
  e: ref Emitter,
  prog: ref Program,
  tm: ref TypedModule,
  ast: ref AST,
  locals: ref FnLocals,
  loops: ref LoopStack,   // where break/continue jump; see loops.yoop
  // Which monomorphization of a generic function is being emitted, as an index
  // into Program.funcInstances - or NO_FUNC_INSTANCE for ordinary code.
  //
  // A generic body is TYPE-CHECKED once, with its parameters left opaque, so
  // its decoration holds TypeParam ids. Codegen emits it once per instance and
  // substitutes on the way out: `typeOf` is the single place that happens. See
  // the note in query.yoop.
  instance: usize,
}

// `Cx.instance` when the code being emitted is not inside a generic function.
//
// Index 0, and `initGenerics` burns that slot on a dead entry - the same
// reserved-zero idiom SymbolId and DeclId use. A max-value sentinel was the
// first attempt and it was worse than wrong: it silently WRAPPED to 0, so the
// first monomorphization in every program was emitted as if it were ordinary
// code, under the generic's bare name and with its type parameters unresolved.
export const NO_FUNC_INSTANCE: usize = 0;

// One parameter of the function being emitted.
export type ParamInfo {
  name: string,
  ty: string,        // as the signature spells it - `ptr` for a `ref` parameter
  isRef: bool,
  pointeeTy: string, // what a `ref` parameter points AT; unused otherwise
}

// One argument at a call site, already lowered.
export type CallArg {
  ty: string,
  value: Operand,
}

// ----- raw appenders, used only by instr.yoop -----------------------------
//
// Kept short and unexported-in-spirit: everything outside instr.yoop should be
// calling an emitX function, not assembling text by hand.

export function part(ref cx: Cx, s: string): void {
  text.push(ref cx.e.fn, s);
}

export function startInstr(ref cx: Cx): void {
  text.push(ref cx.e.fn, "  ");
}

export function endInstr(ref cx: Cx): void {
  text.pushByte(ref cx.e.fn, 10);
}

// `%t7`
export function temp(ref cx: Cx, id: usize): void {
  text.push(ref cx.e.fn, "%t");
  text.pushUint(ref cx.e.fn, uint64(id));
}

// `%count.1.addr` - a local's stack slot. Spelled out from the name plus the
// uniquing number so no string is built per use.
export function slot(ref cx: Cx, name: string, id: usize): void {
  text.pushByte(ref cx.e.fn, '%');
  text.push(ref cx.e.fn, name);
  // The reserved id: a `ref` parameter's slot is the incoming pointer, which
  // LLVM already named `%<name>.arg`. See ARG_PTR_SLOT in locals.yoop.
  if (id == ARG_PTR_SLOT) {
    text.push(ref cx.e.fn, ".arg");
    return;
  }
  text.pushByte(ref cx.e.fn, '.');
  text.pushUint(ref cx.e.fn, uint64(id));
  text.push(ref cx.e.fn, ".addr");
}

// The same slot name, into the prologue buffer.
export function prologueSlot(ref cx: Cx, name: string, id: usize): void {
  text.pushByte(ref cx.e.prologue, '%');
  text.push(ref cx.e.prologue, name);
  text.pushByte(ref cx.e.prologue, '.');
  text.pushUint(ref cx.e.prologue, uint64(id));
  text.push(ref cx.e.prologue, ".addr");
}

// `L3`
export function label(ref cx: Cx, id: usize): void {
  text.push(ref cx.e.fn, "L");
  text.pushUint(ref cx.e.fn, uint64(id));
}

// Allocas go to the prologue so they sit at the top of `entry:` and dominate
// every use, even when the declaration was inside a branch.
export function prologuePart(ref cx: Cx, s: string): void {
  text.push(ref cx.e.prologue, s);
}

// A plain number in the instruction stream (a field index, an element count).
export function num(ref cx: Cx, v: usize): void {
  text.pushUint(ref cx.e.fn, uint64(v));
}

export function prologueUint(ref cx: Cx, v: usize): void {
  text.pushUint(ref cx.e.prologue, uint64(v));
}

// The `define ...` line and `entry:` go straight to the module buffer, because
// the prologue and the instruction stream are appended AFTER them.
export function headerPart(ref cx: Cx, s: string): void {
  text.push(ref cx.e.body, s);
}

export function headerEnd(ref cx: Cx): void {
  text.pushByte(ref cx.e.body, 10);
}

export function operand(ref cx: Cx, op: Operand): void {
  emitOperand(cx.e, op);
}

// The message for a codegen invariant that did not hold. One allocation on a
// path that is aborting the compile anyway, which is why a template literal is
// fine here - it is not in a loop.
export function internalError(what: string, detail: string): string {
  return `internal error: ${what} "${detail}"`;
}

// A construct codegen understands and cannot lower YET, as opposed to one it
// should never have been handed. The two read differently on purpose: an
// internal error means a pass above let something through, and this means the
// feature is not built.
export function unsupportedHere(what: string, detail: string): string {
  return `${what} "${detail}" is not supported by the bootstrap codegen yet`;
}
