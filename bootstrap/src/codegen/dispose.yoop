module codegen;

/*
  Emitting the disposals a scope owes.

  `disposable ids: Vec<NodeId> = vec.vecNew(4);` promises that `dispose` runs
  when `ids` goes out of scope, and this is where that call is written. The
  bookkeeping - which bindings, which scopes, how far to unwind - is in
  dispose_stack.yoop; this file only turns an entry into instructions.

  The call is an ordinary static trait dispatch, the same thing
  `Disposable.dispose(ref ids)` would emit if it were written by hand. That is
  the whole trick: a kind with `mustCall dispose beforeScopeEnd` names a method,
  the binding's type has that method, and the machinery for calling it already
  existed. Nothing here knows what `dispose` does.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Option } from "std/core/types.yoop";
import { ASTNode, NodeId, childAt, nodeAt } from "../ast";
import * as str from "std/core/strings.yoop";
import { lookupKind, KindInfo, nominalModuleOf, methodSymbolName, moduleIdOf,
  lookupMethod, TypeId, TYPE_ERROR_ID, PropagatedField, propagatesMustCall,
  propagatedFieldsOf, propagatedDisposeProblem } from "../typecheck";

// Record a binding that owes a disposal, if its kind asks for one.
//
// Reads the kind prefix off the declaration and asks the registry what it
// requires. A kind with no `mustCall` clause - `tainted`, `pooled` - records
// nothing, which is why this is safe to call for every prefixed binding.
export function noteDisposable(
  ref cx: Cx,
  declNode: ASTNode,
  declId: NodeId,
  slot: usize
): string {
  if (declNode.childC == 0) {
    return "";
  }
  const method = disposeMethodOf(ref cx, declNode);
  if (method.len == 0) {
    return "";
  }

  return recordDisposal(ref cx, declNode.name, slot, resolvedTypeAt(ref cx, declId), method);
}

// Push whatever `<kind> x: T` owes onto the current dispose scope: one call on
// the binding when T has the method, and one call per qualifying FIELD when T
// PROPAGATES the kind instead.
//
// Both call sites go through here - an ordinary binding and a kind region -
// because the question "what does this owe" is about the TYPE and neither of
// them should have to know that propagation exists.
export function recordDisposal(
  ref cx: Cx,
  name: string,
  slot: usize,
  ownerType: TypeId,
  method: string
): string {
  if (lookupMethod(cx.prog, ownerType, method) != TYPE_ERROR_ID) {
    disposeRecord(cx.disposes, {
      name: name,
      slot: slot,
      ownerType: ownerType,
      method: method,
      viaField: false,
      fieldIndex: 0,
      slotType: "",
      taskAction: TASK_ACTION_NONE,
    });
    return "";
  }

  // Pass D proved one of these two before codegen ever ran, so a miss here is a
  // check that was skipped rather than a program that is wrong.
  if (!propagatesMustCall(cx.prog, ownerType, method)) {
    return internalError("no such method to dispose with", method);
  }
  if (propagatedDisposeProblem(cx.prog, ownerType, method).len > 0) {
    return internalError("a propagated disposal reached codegen unusable", name);
  }

  const slotType = llvmType(cx.prog, ownerType);
  disposable fields: Vec<PropagatedField> = vec.vecNew(4);
  propagatedFieldsOf(cx.prog, ownerType, method, ref fields);
  let i: usize = 0;
  while (i < fields.len) {
    const field = vec.vecGet(ref fields, i);
    disposeRecord(cx.disposes, {
      name: name,
      slot: slot,
      ownerType: field.fieldType,
      method: method,
      viaField: true,
      fieldIndex: field.index,
      slotType: slotType,
      taskAction: TASK_ACTION_NONE,
    });
    i += 1;
  }
  return "";
}

// The `mustCall` method the declaration's kind prefixes ask for, or "".
//
// The FIRST prefix that asks wins. Stacking two kinds that both demand a
// scope-end call is not something std does, and picking one silently is better
// than emitting two calls in an order nothing specifies - pass D refuses it.
export function disposeMethodOf(ref cx: Cx, declNode: ASTNode): string {
  if (declNode.childC == 0) {
    return "";
  }
  const list = nodeAt(cx.ast, declNode.childC);
  let i: usize = 0;
  while (i < list.childCount) {
    const prefix = nodeAt(cx.ast, childAt(cx.ast, list, i));
    switch (lookupKind(cx.prog, prefix.name)) {
      case Option.Some { value: info }: {
        if (info.disposeMethod.len > 0) {
          return info.disposeMethod;
        }
      }
      case Option.None: { }
    }
    i += 1;
  }
  return "";
}

// Every disposal owed by scope `depth`, in REVERSE declaration order.
//
// Reverse because a later binding may hold a borrow of an earlier one: a `Text`
// built into an arena has to go before the arena does.
export function emitScopeDisposals(ref cx: Cx, depth: usize): string {
  if (depth >= disposeScopeDepth(cx.disposes)) {
    return "";
  }
  // NOT `disposable`. This is a SHALLOW copy that shares the scope's storage,
  // so disposing it frees a buffer the stack still owns and pops it again a
  // moment later - a double free, which aborts. Same trap a Vec read out of the
  // type arena carries; see the note in bootstrap/README.md.
  let pending: Vec<PendingDispose> = disposeScopeAt(cx.disposes, depth);
  let i: usize = pending.len;
  while (i > 0) {
    i -= 1;
    const err = emitOneDisposal(ref cx, vec.vecGet(ref pending, i));
    if (err.len > 0) {
      return err;
    }
  }
  return "";
}

// Every scope from the innermost down to `target`, innermost first. What
// `return` (target 0) and `break` (target = the loop's depth) unwind.
export function emitUnwindTo(ref cx: Cx, target: usize): string {
  let depth: usize = disposeScopeDepth(cx.disposes);
  while (depth > target) {
    depth -= 1;
    const err = emitScopeDisposals(ref cx, depth);
    if (err.len > 0) {
      return err;
    }
  }
  return "";
}

// One call:  call void @m__Vec_int32__dispose(ptr %ids.3.addr)
//
// The receiver is the binding's SLOT ADDRESS - `dispose` takes `ref self`, and
// a borrow is the address of storage that already exists.
//
// A PROPAGATED entry geps one level in first, and the field pointer is then the
// receiver in exactly the same way:
//
//   %t1 = getelementptr inbounds %struct.c__Emitter, ptr %e.1.addr, i32 0, i32 0
//   call void @text__Text__dispose(ptr %t1)
function emitOneDisposal(ref cx: Cx, entry: PendingDispose): string {
  // A task handle owes the scheduler a join or a release rather than a method
  // call - there is no method to call, since `Task<T>` is a compiler type.
  if (entry.taskAction != TASK_ACTION_NONE) {
    emitTaskCleanup(ref cx, entry);
    return "";
  }
  disposable args: Vec<CallArg> = vec.vecNew(1);
  vec.vecPush(ref args, {
    ty: "ptr",
    value: disposeReceiver(ref cx, entry),
  });
  emitCall(
    ref cx, 0, "void",
    moduleIdOf(cx.prog, nominalModuleOf(cx.prog, entry.ownerType)),
    methodSymbolName(cx.prog, entry.ownerType, entry.method),
    ref args
  );
  return "";
}

//   %t1 = getelementptr inbounds %struct.c__Emitter, ptr %e.1.addr, i32 0, i32 0
//
// What `ref self` is for one disposal: the binding's slot, or the address of
// one of its fields when the obligation was propagated to them.
function disposeReceiver(ref cx: Cx, entry: PendingDispose): Operand {
  if (!entry.viaField) {
    return Operand.SlotAddr { name: entry.name, id: entry.slot };
  }
  const fieldAddr = freshTemp(cx.e);
  emitGepField(ref cx, fieldAddr, entry.slotType, entry.name, entry.slot, entry.fieldIndex);
  return Operand.Temp { id: fieldAddr };
}

// `ephemeral arenaScope(N) { ... }` - build the subject, run the block, call.
//
// The subject gets an ANONYMOUS slot: `dispose` takes `ref self`, so it needs
// an address, and nothing in the block can name it. Recording it in the block's
// own dispose scope is what makes the call fire on every way out - the closing
// brace, a `return`, a `break` - rather than only the first.
