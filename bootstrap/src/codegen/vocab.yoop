module codegen;

// The LLVM spellings: which opcode or predicate a yoop operator lowers to, and
// the one variadic signature we know about.
//
// Separate from instr.yoop so that file stays a pure catalogue of instructions.
// Changing what `<` lowers to is a change here; changing how an icmp is
// FORMATTED is a change there.

import { TokenTags } from "../lex";

// printf is the only variadic callee the bootstrap knows about, so its type is
// spelled once here rather than at the call site.
const PRINTF_SIGNATURE: string = "i32 (ptr, ...)";

export function printfReturnType(): string {
  return "i32";
}

// The integer opcode for a binary operator, or "" when there is no lowering
// yet. Float variants arrive with the types that need them.
//
// `signed` is the OPERAND's signedness, and three operators need it:
//
//   /   sdiv vs udiv     -9 / 2 is -4 signed and an enormous number unsigned
//   %   srem vs urem     same
//   >>  ashr vs lshr     an arithmetic shift keeps the sign bit
//
// Everything else has one instruction for both. `and`, `or` and `xor` are
// bit-for-bit operations with no interpretation of the operands at all.
export function llvmIntOp(tag: TokenTags, signed: bool): string {
  switch (tag) {
    case TokenTags.PLUS: { return "add"; }
    case TokenTags.MINUS: { return "sub"; }
    case TokenTags.MULT: { return "mul"; }
    case TokenTags.DIVIDE: {
      if (signed) { return "sdiv"; }
      return "udiv";
    }
    case TokenTags.MODULUS: {
      if (signed) { return "srem"; }
      return "urem";
    }
    case TokenTags.AMP: { return "and"; }
    case TokenTags.PIPE: { return "or"; }
    case TokenTags.CARET: { return "xor"; }
    case TokenTags.LSHIFT: { return "shl"; }
    case TokenTags.RSHIFT: {
      if (signed) { return "ashr"; }
      return "lshr";
    }
    default: { return ""; }
  }
}

// The SIGNED icmp predicate for a comparison operator, or "" when the operator
// is not a comparison. Unsigned variants (`ult`, `ule`, ...) arrive with
// unsigned types.
export function llvmIntPredicate(tag: TokenTags): string {
  switch (tag) {
    case TokenTags.EQEQ: { return "eq"; }
    case TokenTags.NEQ: { return "ne"; }
    case TokenTags.LT: { return "slt"; }
    case TokenTags.GT: { return "sgt"; }
    case TokenTags.LTE: { return "sle"; }
    case TokenTags.GTE: { return "sge"; }
    default: { return ""; }
  }
}

// The conversion opcode for an integer cast, or "" when the widths already
// match and the value passes through untouched.
//
//   narrowing        -> trunc
//   widening, signed -> sext  (sign-extend, so -1 stays -1)
//   widening, other  -> zext  (zero-extend)
//
// Signedness of the SOURCE is what matters: widening a uint8 to int64 must not
// sign-extend, or 200 becomes -56.
export function llvmIntCastOp(fromBits: usize, toBits: usize, fromSigned: bool): string {
  if (toBits == fromBits) {
    return "";
  }
  if (toBits < fromBits) {
    return "trunc";
  }
  if (fromSigned) {
    return "sext";
  }
  return "zext";
}

// C default argument promotion, for a variadic call.
//
// varargs pass integers as 32- or 64-bit and floats as double, so anything
// narrower has to be widened AT THE CALL SITE. Skipping this is not a rounding
// error: printf reads a full slot, so passing an `i8` leaves the upper bits
// holding whatever was there before and the printed number is unrelated to the
// value. Returns the LLVM type to pass as.
export function promotedVarargType(bits: usize, isBool: bool): string {
  if (isBool) {
    return "i32";
  }
  if (bits >= 64) {
    return "i64";
  }
  return "i32";
}
