module codegen;

// Arrays: literals, indexing, and `.len`.
//
// An array VALUE is a `{ ptr, i64 }` descriptor - the data pointer and the
// length - passed around like any other operand. Everything here is either
// building one or taking it apart.
//
// A literal's storage is a hoisted `alloca [N x T]` and the descriptor points at
// element 0 of it. That means a literal borrows stack memory belonging to the
// enclosing FUNCTION, so returning one hands back a dangling pointer. The JS
// reference has the same property ("no copy - the array borrows the underlying
// memory"); a heap-allocating form is a separate feature.

import { ASTNode, NodeId, childAt, nodeAt } from "../ast";
import { Type, typeAt } from "../typecheck";

// `[a, b, c]` - store each element into the backing slot, then build the
// descriptor that points at it.
export function emitArrayLiteral(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  const elemTy = elementLlvmType(ref cx, exprId);
  let count: usize = 0;
  if (expr.childA != 0) {
    count = nodeAt(cx.ast, expr.childA).childCount;
  }

  const store = declareArraySlot(ref cx, elemTy, count);

  if (count > 0) {
    const list = nodeAt(cx.ast, expr.childA);
    let i: usize = 0;
    while (i < count) {
      const elemId = childAt(cx.ast, list, i);
      let value: Operand = Operand.None;
      emitExpr(ref cx, elemId, ref value)?;
      const addr = freshTemp(cx.e);
      emitGepArrayBaseAt(ref cx, addr, count, elemTy, store.id, i);
      emitStoreToPtr(ref cx, elemTy, value, addr);
      i += 1;
    }
  }

  // data pointer, then length, into a fresh descriptor.
  const dataPtr = freshTemp(cx.e);
  emitGepArrayBase(ref cx, dataPtr, count, elemTy, TEMP_SLOT_NAME, store.id);
  const withData = freshTemp(cx.e);
  emitInsertValue(ref cx, withData, "undef", "ptr", Operand.Temp { id: dataPtr }, 0);
  const withLen = freshTemp(cx.e);
  emitInsertValueTemp(ref cx, withLen, withData, "i64", Operand.Imm { value: uint64(count) }, 1);
  out = Operand.Temp { id: withLen };
  return EmitResult.Ok;
}

// `xs[i]` - step the data pointer, then load.
export function emitIndexRead(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let addr: usize = 0;
  emitElementAddress(ref cx, expr, exprId, ref addr)?;
  const elemTy = typeOf(ref cx, exprId);
  const dest = freshTemp(cx.e);
  emitLoadFromPtr(ref cx, dest, elemTy, addr);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}

// `xs[i] = v` - the same address, then store.
export function emitIndexWrite(ref cx: Cx, target: ASTNode, targetId: NodeId, value: Operand): EmitResult {
  let addr: usize = 0;
  emitElementAddress(ref cx, target, targetId, ref addr)?;
  emitStoreToPtr(ref cx, typeOf(ref cx, targetId), value, addr);
  return EmitResult.Ok;
}

// `xs.ptr` - field 0 of the descriptor, the data pointer.
export function emitArrayPtr(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let base: Operand = Operand.None;
  emitExprValue(ref cx, expr.childA, ref base)?;
  const dest = freshTemp(cx.e);
  emitExtractValue(ref cx, dest, ARRAY_DESCRIPTOR, base, 0);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}

// `xs.len` - field 1 of the descriptor.
export function emitArrayLen(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let base: Operand = Operand.None;
  emitExprValue(ref cx, expr.childA, ref base)?;
  const dest = freshTemp(cx.e);
  emitExtractValue(ref cx, dest, ARRAY_DESCRIPTOR, base, 1);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}

// The address of `xs[i]`, shared by the read and the write so the two cannot
// disagree about how an element is located.
export function emitElementAddress(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref addr: usize): EmitResult {
  let base: Operand = Operand.None;
  emitExprValue(ref cx, expr.childA, ref base)?;
  let index: Operand = Operand.None;
  emitExpr(ref cx, expr.childB, ref index)?;

  const dataPtr = freshTemp(cx.e);
  emitExtractValue(ref cx, dataPtr, ARRAY_DESCRIPTOR, base, 0);
  const elemAddr = freshTemp(cx.e);
  emitGepElem(
    ref cx, elemAddr, typeOf(ref cx, exprId),
    Operand.Temp { id: dataPtr },
    typeOf(ref cx, expr.childB), index
  );
  addr = elemAddr;
  return EmitResult.Ok;
}

// The LLVM element type of an array-typed node.
function elementLlvmType(ref cx: Cx, exprId: NodeId): string {
  // resolvedTypeAt, not the raw table: inside a monomorphization the recorded
  // type is still `T[]`, and the element has to be substituted before it can be
  // an LLVM type at all.
  const arrayType = resolvedTypeAt(ref cx, exprId);
  switch (typeAt(cx.prog, arrayType)) {
    case Type.Array { elem: e }: { return llvmType(cx.prog, e); }
    default: { return "i8"; }
  }
}

// `xs[a..b]` - a borrowing view, no copy.
//
//   %data = extractvalue { ptr, i64 } %xs, 0
//   %base = getelementptr i32, ptr %data, i64 %a
//   %len  = sub i64 %b, %a
//
// The same three instructions the `arraySlice` intrinsic emits, because it is
// the same operation - this is the syntax for it. An omitted start is 0 and an
// omitted end is the base's own length, which is the one thing the syntax
// cannot say and codegen already has.
export function emitSlice(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let base: Operand = Operand.None;
  emitExprValue(ref cx, expr.childA, ref base)?;
  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, base, 0);

  let start: Operand = Operand.Imm { value: 0 };
  if (expr.childB != 0) {
    emitExpr(ref cx, expr.childB, ref start)?;
  }

  let end: Operand = Operand.None;
  if (expr.childC != 0) {
    emitExpr(ref cx, expr.childC, ref end)?;
  } else {
    const len = freshTemp(cx.e);
    emitExtractValue(ref cx, len, ARRAY_DESCRIPTOR, base, 1);
    end = Operand.Temp { id: len };
  }

  const elemTy = elementLlvmType(ref cx, exprId);
  const at = freshTemp(cx.e);
  emitGepElem(ref cx, at, elemTy, Operand.Temp { id: data }, "i64", start);
  const count = freshTemp(cx.e);
  emitBinOp(ref cx, count, "sub", "i64", end, start);

  const withData = freshTemp(cx.e);
  emitInsertValue(ref cx, withData, "undef", "ptr", Operand.Temp { id: at }, 0);
  const withLen = freshTemp(cx.e);
  emitInsertValueTemp(ref cx, withLen, withData, "i64", Operand.Temp { id: count }, 1);
  out = Operand.Temp { id: withLen };
  return EmitResult.Ok;
}

// `s.len` on a STRING - one strlen.
//
//   %t1 = call i64 @strlen(ptr %t0)
//
// A string is a NUL-terminated pointer with no length beside it, so unlike an
// array's `.len` there is no field to project - the length has to be measured.
export function emitStringLen(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let base: Operand = Operand.None;
  emitExprValue(ref cx, expr.childA, ref base)?;
  cx.e.usesStringBuilder = true;
  const dest = freshTemp(cx.e);
  emitStrlen(ref cx, dest, base);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}
