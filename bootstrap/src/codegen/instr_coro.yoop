module codegen;

// The instruction catalogue for LLVM SWITCHED-RESUME COROUTINES - the lowering
// an `async` function gets. Same house rules as instr.yoop, which documents
// them: one function per instruction, named for the instruction, with a sample
// of its output.
//
// Every one of these is a call to an `llvm.coro.*` intrinsic. They are
// intrinsics rather than real functions, which has two consequences the rest of
// the coroutine machinery is shaped by: they can only appear INSIDE the
// coroutine that owns the frame (so the runtime cannot call them, hence the
// trampolines in coro.yoop), and the frame layout is LLVM's business and never
// spelled here.
//
// The four PROLOGUE emitters append to the HEADER buffer rather than the
// instruction stream, because `coro.begin` has to dominate every alloca and the
// bootstrap hoists allocas to the top of `entry:`. See coro.yoop.

import { Text }, * as text from "std/core/text.yoop";

//   %t1 = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)
//
// Opens a coroutine. The token identifies this frame to `begin`, `free` and
// `end`; the three null pointers are the alignment/promise/coroaddr arguments,
// which a switched-resume coroutine with no promise does not use.
export function emitCoroId(ref cx: Cx, dest: usize): void {
  headerTempAssign(ref cx, dest);
  headerPart(ref cx, "call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)");
  headerEnd(ref cx);
}

//   %t2 = call i64 @llvm.coro.size.i64()
//
// How many bytes this coroutine's frame needs. Not a constant here - the coro
// passes replace it once they know which locals had to be spilled.
export function emitCoroSize(ref cx: Cx, dest: usize): void {
  headerTempAssign(ref cx, dest);
  headerPart(ref cx, "call i64 @llvm.coro.size.i64()");
  headerEnd(ref cx);
}

//   %t3 = call ptr @malloc(i64 %t2)
//
// The frame's storage. Raw malloc rather than the allocator context, matching
// the reference: `coro.free` hands back this exact pointer at the cleanup edge
// and the pairing has to be with plain free.
export function emitCoroFrameAlloc(ref cx: Cx, dest: usize, sizeTemp: usize): void {
  headerTempAssign(ref cx, dest);
  headerPart(ref cx, "call ptr @malloc(i64 ");
  headerTemp(ref cx, sizeTemp);
  headerPart(ref cx, ")");
  headerEnd(ref cx);
}

//   %t4 = call ptr @llvm.coro.begin(token %t1, ptr %t3)
//
// Binds the storage to the token and yields the HANDLE - the value this
// function returns, and the one a caller drives with resume / done / destroy.
export function emitCoroBegin(ref cx: Cx, dest: usize, idTemp: usize, memTemp: usize): void {
  headerTempAssign(ref cx, dest);
  headerPart(ref cx, "call ptr @llvm.coro.begin(token ");
  headerTemp(ref cx, idTemp);
  headerPart(ref cx, ", ptr ");
  headerTemp(ref cx, memTemp);
  headerPart(ref cx, ")");
  headerEnd(ref cx);
}

//   %t9 = call i8 @llvm.coro.suspend(token none, i1 true)
//
// THE suspend point. Control leaves the function here and the handle goes back
// to whoever called it; the i8 result says how it was re-entered, and the
// caller of this emitter always follows it with the three-way switch below.
//
// `isFinal` marks the LAST suspend - the one `coro.done` reports true for. A
// final suspend can only be destroyed, never resumed, which is what makes
// "done" and "the result slot is filled" the same fact.
export function emitCoroSuspend(ref cx: Cx, dest: usize, isFinal: bool): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call i8 @llvm.coro.suspend(token none, i1 ");
  if (isFinal) {
    part(ref cx, "true");
  } else {
    part(ref cx, "false");
  }
  part(ref cx, ")");
  endInstr(ref cx);
}

//   switch i8 %t9, label %L7 [
//     i8 0, label %L6
//     i8 1, label %L6
//   ]
//
// The three edges out of a suspend, and the reason `coro.suspend` is never a
// plain instruction: `default` is "stay suspended" (return the handle), 0 is
// "resumed", 1 is "destroyed". Both of the last two go to the CLEANUP block
// after a final suspend, because a finished coroutine has nothing left to run.
export function emitCoroSuspendSwitch(
  ref cx: Cx,
  suspendTemp: usize,
  stayLabel: usize,
  resumeLabel: usize,
  destroyLabel: usize
): void {
  emitSwitchOpen(ref cx, "i8", Operand.Temp { id: suspendTemp }, stayLabel);
  emitSwitchCase(ref cx, "i8", Operand.Imm { value: 0 }, resumeLabel);
  emitSwitchCase(ref cx, "i8", Operand.Imm { value: 1 }, destroyLabel);
  emitSwitchClose(ref cx);
}

//   %t10 = call ptr @llvm.coro.free(token %t1, ptr %t4)
//
// The frame's storage back, for the `free` that follows. Answers null when the
// coro passes elided the allocation, which is why the free is guarded by LLVM
// rather than by us - `free(null)` is defined.
export function emitCoroFree(ref cx: Cx, dest: usize, idTemp: usize, hdlTemp: usize): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call ptr @llvm.coro.free(token ");
  temp(ref cx, idTemp);
  part(ref cx, ", ptr ");
  temp(ref cx, hdlTemp);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call void @free(ptr %t10)
export function emitFreeCall(ref cx: Cx, ptrTemp: usize): void {
  startInstr(ref cx);
  part(ref cx, "call void @free(ptr ");
  temp(ref cx, ptrTemp);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call i1 @llvm.coro.end(ptr %t4, i1 false)
//
// Marks the end of the coroutine body. The result is deliberately DISCARDED
// rather than bound to a temp: `llvm.coro.end` changed from `i1 (ptr, i1)` to
// `void (ptr, i1, token)` in LLVM 19/20, and newer LLVM auto-upgrades the old
// spelling on read - but only cleanly when nothing names the result. With a
// `%tN =` in front the upgrade rewrites the call to void and leaves the
// assignment dangling, and the module fails verification. Discarding is legal
// in both worlds, so this one line is right against every LLVM the project
// supports with no version detection. Same reasoning, and the same line, as the
// reference.
export function emitCoroEnd(ref cx: Cx, hdlTemp: usize): void {
  startInstr(ref cx);
  part(ref cx, "call i1 @llvm.coro.end(ptr ");
  temp(ref cx, hdlTemp);
  part(ref cx, ", i1 false)");
  endInstr(ref cx);
}

//   %t12 = call i1 @llvm.coro.done(ptr %t11)
//
// True once the coroutine named by the handle is parked at its FINAL suspend -
// which is to say, its result slot is filled and there is nothing left to
// resume.
export function emitCoroDone(ref cx: Cx, dest: usize, hdl: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call i1 @llvm.coro.done(ptr ");
  operand(ref cx, hdl);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call void @llvm.coro.resume(ptr %t11)
//
// Runs the coroutine from where it parked until its next suspend point.
export function emitCoroResume(ref cx: Cx, hdl: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call void @llvm.coro.resume(ptr ");
  operand(ref cx, hdl);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call void @llvm.coro.destroy(ptr %t11)
//
// Releases the frame. Always AFTER the result has been read out of the caller's
// slot - the slot is the caller's, but the frame is not.
export function emitCoroDestroy(ref cx: Cx, hdl: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call void @llvm.coro.destroy(ptr ");
  operand(ref cx, hdl);
  part(ref cx, ")");
  endInstr(ref cx);
}

// ----- header-buffer appenders --------------------------------------------
//
// The four prologue emitters above write here rather than into the instruction
// stream. `flushFunction` lays a function out as header, then hoisted allocas,
// then instructions - so an instruction that must precede every alloca has
// exactly one place to go.

//   `  %t1 = `
function headerTempAssign(ref cx: Cx, dest: usize): void {
  headerPart(ref cx, "  ");
  headerTemp(ref cx, dest);
  headerPart(ref cx, " = ");
}

//   `%t1`
export function headerTemp(ref cx: Cx, id: usize): void {
  text.push(ref cx.e.body, "%t");
  text.pushUint(ref cx.e.body, uint64(id));
}
