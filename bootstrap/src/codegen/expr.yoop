module codegen;

// Expressions: AST node -> an Operand the caller can hand to an instruction.
//
// Every function here answers "what value does this expression produce", emits
// whatever instructions are needed to get there, and writes the result into
// `out`. The IR text itself is instr.yoop's job - nothing in this file appends
// characters.
//
// Return convention: `EmitResult` - Ok, or the internal error that stopped it.
// Reaching one means typecheck let something through, not that the user did
// something wrong.

import * as vec from "std/core/vec.yoop";
import * as map from "std/collections/map.yoop";
import { primIsSigned } from "../typecheck";
import * as text from "std/core/text.yoop";
import { Option } from "std/core/types.yoop";
import { ASTNode, ASTNodeKind, NodeId, nodeAt, kindName } from "../ast";
import { TokenTags, tagName } from "../lex";

// The one entry point. Everything an expression needs is decided by the switch
// below EXCEPT one thing: whether a `ref T` in this position is being handed on
// as a borrow or used as the value it borrows. That is a question about the
// CONTEXT, so pass D answered it and recorded the node; here it costs one load.
// See borrow.yoop.
export function emitExpr(ref cx: Cx, exprId: NodeId, ref out: Operand): EmitResult {
  // A `ref` PARAMETER handed on as a borrow. Answered ahead of the walk rather
  // than after it, because the walk would emit a load of the borrowed object
  // and the whole point is that there is no instruction here at all.
  if (map.mapContainsKey(ref cx.tm.reborrowUses, uint64(exprId))) {
    return emitForwardBorrow(ref cx, exprId, ref out);
  }
  emitExprInner(ref cx, exprId, ref out)?;
  if (map.mapContainsKey(ref cx.tm.derefUses, uint64(exprId))) {
    // The node's own type is already the OPENED one - pass D rewrote it when it
    // recorded the use - so it is what the load reads.
    emitOpenBorrow(ref cx, typeOf(ref cx, exprId), ref out);
  }
  return EmitResult.Ok;
}

function emitExprInner(ref cx: Cx, exprId: NodeId, ref out: Operand): EmitResult {
  const expr = nodeAt(cx.ast, exprId);
  switch (expr.kind) {
    case ASTNodeKind.INT_LITERAL: {
      // An immediate: no instruction, the value IS the operand.
      out = Operand.Imm { value: expr.intVal };
      return EmitResult.Ok;
    }
    // Also an immediate, but WHICH immediate depends on the type pass D pinned
    // it to: a float32 constant is the bits of the value after rounding to
    // float precision, and a float64 constant is the bits as decoded.
    case ASTNodeKind.FLOAT_LITERAL: {
      out = floatImmFor(ref cx, exprId, expr.floatVal);
      return EmitResult.Ok;
    }
    case ASTNodeKind.STRING_LITERAL: {
      // A module-level constant, referenced by name.
      out = Operand.StrRef {
        id: internStringConstant(cx.e, vec.vecGet(ref cx.ast.strings, expr.strId))
      };
      return EmitResult.Ok;
    }
    case ASTNodeKind.TEMPLATE_LITERAL: {
      return emitTemplateLiteral(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.SLICE_EXPRESSION: {
      return emitSlice(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.NULL_LITERAL: {
      out = Operand.Null;
      return EmitResult.Ok;
    }
    case ASTNodeKind.BOOL_LITERAL: {
      // i1 immediates are spelled `true` / `false`, which Operand.Bool writes.
      out = Operand.Bool { value: expr.intVal != 0 };
      return EmitResult.Ok;
    }
    case ASTNodeKind.UNARY_EXPRESSION: {
      return emitUnary(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.ARRAY_LITERAL: {
      return emitArrayLiteral(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.INDEX_EXPRESSION: {
      return emitIndexRead(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.STRUCT_LITERAL: {
      // A union literal is the same NODE - pass D decided which by the target
      // type. It fills one field at offset 0 rather than one gep per field.
      if (isUnionAt(ref cx, exprId)) {
        return emitUnionLiteral(ref cx, expr, exprId, ref out);
      }
      return emitStructLiteral(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.VARIANT_CONSTRUCTOR: {
      return emitVariantConstructor(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.FIELD_ACCESS: {
      // Six things wear this shape, and pass D already decided which: an ENUM
      // CASE (`Color.Red`), a payload-less variant constructor (`Shape.Empty`,
      // typed as the VARIANT), a struct field, a UNION field, a STRING's `.len`,
      // or an array's `.len`.
      //
      // The enum test is on the BASE and not on the whole expression, because
      // `p.c` on a struct with a `Color` field resolves to the same enum type.
      // Pass D decorated the base with the enum only for a case access, and an
      // enum has no fields, so a base that is one is never anything else.
      if (isValueEnumAt(ref cx, expr.childA)) {
        out = enumCaseOperand(ref cx, expr.childA, exprId);
        return EmitResult.Ok;
      }
      // A UNION base, and the two aggregate answers have nothing in common: a
      // struct read is an extractvalue on the loaded aggregate, a union read is
      // a load at the union's own ADDRESS spelled at the field's type, because
      // a union's loaded value is a byte buffer with nothing to extract. See
      // union.yoop.
      if (isUnionAt(ref cx, expr.childA)) {
        return emitUnionFieldRead(ref cx, expr, exprId, ref out);
      }
      // The STRUCT test comes before the variant one, and it has to. A field
      // whose own type is a variant - `CallArg { ty: string, value: Operand }` -
      // makes `a.value` an expression of variant type, which is exactly what a
      // payload-less constructor looks like from here. The base is what tells
      // them apart: `Shape.Empty`'s base is a TYPE NAME and was never checked as
      // a value, so it carries no resolved type at all, while `a.value`'s base
      // is a struct. Reading the whole expression instead compiled `a.value` as
      // `Operand.<case 0>` - a fresh tag and an unwritten payload - which is a
      // SILENT miscompile, not an error. It cost the self-compile its third
      // stage; see `field_variant.yoop` in the slice fixtures.
      if (isStructAt(ref cx, expr.childA)) {
        return emitStructFieldRead(ref cx, expr, ref out);
      }
      if (isVariantAt(ref cx, exprId)) {
        return emitVariantConstructor(ref cx, expr, exprId, ref out);
      }
      if (isStringAt(ref cx, expr.childA)) {
        return emitStringLen(ref cx, expr, ref out);
      }
      if (text.equals(expr.name, "ptr")) {
        return emitArrayPtr(ref cx, expr, ref out);
      }
      return emitArrayLen(ref cx, expr, ref out);
    }
    case ASTNodeKind.IDENT: {
      return emitLocalRead(ref cx, expr, ref out);
    }
    // `&x` and `ref x` lower identically - both are the address of x's slot.
    // What differs is the TYPE, which pass D decided, and therefore what the
    // language lets you do with the result.
    case ASTNodeKind.DEREF_EXPRESSION: {
      return emitDeref(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.REF_EXPRESSION, ASTNodeKind.ADDRESS_OF_EXPRESSION: {
      return emitRefExpr(ref cx, expr, expr.childA, ref out);
    }
    case ASTNodeKind.UNSAFE_PTR_CAST: {
      return emitUnsafePtrOp(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.ASSIGNMENT: {
      return emitAssignment(ref cx, expr, ref out);
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return emitBinaryExpr(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.CALL_EXPRESSION: {
      return emitCallExpr(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.TRY_OP: {
      return emitTryOp(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.AWAIT_EXPRESSION: {
      return emitAwait(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.WAIT_EXPRESSION: {
      return emitWait(ref cx, expr, exprId, ref out);
    }
    default: {
      return internalError("codegen cannot emit expression", kindName(expr.kind));
    }
  }
}

// Reading a local or parameter means loading from its stack slot.
function emitLocalRead(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  switch (lookupLocal(cx.locals, expr.name)) {
    case Option.None: {
      // Not a local, so it is a module-level `const` - pass D already refused
      // anything else. A const is INLINED rather than loaded: there is no
      // global to read from, which is what makes an imported one cost nothing.
      if (moduleConstOf(ref cx, expr.name, ref out)) {
        return EmitResult.Ok;
      }
      // Or a module-level `let` - a real global, so this is a LOAD rather than
      // the inlining a const gets.
      const globalTy = moduleGlobalTypeOf(ref cx, expr.name);
      if (globalTy.len > 0) {
        const dest = freshTemp(cx.e);
        const sym = globalSymbol(ref cx, expr.name);
        emitLoadGlobal(ref cx, dest, globalTy, sym.home, sym.name);
        out = Operand.Temp { id: dest };
        return EmitResult.Ok;
      }
      // Or a FUNCTION named without being called - `{ hash: stringHash }`.
      // Its value is its symbol, resolved through the same table a call goes
      // through so an imported one lands on the defining module's name.
      if (isModuleFunction(ref cx, expr.name)) {
        // NodeId 0 is safe here: calleeSymbol only reads it to look for a
        // generic instance or a trait receiver, and a bare name is neither.
        const sym = calleeSymbol(ref cx, expr, 0);
        out = Operand.FuncRef { home: sym.home, name: sym.name };
        return EmitResult.Ok;
      }
      return internalError("no stack slot for", expr.name);
    }
    case Option.Some { value: slotInfo }: {
      const dest = freshTemp(cx.e);
      emitLoad(ref cx, dest, slotInfo.ty, expr.name, slotInfo.id);
      out = Operand.Temp { id: dest };
      return EmitResult.Ok;
    }
  }
}

// `ref x` - the ADDRESS of x's slot, with no instruction at all.
//
// Every local already lives in an alloca and every `ref` parameter already IS a
// pointer, so a borrow is a name for storage that exists rather than anything
// that has to be built. Pass D refused any target but a plain name, which is
// what makes the lookup below total.
function emitRefExpr(ref cx: Cx, expr: ASTNode, targetId: NodeId, ref out: Operand): EmitResult {
  const target = nodeAt(cx.ast, targetId);

  // `ref fp` where `fp` is ALREADY a `ref T` - a RE-borrow. The slot holds the
  // borrowed ADDRESS, so the borrow is what is IN the slot rather than the
  // slot's own address: one load, and `ref ref T` never exists. Pass D typed it
  // that way; this is the instruction half. A `ref` PARAMETER does not come
  // here, because the body sees its type already unwrapped to `T`.
  if (isRefAt(ref cx, targetId)) {
    emitRefBase(ref cx, target, targetId, ref out)?;
    emitOpenBorrow(ref cx, REF_LLVM_TYPE, ref out);
    return EmitResult.Ok;
  }
  return emitRefBase(ref cx, target, targetId, ref out);
}

// The ADDRESS `ref` names, for each of the three things that has one.
function emitRefBase(ref cx: Cx, target: ASTNode, targetId: NodeId, ref out: Operand): EmitResult {

  // `ref x.f` - the FIELD's address, which is a gep on the base's slot rather
  // than the slot itself. Same address a field assignment stores through, so
  // the two cannot disagree about where a field lives.
  if (target.kind == ASTNodeKind.FIELD_ACCESS) {
    let addr: usize = 0;
    emitFieldAddress(ref cx, target, ref addr)?;
    out = Operand.Temp { id: addr };
    return EmitResult.Ok;
  }

  // `ref xs[i]` - the ELEMENT's address, the same gep an element write stores
  // through. This is why the target's NodeId is threaded in rather than read
  // off `expr.childA`: locating an element needs the node's own resolved type,
  // which is how the element width is known inside a monomorphization.
  if (target.kind == ASTNodeKind.INDEX_EXPRESSION) {
    let addr: usize = 0;
    emitElementAddress(ref cx, target, targetId, ref addr)?;
    out = Operand.Temp { id: addr };
    return EmitResult.Ok;
  }

  switch (lookupLocal(cx.locals, target.name)) {
    case Option.None: {
      // `ref counter` on a module-level `let` - a global, which already IS
      // storage, so its address is its symbol and there is nothing to emit.
      // The same fall-through a READ and a WRITE of one already take; a borrow
      // is the third position that has to know a name can live outside the
      // frame. A module-level `const` never reaches here: pass D refuses `ref`
      // on one, because an inlined value has no address to hand out.
      const globalTy = moduleGlobalTypeOf(ref cx, target.name);
      if (globalTy.len > 0) {
        const sym = globalSymbol(ref cx, target.name);
        out = Operand.GlobalAddr { home: sym.home, name: sym.name };
        return EmitResult.Ok;
      }
      return internalError("no stack slot to borrow", target.name);
    }
    case Option.Some { value: slotInfo }: {
      out = Operand.SlotAddr { name: target.name, id: slotInfo.id };
      return EmitResult.Ok;
    }
  }
}

// `x = expr` stores into x's existing slot. It produces no value: pass D types
// it as void, so nothing downstream asks for one.
function emitAssignment(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  const target = nodeAt(cx.ast, expr.childA);
  let value: Operand = Operand.None;
  emitExpr(ref cx, expr.childB, ref value)?;
  if (target.kind == ASTNodeKind.FIELD_ACCESS) {
    out = Operand.None;
    return emitStructFieldWrite(ref cx, target, expr.childA, value);
  }
  if (target.kind == ASTNodeKind.INDEX_EXPRESSION) {
    out = Operand.None;
    return emitIndexWrite(ref cx, target, expr.childA, value);
  }
  // `*p = v` - store THROUGH the pointer. The address is the pointer's own
  // value, so there is nothing to compute but the pointer itself.
  if (target.kind == ASTNodeKind.DEREF_EXPRESSION) {
    let ptr: Operand = Operand.None;
    emitExpr(ref cx, target.childA, ref ptr)?;
    emitStoreToAddr(ref cx, typeOf(ref cx, expr.childA), value, ptr);
    out = Operand.None;
    return EmitResult.Ok;
  }
  switch (lookupLocal(cx.locals, target.name)) {
    case Option.None: {
      // A module-level `let`. Pass D already refused a const here, so a name
      // that is not a local and not a global is a compiler bug.
      const globalTy = moduleGlobalTypeOf(ref cx, target.name);
      if (globalTy.len > 0) {
        const sym = globalSymbol(ref cx, target.name);
        emitStoreGlobal(ref cx, globalTy, value, sym.home, sym.name);
        out = Operand.None;
        return EmitResult.Ok;
      }
      return internalError("no stack slot for assignment target", target.name);
    }
    case Option.Some { value: slotInfo }: {
      emitStore(ref cx, slotInfo.ty, value, target.name, slotInfo.id);
      out = Operand.None;
      return EmitResult.Ok;
    }
  }
}

// `!x` is an i1 xor; `~x` is an xor with all ones at the operand's width; `-x`
// is `0 - x`, which reuses the ordinary subtract.
function emitUnary(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let value: Operand = Operand.None;
  emitExpr(ref cx, expr.childA, ref value)?;
  const dest = freshTemp(cx.e);
  if (expr.operator == TokenTags.BANG) {
    emitNot(ref cx, dest, value);
  } else if (expr.operator == TokenTags.TILDE) {
    // `xor %x, -1`, at the operand's own width. -1 is all ones in two's
    // complement at every width, so one spelling covers signed and unsigned
    // alike and there is no separate "complement" instruction to reach for.
    // Same lowering the reference emits.
    emitBinOp(ref cx, dest, "xor", typeOf(ref cx, exprId), value, Operand.NegImm { value: 1 });
  } else if (isFloatAt(ref cx, exprId)) {
    // `fneg`, not `0.0 - x`. The two differ on a zero: `0.0 - 0.0` is +0.0
    // while `fneg 0.0` is -0.0, and the reference emits fneg.
    emitFNeg(ref cx, dest, typeOf(ref cx, exprId), value);
  } else {
    emitBinOp(ref cx, dest, "sub", typeOf(ref cx, exprId), Operand.Imm { value: 0 }, value);
  }
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}

// Both sides first, then one arithmetic instruction over the results.
function emitBinaryExpr(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  // `&&` and `||` must NOT evaluate both sides, so they are branching, not a
  // single instruction - see emitShortCircuit in flow.yoop.
  if (expr.operator == TokenTags.ANDAND || expr.operator == TokenTags.OROR) {
    return emitShortCircuit(ref cx, expr, ref out);
  }

  // POINTER ARITHMETIC steps by ELEMENTS rather than by the operand's own
  // width, so it is a gep (or a division) rather than an `add`. Comparison is
  // NOT here: `p == null` is an ordinary icmp over two pointers.
  if ((expr.operator == TokenTags.PLUS || expr.operator == TokenTags.MINUS) &&
      (isUnsafePtrAt(ref cx, expr.childA) || isUnsafePtrAt(ref cx, expr.childB))) {
    return emitPointerArith(ref cx, expr, exprId, ref out);
  }

  let lhs: Operand = Operand.None;
  emitExpr(ref cx, expr.childA, ref lhs)?;

  let rhs: Operand = Operand.None;
  emitExpr(ref cx, expr.childB, ref rhs)?;

  // `a == b` on two VARIANTS is a TAG comparison. An `icmp` on the aggregate
  // itself is invalid IR rather than a wrong answer, which is how this stayed
  // hidden: the compile succeeds and clang refuses what it produced. Comparing
  // tags only is the documented semantics and the reference's - two `Circle`s
  // with different radii are equal, and a structural comparison is what
  // `switch` is for.
  if ((expr.operator == TokenTags.EQEQ || expr.operator == TokenTags.NEQ) &&
      isVariantAt(ref cx, expr.childA) && isVariantAt(ref cx, expr.childB)) {
    const variantTy = typeOf(ref cx, expr.childA);
    const leftTag = emitVariantTag(ref cx, variantTy, lhs);
    const rightTag = emitVariantTag(ref cx, variantTy, rhs);
    const tagCmp = freshTemp(cx.e);
    let pred = "eq";
    if (expr.operator == TokenTags.NEQ) {
      pred = "ne";
    }
    emitICmp(ref cx, tagCmp, pred, VARIANT_TAG_TYPE,
      Operand.Temp { id: leftTag }, Operand.Temp { id: rightTag });
    out = Operand.Temp { id: tagCmp };
    return EmitResult.Ok;
  }

  // A comparison is a compare over the OPERAND type and yields i1; arithmetic
  // is one instruction over the result type. `typeOf(exprId)` is bool for a
  // comparison, which is why the operand type is read off the left side.
  //
  // The whole float/int fork is decided by the OPERANDS too, and it has to be:
  // a float comparison's result type is `i1` just like an integer one's, so
  // asking the result would pick icmp for `a < b` on two doubles.
  const floats = isFloatAt(ref cx, expr.childA);
  const dest = freshTemp(cx.e);

  // Signedness comes from the OPERAND, not the result - a comparison's result
  // is `i1` either way, so asking the node's own type would pick `slt` for
  // every unsigned compare in the program.
  const pred = llvmIntPredicate(expr.operator,
    primIsSigned(cx.prog, resolvedTypeAt(ref cx, expr.childA)));
  if (pred.len > 0) {
    if (floats) {
      emitFCmp(ref cx, dest, llvmFloatPredicate(expr.operator),
               typeOf(ref cx, expr.childA), lhs, rhs);
    } else {
      emitICmp(ref cx, dest, pred, typeOf(ref cx, expr.childA), lhs, rhs);
    }
    out = Operand.Temp { id: dest };
    return EmitResult.Ok;
  }

  // Signedness comes from the OPERANDS, not the result: a comparison already
  // returned above, so the result type here is the operand type anyway - but
  // reading the left side is what stays correct if that ever changes.
  let op = llvmFloatOp(expr.operator);
  if (!floats) {
    op = llvmIntOp(expr.operator, primIsSigned(cx.prog, resolvedTypeAt(ref cx, expr.childA)));
  }
  if (op.len == 0) {
    return internalError("codegen cannot emit operator", tagName(expr.operator));
  }
  emitBinOp(ref cx, dest, op, typeOf(ref cx, exprId), lhs, rhs);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}

// `*p` - one load from the address the pointer holds.
//
//   %t2 = load i32, ptr %t1
//
// The pointer is already a value, so there is nothing to compute first: an
// opaque `ptr` in LLVM plus the pointee type pass D resolved is the whole
// instruction.
function emitDeref(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let ptr: Operand = Operand.None;
  emitExpr(ref cx, expr.childA, ref ptr)?;
  const dest = freshTemp(cx.e);
  emitLoadFromAddr(ref cx, dest, typeOf(ref cx, exprId), ptr);
  out = Operand.Temp { id: dest };
  return EmitResult.Ok;
}
