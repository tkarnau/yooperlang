module codegen;

// Expressions: AST node -> an Operand the caller can hand to an instruction.
//
// Every function here answers "what value does this expression produce", emits
// whatever instructions are needed to get there, and writes the result into
// `out`. The IR text itself is instr.yoop's job - nothing in this file appends
// characters.
//
// Return convention: "" on success, otherwise an internal-error message.
// Reaching one means typecheck let something through, not that the user did
// something wrong.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Option } from "std/core/types.yoop";
import { ASTNode, ASTNodeKind, NodeId, childAt, nodeAt, kindName } from "../ast";
import { TokenTags, tagName } from "../lex";

export function emitExpr(ref cx: Cx, exprId: NodeId, ref out: Operand): string {
  const expr = nodeAt(cx.ast, exprId);
  switch (expr.kind) {
    case ASTNodeKind.INT_LITERAL: {
      // An immediate: no instruction, the value IS the operand.
      out = Operand.Imm { value: expr.intVal };
      return "";
    }
    case ASTNodeKind.STRING_LITERAL: {
      // A module-level constant, referenced by name.
      out = Operand.StrRef {
        id: internStringConstant(cx.e, vec.vecGet(ref cx.ast.strings, expr.strId))
      };
      return "";
    }
    case ASTNodeKind.BOOL_LITERAL: {
      // i1 immediates are spelled `true` / `false`, which Operand.Bool writes.
      out = Operand.Bool { value: expr.intVal != 0 };
      return "";
    }
    case ASTNodeKind.UNARY_EXPRESSION: {
      return emitUnary(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.ARRAY_LITERAL: {
      return emitArrayLiteral(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.INDEX_EXPRESSION: {
      return emitIndexRead(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.STRUCT_LITERAL: {
      return emitStructLiteral(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.VARIANT_CONSTRUCTOR: {
      return emitVariantConstructor(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.FIELD_ACCESS: {
      // Three things wear this shape, and pass D already decided which: a
      // payload-less variant constructor (`Shape.Empty`, typed as the VARIANT),
      // a struct field, or an array's `.len`.
      if (isVariantAt(ref cx, exprId)) {
        return emitVariantConstructor(ref cx, expr, exprId, ref out);
      }
      if (isStructAt(ref cx, expr.childA)) {
        return emitStructFieldRead(ref cx, expr, ref out);
      }
      return emitArrayLen(ref cx, expr, ref out);
    }
    case ASTNodeKind.IDENT: {
      return emitLocalRead(ref cx, expr, ref out);
    }
    case ASTNodeKind.ASSIGNMENT: {
      return emitAssignment(ref cx, expr, ref out);
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return emitBinaryExpr(ref cx, expr, exprId, ref out);
    }
    case ASTNodeKind.CALL_EXPRESSION: {
      return emitCallExpr(ref cx, expr, exprId, ref out);
    }
    default: {
      return internalError("codegen cannot emit expression", kindName(expr.kind));
    }
  }
}

// Reading a local or parameter means loading from its stack slot.
function emitLocalRead(ref cx: Cx, expr: ASTNode, ref out: Operand): string {
  switch (lookupLocal(cx.locals, expr.name)) {
    case Option.None: {
      return internalError("no stack slot for", expr.name);
    }
    case Option.Some { value: slotInfo }: {
      const dest = freshTemp(cx.e);
      emitLoad(ref cx, dest, slotInfo.ty, expr.name, slotInfo.id);
      out = Operand.Temp { id: dest };
      return "";
    }
  }
}

// `x = expr` stores into x's existing slot. It produces no value: pass D types
// it as void, so nothing downstream asks for one.
function emitAssignment(ref cx: Cx, expr: ASTNode, ref out: Operand): string {
  const target = nodeAt(cx.ast, expr.childA);
  let value: Operand = Operand.None;
  const err = emitExpr(ref cx, expr.childB, ref value);
  if (err.len > 0) {
    return err;
  }
  if (target.kind == ASTNodeKind.FIELD_ACCESS) {
    out = Operand.None;
    return emitStructFieldWrite(ref cx, target, expr.childA, value);
  }
  if (target.kind == ASTNodeKind.INDEX_EXPRESSION) {
    out = Operand.None;
    return emitIndexWrite(ref cx, target, expr.childA, value);
  }
  switch (lookupLocal(cx.locals, target.name)) {
    case Option.None: {
      return internalError("no stack slot for assignment target", target.name);
    }
    case Option.Some { value: slotInfo }: {
      emitStore(ref cx, slotInfo.ty, value, target.name, slotInfo.id);
      out = Operand.None;
      return "";
    }
  }
}

// `!x` is an i1 xor; `-x` is `0 - x`, which reuses the ordinary subtract.
function emitUnary(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): string {
  let value: Operand = Operand.None;
  const err = emitExpr(ref cx, expr.childA, ref value);
  if (err.len > 0) {
    return err;
  }
  const dest = freshTemp(cx.e);
  if (expr.operator == TokenTags.BANG) {
    emitNot(ref cx, dest, value);
  } else {
    emitBinOp(ref cx, dest, "sub", typeOf(ref cx, exprId), Operand.Imm { value: 0 }, value);
  }
  out = Operand.Temp { id: dest };
  return "";
}

// Both sides first, then one arithmetic instruction over the results.
function emitBinaryExpr(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): string {
  // `&&` and `||` must NOT evaluate both sides, so they are branching, not a
  // single instruction - see emitShortCircuit in flow.yoop.
  if (expr.operator == TokenTags.ANDAND || expr.operator == TokenTags.OROR) {
    return emitShortCircuit(ref cx, expr, ref out);
  }

  let lhs: Operand = Operand.None;
  const lerr = emitExpr(ref cx, expr.childA, ref lhs);
  if (lerr.len > 0) { return lerr; }

  let rhs: Operand = Operand.None;
  const rerr = emitExpr(ref cx, expr.childB, ref rhs);
  if (rerr.len > 0) { return rerr; }

  // A comparison is an icmp over the OPERAND type and yields i1; arithmetic is
  // one instruction over the result type. `typeOf(exprId)` is bool for a
  // comparison, which is why the operand type is read off the left side.
  const pred = llvmIntPredicate(expr.operator);
  const dest = freshTemp(cx.e);
  if (pred.len > 0) {
    emitICmp(ref cx, dest, pred, typeOf(ref cx, expr.childA), lhs, rhs);
    out = Operand.Temp { id: dest };
    return "";
  }

  const op = llvmIntOp(expr.operator);
  if (op.len == 0) {
    return internalError("codegen cannot emit operator", tagName(expr.operator));
  }
  emitBinOp(ref cx, dest, op, typeOf(ref cx, exprId), lhs, rhs);
  out = Operand.Temp { id: dest };
  return "";
}
