module codegen;

// The two forms where a scope-end call is attached to a BLOCK rather than to
// the enclosing function:
//
//   ephemeral arenaScope(N) { ... }          anonymous - the region form
//   disposable reg: T = expr { ... }         named    - a binding that owns one
//
// Both mean the same thing and lower the same way: one dispose scope holding
// exactly one entry, the block inside it, and the scope-end call at the closing
// brace. What differs is whether the subject has a NAME, which decides whether
// it goes in an ordinary local slot the block can read or in an anonymous one.
//
// The ordinary `disposable ids: Vec<T> = ...;` binding is NOT here - it belongs
// to whatever scope it was declared in, which is dispose.yoop's business.

import { ASTNode, NodeId, nodeAt } from "../ast";

// `disposable reg: ArenaScope = arenaScope(4096) { ... }` - a kind-prefixed
// binding that OWNS a block.
//
// The named twin of `emitKindRegion`, and the two differ in exactly one thing:
// the subject has a NAME here, so it goes in an ordinary local slot that the
// block can read, instead of the anonymous slot a region uses. Everything after
// that is the same shape - one dispose scope holding just this binding, the
// block inside it, and the scope-end call at the closing brace.
//
// A LOCALS scope goes around it too, which the anonymous form needs no
// equivalent of: a name has to stop resolving at the closing brace, and
// `emitBlock` pushes its own scope INSIDE this one, too late to hold a binding
// declared before the block starts.
export function emitScopedBinding(
  ref cx: Cx,
  stmt: ASTNode,
  stmtId: NodeId,
  retTy: string,
  ref terminated: bool
): string {
  localsPushBlock(cx.locals);
  disposePushScope(cx.disposes);

  const declErr = emitVarDecl(ref cx, stmt, stmtId);
  if (declErr.len > 0) {
    disposePopScope(cx.disposes);
    localsPopBlock(cx.locals);
    return declErr;
  }

  let bodyErr = "";
  let bodyTerminated = false;
  emitBlock(ref cx, stmt.childD, retTy, ref bodyTerminated, ref bodyErr);
  if (bodyErr.len > 0) {
    disposePopScope(cx.disposes);
    localsPopBlock(cx.locals);
    return bodyErr;
  }

  // A body that terminated already unwound this scope on its way out - a
  // `return` unwinds to 0 and a `break` unwinds to the loop, and both pass
  // through here.
  if (!bodyTerminated) {
    // The DECLARATION is the exit site here: it is the node that owns this
    // scope, and the one pass D keyed a manual dispose inside the block by.
    const derr = emitScopeDisposals(ref cx, disposeScopeDepth(cx.disposes) - 1, stmtId);
    if (derr.len > 0) {
      disposePopScope(cx.disposes);
      localsPopBlock(cx.locals);
      return derr;
    }
  }
  disposePopScope(cx.disposes);
  localsPopBlock(cx.locals);
  terminated = bodyTerminated;
  return "";
}

export function emitKindRegion(
  ref cx: Cx,
  stmt: ASTNode,
  stmtId: NodeId,
  retTy: string,
  ref terminated: bool
): string {
  const method = disposeMethodOf(ref cx, stmt);
  if (method.len == 0) {
    return internalError("kind region with no scope-end method", "codegen");
  }

  let subject: Operand = Operand.None;
  const err = emitExpr(ref cx, stmt.childA, ref subject);
  if (err.len > 0) {
    return err;
  }
  const ty = typeOf(ref cx, stmtId);
  const slot = declareAnonSlot(ref cx, ty);
  emitStore(ref cx, ty, subject, TEMP_SLOT_NAME, slot.id);

  // The IMPLICIT form - `ephemeral makeGuard(1);` - owns the rest of the
  // ENCLOSING scope rather than a block of its own, so it opens no scope and
  // records into the one already open. That is the whole difference, and it is
  // what makes two of them in a row unwind in reverse: they are two entries in
  // one scope, exactly like two `disposable` bindings.
  if (stmt.childB == 0) {
    // declNode 0: the subject is ANONYMOUS, so there is no name a hand-written
    // call could reach it by and nothing that could discharge it early.
    return recordDisposal(ref cx, TEMP_SLOT_NAME, slot.id, 0,
      resolvedTypeAt(ref cx, stmtId), method);
  }

  // Its own scope, holding just the subject, so the block's own disposables
  // unwind INSIDE it and the region's call comes last.
  disposePushScope(cx.disposes);
  const rerr = recordDisposal(ref cx, TEMP_SLOT_NAME, slot.id, 0,
    resolvedTypeAt(ref cx, stmtId), method);
  if (rerr.len > 0) {
    disposePopScope(cx.disposes);
    return rerr;
  }

  let bodyErr = "";
  let bodyTerminated = false;
  emitBlock(ref cx, stmt.childB, retTy, ref bodyTerminated, ref bodyErr);
  if (bodyErr.len > 0) {
    disposePopScope(cx.disposes);
    return bodyErr;
  }

  // A body that terminated already unwound this scope on its way out.
  if (!bodyTerminated) {
    const derr = emitScopeDisposals(ref cx, disposeScopeDepth(cx.disposes) - 1, stmtId);
    if (derr.len > 0) {
      disposePopScope(cx.disposes);
      return derr;
    }
  }
  disposePopScope(cx.disposes);
  terminated = bodyTerminated;
  return "";
}
