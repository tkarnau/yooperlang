module codegen;

/*
  What has to be disposed, and where.

  `disposable ids: Vec<NodeId> = vec.vecNew(4);` is a promise that `dispose`
  runs when `ids` goes out of scope. Keeping that promise means finding EVERY
  way out of the scope, not just the closing brace:

    the closing brace   dispose this scope's bindings, in reverse
    `return`            dispose every enclosing scope, innermost first
    `break`             dispose out to the innermost breakable scope - a loop
                        OR a switch - and no further
    `continue`          dispose out to the innermost LOOP, looking past any
                        switch in between

  So this is a stack of scopes, each holding its own pending disposals in
  declaration order - the loop-label stack's shape, for the same reason. Reverse
  order matters: a later binding may hold a borrow of an earlier one, so it has
  to go first.

  ONE DIVERGENCE FROM THE REFERENCE, deliberate. The JS compiler disposes on the
  closing brace and on `return`, but NOT on `break` - a `disposable` declared in
  a loop body leaks on the iteration that breaks. The bootstrap disposes there
  too. Reproducing a leak to match is not parity worth having, and a fixture
  cannot cover the difference (a `.expected` is asserted against both), so it
  lives in a unit test.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable, Disposable } from "std/core/kinds.yoop";
import { NodeId } from "../ast";
import { TypeId } from "../typecheck";

// One binding, or one FIELD of one binding, waiting to be disposed.
//
// A type carrying `propagates<disposable>` and no `dispose` of its own owes one
// call per field that supplies the kind, so a single binding can push several
// of these. `viaField` is what tells them apart: false means "the binding
// itself", true means "gep into `fieldIndex` first" - and `ownerType` is then
// the FIELD's type, since that is what the method is mangled against either way.
//
// A BOOL rather than an out-of-range `fieldIndex` sentinel, and that is not a
// style preference: field 0 is an ordinary answer, so the sentinel would have
// to be a maximum, and the JS reference silently WRAPS an integer literal above
// int64 to zero (`const N: usize = 18446744073709551615;` prints 0 there and
// prints itself here). That made every field-0 disposal skip its gep in the
// JS-built stage, which is the exact shape of the trap bootstrap/README.md
// already records for the function-instance sentinel.
export type PendingDispose {
  name: string,       // the local's name, for its slot
  slot: usize,        // its slot id
  // The DECLARATION this entry came from, and the only thing that can be
  // discharged by hand. Pass D answers "was this binding's method already
  // called on every path reaching this exit" against exactly this node - see
  // typecheck/discharge.yoop - and 0 means "nothing can discharge it": an
  // anonymous region has no name to write, and a task handle owes the scheduler
  // rather than a method call.
  declNode: NodeId,
  ownerType: TypeId,  // what the method is mangled against
  method: string,     // the `mustCall` method - `dispose`, `close`, ...
  viaField: bool,     // gep into a field of the binding first
  fieldIndex: usize,  // which field, when viaField
  slotType: string,   // the BINDING's LLVM type, for that gep
  // A `pooled` / `joined` TASK HANDLE owes the scheduler something instead of a
  // method call - a release, or a join plus freeing the sync pair. It rides on
  // this stack rather than on one of its own because the question "what does
  // this scope owe" has one answer and `return` / `break` / `continue` already
  // unwind it correctly. TASK_ACTION_NONE for every ordinary disposal; see
  // task_wait.yoop.
  taskAction: usize,
}

// A stack of scopes, and nothing else.
//
// How far a `break` or a `continue` unwinds is NOT here: it is recorded on the
// frame the jump targets, in loop_stack.yoop. A parallel `loopScopeDepths`
// stack cannot answer it, because a switch is a breakable scope too - a `break`
// out of a switch inside a loop unwinds to the SWITCH's depth while a
// `continue` in the same arm unwinds to the LOOP's, and one stack cannot hold
// both. Putting the depth on the frame makes each jump read the depth of the
// thing it is actually leaving.
export type DisposeStack propagates<disposable> {
  scopes: Vec<Vec<PendingDispose>>,
}

export function disposeStackNew(): DisposeStack propagates<disposable> {
  let scopes: Vec<Vec<PendingDispose>> = vec.vecNew(4);
  return { scopes: scopes };
}

export function disposePushScope(ref d: DisposeStack): void {
  let fresh: Vec<PendingDispose> = vec.vecNew(2);
  vec.vecPush(ref d.scopes, fresh);
}

// Drop the innermost scope WITHOUT emitting anything - the caller has already
// emitted whatever it needed.
export function disposePopScope(ref d: DisposeStack): void {
  if (d.scopes.len == 0) {
    return;
  }
  let top = vec.vecGet(ref d.scopes, d.scopes.len - 1);
  Disposable.dispose(ref top);
  d.scopes.len -= 1;
}

export function disposeRecord(ref d: DisposeStack, entry: PendingDispose): void {
  if (d.scopes.len == 0) {
    return;
  }
  let top = vec.vecGet(ref d.scopes, d.scopes.len - 1);
  vec.vecPush(ref top, entry);
  vec.vecSet(ref d.scopes, d.scopes.len - 1, top);
}

// How many scopes are open. `return` unwinds all of them.
export function disposeScopeDepth(ref d: DisposeStack): usize {
  return d.scopes.len;
}

// The pending disposals of scope `i`, innermost last.
export function disposeScopeAt(ref d: DisposeStack, i: usize): Vec<PendingDispose> propagates<disposable> {
  return vec.vecGet(ref d.scopes, i);
}
