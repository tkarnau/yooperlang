module codegen;

// String literals become private module-level constants.
//
// LLVM's `c"..."` form takes raw bytes with `\XX` hex escapes, and the constant
// has to be NUL-terminated for anything that hands it to C (printf, here).
//
// Everything here appends into the globals Text byte by byte. The first version
// built a string per BYTE and joined them, which is how a 34-character literal
// turned into 35 mallocs.

import { Text }, * as text from "std/core/text.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";
import * as intr from "std/core/intrinsics.yoop";

// Emits `@.str.N = private unnamed_addr constant [L x i8] c"..."` and returns
// N, so a caller can reference it as `Operand.StrRef { id: N }`.
//
// INTERNED BY CONTENT, which the name has always claimed and which the compare
// on an `enum<string>` depends on: identical bytes get one global and one
// address, so `icmp eq ptr` answers the question a reader thinks it is asking.
// Before this, the same case constant reached from two modules was two globals,
// and only the ELF and Mach-O mergeable-string sections made that look right -
// COFF kept them apart and `warm == Label.Warm` came out false on Windows.
export function internStringConstant(ref e: Emitter, s: string): usize {
  switch (e.strConstants.get(s)) {
    case Option.Some { value: existing }: { return existing; }
    case Option.None: {}
  }

  const id = e.nextStr;
  e.nextStr += 1;
  e.strConstants.insert(s, id);

  const raw = intr.stringAsBytes(s);
  e.globals.push("@.str.");
  e.globals.pushUint(uint64(id));
  e.globals.push(" = private unnamed_addr constant [");
  e.globals.pushUint(uint64(raw.len + 1));
  e.globals.push(" x i8] c\"");
  pushLlvmEscaped(ref e.globals, raw);
  e.globals.push("\\00\", align 1\n");
  return id;
}

//   @.arr.0 = internal global [4 x i8] [i8 32, i8 9, i8 13, i8 10], align 8
//
// The PAYLOAD of a module-level array const, returned as N so a caller can
// reference it as `Operand.ArrayConst { dataId: N, ... }`. It sits beside the
// string constants because it is the same kind of thing - a module datum a
// constant points at - and it is emitted from the same buffer.
//
// `internal global` and not `private constant`, because constness is about the
// BINDING: `A[0] = 9` through a `const` is allowed, and read-only storage would
// make that a crash rather than a write.
export function emitArrayPayload(ref e: Emitter, elemTy: string, ref elems: Vec<Operand>): usize {
  const id = e.nextArr;
  e.nextArr += 1;

  e.globals.push("@.arr.");
  e.globals.pushUint(uint64(id));
  e.globals.push(" = internal global [");
  e.globals.pushUint(uint64(elems.len));
  e.globals.push(" x ");
  e.globals.push(elemTy);
  e.globals.push("] ");
  // A zero-length array has no element list to write, and `[0 x i8] []` is not
  // how LLVM spells one - `zeroinitializer` is.
  if (elems.len == 0) {
    e.globals.push("zeroinitializer, align 8\n");
    return id;
  }
  e.globals.pushByte('[');
  let i: usize = 0;
  while (i < elems.len) {
    if (i > 0) {
      e.globals.push(", ");
    }
    e.globals.push(elemTy);
    e.globals.pushByte(' ');
    pushOperand(ref e.globals, elems.get(i));
    i += 1;
  }
  e.globals.push("], align 8\n");
  return id;
}

// LLVM accepts printable ASCII literally; everything else, plus `"` and `\`,
// must be a two-digit hex escape.
function pushLlvmEscaped(t: ref Text, raw: uint8[]): void {
  let i: usize = 0;
  while (i < raw.len) {
    const b = raw[i];
    if (b >= 32 && b < 127 && b != '"' && b != '\\') {
      t.pushByte(b);
    } else {
      t.pushByte('\\');
      t.pushByte(hexDigit(b / 16));
      t.pushByte(hexDigit(b % 16));
    }
    i += 1;
  }
}

function hexDigit(nibble: uint8): uint8 {
  if (nibble < 10) {
    return 48 + nibble;        // '0'
  }
  return 55 + nibble;          // 'A' - 10
}
