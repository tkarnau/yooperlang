module codegen;

// What an expression evaluates to, as a VALUE rather than a built string.
//
// Passing operands around as `string` costs a malloc for every `%t12` and every
// immediate. An operand is really one of four small things, so this says that
// out loud and lets the emitter write the text straight into its buffer with no
// allocation at all.

import { Text }, * as text from "std/core/text.yoop";
import { pushFloatBitsHex } from "../utils";

export variant Operand {
  Imm    { value: uint64 },   // 42
  NegImm { value: uint64 },   // -42, for a negative case pattern
  // `0x3FF8000000000000` - a float constant, as the 64 bits of a DOUBLE. LLVM
  // takes an arbitrary decimal for a `double` but not for a `float` (`float 1.3`
  // is "floating point constant invalid for type", because 1.3 does not
  // round-trip through 32 bits), so the hex form is the only spelling that
  // works for both and the reference emits it for both too. What differs
  // between the two widths is which VALUE was measured - see float_bits.yoop.
  FloatImm { bits: uint64 },
  Bool   { value: bool },     // true / false, how LLVM spells an i1 immediate
  Temp   { id: usize },       // %t3
  StrRef { id: usize },       // @.str.0
  // `{ ptr @.arr.0, i64 4 }` - an array DESCRIPTOR as a constant aggregate.
  // LLVM takes one as an operand, which is what lets a module-level array const
  // be inlined at every use the way an integer one is: the payload lives in a
  // module datum and the descriptor pointing at it costs no instructions.
  ArrayConst { dataId: usize, len: usize },
  // `@mathx_1__add` - a FUNCTION's address, which is what a function value is.
  // There is nothing to load: a symbol IS a constant pointer in LLVM.
  FuncRef { home: string, name: string },
  // `@main_0__counter` - a module-level `let`'s address. What `ref counter`
  // evaluates to, and the global's answer to SlotAddr: a global already IS
  // storage, so a borrow of one costs no instruction either.
  //
  // Rendered exactly like a FuncRef and deliberately not the same case. One is
  // storage and the other is code, and `ref` may name only the first - reading
  // that back off the operand is worth six lines of duplication.
  GlobalAddr { home: string, name: string },
  // `%v.3.addr` - a local's slot ADDRESS rather than its value. What `ref x`
  // evaluates to: a borrow is the address, and the slot already is one.
  SlotAddr { name: string, id: usize },
  // `%ts` - an LLVM value by BARE name. One thing needs it: the per-task
  // thunk's handle parameter. A thunk has no yoop body, so its parameter is
  // never spilled to a slot and never lands in a temp, and every other operand
  // shape here spells a decoration this one must not have.
  Named { name: string },
  // `null` - LLVM spells a null pointer constant exactly that way.
  Null,
  None,                       // a void call's non-result
}

// `@mathx_1__add` - a module-qualified symbol as an operand. A bare `home` means
// an unqualified one, which is what an extern's exact spelling needs.
function pushSymbolRef(ref out: Text, home: string, name: string): void {
  text.pushByte(ref out, '@');
  if (home.len > 0) {
    text.push(ref out, home);
    text.push(ref out, SYMBOL_MODULE_SEPARATOR);
  }
  text.push(ref out, name);
}

// Writes into the per-function instruction buffer (`fn`), not the module buffer.
// An operand is always part of an instruction, and instructions are assembled
// per function so the hoisted allocas can be spliced in ahead of them.
export function emitOperand(ref e: Emitter, op: Operand): void {
  pushOperand(ref e.fn, op);
}

// The same rendering into an ARBITRARY buffer. A module-level const's payload
// is built out of operands too, and that goes in `globals` rather than in any
// function's instruction stream.
export function pushOperand(ref out: Text, op: Operand): void {
  switch (op) {
    case Operand.Imm { value: v }: { text.pushUint(ref out, v); }
    case Operand.NegImm { value: v }: {
      text.pushByte(ref out, '-');
      text.pushUint(ref out, v);
    }
    case Operand.FloatImm { bits: b }: { pushFloatBitsHex(ref out, b); }
    case Operand.Bool { value: b }: {
      if (b) {
        text.push(ref out, "true");
      } else {
        text.push(ref out, "false");
      }
    }
    case Operand.Temp { id: n }: {
      text.push(ref out, "%t");
      text.pushUint(ref out, uint64(n));
    }
    case Operand.FuncRef { home: h, name: n }: { pushSymbolRef(ref out, h, n); }
    case Operand.GlobalAddr { home: h, name: n }: { pushSymbolRef(ref out, h, n); }
    case Operand.Null: { text.push(ref out, "null"); }
    case Operand.StrRef { id: n }: {
      text.push(ref out, "@.str.");
      text.pushUint(ref out, uint64(n));
    }
    //   { ptr @.arr.0, i64 4 }
    // The descriptor spelled out. It must match ARRAY_DESCRIPTOR exactly, or
    // the aggregate does not typecheck as the array it is standing in for.
    case Operand.ArrayConst { dataId: d, len: n }: {
      text.push(ref out, "{ ptr @.arr.");
      text.pushUint(ref out, uint64(d));
      text.push(ref out, ", i64 ");
      text.pushUint(ref out, uint64(n));
      text.push(ref out, " }");
    }
    case Operand.SlotAddr { name: n, id: i }: {
      text.pushByte(ref out, '%');
      text.push(ref out, n);
      // Mirrors `slot()` in context.yoop, including its reserved id.
      if (i == ARG_PTR_SLOT) {
        text.push(ref out, ".arg");
      } else {
        text.pushByte(ref out, '.');
        text.pushUint(ref out, uint64(i));
        text.push(ref out, ".addr");
      }
    }
    case Operand.Named { name: n }: {
      text.pushByte(ref out, '%');
      text.push(ref out, n);
    }
    case Operand.None: { text.push(ref out, "void"); }
  }
}
