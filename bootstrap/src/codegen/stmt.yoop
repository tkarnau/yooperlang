module codegen;

// Statements: emit the instructions one statement implies.
//
// Same convention as expr.yoop - "" on success, an internal-error message
// otherwise, and no text assembly in this file.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { ASTNode, ASTNodeKind, NodeId, childAt, nodeAt, kindName } from "../ast";
import { TaskBind, taskBindOf } from "../typecheck";

// Walks a BLOCK's statement list.
//
// `terminated` comes back true when the block definitely ends in a terminator on
// every path - a `ret`, but also a `break` or `continue`, which is why it is not
// called "returned". That is what tells the caller whether a `br` is still owed:
// LLVM allows exactly one terminator per block and rejects a second, so getting
// this wrong produces invalid IR rather than a wrong answer.
export function emitBlock(
  ref cx: Cx,
  blockId: NodeId,
  retTy: string,
  ref terminated: bool,
  ref err: string
): void {
  terminated = false;
  const block = nodeAt(cx.ast, blockId);
  if (block.childA == 0) {
    return;
  }

  // One dispose scope per block. Anything `disposable` declared inside is
  // unwound below - or by the terminator that leaves early, which does its own
  // unwinding and then leaves this pop with nothing to emit.
  disposePushScope(cx.disposes);
  localsPushBlock(cx.locals);

  const list = nodeAt(cx.ast, block.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    const stmtId = childAt(cx.ast, list, i);
    let stmtTerminated = false;
    err = emitStatement(ref cx, stmtId, retTy, ref stmtTerminated);
    if (err.len > 0) {
      disposePopScope(cx.disposes);
      localsPopBlock(cx.locals);
      return;
    }
    if (stmtTerminated) {
      // Anything after a terminator is unreachable; emitting it would put a
      // second terminator in this block.
      terminated = true;
      disposePopScope(cx.disposes);
      localsPopBlock(cx.locals);
      return;
    }
    i += 1;
  }

  // Fell out the bottom: this scope's bindings are done with.
  err = emitScopeDisposals(ref cx, disposeScopeDepth(cx.disposes) - 1);
  disposePopScope(cx.disposes);
  localsPopBlock(cx.locals);
}

export function emitStatement(
  ref cx: Cx,
  stmtId: NodeId,
  retTy: string,
  ref terminated: bool
): string {
  terminated = false;
  const stmt = nodeAt(cx.ast, stmtId);
  switch (stmt.kind) {
    case ASTNodeKind.RETURN_STATEMENT: {
      terminated = true;
      return emitReturn(ref cx, stmt, retTy);
    }

    // `expr;` and `_ = expr;` alike. The value is discarded; the instructions
    // still have to run, and a `?` inside one still propagates.
    case ASTNodeKind.EXPRESSION_STATEMENT, ASTNodeKind.DISCARD_STATEMENT: {
      let ignored: Operand = Operand.None;
      return emitExpr(ref cx, stmt.childA, ref ignored);
    }
    case ASTNodeKind.LET_DECL, ASTNodeKind.CONST_DECL: {
      // `disposable reg: T = expr { ... }` - the binding OWNS a block, and the
      // block is its whole scope. dispose.yoop has it, beside the anonymous
      // region form it is the named twin of.
      if (stmt.childD != 0) {
        return emitScopedBinding(ref cx, stmt, stmtId, retTy, ref terminated);
      }
      return emitVarDecl(ref cx, stmt, stmtId);
    }
    case ASTNodeKind.IF_STATEMENT: {
      return emitIf(ref cx, stmt, retTy, ref terminated);
    }
    case ASTNodeKind.WHILE_STATEMENT: {
      // A loop does not normally count as terminating: the condition may be
      // false on the first test, so control reaches the statement after it.
      // `while (true)` with no `break` is the one exception - see loop.yoop.
      return emitWhile(ref cx, stmt, retTy, ref terminated);
    }
    case ASTNodeKind.FOR_LOOP: {
      return emitFor(ref cx, stmt, stmtId, retTy);
    }
    case ASTNodeKind.FOR_IN_LOOP: {
      return emitForIn(ref cx, stmt, stmtId, retTy);
    }
    case ASTNodeKind.KIND_REGION: {
      return emitKindRegion(ref cx, stmt, stmtId, retTy, ref terminated);
    }
    case ASTNodeKind.SWITCH_STATEMENT: {
      return emitSwitch(ref cx, stmt, retTy, ref terminated);
    }
    case ASTNodeKind.BREAK_STATEMENT: {
      terminated = true;
      // The INNERMOST breakable frame, whichever kind it is - a switch is one
      // as much as a loop, so a `break` in a switch arm inside a loop leaves
      // the switch and the loop body carries on after it.
      if (!insideBreakable(ref cx)) {
        return internalError("break outside a loop or switch reached", "codegen");
      }
      const target = innermostBreakable(ref cx);
      // Everything between here and that frame is being left, so it is
      // disposed. The reference does NOT do this - see dispose_stack.yoop.
      const err = emitUnwindTo(ref cx, target.scopeDepth);
      if (err.len > 0) {
        return err;
      }
      noteBreakTaken(ref cx);
      emitBr(ref cx, target.breakTarget);
      return "";
    }
    case ASTNodeKind.CONTINUE_STATEMENT: {
      terminated = true;
      // The innermost LOOP, looking past any switch in between - not symmetric
      // with `break`, and the same rule the reference has.
      if (!insideLoop(ref cx)) {
        return internalError("continue outside a loop reached", "codegen");
      }
      const loop = innermostLoop(ref cx);
      const cerr = emitUnwindTo(ref cx, loop.scopeDepth);
      if (cerr.len > 0) {
        return cerr;
      }
      emitBr(ref cx, loop.continueTarget);
      return "";
    }
    default: {
      return internalError("codegen cannot emit statement", kindName(stmt.kind));
    }
  }
}

function emitReturn(ref cx: Cx, stmt: ASTNode, retTy: string): string {
  if (stmt.childA == 0) {
    const verr = emitUnwindTo(ref cx, 0);
    if (verr.len > 0) {
      return verr;
    }
    // In a coroutine there is no `ret <value>` anywhere: the result goes to the
    // caller-owned slot and control falls into the shared final-suspend
    // trailer, which is the block that hands the handle back. See coro.yoop.
    if (cx.coro.active) {
      emitCoroReturn(ref cx, retTy, Operand.None, false);
      return "";
    }
    emitSchedulerShutdown(ref cx);
    emitRetVoid(ref cx);
    return "";
  }
  // The returned VALUE is computed before anything is disposed - it may read a
  // binding that is about to go, and a returned `Text.view` into an arena has
  // to be taken while the arena is still there.
  let value: Operand = Operand.None;
  const err = emitExpr(ref cx, stmt.childA, ref value);
  if (err.len > 0) {
    return err;
  }
  const uerr = emitUnwindTo(ref cx, 0);
  if (uerr.len > 0) {
    return uerr;
  }
  if (cx.coro.active) {
    emitCoroReturn(ref cx, retTy, value, true);
    return "";
  }
  emitSchedulerShutdown(ref cx);
  emitRet(ref cx, retTy, value);
  return "";
}

// `call void @yoop_runtime_shutdown()` on the way out of `main`, and only
// there. It joins the worker threads and drains the queue, so a task nobody
// waited on is finished rather than killed halfway through by process exit.
// Before EVERY `ret` in main rather than at one exit, because main may have
// several - the reference does the same.
function emitSchedulerShutdown(ref cx: Cx): void {
  if (!cx.inMain) {
    return;
  }
  emitRuntimeShutdown(ref cx);
}

// `let x: T = expr;` is a stack slot plus a store. Without an initializer it is
// just the slot - reading it before assignment is typecheck's problem.
function emitVarDecl(ref cx: Cx, stmt: ASTNode, stmtId: NodeId): string {
  const ty = typeOf(ref cx, stmtId);
  const hasInit = stmt.childB != 0;

  // `pooled h = f(a)`, `joined d = f(a)`, `const v: T = f(a)` - a SPAWN rather
  // than an initializer. The classifier is typecheck's, asked again here for
  // the same reason `fallibleShapeOf` is: the answer is a property of the type
  // and the kind's clauses, so this is a lookup and not a second typecheck.
  if (hasInit) {
    const bind = taskBindOf(
      cx.prog, cx.ast, stmt, resolvedTypeAt(ref cx, stmtId), resolvedTypeAt(ref cx, stmt.childB)
    );
    if (bind != TaskBind.NONE) {
      return emitTaskBinding(ref cx, stmt, stmtId, bind);
    }
  }

  let value: Operand = Operand.None;
  if (hasInit) {
    // Lowered BEFORE the slot is recorded, so `let x = x;` cannot see itself.
    const err = emitExpr(ref cx, stmt.childB, ref value);
    if (err.len > 0) {
      return err;
    }
  }

  const slotInfo = declareLocal(ref cx, stmt.name, ty);
  if (hasInit) {
    emitStore(ref cx, ty, value, stmt.name, slotInfo.id);
  }
  // Recorded AFTER the store: a disposal runs on a binding that exists, and if
  // the initializer had failed there would be nothing to dispose.
  return noteDisposable(ref cx, stmt, stmtId, slotInfo.id);
}
