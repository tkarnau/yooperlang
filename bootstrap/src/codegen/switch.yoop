module codegen;

// `switch` lowered to an LLVM jump table.
//
//     switch i32 %scrut, label %Ldefault [ i32 1, label %L1  i32 2, label %L1 ]
//   L1:  ...  br label %Lend
//   Ldefault: ...  br label %Lend
//   Lend:
//
// The labels are allocated for EVERY arm before any is emitted, because the
// dispatch instruction has to name them all up front. That is the one structural
// difference from `if`, where each branch's label is needed only when reached.
//
// Arms do not fall through, so each ends with its own branch to the join. An arm
// that already terminated (a `return` inside it) gets none - the same one
// terminator per block rule as everywhere else.
//
// The switch is also a BREAKABLE scope: `break` in an arm branches to the join,
// which is why a SWITCH frame goes on the jump stack (loop_stack.yoop) around
// the arm bodies. `continue` looks past it to the enclosing loop, so the frame
// carries no continue target. A `break` is decorative at the end of an arm -
// nothing falls through here - but it is legal Yoop and reaching the same join
// by a different route is all it does.

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ASTNode, NodeId, childAt, nodeAt } from "../ast";

export function emitSwitch(ref cx: Cx, stmt: ASTNode, retTy: string, ref terminated: bool): string {
  terminated = false;

  let scrut: Operand = Operand.None;
  const serr = emitExpr(ref cx, stmt.childA, ref scrut);
  if (serr.len > 0) {
    return serr;
  }
  const valueTy = typeOf(ref cx, stmt.childA);
  const overVariant = isVariantAt(ref cx, stmt.childA);
  // A value enum dispatches on the scrutinee ITSELF - its values are integers of
  // the underlying width, so `valueTy` is already the right type and there is no
  // tag to extract and no slot to spill into.
  const overEnum = isValueEnumAt(ref cx, stmt.childA);
  // A BOOL scrutinee dispatches on itself too, as `switch i1`. It is called out
  // because it is the other kind that may be EXHAUSTIVE with no default arm, so
  // it needs the unreachable default block below rather than a fall-through to
  // the join.
  const overBool = isBoolAt(ref cx, stmt.childA);

  // A variant dispatches on its TAG, and its arms read payload fields out of a
  // stack slot - a loaded value has no address to reinterpret. Both are set up
  // once here rather than per arm, because every arm reads the same slot.
  let scrutTy = valueTy;
  let dispatch = scrut;
  let scrutSlotId: usize = 0;
  if (overVariant) {
    const slot = declareAnonSlot(ref cx, valueTy);
    scrutSlotId = slot.id;
    emitStore(ref cx, valueTy, scrut, TEMP_SLOT_NAME, scrutSlotId);
    dispatch = Operand.Temp { id: emitVariantTag(ref cx, valueTy, scrut) };
    scrutTy = VARIANT_TAG_TYPE;
  }

  // One label per arm, plus the join. Allocated first so the dispatch can name
  // them.
  disposable armLabels: Vec<usize> = vec.vecNew(4);
  let defaultLabel: usize = 0;
  let i: usize = 0;
  while (i < stmt.childCount) {
    const arm = nodeAt(cx.ast, childAt(cx.ast, stmt, i));
    const armLabel = freshLabel(cx.e);
    vec.vecPush(ref armLabels, armLabel);
    if (arm.flagA) {
      defaultLabel = armLabel;
    }
    i += 1;
  }
  const endLabel = freshLabel(cx.e);
  const hasDefaultArm = defaultLabel != 0;

  // A jump table must name SOME default. An exhaustive variant switch has no
  // default arm - pass D proved every case is covered, so a value reaching the
  // default is impossible - and it gets a block saying exactly that. Without it
  // the fall-through would make the switch look non-terminating to the caller,
  // and a function whose every arm returns would be rejected for having no
  // return on some path.
  let unreachableLabel: usize = 0;
  if (!hasDefaultArm) {
    if (overVariant || overEnum || overBool) {
      unreachableLabel = freshLabel(cx.e);
      defaultLabel = unreachableLabel;
    } else {
      // An integer switch always has a default (pass D requires it), so this is
      // unreachable on well-formed input - and falling to the join is the
      // answer that cannot produce invalid IR.
      defaultLabel = endLabel;
    }
  }

  emitSwitchOpen(ref cx, scrutTy, dispatch, defaultLabel);
  emitCaseLines(ref cx, stmt, scrutTy, overVariant, overEnum, ref armLabels);
  emitSwitchClose(ref cx);

  // Now the arm bodies. A SWITCH frame goes on the jump stack around them: the
  // switch is a breakable scope, so a `break` in an arm branches to the join
  // and unwinds only what the arm opened. It is pushed AFTER the labels exist
  // and BEFORE any arm body, so the recorded dispose depth is the switch's own
  // and not an arm's.
  switchPush(ref cx, endLabel);
  let allTerminated = stmt.childCount > 0;
  let a: usize = 0;
  let armErr = "";
  while (a < stmt.childCount && armErr.len == 0) {
    const arm = nodeAt(cx.ast, childAt(cx.ast, stmt, a));
    emitLabel(ref cx, vec.vecGet(ref armLabels, a));

    // The payload bindings come FIRST in the arm, so the body reads them as
    // ordinary locals. Only the first pattern of an arm can bind: several
    // patterns sharing an arm would bind different things under one name, and
    // pass D requires every field of a case to be bound, so a shared arm can
    // only be payload-less cases.
    if (overVariant) {
      armErr = emitArmBindings(ref cx, arm, scrutSlotId);
    }

    if (armErr.len == 0) {
      let armTerminated = false;
      emitBlock(ref cx, arm.childB, retTy, ref armTerminated, ref armErr);
      if (armErr.len == 0 && !armTerminated) {
        allTerminated = false;
        emitBr(ref cx, endLabel);
      }
    }
    a += 1;
  }

  // Read the frame's `sawBreak` before popping it: a `break` in an arm makes
  // the join reachable even when every arm "terminated", because that break IS
  // the branch to the join.
  const brokeToJoin = innermostBreakable(ref cx).sawBreak;
  loopPop(ref cx);
  if (armErr.len > 0) {
    return armErr;
  }

  if (unreachableLabel != 0) {
    emitLabel(ref cx, unreachableLabel);
    emitUnreachable(ref cx);
  }

  // If every arm returned AND every value lands in one, nothing reaches the
  // join - which is true both for a switch with a default and for an exhaustive
  // variant switch without one. A `break` is the exception: it counts as an arm
  // terminator, and the terminator it emits is a branch to the join, so the
  // join is reached after all and its label has to exist.
  if (allTerminated && !brokeToJoin && defaultLabel != endLabel) {
    terminated = true;
    return "";
  }
  emitLabel(ref cx, endLabel);
  return "";
}

// The `<ty> <value>, label %Lk` lines - one per pattern, so several patterns can
// share an arm. Three dispatches differ only in what a pattern's value IS: a
// variant's is its ORDINAL, an enum's is the case's declared CONSTANT (which may
// be sparse or negative, so it is never the ordinal), and an integer's is the
// literal itself.
function emitCaseLines(
  ref cx: Cx,
  stmt: ASTNode,
  scrutTy: string,
  overVariant: bool,
  overEnum: bool,
  ref armLabels: Vec<usize>
): void {
  let i: usize = 0;
  while (i < stmt.childCount) {
    const arm = nodeAt(cx.ast, childAt(cx.ast, stmt, i));
    if (!arm.flagA && arm.childA != 0) {
      const patterns = nodeAt(cx.ast, arm.childA);
      let p: usize = 0;
      while (p < patterns.childCount) {
        const patternId = childAt(cx.ast, patterns, p);
        let value: Operand = Operand.Imm { value: variantOrdinalOf(ref cx, patternId) };
        if (overEnum) {
          // The pattern node carries the ENUM type and the case name, which is
          // the same pair a `Color.Red` expression is read from.
          value = enumCaseOperand(ref cx, patternId, patternId);
        } else if (!overVariant) {
          value = patternOperand(nodeAt(cx.ast, patternId));
        }
        emitSwitchCase(ref cx, scrutTy, value, vec.vecGet(ref armLabels, i));
        p += 1;
      }
    }
    i += 1;
  }
}

// A literal pattern as an operand. `flagA` is the negation the parser recorded,
// so `case -1:` reaches here as 1 with the flag set.
function patternOperand(pattern: ASTNode): Operand {
  if (pattern.flagA) {
    return Operand.NegImm { value: pattern.intVal };
  }
  return Operand.Imm { value: pattern.intVal };
}

// The payload bindings for whichever pattern reached this arm. Pass D allows
// several patterns to share an arm only when none of them binds, so taking the
// FIRST is not a choice - it is the only one that can bind anything.
function emitArmBindings(ref cx: Cx, arm: ASTNode, scrutSlotId: usize): string {
  if (arm.flagA || arm.childA == 0) {
    return "";
  }
  const patterns = nodeAt(cx.ast, arm.childA);
  if (patterns.childCount == 0) {
    return "";
  }
  const patternId = childAt(cx.ast, patterns, 0);
  return emitPatternBindings(ref cx, nodeAt(cx.ast, patternId), patternId, scrutSlotId);
}
