module codegen;

// The module-level `%struct.X = type { ... }` lines.
//
// Split from the walk in codegen.yoop because this is the one part of codegen
// that reads the TYPE ARENA rather than the AST - it emits a definition per
// declared struct, not per construct encountered.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, childAt, declOf, nodeAt } from "../ast";
import { Module, ModuleGraph } from "../source_graph";
import { Program, TypedModule, Type, TypeId, Field, VariantCase, Symbol, moduleIdOf, symbolAt,
  typeAt, variantPayloadSize, unionPayloadSize, isOpenInstance } from "../typecheck";

// `%struct.Point = type { i32, i32 }` for every struct the program declared.
//
// Emitted in TypeId order, which is the order pass A registered the decls, so a
// struct whose field is another struct sees that type defined first. Two structs
// that referenced each other would need a pointer somewhere to be representable
// at all, so the ordering constraint costs nothing real.
//
// Emitted for every declared struct rather than only the used ones - an unused
// type definition is free, and tracking usage would be bookkeeping for nothing.
function emitStructTypeDefs(ref e: Emitter, ref prog: Program): void {
  let id: usize = 0;
  while (id < prog.types.len) {
    switch (typeAt(ref prog, id)) {
      // A TEMPLATE is skipped: its members are TypeParams, which have no LLVM
      // type and which nothing ever holds a value of. Only the INSTANCES
      // substitution produced are real types, and they are in this same arena.
      case Type.Struct { decl: d, fields: f, methods: mm, implementsTraits: it, generic: g }: {
        if (d.populated && !isOpenInstance(ref prog, id)) {
          emitStructTypeDef(ref e, ref prog, moduleIdOf(ref prog, d.module), d.name, ref f);
        }
      }
      case Type.Variant { decl: d, cases: cs, methods: mm, implementsTraits: it, generic: g }: {
        if (d.populated && !isOpenInstance(ref prog, id)) {
          emitVariantTypeDefs(ref e, ref prog, id, moduleIdOf(ref prog, d.module), d.name, ref cs);
        }
      }
      case Type.VTable { decl: d, forTrait: ft, fields: f, methodOrder: mo }: {
        if (d.populated) {
          emitVtableTypeDef(ref e, moduleIdOf(ref prog, d.module), d.name, f.len);
        }
      }
      // A union carries no field list at all - one byte buffer as wide as its
      // widest field, which is what `unionPayloadSize` measures.
      case Type.Union { decl: d, fields: f }: {
        if (d.populated) {
          emitUnionTypeDef(ref e, moduleIdOf(ref prog, d.module), d.name,
            unionPayloadSize(ref prog, id));
        }
      }
      default: { }
    }
    id += 1;
  }
}

//   %vtable.traits_1__Reader = type { ptr, ptr }
//
// One `ptr` for the erased receiver, then one per slot. Every field of a vtable
// is a function POINTER and the ctx is a pointer too, so the whole definition is
// a count rather than a walk over the field types.
function emitVtableTypeDef(ref e: Emitter, moduleId: string, name: string, slots: usize): void {
  text.push(ref e.globals, vtableLlvmName(moduleId, name));
  text.push(ref e.globals, " = type { ptr");
  let i: usize = 0;
  while (i < slots) {
    text.push(ref e.globals, ", ptr");
    i += 1;
  }
  text.push(ref e.globals, " }\n");
}

// The variant itself, plus one payload struct per case that carries something:
//
//   %variant.m__Shape = type { i32, [16 x i8] }
//   %variantc.m__Shape__Circle = type { i32 }
//   %variantc.m__Shape__Rect = type { i32, i32 }
//
// The payload is a byte ARRAY rather than a union because LLVM has no union:
// one blob big enough for the largest case, addressed as whichever case struct
// the tag says it holds. A payload-less case contributes no struct at all -
// there would be nothing in it.
function emitVariantTypeDefs(
  ref e: Emitter,
  ref prog: Program,
  variantType: TypeId,
  moduleId: string,
  name: string,
  ref cases: Vec<VariantCase>
): void {
  text.push(ref e.globals, variantLlvmName(moduleId, name));
  text.push(ref e.globals, " = type { ");
  text.push(ref e.globals, VARIANT_TAG_TYPE);
  text.push(ref e.globals, ", [");
  text.pushUint(ref e.globals, uint64(variantPayloadSize(ref prog, variantType)));
  text.push(ref e.globals, " x i8] }\n");

  let i: usize = 0;
  while (i < cases.len) {
    let c = vec.vecGet(ref cases, i);
    if (c.fields.len > 0) {
      text.push(ref e.globals, variantCaseLlvmName(moduleId, name, c.name));
      text.push(ref e.globals, " = type { ");
      let f: usize = 0;
      while (f < c.fields.len) {
        if (f > 0) {
          text.push(ref e.globals, ", ");
        }
        text.push(ref e.globals, llvmType(ref prog, vec.vecGet(ref c.fields, f).typeId));
        f += 1;
      }
      text.push(ref e.globals, " }\n");
    }
    i += 1;
  }
}

//   declare i32 @yoop_log_info(ptr)
//   declare i32 @printf(ptr, ...)
//
// One line per extern, in the module-level globals. The name is NOT mangled:
// an extern IS the linker's spelling, which is the whole point of declaring one.
//
// A PROGRAM-level walk rather than one per file, because one LLVM module holds
// the whole graph and a symbol may only be declared in it ONCE. Two files each
// writing `extern "C" { function printf(fmt: string, ...): int32; }` - which is
// ordinary, since an extern is not exported and every file that calls printf
// declares its own - would otherwise emit two `declare i32 @printf` lines, and
// clang rejects the second as an invalid redefinition.
//
// The dedupe itself lives on the EMITTER (extern_table.yoop) rather than here,
// because the string-builder lowering and the runtime bridge declare libc and
// runtime symbols of their own AFTER every body is walked, and those collide
// with a user's `extern malloc` exactly as two user externs collide with each
// other.
//
// Returns "" on success, or the refusal when two declarations of one name
// disagree about the signature.
export function emitExternDeclares(ref e: Emitter, ref prog: Program, ref graph: ModuleGraph): string {
  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    let tm = vec.vecGet(ref prog.modules, i);
    let f: usize = 0;
    while (f < m.files.len) {
      const programNode = nodeAt(ref m.ast, vec.vecGet(ref m.files, f).root);
      let d: usize = 0;
      while (d < programNode.childCount) {
        const declNode = nodeAt(ref m.ast, declOf(ref m.ast, childAt(ref m.ast, programNode, d)));
        // An INTRINSIC has no symbol at all - codegen lowers the call to
        // instructions - so a `declare` for one names something nothing
        // defines. Harmless while nothing calls it, which is why it went
        // unnoticed, but it is not a declaration of anything.
        if (declNode.kind == ASTNodeKind.EXTERN_BLOCK && !declNode.flagA) {
          const err = emitOneBlocksDeclares(ref e, ref prog, ref tm, ref m.ast, declNode);
          if (err.len > 0) {
            return err;
          }
        }
        d += 1;
      }
      f += 1;
    }
    i += 1;
  }
  return "";
}

function emitOneBlocksDeclares(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  blockNode: ASTNode
): string {
  let i: usize = 0;
  while (i < blockNode.childCount) {
    const externNode = nodeAt(ref ast, childAt(ref ast, blockNode, i));
    // An opaque `type FILE;` declares no symbol - there is nothing to
    // `declare`, and asking for its "signature" would look up a function that
    // was never registered.
    if (externNode.kind == ASTNodeKind.EXTERN_TYPE_DECL) {
      i += 1;
      continue;
    }
    disposable params: Vec<string> = vec.vecNew(4);
    let variadic = false;
    const ret = externSignature(ref prog, ref tm, externNode.name, ref params, ref variadic);
    const err = externDeclare(
      ref e, externNode.name, ret, vec.vecAsArray(ref params), variadic
    );
    if (err.len > 0) {
      return err;
    }
    i += 1;
  }
  return "";
}

// The Func pass C filled for an extern, split into the three things a
// `declare` is made of: the return type, the FIXED parameters, and whether a
// `...` rode on the signature.
function externSignature(
  ref prog: Program,
  ref tm: TypedModule,
  name: string,
  ref params: Vec<string>,
  ref variadic: bool
): string {
  switch (externFuncType(ref prog, ref tm, name)) {
    case Type.Func { params: p, ret: r, variadic: v, isAsync: fnAsync }: {
      let i: usize = 0;
      while (i < p.len) {
        vec.vecPush(ref params, llvmType(ref prog, vec.vecGet(ref p, i)));
        i += 1;
      }
      variadic = v;
      return llvmType(ref prog, r);
    }
    default: { return "void"; }
  }
}

// The Func type pass C filled for an extern, by name.
function externFuncType(ref prog: Program, ref tm: TypedModule, name: string): Type propagates<disposable> {
  switch (map.mapGet(ref tm.names, name)) {
    case Option.Some { value: symId }: {
      switch (symbolAt(ref prog, symId)) {
        case Symbol.Func { typeId: t }: { return typeAt(ref prog, t); }
        default: { return Type.ErrorT; }
      }
    }
    case Option.None: { return Type.ErrorT; }
  }
}

function emitStructTypeDef(
  ref e: Emitter,
  ref prog: Program,
  moduleId: string,
  name: string,
  ref fields: Vec<Field>
): void {
  text.push(ref e.globals, structLlvmName(moduleId, name));
  text.push(ref e.globals, " = type { ");
  let i: usize = 0;
  while (i < fields.len) {
    if (i > 0) {
      text.push(ref e.globals, ", ");
    }
    text.push(ref e.globals, llvmType(ref prog, vec.vecGet(ref fields, i).typeId));
    i += 1;
  }
  text.push(ref e.globals, " }\n");
}
