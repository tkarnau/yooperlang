module codegen;

/*
  Intrinsics - the calls that are not calls.

  `extern "intrinsic" from "compiler" { ... }` declares operations whose
  implementation IS the compiler. There is no symbol behind `stringAsBytes`, so
  a call to it becomes instructions here rather than a `call` to anything - and
  that is why pass A keeps intrinsic names out of `externNames`, which is the
  table that says "emit this call with its name unmangled".

  The name is the lowering, so this dispatch and pass A's list of known
  intrinsics are two halves of one table. Adding a name to one without the other
  is how you get a call to a symbol nothing defines.

  What each one costs:

    stringAsBytes             one strlen, no copy      - a string IS the bytes
    bytesAsStringUnchecked    one extractvalue         - the inverse, no copy
    arraySlice                one gep and one sub      - a borrowing view
    heapFree                  one free
    heapAlloc                 one mul and one malloc
    stringFromBytesUnchecked  malloc + memcpy + NUL    - the one that copies

  Five of the six are free or nearly so, which is the point: these exist because
  a fat pointer and a NUL-terminated string already share a representation, and
  saying so costs less than converting.
*/

import * as map from "std/collections/map.yoop";
import { ASTNode, NodeId, childAt, nodeAt } from "../ast";
import * as str from "std/core/strings.yoop";
import { Type, typeAt, sizeOfType, isIntrinsicName } from "../typecheck";

// True when this call names an intrinsic rather than a function.
//
// Being an intrinsic SOMEWHERE in the graph is not enough, because the name is
// an ordinary identifier and nothing stops a module from using it for something
// else: std/tls/ffi.yoop declares `ctxFree(ref c: TlsCtx)` beside the
// allocator's `ctxFree<T>(a: T[])`, and lowering its calls as the intrinsic
// emitted an `extractvalue` on a struct pointer. So the question is whether the
// intrinsic is in scope HERE, and it is asked the way the reference asks it -
// per module, off what that module declared or reached.
//
//   QUALIFIED    `intr.stringAsBytes(s)` names the namespace it came through,
//                and a namespace member is whatever that module exported.
//                Nothing local can shadow it.
//   UNQUALIFIED  only when THIS module wrote the `extern "intrinsic"` block. A
//                module that reached one any other way and then called it
//                unqualified gets a call to a symbol nothing defines, which is
//                a link error rather than a wrong answer - and no file in std,
//                examples or bootstrap does it, because a std value import has
//                to come through a namespace.
export function isIntrinsicCall(ref cx: Cx, expr: ASTNode): bool {
  if (!isIntrinsicName(cx.prog, expr.name)) {
    return false;
  }
  if (expr.childB != 0) {
    return true;
  }
  return map.mapContainsKey(ref cx.tm.intrinsicNames, expr.name);
}

// Lower one intrinsic call. Ok on success, else the error that stopped
// it - an unknown name here is a compiler bug, since pass A refuses any name
// this dispatch does not have.
export function emitIntrinsicCall(
  ref cx: Cx,
  expr: ASTNode,
  exprId: NodeId,
  ref out: Operand
): EmitResult {
  if (str.stringEq(expr.name, "stringAsBytes")) {
    return emitStringAsBytes(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "bytesAsStringUnchecked")) {
    return emitBytesAsString(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "stringFromBytesUnchecked")) {
    return emitStringFromBytes(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "heapAlloc")) {
    return emitHeapAlloc(ref cx, expr, exprId, ref out);
  }
  if (str.stringEq(expr.name, "heapFree")) {
    return emitHeapFree(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "arraySlice")) {
    return emitArraySlice(ref cx, expr, exprId, ref out);
  }
  // The allocator-context pair. Identical in shape to heapAlloc/heapFree, and
  // different in exactly one way: the bytes come from the CURRENT allocator, so
  // an installed arena captures them. That is the whole reason they exist, and
  // why they were refused rather than lowered to malloc while the runtime was
  // unlinkable - a program would have run, and quietly not used the arena.
  if (str.stringEq(expr.name, "ctxAlloc")) {
    return emitCtxAllocCall(ref cx, expr, exprId, ref out);
  }
  if (str.stringEq(expr.name, "ctxFree")) {
    return emitCtxFreeCall(ref cx, expr, ref out);
  }
  // The four `Task<T>` ones. They live in task_intr.yoop rather than here
  // because all four are calls into the scheduler and none of them is a
  // representation trick, which is what everything above this line is.
  if (str.stringEq(expr.name, "cancel")) {
    return emitCancelIntrinsic(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "isDone")) {
    return emitIsDoneIntrinsic(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "armComplete")) {
    return emitArmCompleteIntrinsic(ref cx, expr, ref out);
  }
  if (str.stringEq(expr.name, "waitUntil")) {
    return emitWaitUntilIntrinsic(ref cx, expr, exprId, ref out);
  }
  // `suspendNow` never reaches here: it is a SUSPEND rather than a call, so
  // `await` intercepts it before an ordinary call lowering is reached.
  return internalError("no lowering for intrinsic", expr.name);
}

// `stringAsBytes(s)` - a uint8[] over the string's own storage.
//
//   %len = call i64 @strlen(ptr %s)
//   ... insertvalue { ptr, i64 } undef, ptr %s, 0 / i64 %len, 1
//
// No copy: a yoop string is a NUL-terminated ptr and a uint8[] is that pointer
// plus a length, so the only missing piece is the length.
function emitStringAsBytes(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let s: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref s)?;
  cx.e.usesStringBuilder = true;

  const len = freshTemp(cx.e);
  emitStrlen(ref cx, len, s);
  out = buildDescriptor(ref cx, s, Operand.Temp { id: len });
  return EmitResult.Ok;
}

// `bytesAsStringUnchecked(buf)` - the data pointer, and nothing else.
//
// The caller guarantees the bytes are valid UTF-8 with a NUL at buf[len], which
// is exactly what makes this free. `Text.view` maintains both by construction.
function emitBytesAsString(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let buf: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref buf)?;
  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, buf, 0);
  out = Operand.Temp { id: data };
  return EmitResult.Ok;
}

// `stringFromBytesUnchecked(buf)` - malloc, copy, terminate.
//
// The one intrinsic that allocates, and where a string's storage comes from.
// The NUL is why it cannot be a view: the bytes may not have one.
function emitStringFromBytes(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let buf: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref buf)?;
  cx.e.usesStringBuilder = true;

  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, buf, 0);
  const len = freshTemp(cx.e);
  emitExtractValue(ref cx, len, ARRAY_DESCRIPTOR, buf, 1);

  const size = freshTemp(cx.e);
  emitBinOp(ref cx, size, "add", "i64", Operand.Temp { id: len }, Operand.Imm { value: 1 });
  const dst = freshTemp(cx.e);
  emitMalloc(ref cx, dst, Operand.Temp { id: size });
  emitMemcpy(ref cx, dst, Operand.Temp { id: data }, Operand.Temp { id: len });

  const end = freshTemp(cx.e);
  emitGepByteOffset(ref cx, end, dst, Operand.Temp { id: len });
  emitStoreNulByte(ref cx, end);

  out = Operand.Temp { id: dst };
  return EmitResult.Ok;
}

// `heapAlloc<T>(n)` - n ELEMENTS, so the byte count is a multiplication.
//
// The element size comes from the call's resolved type rather than from the
// type argument: `T[]` is already substituted there, so this needs no access to
// the instantiation.
function emitHeapAlloc(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let n: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref n)?;
  cx.e.usesStringBuilder = true;

  const size = freshTemp(cx.e);
  emitBinOp(
    ref cx, size, "mul", "i64", n,
    Operand.Imm { value: uint64(elementSizeOfResult(ref cx, exprId)) }
  );
  const raw = freshTemp(cx.e);
  emitMalloc(ref cx, raw, Operand.Temp { id: size });

  // The length is the ELEMENT count the caller asked for, not the byte count.
  out = buildDescriptor(ref cx, Operand.Temp { id: raw }, n);
  return EmitResult.Ok;
}

// `ctxAlloc<T>(n)` - heapAlloc through the allocator context.
function emitCtxAllocCall(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let n: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref n)?;
  cx.e.usesRuntime = true;

  const size = freshTemp(cx.e);
  emitBinOp(
    ref cx, size, "mul", "i64", n,
    Operand.Imm { value: uint64(elementSizeOfResult(ref cx, exprId)) }
  );
  const raw = freshTemp(cx.e);
  emitCtxAlloc(ref cx, raw, Operand.Temp { id: size });
  out = buildDescriptor(ref cx, Operand.Temp { id: raw }, n);
  return EmitResult.Ok;
}

// `ctxFree(a)` - return the bytes to the allocator they came from.
function emitCtxFreeCall(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let a: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref a)?;
  cx.e.usesRuntime = true;

  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, a, 0);
  emitCtxFree(ref cx, data);
  out = Operand.None;
  return EmitResult.Ok;
}

// `heapFree(a)` - free the data pointer. The descriptor is a value and needs no
// tearing down of its own.
function emitHeapFree(ref cx: Cx, expr: ASTNode, ref out: Operand): EmitResult {
  let a: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref a)?;
  cx.e.usesStringBuilder = true;

  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, a, 0);
  emitFree(ref cx, data);
  out = Operand.None;
  return EmitResult.Ok;
}

// `arraySlice(xs, start, end)` - a borrowing view, no copy.
//
//   %base = getelementptr <elem>, ptr %data, i64 %start
//   %len  = sub i64 %end, %start
//
// Out-of-range is the caller's problem, the same as an index read: the language
// does not specify a bounds check and adding one here would diverge.
function emitArraySlice(ref cx: Cx, expr: ASTNode, exprId: NodeId, ref out: Operand): EmitResult {
  let xs: Operand = Operand.None;
  let start: Operand = Operand.None;
  let end: Operand = Operand.None;
  emitIntrinsicArg(ref cx, expr, 0, ref xs)?;
  emitIntrinsicArg(ref cx, expr, 1, ref start)?;
  emitIntrinsicArg(ref cx, expr, 2, ref end)?;

  const data = freshTemp(cx.e);
  emitExtractValue(ref cx, data, ARRAY_DESCRIPTOR, xs, 0);
  const base = freshTemp(cx.e);
  emitGepElem(
    ref cx, base, elementLlvmTypeOfResult(ref cx, exprId),
    Operand.Temp { id: data }, "i64", start
  );
  const len = freshTemp(cx.e);
  emitBinOp(ref cx, len, "sub", "i64", end, start);

  out = buildDescriptor(ref cx, Operand.Temp { id: base }, Operand.Temp { id: len });
  return EmitResult.Ok;
}

// ----- shared shapes ---------------------------------------------------------

// A `{ ptr, i64 }` descriptor from a data pointer and a length. Every intrinsic
// that hands back an array ends here, so they cannot disagree about the layout.
function buildDescriptor(ref cx: Cx, data: Operand, len: Operand): Operand {
  const withData = freshTemp(cx.e);
  emitInsertValue(ref cx, withData, "undef", "ptr", data, 0);
  const withLen = freshTemp(cx.e);
  emitInsertValueTemp(ref cx, withLen, withData, "i64", len, 1);
  return Operand.Temp { id: withLen };
}

// The i-th argument of an intrinsic call, evaluated.
function emitIntrinsicArg(ref cx: Cx, expr: ASTNode, i: usize, ref out: Operand): EmitResult {
  if (expr.childA == 0) {
    return internalError("intrinsic call has no arguments", expr.name);
  }
  const args = nodeAt(cx.ast, expr.childA);
  if (i >= args.childCount) {
    return internalError("intrinsic call is missing an argument", expr.name);
  }
  return emitExpr(ref cx, childAt(cx.ast, args, i), ref out);
}

// The size in bytes of the element of the ARRAY this call returns.
function elementSizeOfResult(ref cx: Cx, exprId: NodeId): usize {
  switch (typeAt(cx.prog, resolvedTypeAt(ref cx, exprId))) {
    case Type.Array { elem: e }: { return sizeOfType(cx.prog, e); }
    default: { return 1; }
  }
}

function elementLlvmTypeOfResult(ref cx: Cx, exprId: NodeId): string {
  switch (typeAt(cx.prog, resolvedTypeAt(ref cx, exprId))) {
    case Type.Array { elem: e }: { return llvmType(cx.prog, e); }
    default: { return "i8"; }
  }
}
