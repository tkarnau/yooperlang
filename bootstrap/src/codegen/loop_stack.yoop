module codegen;

// Where `break` and `continue` jump to.
//
// A stack, because loops nest and each jump targets the INNERMOST one. Pushed by
// the loop lowering in flow.yoop and popped when the loop closes, so a jump
// only ever sees loops that actually enclose it. Pass D already refused a jump
// with no enclosing loop, so an empty stack here is an internal error.
//
// `continueTarget` differs by loop kind, which is the whole reason this carries
// two labels instead of one:
//   while - the condition block, so the test runs again
//   for   - the STEP block, so the counter advances before the test

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";

export type LoopLabels {
  continueTarget: usize,
  breakTarget: usize,
}

export type LoopStack propagates<disposable> {
  frames: Vec<LoopLabels>,
}

export function loopStackNew(): LoopStack propagates<disposable> {
  return { frames: vec.vecNew(4) };
}

export function loopPush(ref cx: Cx, continueTarget: usize, breakTarget: usize): void {
  vec.vecPush(ref cx.loops.frames, { continueTarget: continueTarget, breakTarget: breakTarget });
}

export function loopPop(ref cx: Cx): void {
  if (cx.loops.frames.len > 0) {
    cx.loops.frames.len -= 1;
  }
}

export function innermostLoop(ref cx: Cx): LoopLabels {
  if (cx.loops.frames.len == 0) {
    return { continueTarget: 0, breakTarget: 0 };
  }
  return vec.vecGet(ref cx.loops.frames, cx.loops.frames.len - 1);
}

export function insideLoop(ref cx: Cx): bool {
  return cx.loops.frames.len > 0;
}
