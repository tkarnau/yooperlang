module codegen;

// Where a local or parameter lives in the emitted function.
//
// Every one gets an `alloca` and is read back with a `load`. That is the
// unoptimized-but-always-correct lowering: no SSA construction, no phi nodes,
// and it stays correct once branches exist. LLVM's mem2reg promotes them, so
// the cost is IR size, not runtime.
//
// The allocas are HOISTED into the entry block (see Emitter.prologue). An
// alloca must dominate every load, and one emitted inside an `if` arm does not
// dominate a use after the join.

import { Map }, * as map from "std/collections/map.yoop";
import { disposable, Disposable } from "std/core/kinds.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { Option } from "std/core/types.yoop";

export type LocalSlot {
  ty: string,   // the LLVM type stored there
  // Slot names must be unique across the WHOLE function, since every alloca is
  // hoisted into one entry block and two sibling branches may each declare `a`.
  // The number is what makes them unique; the name is spelled out at each use
  // as `%<name>.<id>.addr`, so no string is ever built for it.
  // Slot id 0 is RESERVED and means "the incoming argument pointer is the
  // slot" - a `ref` parameter. `nextSlot` is incremented before it is used, so
  // no ordinary slot ever gets 0; the same reserved-zero idiom SymbolId and
  // DeclId use. `slot()` writes `%<name>.arg` for it instead of
  // `%<name>.<id>.addr`, which is why nothing else in codegen has to change:
  // every load and store only ever needed an ADDRESS, and this is one.
  id: usize,
}

// A slot id that names the incoming argument pointer rather than an alloca.
export const ARG_PTR_SLOT: usize = 0;

// One name a block declared, and whatever that name meant just before it did.
// A block that SHADOWS an outer binding has to put the outer one back on the
// way out, not merely stop resolving its own - `let v = 7; if (c) { let v = 99;
// } total += v;` reads the outer slot after the branch, and a plain remove
// would leave `v` resolving to nothing at all.
type DeclaredName {
  name: string,
  // False when the name was free before this block declared it, in which case
  // leaving the block removes it outright.
  hadPrev: bool,
  prev: LocalSlot,
}

export type FnLocals propagates<disposable> {
  slots: Map<string, LocalSlot>,
  nextSlot: usize,
  // The names declared in each open block, so leaving one can undo them.
  //
  // The ALLOCAS stay - they are hoisted into `entry:` and a slot id is never
  // reused - but the NAME has to go back to what it meant, or a binding that
  // shadowed something in an inner block goes on shadowing it forever.
  blockNames: Vec<Vec<DeclaredName>>,
}

export function localsNew(): FnLocals propagates<disposable> {
  let blocks: Vec<Vec<DeclaredName>> = vec.vecNew(4);
  return { slots: map.mapNew(0, map.stringKeyOps()), nextSlot: 0, blockNames: blocks };
}

export function localsPushBlock(ref l: FnLocals): void {
  let fresh: Vec<DeclaredName> = vec.vecNew(2);
  vec.vecPush(ref l.blockNames, fresh);
}

// Undo the innermost block's declarations, innermost-last first so a name
// declared twice in one block unwinds to the right one. Their slots survive.
export function localsPopBlock(ref l: FnLocals): void {
  if (l.blockNames.len == 0) {
    return;
  }
  let names = vec.vecGet(ref l.blockNames, l.blockNames.len - 1);
  let i: usize = names.len;
  while (i > 0) {
    i -= 1;
    const d: DeclaredName = vec.vecGet(ref names, i);
    if (d.hadPrev) {
      map.mapInsert(ref l.slots, d.name, d.prev);
    } else {
      map.mapRemove(ref l.slots, d.name);
    }
  }
  Disposable.dispose(ref names);
  l.blockNames.len -= 1;
}

// Called BEFORE the new slot is inserted, so `mapGet` still answers with what
// the name meant on the way in.
function localsNoteName(ref l: FnLocals, name: string): void {
  if (l.blockNames.len == 0) {
    return;
  }
  let top = vec.vecGet(ref l.blockNames, l.blockNames.len - 1);
  switch (map.mapGet(ref l.slots, name)) {
    case Option.Some { value: old }: {
      vec.vecPush(ref top, { name: name, hadPrev: true, prev: old });
    }
    case Option.None: {
      vec.vecPush(ref top, { name: name, hadPrev: false, prev: { ty: "", id: 0 } });
    }
  }
  vec.vecSet(ref l.blockNames, l.blockNames.len - 1, top);
}

// Emits the alloca into the function prologue and records the slot.
export function declareLocal(ref cx: Cx, name: string, ty: string): LocalSlot {
  cx.locals.nextSlot += 1;
  const info: LocalSlot = { ty: ty, id: cx.locals.nextSlot };
  emitAlloca(ref cx, name, info.id, ty);
  localsNoteName(cx.locals, name);
  map.mapInsert(ref cx.locals.slots, name, info);
  return info;
}

// A `ref` parameter: the incoming pointer IS the slot, so there is no alloca to
// emit and nothing to spill. `pointeeTy` is what the pointer points at, because
// that is what every load and store through the slot moves.
export function declareRefParam(ref cx: Cx, name: string, pointeeTy: string): LocalSlot {
  const info: LocalSlot = { ty: pointeeTy, id: ARG_PTR_SLOT };
  localsNoteName(cx.locals, name);
  map.mapInsert(ref cx.locals.slots, name, info);
  return info;
}

export function lookupLocal(ref l: FnLocals, name: string): Option<LocalSlot> {
  return map.mapGet(ref l.slots, name);
}

// The slot name compiler-introduced temporaries share. Each still gets a unique
// number, so `%sc.4.addr` and `%sc.9.addr` never collide.
export const TEMP_SLOT_NAME: string = "sc";

// A stack slot with no user-visible name, for a value codegen needs to write on
// two different paths and read once after they join - what `&&` and `||` need
// instead of a phi node.
export function declareAnonSlot(ref cx: Cx, ty: string): LocalSlot {
  cx.locals.nextSlot += 1;
  const info: LocalSlot = { ty: ty, id: cx.locals.nextSlot };
  emitAlloca(ref cx, TEMP_SLOT_NAME, info.id, ty);
  return info;
}

// Backing storage for an array literal: `alloca [N x T]`, hoisted like every
// other slot. The literal's descriptor points at element 0 of this.
export function declareArraySlot(ref cx: Cx, elemTy: string, count: usize): LocalSlot {
  cx.locals.nextSlot += 1;
  const info: LocalSlot = { ty: elemTy, id: cx.locals.nextSlot };
  emitAllocaArray(ref cx, TEMP_SLOT_NAME, info.id, elemTy, count);
  return info;
}
