module codegen;

// What a symbol is CALLED in the emitted module.
//
// One LLVM module holds every yoop module in the graph, so `add` in two of them
// would be one symbol and one of the two definitions would win silently. Every
// symbol therefore carries its home module:
//
//   function `add` in module `mathx_1`  ->  @mathx_1__add
//   type `Point` in module `mathx_1`    ->  %struct.mathx_1__Point
//
// Two symbols keep their bare C name, and both are decided here rather than at
// the emit sites: `main`, which the linker looks for by that exact spelling,
// and `printf`, which is libc's. A home module of "" means exactly that.

import * as map from "std/collections/map.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Option } from "std/core/types.yoop";
import * as str from "std/core/strings.yoop";
import { ASTNode, NodeId, nodeAt } from "../ast";
import { Symbol, moduleIdOf, symbolAt, funcInstanceAt, genericAt, methodSymbolName, nominalModuleOf } from "../typecheck";

// Between the module and the name. Long enough that a module ending in `_` and
// a name starting with one cannot collide with an ordinary identifier.
export const SYMBOL_MODULE_SEPARATOR: string = "__";

// A symbol as it is spelled in the IR, in the two pieces emitCall and
// emitFunctionOpen append. `home` is "" for a bare C name.
export type SymbolName {
  home: string,
  name: string,
}

// The symbol a call expression lands on.
//
// Both halves can differ from what the call site wrote, and for two different
// reasons:
//
//   ns.fn()        the home is whatever module `ns` names; the member name is
//                  already the export name, since a namespace has no aliases
//   fn()           `import { tag as mathTag }` calls `mathTag` here and has to
//                  reach mathx's `tag`, so the name comes from the import table
//                  too - the local name would emit a call to a symbol nothing
//                  defines
//
// An unqualified name absent from `importedFrom` is this module's own. That is
// the whole rule, and it is why pass B records the table.

// The symbol a METHOD is defined under: the owner's module, and a name that
// carries the owner. See methodSymbolName in typecheck/traits.yoop for why the
// trait is not in it.
export function methodDefinitionSymbol(ref cx: Cx, declNode: ASTNode): SymbolName {
  const owner = methodOwnerOf(ref cx, declNode);
  return {
    home: moduleIdOf(cx.prog, nominalModuleOf(cx.prog, owner)),
    name: methodSymbolName(cx.prog, owner, declNode.name),
  };
}

// See the note above methodDefinitionSymbol for the rules this follows.
export function calleeSymbol(ref cx: Cx, expr: ASTNode, exprId: NodeId): SymbolName {
  // `Display.toString(ref p)` - pass D recorded which type the receiver
  // resolved to, and that plus the method name IS the symbol.
  //
  // The recorded type can be an opaque `T`, when the call is a bounded generic
  // body dispatching through its bound. That is the same "decoration is written
  // in terms of the parameters" rule every node type follows, so it goes
  // through the same substitution - which is what makes one checked body emit
  // `Token__compare` in one instance and `Num__compare` in the next.
  switch (map.mapGet(ref cx.tm.calleeReceiver, uint64(exprId))) {
    case Option.Some { value: recorded }: {
      const receiver = resolvedType(ref cx, recorded);
      return {
        home: moduleIdOf(cx.prog, nominalModuleOf(cx.prog, receiver)),
        name: methodSymbolName(cx.prog, receiver, expr.name),
      };
    }
    case Option.None: { }
  }

  // A call to a GENERIC function names the monomorphization pass D picked, not
  // the decl - `identity` becomes `identity_int32`. The home is the module that
  // DECLARED it, so an instance created from an importing module still lands on
  // one symbol.
  switch (map.mapGet(ref cx.tm.calleeInstance, uint64(exprId))) {
    case Option.Some { value: index }: {
      // A generic calling a generic recorded `partitionYoop_T`, because `T` was
      // all the body knew. Which one it really means depends on the instance
      // this call is being emitted IN, so the recorded arguments substitute
      // exactly as a node's recorded type does.
      let inst = funcInstanceAt(cx.prog, resolvedFuncInstance(ref cx, index));
      return { home: moduleIdOf(cx.prog, genericAt(cx.prog, inst.origin).module), name: inst.name };
    }
    case Option.None: { }
  }

  if (expr.childB != 0) {
    return { home: qualifyingModuleOf(ref cx, expr.childB), name: expr.name };
  }
  if (keepsCName(expr.name) || isExtern(ref cx, expr.name)) {
    return { home: "", name: expr.name };
  }
  switch (map.mapGet(ref cx.tm.importedFrom, expr.name)) {
    case Option.Some { value: origin }: {
      return { home: origin.moduleId, name: origin.exportName };
    }
    case Option.None: {
      return { home: cx.tm.moduleId, name: expr.name };
    }
  }
}

// A SymbolName as the linker spells it - `mathx_1__add`, or a bare `main`.
//
// The one place a symbol is rendered to a string rather than pushed into the
// emit buffer, because DWARF's `linkageName:` is an attribute of a metadata
// node and not a line of IR.
export function debugSymbolText(symbol: SymbolName): string {
  if (symbol.home.len == 0) {
    return symbol.name;
  }
  disposable parts: Vec<string> = vec.vecNew(3);
  vec.vecPush(ref parts, symbol.home);
  vec.vecPush(ref parts, SYMBOL_MODULE_SEPARATOR);
  vec.vecPush(ref parts, symbol.name);
  return str.stringConcatAll(vec.vecAsArray(ref parts));
}

// The symbol a module-level `let` is READ and WRITTEN through.
//
// A global has ONE definition, in the module that declared it, so an importing
// module's read has to name that module and not itself - `export let counter`
// read from another file is `@counter_1__counter`, never `@main_0__counter`.
// Same rule and same table as an imported CALL, which is why this is the two
// lines it is rather than anything the emit sites have to know about.
export function globalSymbol(ref cx: Cx, name: string): SymbolName {
  switch (map.mapGet(ref cx.tm.importedFrom, name)) {
    case Option.Some { value: origin }: {
      return { home: origin.moduleId, name: origin.exportName };
    }
    case Option.None: {
      return { home: cx.tm.moduleId, name: name };
    }
  }
}

// The mangling id of the module an `ns.fn()` base names. Pass D already proved
// the base is a namespace, so a miss here is an internal error rather than a
// user one - and "" is the safest thing to emit, since it fails at link time
// with the bare name rather than silently calling the wrong function.
function qualifyingModuleOf(ref cx: Cx, baseId: NodeId): string {
  const base = nodeAt(cx.ast, baseId);
  switch (map.mapGet(ref cx.tm.names, base.name)) {
    case Option.Some { value: symId }: {
      switch (symbolAt(cx.prog, symId)) {
        case Symbol.Namespace { module: mi }: { return moduleIdOf(cx.prog, mi); }
        default: { return ""; }
      }
    }
    case Option.None: { return ""; }
  }
}

// The symbol a DEFINITION is emitted under: always the module being walked,
// under the name it was declared with, except for the entry point.
export function definitionSymbol(ref cx: Cx, name: string): SymbolName {
  // A monomorphization is DEFINED under the instance's name, which is what the
  // call sites above go looking for.
  if (cx.instance != NO_FUNC_INSTANCE) {
    let inst = funcInstanceAt(cx.prog, cx.instance);
    return { home: cx.tm.moduleId, name: inst.name };
  }
  // `main`, and an `export "C" function` - which pass A recorded in
  // `externNames` for exactly this reason. Both are DEFINED under the bare
  // spelling a C caller has to use.
  if (keepsCName(name) || isExtern(ref cx, name)) {
    return { home: "", name: name };
  }
  return { home: cx.tm.moduleId, name: name };
}

// `main` is the C entry point and `printf` is libc s. Mangling either one
// produces IR that compiles and then fails to link, which is a bad place to
// find out.
function keepsCName(name: string): bool {
  return str.stringEq(name, "main") || str.stringEq(name, "printf");
}

// An `extern` declares a symbol that already exists somewhere else, so its NAME
// is the linker's spelling and mangling it would call something that is not
// there. Pass A recorded which names those are; the Symbol alone cannot say,
// since an extern is an ordinary `Symbol.Func`.
function isExtern(ref cx: Cx, name: string): bool {
  return map.mapContainsKey(ref cx.tm.externNames, name);
}
