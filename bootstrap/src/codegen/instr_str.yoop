module codegen;

// The libc calls a built string is made of: measure, allocate, copy, terminate,
// and integer-to-decimal.
//
// A yoop `string` is a NUL-terminated `ptr`, the same thing C means by one, so
// every operation here is the C one. They live in their own file because they
// are the only instructions in codegen that reach for libc beyond printf, and
// keeping them together is what makes the set auditable - see template.yoop for
// why it is this set and not std's.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Text }, * as text from "std/core/text.yoop";

// The printf-family signature LLVM wants spelled out at a variadic call site.
const SPRINTF_SIGNATURE: string = "i32 (ptr, ptr, ...)";

//   @m__COUNT = internal global i32 0, align 8
//
// A module-level `let`. `internal` because a yoop module is not a C library:
// nothing outside the emitted program links against it by name, and internal
// linkage lets LLVM see every use.
export function emitGlobalVariable(ref e: Emitter, home: string, name: string, ty: string, init: int64): void {
  text.push(ref e.globals, "@");
  text.push(ref e.globals, home);
  text.push(ref e.globals, SYMBOL_MODULE_SEPARATOR);
  text.push(ref e.globals, name);
  text.push(ref e.globals, " = internal global ");
  text.push(ref e.globals, ty);
  text.push(ref e.globals, " ");
  text.pushInt(ref e.globals, init);
  text.push(ref e.globals, ", align 8\n");
}

//   @m__state = internal global %struct.m__ServeState zeroinitializer, align 8
//
// The same global with no value to write into it yet. A module-level `let`
// whose initializer is not a literal starts zeroed and is filled at run time by
// the module's init function - see module_init.yoop. Also the only legal form
// for a global of a type that has no immediate at all: a struct, a variant, an
// array descriptor.
export function emitGlobalZeroed(ref e: Emitter, home: string, name: string, ty: string): void {
  text.push(ref e.globals, "@");
  text.push(ref e.globals, home);
  text.push(ref e.globals, SYMBOL_MODULE_SEPARATOR);
  text.push(ref e.globals, name);
  text.push(ref e.globals, " = internal global ");
  text.push(ref e.globals, ty);
  text.push(ref e.globals, " zeroinitializer, align 8\n");
}

//   %t2 = load i32, ptr @m__COUNT
export function emitLoadGlobal(ref cx: Cx, dest: usize, ty: string, home: string, name: string): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = load ");
  part(ref cx, ty);
  part(ref cx, ", ptr @");
  part(ref cx, home);
  part(ref cx, SYMBOL_MODULE_SEPARATOR);
  part(ref cx, name);
  endInstr(ref cx);
}

//   store i32 %t3, ptr @m__COUNT
export function emitStoreGlobal(ref cx: Cx, ty: string, value: Operand, home: string, name: string): void {
  startInstr(ref cx);
  part(ref cx, "store ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, value);
  part(ref cx, ", ptr @");
  part(ref cx, home);
  part(ref cx, SYMBOL_MODULE_SEPARATOR);
  part(ref cx, name);
  endInstr(ref cx);
}

//   %t1 = call i64 @strlen(ptr %t0)
export function emitStrlen(ref cx: Cx, dest: usize, str: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call i64 @strlen(ptr ");
  operand(ref cx, str);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call void @free(ptr %t2)
export function emitFree(ref cx: Cx, ptr: usize): void {
  startInstr(ref cx);
  part(ref cx, "call void @free(ptr ");
  temp(ref cx, ptr);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t2 = call ptr @malloc(i64 %t1)
export function emitMalloc(ref cx: Cx, dest: usize, size: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call ptr @malloc(i64 ");
  operand(ref cx, size);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call ptr @memcpy(ptr %t3, ptr %t0, i64 %t1)
export function emitMemcpy(ref cx: Cx, dst: usize, src: Operand, len: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call ptr @memcpy(ptr ");
  temp(ref cx, dst);
  part(ref cx, ", ptr ");
  operand(ref cx, src);
  part(ref cx, ", i64 ");
  operand(ref cx, len);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t4 = getelementptr i8, ptr %t2, i64 %t3
//
// Byte arithmetic on an existing buffer, which is what stepping a write cursor
// through the destination is.
export function emitGepByteOffset(ref cx: Cx, dest: usize, base: usize, offset: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = getelementptr i8, ptr ");
  temp(ref cx, base);
  part(ref cx, ", i64 ");
  operand(ref cx, offset);
  endInstr(ref cx);
}

//   store i8 0, ptr %t5
export function emitStoreNulByte(ref cx: Cx, addr: usize): void {
  startInstr(ref cx);
  part(ref cx, "store i8 0, ptr ");
  temp(ref cx, addr);
  endInstr(ref cx);
}

//   call i32 (ptr, ptr, ...) @sprintf(ptr %t2, ptr @.str.0, i64 %t1)
//
// The result is ignored: the buffer is sized for the widest possible i64
// rendering, so there is no truncation to detect. `fmt` is `%lld` or `%llu`.
export function emitSprintfInt(ref cx: Cx, buf: usize, fmt: usize, value: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call ");
  part(ref cx, SPRINTF_SIGNATURE);
  part(ref cx, " @sprintf(ptr ");
  temp(ref cx, buf);
  part(ref cx, ", ptr ");
  operand(ref cx, Operand.StrRef { id: fmt });
  part(ref cx, ", i64 ");
  operand(ref cx, value);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   call i32 (ptr, ptr, ...) @sprintf(ptr %t2, ptr @.str.0, double %t1)
//
// The float twin. Same call, and the ONLY difference is that the value rides in
// a `double` slot rather than an `i64` - which is C's variadic promotion, so
// there is no float32 spelling here at all and the caller widens first.
export function emitSprintfFloat(ref cx: Cx, buf: usize, fmt: usize, value: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call ");
  part(ref cx, SPRINTF_SIGNATURE);
  part(ref cx, " @sprintf(ptr ");
  temp(ref cx, buf);
  part(ref cx, ", ptr ");
  operand(ref cx, Operand.StrRef { id: fmt });
  part(ref cx, ", double ");
  operand(ref cx, value);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t4 = select i1 %t3, ptr @.str.1, ptr @.str.2
export function emitSelectPtr(
  ref cx: Cx,
  dest: usize,
  cond: Operand,
  whenTrue: usize,
  whenFalse: usize
): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = select i1 ");
  operand(ref cx, cond);
  part(ref cx, ", ptr ");
  operand(ref cx, Operand.StrRef { id: whenTrue });
  part(ref cx, ", ptr ");
  operand(ref cx, Operand.StrRef { id: whenFalse });
  endInstr(ref cx);
}

//   %t2 = call ptr @yoop_ctx_alloc(i64 %t1, i64 8)
//
// The allocator-context allocation. Alignment is 8, which satisfies every yoop
// scalar and struct today - the same constant the reference passes.
export function emitCtxAlloc(ref cx: Cx, dest: usize, size: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call ptr @yoop_ctx_alloc(i64 ");
  operand(ref cx, size);
  part(ref cx, ", i64 8)");
  endInstr(ref cx);
}

//   call void @yoop_ctx_free(ptr %t3)
export function emitCtxFree(ref cx: Cx, ptr: usize): void {
  startInstr(ref cx);
  part(ref cx, "call void @yoop_ctx_free(ptr ");
  temp(ref cx, ptr);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t1 = call i32 @yoop_errno_get()
export function emitErrnoGet(ref cx: Cx, dest: usize): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call i32 @yoop_errno_get()");
  endInstr(ref cx);
}

//   call void @yoop_errno_set(i32 %t1)
export function emitErrnoSet(ref cx: Cx, value: Operand): void {
  startInstr(ref cx);
  part(ref cx, "call void @yoop_errno_set(i32 ");
  operand(ref cx, value);
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t2 = call ptr @yoop_errno_message(i32 %t1)
export function emitErrnoMessage(ref cx: Cx, dest: usize, code: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = call ptr @yoop_errno_message(i32 ");
  operand(ref cx, code);
  part(ref cx, ")");
  endInstr(ref cx);
}

// The declarations every runtime call above needs.
//
//   declare ptr @yoop_ctx_alloc(i64, i64)
//   declare void @yoop_ctx_free(ptr)
//   declare i32 @yoop_errno_get()
//   declare void @yoop_errno_set(i32)
//   declare ptr @yoop_errno_message(i32)
//
// Through `externDeclare` rather than straight into the globals, because a
// user's own `extern "C" from "yoop_runtime"` block may have declared the same
// symbol already. Returns "" or the refusal - see extern_table.yoop.
export function emitRuntimeDeclarations(ref e: Emitter): string {
  let err = externDeclare(ref e, "yoop_ctx_alloc", "ptr", ["i64", "i64"], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "yoop_ctx_free", "void", ["ptr"], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "yoop_errno_get", "i32", [], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "yoop_errno_set", "void", ["i32"], false);
  if (err.len > 0) { return err; }
  return externDeclare(ref e, "yoop_errno_message", "ptr", ["i32"], false);
}

// The declarations the calls above need, emitted once per module and only when
// something actually built a string.
//
//   declare i64 @strlen(ptr)
//   declare ptr @malloc(i64)
//   declare void @free(ptr)
//   declare ptr @memcpy(ptr, ptr, i64)
//   declare i32 @sprintf(ptr, ptr, ...)
//
// This is the half of 2.1 that used to collide: std/core/alloc.yoop declares
// its own `malloc` and `free`, and both spell exactly these two lines - so
// they are now REUSED rather than emitted twice.
export function emitStringBuilderDeclarations(ref e: Emitter): string {
  let err = externDeclare(ref e, "strlen", "i64", ["ptr"], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "malloc", "ptr", ["i64"], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "free", "void", ["ptr"], false);
  if (err.len > 0) { return err; }
  err = externDeclare(ref e, "memcpy", "ptr", ["ptr", "ptr", "i64"], false);
  if (err.len > 0) { return err; }
  return externDeclare(ref e, "sprintf", "i32", ["ptr", "ptr"], true);
}
