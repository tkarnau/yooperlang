module codegen;

// One function per LLVM instruction this compiler emits.
//
// Read this file to learn what IR the bootstrap produces; read expr.yoop and
// stmt.yoop to learn WHEN. That split is deliberate - the walking code should
// read as "load the local, then multiply", not as a pile of string appends.
//
// House rules for everything in here:
//   * Named after the IR it emits (`emitLoad`), never after the AST it came
//     from (`emitIdentExpr`).
//   * A comment showing the exact line it produces. That sample is the
//     documentation - if you change the format, change the sample.
//   * Takes operands and types already decided by the caller. No lookups, no
//     AST, no decisions.
//   * Appends piece by piece. A template literal here would be one malloc per
//     instruction (docs/writing_yoop.md 3.1).

import * as text from "std/core/text.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";

// ----- terminators ---------------------------------------------------------

//   ret i32 %t3
export function emitRet(ref cx: Cx, ty: string, value: Operand): void {
  startInstr(ref cx);
  part(ref cx, "ret ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, value);
  endInstr(ref cx);
}

//   ret void
export function emitRetVoid(ref cx: Cx): void {
  startInstr(ref cx);
  part(ref cx, "ret void");
  endInstr(ref cx);
}

//   ret i32 0
//
// The exit status of a `main` declared `void`, which is emitted as
// `define i32 @main()` - see Cx.voidMain. C says a missing `return` in `main`
// means 0, so this is what both the fall-out-the-bottom and a bare `return;`
// lower to. Its own emitter rather than `emitRet` with an immediate, because
// nothing here is a choice the caller made: the type and the value are both
// fixed by C's entry-point ABI.
export function emitRetMainZero(ref cx: Cx): void {
  startInstr(ref cx);
  part(ref cx, "ret ");
  part(ref cx, MAIN_EXIT_TYPE);
  part(ref cx, " 0");
  endInstr(ref cx);
}

// ----- memory --------------------------------------------------------------

//   %count.1.addr = alloca i32
//
// Goes into the PROLOGUE buffer, not the instruction stream: every alloca is
// hoisted to the top of `entry:` so it dominates uses in any branch.
export function emitAlloca(ref cx: Cx, name: string, id: usize, ty: string): void {
  prologuePart(ref cx, "  ");
  prologueSlot(ref cx, name, id);
  prologuePart(ref cx, " = alloca ");
  prologuePart(ref cx, ty);
  prologuePart(ref cx, "\n");
}

//   %sc.1.addr = alloca [3 x i32]
//
// Fixed-size backing store for an array literal. Prologue, like every alloca.
export function emitAllocaArray(
  ref cx: Cx,
  name: string,
  id: usize,
  elemTy: string,
  count: usize
): void {
  prologuePart(ref cx, "  ");
  prologueSlot(ref cx, name, id);
  prologuePart(ref cx, " = alloca [");
  prologueUint(ref cx, count);
  prologuePart(ref cx, " x ");
  prologuePart(ref cx, elemTy);
  prologuePart(ref cx, "]\n");
}

//   store i32 42, ptr %count.addr
export function emitStore(ref cx: Cx, ty: string, value: Operand, name: string, id: usize): void {
  startInstr(ref cx);
  part(ref cx, "store ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, value);
  part(ref cx, ", ptr ");
  slot(ref cx, name, id);
  endInstr(ref cx);
}

//   %t4 = load i32, ptr %count.addr
export function emitLoad(ref cx: Cx, dest: usize, ty: string, name: string, id: usize): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = load ");
  part(ref cx, ty);
  part(ref cx, ", ptr ");
  slot(ref cx, name, id);
  endInstr(ref cx);
}

//   %t6 = load %struct.Point, ptr %sc.1.addr
//
// Same as emitLoad, named for what it is used for: pulling a whole aggregate
// value out of its slot.
export function emitLoadFromSlot(
  ref cx: Cx,
  dest: usize,
  ty: string,
  slotName: string,
  slotId: usize
): void {
  emitLoad(ref cx, dest, ty, slotName, slotId);
}

//   store i32 %a.arg, ptr %a.addr
//
// The parameter spill. Separate from emitStore because the source is an incoming
// argument register, not an Operand any expression produced.
export function emitStoreArg(ref cx: Cx, ty: string, name: string, id: usize): void {
  startInstr(ref cx);
  part(ref cx, "store ");
  part(ref cx, ty);
  part(ref cx, " %");
  part(ref cx, name);
  part(ref cx, ".arg, ptr ");
  slot(ref cx, name, id);
  endInstr(ref cx);
}

// ----- arithmetic ----------------------------------------------------------

//   %t5 = mul i32 %t4, 2
export function emitBinOp(
  ref cx: Cx,
  dest: usize,
  op: string,
  ty: string,
  lhs: Operand,
  rhs: Operand
): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = ");
  part(ref cx, op);
  part(ref cx, " ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, lhs);
  part(ref cx, ", ");
  operand(ref cx, rhs);
  endInstr(ref cx);
}

//   %t4 = zext i32 %t3 to i64
//   %t5 = fpext float %t4 to double
//   %t6 = fptosi double %t5 to i32
//
// A numeric conversion. `op` is trunc / zext / sext for the integer widths, and
// sitofp / uitofp / fptosi / fptoui / fpext / fptrunc once a float is on either
// side - every one of them has this exact `<op> <from> <val> to <to>` shape, so
// there is one emitter and vocab.yoop picks the word. The name stayed
// `emitIntCast` because renaming it would touch a dozen call sites for no
// change in what it writes.
export function emitIntCast(
  ref cx: Cx,
  dest: usize,
  op: string,
  fromTy: string,
  value: Operand,
  toTy: string
): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = ");
  part(ref cx, op);
  part(ref cx, " ");
  part(ref cx, fromTy);
  part(ref cx, " ");
  operand(ref cx, value);
  part(ref cx, " to ");
  part(ref cx, toTy);
  endInstr(ref cx);
}

// ----- comparison ----------------------------------------------------------

//   %t6 = icmp slt i32 %t4, %t5
//
// Produces an i1. `pred` is the LLVM predicate (`slt`, `eq`, ...) and `ty` is
// the type of the OPERANDS, not of the result.
export function emitICmp(
  ref cx: Cx,
  dest: usize,
  pred: string,
  ty: string,
  lhs: Operand,
  rhs: Operand
): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = icmp ");
  part(ref cx, pred);
  part(ref cx, " ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, lhs);
  part(ref cx, ", ");
  operand(ref cx, rhs);
  endInstr(ref cx);
}

//   %t6 = fcmp olt double %t4, %t5
//
// The float twin, and it also produces an i1. The predicate spelling is the
// only difference - `olt` rather than `slt` - but the OPCODE differs too, and
// an icmp over two doubles is invalid IR rather than a wrong answer.
export function emitFCmp(
  ref cx: Cx,
  dest: usize,
  pred: string,
  ty: string,
  lhs: Operand,
  rhs: Operand
): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = fcmp ");
  part(ref cx, pred);
  part(ref cx, " ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, lhs);
  part(ref cx, ", ");
  operand(ref cx, rhs);
  endInstr(ref cx);
}

//   %t7 = fneg double %t6
//
// Unary minus on a float. A single operand, unlike the integer form which is a
// subtraction from zero - and not interchangeable with one: `0.0 - 0.0` is +0.0
// while `fneg 0.0` is -0.0.
export function emitFNeg(ref cx: Cx, dest: usize, ty: string, value: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = fneg ");
  part(ref cx, ty);
  part(ref cx, " ");
  operand(ref cx, value);
  endInstr(ref cx);
}

//   %t7 = xor i1 %t6, true
//
// Logical not. `xor ... true` is the idiomatic i1 negation - shorter than an
// icmp against zero and what clang itself emits.
export function emitNot(ref cx: Cx, dest: usize, value: Operand): void {
  startInstr(ref cx);
  temp(ref cx, dest);
  part(ref cx, " = xor i1 ");
  operand(ref cx, value);
  part(ref cx, ", true");
  endInstr(ref cx);
}

// ----- functions -----------------------------------------------------------

// Opens the function: the signature line and `entry:`. Both go to the module
// buffer, because the hoisted allocas and the instruction stream are appended
// after them by emitFunctionClose.
//
//   define i32 @mathx_1__add(i32 %a.arg, i32 %b.arg) {
//   entry:
//
// `homeModule` is the mangling prefix, or "" for a symbol that keeps its bare C
// name. Which one it is was decided in mangle.yoop; this just spells it.
export function emitFunctionOpen(
  ref cx: Cx,
  homeModule: string,
  name: string,
  retTy: string,
  ref params: Vec<ParamInfo>
): void {
  headerPart(ref cx, "define ");
  headerPart(ref cx, retTy);
  headerPart(ref cx, " @");
  if (homeModule.len > 0) {
    headerPart(ref cx, homeModule);
    headerPart(ref cx, SYMBOL_MODULE_SEPARATOR);
  }
  headerPart(ref cx, name);
  headerPart(ref cx, "(");
  let i: usize = 0;
  while (i < params.len) {
    const p = vec.vecGet(ref params, i);
    if (i > 0) {
      headerPart(ref cx, ", ");
    }
    headerPart(ref cx, p.ty);
    headerPart(ref cx, " %");
    headerPart(ref cx, p.name);
    headerPart(ref cx, ".arg");
    i += 1;
  }
  headerPart(ref cx, ") {");
  headerEnd(ref cx);
  headerPart(ref cx, "entry:");
  headerEnd(ref cx);
}

//   define internal void @main_0__module_init0() {
//   entry:
//
// A parameter-free, result-free definition, which is what a module's init
// function is. `internal` because nothing outside the emitted program calls it:
// `main` does, once, before any user code. The symbol arrives already spelled
// out, module prefix and all, because the plan walk built it before any of
// these were emitted - see module_init.yoop.
export function emitInternalVoidFunctionOpen(ref cx: Cx, symbol: string): void {
  headerPart(ref cx, "define internal void @");
  headerPart(ref cx, symbol);
  headerPart(ref cx, "() {");
  headerEnd(ref cx);
  headerPart(ref cx, "entry:");
  headerEnd(ref cx);
}

// The COROUTINE form of the same line. Three differences, and each is the async
// ABI saying one thing:
//
//   define ptr @m__fetch(i32 %n.arg, ptr %__ret) presplitcoroutine {
//   entry:
//
//   * `ptr` return - an async function hands back its HANDLE, not its result.
//   * a trailing `ptr %__ret` - the caller-owned slot the result is written
//     into. A `void` async function takes it too and never writes it, so there
//     is one ABI rather than two.
//   * `presplitcoroutine` - without it the coro passes leave the intrinsics in
//     place and clang rejects the module.
export function emitCoroFunctionOpen(
  ref cx: Cx,
  homeModule: string,
  name: string,
  ref params: Vec<ParamInfo>
): void {
  headerPart(ref cx, "define ptr @");
  if (homeModule.len > 0) {
    headerPart(ref cx, homeModule);
    headerPart(ref cx, SYMBOL_MODULE_SEPARATOR);
  }
  headerPart(ref cx, name);
  headerPart(ref cx, "(");
  let i: usize = 0;
  while (i < params.len) {
    const p = vec.vecGet(ref params, i);
    headerPart(ref cx, p.ty);
    headerPart(ref cx, " %");
    headerPart(ref cx, p.name);
    headerPart(ref cx, ".arg, ");
    i += 1;
  }
  headerPart(ref cx, "ptr %");
  headerPart(ref cx, CORO_RET_PARAM);
  headerPart(ref cx, ")");
  headerPart(ref cx, CORO_FN_ATTR);
  headerPart(ref cx, " {");
  headerEnd(ref cx);
  headerPart(ref cx, "entry:");
  headerEnd(ref cx);
}

// Closes it, assembling the pieces into the module: the hoisted allocas first,
// then the instruction stream, then `}`.
export function emitFunctionClose(ref cx: Cx): void {
  flushFunction(cx.e);
}

//   %t7 = call i32 @main_2__answer()
//   call void @mathx_1__doThing()
//
// `dest` is ignored when `retTy` is void. The return type is all the callee's
// type contributes: LLVM reads the parameter types off the arguments, so an
// ordinary call never has to spell the signature. `calleeHome` is the callee's
// mangling prefix, or "" for a bare C name.
export function emitCall(
  ref cx: Cx,
  dest: usize,
  retTy: string,
  calleeHome: string,
  calleeName: string,
  ref args: Vec<CallArg>
): void {
  startInstr(ref cx);
  callResult(ref cx, dest, retTy);
  part(ref cx, retTy);
  callTail(ref cx, calleeHome, calleeName, ref args);
}

//   %t8 = call i32 (ptr, ...) @printf(ptr @.str.0, i32 %t7)
//   %t4 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %t1, i64 64, ptr %t2, i32 7)
//
// A variadic callee is the one case where LLVM needs the FULL function type at
// the call site: the arguments alone cannot say where the fixed parameters stop
// and the varargs begin. `fixedTys` is the parameter types before the `...`, so
// an empty one prints `T (...)`, which is what `function f(...): T` means.
export function emitCallVariadic(
  ref cx: Cx,
  dest: usize,
  retTy: string,
  calleeHome: string,
  calleeName: string,
  ref fixedTys: Vec<string>,
  ref args: Vec<CallArg>
): void {
  startInstr(ref cx);
  callResult(ref cx, dest, retTy);
  part(ref cx, retTy);
  part(ref cx, " (");
  let f: usize = 0;
  while (f < fixedTys.len) {
    part(ref cx, vec.vecGet(ref fixedTys, f));
    part(ref cx, ", ");
    f += 1;
  }
  part(ref cx, "...)");
  callTail(ref cx, calleeHome, calleeName, ref args);
}

// `%t8 = call ` or `call `, depending on whether there is a result to name.
function callResult(ref cx: Cx, dest: usize, retTy: string): void {
  if (!text.equals(retTy, "void")) {
    temp(ref cx, dest);
    part(ref cx, " = ");
  }
  part(ref cx, "call ");
}

// ` @mathx_1__doThing(i32 %t1, ptr %t2)` - everything after the callee's type,
// which is identical for a variadic call and an ordinary one.
function callTail(
  ref cx: Cx,
  calleeHome: string,
  calleeName: string,
  ref args: Vec<CallArg>
): void {
  part(ref cx, " @");
  if (calleeHome.len > 0) {
    part(ref cx, calleeHome);
    part(ref cx, SYMBOL_MODULE_SEPARATOR);
  }
  part(ref cx, calleeName);
  part(ref cx, "(");
  let i: usize = 0;
  while (i < args.len) {
    const a = vec.vecGet(ref args, i);
    if (i > 0) {
      part(ref cx, ", ");
    }
    part(ref cx, a.ty);
    part(ref cx, " ");
    operand(ref cx, a.value);
    i += 1;
  }
  part(ref cx, ")");
  endInstr(ref cx);
}

//   %t7 = call i64 %t5(ptr %t6)
//
// A call through a function POINTER rather than a symbol. LLVM's opaque
// pointers put the signature at the call site, so the return type here is all
// the callee's type contributes.
export function emitCallIndirect(
  ref cx: Cx,
  dest: usize,
  retTy: string,
  callee: usize,
  ref args: Vec<CallArg>
): void {
  startInstr(ref cx);
  const isVoid = text.equals(retTy, "void");
  if (!isVoid) {
    temp(ref cx, dest);
    part(ref cx, " = ");
  }
  part(ref cx, "call ");
  part(ref cx, retTy);
  part(ref cx, " ");
  temp(ref cx, callee);
  part(ref cx, "(");
  let i: usize = 0;
  while (i < args.len) {
    const a = vec.vecGet(ref args, i);
    if (i > 0) {
      part(ref cx, ", ");
    }
    part(ref cx, a.ty);
    part(ref cx, " ");
    operand(ref cx, a.value);
    i += 1;
  }
  part(ref cx, ")");
  endInstr(ref cx);
}
