module codegen;

/*
  The SPAWN - what a `task` call site lowers to.

  A task call is not a call. It fills in a handle, hands it to the scheduler,
  and evaluates to the handle; the body runs on somebody else's thread. Three
  binding forms, and the only thing that differs between them is where the
  handle LIVES and what happens to it at the end of the scope:

    pooled h = f(a);        heap, refcounted   released at scope end
    joined d = f(a);        stack              joined at scope end
    const v: T = f(a);      stack              joined right here, binds T

  The kind's clauses pick the form - see typecheck/task.yoop - and pass D has
  already proved the right-hand side is a direct call to a task function of this
  module. Everything below is the emission.
*/

import * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { ASTNode, ASTNodeKind, NodeId, childAt, kindName, nodeAt } from "../ast";
import { TaskBind } from "../typecheck";

// The three forms, from the LET/CONST decl. Called by emitVarDecl when the
// classifier says this binding is a spawn.
export function emitTaskBinding(ref cx: Cx, stmt: ASTNode, stmtId: NodeId, bind: TaskBind): EmitResult {
  const call = nodeAt(cx.ast, stmt.childB);
  if (call.kind != ASTNodeKind.CALL_EXPRESSION) {
    return internalError("a task binding's initializer is not a call", kindName(call.kind));
  }
  // A cross-module spawn would need the DEFINING module's handle layout and
  // thunk symbol, and `taskMetaOf` only answers about this one. Refused by name
  // rather than emitted against the wrong struct - the reference refuses it in
  // the same place, for the same reason.
  disposable meta: TaskMeta = taskMetaOf(ref cx, call.name);
  if (!meta.found) {
    return unsupportedHere(
      "a CROSS-MODULE task spawn - the handle layout and the thunk belong to the module that declared the task",
      call.name
    );
  }

  let handle: Operand = Operand.None;
  let err: EmitResult = EmitResult.Ok;
  if (bind == TaskBind.POOLED) {
    err = emitPooledHandle(ref cx, call, ref meta, ref handle);
  } else {
    err = emitStackHandle(ref cx, call, ref meta, ref handle);
  }
  if (emitFailed(err)) {
    return err;
  }
  emitTaskSubmit(ref cx, handle, cx.tm.moduleId, taskThunkSymbolName(call.name));

  if (bind == TaskBind.IMMEDIATE) {
    return bindJoinedResult(ref cx, stmt, stmtId, ref meta, handle);
  }
  return bindHandle(ref cx, stmt, stmtId, bind, handle);
}

// `pooled h = f(a)` - the handle outlives nothing in particular, so it goes on
// the heap with a refcount. `yoop_task_alloc` is calloc plus a refcount of two:
// one for this binding, one for the worker, and the worker drops its own when
// the task completes.
function emitPooledHandle(ref cx: Cx, call: ASTNode, ref meta: TaskMeta, ref handle: Operand): EmitResult {
  const gepTemp = freshTemp(cx.e);
  const sizeTemp = freshTemp(cx.e);
  emitSizeOfStruct(ref cx, sizeTemp, gepTemp, meta.structName);
  const heap = freshTemp(cx.e);
  emitTaskAlloc(ref cx, heap, sizeTemp);
  handle = Operand.Temp { id: heap };
  return fillHandle(ref cx, call, ref meta, handle);
}

// `joined d = f(a)` and the immediate form - the handle cannot outlive the
// frame, so it is one alloca. Zeroed first, because the runtime reads its state
// and refcount before anything here writes either, and a refcount of zero is
// what says "this one is not on the heap".
function emitStackHandle(ref cx: Cx, call: ASTNode, ref meta: TaskMeta, ref handle: Operand): EmitResult {
  const slotInfo = declareAnonSlot(ref cx, meta.structName);
  emitStoreZeroInit(ref cx, meta.structName, TEMP_SLOT_NAME, slotInfo.id);
  handle = Operand.SlotAddr { name: TEMP_SLOT_NAME, id: slotInfo.id };
  return fillHandle(ref cx, call, ref meta, handle);
}

// The two things the compiler owes the handle before it is submitted: the thunk
// pointer at field 0, and one argument per parameter from field 9 on.
//
// Nothing else. State, the cancel byte and the mutex/cond pair are all zero
// already - calloc did it for a pooled handle and the zeroinitializer store did
// it for a stack one - and `yoop_task_submit` is what fills the pair in.
function fillHandle(ref cx: Cx, call: ASTNode, ref meta: TaskMeta, handle: Operand): EmitResult {
  const thunkAddr = freshTemp(cx.e);
  emitGepFieldOfAddr(ref cx, thunkAddr, meta.structName, handle, TASK_FIELD_THUNK);
  emitStoreToPtr(
    ref cx, "ptr",
    Operand.FuncRef { home: cx.tm.moduleId, name: taskThunkSymbolName(call.name) },
    thunkAddr
  );

  if (call.childA == 0) {
    return EmitResult.Ok;
  }
  const list = nodeAt(cx.ast, call.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    const argId = childAt(cx.ast, list, i);
    let value: Operand = Operand.None;
    emitExpr(ref cx, argId, ref value)?;
    const slotAddr = freshTemp(cx.e);
    emitGepFieldOfAddr(ref cx, slotAddr, meta.structName, handle, TASK_FIELD_ARG0 + i);
    emitStoreToPtr(ref cx, vec.vecGet(ref meta.argTys, i), value, slotAddr);
    i += 1;
  }
  return EmitResult.Ok;
}

// `pooled h` / `joined d` - the NAME is bound to the handle pointer, and the
// scope owes it a release or a join. Recorded on the same stack an ordinary
// `disposable` uses, so a `return` or a `break` out of the middle unwinds it
// exactly as it unwinds everything else.
function bindHandle(ref cx: Cx, stmt: ASTNode, stmtId: NodeId, bind: TaskBind, handle: Operand): EmitResult {
  const slotInfo = declareLocal(ref cx, stmt.name, "ptr");
  emitStore(ref cx, "ptr", handle, stmt.name, slotInfo.id);
  let action = TASK_ACTION_JOIN;
  if (bind == TaskBind.POOLED) {
    action = TASK_ACTION_RELEASE;
  }
  recordTaskCleanup(cx.disposes, stmt.name, slotInfo.id, action);
  return EmitResult.Ok;
}

// `const v: T = f(a)` - spawn and join in one statement, so the binding is the
// RESULT rather than the handle and there is nothing left to do at scope end.
//
// The sync pair is freed right after the join: the handle is about to go out of
// use and nothing can wait on it again.
function bindJoinedResult(
  ref cx: Cx,
  stmt: ASTNode,
  stmtId: NodeId,
  ref meta: TaskMeta,
  handle: Operand
): EmitResult {
  emitTaskWaitCall(ref cx, handle);
  const resultAddr = freshTemp(cx.e);
  emitGepFieldOfAddr(ref cx, resultAddr, meta.structName, handle, TASK_FIELD_RESULT);
  const value = freshTemp(cx.e);
  emitLoadFromPtr(ref cx, value, meta.resultTy, resultAddr);
  emitTaskFreeSyncPair(ref cx, handle);

  const ty = typeOf(ref cx, stmtId);
  const slotInfo = declareLocal(ref cx, stmt.name, ty);
  emitStore(ref cx, ty, Operand.Temp { id: value }, stmt.name, slotInfo.id);
  return EmitResult.Ok;
}
