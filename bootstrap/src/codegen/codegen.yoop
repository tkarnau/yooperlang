module codegen;

// Layer 5: typed AST -> LLVM IR text.
//
// Codegen does ZERO type-checking. Every node it reads already has a concrete
// TypeId in TypedModule.resolvedTypes, and it is total on well-formed input - a
// crash here is a typecheck bug, not a user error. That is the contract in
// plans/bootstrap-pipeline-contracts.md, and it is what lets a bytecode IR slot
// in later without the rest of the pipeline caring.
//
// The subset today is the vertical slice: functions, `return`, int and string
// literals, and calls (printf plus other top-level functions). Anything else is
// an internal error naming the node kind.

import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable, owned } from "std/core/kinds.yoop";
import * as str from "std/core/strings.yoop";
import { Result } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, nodeAt, kindName } from "../ast";
import { ModuleGraph, Module } from "../source_graph";
import { Program, TypedModule, TypeId, Type, Symbol, SymbolId, SYMBOL_NONE_ID,
  symbolAt, typeAt, TYPE_VOID_ID, TYPE_ERROR_ID } from "../typecheck";
import { TokenTags, tagName } from "../lex";
import { Map }, * as map from "std/collections/map.yoop";
import { Option } from "std/core/types.yoop";

export function codegenProgram(ref prog: Program, ref graph: ModuleGraph): Result<string, string> {
  let e = emitterNew();
  emitGlobal(ref e, "; generated by the yooperlang bootstrap compiler");

  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    let tm = vec.vecGet(ref prog.modules, i);
    const err = codegenModule(ref e, ref prog, ref tm, m);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
    i += 1;
  }

  if (e.usesPrintf) {
    emitGlobal(ref e, "declare i32 @printf(ptr, ...)");
  }
  return Result.Ok { value: finish(ref e) };
}

// Returns "" on success, else the internal error that stopped it.
function codegenModule(ref e: Emitter, ref prog: Program, ref tm: TypedModule, m: Module): string {
  const programNode = nodeAt(ref m.ast, m.ast.root);
  let i: usize = 0;
  while (i < programNode.childCount) {
    const declNode = nodeAt(ref m.ast, childAt(ref m.ast, programNode, i));
    if (declNode.kind == ASTNodeKind.FUNCTION_DECL) {
      const err = codegenFunction(ref e, ref prog, ref tm, ref m.ast, declNode);
      if (err.len > 0) {
        return err;
      }
    }
    // TYPE_DECLs contribute no code until something instantiates them.
    i += 1;
  }
  return "";
}

function codegenFunction(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): string {
  const retType = functionReturnType(ref prog, ref tm, declNode.name);
  const retLl = llvmType(ref prog, retType);

  // No mangling yet: the graph is one module, and `main` in particular has to
  // keep its C name for the linker. Mangling arrives with imports.
  e.nextTemp = 0;
  emitLine(ref e, `define ${retLl} @${declNode.name}() {`);
  emitLine(ref e, "entry:");

  let sawReturn = false;
  if (declNode.childD != 0) {
    const block = nodeAt(ref ast, declNode.childD);
    if (block.childA != 0) {
      const list = nodeAt(ref ast, block.childA);
      let s: usize = 0;
      while (s < list.childCount) {
        const stmtId = childAt(ref ast, list, s);
        const err = codegenStatement(ref e, ref prog, ref tm, ref ast, stmtId, retLl);
        if (err.len > 0) {
          return err;
        }
        if (nodeAt(ref ast, stmtId).kind == ASTNodeKind.RETURN_STATEMENT) {
          sawReturn = true;
        }
        s += 1;
      }
    }
  }

  // Every LLVM block needs a terminator, and a void function is allowed to just
  // run off the end in yoop.
  if (!sawReturn) {
    if (str.stringEq(retLl, "void")) {
      emitLine(ref e, "  ret void");
    } else {
      return `function "${declNode.name}" has no return on some path`;
    }
  }
  emitLine(ref e, "}");
  return "";
}

function codegenStatement(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  stmtId: NodeId,
  retLl: string
): string {
  const stmt = nodeAt(ref ast, stmtId);
  switch (stmt.kind) {
    case ASTNodeKind.RETURN_STATEMENT: {
      if (stmt.childA == 0) {
        emitLine(ref e, "  ret void");
        return "";
      }
      let value = "";
      const err = codegenExpr(ref e, ref prog, ref tm, ref ast, stmt.childA, ref value);
      if (err.len > 0) {
        return err;
      }
      emitLine(ref e, `  ret ${retLl} ${value}`);
      return "";
    }
    case ASTNodeKind.EXPRESSION_STATEMENT: {
      let value = "";
      return codegenExpr(ref e, ref prog, ref tm, ref ast, stmt.childA, ref value);
    }
    default: {
      return `internal error: codegen cannot emit ${kindName(stmt.kind)}`;
    }
  }
}

// Writes the LLVM operand text for `exprId` into `out`. Returns "" on success.
function codegenExpr(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  exprId: NodeId,
  ref out: string
): string {
  const expr = nodeAt(ref ast, exprId);
  switch (expr.kind) {
    case ASTNodeKind.INT_LITERAL: {
      out = `${expr.intVal}`;
      return "";
    }
    case ASTNodeKind.STRING_LITERAL: {
      out = internStringConstant(ref e, vec.vecGet(ref ast.strings, expr.strId));
      return "";
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return codegenBinary(ref e, ref prog, ref tm, ref ast, expr, exprId, ref out);
    }
    case ASTNodeKind.CALL_EXPRESSION: {
      return codegenCall(ref e, ref prog, ref tm, ref ast, expr, exprId, ref out);
    }
    default: {
      return `internal error: codegen cannot emit ${kindName(expr.kind)}`;
    }
  }
}

function codegenBinary(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  ref out: string
): string {
  let lhs = "";
  const lerr = codegenExpr(ref e, ref prog, ref tm, ref ast, expr.childA, ref lhs);
  if (lerr.len > 0) { return lerr; }
  let rhs = "";
  const rerr = codegenExpr(ref e, ref prog, ref tm, ref ast, expr.childB, ref rhs);
  if (rerr.len > 0) { return rerr; }

  const op = llvmIntOp(expr.operator);
  if (op.len == 0) {
    return `internal error: codegen cannot emit operator ${tagName(expr.operator)}`;
  }
  const ty = llvmType(ref prog, vec.vecGet(ref tm.resolvedTypes, exprId));
  const tmp = freshTemp(ref e);
  emitLine(ref e, `  ${tmp} = ${op} ${ty} ${lhs}, ${rhs}`);
  out = tmp;
  return "";
}

function codegenCall(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  expr: ASTNode,
  exprId: NodeId,
  ref out: string
): string {
  // Arguments first: each may itself emit instructions, and they have to land
  // before the call.
  disposable argText: Vec<string> = vec.vecNew(4);
  if (expr.childA != 0) {
    const args = nodeAt(ref ast, expr.childA);
    let a: usize = 0;
    while (a < args.childCount) {
      const argId = childAt(ref ast, args, a);
      let value = "";
      const err = codegenExpr(ref e, ref prog, ref tm, ref ast, argId, ref value);
      if (err.len > 0) { return err; }
      const argTy = llvmType(ref prog, vec.vecGet(ref tm.resolvedTypes, argId));
      vec.vecPush(ref argText, `${argTy} ${value}`);
      a += 1;
    }
  }
  const joined = joinWith(vec.vecAsArray(ref argText), ", ");

  if (str.stringEq(expr.name, "printf")) {
    e.usesPrintf = true;
    const tmp = freshTemp(ref e);
    emitLine(ref e, `  ${tmp} = call i32 (ptr, ...) @printf(${joined})`);
    out = tmp;
    return "";
  }

  const retTy = llvmType(ref prog, vec.vecGet(ref tm.resolvedTypes, exprId));
  if (str.stringEq(retTy, "void")) {
    emitLine(ref e, `  call void @${expr.name}(${joined})`);
    out = "";
    return "";
  }
  const tmp = freshTemp(ref e);
  emitLine(ref e, `  ${tmp} = call ${retTy} @${expr.name}(${joined})`);
  out = tmp;
  return "";
}

function joinWith(parts: string[], sep: string): owned string {
  disposable pieces: Vec<string> = vec.vecNew(parts.len * 2);
  let i: usize = 0;
  while (i < parts.len) {
    if (i > 0) {
      vec.vecPush(ref pieces, sep);
    }
    vec.vecPush(ref pieces, parts[i]);
    i += 1;
  }
  return str.stringConcatAll(vec.vecAsArray(ref pieces));
}

// The declared return type of a top-level function, straight out of the symbol
// table pass C filled.
function functionReturnType(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  switch (map.mapGet(ref tm.names, name)) {
    case Option.None: { return TYPE_VOID_ID; }
    case Option.Some { value: symId }: {
      switch (symbolAt(ref prog, symId)) {
        case Symbol.Func { typeId: t }: {
          switch (typeAt(ref prog, t)) {
            case Type.Func { params: p, ret: r, variadic: v }: { return r; }
            default: { return TYPE_VOID_ID; }
          }
        }
        default: { return TYPE_VOID_ID; }
      }
    }
  }
}

// The signed-integer LLVM opcode for a binary operator, or "" when codegen has
// no lowering for it yet. Unsigned and float variants arrive with the types
// that need them.
function llvmIntOp(tag: TokenTags): string {
  switch (tag) {
    case TokenTags.PLUS: { return "add"; }
    case TokenTags.MINUS: { return "sub"; }
    case TokenTags.MULT: { return "mul"; }
    case TokenTags.DIVIDE: { return "sdiv"; }
    case TokenTags.MODULUS: { return "srem"; }
    default: { return ""; }
  }
}
