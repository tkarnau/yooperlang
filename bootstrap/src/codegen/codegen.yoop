module codegen;

// Layer 5 entry point: typed AST -> LLVM IR text.
//
// This file is only the walk over modules and functions. The rest of the module
// splits by job, which is the order to read them in:
//
//   context.yoop   what every function is handed (Cx), and the raw appenders
//   query.yoop     THE typecheck boundary: `typeOf`, `returnTypeOf`, and the
//                  cast/promotion widths derived from them
//   instr.yoop     one function per LLVM instruction, each with a sample of its
//                  output. Read this to learn WHAT IR we emit
//   instr_mem.yoop the same, for aggregates and computed addresses
//   instr_flow.yoop the same, for branches, labels and the jump table
//   switch.yoop    `switch` -> a jump table
//   struct.yoop    struct literals, field read and write
//   variant.yoop   variant constructors, tags, and pattern bindings
//   typedefs.yoop  the module-level `%struct.X = type { ... }` lines
//   array.yoop     array literals, indexing, `.len`
//   call.yoop      call expressions, and the argument ordering rule
//   stmt.yoop      statements -> instructions
//   flow.yoop      `if` -> labels and branches, and the one terminator per
//                  block discipline every branching construct follows
//   loop.yoop      `while` / `for` -> labels and branches
//   loop_stack.yoop  where break/continue jump
//   expr.yoop      expressions -> an Operand, plus the instructions to get it
//   vocab.yoop     which LLVM opcode or predicate an operator lowers to
//   operand.yoop   what an expression evaluates to, as a value not a string
//   locals.yoop    a local's stack slot
//   strings.yoop   string literals -> private module constants
//   emit.yoop      the Text buffers and the TypeId -> LLVM type map
//
// What codegen is allowed to assume, and does: every node it visits has a
// concrete resolvedType, so it does ZERO type-checking and is total on
// well-formed input. An internal-error return here is a typecheck bug.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { isOpenInstance, instanceAt, instanceCount, DECL_NONE_ID, Symbol, symbolAt } from "../typecheck";
import { anyOpenArg } from "../typecheck";
import { Option } from "std/core/types.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, nodeAt } from "../ast";
import { ModuleGraph, Module } from "../source_graph";
import { Program, TypedModule, DECL_NONE_ID, funcInstanceAt, TYPE_VOID_ID, TYPE_ERROR_ID,
  isIntPrimType } from "../typecheck";

// Hands back the finished IR as a Text. The caller owns it and its allocator
// reclaims it - a `string` here would be a malloc the size of the whole module.
// What one compile produces: the IR, and whether linking it needs the runtime.
//
// The flag rides with the IR rather than being asked for separately, because it
// is a property OF that IR - it means "these instructions call yoop_ctx_alloc".
export type CodegenOutput propagates<disposable> {
  ir: Text,
  needsRuntime: bool,
  // The libraries `extern "C" from library "X"` blocks asked for, graph-wide.
  // A property of the emitted program rather than of any one module, the same
  // way `needsRuntime` is, so it rides out with the IR. See link_flags.yoop.
  linkLibraries: Vec<string>,
}

export function codegenProgram(ref prog: Program, ref graph: ModuleGraph): Result<CodegenOutput, string> {
  // The Emitter owns two Text buffers and `finish` copies into a THIRD that the
  // caller owns, so this binding has to be disposable or the build buffers
  // outlive the compile.
  disposable e: Emitter = emitterNew();
  emitGlobal(ref e, "; generated by the yooperlang bootstrap compiler");
  emitStructTypeDefs(ref e, ref prog);
  // Before any body, and before `main` in particular: the handle layouts are
  // what a spawn geps into, and `e.hasTasks` - which this sets - is what tells
  // `main` whether to install the scheduler. See task.yoop.
  emitTaskStructDefs(ref e, ref prog, ref graph);
  emitModuleGlobals(ref e, ref prog, ref graph);
  // Before any body: a const's use may be emitted before the module declaring
  // it is walked, and an imported one is only ever declared in one of them.
  materializeModuleConsts(ref e, ref prog, ref graph);
  // Before the function bodies, and once for the whole graph: a symbol may be
  // declared in an LLVM module exactly once, and two files each declaring their
  // own `printf` extern is the ordinary case rather than the odd one. The user
  // externs go in FIRST so that the lowerings below reuse a matching one rather
  // than the other way round - a user's declaration is the one with a source
  // location to point at.
  const externErr = emitExternDeclares(ref e, ref prog, ref graph);
  if (externErr.len > 0) {
    return Result.Err { error: externErr };
  }

  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    let tm = vec.vecGet(ref prog.modules, i);
    const err = emitModule(ref e, ref prog, ref tm, m);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
    i += 1;
  }

  // `usesPrintf` means a call fell back to the BUILTIN, which only happens in a
  // module that declared no printf of its own. Another module in the same graph
  // may still have declared one, and that declaration is already in the IR - so
  // this goes through the same table, which reuses a matching line and refuses
  // a `printf` someone declared with an incompatible signature.
  if (e.usesPrintf) {
    const err = externDeclare(ref e, PRINTF_NAME, PRINTF_BUILTIN_RETURN, ["ptr"], true);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
  }
  if (e.usesStringBuilder) {
    const err = emitStringBuilderDeclarations(ref e);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
  }
  if (e.usesRuntime) {
    const err = emitRuntimeDeclarations(ref e);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
  }
  // The scheduler bridge, emitted once for the whole program and only for a
  // program that has a task in it. The trampolines are DEFINITIONS rather than
  // declares - they wrap LLVM intrinsics the C runtime cannot name - and they
  // go in last so their `declare` lines are already there.
  if (e.usesTaskIntrinsics) {
    const err = emitTaskIntrinsicDeclarations(ref e);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
  }
  if (e.hasTasks) {
    const derr = emitTaskRuntimeDeclarations(ref e);
    if (derr.len > 0) {
      return Result.Err { error: derr };
    }
    const terr = emitCoroTrampolines(ref e);
    if (terr.len > 0) {
      return Result.Err { error: terr };
    }
  }
  // Read BEFORE `finish`, which consumes the emitter's buffers.
  //
  // Two ways a program needs the runtime linked, and they are different
  // questions: `usesRuntime` means codegen's own lowerings emitted calls into
  // it (the allocator context, the errno bridge), and `namesRuntime` means a
  // user wrote `extern "C" from "yoop_runtime" { ... }` and brought their own
  // declarations. Either one puts the runtime's C sources on the clang line.
  let reqs: LinkRequests = collectLinkRequests(ref graph);
  // A third way, and it is codegen's own: a program with a task calls into the
  // scheduler whether or not the user ever named the runtime.
  const needsRuntime = e.usesRuntime || e.hasTasks || reqs.namesRuntime;
  return Result.Ok { value: {
    ir: finish(ref e), needsRuntime: needsRuntime, linkLibraries: reqs.libraries
  } };
}

// Returns "" on success, else the internal error that stopped it.
function emitModule(ref e: Emitter, ref prog: Program, ref tm: TypedModule, m: Module): string {
  let f: usize = 0;
  while (f < m.files.len) {
    const err = emitFile(ref e, ref prog, ref tm, m, vec.vecGet(ref m.files, f).root, f);
    if (err.len > 0) {
      return err;
    }
    f += 1;
  }
  return "";
}

// One source file of a module. Every file emits into the same LLVM module and
// mangles against the same id, which is what makes a directory module one unit
// to the linker as well as to the typechecker.
function emitFile(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  root: NodeId,
  fileIndex: usize
): string {
  // The file's own init function, if its module-level `let`s owe one. First,
  // because it is the one definition here whose CALLER (`main`) may be in any
  // module, and emitting it beside the file that declared the globals is what
  // keeps the store in the same arena as the initializer. See module_init.yoop.
  const initErr = emitModuleInitFn(ref e, ref prog, ref tm, m, root, fileIndex);
  if (initErr.len > 0) {
    return initErr;
  }

  const programNode = nodeAt(ref m.ast, root);
  let i: usize = 0;
  while (i < programNode.childCount) {
    // `export function f()` wraps the decl, and exportedness changes nothing
    // here - a module-qualified symbol is emitted either way, and whether it
    // was legal to NAME it was settled in pass B.
    const declId = declOf(ref m.ast, childAt(ref m.ast, programNode, i));
    const declNode = nodeAt(ref m.ast, declId);
    if (declNode.kind == ASTNodeKind.FUNCTION_DECL) {
      // A GENERIC function has no single body to emit: one per instantiation
      // pass D recorded, each walking this same AST with a different
      // substitution active. A function nothing ever called emits nothing,
      // which is monomorphization doing its job.
      if (declNode.childA != 0) {
        const err = emitFunctionInstances(ref e, ref prog, ref tm, m, declNode);
        if (err.len > 0) {
          return err;
        }
      } else {
        const err = emitFunction(ref e, ref prog, ref tm, m, declNode, NO_FUNC_INSTANCE, NO_TYPE_INSTANCE);
        if (err.len > 0) {
          return err;
        }
      }
    }
    // An EXTERN_BLOCK contributes no code here: it has no body, and its
    // `declare` lines were emitted once for the whole graph up in
    // codegenProgram, because they have to be deduplicated across modules.
    // A type's METHODS are ordinary functions with a `ref self` first
    // parameter, emitted under a name that carries the type. The type itself
    // still contributes no code.
    if (declNode.kind == ASTNodeKind.TYPE_DECL ||
        declNode.kind == ASTNodeKind.VARIANT_DECL ||
        declNode.kind == ASTNodeKind.ENUM_DECL) {
      const err = emitMethods(ref e, ref prog, ref tm, m, declNode);
      if (err.len > 0) {
        return err;
      }
    }
    // A TYPE_DECL contributes no code until something instantiates it, and an
    // IMPORT_DECL never contributes any.
    i += 1;
  }
  return "";
}

// Every METHOD in a type decl's member run. Fields contribute nothing; a method
// is a function whose receiver happens to be spelled `self`.
function emitMethods(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode
): string {
  // A GENERIC type's methods are TEMPLATES: `ref self` is `Vec<T>`, whose
  // layout is unknown until T is. So they are emitted once per instantiation,
  // exactly as a generic function's body is - `cx.typeInstance` is what
  // `resolvedTypeAt` substitutes against, and the mangled name falls out of the
  // receiver's now-concrete type without this having to spell it.
  //
  // A template with no instantiations emits nothing at all, which is right: no
  // call site can name a method on a type nobody instantiated.
  if (declNode.childA != 0) {
    return emitGenericMethods(ref e, ref prog, ref tm, m, declNode);
  }

  return emitMethodRun(ref e, ref prog, ref tm, m, declNode, NO_TYPE_INSTANCE);
}

// One copy of every method, for every instantiation of this generic decl.
function emitGenericMethods(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode
): string {
  const declId = genericTypeDeclIdOf(ref prog, ref tm, declNode.name);
  if (declId == DECL_NONE_ID) {
    return "";
  }
  let i: usize = 1;   // 0 is the reserved sentinel
  while (i < instanceCount(ref prog)) {
    let inst = instanceAt(ref prog, i);
    // Skip the TEMPLATE's own open instance - its arguments are its parameters,
    // so emitting it would produce the very IR this exists to avoid.
    if (inst.origin == declId && !isOpenInstance(ref prog, inst.typeId)) {
      const err = emitMethodRun(ref e, ref prog, ref tm, m, declNode, i);
      if (err.len > 0) {
        return err;
      }
    }
    i += 1;
  }
  return "";
}

// The METHOD_DECL members of one decl, emitted under one substitution.
function emitMethodRun(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode,
  typeInstance: usize
): string {
  let i: usize = 0;
  while (i < declNode.childCount) {
    const memberId = childAt(ref m.ast, declNode, i);
    const member = nodeAt(ref m.ast, memberId);
    if (member.kind == ASTNodeKind.METHOD_DECL) {
      // A `task` METHOD, refused because a task's CALL SITE is a spawn onto
      // the scheduler rather than an inline drive - see the same refusal for a
      // function in emitFunction. An `async` method is emitted as an ordinary
      // coroutine; `pausableMethods` is the union of the two, so it is the TASK
      // half that is asked about here. Asked at this level because only the
      // caller has the member's NodeId.
      if (map.mapContainsKey(ref tm.taskMethods, uint64(memberId))) {
        return unsupportedHere(
          "a `task` method - its call site is a SPAWN onto the scheduler, which needs the task handle struct and the runtime's submit/wait ABI",
          member.name
        );
      }
      const err = emitFunction(ref e, ref prog, ref tm, m, member, NO_FUNC_INSTANCE, typeInstance);
      if (err.len > 0) {
        return err;
      }
    }
    i += 1;
  }
  return "";
}

// Every monomorphization of one generic function decl. The instances belong to
// the whole PROGRAM, so this picks out the ones whose origin is this decl.
function emitFunctionInstances(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode
): string {
  const declId = genericFuncDeclIdOf(ref prog, ref tm, declNode.name);
  if (declId == DECL_NONE_ID) {
    return "";
  }
  let i: usize = 1;   // 0 is the reserved dead entry
  while (i < prog.funcInstances.len) {
    let inst = funcInstanceAt(ref prog, i);
    // An instance whose arguments are still TYPE PARAMETERS is not a
    // monomorphization - it is what a generic calling another generic recorded
    // before the caller's own arguments were known. `closeFuncInstances`
    // registered the concrete ones it implies and every call site resolves onto
    // those, so emitting this would define a function nothing calls, out of a
    // signature that mentions types with no LLVM spelling. Same test, same
    // reason, as `isOpenInstance` for a generic TYPE.
    if (inst.origin == declId && !anyOpenArg(ref prog, ref inst.args)) {
      const err = emitFunction(ref e, ref prog, ref tm, m, declNode, i, NO_TYPE_INSTANCE);
      if (err.len > 0) {
        return err;
      }
    }
    i += 1;
  }
  return "";
}

function emitFunction(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode,
  instance: usize,
  typeInstance: usize
): string {
  // One locals map per function; the Cx bundles it with everything else so the
  // walk below is not threading five arguments through every call.
  disposable locals: FnLocals = localsNew();
  disposable loops: LoopStack = loopStackNew();
  disposable disposes: DisposeStack = disposeStackNew();
  // `e`, `prog` and `tm` are already refs, so they go in as-is; `ref ref T` is
  // not a thing. `m.ast` is a field of a by-value param, and taking a ref to it
  // avoids copying the whole arena.
  let cx: Cx = {
    e: e, prog: prog, tm: tm, ast: ref m.ast, locals: ref locals, loops: ref loops,
    disposes: ref disposes,
    instance: instance,
    typeInstance: typeInstance,
    fnRet: TYPE_VOID_ID,
    coro: noCoroFrame(),
    inMain: false,
    voidMain: false,
  };

  beginFunctionBuffers(ref e);
  // A method is not in the module namespace, so its return type comes from its
  // own signature rather than from a name lookup.
  const isMethod = declNode.kind == ASTNodeKind.METHOD_DECL;
  let retTyId = returnTypeIdOf(ref cx, declNode.name);
  if (isMethod) {
    retTyId = methodReturnTypeIdOf(ref cx, declNode);
  }
  // Recorded on the Cx as well as spelled into `retTy`, because `?` has to ask
  // the type system about it rather than just print it.
  cx.fnRet = retTyId;
  const retTy = llvmType(cx.prog, retTyId);

  disposable params: Vec<ParamInfo> = vec.vecNew(4);
  collectParams(ref cx, declNode, ref params);

  let symbol = definitionSymbol(ref cx, declNode.name);
  if (isMethod) {
    symbol = methodDefinitionSymbol(ref cx, declNode);
  }
  // The C ENTRY POINT. Asked once and read twice, because the two readers want
  // different things from it: the scheduler's lifetime is `main` in a program
  // that has a task, and the exit status is `main` however the program is
  // built.
  const isMain = !isMethod && instance == NO_FUNC_INSTANCE &&
    symbol.home.len == 0 && text.equals(symbol.name, MAIN_SYMBOL);
  // `main` is where the worker pool is started, where the coroutine
  // trampolines are handed over, and where it is all torn down again - see the
  // scheduler prologue below and the shutdown in emitReturn.
  cx.inMain = e.hasTasks && isMain;

  // An `async` function is a COROUTINE: it returns a handle rather than its
  // result, takes a caller-owned slot to write the result into, and carries
  // `presplitcoroutine` so the coro passes split it. See coro.yoop.
  let isCoro = funcIsAsync(ref cx, declNode.name);
  if (isMethod) {
    isCoro = methodIsAsync(ref cx, declNode);
  }

  // `function main(): void` is emitted with C's entry-point signature - see
  // Cx.voidMain. `retTy` keeps saying `void`, because that is still what the
  // BODY returns and what `?` and the coroutine trailer read; only the two
  // places that spell the `ret` know the difference.
  cx.voidMain = isMain && !isCoro && text.equals(retTy, "void");
  let signatureRetTy = retTy;
  if (cx.voidMain) {
    signatureRetTy = MAIN_EXIT_TYPE;
  }
  if (isCoro) {
    const derr = declareCoroIntrinsics(ref e);
    if (derr.len > 0) {
      return derr;
    }
    emitCoroFunctionOpen(ref cx, symbol.home, symbol.name, ref params);
    cx.coro = beginCoroFrame(ref cx);
    emitParamPrologue(ref cx, ref params);
    openCoroBody(ref cx);
  } else {
    emitFunctionOpen(ref cx, symbol.home, symbol.name, signatureRetTy, ref params);
    emitParamPrologue(ref cx, ref params);
  }
  if (cx.inMain) {
    emitSchedulerPrologue(ref cx);
  }
  // Every module's run-time initializers, before a line of user code and after
  // the scheduler exists - an initializer may spawn. See module_init.yoop.
  if (isMain) {
    emitModuleInitCalls(ref cx);
  }

  let err = "";
  let bodyTerminated = false;
  if (declNode.childD != 0) {
    emitBlock(ref cx, declNode.childD, retTy, ref bodyTerminated, ref err);
    if (err.len > 0) {
      return err;
    }
  }

  // Every LLVM block needs a terminator, and a void function may just run off
  // the end in yoop.
  if (isCoro) {
    // Falling out of a coroutine's body reaches the final suspend rather than a
    // `ret`. A non-void one that falls off the end was proven unreachable by
    // pass D, exactly as in the ordinary case below.
    if (!bodyTerminated) {
      if (text.equals(retTy, "void")) {
        emitCoroReturn(ref cx, retTy, Operand.None, false);
      } else {
        return internalError("no return on some path out of", declNode.name);
      }
    }
    emitCoroTrailer(ref cx);
    emitFunctionClose(ref cx);
    // A `task` body needs one more function beside it: the THUNK a worker
    // thread calls, which unpacks the arguments out of the handle and starts
    // the coroutine. Emitted here rather than in emitFile because it is a
    // property of this declaration and needs the same Cx - see task_thunk.yoop.
    if (!isMethod && map.mapContainsKey(ref tm.taskNames, declNode.name)) {
      return emitTaskThunk(ref cx, declNode);
    }
    return "";
  }
  if (!bodyTerminated) {
    if (text.equals(retTy, "void")) {
      if (cx.inMain) {
        emitRuntimeShutdown(ref cx);
      }
      if (cx.voidMain) {
        emitRetMainZero(ref cx);
      } else {
        emitRetVoid(ref cx);
      }
    } else {
      return internalError("no return on some path out of", declNode.name);
    }
  }
  emitFunctionClose(ref cx);
  return "";
}

// What `main` does before any user code, for a program that has a task.
//
//   call void @yoop_runtime_init()
//   call void @yoop_runtime_set_coro_ops(ptr @yoop_coro_resume, ptr @yoop_coro_destroy, ptr @yoop_coro_done)
//
// The ops go in immediately after init and before anything can be submitted.
// Without them `yoop_task_settle` has no way to ask whether a coroutine
// finished, so it treats every step as complete - which is exactly wrong for a
// task that suspends: the handle would be signalled done with an empty result
// slot and the frame would leak.
function emitSchedulerPrologue(ref cx: Cx): void {
  emitRuntimeInit(ref cx);
  emitSetCoroOps(ref cx);
}

// The C entry point's name, which mangle.yoop keeps unmangled.
const MAIN_SYMBOL: string = "main";

// What C's entry point returns. A yoop `main` may be declared `int32`, in which
// case this is what `llvmType` already says; a `void` one is emitted with this
// signature anyway and hands back 0. See Cx.voidMain.
export const MAIN_EXIT_TYPE: string = "i32";

// childB is the parameter NODE_LIST. Their types come from pass D's decoration,
// which took them from the signature pass C resolved.
function collectParams(ref cx: Cx, declNode: ASTNode, ref params: Vec<ParamInfo>): void {
  if (declNode.childB == 0) {
    return;
  }
  const list = nodeAt(cx.ast, declNode.childB);
  let i: usize = 0;
  while (i < list.childCount) {
    const paramId = childAt(cx.ast, list, i);
    const paramNode = nodeAt(cx.ast, paramId);
    // `ty` is what the SIGNATURE says (a `ref` parameter is `ptr`);
    // `pointeeTy` is what it points at, which is what the body loads and stores.
    vec.vecPush(ref params, {
      name: paramNode.name,
      ty: typeOf(ref cx, paramId),
      isRef: isRefAt(ref cx, paramId),
      pointeeTy: pointeeTypeOf(ref cx, paramId),
    });
    i += 1;
  }
}

// A parameter arrives in an SSA register (`%a.arg`) but the body reads locals
// out of stack slots, so each one is spilled on entry. That is one uniform rule
// for reading a name - `mem2reg` undoes the cost.
//
//   %a.addr = alloca i32
//   store i32 %a.arg, ptr %a.addr
function emitParamPrologue(ref cx: Cx, ref params: Vec<ParamInfo>): void {
  let i: usize = 0;
  while (i < params.len) {
    const p = vec.vecGet(ref params, i);
    // A `ref` parameter arrives as a pointer to the caller's object; that
    // pointer is the slot, so there is no alloca and no spill. Every read and
    // write in the body then lands on the caller's storage, which is what a
    // borrow means.
    if (p.isRef) {
      declareRefParam(ref cx, p.name, p.pointeeTy);
      i += 1;
      continue;
    }
    const slotInfo = declareLocal(ref cx, p.name, p.ty);
    emitStoreArg(ref cx, p.ty, p.name, slotInfo.id);
    i += 1;
  }
}

// Whether a decl's member run holds any METHOD_DECL.
function declNodeHasMethods(ref ast: AST, declNode: ASTNode): bool {
  let i: usize = 0;
  while (i < declNode.childCount) {
    if (nodeAt(ref ast, childAt(ref ast, declNode, i)).kind == ASTNodeKind.METHOD_DECL) {
      return true;
    }
    i += 1;
  }
  return false;
}

// `@m__COUNT = internal global i32 0` for every module-level `let` in the
// graph, emitted once up front.
//
// Before any function body, because a body may read one - and unlike a local,
// a global has no declaration point inside the code that uses it.
//
// This walk is also where each file's INIT function is noted, in the order
// `main` will call them: the modules arrive topologically ordered, so recording
// them as they go past is what gives a module's initializer the guarantee that
// everything it imported is already stored. See module_init.yoop.
function emitModuleGlobals(ref e: Emitter, ref prog: Program, ref graph: ModuleGraph): void {
  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    let tm = vec.vecGet(ref prog.modules, i);
    let f: usize = 0;
    while (f < m.files.len) {
      emitFileGlobals(ref e, ref prog, ref tm, ref m.ast, vec.vecGet(ref m.files, f).root, f);
      f += 1;
    }
    i += 1;
  }
}

// One source file's module-level `let`s.
function emitFileGlobals(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  root: NodeId,
  fileIndex: usize
): void {
  const programNode = nodeAt(ref ast, root);
  let needsInit = false;
  let d: usize = 0;
  while (d < programNode.childCount) {
    const declNode = nodeAt(ref ast, declOf(ref ast, childAt(ref ast, programNode, d)));
    if (declNode.kind == ASTNodeKind.LET_DECL) {
      if (emitOneModuleGlobal(ref e, ref prog, ref tm, ref ast, declNode)) {
        needsInit = true;
      }
    }
    d += 1;
  }
  if (needsInit) {
    noteModuleInit(ref e, tm.moduleId, fileIndex);
  }
}

// True when this global's value has to be STORED at run time rather than baked
// into the definition emitted here.
function emitOneModuleGlobal(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  ref ast: AST,
  declNode: ASTNode
): bool {
  const declared = moduleGlobalTypeId(ref prog, ref tm, declNode.name);
  if (declared == TYPE_ERROR_ID) {
    return false;
  }
  const ty = llvmType(ref prog, declared);
  if (moduleGlobalNeedsStore(ref prog, ref ast, declNode, declared)) {
    emitGlobalZeroed(ref e, tm.moduleId, declNode.name, ty);
    return true;
  }
  // A baked VALUE is an integer and nothing else - see moduleGlobalIsBaked - so
  // the symbol's own `intVal` is the whole initializer. Anything else that got
  // here has no initializer at all, and zero is precisely what that means; it
  // takes the zeroinitializer form because a struct or an array descriptor has
  // no immediate to write.
  if (!isIntPrimType(ref prog, declared)) {
    emitGlobalZeroed(ref e, tm.moduleId, declNode.name, ty);
    return false;
  }
  emitGlobalVariable(ref e, tm.moduleId, declNode.name, ty, moduleGlobalIntValue(ref prog, ref tm, declNode.name));
  return false;
}

// The integer a baked global rides on. Its own lookup rather than one that also
// hands back the type, because only this one caller wants it.
function moduleGlobalIntValue(ref prog: Program, ref tm: TypedModule, name: string): int64 {
  switch (map.mapGet(ref tm.names, name)) {
    case Option.None: { return 0; }
    case Option.Some { value: symId }: {
      switch (symbolAt(ref prog, symId)) {
        case Symbol.Global { typeId: t, intVal: v }: { return v; }
        default: { return 0; }
      }
    }
  }
}
