module codegen;

// Layer 5 entry point: typed AST -> LLVM IR text.
//
// This file is only the walk over modules and functions. The rest of the module
// splits by job, which is the order to read them in:
//
//   context.yoop   what every function is handed (Cx), and the raw appenders
//   query.yoop     THE typecheck boundary: `typeOf`, `returnTypeOf`, and the
//                  cast/promotion widths derived from them
//   instr.yoop     one function per LLVM instruction, each with a sample of its
//                  output. Read this to learn WHAT IR we emit
//   instr_mem.yoop the same, for aggregates and computed addresses
//   instr_flow.yoop the same, for branches, labels and the jump table
//   switch.yoop    `switch` -> a jump table
//   struct.yoop    struct literals, field read and write
//   variant.yoop   variant constructors, tags, and pattern bindings
//   typedefs.yoop  the module-level `%struct.X = type { ... }` lines
//   array.yoop     array literals, indexing, `.len`
//   call.yoop      call expressions, and the argument ordering rule
//   stmt.yoop      statements -> instructions
//   flow.yoop      `if` -> labels and branches, and the one terminator per
//                  block discipline every branching construct follows
//   loop.yoop      `while` / `for` -> labels and branches
//   loop_stack.yoop  where break/continue jump
//   expr.yoop      expressions -> an Operand, plus the instructions to get it
//   vocab.yoop     which LLVM opcode or predicate an operator lowers to
//   operand.yoop   what an expression evaluates to, as a value not a string
//   locals.yoop    a local's stack slot
//   strings.yoop   string literals -> private module constants
//   emit.yoop      the Text buffers and the TypeId -> LLVM type map
//
// What codegen is allowed to assume, and does: every node it visits has a
// concrete resolvedType, so it does ZERO type-checking and is total on
// well-formed input. An internal-error return here is a typecheck bug.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, nodeAt } from "../ast";
import { ModuleGraph, Module } from "../source_graph";
import { Program, TypedModule, DECL_NONE_ID, funcInstanceAt } from "../typecheck";

// Hands back the finished IR as a Text. The caller owns it and its allocator
// reclaims it - a `string` here would be a malloc the size of the whole module.
export function codegenProgram(ref prog: Program, ref graph: ModuleGraph): Result<Text, string> {
  // The Emitter owns two Text buffers and `finish` copies into a THIRD that the
  // caller owns, so this binding has to be disposable or the build buffers
  // outlive the compile.
  disposable e: Emitter = emitterNew();
  emitGlobal(ref e, "; generated by the yooperlang bootstrap compiler");
  emitStructTypeDefs(ref e, ref prog);

  let i: usize = 0;
  while (i < graph.modules.len) {
    const m = vec.vecGet(ref graph.modules, i);
    let tm = vec.vecGet(ref prog.modules, i);
    const err = emitModule(ref e, ref prog, ref tm, m);
    if (err.len > 0) {
      return Result.Err { error: err };
    }
    i += 1;
  }

  if (e.usesPrintf) {
    emitGlobal(ref e, "declare i32 @printf(ptr, ...)");
  }
  if (e.usesStringBuilder) {
    emitStringBuilderDeclarations(ref e);
  }
  return Result.Ok { value: finish(ref e) };
}

// Returns "" on success, else the internal error that stopped it.
function emitModule(ref e: Emitter, ref prog: Program, ref tm: TypedModule, m: Module): string {
  let f: usize = 0;
  while (f < m.files.len) {
    const err = emitFile(ref e, ref prog, ref tm, m, vec.vecGet(ref m.files, f).root);
    if (err.len > 0) {
      return err;
    }
    f += 1;
  }
  return "";
}

// One source file of a module. Every file emits into the same LLVM module and
// mangles against the same id, which is what makes a directory module one unit
// to the linker as well as to the typechecker.
function emitFile(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  root: NodeId
): string {
  const programNode = nodeAt(ref m.ast, root);
  let i: usize = 0;
  while (i < programNode.childCount) {
    // `export function f()` wraps the decl, and exportedness changes nothing
    // here - a module-qualified symbol is emitted either way, and whether it
    // was legal to NAME it was settled in pass B.
    const declId = declOf(ref m.ast, childAt(ref m.ast, programNode, i));
    const declNode = nodeAt(ref m.ast, declId);
    if (declNode.kind == ASTNodeKind.FUNCTION_DECL) {
      // A GENERIC function has no single body to emit: one per instantiation
      // pass D recorded, each walking this same AST with a different
      // substitution active. A function nothing ever called emits nothing,
      // which is monomorphization doing its job.
      if (declNode.childA != 0) {
        const err = emitFunctionInstances(ref e, ref prog, ref tm, m, declNode);
        if (err.len > 0) {
          return err;
        }
      } else {
        const err = emitFunction(ref e, ref prog, ref tm, m, declNode, NO_FUNC_INSTANCE);
        if (err.len > 0) {
          return err;
        }
      }
    }
    // An extern has no body to emit - just a `declare` so the linker knows the
    // symbol is someone else's.
    if (declNode.kind == ASTNodeKind.EXTERN_BLOCK) {
      emitExternDeclares(ref e, ref prog, ref tm, m, declNode);
    }
    // A type's METHODS are ordinary functions with a `ref self` first
    // parameter, emitted under a name that carries the type. The type itself
    // still contributes no code.
    if (declNode.kind == ASTNodeKind.TYPE_DECL ||
        declNode.kind == ASTNodeKind.VARIANT_DECL) {
      const err = emitMethods(ref e, ref prog, ref tm, m, declNode);
      if (err.len > 0) {
        return err;
      }
    }
    // A TYPE_DECL contributes no code until something instantiates it, and an
    // IMPORT_DECL never contributes any.
    i += 1;
  }
  return "";
}

// Every METHOD in a type decl's member run. Fields contribute nothing; a method
// is a function whose receiver happens to be spelled `self`.
function emitMethods(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode
): string {
  // A GENERIC type's methods are templates: their `ref self` is `Box<T>`, whose
  // layout is unknown until T is. Emitting one produces IR that operates on the
  // template type and does not verify.
  //
  // The right answer is to emit one copy per instantiation, the way generic
  // FUNCTIONS already are - but that needs a "current type instance" on the Cx
  // for `resolvedTypeAt` to substitute against, which generic functions get
  // from `cx.instance` and type methods have no equivalent of. Refused by name
  // until that exists; typechecking them already works, which is what std
  // needed.
  if (declNode.childA != 0 && declNodeHasMethods(ref m.ast, declNode)) {
    return unsupportedHere(
      "a method on a generic type, which needs one copy emitted per instantiation",
      declNode.name
    );
  }

  let i: usize = 0;
  while (i < declNode.childCount) {
    const member = nodeAt(ref m.ast, childAt(ref m.ast, declNode, i));
    if (member.kind == ASTNodeKind.METHOD_DECL) {
      const err = emitFunction(ref e, ref prog, ref tm, m, member, NO_FUNC_INSTANCE);
      if (err.len > 0) {
        return err;
      }
    }
    i += 1;
  }
  return "";
}

// Every monomorphization of one generic function decl. The instances belong to
// the whole PROGRAM, so this picks out the ones whose origin is this decl.
function emitFunctionInstances(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode
): string {
  const declId = genericFuncDeclIdOf(ref prog, ref tm, declNode.name);
  if (declId == DECL_NONE_ID) {
    return "";
  }
  let i: usize = 0;
  while (i < prog.funcInstances.len) {
    if (funcInstanceAt(ref prog, i).origin == declId) {
      const err = emitFunction(ref e, ref prog, ref tm, m, declNode, i);
      if (err.len > 0) {
        return err;
      }
    }
    i += 1;
  }
  return "";
}

function emitFunction(
  ref e: Emitter,
  ref prog: Program,
  ref tm: TypedModule,
  m: Module,
  declNode: ASTNode,
  instance: usize
): string {
  // A coroutine, and there is no coroutine lowering. Refused HERE rather than
  // waved through, because an `async` function emitted as an ordinary one
  // compiles and links and then simply never suspends - a silent miscompile
  // instead of a missing feature.
  if (map.mapContainsKey(ref tm.pausableNames, declNode.name)) {
    return unsupportedHere(
      "a coroutine - a function carrying a pausable kind such as `async` or `task`",
      declNode.name
    );
  }

  // One locals map per function; the Cx bundles it with everything else so the
  // walk below is not threading five arguments through every call.
  disposable locals: FnLocals = localsNew();
  disposable loops: LoopStack = loopStackNew();
  // `e`, `prog` and `tm` are already refs, so they go in as-is; `ref ref T` is
  // not a thing. `m.ast` is a field of a by-value param, and taking a ref to it
  // avoids copying the whole arena.
  let cx: Cx = {
    e: e, prog: prog, tm: tm, ast: ref m.ast, locals: ref locals, loops: ref loops,
    instance: instance,
  };

  beginFunctionBuffers(ref e);
  // A method is not in the module namespace, so its return type comes from its
  // own signature rather than from a name lookup.
  const isMethod = declNode.kind == ASTNodeKind.METHOD_DECL;
  let retTy = returnTypeOf(ref cx, declNode.name);
  if (isMethod) {
    retTy = methodReturnTypeOf(ref cx, declNode);
  }

  disposable params: Vec<ParamInfo> = vec.vecNew(4);
  collectParams(ref cx, declNode, ref params);

  let symbol = definitionSymbol(ref cx, declNode.name);
  if (isMethod) {
    symbol = methodDefinitionSymbol(ref cx, declNode);
  }
  emitFunctionOpen(ref cx, symbol.home, symbol.name, retTy, ref params);
  emitParamPrologue(ref cx, ref params);

  let err = "";
  let bodyTerminated = false;
  if (declNode.childD != 0) {
    emitBlock(ref cx, declNode.childD, retTy, ref bodyTerminated, ref err);
    if (err.len > 0) {
      return err;
    }
  }

  // Every LLVM block needs a terminator, and a void function may just run off
  // the end in yoop.
  if (!bodyTerminated) {
    if (text.equals(retTy, "void")) {
      emitRetVoid(ref cx);
    } else {
      return internalError("no return on some path out of", declNode.name);
    }
  }
  emitFunctionClose(ref cx);
  return "";
}

// childB is the parameter NODE_LIST. Their types come from pass D's decoration,
// which took them from the signature pass C resolved.
function collectParams(ref cx: Cx, declNode: ASTNode, ref params: Vec<ParamInfo>): void {
  if (declNode.childB == 0) {
    return;
  }
  const list = nodeAt(cx.ast, declNode.childB);
  let i: usize = 0;
  while (i < list.childCount) {
    const paramId = childAt(cx.ast, list, i);
    const paramNode = nodeAt(cx.ast, paramId);
    // `ty` is what the SIGNATURE says (a `ref` parameter is `ptr`);
    // `pointeeTy` is what it points at, which is what the body loads and stores.
    vec.vecPush(ref params, {
      name: paramNode.name,
      ty: typeOf(ref cx, paramId),
      isRef: isRefAt(ref cx, paramId),
      pointeeTy: pointeeTypeOf(ref cx, paramId),
    });
    i += 1;
  }
}

// A parameter arrives in an SSA register (`%a.arg`) but the body reads locals
// out of stack slots, so each one is spilled on entry. That is one uniform rule
// for reading a name - `mem2reg` undoes the cost.
//
//   %a.addr = alloca i32
//   store i32 %a.arg, ptr %a.addr
function emitParamPrologue(ref cx: Cx, ref params: Vec<ParamInfo>): void {
  let i: usize = 0;
  while (i < params.len) {
    const p = vec.vecGet(ref params, i);
    // A `ref` parameter arrives as a pointer to the caller's object; that
    // pointer is the slot, so there is no alloca and no spill. Every read and
    // write in the body then lands on the caller's storage, which is what a
    // borrow means.
    if (p.isRef) {
      declareRefParam(ref cx, p.name, p.pointeeTy);
      i += 1;
      continue;
    }
    const slotInfo = declareLocal(ref cx, p.name, p.ty);
    emitStoreArg(ref cx, p.ty, p.name, slotInfo.id);
    i += 1;
  }
}

// Whether a decl's member run holds any METHOD_DECL.
function declNodeHasMethods(ref ast: AST, declNode: ASTNode): bool {
  let i: usize = 0;
  while (i < declNode.childCount) {
    if (nodeAt(ref ast, childAt(ref ast, declNode, i)).kind == ASTNodeKind.METHOD_DECL) {
      return true;
    }
    i += 1;
  }
  return false;
}
