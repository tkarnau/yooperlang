  Author: Tom Karnau

  Main entry point for the self-hosted yooperlang compiler
*/

// for starters lets define a main function, and start getting a lexer stream of
// tokens from an input file.

import * as log from "std/log.yoop";
import * as intr from "std/core/intrinsics.yoop";
import * as debug from "std/debug.yoop";
import { Display } from "std/core/traits.yoop";
import * as strings from "std/core/strings.yoop";

import { isHexDigit } from "./sourceCodeProcessing/charUtils.yoop";
import { tokenize, Token } from "./sourceCodeProcessing/lexer.yoop";
import { tokenScanList } from "./contracts.yoop";

// @precompile {
//   log.info("hello, yooper from a precompile!");
// }

function main(): int {
  log.info("hello, yooper!");

  runCompilerAssertions();

  // const testStr = "ello";
  // const testStrBytes = intr.string_as_bytes(testStr);
  // const isIt = isHexDigit(testStrBytes[0]);

  // log.info(`is hex digit?: ${isIt}, value: ${testStrBytes[0]}`);

  const testStr = `
    // test program
    /* 
      this is a test
    */
    ;{}...,'\\xFF'
    "teststr"`;

  const bytes = intr.string_as_bytes(testStr);

  const tokenizeResult = tokenize(bytes);
  switch (tokenizeResult){
    case Result.Err { error: e } : {
      log.info(`tokenize error: ${e}`);
    }
    case Result.Ok { value: tokens } : {
      for tok in tokens {
        log.info(`token: ${tok}`);
      }
    }
  }

  // log.info(`tokenize result ${tokenizeResult}`);

  return 0;
}

function runCompilerAssertions(): void {
  debug.assert(strings.string_eq(tokenScanList[0].str, "..."), "tokenScanList is not sorted");
}
