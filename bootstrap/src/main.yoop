/*
  Author: Tom Karnau

  The self-hosted yooperlang compiler.

    yoopiler_boot <entry.yoop> [-o <out>]

  Runs the whole pipeline - module graph, lex, parse, typecheck, codegen, link -
  and produces an executable. The language subset it accepts is small and grows
  from the bottom up; anything outside it is refused BY NAME rather than
  mis-compiled. bootstrap/README.md has the current subset.
*/

import * as log from "std/log.yoop";
import * as env from "std/env.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { Text }, * as text from "std/core/text.yoop";

import { loadModuleGraph, LoadGraphResult, discoverStdRoot } from "./source_graph";
import { typecheckProgram, Program } from "./typecheck";
import { Severity, formatLocation } from "./diagnostics";
import { codegenProgram } from "./codegen";
import { linkExecutable } from "./link";

function main(): int {
  if (env.argCount() < 2) {
    log.error("usage: yoopiler_boot <entry.yoop> [-o <out>]");
    return 2;
  }
  const entryPath = env.argAt(1);
  let outPath = "a.out";
  if (env.argCount() >= 4) {
    outPath = env.argAt(3);   // `-o <out>`
  }

  // Where `std/...` resolves. Discovered once here and handed to the graph, so
  // the layer that RESOLVES paths never has to probe for a directory.
  const stdRoot = discoverStdRoot(env.argAt(0));

  switch (loadModuleGraph(entryPath, stdRoot)) {
    case LoadGraphResult.Err { error: e }: {
      log.error(`${e}`);
      return 1;
    }
    case LoadGraphResult.Ok { value: moduleGraph }: {
      // `disposable` here because the unhandled-disposable warning caught it:
      // Program owns the type/symbol arenas and every TypedModule's maps.
      disposable prog: Program = typecheckProgram(ref moduleGraph);
      if (reportDiagnostics(ref prog) > 0) {
        return 1;
      }
      log.info("typecheck: ok");

      switch (codegenProgram(ref prog, ref moduleGraph)) {
        case Result.Err { error: e }: {
          log.error(`codegen: ${e}`);
          return 1;
        }
        case Result.Ok { value: out }: {
          log.info("llvm IR: ok");
          disposable irText: Text = out.ir;
          disposable irPath: Text = text.fromString(outPath);
          text.push(ref irPath, ".ll");
          disposable libs: Vec<string> = out.linkLibraries;
          const linkErr = linkExecutable(
            ref irText, text.view(ref irPath), outPath, out.needsRuntime,
            ref libs, env.argAt(0)
          );
          if (linkErr.len > 0) {
            log.error(linkErr);
            return 1;
          }
          log.info(`compiled: ${outPath}`);
          return 0;
        }
      }
    }
  }
}

// Prints every accumulated diagnostic and returns the error count. Warnings do
// not stop the compile.
function reportDiagnostics(ref prog: Program): usize {
  let errors: usize = 0;
  let i: usize = 0;
  while (i < prog.diagnostics.len) {
    const d = vec.vecGet(ref prog.diagnostics, i);
    switch (d.severity) {
      case Severity.ERROR: {
        errors += 1;
        log.error(`${formatLocation(ref d)}: ${d.message}`);
      }
      case Severity.WARNING: {
        log.info(`${formatLocation(ref d)}: warning: ${d.message}`);
      }
    }
    i += 1;
  }
  return errors;
}
