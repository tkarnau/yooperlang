/*
  Author: Tom Karnau

  The self-hosted yooperlang compiler.

    yoopiler_boot <entry.yoop> [-o <out>] [--emit-ir]
    yoopiler_boot --test <dir-or-file> [filter...]

  Runs the whole pipeline - module graph, lex, parse, typecheck, codegen, link -
  and produces an executable. The language subset it accepts is small and grows
  from the bottom up; anything outside it is refused BY NAME rather than
  mis-compiled. bootstrap/README.md has the current subset.

  `--test` is the same pipeline with a generated entry module in front of it:
  find the test files, collect their suites, write a `main` that hands the table
  to std/test.yoop, and RUN what comes out. See test_mode/.
*/

import * as log from "std/log.yoop";
import * as env from "std/env.yoop";
import * as str from "std/core/strings.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { Text }, * as text from "std/core/text.yoop";

import {
  loadModuleGraph, loadModuleGraphFromSource, LoadGraphResult, discoverStdRoot
} from "./source_graph";
import { typecheckProgram, Program } from "./typecheck";
import { Severity, formatLocation } from "./diagnostics";
import { codegenProgram } from "./codegen";
import { linkExecutable, writeIrFile } from "./link";
import {
  TestPlan, planTestRun, testBinaryPath, runTestBinary, removeTestArtifacts
} from "./test_mode";

const USAGE: string = "usage: yoopiler_boot <entry.yoop> [-o <out>] [--emit-ir]\n       yoopiler_boot --test <dir-or-file> [filter...]";

function main(): int {
  // Extra positionals are suite-name FILTERS in a test run and an error in an
  // ordinary one, so they are collected either way and judged after the scan.
  disposable extras: Vec<string> = vec.vecNew(2);
  const cli = parseCommandLine(ref extras);
  if (cli.error.len > 0) {
    log.error(cli.error);
    log.error(USAGE);
    return 2;
  }

  // Where `std/...` resolves. Discovered once here and handed to the graph, so
  // the layer that RESOLVES paths never has to probe for a directory.
  const stdRoot = discoverStdRoot(env.argAt(0));

  // Not `disposable`: on a test run the plan's source bytes are MOVED into the
  // graph, which keeps them for as long as the AST's spans point into them.
  let plan: TestPlan = planTestRun(cli.test, cli.entry);
  if (plan.isTestRun) {
    if (plan.error.len > 0) {
      log.error(plan.error);
      return 1;
    }
    return runTests(ref plan, stdRoot, ref extras);
  }

  return compileGraph(loadModuleGraph(cli.entry, stdRoot), cli.out, cli.emitIr);
}

// Discover, generate, compile, run. The compile is the ORDINARY one - there is
// no test-mode typechecker and no second codegen path, only an entry module
// nobody wrote.
//
// The binary is an artifact of the run rather than of the project, so `-o` does
// not name it: it goes to the temp directory and is removed on the way out.
// Its EXIT CODE is the failure count std/test.yoop returned, and it becomes
// ours, which is what lets CI gate on the command directly.
function runTests(ref plan: TestPlan, stdRoot: string, ref filters: Vec<string>): int {
  log.info(`test: ${plan.suiteCount} suite(s) in ${plan.fileCount} file(s)`);
  const exePath = testBinaryPath();
  const built = compileGraph(
    loadModuleGraphFromSource(plan.entrySource, plan.entryPath, stdRoot),
    exePath,
    false
  );
  if (built != 0) {
    // A build that got as far as clang and stopped there still left a `.ll`
    // behind. Nobody is going to go looking for it under a pid-named path in
    // the temp directory, so it goes the same way a successful run's does.
    removeTestArtifacts(exePath);
    return built;
  }
  const code = runTestBinary(exePath, ref filters);
  removeTestArtifacts(exePath);
  return code;
}

// Everything above layer 0: typecheck a loaded graph, emit its IR, and link it.
// Returns the process exit code.
//
// Split out of `main` so an ordinary compile and a test run share it rather
// than each carrying a copy of the same five failure paths.
function compileGraph(loaded: LoadGraphResult, outPath: string, emitIr: bool): int {
  switch (loaded) {
    case LoadGraphResult.Err { error: e }: {
      log.error(`${e}`);
      return 1;
    }
    case LoadGraphResult.Ok { value: moduleGraph }: {
      // `disposable` here because the unhandled-disposable warning caught it:
      // Program owns the type/symbol arenas and every TypedModule's maps.
      disposable prog: Program = typecheckProgram(ref moduleGraph);
      if (reportDiagnostics(ref prog) > 0) {
        return 1;
      }
      log.info("typecheck: ok");

      switch (codegenProgram(ref prog, ref moduleGraph)) {
        case Result.Err { error: e }: {
          log.error(`codegen: ${e}`);
          return 1;
        }
        case Result.Ok { value: out }: {
          log.info("llvm IR: ok");
          disposable irText: Text = out.ir;
          disposable irPath: Text = text.fromString(outPath);
          text.push(ref irPath, ".ll");
          disposable libs: Vec<string> = out.linkLibraries;

          // --emit-ir stops HERE, one step short of clang. The `.ll` is written
          // where a linking run would have written it, so the two modes leave
          // the same artifact behind and only the executable is missing.
          if (emitIr) {
            const writeErr = writeIrFile(ref irText, text.view(ref irPath));
            if (writeErr.len > 0) {
              log.error(writeErr);
              return 1;
            }
            log.info(`llvm IR written to ${text.view(ref irPath)}`);
            return 0;
          }

          const linkErr = linkExecutable(
            ref irText, text.view(ref irPath), outPath, out.needsRuntime,
            ref libs, env.argAt(0)
          );
          if (linkErr.len > 0) {
            log.error(linkErr);
            return 1;
          }
          log.info(`compiled: ${outPath}`);
          return 0;
        }
      }
    }
  }
}

// A parsed command line. `error` is "" when the line is usable, and otherwise
// is the whole complaint - the caller prints it and the usage line and stops.
type CliArgs {
  entry: string,
  out: string,
  emitIr: bool,
  test: bool,
  error: string,
}

/*
  The command line, as a real scan rather than the fixed positions this used to
  read (`argAt(1)` was the entry and `argAt(3)` was the output, whatever stood
  at `argAt(2)`). `<entry> -o <out>` still means exactly what it did; what is
  new is that a flag may stand anywhere in the line and an unrecognized one is
  refused BY NAME instead of being taken for an input file.

  `--emit-ir` is the bootstrap's own spelling - the reference has no equivalent
  (its `--keep-ir` keeps a temp copy of the IR and still links). It exists
  because most of what compiles a corpus file only wants to know whether
  codegen succeeded, and the link is the expensive half.

  `--test` takes at most ONE positional, the path to search, and everything
  after it is a suite-name filter rather than a second input file. So the extra
  positionals are collected unconditionally and what they MEAN is decided once
  the whole line has been read - a `--test` written after its path would
  otherwise be refused by the flag that has not been seen yet.
*/
function parseCommandLine(ref extras: Vec<string>): CliArgs {
  let args: CliArgs = { entry: "", out: "a.out", emitIr: false, test: false, error: "" };
  const argc = env.argCount();
  let i: int32 = 1;
  while (i < argc) {
    const a = env.argAt(i);
    if (str.stringEq(a, "-o")) {
      if (i + 1 >= argc) {
        args.error = "-o needs a path";
        return args;
      }
      args.out = env.argAt(i + 1);
      i += 2;
    } else if (str.stringEq(a, "--emit-ir")) {
      args.emitIr = true;
      i += 1;
    } else if (str.stringEq(a, "--test")) {
      args.test = true;
      i += 1;
    } else if (str.stringStartsWith(a, "-")) {
      args.error = `unknown option ${a}`;
      return args;
    } else {
      if (args.entry.len == 0) {
        args.entry = a;
      } else {
        vec.vecPush(ref extras, a);
      }
      i += 1;
    }
  }
  if (!args.test && extras.len > 0) {
    args.error = `more than one input file: ${vec.vecGet(ref extras, 0)}`;
    return args;
  }
  // `--test` with no path means the current directory, so only an ordinary
  // compile needs one named.
  if (!args.test && args.entry.len == 0) {
    args.error = "no input file";
  }
  return args;
}

// Prints every accumulated diagnostic and returns the error count. Warnings do
// not stop the compile.
function reportDiagnostics(ref prog: Program): usize {
  let errors: usize = 0;
  let i: usize = 0;
  while (i < prog.diagnostics.len) {
    const d = vec.vecGet(ref prog.diagnostics, i);
    switch (d.severity) {
      case Severity.ERROR: {
        errors += 1;
        log.error(`${formatLocation(ref d)}: ${d.message}`);
      }
      case Severity.WARNING: {
        log.info(`${formatLocation(ref d)}: warning: ${d.message}`);
      }
    }
    i += 1;
  }
  return errors;
}
