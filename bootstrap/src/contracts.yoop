// Maps a TokenTags case to its source spelling. Used by Display sites
// (error messages, token dumps); the int-backed enum decays to its ordinal
// for the array index. Order MUST mirror the TokenTags decl above.
export function tagName(v: TokenTags): string {
  return TOKEN_TAG_NAMES[v];
}

// should move these into std or something perhaps

export type SortedTokenDefinition implements Comparable<SortedTokenDefinition> {
  str: string, // the value in source code that points to a tag
  tag: TokenTags,
  function compare(ref self, b: SortedTokenDefinition): int8 {
    if (self.str.len < b.str.len) {
      return 1;
    } else if (self.str.len > b.str.len) {
      return -1;
    } else {
      return 0;
    }
  }
}

// vtable Comparator<T> for Comparable<T> {
//   compare: (b: T) => int8,
// }

function sortedDefs(arr: SortedTokenDefinition[]): SortedTokenDefinition[] {
  quickSort(arr, 0, arr.len - 1);
  return arr;
}

// needs to be sorted by largest scannable to smallest by char count
// so that `...` is found instead of `.`, `.`, `.`
export const tokenScanList: SortedTokenDefinition[] = sortedDefs([
  { str: "(", tag: TokenTags.LPAREN },
  { str: ")", tag: TokenTags.RPAREN },
  { str: ";", tag: TokenTags.SEMICOLON },
  { str: "=", tag: TokenTags.EQ },
  { str: "{", tag: TokenTags.LCURLY },
  { str: "}", tag: TokenTags.RCURLY },
  { str: ":", tag: TokenTags.COLON },
  { str: ",", tag: TokenTags.COMMA },
  { str: "?", tag: TokenTags.QUESTION },
  { str: "==", tag: TokenTags.EQEQ },
  { str: "!=", tag: TokenTags.NEQ },
  { str: "!", tag: TokenTags.BANG },
  { str: "^", tag: TokenTags.CARET },
  { str: "~", tag: TokenTags.TILDE },
  { str: "<=", tag: TokenTags.LTE },
  { str: ">=", tag: TokenTags.GTE },
  { str: "<", tag: TokenTags.LT },
  { str: ">", tag: TokenTags.GT },
  { str: "&&", tag: TokenTags.ANDAND },
  { str: "&", tag: TokenTags.AMP },
  { str: "||", tag: TokenTags.OROR },
  { str: "|", tag: TokenTags.PIPE },
  { str: "<<", tag: TokenTags.LSHIFT },
  { str: ">>", tag: TokenTags.RSHIFT },
  { str: "+", tag: TokenTags.PLUS },
  { str: "-", tag: TokenTags.MINUS },
  { str: "*", tag: TokenTags.MULT },
  { str: "/", tag: TokenTags.DIVIDE },
  { str: "%", tag: TokenTags.MODULUS },
  // Phase 9: compound-assignment two-char operators. Longest-first sort puts
  // these before the single-char arithmetic ops above.
  { str: "+=", tag: TokenTags.PLUSEQ },
  { str: "-=", tag: TokenTags.MINUSEQ },
  { str: "*=", tag: TokenTags.MULTEQ },
  { str: "/=", tag: TokenTags.DIVIDEEQ },
  { str: "%=", tag: TokenTags.MODULUSEQ },
  // Phase 9.G: function value type separator. Longest-first sort puts this
  // before `=` and before `>=` / `>`; the lexer's existing logic handles
  // the disambiguation against `==`.
  { str: "=>", tag: TokenTags.FATARROW },
  { str: ".", tag: TokenTags.DOT },
  { str: "..", tag: TokenTags.DOTDOT },
  { str: "...", tag: TokenTags.DOTDOTDOT },
  { str: "[", tag: TokenTags.LBRACKET },
  { str: "]", tag: TokenTags.RBRACKET },
  // Phase 11.A: attribute prefix `@`.
  { str: "@", tag: TokenTags.AT },
]);

// A reserved word that `lexIdentifierOrKeyword` promotes from IDENT to its
// dedicated tag on an exact match. Unlike `tokenScanList`, order does not
// matter here: `scanIdentity` already gave us a whole-word boundary, so we
// only ever compare complete tokens (no prefix ambiguity to length-sort away).
export type KeywordDefinition {
  str: string, // the exact lowercase source spelling
  tag: TokenTags,
}

// Mirrors the JS lexer's `keywordTagList`. Two intentional notes carried over:
//   * `contains` is absent - it's recognized CONTEXTUALLY by the parser inside
//     kind decls / propagation clauses, so it stays usable as a plain ident.
//   * `_` lexes to DISCARD - bare underscores are discarded.
export const keywordList: KeywordDefinition[] = [
  { str: "let",            tag: TokenTags.LET },
  { str: "function",       tag: TokenTags.FUNCTION },
  { str: "const",          tag: TokenTags.CONST },
  { str: "return",         tag: TokenTags.RETURN },
  { str: "if",             tag: TokenTags.IF },
  { str: "else",           tag: TokenTags.ELSE },
  { str: "while",          tag: TokenTags.WHILE },
  { str: "for",            tag: TokenTags.FOR },
  { str: "in",             tag: TokenTags.IN },
  { str: "type",           tag: TokenTags.TYPE },
  { str: "import",         tag: TokenTags.IMPORT },
  { str: "export",         tag: TokenTags.EXPORT },
  { str: "extern",         tag: TokenTags.EXTERN },
  { str: "from",           tag: TokenTags.FROM },
  { str: "as",             tag: TokenTags.AS },
  { str: "library",        tag: TokenTags.LIBRARY },
  { str: "ref",            tag: TokenTags.REF },
  { str: "break",          tag: TokenTags.BREAK },
  { str: "continue",       tag: TokenTags.CONTINUE },
  { str: "true",           tag: TokenTags.TRUE },
  { str: "false",          tag: TokenTags.FALSE },
  { str: "trait",          tag: TokenTags.TRAIT },
  { str: "implements",     tag: TokenTags.IMPLEMENTS },
  { str: "self",           tag: TokenTags.SELF },
  { str: "extends",        tag: TokenTags.EXTENDS },
  { str: "vtable",         tag: TokenTags.VTABLE },
  { str: "kind",           tag: TokenTags.KIND },
  { str: "appliesTo",      tag: TokenTags.APPLIESTO },
  { str: "requires",       tag: TokenTags.REQUIRES },
  { str: "mustCall",       tag: TokenTags.MUSTCALL },
  { str: "ownsBlock",      tag: TokenTags.OWNSBLOCK },
  { str: "beforeScopeEnd", tag: TokenTags.BEFORESCOPEEND },
  { str: "binding",        tag: TokenTags.BINDING },
  { str: "mustNotEscape",  tag: TokenTags.MUSTNOTESCAPE },
  { str: "mustNotShare",   tag: TokenTags.MUSTNOTSHARE },
  { str: "forbids",        tag: TokenTags.FORBIDS },
  { str: "scope",          tag: TokenTags.SCOPE },
  { str: "acrossScopes",   tag: TokenTags.ACROSSSCOPES },
  { str: "parameter",      tag: TokenTags.PARAMETER },
  { str: "field",          tag: TokenTags.FIELD },
  { str: "io",             tag: TokenTags.IO },
  { str: "globalState",    tag: TokenTags.GLOBALSTATE },
  { str: "task",           tag: TokenTags.TASK },
  { str: "wait",           tag: TokenTags.WAIT },
  { str: "joined",         tag: TokenTags.JOINED },
  { str: "pooled",         tag: TokenTags.POOLED },
  { str: "propagates",     tag: TokenTags.PROPAGATES },
  { str: "layout",         tag: TokenTags.LAYOUT },
  { str: "align",          tag: TokenTags.ALIGN },
  { str: "switch",         tag: TokenTags.SWITCH },
  { str: "case",           tag: TokenTags.CASE },
  { str: "default",        tag: TokenTags.DEFAULT },
  { str: "enum",           tag: TokenTags.ENUM },
  { str: "variant",        tag: TokenTags.VARIANT },
  { str: "union",          tag: TokenTags.UNION },
  { str: "null",           tag: TokenTags.NULL },
  { str: "_",              tag: TokenTags.DISCARD },
];

// *************** DRIVER CONTRACTS *************

export enum ASTNodeKind implements Display {
  FUNCTION_DECL,
  LET_DECL,
  CONST_DECL,
  TYPE_DECL,
  FIELD_DECL,
  DESTRUCTURE_DECL,
  IMPORT_DECL,
  EXPORT_DECL,
  EXTERN_FUNCTION_DECL,
  EXTERN_TYPE_DECL,
  EXPORT_C_FUNCTION_DECL,

  // literals
  TEMPLATE_LITERAL,
  STRING_PART,
  INT_LITERAL,
  FLOAT_LITERAL,
  STRING_LITERAL,
  BOOL_LITERAL,

  // expressions
  CALL_EXPRESSION,
  EXPRESSION_STATEMENT,
  EXPR_PART,
  UNARY_EXPRESSION,
  BINARY_EXPRESSION,
  FIELD_ACCESS,
  STRUCT_LITERAL,
  STRUCT_LITERAL_FIELD,

  // other
  EXTERN_BLOCK,
  BLOCK,
  PARAM,
  IDENT,
  NAMESPACE_IDENT,
  ASSIGNMENT,
  PROGRAM,
  RETURN_STATEMENT,
  IF_STATEMENT,
  WHILE_STATEMENT,
  DISCARD_STATEMENT,
  TRY_OP,

  // phase 4 refs, arrays, control flow
  FOR_LOOP,
  // phase 9.D `for item in xs { ... }` - element-walking loop over an array
  // (default sequential iteration; trait-driven iteration is a later phase).
  FOR_IN_LOOP,
  BREAK_STATEMENT,
  CONTINUE_STATEMENT,
  ARRAY_LITERAL,
  INDEX_EXPRESSION,
  REF_EXPRESSION,

  // phase 5 traits
  TRAIT_DECL,
  METHOD_SIG,
  METHOD_DECL,
  // Phase 9.G `vtable Name for TraitName { field (params) => ret, ... }`.
  // A vtable decl is a type-erased shape backing a trait - codegen emits it
  // as a LLVM struct of `{ ctx, methodPtr1, methodPtr2, ... }`.
  VTABLE_DECL,

  // phase 6 kinds
  KIND_DECL,
  KIND_APPLIES_TO_CLAUSE,
  KIND_REQUIRES_CLAUSE,
  KIND_MUSTCALL_CLAUSE,
  KIND_OWNSBLOCK_CLAUSE,
  CLEANUP_CALL,
  // phase 6.2 escape and sharing
  KIND_MUST_NOT_ESCAPE_CLAUSE,
  KIND_MUST_NOT_SHARE_CLAUSE,
  KIND_FORBIDS_CLAUSE,
  // phase 6.5 layout / composition / parameterized kinds
  KIND_LAYOUT_CLAUSE,
  // clearance kinds marker polarity (conferred | restrictive)
  KIND_MARKER_CLAUSE,
  // clearance kinds kind-decl-named transition authority
  // (clearedBy <fn> on a restrictive kind / appliedBy <fn> on a conferred kind)
  KIND_TRANSITION_CLAUSE,
  KIND_PREFIX,

  // phase 6.3 task / concurrency sugar
  WAIT_EXPRESSION,
  TASK_AUTO_WAIT,
  TASK_RELEASE,
  TASK_RETAIN,

  // phase 7.1 generics
  TYPE_PARAM,

  // phase 7.5 switch / patterns / sum types / unions
  // Phase 12 ENUM_DECL renamed to VARIANT_DECL (sum types); ENUM_VARIANT
  // renamed to VARIANT_CASE (one case inside a variant decl). The `enum`
  // keyword is reserved for the value-enum construct below.
  SWITCH_STATEMENT,
  SWITCH_ARM,
  LITERAL_PATTERN,
  VARIANT_PATTERN,
  VARIANT_DECL,
  VARIANT_CASE,
  UNION_DECL,
  VARIANT_CONSTRUCTOR,

  // Phase 12 value enums - C-style named constants of a primitive
  // underlying type (default int32). `enum<T> Name { Case (value)? , ... }`.
  // ENUM_CASE is one case inside an ENUM_DECL; its valueExpr is parsed as a
  // normal expression and const-evaluated at typecheck. The constructor and
  // pattern AST kinds reuse VARIANT_CONSTRUCTOR / VARIANT_PATTERN - the
  // typechecker stamps the right resolved type onto them.
  ENUM_DECL,
  ENUM_CASE,

  // phase 8.A unsafe pointers
  ADDRESS_OF_EXPRESSION,
  DEREF_EXPRESSION,
  NULL_LITERAL,
  UNSAFE_PTR_CAST,

  // phase 8.D errno intrinsics
  ERRNO_INTRINSIC,

  // phase 9.E array slice syntax `xs[i..j]`
  SLICE_EXPRESSION,

  // phase 9 compound assignments `x += y`, `x -= y`, etc. Stored as a
  // dedicated node so codegen can address the lvalue once (no double-eval
  // of expressions inside `xs[f()] += 1`).
  COMPOUND_ASSIGNMENT,

  // test undefined kind handling for iteration tests
  FAIL_TEST_KIND,

  // phase 11.A `@<name>(args?) target` compile-time / static-analysis
  // attribute. The `target` field carries the AST node the attribute
  // decorates (a decl, statement, block, or null for bare attribute
  // statements). Per-attribute behavior lives in
  // src/jsyoopattributes/registry.js - the AST node itself is just the
  // carrier. Codegen must consume every ATTRIBUTE node before emission;
  // any that survive are an internal-error.
  ATTRIBUTE,
  NODE_LIST, // with a fat node, the list of nodes allows a level of indirection
  // type annotation kinds
  TYPE_ANNOTATION_REF_TYPE,
  TYPE_ANNOTATION_TYPE_NAME,
  function to_string(ref self): string {
    return kindName(self);
  }
}

