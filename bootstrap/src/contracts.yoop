  "TYPE_ANNOTATION_REF_TYPE",
  "TYPE_ANNOTATION_TYPE_NAME",
];

// Maps an ASTNodeKind case to its source spelling. Used by Display sites
// (error messages, AST dumps); the int-backed enum decays to its ordinal
// for the array index. Order MUST mirror the ASTNodeKind decl above.
export function kindName(v: ASTNodeKind): string {
  return AST_NODE_KIND_NAMES[v];
}

export function astNodeFlagAName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.INT_LITERAL: {
      return "negated";
    }
    case ASTNodeKind.PARAM: {
      return "isRef";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildAName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.TYPE_DECL,
         ASTNodeKind.FUNCTION_DECL: {
      return "typeParams";
    }
    case ASTNodeKind.KIND_PREFIX: {
      return "argsList";
    }
    case ASTNodeKind.TYPE_ANNOTATION_REF_TYPE: {
      return "inner";
    }
    case ASTNodeKind.PARAM,
         ASTNodeKind.CONST_DECL,
         ASTNodeKind.LET_DECL: {
      return "typeAnnotation";
    }
    case ASTNodeKind.BLOCK: {
      return "statementsList";
    }
    case ASTNodeKind.RETURN_STATEMENT: {
      return "returnExpression";
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return "leftNode";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildBName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.TYPE_DECL: {
      return "kindPrefix";
    }
    case ASTNodeKind.FUNCTION_DECL: {
      return "functionParamList";
    }
    case ASTNodeKind.CONST_DECL,
         ASTNodeKind.LET_DECL: {
      return "assignmentExpression";
    }
    case ASTNodeKind.BINARY_EXPRESSION: {
      return "rightNode";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildCName(v: ASTNodeKind): string {
  switch (v) {
    case ASTNodeKind.FUNCTION_DECL: {
      return "returnTypeAnnotation";
    }
    default: {
      return "undefined";
    }
  }
}

export function astNodeChildDName(v: ASTNodeKind): string {
  switch(v) {
    case ASTNodeKind.FUNCTION_DECL: {
      return "functionBody";
    }
    default: {
      return "undefined";
    }
  }
}

export type NodeId = usize;

export type SourceLocation implements Display {
  pos: usize,
  line: usize,
  column: usize,
  length: usize,
  function to_string(ref self): string {
    return `pos: ${self.pos}, line: ${self.line}, column: ${self.column}, length: ${self.length}`;
  }
}

// note(tom): Flat and Fat nodes for now, child slots and flag slots reused:
// what each slot means depends on the `astNodeKind` and you just have to
// look it up for now in the string helpers, it is too big of a headache to stitch a dynamic shape
// through all the places needed. Childs are 64 bit node ids and Flags are bools.
// after bootstrapping is done, we can implement a language feature to help, but
// not sure what we'd want anyhow, yet.
@derive(display)
export type ASTNode {
  kind: ASTNodeKind,
  sourceLoc: SourceLocation,
  name: string,

  // variable-arity children: a slice into AST.childIds. This is the node's
  // PRIMARY list (PROGRAM.body, CALL.args, STRUCT_LITERAL.fields, SWITCH.arms,
  // TYPE_DECL.fields, ...). Any ADDITIONAL list a kind needs is reached through
  // a named single-child slot below pointing at a NODE_LIST whose own
  // childStart/childCount holds that list.
  childStart: usize,
  // Can I actually use this? Since nodes are arbitrarily added to the list?
  // Wouldn't we only want direct descendents in this count? You can't just
  // take it from the childStart and count...
  childCount: usize, 

  // Named single-child slots for the fat node (0 = none, since NodeId 0 is the
  // reserved "none" sentinel - no real node lives at arena index 0). Each kind
  // documents its own meaning, e.g.
  //   TYPE_DECL:     childA = typeParams list-node
  //   FUNCTION_DECL: childA = typeParams, childB = params, childC = returnType
  childA: NodeId,
  childB: NodeId,
  childC: NodeId,
  childD: NodeId,

  // scalar payload reused per kind (e.g. IMPORT_DECL's source-path span)
  spanStart: usize,
  spanLen: usize,
  operator: TokenTags,

  strId: usize,
  intVal: uint64,
  flagA: bool, // per-kind flags
  // ...the result of the fat-node scalar/NodeId slots
  // function to_string(ref self): string {
  //   let nameStr = self.name;
  //   if (self.name.len == 0) {
  //     nameStr = "none";
  //   }
  //   return `
  //     name: ${nameStr},
  //     kind: ${kindName(self.kind)},
  //     sourceLoc: (${self.sourceLoc}),
  //     childStart: ${self.childStart},
  //     childCount: ${self.childCount},
  //     childA (slot: ${astNodeChildAName(self.kind)}): ${self.childA},
  //     childB (slot: ${astNodeChildBName(self.kind)}): ${self.childB},
  //     childC (slot: ${astNodeChildCName(self.kind)}): ${self.childC},
  //     childD (slot: ${astNodeChildDName(self.kind)}): ${self.childD},
  //     spanStart: ${self.spanStart},
  //     spanLen: ${self.spanLen},
  //     operator: ${tagName(self.operator)},
  //     strId: ${self.strId},
  //     intVal: ${self.intVal},
  //     flagA (slot: ${astNodeFlagAName(self.kind)}): ${self.flagA}`;
  // }
}


@derive(display)
export type AST /* implements Display */ propagates<disposable> {
  nodes: Vec<ASTNode>,
  childIds: Vec<NodeId>,
  strings: Vec<string>, // string pool: decoded string-literal text
  root: NodeId,
  // function to_string(ref self): string {
  //   // Debug dump of the whole arena. We collect each line as its own string
  //   // piece and concat once at the end (the path_join pattern in std/fs) -
  //   // far cheaper than re-allocating a growing accumulator per node.
  //   disposable pieces: Vec<string> = vec.vec_new(self.nodes.len + self.strings.len + self.childIds.len + 4);

  //   vec.vec_push(ref pieces,
  //     `AST { root: ${self.root}, nodes: ${self.nodes.len}, childIds: ${self.childIds.len}, strings: ${self.strings.len} }\n`);

  //   // Node arena. Index 0 is the reserved "none" sentinel, so real nodes
  //   // begin at 1. ASTNode implements Display, so `${n}` dispatches to its
  //   // own to_string (Phase 9.F template interpolation).
  //   let i: usize = 1;
  //   while (i < self.nodes.len) {
  //     let n: ASTNode = vec.vec_get(ref self.nodes, i);
  //     vec.vec_push(ref pieces, `  node[${i}]: {${n}\n  }\n`);
  //     i = i + 1;
  //   }

  //   // Flat child-id pool (nodes index into this via childStart/childCount).
  //   vec.vec_push(ref pieces, "  childIds: [ ");
  //   let c: usize = 0;
  //   while (c < self.childIds.len) {
  //     vec.vec_push(ref pieces, `${vec.vec_get(ref self.childIds, c)} `);
  //     c = c + 1;
  //   }
  //   vec.vec_push(ref pieces, "]\n");

  //   // String pool.
  //   let s: usize = 0;
  //   while (s < self.strings.len) {
  //     vec.vec_push(ref pieces, `  str[${s}]: "${vec.vec_get(ref self.strings, s)}"\n`);
  //     s = s + 1;
  //   }

  //   let arr: string[] = vec.vec_as_array(ref pieces);
  //   return str.string_concat_all(arr);
  // }
}

export type ImportEdge {
  nodeId: NodeId,
  resolvedModuleIndex: usize,
  resolvedModuleId: string,
}

export type Module propagates<disposable> {
  id: string,
  absPath: string,
  src: Vec<uint8>,
  ast: AST,
  imports: Vec<ImportEdge>,
}

export type ModuleGraph propagates<disposable> {
  modules: Vec<Module>,            // topo-ordered, leaves first; the entry is IN this list
  entryIndex: usize,               // index of the entry module in `modules` (not a copy)
  autoLoadModuleIds: Map<string, string>,
}

export type ParsingError implements Display {
  sourceLoc: SourceLocation,
  isParseError: bool,
  rawMessage: string,
  src: ref uint8[],
  err: string,
  function to_string(ref self): string {
    let lowerBound: usize;
    let upperBound: usize;
    let relativePos: usize = 4;
    if (self.sourceLoc.column >= 5) {
      lowerBound = self.sourceLoc.pos - 5;
    } else {
      lowerBound = self.sourceLoc.pos - self.sourceLoc.column;
      relativePos = self.sourceLoc.column;
    }
    
    const srcRef = self.src;
    let maxOffSet: usize = 5;
    if (srcRef.len <= 5) {
      maxOffSet = srcRef.len;
    }
    if (self.sourceLoc.column < (srcRef.len - maxOffSet)) {
      upperBound = self.sourceLoc.pos + maxOffSet;
    } else {
      upperBound = self.sourceLoc.pos;
    }

    let codestr: string = "";
    const codestrRes = str.string_from_bytes(bytes.bytes_slice(srcRef, lowerBound, upperBound));
    switch (codestrRes) {
      case Result.Err { error: e }: {
        codestr = e;
      }
      case Result.Ok { value: v}: {
        codestr = v;
      }
    }
    let caretStr = "^";
    let caretStrCtr: usize = 0;
    while (caretStrCtr < relativePos) {
      caretStr = ` ${caretStr}`;
      caretStrCtr += 1;
    }
    return `err: ${self.err},
sourceLoc: ${self.sourceLoc},
rawMessage: ${self.rawMessage},
isParseError: ${self.isParseError}
code:
\t${codestr}
\t${caretStr}`;
  }
}

export type ParsingResult = Result<NodeId, ParsingError>;

// ===========================================================================
// Typecheck-layer contracts (Layer 3): the interned Type + Symbol model.
//
// This deliberately DIVERGES from the JS reference internals (see the deviation
// policy in plans/bootstrap-pipeline-contracts.md - only the TypedProgram
// BOUNDARY is a contract; the tables inside a pass are free to differ). Two JS
// patterns do not port to a value-semantic language, and each has a clean
// collapse here:
//
//   1. src/jsyooptypecheck/types.js reference-shares "shell" type objects and
//      MUTATES them in place across passes (StructType.fields filled in pass C,
//      TraitType.methods, TypeParamType.bounds). yoop cannot mutate a
//      copied-around value, so instead every type is INTERNED in one arena
//      (Program.types: Vec<Type>) and referred to by an integer `TypeId`. Pass A
//      inserts a shell; pass C REPLACES the whole arena slot
//      (types.set(id, filled)). `NominalDecl.populated` is the shell/filled bit
//      that replaces JS's `fields: null` sentinel (which a Vec can't express).
//
//   2. The JS ModuleEnvironment splits one logical namespace across 13
//      string-keyed tables (structTable, traitTable, variantTable, the generic*
//      tables, ...). Here a module scope is ONE Map<string, SymbolId> whose
//      value is a `Symbol`. Name lookup is one get + one switch, not an
//      N-table `??` fallthrough, and the redeclaration check is one `has`.
//
// KindType is intentionally NOT a Type case: a kind is a decl, not a value's
// type. It lives in the symbol table as `Symbol.Kind` (a KindId into a separate
// kinds table). That drops the single heaviest, most-mutable JS type case out
// of the type arena entirely.
// ===========================================================================

export type TypeId   = usize;   // index into Program.types  (0 = none/error sentinel)
export type SymbolId = usize;   // index into Program.symbols
export type ModuleId = usize;   // index into Program.modules
export type DeclId   = usize;   // stable per-decl id for a generic origin (0 = none)
export type KindId   = usize;   // index into the kinds table (0 = none)
// NodeId is already declared above (the AST arena uses it).

// Canonical primitive kinds. Resolution canonicalizes source spellings up front
// (`int` -> INT32, `float` -> FLOAT32, the c_* aliases -> their LP64 widths), so
// the arena only ever holds a canonical PrimKind, never a raw name string.
export enum PrimKind {
  INT8, INT16, INT32, INT64, ISIZE,
  UINT8, UINT16, UINT32, UINT64, USIZE,
  FLOAT32, FLOAT64,
  BOOL, STRING,
}

// Which generic-decl family a `Symbol.GenericDecl` points at. Replaces the JS
// genericStructTable / genericFuncTable / genericTraitTable / genericVariantTable
// four-table split with one tag; the decl itself lives in a side table keyed by
// DeclId. Concrete instantiations never live here - they go in the registry.
export enum GenericSort { STRUCT, FUNC, TRAIT, VARIANT }

// Identity shared by every nominal type (struct / variant / union / enum /
// trait / vtable). `populated` is the shell/filled bit: pass A registers a shell
// (populated = false, empty member lists) so cross-module and forward refs
// resolve; pass C re-sets the arena slot with populated = true once fields /
// methods are known. This is the value-semantic replacement for the JS
// `fields: null` shell sentinel.
@derive(display)
export type NominalDecl {
  name: string,
  module: ModuleId,
  populated: bool,
}

// When a nominal type is an instantiation of a generic decl, `origin` names the
// generic decl and `args` are the type-args used. `origin == 0` means "not an
// instance". Substitution re-instantiates open instances (args that are
// themselves TypeParams) through the registry.
@derive(display)
export type GenericInst propagates<disposable> {
  origin: DeclId,
  args: Vec<TypeId>,
}

@derive(display)
export type Field {
  name: string,
  typeId: TypeId,
}

// One case of a tagged `variant`. `ordinal` is the stable 0-indexed
// declaration-order tag and is ABI: reordering cases changes the emitted i32
// discriminator. Empty `fields` = a payload-less case.
@derive(display)
export type VariantCase propagates<disposable> {
  name: string,
  ordinal: int,
  fields: Vec<Field>,
}

// One case of a value `enum`. `value` is the case's compile-time constant of the
// enum's underlying primitive. For `enum<string>` the constant is a string;
// store its string-pool index here (or add a valueStr slot) when Phase-12 string
// enums land in the bootstrap.
@derive(display)
export type EnumCase {
  name: string,
  ordinal: int,
  value: int64,
}

// The interned type. Every inner type reference is a `TypeId` (an arena index),
// never a nested `Type` value - that indirection is what sidesteps recursive
// value ownership and lets a pass "fill a shell" by re-setting one slot. Mirrors
// the ~22 constructors in src/jsyooptypecheck/types.js, minus KindType (now a
// Symbol) and with the JS mutable exceptions (Struct.fields, Trait.methods,
// TypeParam.bounds) folded into the uniform shell-then-reset pattern.
@derive(display)
export variant Type propagates<disposable> {
  // Leaves: no inner TypeId. The singletons below should get RESERVED low
  // TypeIds allocated once at Program init, so equality on them is `id == id`.
  Prim            { prim: PrimKind },
  Void,
  UntypedInt,
  UntypedFloat,
  UntypedNull,
  ErrorT,
  SelfPlaceholder,                        // trait-method `ref self` placeholder

  // Structural: compose other TypeIds.
  Ref       { inner: TypeId },
  Array     { elem: TypeId },
  Task      { result: TypeId },
  UnsafePtr { pointee: TypeId },          // pointee 0 = opaque `unsafe_ptr` (no <T>)
  Func      { params: Vec<TypeId>, ret: TypeId, variadic: bool },
  FuncPtr   { params: Vec<TypeId>, ret: TypeId },   // `(p: T) => R` value type
  Namespace { module: ModuleId },         // `import * as ns`; exports on the scope

  // Nominal: named, per-module, shell-then-filled (see NominalDecl.populated).
  Struct    { decl: NominalDecl, fields: Vec<Field>, methods: Map<string, TypeId>,
              implementsTraits: Vec<TypeId>, generic: GenericInst },
  Variant   { decl: NominalDecl, cases: Vec<VariantCase>, methods: Map<string, TypeId>,
              implementsTraits: Vec<TypeId>, generic: GenericInst },
  Union     { decl: NominalDecl, fields: Vec<Field> },
  ValueEnum { decl: NominalDecl, underlying: TypeId, cases: Vec<EnumCase>, isOpen: bool },
  Trait     { decl: NominalDecl, methods: Map<string, TypeId>,
              typeParams: Vec<TypeId>, extendsTraits: Vec<TypeId> },
  VTable    { decl: NominalDecl, forTrait: TypeId, fields: Vec<Field>,
              methodOrder: Vec<string> },

  // Generics: a TypeParam placeholder inside a generic body. `bounds` is empty
  // in pass A and re-set in pass C once `implements` clauses resolve.
  TypeParam { name: string, originDecl: DeclId, bounds: Vec<TypeId> },
}

// A module-level name binding. One symbol namespace per module (a module scope
// is Map<string, SymbolId>) replaces the JS 13-table split; the value here says
// what the name means, so lookup is one get + one switch.
//
// The eight type-carrying cases (Struct..Vtable) could collapse into a single
// `Type { typeId }`, since Program.types[typeId] already discriminates which
// nominal kind it is - kept explicit here for 1:1 readability against the JS
// tables. Collapse if the redundancy bites. Symbol is all-scalar (no Vec/Map),
// so unlike Type it needs no `propagates` clause.
@derive(display)
export variant Symbol {
  Struct      { typeId: TypeId },
  Func        { typeId: TypeId },         // a named function's FuncType
  Value       { typeId: TypeId },         // a module-level const binding
  Trait       { typeId: TypeId },
  VariantT    { typeId: TypeId },         // tagged `variant` (enum-with-payload)
  Union       { typeId: TypeId },
  ValueEnum   { typeId: TypeId },
  Vtable      { typeId: TypeId },
  Alias       { annot: NodeId, home: ModuleId },   // transparent `type X = ...` RHS
  Kind        { kindId: KindId },         // a kind decl (disposable, tainted, ...)
  GenericDecl { decl: DeclId, sort: GenericSort }, // stays out of the concrete tables
  Namespace   { module: ModuleId },       // `import * as ns`
  Imported    { target: SymbolId },       // by-name import: a redirect to another module's symbol
}

// A typecheck diagnostic. Unlike lex/parse (which fail fast via Result), the
// typechecker ACCUMULATES these and never throws - the whole
// program is checked so the user sees every error at once. `sourceLoc` points
// into the original module source.
export enum Severity { ERROR, WARNING }

@derive(display)
export type Diagnostic {
  message: string,
  sourceLoc: SourceLocation,
  severity: Severity,
}

// Per-module typecheck state, indexed positionally by ModuleId (parallel to the
// driver's module list). This does NOT own the module's AST - the ModuleGraph
// does; decoration references nodes by NodeId (decision D2), so codegen reads
// the AST from the graph and the resolved types from here, correlated by index.
@derive(display)
export type TypedModule propagates<disposable> {
  moduleId: string,               // stable id copied from Module.id; mangling basis
  names: Map<string, SymbolId>,   // the one symbol namespace (replaces the 13 JS tables)
  exports: Map<string, SymbolId>, // the exported subset of `names`
  resolvedTypes: Vec<TypeId>,     // dense decoration, indexed by NodeId (0 = none / infer-later)
  allowsUnsafe: bool,
  // Sparse decorations (calleeMangled, genericInstances, castTargets, ...) are
  // added as Map<NodeId, T> slots here when the checker needs them.
}

// The whole-program output of typecheckProgram. Types and symbols are interned
// ONCE across the program (TypeId / SymbolId are global indices); per-module
// name maps point into the shared `symbols` arena, which is what makes an import
// just a name binding. Holds the accumulated diagnostics rather than returning a
// Result - see Diagnostic above.
@derive(display)
export type Program propagates<disposable> {
  types: Vec<Type>,             // interned; indexed by TypeId (low ids reserved for singletons)
  symbols: Vec<Symbol>,         // interned; indexed by SymbolId
  modules: Vec<TypedModule>,    // by ModuleId; parallel to the driver's modules
  diagnostics: Vec<Diagnostic>,
  // registry: InstantiationRegistry - deferred until generics land in the bootstrap.
}