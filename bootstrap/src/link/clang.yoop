module link;

// Layer 6: LLVM IR text -> executable, by shelling out to clang.
//
// This layer is identical in both implementations by design - it is the one
// layer that does not deviate. The only wrinkle is that yoop has no process
// API, so we reach for libc's `system` directly. That is why this
// file is `import.unsafe`.
//
// A program that only touches libc needs no yoop runtime, which is what keeps
// the link line down to one clang invocation and one input. When codegen says
// it emitted a call into the runtime, its C sources join the line - see
// runtime_root.yoop for which and why the whole set.

import.unsafe;

import * as fs from "std/fs.yoop";
import * as str from "std/core/strings.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";

extern "C" from "stdlib.h" {
  function system(cmd: string): c_int;
}

// Which platform we are building for. The reference reads `process.platform`;
// this is the bootstrap's equivalent, and the three platform-dependent rules
// below are the reason it exists. Values mirror YOOP_PLATFORM_* in
// runtime/yoop_runtime.h - see yoop_runtime_platform there for why an int.
//
// Declared here rather than reached for through std/runtime.yoop deliberately:
// that module is not in the bootstrap's import graph today, and the bootstrap
// has to COMPILE everything it imports. Adding a module to the self-hosting
// graph to read one integer is a much larger bet than one extern line.
extern "C" from "yoop_runtime" {
  function yoop_runtime_platform(): c_int;
}

export const PLATFORM_LINUX: c_int = 1;
export const PLATFORM_MACOS: c_int = 2;
export const PLATFORM_WINDOWS: c_int = 3;

// Writes `ir` to `irPath`. Returns "" on success or a human-readable error.
//
// Split out of `linkExecutable` for `--emit-ir`, which wants the first half of
// the layer and none of the second. One writer rather than two, so the file a
// linking run leaves behind and the file `--emit-ir` produces are the same
// bytes at the same path by construction.
export function writeIrFile(ref ir: Text, irPath: string): string {
  const writeErr = fs.writeFile(irPath, text.bytes(ref ir));
  if (writeErr.len > 0) {
    return `writing ${irPath}: ${writeErr}`;
  }
  return "";
}

// Writes `ir` to `irPath`, then links it to `exePath`. Returns "" on success or
// a human-readable error.
//
// `linkLibraries` is what `extern "C" from library "X"` blocks asked for,
// collected graph-wide by codegen. A program that names none links its own IR
// and nothing else, which is the common case.
export function linkExecutable(
  ref ir: Text,
  irPath: string,
  exePath: string,
  needsRuntime: bool,
  ref linkLibraries: Vec<string>,
  exeSelfPath: string
): string {
  const writeErr = writeIrFile(ref ir, irPath);
  if (writeErr.len > 0) {
    return writeErr;
  }

  disposable cmd: Text = text.make(256);
  // `-g` keeps the DWARF the IR carries. Without it clang drops the metadata on
  // the way to the object file, and a binary compiled from debuggable IR is not
  // debuggable - with nothing in the output saying so.
  text.push(ref cmd, `clang -g -Wno-override-module -o "${exePath}" "${irPath}"`);

  if (needsRuntime) {
    const runtimeRoot = discoverRuntimeRoot(exeSelfPath);
    const problem = runtimeRootProblem(runtimeRoot);
    if (problem.len > 0) {
      return problem;
    }
    disposable sources: Vec<string> = runtimeSources(runtimeRoot);
    let i: usize = 0;
    while (i < sources.len) {
      text.push(ref cmd, ` "${vec.vecGet(ref sources, i)}"`);
      i += 1;
    }

    // The glue sources a program gets for what it LINKS rather than for
    // touching the runtime at all - `yoop_tls.c` for an OpenSSL program. See
    // runtime_root.yoop. Inside the `needsRuntime` branch because that is
    // where the runtime root is discovered, and because TLS is built on the
    // runtime's I/O: a program that reaches std/tls has already reached it.
    disposable glue: Vec<string> = glueSources(runtimeRoot, ref linkLibraries);
    let g: usize = 0;
    while (g < glue.len) {
      text.push(ref cmd, ` "${vec.vecGet(ref glue, g)}"`);
      g += 1;
    }
  }

  // `-L` and `-I` BEFORE the `-l` names: clang resolves a library against the
  // search path in effect, and a `-l` ahead of its `-L` finds nothing.
  pushSearchPaths(ref cmd);
  pushRuntimeLibraries(ref cmd);
  pushLinkLibraries(ref cmd, ref linkLibraries);

  const rc = system(text.view(ref cmd));
  if (rc != 0) {
    return `clang failed (exit ${rc}) on ${irPath}`;
  }
  return "";
}

// The libraries EVERY program links, whatever its source names. Mirrors
// `runtimeLinkFlags` in src/runtimeBuild.js.
//
// `m` is Linux-only, and not as an optimization - it is the only platform where
// libm is a separate library at all. glibc keeps the math functions in libm.so,
// so codegen lowering a float `%` to a `fmod` call links with "undefined
// reference to fmod" without it. macOS and Windows fold the math functions into
// the one C library every link already gets, and Windows has no `m` to name:
// asking for it there is a hard "cannot open input file 'm.lib'".
//
// `pthread` goes on both POSIX platforms for parity with the reference, even
// though a current glibc does not need it (2.34 merged libpthread into libc)
// and macOS never did. It costs nothing on either and is what an older glibc
// wants.
// Takes the platform rather than reading it, so a test can assert all three on
// whichever machine it happens to run on. `collectSearchPaths` is split from
// `pushSearchPaths` in search_paths.yoop for the same reason: a rule that
// varies by platform is exactly the rule a one-platform test cannot cover.
export function pushRuntimeLibrariesFor(ref cmd: Text, platform: c_int): void {
  if (platform == PLATFORM_WINDOWS) {
    return;
  }
  text.push(ref cmd, " -lpthread");
  if (platform == PLATFORM_LINUX) {
    text.push(ref cmd, " -lm");
  }
}

function pushRuntimeLibraries(ref cmd: Text): void {
  pushRuntimeLibrariesFor(ref cmd, yoop_runtime_platform());
}

// `-lm`, `-framework OpenGL`, and the OpenSSL pair.
//
// Three rules, and all three are the reference's (`lowerLinkFlag` in
// src/toolchain.js) so a program links the same way under either compiler:
//
//   * `framework:NAME` is an APPLE linker concept and lowers to
//     `-framework NAME` there. Off Apple it drops, with one exception:
//     `framework:OpenGL` names the platform's OpenGL and every platform has
//     one, so it becomes `-lopengl32` on Windows and `-lGL` on Linux. Deciding
//     that needs a way to ask what is being built for, which is what
//     `yoop_runtime_platform` is.
//   * `ssl` and `crypto` each mean BOTH. libssl is the protocol and libcrypto
//     is everything underneath it, and libssl cannot link without it; making a
//     user name both would be a papercut whose failure mode is a wall of
//     unresolved symbols rather than a message.
//   * everything else is `-lNAME`.
//
// Where clang LOOKS for those libraries is search_paths.yoop, which is a
// separate question and a separate file. The corpus needs it:
// `examples/pass/https_client/main.yoop` does not link without it.
function pushLinkLibraries(ref cmd: Text, ref libs: Vec<string>): void {
  let i: usize = 0;
  while (i < libs.len) {
    const name = vec.vecGet(ref libs, i);
    if (str.stringStartsWith(name, FRAMEWORK_PREFIX)) {
      pushFramework(ref cmd, name);
    } else if (str.stringEq(name, "ssl") || str.stringEq(name, "crypto")) {
      text.push(ref cmd, " -lssl -lcrypto");
    } else {
      text.push(ref cmd, " -l");
      text.push(ref cmd, name);
    }
    i += 1;
  }
}

// One `framework:NAME` name, lowered for the platform being built for.
//
// Apple gets the real thing. Windows gets `opengl32` for OpenGL and nothing for
// anything else, since every other framework name really is Apple's. Linux
// drops the lot: it has no framework concept, and passing `-framework` to a GNU
// ld is an "unrecognized option" rather than something it ignores.
// Platform passed in rather than read, for the reason given on
// `pushRuntimeLibrariesFor`.
export function pushFrameworkFor(ref cmd: Text, name: string, platform: c_int): void {
  if (platform == PLATFORM_MACOS) {
    text.push(ref cmd, " -framework ");
    // The name after the prefix, pushed BYTE by byte: `stringSlice` returns a
    // Result whose Ok is a fresh malloc, and a link line is not worth one.
    pushFrom(ref cmd, name, FRAMEWORK_PREFIX.len);
    return;
  }
  // OpenGL is the one framework name that means something off Apple, because
  // every platform has an OpenGL: opengl32 on Windows, libGL on Linux. Every
  // other framework name really is Apple's and drops.
  if (!str.stringEq(name, "framework:OpenGL")) {
    return;
  }
  if (platform == PLATFORM_WINDOWS) {
    text.push(ref cmd, " -lopengl32");
  } else if (platform == PLATFORM_LINUX) {
    text.push(ref cmd, " -lGL");
  }
}

function pushFramework(ref cmd: Text, name: string): void {
  pushFrameworkFor(ref cmd, name, yoop_runtime_platform());
}

const FRAMEWORK_PREFIX: string = "framework:";

// The bytes of `s` from `start` on, appended. No allocation: `stringSlice`
// would hand back an owned copy nothing frees.
function pushFrom(ref out: Text, s: string, start: usize): void {
  const raw = intr.stringAsBytes(s);
  let i: usize = start;
  while (i < raw.len) {
    text.pushByte(ref out, raw[i]);
    i += 1;
  }
}
