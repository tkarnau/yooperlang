module link;

// Layer 6: LLVM IR text -> executable, by shelling out to clang.
//
// This layer is identical in both implementations by design - the contracts doc
// calls it the one that does not deviate. The only wrinkle is that yoop has no
// process API yet, so we reach for libc's `system` directly. That is why this
// file is `import.unsafe`.
//
// A program that only touches libc needs no yoop runtime, which is what keeps
// the link line down to one clang invocation and one input. When codegen says
// it emitted a call into the runtime, its C sources join the line - see
// runtime_root.yoop for which and why the whole set.

import.unsafe;

import * as fs from "std/fs.yoop";
import * as str from "std/core/strings.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";

extern "C" from "stdlib.h" {
  function system(cmd: string): c_int;
}

// Writes `ir` to `irPath`. Returns "" on success or a human-readable error.
//
// Split out of `linkExecutable` for `--emit-ir`, which wants the first half of
// the layer and none of the second. One writer rather than two, so the file a
// linking run leaves behind and the file `--emit-ir` produces are the same
// bytes at the same path by construction.
export function writeIrFile(ref ir: Text, irPath: string): string {
  const writeErr = fs.writeFile(irPath, text.bytes(ref ir));
  if (writeErr.len > 0) {
    return `writing ${irPath}: ${writeErr}`;
  }
  return "";
}

// Writes `ir` to `irPath`, then links it to `exePath`. Returns "" on success or
// a human-readable error.
//
// `linkLibraries` is what `extern "C" from library "X"` blocks asked for,
// collected graph-wide by codegen. A program that names none links its own IR
// and nothing else, which is the common case.
export function linkExecutable(
  ref ir: Text,
  irPath: string,
  exePath: string,
  needsRuntime: bool,
  ref linkLibraries: Vec<string>,
  exeSelfPath: string
): string {
  const writeErr = writeIrFile(ref ir, irPath);
  if (writeErr.len > 0) {
    return writeErr;
  }

  disposable cmd: Text = text.make(256);
  text.push(ref cmd, `clang -Wno-override-module -o "${exePath}" "${irPath}"`);

  if (needsRuntime) {
    const runtimeRoot = discoverRuntimeRoot(exeSelfPath);
    const problem = runtimeRootProblem(runtimeRoot);
    if (problem.len > 0) {
      return problem;
    }
    disposable sources: Vec<string> = runtimeSources(runtimeRoot);
    let i: usize = 0;
    while (i < sources.len) {
      text.push(ref cmd, ` "${vec.vecGet(ref sources, i)}"`);
      i += 1;
    }

    // The glue sources a program gets for what it LINKS rather than for
    // touching the runtime at all - `yoop_tls.c` for an OpenSSL program. See
    // runtime_root.yoop. Inside the `needsRuntime` branch because that is
    // where the runtime root is discovered, and because TLS is built on the
    // runtime's I/O: a program that reaches std/tls has already reached it.
    disposable glue: Vec<string> = glueSources(runtimeRoot, ref linkLibraries);
    let g: usize = 0;
    while (g < glue.len) {
      text.push(ref cmd, ` "${vec.vecGet(ref glue, g)}"`);
      g += 1;
    }
  }

  // `-L` and `-I` BEFORE the `-l` names: clang resolves a library against the
  // search path in effect, and a `-l` ahead of its `-L` finds nothing.
  pushSearchPaths(ref cmd);
  pushLinkLibraries(ref cmd, ref linkLibraries);

  const rc = system(text.view(ref cmd));
  if (rc != 0) {
    return `clang failed (exit ${rc}) on ${irPath}`;
  }
  return "";
}

// `-lm`, `-framework OpenGL`, and the OpenSSL pair.
//
// Three rules, and all three are the reference's (`lowerLinkFlag` in
// src/toolchain.js) so a program links the same way under either compiler:
//
//   * `framework:NAME` is an APPLE linker concept and lowers to
//     `-framework NAME`. It is dropped everywhere else, which the bootstrap
//     cannot do yet because it has no platform check - so it is emitted, and
//     that is a known gap rather than a decision.
//   * `ssl` and `crypto` each mean BOTH. libssl is the protocol and libcrypto
//     is everything underneath it, and libssl cannot link without it; making a
//     user name both would be a papercut whose failure mode is a wall of
//     unresolved symbols rather than a message.
//   * everything else is `-lNAME`.
//
// Where clang LOOKS for those libraries is search_paths.yoop, which is a
// separate question and a separate file. It used to be missing on the grounds
// that nothing in the corpus needed it; the program probe found
// `examples/pass/https_client/main.yoop`, which does.
function pushLinkLibraries(ref cmd: Text, ref libs: Vec<string>): void {
  let i: usize = 0;
  while (i < libs.len) {
    const name = vec.vecGet(ref libs, i);
    if (str.stringStartsWith(name, FRAMEWORK_PREFIX)) {
      text.push(ref cmd, " -framework ");
      // The name after the prefix, pushed BYTE by byte: `stringSlice` returns a
      // Result whose Ok is a fresh malloc, and a link line is not worth one.
      pushFrom(ref cmd, name, FRAMEWORK_PREFIX.len);
    } else if (str.stringEq(name, "ssl") || str.stringEq(name, "crypto")) {
      text.push(ref cmd, " -lssl -lcrypto");
    } else {
      text.push(ref cmd, " -l");
      text.push(ref cmd, name);
    }
    i += 1;
  }
}

const FRAMEWORK_PREFIX: string = "framework:";

// The bytes of `s` from `start` on, appended. No allocation: `stringSlice`
// would hand back an owned copy nothing frees.
function pushFrom(ref out: Text, s: string, start: usize): void {
  const raw = intr.stringAsBytes(s);
  let i: usize = start;
  while (i < raw.len) {
    text.pushByte(ref out, raw[i]);
    i += 1;
  }
}
