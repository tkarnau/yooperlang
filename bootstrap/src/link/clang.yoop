module link;

// Layer 6: LLVM IR text -> executable, by running clang.
//
// clang is run from an ARGV ARRAY through the runtime's `yoop_proc_run`, and
// never through a shell. That is a security property, not a style choice: the
// link line carries strings copied out of the program being compiled (every
// `extern "C" from library "NAME"` becomes `-lNAME`), and a shell would
// interpret every byte of them. `library "m; rm -rf ~"` used to be a command;
// as an argv element it is one library clang cannot find, and the typechecker
// refuses the name before it gets even that far (typecheck/link_names.yoop).
//
// The file is `import.unsafe` for one reason: handing the array to C means
// reading its data pointer (`.ptr`), which is gated.
//
// A program that only touches libc needs no yoop runtime, which is what keeps
// the link line down to one clang invocation and one input. When codegen says
// it emitted a call into the runtime, its C sources join the line - see
// runtime_root.yoop for which and why the whole set.

import.unsafe;

import * as fs from "std/fs.yoop";
import * as str from "std/core/strings.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { Text }, * as text from "std/core/text.yoop";
import { Vec }, * as vec from "std/core/vec.yoop";
import { disposable } from "std/core/kinds.yoop";

// Which platform we are building for. The reference reads `process.platform`;
// this is the bootstrap's equivalent, and the three platform-dependent rules
// below are the reason it exists. Values mirror YOOP_PLATFORM_* in
// runtime/yoop_runtime.h - see yoop_runtime_platform there for why an int.
//
// Declared here rather than reached for through std/runtime.yoop deliberately:
// that module is not in the bootstrap's import graph today, and the bootstrap
// has to COMPILE everything it imports. Adding a module to the self-hosting
// graph to read one integer is a much larger bet than one extern line.
//
// `yoop_proc_run` is the process primitive: argv in, exit code out, no shell.
// Its contract is on the declaration in runtime/yoop_runtime.h.
extern "C" from "yoop_runtime" {
  function yoop_runtime_platform(): c_int;
  function yoop_proc_run(argv: unsafe_ptr<string>, argc: usize): c_int;
}

// The platform this compiler is RUNNING on, which is also the one it builds
// for - nothing here cross-compiles. Exported because the link line is no
// longer the only caller: test_mode/run.yoop needs the same answer to decide
// an executable suffix.
export function currentPlatform(): c_int {
  return yoop_runtime_platform();
}

export const PLATFORM_LINUX: c_int = 1;
export const PLATFORM_MACOS: c_int = 2;
export const PLATFORM_WINDOWS: c_int = 3;

// Runs `args[0]` with `args[1..]` as its arguments and waits for it. Returns
// the child's exit code, 128 + signal for a child killed by one, or -1 when it
// could not be started (errno says why; ENOENT means "not on PATH").
//
// Every argument is delivered to the child as exactly the bytes in the
// vector. There is no shell, so there is nothing to quote and nothing to
// escape - which is the whole point, and why this is the ONE way the compiler
// runs another program. test_mode/run.yoop runs the test binary through it.
export function runProgram(ref args: Vec<string>): c_int {
  const argv = vec.vecAsArray(ref args);
  return yoop_proc_run(argv.ptr, argv.len);
}

// `out` with the suffix the platform needs to consider it an executable.
//
// Windows decides what is runnable by NAME: CreateProcess appends `.exe` when
// the name it is given has no extension, so a file literally called `hello` is
// a valid PE image that cmd, Explorer and CreateProcess all refuse to launch.
// `yoopiler_boot hello.yoop -o hello` has to produce something the user can
// then run, on every platform, and on this one that means four more
// characters. A path that already ends in `.exe` is left alone rather than
// growing a second one.
//
// The `.ll` beside it is NOT renamed - it is derived from the `-o` value as
// written, so `--emit-ir` produces the same filename on every platform and the
// probe does not need to know where it is running.
// Platform passed in rather than read, for the reason given on
// `pushRuntimeLibrariesFor`.
export function withExeSuffixFor(out: string, platform: c_int): string {
  if (platform != PLATFORM_WINDOWS) {
    return out;
  }
  // Compared over bytes rather than with stringSlice, which returns an owned
  // copy: this runs once per compile and does not need a malloc to answer a
  // four-byte question. ASCII-case-insensitive, because `-o hello.EXE` names
  // the same file to Windows and appending to it would produce hello.EXE.exe.
  const raw = intr.stringAsBytes(out);
  if (raw.len >= 4
      && raw[raw.len - 4] == 46
      && (raw[raw.len - 3] == 101 || raw[raw.len - 3] == 69)
      && (raw[raw.len - 2] == 120 || raw[raw.len - 2] == 88)
      && (raw[raw.len - 1] == 101 || raw[raw.len - 1] == 69)) {
    return out;
  }
  return `${out}.exe`;
}

export function withExeSuffix(out: string): string {
  return withExeSuffixFor(out, yoop_runtime_platform());
}

// Writes `ir` to `irPath`. Returns "" on success or a human-readable error.
//
// Split out of `linkExecutable` for `--emit-ir`, which wants the first half of
// the layer and none of the second. One writer rather than two, so the file a
// linking run leaves behind and the file `--emit-ir` produces are the same
// bytes at the same path by construction.
export function writeIrFile(ref ir: Text, irPath: string): string {
  const writeErr = fs.writeFile(irPath, text.bytes(ref ir));
  if (writeErr.len > 0) {
    return `writing ${irPath}: ${writeErr}`;
  }
  return "";
}

// Writes `ir` to `irPath`, then links it to `exePath`. Returns "" on success or
// a human-readable error.
//
// `linkLibraries` is what `extern "C" from library "X"` blocks asked for,
// collected graph-wide by codegen. A program that names none links its own IR
// and nothing else, which is the common case.
export function linkExecutable(
  ref ir: Text,
  irPath: string,
  exePath: string,
  needsRuntime: bool,
  ref linkLibraries: Vec<string>,
  exeSelfPath: string
): string {
  const writeErr = writeIrFile(ref ir, irPath);
  if (writeErr.len > 0) {
    return writeErr;
  }

  // One argv element per push. A path with a space in it is one argument, and
  // so is a path with a `$(` in it - there is no shell between here and clang
  // to read either.
  disposable args: Vec<string> = vec.vecNew(32);
  vec.vecPush(ref args, "clang");
  // `-g` keeps the DWARF the IR carries. Without it clang drops the metadata on
  // the way to the object file, and a binary compiled from debuggable IR is not
  // debuggable - with nothing in the output saying so.
  vec.vecPush(ref args, "-g");
  vec.vecPush(ref args, "-Wno-override-module");
  vec.vecPush(ref args, "-o");
  vec.vecPush(ref args, exePath);
  vec.vecPush(ref args, irPath);

  if (needsRuntime) {
    const runtimeRoot = discoverRuntimeRoot(exeSelfPath);
    const problem = runtimeRootProblem(runtimeRoot);
    if (problem.len > 0) {
      return problem;
    }
    disposable sources: Vec<string> = runtimeSources(runtimeRoot);
    let i: usize = 0;
    while (i < sources.len) {
      vec.vecPush(ref args, vec.vecGet(ref sources, i));
      i += 1;
    }

    // The glue sources a program gets for what it LINKS rather than for
    // touching the runtime at all - `yoop_tls.c` for an OpenSSL program. See
    // runtime_root.yoop. Inside the `needsRuntime` branch because that is
    // where the runtime root is discovered, and because TLS is built on the
    // runtime's I/O: a program that reaches std/tls has already reached it.
    disposable glue: Vec<string> = glueSources(runtimeRoot, ref linkLibraries);
    let g: usize = 0;
    while (g < glue.len) {
      vec.vecPush(ref args, vec.vecGet(ref glue, g));
      g += 1;
    }
  }

  pushPlatformLinkFlags(ref args, yoop_runtime_platform());

  // `-L` and `-I` BEFORE the `-l` names: clang resolves a library against the
  // search path in effect, and a `-l` ahead of its `-L` finds nothing.
  pushSearchPaths(ref args);
  pushRuntimeLibraries(ref args);
  pushLinkLibrariesFor(ref args, ref linkLibraries, yoop_runtime_platform());

  const rc = runProgram(ref args);
  if (rc < 0) {
    return `could not run clang (${errno.message(errno.get())}) - is it installed and on PATH?`;
  }
  if (rc != 0) {
    return `clang failed (exit ${rc}) on ${irPath}`;
  }
  return "";
}

// Link flags that are about the PLATFORM rather than about any library.
//
// Both of these are Windows-only, and both are about what the platform assumes
// rather than about anything a program wrote.
//
// legacy_stdio_definitions. Since the UCRT, `sprintf` and most of its family
// are INLINE functions in <stdio.h> rather than symbols in a library. A C
// program never notices, because it included the header and got the inline
// body. This compiler emits a direct call to `@sprintf` from an
// `extern "C"` declaration, so there is no header and no inline body, and the
// link ends at `LNK2019: unresolved external symbol sprintf`. That library is
// exactly what Microsoft ships to provide the real symbols. It is why
// slice/floats.yoop and a dozen others linked on Linux and macOS and not here.
//
// The stack. A PE image declares the
// stack its main thread gets, and the linker default is 1 MB; ELF and Mach-O
// leave it to the kernel, which gives 8. Every pass in this compiler walks the
// AST by recursion, so on a deeply nested expression a Windows build does not
// report an error - it dies with no output at all, because a stack overflow is
// not something a program gets to print about. That is how it presented: the
// unit suite stopped mid-LINE, part way through codegen.
//
// 8 MB matches what the other two platforms hand out, so the depth a program
// can reach stops depending on which one compiled it. It is RESERVED address
// space, not committed memory - the pages are faulted in on use - so the cost
// of asking for it is address space a 64-bit process has in abundance.
// Platform passed in rather than read, for the reason given on
// `pushRuntimeLibrariesFor`.
export function pushPlatformLinkFlags(ref args: Vec<string>, platform: c_int): void {
  if (platform != PLATFORM_WINDOWS) {
    return;
  }
  vec.vecPush(ref args, "-Wl,/STACK:8388608");
  vec.vecPush(ref args, "-llegacy_stdio_definitions");
}

// The libraries EVERY program links, whatever its source names. Mirrors
// `runtimeLinkFlags` in src/runtimeBuild.js.
//
// `m` is Linux-only, and not as an optimization - it is the only platform where
// libm is a separate library at all. glibc keeps the math functions in libm.so,
// so codegen lowering a float `%` to a `fmod` call links with "undefined
// reference to fmod" without it. macOS and Windows fold the math functions into
// the one C library every link already gets, and Windows has no `m` to name:
// asking for it there is a hard "cannot open input file 'm.lib'".
//
// `pthread` goes on both POSIX platforms for parity with the reference, even
// though a current glibc does not need it (2.34 merged libpthread into libc)
// and macOS never did. It costs nothing on either and is what an older glibc
// wants.
// Takes the platform rather than reading it, so a test can assert all three on
// whichever machine it happens to run on. `collectSearchPaths` is split from
// `pushSearchPaths` in search_paths.yoop for the same reason: a rule that
// varies by platform is exactly the rule a one-platform test cannot cover.
export function pushRuntimeLibrariesFor(ref args: Vec<string>, platform: c_int): void {
  if (platform == PLATFORM_WINDOWS) {
    return;
  }
  vec.vecPush(ref args, "-lpthread");
  if (platform == PLATFORM_LINUX) {
    vec.vecPush(ref args, "-lm");
  }
}

function pushRuntimeLibraries(ref args: Vec<string>): void {
  pushRuntimeLibrariesFor(ref args, yoop_runtime_platform());
}

// `-lm`, `-framework OpenGL`, and the OpenSSL pair.
//
// Three rules, and all three are the reference's (`lowerLinkFlag` in
// src/toolchain.js) so a program links the same way under either compiler:
//
//   * `framework:NAME` is an APPLE linker concept and lowers to
//     `-framework NAME` there. Off Apple it drops, with one exception:
//     `framework:OpenGL` names the platform's OpenGL and every platform has
//     one, so it becomes `-lopengl32` on Windows and `-lGL` on Linux. Deciding
//     that needs a way to ask what is being built for, which is what
//     `yoop_runtime_platform` is.
//   * `ssl` and `crypto` each mean BOTH. libssl is the protocol and libcrypto
//     is everything underneath it, and libssl cannot link without it; making a
//     user name both would be a papercut whose failure mode is a wall of
//     unresolved symbols rather than a message.
//   * everything else is `-lNAME`, as ONE argument. The name was checked at
//     its declaration (typecheck/link_names.yoop), so by the time it is here it
//     is letters, digits and a little punctuation; and even if it were not, an
//     argv element is not a place anything gets interpreted.
//
// Where clang LOOKS for those libraries is search_paths.yoop, which is a
// separate question and a separate file. The corpus needs it:
// `examples/pass/https_client/main.yoop` does not link without it.
// Platform passed in rather than read, for the reason given on
// `pushRuntimeLibrariesFor`: the rules that VARY by platform are exactly the
// rules a one-platform test cannot cover.
export function pushLinkLibrariesFor(ref args: Vec<string>, ref libs: Vec<string>, platform: c_int): void {
  let i: usize = 0;
  while (i < libs.len) {
    const name = vec.vecGet(ref libs, i);
    if (str.stringStartsWith(name, FRAMEWORK_PREFIX)) {
      pushFrameworkFor(ref args, name, platform);
    } else if (platform == PLATFORM_WINDOWS && isImplicitOnWindows(name)) {
      // Dropped rather than translated. See isImplicitOnWindows.
    } else if (str.stringEq(name, "ssl") || str.stringEq(name, "crypto")) {
      vec.vecPush(ref args, "-lssl");
      vec.vecPush(ref args, "-lcrypto");
    } else {
      // One short string per library named, once per compile. Not worth a
      // Text; see writing_yoop.md 3.1 on when the rule applies.
      vec.vecPush(ref args, `-l${name}`);
    }
    i += 1;
  }
}

// The library names that name a REAL library on POSIX and no library at all on
// Windows, where the C runtime already contains both.
//
// `-lm` is the one that matters, and it is not hypothetical: the compiler
// itself writes `extern "C" from library "m"` for the math functions
// (bootstrap/src/comptime/externs.yoop), so on Windows the link line asks the
// MSVC linker for m.lib and gets `LNK1104: cannot open file m.lib`. That is
// the compiler failing to compile ITSELF, with a message naming a file the
// user never wrote.
//
// Mirrors WINDOWS_IMPLICIT_LIBS in src/toolchain.js, the rule the JS reference
// has always had. This is the self-hosted half catching up, and the two lists
// have to stay one list.
function isImplicitOnWindows(name: string): bool {
  return str.stringEq(name, "m") || str.stringEq(name, "pthread");
}

// One `framework:NAME` name, lowered for the platform being built for.
//
// Apple gets the real thing, as TWO arguments: `-framework` and then the name,
// which is how clang's driver wants it. Windows gets `opengl32` for OpenGL and
// nothing for anything else, since every other framework name really is
// Apple's. Linux drops the lot: it has no framework concept, and passing
// `-framework` to a GNU ld is an "unrecognized option" rather than something
// it ignores.
// Platform passed in rather than read, for the reason given on
// `pushRuntimeLibrariesFor`.
export function pushFrameworkFor(ref args: Vec<string>, name: string, platform: c_int): void {
  if (platform == PLATFORM_MACOS) {
    vec.vecPush(ref args, "-framework");
    // The name after the prefix. An owned copy, once per framework per
    // compile; a link line is the wrong place to economize on a malloc.
    vec.vecPush(ref args, str.sliceFrom(name, FRAMEWORK_PREFIX.len));
    return;
  }
  // OpenGL is the one framework name that means something off Apple, because
  // every platform has an OpenGL: opengl32 on Windows, libGL on Linux. Every
  // other framework name really is Apple's and drops.
  if (!str.stringEq(name, "framework:OpenGL")) {
    return;
  }
  if (platform == PLATFORM_WINDOWS) {
    vec.vecPush(ref args, "-lopengl32");
  } else if (platform == PLATFORM_LINUX) {
    vec.vecPush(ref args, "-lGL");
  }
}

// Mirrors FRAMEWORK_PREFIX in typecheck/link_names.yoop, which checks the name
// this lowers.
const FRAMEWORK_PREFIX: string = "framework:";
