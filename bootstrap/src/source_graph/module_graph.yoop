/*
  Layer 0 - module graph / driver.

  Today the bootstrap does NOT resolve imports, so "the graph" is a single
  entry module: read the file, parse it into an AST arena, wrap it in a Module,
  and return a one-module ModuleGraph. If the entry uses imports we refuse with
  a clear message rather than half-building a graph.

  Note on `disposable` ceremony: this file leans on the arena/index pattern to
  keep ownership simple. Every value that survives is MOVED forward into the
  returned graph (src -> Module.src, ast -> Module.ast, module -> modules,
  modules -> ModuleGraph), so there is exactly one owner at the end and nothing
  to auto-clean. That is why no binding here needs the `disposable` keyword and
  no function needs `propagates<disposable>` on its return: only the container
  TYPE decls in contracts.yoop (Module, ModuleGraph, AST) carry that annotation,
  because for a `type` a disposable field requires it - a rule that does NOT
  apply to `variant` decls or to function return types.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import * as fs from "std/fs.yoop";
import * as str from "std/core/strings.yoop";
import { Result } from "std/core/types.yoop";
import { AST, ASTNodeKind, Module, ModuleGraph } from "../contracts.yoop";
import { parse } from "../source_processing/parser.yoop";

export function getModuleId(path: string): string {
  // TODO: hash to a short, stable id for cross-module symbol mangling. Until
  // imports (and therefore multi-module mangling) exist, the path is a unique
  // enough id for the single entry module.
  return path;
}

export variant LoadGraphResult {
  Ok { value: ModuleGraph },
  Err { error: string },
}

variant LoadModuleResult {
  Ok { value: Module },
  Err { error: string },
}

// Count the leading IMPORT_DECLs in a parsed program (the imports-first rule).
// The parser does not emit IMPORT_DECL nodes yet - it rejects `import` at the
// top level - so this returns 0 today. It is the forward-compatible guard: the
// moment imports parse, they get a clear refusal here instead of silently
// vanishing from a graph the driver cannot yet build.
function countLeadingImports(ref ast: AST): usize {
  const program = vec.vec_get(ref ast.nodes, ast.root);
  let count: usize = 0;
  let i: usize = 0;
  while (i < program.childCount) {
    const childId = vec.vec_get(ref ast.childIds, program.childStart + i);
    const child = vec.vec_get(ref ast.nodes, childId);
    if (child.kind != ASTNodeKind.IMPORT_DECL) {
      break; // imports-first: the first non-import ends the run
    }
    count += 1;
    i += 1;
  }
  return count;
}

// Read + parse one source file into a Module. This is the whole graph today.
function loadModule(absPath: string): LoadModuleResult {
  if (!fs.exists(absPath)) {
    return LoadModuleResult.Err { error: `entry file not found: ${absPath}` };
  }

  // Read the source bytes. read_file_into returns "" on success, else an error.
  const srcBuf: Vec<uint8> = vec.vec_new(4096);
  const readErr = fs.read_file_into(ref srcBuf, absPath);
  if (readErr.len > 0) {
    return LoadModuleResult.Err { error: `error reading ${absPath}: ${readErr}` };
  }

  // Parse into an AST arena. parse borrows the byte array for the duration of
  // the call; srcBuf outlives it and is moved into Module.src below (the AST's
  // spans are byte offsets into it, so the module keeps the source around).
  const parseResult = parse(vec.vec_as_array(ref srcBuf));
  let ast: AST;
  switch (parseResult) {
    case Result.Err { error: e }: {
      return LoadModuleResult.Err { error: `parse error in ${absPath}: ${e}` };
    }
    case Result.Ok { value: parsedAst }: {
      ast = parsedAst;
    }
  }

  if (countLeadingImports(ref ast) > 0) {
    return LoadModuleResult.Err {
      error: `module ${absPath} uses imports, which the bootstrap compiler does not support yet`
    };
  }

  const mod: Module = {
    id: getModuleId(absPath),
    absPath: absPath,
    src: srcBuf,
    ast: ast,
    imports: vec.vec_new(0),
  };
  return LoadModuleResult.Ok { value: mod };
}

// Layer 0 producer. Loads the entry file into a one-module graph.
export function loadModuleGraph(entryPath: string): LoadGraphResult {
  let entryModule: Module;
  switch (loadModule(entryPath)) {
    case LoadModuleResult.Err { error: e }: {
      return LoadGraphResult.Err { error: e };
    }
    case LoadModuleResult.Ok { value: m }: {
      entryModule = m;
    }
  }

  const modules: Vec<Module> = vec.vec_new(1);
  vec.vec_push(ref modules, entryModule);

  // No std autoloads wired yet; an empty map keeps the ModuleGraph shape whole.
  const autoLoads: Map<string, string> = map.map_new(0, map.string_key_ops());

  const graph: ModuleGraph = {
    modules: modules,
    entryIndex: 0,
    autoLoadModuleIds: autoLoads,
  };
  return LoadGraphResult.Ok { value: graph };
}

// --- Import-path resolution (dormant until imports land) -------------------
// Kept because it is standalone path logic, not a layer-interfacing assumption:
// it maps an import source path (std/..., ./..., ../..., or absolute) to a
// canonical, existing file path. loadModule will call this per import edge once
// the parser emits IMPORT_DECLs and the graph goes multi-module.
export function resolveImportPath(
  importerAbsPath: string,
  sourcePath: string,
  stdRoot: string
): Result<string, string> {
  if (!fs.hasYoopFileNameSuffix(sourcePath)) {
    return Result.Err { error: `import path "${sourcePath}" must end in .yoop` };
  }

  const isStd = str.string_starts_with(sourcePath, "std/");
  let joinedPath: string;
  if (isStd) {
    const rest = str.sliceFrom(sourcePath, 4); // drop "std/", root at stdRoot
    joinedPath = fs.path_join([stdRoot, rest]);
  } else {
    const isRel = str.string_starts_with(sourcePath, "./")
      || str.string_starts_with(sourcePath, "../");
    const isAbs = str.string_starts_with(sourcePath, "/");
    if (!isRel && !isAbs) {
      return Result.Err {
        error: `import path "${sourcePath}" must be relative (./...), absolute, or start with std/`
      };
    }
    if (isAbs) {
      joinedPath = sourcePath;
    } else {
      const baseDir = fs.dirName(importerAbsPath);
      joinedPath = fs.path_join([baseDir, sourcePath]);
    }
  }

  const canonicalPath = fs.normalizePath(joinedPath);
  if (canonicalPath.len == 0) {
    return Result.Err { error: `unable to identify a canonical path from ${joinedPath}` };
  }
  if (!fs.exists(canonicalPath)) {
    return Result.Err { error: `cannot resolve import ${sourcePath} from ${importerAbsPath}: file not found` };
  }

  return Result.Ok { value: canonicalPath };
}
