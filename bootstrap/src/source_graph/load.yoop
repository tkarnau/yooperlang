module source_graph;

/*
  Reading the entry file into a graph.

  Today the bootstrap does NOT resolve imports, so "the graph" is a single entry
  module: read the file, parse it into an AST arena, wrap it in a Module, and
  return a one-module ModuleGraph. If the entry uses imports we refuse with a
  clear message rather than half-building a graph.

  Note on `disposable` ceremony: this file leans on the arena/index pattern to
  keep ownership simple. Every value that survives is MOVED forward into the
  returned graph (src -> Module.src, ast -> Module.ast, module -> modules,
  modules -> ModuleGraph), so there is exactly one owner at the end and nothing
  to auto-clean. That is why no binding here needs the `disposable` keyword and
  no function needs `propagates<disposable>` on its return: only the container
  TYPE decls in graph.yoop (Module, ModuleGraph) and AST carry that annotation,
  because for a `type` a disposable field requires it - a rule that does NOT
  apply to `variant` decls or to function return types.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import * as fs from "std/fs.yoop";
import { Result } from "std/core/types.yoop";
import { AST, ASTNodeKind } from "../ast";
import { parse } from "../parse";

export function getModuleId(path: string): string {
  // TODO: hash to a short, stable id for cross-module symbol mangling. Until
  // imports (and therefore multi-module mangling) exist, the path is a unique
  // enough id for the single entry module.
  return path;
}

export variant LoadGraphResult {
  Ok { value: ModuleGraph },
  Err { error: string },
}

export variant LoadModuleResult {
  Ok { value: Module },
  Err { error: string },
}

// Count the leading IMPORT_DECLs in a parsed program (the imports-first rule).
// The parser does not emit IMPORT_DECL nodes yet - it rejects `import` at the
// top level - so this returns 0 today. It is the forward-compatible guard: the
// moment imports parse, they get a clear refusal here instead of silently
// vanishing from a graph the driver cannot yet build.
function countLeadingImports(ref ast: AST): usize {
  const program = vec.vecGet(ref ast.nodes, ast.root);
  let count: usize = 0;
  let i: usize = 0;
  while (i < program.childCount) {
    const childId = vec.vecGet(ref ast.childIds, program.childStart + i);
    const child = vec.vecGet(ref ast.nodes, childId);
    if (child.kind != ASTNodeKind.IMPORT_DECL) {
      break; // imports-first: the first non-import ends the run
    }
    count += 1;
    i += 1;
  }
  return count;
}

// Parse already-read source bytes into a Module.
//
// Split out from loadModule so a caller that already has the bytes (a test, and
// eventually the LSP) does not have to go through the filesystem. `srcBuf` is
// MOVED into the returned Module: the AST's spans are byte offsets into exactly
// those bytes, so the module has to keep them.
export function moduleFromSource(id: string, absPath: string, srcBuf: Vec<uint8>): LoadModuleResult {
  // parse borrows the byte array for the duration of the call only.
  const parseResult = parse(vec.vecAsArray(ref srcBuf));
  let ast: AST;
  switch (parseResult) {
    case Result.Err { error: e }: {
      return LoadModuleResult.Err { error: `parse error in ${absPath}: ${e}` };
    }
    case Result.Ok { value: parsedAst }: {
      ast = parsedAst;
    }
  }

  if (countLeadingImports(ref ast) > 0) {
    return LoadModuleResult.Err {
      error: `module ${absPath} uses imports, which the bootstrap compiler does not support yet`
    };
  }

  const mod: Module = {
    id: id,
    absPath: absPath,
    src: srcBuf,
    ast: ast,
    imports: vec.vecNew(0),
  };
  return LoadModuleResult.Ok { value: mod };
}

// Read + parse one source file into a Module. This is the whole graph today.
function loadModule(absPath: string): LoadModuleResult {
  if (!fs.exists(absPath)) {
    return LoadModuleResult.Err { error: `entry file not found: ${absPath}` };
  }

  // Read the source bytes. readFileInto returns "" on success, else an error.
  const srcBuf: Vec<uint8> = vec.vecNew(4096);
  const readErr = fs.readFileInto(ref srcBuf, absPath);
  if (readErr.len > 0) {
    return LoadModuleResult.Err { error: `error reading ${absPath}: ${readErr}` };
  }

  return moduleFromSource(getModuleId(absPath), absPath, srcBuf);
}

// Wrap one module as the entry of a one-module graph. Separate from
// loadModuleGraph so an in-memory module can become a graph too.
export function singleModuleGraph(entryModule: Module): ModuleGraph {
  const modules: Vec<Module> = vec.vecNew(1);
  vec.vecPush(ref modules, entryModule);

  // No std autoloads wired yet; an empty map keeps the ModuleGraph shape whole.
  const autoLoads: Map<string, string> = map.mapNew(0, map.stringKeyOps());

  return {
    modules: modules,
    entryIndex: 0,
    autoLoadModuleIds: autoLoads,
  };
}

// Layer 0 producer. Loads the entry file into a one-module graph.
export function loadModuleGraph(entryPath: string): LoadGraphResult {
  switch (loadModule(entryPath)) {
    case LoadModuleResult.Err { error: e }: {
      return LoadGraphResult.Err { error: e };
    }
    case LoadModuleResult.Ok { value: m }: {
      return LoadGraphResult.Ok { value: singleModuleGraph(m) };
    }
  }
}
