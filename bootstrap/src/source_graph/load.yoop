module source_graph;

/*
  Reading source files into a Module.

  Following imports and ordering the result is walk.yoop's job; this file stops
  at the module boundary. Two shapes come out of it:

    a SINGLE-FILE module - `./util.yoop`, no header, one file
    a DIRECTORY module   - every `.yoop` in a directory, each declaring the same
                           `module <name>;`, sharing one namespace and one arena

  Note on `disposable` ceremony: this file leans on the arena/index pattern to
  keep ownership simple. Every value that survives is MOVED forward into the
  returned Module (bytes -> SourceFile.src, arena -> Module.ast), so there is
  exactly one owner at the end and nothing to auto-clean. That is why no binding
  here needs the `disposable` keyword and no function needs
  `propagates<disposable>` on its return: only the container TYPE decls in
  graph.yoop (SourceFile, Module, ModuleGraph) and AST carry that annotation,
  because for a `type` a disposable field requires it - a rule that does NOT
  apply to `variant` decls or to function return types.
*/

import { Vec }, * as vec from "std/core/vec.yoop";
import { Map }, * as map from "std/collections/map.yoop";
import * as fs from "std/fs.yoop";
import * as str from "std/core/strings.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { disposable } from "std/core/kinds.yoop";
import { Result } from "std/core/types.yoop";
import { AST, emptyArena } from "../ast";
import { ParsedFile, moduleHeaderName, parseInto } from "../parse";

export variant LoadGraphResult {
  Ok { value: ModuleGraph },
  Err { error: string },
}

export variant LoadModuleResult {
  Ok { value: Module },
  Err { error: string },
}

// Read one file's bytes. "" in the error slot means success.
type ReadResult = Result<Vec<uint8>, string>;

function readSource(absPath: string): ReadResult propagates<disposable> {
  if (!fs.exists(absPath)) {
    return Result.Err { error: `source file not found: ${absPath}` };
  }
  // readFileInto returns "" on success, else an error.
  let buf: Vec<uint8> = vec.vecNew(4096);
  const readErr = fs.readFileInto(ref buf, absPath);
  if (readErr.len > 0) {
    return Result.Err { error: `error reading ${absPath}: ${readErr}` };
  }
  return Result.Ok { value: buf };
}

// Parse already-read bytes into a module of one file.
//
// `srcBuf` is MOVED into the returned Module: the AST's spans are byte offsets
// into exactly those bytes, so the module has to keep them.
//
// The `id` is the mangling basis and is NOT derived here, because it depends on
// the module's position in the graph, which is not known until everything it
// imports has loaded. walk.yoop stamps it (see moduleIdFor); a caller building
// a standalone module supplies its own.
export function moduleFromSource(id: string, absPath: string, srcBuf: Vec<uint8>): LoadModuleResult {
  let mod: Module = {
    id: id,
    dir: "",
    name: "",
    ast: emptyArena(),
    files: vec.vecNew(1),
  };
  const err = addFile(ref mod, absPath, srcBuf);
  if (err.len > 0) {
    return LoadModuleResult.Err { error: err };
  }
  return LoadModuleResult.Ok { value: mod };
}

// Parse one file into the module's arena and record it. Returns "" on success.
//
// The arena is MOVED through `parseInto` and back - the parser owns it for the
// duration of the call - which is what lets several files accumulate into one.
function addFile(ref mod: Module, absPath: string, srcBuf: Vec<uint8>): string {
  // parse borrows the byte array for the duration of the call only.
  const parsed = parseInto(mod.ast, vec.vecAsArray(ref srcBuf));
  switch (parsed) {
    case Result.Err { error: e }: {
      return `parse error in ${absPath}: ${e}`;
    }
    case Result.Ok { value: file }: {
      mod.ast = file.ast;
      vec.vecPush(ref mod.files, {
        absPath: absPath,
        src: srcBuf,
        root: file.root,
        imports: vec.vecNew(0),
      });
      return "";
    }
  }
}

// Read + parse the module that OWNS `absPath`: the file alone when it has no
// `module <name>;` header, otherwise every file of its directory.
//
// `blamePath` is whatever made us look here - the importing file, or the entry
// path - and appears only in diagnostics.
//
// `isEntry` decides what happens when the path names ONE FILE of a directory
// module. As an entry that is fine and means "compile the module this file
// belongs to". As an IMPORT it is refused, because the module is the unit and
// naming a file of it suggests you get only that file.
function loadOwningModule(absPath: string, blamePath: string, isEntry: bool): LoadModuleResult {
  if (fs.statPath(absPath).isDir) {
    return loadDirectoryModule(absPath, blamePath);
  }

  let srcBuf: Vec<uint8>;
  switch (readSource(absPath)) {
    case Result.Err { error: e }: { return LoadModuleResult.Err { error: e }; }
    case Result.Ok { value: buf }: { srcBuf = buf; }
  }

  const declaredName = moduleHeaderName(vec.vecAsArray(ref srcBuf));
  if (declaredName.len == 0) {
    return moduleFromSource("", absPath, srcBuf);
  }
  if (!isEntry) {
    return LoadModuleResult.Err {
      error: `import of "${absPath}" from ${blamePath} names one source file of module "${declaredName}" - import the module itself instead (drop the file name and the .yoop extension)`
    };
  }
  return loadDirectoryModule(fs.dirName(absPath), blamePath);
}

// Every `.yoop` file directly in `dir`, as one module.
//
// The declared name comes from the first file and every other must agree.
// Identity is the DIRECTORY, so a disagreement cannot quietly split one
// directory into two modules - it is simply an error.
function loadDirectoryModule(dir: string, blamePath: string): LoadModuleResult {
  disposable names: Vec<string> = listModuleSourceFiles(dir);
  if (names.len == 0) {
    return LoadModuleResult.Err {
      error: `import of directory "${dir}" from ${blamePath}: the directory holds no .yoop source files`
    };
  }

  let mod: Module = {
    id: "",
    dir: dir,
    name: "",
    ast: emptyArena(),
    files: vec.vecNew(names.len),
  };

  let i: usize = 0;
  while (i < names.len) {
    const absPath = fs.pathJoin([dir, vec.vecGet(ref names, i)]);
    let srcBuf: Vec<uint8>;
    switch (readSource(absPath)) {
      case Result.Err { error: e }: { return LoadModuleResult.Err { error: e }; }
      case Result.Ok { value: buf }: { srcBuf = buf; }
    }

    // A MIXED directory is an error. Half a module is not a state worth
    // supporting, and this is what catches a file dropped in later by someone
    // who did not notice the directory had opted in.
    const declaredName = moduleHeaderName(vec.vecAsArray(ref srcBuf));
    if (declaredName.len == 0) {
      return LoadModuleResult.Err {
        error: `${absPath} is in module directory "${dir}" but has no \`module <name>;\` header - every .yoop file in a module directory must declare it (*.test.yoop is exempt)`
      };
    }
    if (mod.name.len == 0) {
      mod.name = declaredName;
    } else if (!str.stringEq(declaredName, mod.name)) {
      return LoadModuleResult.Err {
        error: `${absPath} declares \`module ${declaredName};\` but "${dir}" is module "${mod.name}" - every .yoop file in a directory must declare the same name`
      };
    }

    const err = addFile(ref mod, absPath, srcBuf);
    if (err.len > 0) {
      return LoadModuleResult.Err { error: err };
    }
    i += 1;
  }

  return LoadModuleResult.Ok { value: mod };
}

// The source file NAMES a directory module is made of: every `.yoop` directly
// in the directory, sorted so the module's contents do not depend on the order
// the filesystem hands them back, minus test files.
//
// `*.test.yoop` is excluded because a test module is its own thing (`import
// .test;`, no main) and must not be absorbed into the module it tests - that
// exclusion is what lets a test reach its module through the same import path a
// consumer writes.
function listModuleSourceFiles(dir: string): Vec<string> propagates<disposable> {
  let names: Vec<string> = vec.vecNew(8);
  disposable entries: fs.DirIter = fs.openDir(dir);
  for name in entries {
    if (fs.hasYoopFileNameSuffix(name) && !isTestFileName(name)) {
      vec.vecPush(ref names, name);
    }
  }
  sortNames(ref names);
  return names;
}

// Insertion sort, because a module directory holds a handful of files and
// `utils.quickSort` wants a `Comparable<T>` that `string` does not implement.
// Determinism is the whole requirement here, not speed.
function sortNames(ref names: Vec<string>): void {
  let i: usize = 1;
  while (i < names.len) {
    const item = vec.vecGet(ref names, i);
    let j = i;
    while (j > 0 && nameLess(item, vec.vecGet(ref names, j - 1))) {
      vec.vecSet(ref names, j, vec.vecGet(ref names, j - 1));
      j -= 1;
    }
    vec.vecSet(ref names, j, item);
    i += 1;
  }
}

// Byte-wise `a < b`, the plain lexicographic order.
function nameLess(a: string, b: string): bool {
  const ab = intr.stringAsBytes(a);
  const bb = intr.stringAsBytes(b);
  let i: usize = 0;
  while (i < ab.len && i < bb.len) {
    if (ab[i] != bb[i]) {
      return ab[i] < bb[i];
    }
    i += 1;
  }
  return ab.len < bb.len;
}

function isTestFileName(name: string): bool {
  const suffix = ".test.yoop";
  if (name.len < suffix.len) {
    return false;
  }
  switch (str.stringSlice(name, name.len - suffix.len, name.len)) {
    case Result.Ok { value: tail }: { return str.stringEq(tail, suffix); }
    case Result.Err { error: e }: { return false; }
  }
}

// Wrap one module as the entry of a one-module graph. Separate from the graph
// walk so an in-memory module (a test, the LSP) can become a graph too, without
// its imports being followed.
export function singleModuleGraph(entryModule: Module): ModuleGraph {
  const modules: Vec<Module> = vec.vecNew(1);
  vec.vecPush(ref modules, entryModule);

  // No std autoloads wired yet; an empty map keeps the ModuleGraph shape whole.
  const autoLoads: Map<string, string> = map.mapNew(0, map.stringKeyOps());

  return {
    modules: modules,
    entryIndex: 0,
    autoLoadModuleIds: autoLoads,
  };
}
