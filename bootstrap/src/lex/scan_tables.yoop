module lex;

// The two tables the scanner walks: punctuation/operators, and reserved words.
//
// They are separate because they are matched differently. The punctuation table
// is matched by PREFIX against raw bytes, so it must be ordered longest-first or
// `...` would scan as three `.`s. The keyword table is matched against a whole
// word that `scanIdentity` already delimited, so order there is irrelevant.
//
// Both are BUILT AT RUNTIME into a `LexTables` the caller owns, rather than
// declared as module-level arrays. Two reasons, and the second is the one that
// decides the shape:
//
//   * neither table can BE a module-level array here. An array of STRUCTS has
//     no static spelling the bootstrap can inline, so a plain
//     `const KEYWORD_LIST: KeywordDefinition[] = [ ... ]` is refused; and the
//     punctuation table additionally went through a CALL
//     (`sortedDefs([ ... ])`), which the JS reference FOLDS with its comptime
//     interpreter. Comptime is deliberately out of scope for the bootstrap, and
//     these two declarations between them gate every file whose import closure
//     runs through `lex` - which is the whole compiler's own.
//   * the longest-first ORDER is a correctness requirement rather than a
//     formatting preference, and `quickSort` is what enforces it. Hand-sorting
//     the literal would trade a check for a comment, and the comment already
//     says what breaks.
//
// So the order is established at RUNTIME, once per `LexTables`, by a sort the
// reference runs at compile time. This is REVERSIBLE: a self-hosted comptime
// interpreter would let `lexTablesNew` become a module const with no change to
// anything that reads it.

import { Vec }, * as vec from "std/core/vec.yoop";
import { Disposable, disposable } from "std/core/kinds.yoop";
import { Comparable, quickSort } from "../utils";

export type SortedTokenDefinition implements Comparable<SortedTokenDefinition> {
  str: string, // the value in source code that points to a tag
  tag: TokenTags,
  function compare(ref self, b: SortedTokenDefinition): int8 {
    if (self.str.len < b.str.len) {
      return 1;
    } else if (self.str.len > b.str.len) {
      return -1;
    } else {
      return 0;
    }
  }
}

// A reserved word that `lexIdentifierOrKeyword` promotes from IDENT to its
// dedicated tag on an exact match. Unlike the punctuation table, order does not
// matter here: `scanIdentity` already gave us a whole-word boundary, so we
// only ever compare complete tokens (no prefix ambiguity to length-sort away).
export type KeywordDefinition {
  str: string, // the exact lowercase source spelling
  tag: TokenTags,
}

// Both tables, built once. Every entry point into the lexer takes one by `ref`
// rather than reaching for a global, because there is no global to reach for -
// see the header comment.
export type LexTables implements Disposable propagates<disposable> {
  scan: Vec<SortedTokenDefinition>,     // sorted longest spelling first
  keywords: Vec<KeywordDefinition>,     // in declaration order; order is free
  function dispose(ref self): void {
    self.scan.dispose();
    self.keywords.dispose();
  }
}

// Build both tables and put the punctuation one in scanning order.
//
// Cheap enough to do per FILE and that is how it is used: `parseInto`,
// `moduleHeaderName`, `tokenize` and `dumpTokens` each own one for the length
// of their walk. It is 41 + 40 vector pushes and one 41-element quicksort, so
// well under a microsecond next to reading the file it is about to lex.
export function lexTablesNew(): LexTables propagates<disposable> {
  let scan: Vec<SortedTokenDefinition> = vec.vecNew(48);
  fillTokenScanList(ref scan);
  // `vecAsArray` is a VIEW over the vector's own storage, so this sorts the
  // vector in place. Nothing pushes afterwards, which is the rule that view
  // comes with.
  quickSort(scan.asArray(), 0, scan.len - 1);

  let keywords: Vec<KeywordDefinition> = vec.vecNew(48);
  fillKeywordList(ref keywords);
  return { scan: scan, keywords: keywords };
}

// The punctuation and operator table, in whatever order reads best here.
// `lexTablesNew` is what puts it in scanning order, so a new entry goes
// wherever its neighbours are rather than wherever its length says.
function fillTokenScanList(ref out: Vec<SortedTokenDefinition>): void {
  out.push({ str: "(", tag: TokenTags.LPAREN });
  out.push({ str: ")", tag: TokenTags.RPAREN });
  out.push({ str: ";", tag: TokenTags.SEMICOLON });
  out.push({ str: "=", tag: TokenTags.EQ });
  out.push({ str: "{", tag: TokenTags.LCURLY });
  out.push({ str: "}", tag: TokenTags.RCURLY });
  out.push({ str: ":", tag: TokenTags.COLON });
  out.push({ str: ",", tag: TokenTags.COMMA });
  out.push({ str: "?", tag: TokenTags.QUESTION });
  out.push({ str: "==", tag: TokenTags.EQEQ });
  out.push({ str: "!=", tag: TokenTags.NEQ });
  out.push({ str: "!", tag: TokenTags.BANG });
  out.push({ str: "^", tag: TokenTags.CARET });
  out.push({ str: "~", tag: TokenTags.TILDE });
  out.push({ str: "<=", tag: TokenTags.LTE });
  out.push({ str: ">=", tag: TokenTags.GTE });
  out.push({ str: "<", tag: TokenTags.LT });
  out.push({ str: ">", tag: TokenTags.GT });
  out.push({ str: "&&", tag: TokenTags.ANDAND });
  out.push({ str: "&", tag: TokenTags.AMP });
  out.push({ str: "||", tag: TokenTags.OROR });
  out.push({ str: "|", tag: TokenTags.PIPE });
  out.push({ str: "<<", tag: TokenTags.LSHIFT });
  out.push({ str: ">>", tag: TokenTags.RSHIFT });
  out.push({ str: "+", tag: TokenTags.PLUS });
  out.push({ str: "-", tag: TokenTags.MINUS });
  out.push({ str: "*", tag: TokenTags.MULT });
  out.push({ str: "/", tag: TokenTags.DIVIDE });
  out.push({ str: "%", tag: TokenTags.MODULUS });
  // Compound-assignment two-char operators.
  out.push({ str: "+=", tag: TokenTags.PLUSEQ });
  out.push({ str: "-=", tag: TokenTags.MINUSEQ });
  out.push({ str: "*=", tag: TokenTags.MULTEQ });
  out.push({ str: "/=", tag: TokenTags.DIVIDEEQ });
  out.push({ str: "%=", tag: TokenTags.MODULUSEQ });
  // Function value type separator. The sort puts this before `=`
  // and before `>=` / `>`; the lexer's existing logic handles the
  // disambiguation against `==`.
  out.push({ str: "=>", tag: TokenTags.FATARROW });
  out.push({ str: ".", tag: TokenTags.DOT });
  out.push({ str: "..", tag: TokenTags.DOTDOT });
  out.push({ str: "...", tag: TokenTags.DOTDOTDOT });
  out.push({ str: "[", tag: TokenTags.LBRACKET });
  out.push({ str: "]", tag: TokenTags.RBRACKET });
  // Attribute prefix `@`.
  out.push({ str: "@", tag: TokenTags.AT });
}

// Mirrors the JS lexer's `keywordTagList` exactly - src/parity.test.js fails if
// the two drift. Two things that surprise people:
//   * Most kind vocabulary is NOT here: `contains`, `kind`, `requires`,
//     `propagates`, `task`, `pooled`, `io`, `field`, `layout` and friends lex
//     as plain IDENT and the parser recognizes them CONTEXTUALLY, which is what
//     keeps them usable as ordinary names. Use `peekIsWord` to match one.
//   * `_` lexes to DISCARD - bare underscores are discarded.
function fillKeywordList(ref out: Vec<KeywordDefinition>): void {
  out.push({ str: "let",            tag: TokenTags.LET });
  out.push({ str: "function",       tag: TokenTags.FUNCTION });
  out.push({ str: "const",          tag: TokenTags.CONST });
  out.push({ str: "return",         tag: TokenTags.RETURN });
  out.push({ str: "if",             tag: TokenTags.IF });
  out.push({ str: "else",           tag: TokenTags.ELSE });
  out.push({ str: "while",          tag: TokenTags.WHILE });
  out.push({ str: "for",            tag: TokenTags.FOR });
  out.push({ str: "in",             tag: TokenTags.IN });
  out.push({ str: "type",           tag: TokenTags.TYPE });
  out.push({ str: "import",         tag: TokenTags.IMPORT });
  out.push({ str: "export",         tag: TokenTags.EXPORT });
  out.push({ str: "extern",         tag: TokenTags.EXTERN });
  out.push({ str: "from",           tag: TokenTags.FROM });
  out.push({ str: "as",             tag: TokenTags.AS });
  out.push({ str: "ref",            tag: TokenTags.REF });
  out.push({ str: "break",          tag: TokenTags.BREAK });
  out.push({ str: "continue",       tag: TokenTags.CONTINUE });
  out.push({ str: "true",           tag: TokenTags.TRUE });
  out.push({ str: "false",          tag: TokenTags.FALSE });
  out.push({ str: "trait",          tag: TokenTags.TRAIT });
  out.push({ str: "implements",     tag: TokenTags.IMPLEMENTS });
  out.push({ str: "self",           tag: TokenTags.SELF });
  out.push({ str: "extends",        tag: TokenTags.EXTENDS });
  out.push({ str: "vtable",         tag: TokenTags.VTABLE });
  out.push({ str: "appliesTo",      tag: TokenTags.APPLIESTO });
  out.push({ str: "mustCall",       tag: TokenTags.MUSTCALL });
  out.push({ str: "ownsBlock",      tag: TokenTags.OWNSBLOCK });
  out.push({ str: "beforeScopeEnd", tag: TokenTags.BEFORESCOPEEND });
  out.push({ str: "mustNotEscape",  tag: TokenTags.MUSTNOTESCAPE });
  out.push({ str: "wait",           tag: TokenTags.WAIT });
  out.push({ str: "switch",         tag: TokenTags.SWITCH });
  out.push({ str: "case",           tag: TokenTags.CASE });
  out.push({ str: "default",        tag: TokenTags.DEFAULT });
  out.push({ str: "enum",           tag: TokenTags.ENUM });
  out.push({ str: "variant",        tag: TokenTags.VARIANT });
  out.push({ str: "union",          tag: TokenTags.UNION });
  out.push({ str: "null",           tag: TokenTags.NULL });
  out.push({ str: "await",          tag: TokenTags.AWAIT });
  out.push({ str: "_",              tag: TokenTags.DISCARD });
}

// The SOURCE spelling of a tag, for diagnostics: `+` rather than `PLUS`.
//
// Scans the same two tables the lexer matches against, so there is no third
// list to keep in sync. Falls back to the enum name for tags with no spelling
// of their own (IDENT, INTLITERAL, EOF).
//
// Builds its own tables rather than taking a `ref LexTables`: every caller is a
// DIAGNOSTIC in typecheck, three layers above the lexer, and threading a lexer
// table through them to format an error message would be worse than the two
// vectors this allocates on a compile that is already failing. The strings it
// hands back are literals, so they outlive the tables.
export function tagSpelling(tag: TokenTags): string {
  disposable tables: LexTables = lexTablesNew();
  for d in tables.scan.asArray() {
    if (d.tag == tag) {
      return d.str;
    }
  }
  for k in tables.keywords.asArray() {
    if (k.tag == tag) {
      return k.str;
    }
  }
  return tagName(tag);
}
