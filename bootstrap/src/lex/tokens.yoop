  "DOTDOTDOT",
  "REF",
  "BREAK",
  "CONTINUE",
  "LBRACKET",
  "RBRACKET",
  "TRUE",
  "FALSE",
  "TRAIT",
  "IMPLEMENTS",
  "SELF",
  "EXTENDS",
  "VTABLE",
  "KIND",
  "APPLIESTO",
  "REQUIRES",
  "MUSTCALL",
  "OWNSBLOCK",
  "BEFORESCOPEEND",
  "BINDING",
  "MUSTNOTESCAPE",
  "MUSTNOTSHARE",
  "FORBIDS",
  "SCOPE",
  "ACROSSSCOPES",
  "PARAMETER",
  "FIELD",
  "IO",
  "GLOBALSTATE",
  "TASK",
  "WAIT",
  "JOINED",
  "POOLED",
  "PROPAGATES",
  "CONTAINS",
  "LAYOUT",
  "ALIGN",
  "AMP",
  "SWITCH",
  "CASE",
  "DEFAULT",
  "ENUM",
  "VARIANT",
  "UNION",
  "NULL",
  "EQ",
  "SEMICOLON",
  "LPAREN",
  "RPAREN",
  "DISCARD",
  "LCURLY",
  "RCURLY",
  "COLON",
  "COMMA",
  "EQEQ",
  "NEQ",
  "LTE",
  "GTE",
  "LT",
  "GT",
  "ANDAND",
  "OROR",
  "PIPE",
  "LSHIFT",
  "RSHIFT",
  "PLUS",
  "MINUS",
  "MULT",
  "DIVIDE",
  "MODULUS",
  "DOT",
  "QUESTION",
  "DOTDOT",
  "BANG",
  "CARET",
  "TILDE",
  "PLUSEQ",
  "MINUSEQ",
  "MULTEQ",
  "DIVIDEEQ",
  "MODULUSEQ",
  "FATARROW",
  "AT",
  "AWAIT",
];

// Maps a TokenTags case to its source spelling. Used by Display sites
// (error messages, token dumps); the int-backed enum decays to its ordinal
// for the array index. Order MUST mirror the TokenTags decl above.
export function tagName(v: TokenTags): string {
  return TOKEN_TAG_NAMES[v];
}
