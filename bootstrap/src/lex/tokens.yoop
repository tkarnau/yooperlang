module lex;

// The token vocabulary: every tag the lexer can produce, its source spelling,
// and its binding power as a binary operator.
//
// TokenTags must stay in lockstep with the JS reference's tag list
// (src/jsyooplexer/lexer.js) - that lockstep is a CONTRACT, because a token
// dump from either implementation has to diff against the other.

export enum TokenTags {
  NOTOKEN, // for initializers, etc
  // atoms
  EOF,
  IDENT, // NOT A KEYWORD
  INTLITERAL,
  STRLITERAL, // INCLUDED WRAPPING QUOTE CHARACTERS
  CHARLITERAL,
  TEMPLATELITERAL, // BACKTICK-QUOTED, MAY CONTAIN ${...} INTERPOLATIONS
  FLOATLITERAL,

  // KEYWORDS
  LET,
  FUNCTION,
  CONST,
  RETURN,
  IF,
  ELSE,
  WHILE,
  FOR,
  // `FOR ITEM IN XS { ... }` ITERATION FORM.
  IN,
  TYPE,
  IMPORT,
  EXPORT,
  EXTERN,
  FROM,
  AS,
  LIBRARY,
  DOTDOTDOT, // FOR VARIADIC PARAMS AND REST PATTERNS
  REF,
  BREAK,
  CONTINUE,
  LBRACKET, // [
  RBRACKET, // ]
  TRUE,
  FALSE,
  TRAIT,
  IMPLEMENTS,
  SELF,
  EXTENDS,
  // `VTABLE NAME FOR TRAITNAME { ... }` - DECLARES THE
  // TYPE-ERASED SHAPE OF A TRAIT. PAIRS WITH THE `=>` TOKEN (`FATARROW`)
  // FOR FIELD TYPE ANNOTATIONS.
  VTABLE,
  KIND,
  // KIND STUFF
  APPLIESTO,
  REQUIRES,
  MUSTCALL,
  OWNSBLOCK,
  BEFORESCOPEEND,
  BINDING,
  // ESCAPE AND SHARING
  MUSTNOTESCAPE,
  MUSTNOTSHARE,
  FORBIDS,
  SCOPE,
  ACROSSSCOPES,
  PARAMETER,
  FIELD,
  IO,
  GLOBALSTATE,
  // TASK / CONCURRENCY
  TASK,
  WAIT,
  JOINED,
  POOLED,
  // CONTAINMENT / PROPAGATION
  PROPAGATES,
  CONTAINS,
  // LAYOUT / COMPOSITION
  LAYOUT,
  ALIGN,
  AMP, // STANDALONE & (COMPOSITION OPERATOR), DISTINCT FROM &&
  // SWITCH / PATTERNS / SUM TYPES / UNIONS
  SWITCH,
  CASE,
  DEFAULT,
  ENUM,
  VARIANT,
  UNION,
  // UNSAFE POINTERS
  NULL,

  // PUNCTUATION / OPERATORS
  EQ,
  SEMICOLON,
  LPAREN,
  RPAREN,
  DISCARD,
  LCURLY,
  RCURLY,
  COLON,
  COMMA,
  EQEQ,
  NEQ,
  LTE,
  GTE,
  LT,
  GT,
  ANDAND,
  OROR,
  PIPE,
  LSHIFT,
  RSHIFT,
  PLUS,
  MINUS,
  MULT,
  DIVIDE,
  MODULUS,
  DOT,
  QUESTION,
  // ARRAY SLICE SYNTAX - `XS[I..J]`, `XS[..J]`, `XS[I..]`, `XS[..]`.
  DOTDOT,
  // LOGICAL NOT PREFIX - `!FLAG`. LEXER'S LONGEST-FIRST SORT KEEPS
  // `!=` (`NEQ`) WINNING OVER `!` FOR THE BINARY CASE.
  BANG,
  // BITWISE XOR (`^`) BINARY, BITWISE NOT (`~`) PREFIX.
  CARET,
  TILDE,
  // COMPOUND ASSIGNMENTS - `X += Y` SHORTHAND FOR `X = X + Y`,
  // IMPLEMENTED AS DEDICATED AST NODES SO THE LVALUE IS ADDRESSED ONCE.
  PLUSEQ,
  MINUSEQ,
  MULTEQ,
  DIVIDEEQ,
  MODULUSEQ,
  // `=>` SEPARATOR FOR FUNCTION VALUE TYPES IN TYPE POSITION.
  // ONLY LEGAL IN TYPE ANNOTATIONS (STRUCT FIELDS, PARAMETER / RETURN TYPES,
  // VTABLE FIELDS). EXPRESSION-POSITION `=>` IS A PARSE ERROR.
  FATARROW,
  // `@` PREFIX INTRODUCING A COMPILE-TIME / STATIC-ANALYSIS
  // ATTRIBUTE (E.G. `@PRECOMPILE`, `@TEST`, `@VERIFY`). ALWAYS A
  // COMPILE-TIME DIRECTIVE - NEVER QUERYABLE FROM RUNTIME CODE.
  AT,
  // `await <expr>`. Async coloring: only legal inside an async function or a
  // task body.
  AWAIT,
}

export function getTokenPrecedence(tag: TokenTags): int {
  switch(tag) {
    case TokenTags.EQ: { return 10; }
    // `a..b` builds a RANGE value rather than computing anything, and it binds
    // looser than every arithmetic operator so `0..n + 1` is `0..(n + 1)`.
    // Same number the reference uses, and the same reason a slice's bounds are
    // parsed AT this precedence: that is what stops `xs[a..b]`'s first bound
    // from swallowing the `..`.
    case TokenTags.DOTDOT: { return 15; }
    case TokenTags.OROR: { return 20; }
    case TokenTags.ANDAND: { return 30; }
    case TokenTags.PIPE: { return 35; }
    case TokenTags.CARET: { return 36; }
    case TokenTags.AMP: { return 37; }
    case TokenTags.EQEQ,
         TokenTags.NEQ,
         TokenTags.LT,
         TokenTags.GT,
         TokenTags.LTE,
         TokenTags.GTE: { return 40; }
    case TokenTags.LSHIFT,
         TokenTags.RSHIFT: { return 45; }
    case TokenTags.PLUS,
         TokenTags.MINUS: { return 50; }
    case TokenTags.MULT,
         TokenTags.DIVIDE,
         TokenTags.MODULUS: { return 60; }
    default: { return 0; }
  }
}

