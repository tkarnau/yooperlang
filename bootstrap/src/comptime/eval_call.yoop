module comptime;

// Calls, and the one thing that looks like a call and is not: a cast.
//
// A comptime call is a real frame. The callee gets a FRESH scope, so it cannot
// see the caller's locals, and a fresh scope is also what makes recursion work
// - `fact(n - 1)` binds its own `n` rather than stepping on its caller's.
//
// A `ref` parameter is the exception to every copy rule here: it binds the
// caller's SLOT rather than a copy of it, which is what lets a callee mutate
// what it was handed. See value.yoop for why that costs nothing.

import { Vec }, * as vec from "std/core/vec.yoop";
import * as str from "std/core/strings.yoop";
import { Result, Option } from "std/core/types.yoop";
import * as map from "std/collections/map.yoop";
import { disposable } from "std/core/kinds.yoop";
import { AST, ASTNode, ASTNodeKind, NodeId, childAt, declOf, nodeAt } from "../ast";
import { Module, SourceFile } from "../source_graph";
import { AST } from "../ast";
import { TypedModule } from "../typecheck";
import { Program, Type, TypeId, TYPE_ERROR_ID, TYPE_VOID_ID, Symbol, SYMBOL_NONE_ID,
  symbolAt, lookupOwnName, typeAt, primTypeIdOfName,
  isIntPrimType, isFloatPrimType, primIsSigned, primBitWidth } from "../typecheck";
import { floatFromBits } from "../utils";

export function evalCall(ref cx: EvalCx, expr: ASTNode, exprId: NodeId): Result<ValueId, ComptimeError> {
  // A cast is not a call: pass D typed it as the target primitive, and only an
  // UNQUALIFIED name can be one - `ns.usize(x)` reaches a member of `ns`.
  if (expr.childB == 0 && primTypeIdOfName(expr.name) != TYPE_ERROR_ID) {
    return evalCast(ref cx, expr, exprId);
  }
  // `Name.member(...)` is four different things and none of them is a plain
  // call - a trait dispatch, a vtable build, a dispatch through one, or a
  // function in another module. See eval_method.yoop.
  if (expr.childB != 0) {
    return evalQualifiedCall(ref cx, expr, exprId);
  }

  const declId = findFunctionDecl(ref cx, expr.name);
  if (declId != 0) {
    return callFunction(ref cx, declId, expr, exprId);
  }

  // An EXTERN has no body to walk, so it is either on the pure list or it is
  // refused. The list is checked BEFORE the arguments are evaluated: the
  // arguments to a call that cannot happen should not happen either.
  if (isExternHere(ref cx, expr.name) && isWhitelistedExtern(expr.name)) {
    return callExtern(ref cx, expr, exprId);
  }
  if (isExternHere(ref cx, expr.name)) {
    return Result.Err { error: comptimeError(
      `"${expr.name}" is an extern, and only a PURE one may be called at compile time - the program's runtime does not exist yet`,
      expr.sourceLoc
    )};
  }

  return Result.Err { error: comptimeError(
    `"${expr.name}" is not a function declared in this module, so the comptime evaluator cannot call it`,
    expr.sourceLoc
  )};
}

// `int32(x)`, `float64(n)`, `uint8(255)`. One conversion, decided by which side
// is a float and, for the int-to-int case, by the SOURCE's signedness - the
// same fork `castOpFor` makes in codegen.
function evalCast(ref cx: EvalCx, expr: ASTNode, exprId: NodeId): Result<ValueId, ComptimeError> {
  disposable argIds: Vec<NodeId> = callArgIds(ref cx, expr);
  if (argIds.len != 1) {
    return unhandled("a cast with other than one argument", expr.sourceLoc);
  }
  const argId = vec.vecGet(ref argIds, 0);
  const source = typeOfNode(ref cx, argId);
  const target = typeOfNode(ref cx, exprId);
  const value = valueAt(cx.va, evalExprValue(ref cx, argId)?);

  const fromFloat = isFloatPrimType(cx.prog, source);
  const toFloat = isFloatPrimType(cx.prog, target);

  if (fromFloat && toFloat) {
    return Result.Ok { value: floatValue(cx.va, target,
      floatBitsFor(cx.prog, target, floatFromBits(value.bits))) };
  }
  if (fromFloat) {
    // Toward zero, which is what `fptosi` / `fptoui` do.
    const truncated: float64 = floatFromBits(value.bits);
    return Result.Ok { value: intValue(cx.va, target,
      normalizeInt(cx.prog, target, uint64(int64(truncated)))) };
  }
  if (toFloat) {
    // The SOURCE's signedness decides what the bits mean before the widening.
    let asNumber: float64 = 0.0;
    if (primIsSigned(cx.prog, source)) {
      asNumber = float64(asSigned(cx.prog, source, value.bits));
    } else {
      asNumber = float64(value.bits);
    }
    return Result.Ok { value: floatValue(cx.va, target,
      floatBitsFor(cx.prog, target, asNumber)) };
  }

  // Int to int. Widening SIGN-extends from a signed source and zero-extends
  // from an unsigned one; narrowing is a mask either way.
  let widened: uint64 = value.bits;
  if (primIsSigned(cx.prog, source)) {
    widened = uint64(asSigned(cx.prog, source, value.bits));
  }
  return Result.Ok { value: intValue(cx.va, target, normalizeInt(cx.prog, target, widened)) };
}

// The FUNCTION_DECL of `name` in the module being walked, or 0.
function findFunctionDecl(ref cx: EvalCx, name: string): NodeId {
  return findFunctionDeclIn(cx.mod, name);
}

// The same, in any module.
//
// A scan rather than a table: a module's decl list is short, comptime folds are
// few, and a table would have to be invalidated by nothing anyone can see. The
// scan covers every FILE of the module, because a directory module's files see
// each other's declarations without importing.
export function findFunctionDeclIn(ref m: Module, name: string): NodeId {
  let f: usize = 0;
  while (f < m.files.len) {
    const root = vec.vecGet(ref m.files, f).root;
    const programNode = nodeAt(ref m.ast, root);
    let i: usize = 0;
    while (i < programNode.childCount) {
      const declId = declOf(ref m.ast, childAt(ref m.ast, programNode, i));
      const declNode = nodeAt(ref m.ast, declId);
      if (declNode.kind == ASTNodeKind.FUNCTION_DECL && str.stringEq(declNode.name, name)) {
        return declId;
      }
      i += 1;
    }
    f += 1;
  }
  return 0;
}

// One frame: bind the parameters, run the body, take the return value.
function callFunction(
  ref cx: EvalCx,
  declId: NodeId,
  call: ASTNode,
  callId: NodeId
): Result<ValueId, ComptimeError> {
  // The depth guard and the arity check live in `runFrame`, which every call
  // path goes through.
  //
  // The arguments are evaluated in the CALLER's scope, before the callee's
  // exists. A `ref` parameter binds the slot it was handed rather than a copy,
  // which is the whole of comptime mutation-through-a-borrow.
  disposable bound: Vec<ValueId> = vec.vecNew(4);
  disposable argIds: Vec<NodeId> = callArgIds(ref cx, call);
  let i: usize = 0;
  while (i < argIds.len) {
    const argValue = evalExpr(ref cx, vec.vecGet(ref argIds, i))?;
    const opened = openBorrow(ref cx, argValue);
    if (valueAt(cx.va, argValue).kind == ValueKind.REF) {
      vec.vecPush(ref bound, opened);
    } else {
      vec.vecPush(ref bound, cloneValue(cx.va, opened));
    }
    i += 1;
  }

  return runFrame(ref cx, cx.tm, cx.mod, declId, ref bound, call,
    funcReturnTypeOf(cx.prog, cx.tm, nodeAt(cx.ast, declId).name));
}

// One frame, against a NAMED module rather than the caller's.
//
// A method's body lives wherever its type was declared and a namespaced call's
// lives wherever the namespace points, so the frame swaps `tm` and `ast` for
// the callee's. Everything else - the arena, the folded table, the depth - is
// shared, because a value outlives the call that built it.
export function runFrame(
  ref cx: EvalCx,
  ref tm: TypedModule,
  ref m: Module,
  declId: NodeId,
  ref bound: Vec<ValueId>,
  call: ASTNode,
  retTy: TypeId
): Result<ValueId, ComptimeError> {
  if (cx.depth >= MAX_CALL_DEPTH) {
    return Result.Err { error: comptimeError(
      `the comptime call stack passed ${MAX_CALL_DEPTH} frames, which is a runaway recursion rather than a deep fold`,
      call.sourceLoc
    )};
  }
  const decl = nodeAt(ref m.ast, declId);
  if (decl.childD == 0) {
    return Result.Err { error: comptimeError(
      `"${decl.name}" has no body to evaluate at compile time`, call.sourceLoc
    )};
  }

  disposable calleeScope: EvalScope = newEvalScope();
  let inner: EvalCx = {
    prog: cx.prog, tm: ref tm, mod: ref m, ast: ref m.ast, graph: cx.graph,
    va: cx.va, scope: ref calleeScope, folded: cx.folded,
    fnRet: retTy, depth: cx.depth + 1,
  };

  disposable paramIds: Vec<NodeId> = paramNodeIdsIn(ref m.ast, decl);
  if (bound.len != paramIds.len) {
    return Result.Err { error: comptimeError(
      `"${decl.name}" takes ${paramIds.len} argument(s) and was given ${bound.len}`,
      call.sourceLoc
    )};
  }
  let p: usize = 0;
  while (p < paramIds.len) {
    bindLocal(ref calleeScope, nodeAt(ref m.ast, vec.vecGet(ref paramIds, p)).name,
      vec.vecGet(ref bound, p));
    p += 1;
  }

  // A `?` that took its failure branch travels as a marked error and is CAUGHT
  // here: its scope is exactly one function, and this is that function.
  switch (execBlock(ref inner, decl.childD)) {
    case Result.Err { error: e }: {
      if (e.propagating) {
        return Result.Ok { value: e.value };
      }
      return Result.Err { error: e };
    }
    case Result.Ok { value: flow }: {
      switch (flow) {
        case Flow.Returned { value: v }: { return Result.Ok { value: v }; }
        // Falling out of the bottom of a `void` function is a return of
        // nothing; pass D already refused it for any other return type.
        default: { return Result.Ok { value: voidValue(cx.va) }; }
      }
    }
  }
}

// The declared return type of a module-level function, or void.
export function funcReturnTypeOf(ref prog: Program, ref tm: TypedModule, name: string): TypeId {
  const symId = lookupOwnName(ref tm, name);
  if (symId == SYMBOL_NONE_ID) {
    return TYPE_VOID_ID;
  }
  switch (symbolAt(ref prog, symId)) {
    case Symbol.Func { typeId: t }: { return returnTypeOfFuncType(ref prog, t); }
    default: { return TYPE_VOID_ID; }
  }
}

export function returnTypeOfFuncType(ref prog: Program, funcTy: TypeId): TypeId {
  switch (typeAt(ref prog, funcTy)) {
    case Type.Func { params: p, ret: r, variadic: v, isAsync: a }: { return r; }
    default: { return TYPE_VOID_ID; }
  }
}

// True when `name` was declared in an `extern` block in this module.
function isExternHere(ref cx: EvalCx, name: string): bool {
  switch (map.mapGet(ref cx.tm.externNames, name)) {
    case Option.Some { value: v }: { return true; }
    case Option.None: { return false; }
  }
}

// One whitelisted extern: evaluate the arguments, then hand them over.
function callExtern(ref cx: EvalCx, expr: ASTNode, exprId: NodeId): Result<ValueId, ComptimeError> {
  disposable argIds: Vec<NodeId> = callArgIds(ref cx, expr);
  disposable args: Vec<ValueId> = vec.vecNew(argIds.len);
  let i: usize = 0;
  while (i < argIds.len) {
    vec.vecPush(ref args, evalExprValue(ref cx, vec.vecGet(ref argIds, i))?);
    i += 1;
  }
  return callWhitelistedExtern(ref cx, expr.name, ref args,
    typeOfNode(ref cx, exprId), expr.sourceLoc);
}

// The ARGUMENT nodes of a call, in order. They hang off childA as a NODE_LIST -
// the node's own child run is empty, and childB is the qualifying base.
function callArgIds(ref cx: EvalCx, call: ASTNode): Vec<NodeId> propagates<disposable> {
  // NOT `disposable`: the obligation TRANSFERS to the caller, which is what
  // `propagates<disposable>` on the return type says. Declaring the local
  // disposable as well frees the vector on the way out and hands back the
  // freed pointer - invisible under the test harness, whose arena allocator
  // never reclaims, and a segfault in the real compiler.
  let ids: Vec<NodeId> = vec.vecNew(4);
  if (call.childA == 0) {
    return ids;
  }
  const list = nodeAt(cx.ast, call.childA);
  let i: usize = 0;
  while (i < list.childCount) {
    vec.vecPush(ref ids, childAt(cx.ast, list, i));
    i += 1;
  }
  return ids;
}

// The PARAM nodes of a function decl, in order. childB is the parameter list.
export function paramNodeIdsIn(ref ast: AST, decl: ASTNode): Vec<NodeId> propagates<disposable> {
  // Transferred up, not disposed here - see callArgIds.
  let ids: Vec<NodeId> = vec.vecNew(4);
  if (decl.childB == 0) {
    return ids;
  }
  const list = nodeAt(ref ast, decl.childB);
  let i: usize = 0;
  while (i < list.childCount) {
    vec.vecPush(ref ids, childAt(ref ast, list, i));
    i += 1;
  }
  return ids;
}
