/*
  Author: Tom Karnau

  Notes:
    This program should feed "example" strings as input to the lexer.
    It is a little unclear whether we want to use the compiler and have it run in a 
    "tokenize" mode, or if we should import the lexer code here. 
    It may be useful for other tools in the future, and makes this test less "fake".
    For now, let's just import the lexer code and pass strings through it.

    We'll want to test keyword tokens, structural tokens, and atom tokens, and comment/whitespace
*/

import { Result } from "std/core/types.yoop";
import * as log from "std/log.yoop";
import * as intr from "std/core/intrinsics.yoop";
import { tokenize, Token, KEYWORD_LIST, TOKEN_SCAN_LIST, TokenTags } from "../../src/lex";


// store this at compile time so that we can declare a fixed array of assertion
// values
// @precompile const KEYWORD_COUNT = KEYWORD_LIST.len;

function main(): int {
  // first test all defined keywords
  // const expectedKeywordTokens: Token[KEYWORD_COUNT]; 
  let keywordTestString = "";
  for kd in KEYWORD_LIST {
    keywordTestString = `${keywordTestString}${kd.str} `;
  }

  const keywordTestBytes = intr.stringAsBytes(keywordTestString);

  const keywordTokenResult = tokenize(keywordTestBytes);
  switch (keywordTokenResult) {
    case Result.Err { error: e } : {
      log.error(`keyword token test failure: ${e}`);
      return 1;
    }
    case Result.Ok { value: tokens } : {
      const expectedCount = KEYWORD_LIST.len;
      log.info(`keyword lex finished - found ${tokens.len} tokens, expecting ${expectedCount} keyword tokens, verifying results...`);
      let count: usize = 0;
      for kd in KEYWORD_LIST {
        let found = false;
        for tok in tokens {
          if (tok.tag == kd.tag) {
            count += 1;
            found = true;
          }
        }
        if (!found) {
          log.info(`keyword ${kd.str} was not found in the tokens.`);
        }
      }

      if (count != expectedCount) {
        log.error(`Failure: found ${count} tokenized keywords, expected ${expectedCount}`);
        return 1;
      }

      // success
      log.info(`Success: found ${count}/${expectedCount} keywords successfully`);
    }
  }

  // next test all structural tokens
  let tokenScanTestString = "";
  for tokScan in TOKEN_SCAN_LIST {
    tokenScanTestString = `${tokenScanTestString}${tokScan.str} `;
  }

  const tokenScanTestBytes = intr.stringAsBytes(tokenScanTestString);
  const tokenScanResult = tokenize(tokenScanTestBytes);
  switch (tokenScanResult) {
    case Result.Err { error: e } : {
      log.error(`token scan test failure: ${e}`);
      return 1;
    }
    case Result.Ok { value: tokens} : {
      const expectedCount = TOKEN_SCAN_LIST.len;
      log.info(`structural token lex finished - found ${tokens.len} tokens, expecting ${expectedCount} structural tokens, verifying results...`);
      let count: usize = 0;
      for tokScan in TOKEN_SCAN_LIST {
        let found = false;
        for tok in tokens {
          if (tok.tag == tokScan.tag) {
            count += 1;
            found = true;
          }
        }
        if (!found) {
          log.info(`structural token ${tokScan.str} was not found in the tokens.`);
        }
      }

      if (count != expectedCount) {
        log.error(`Failure: found ${count} tokenized structural tokens, expected ${expectedCount}`);
        return 1;
      }

      // success
      log.info(`Success: found ${count}/${expectedCount} structural tokens successfully`);
    }
  }

  // atoms and comments - identifiers and literals
  const atomTestString = `
  // test comment should be ignored
  /* this should also /* be ignored */ */
  "myString" // 1 string
  'c' '\\n' // 2 chars
  123 123_456 0x99FF 0b0101_1011 0o4357 // 5 int literals
  4325.54 // 1 float literal
  yooperman // 1 identifier
  \`this is a test template literal \${woo}\` // 1 template literal
  // 1 eof
  `;

  const atomTestBytes = intr.stringAsBytes(atomTestString);
  const atomTestResult = tokenize(atomTestBytes);
  switch (atomTestResult) {
    case Result.Err { error: e } : {
      log.error(`Failure: unable to parse atom test string: ${e}`);
      return 1;
    }
    case Result.Ok { value: tokens } : {
      log.info(`atom token lex finished - found ${tokens.len} atoms, verifying results...`);
      let unexpectedTokens = 0;
      let stringsFound = 0;
      let charsFound = 0;
      let intsFound = 0;
      let floatsFound = 0;
      let identifiersFound = 0;
      let templatesFound = 0;
      let eofFound = 0;
      for tok in tokens {
        if (tok.tag == TokenTags.INTLITERAL) {
          intsFound += 1;
        }
        else if (tok.tag == TokenTags.STRLITERAL) {
          stringsFound += 1;
        }
        else if (tok.tag == TokenTags.CHARLITERAL) {
          charsFound += 1;
        }
        else if (tok.tag == TokenTags.FLOATLITERAL) {
          floatsFound += 1;
        }
        else if (tok.tag == TokenTags.TEMPLATELITERAL) {
          templatesFound += 1;
        }
        else if (tok.tag == TokenTags.IDENT) {
          identifiersFound += 1;
        }
        else if (tok.tag == TokenTags.EOF) {
          eofFound += 1;
        }
        else {
          log.info(`found unexpected token: ${tok}`);
          unexpectedTokens += 1;
        }
      }
      if (intsFound != 5) {
        log.error(`expected 5 int literals, found ${intsFound}`);
        return 1;
      }
      if (stringsFound != 1) {
        log.error(`expected 1 string, found ${stringsFound}`);
        return 1;
      }
      if (charsFound != 2) {
        log.error(`expected 2 chars, found ${charsFound}`);
        return 1;
      }
      if (templatesFound != 1) {
        log.error(`expected 1 template literal, found ${templatesFound}`);
        return 1;
      }
      if (floatsFound != 1) {
        log.error(`expected 1 float literal, found ${floatsFound}`);
        return 1;
      }
      if (eofFound != 1) {
        log.error(`expected 1 eof, found ${eofFound}`);
        return 1;
      }
      if (identifiersFound != 1) {
        log.error(`expected 1 identifier, found ${identifiersFound}`);
        return 1;
      }

      if (unexpectedTokens > 0) {
        log.error(`found ${unexpectedTokens} unexpected tokens`);
        return 1;
      }

      let totalFound = stringsFound +
        charsFound +
        intsFound +
        floatsFound +
        identifiersFound +
        templatesFound +
        eofFound;

      log.info(`Success: found ${totalFound}/${tokens.len} expected atoms successfully`);
    }
  }

  return 0;
}