// The four `unsafe_ptr.<op>` forms, and pointer ARITHMETIC.
//
//   unsafe_ptr.cast<T>(p)       reinterpret the pointee
//   unsafe_ptr.toInt(p)         the address as an integer
//   unsafe_ptr.fromInt<T>(n)    an integer back as a pointer
//   unsafe_ptr.toArray<T>(p, n) borrow a (pointer, length) pair as `T[]`
//
// `unsafe_ptr` is a TYPE NAME rather than a namespace, so all four are
// recognized by TEXT rather than resolved - there is nothing to resolve the
// left side against.
//
// Three of them cost between zero and one instruction, because LLVM pointers
// are OPAQUE: `cast` is a change of type and nothing else. `toArray` is the one
// with substance, and it is what wraps a malloc'd buffer as something the
// language can index.
//
// The arithmetic steps by ELEMENTS, not bytes - C's rule and the reference's -
// which is why `roundTrip` below has to allocate `int32`s rather than bytes to
// be able to tell the difference at all.

import.unsafe;

extern "C" from "stdlib.h" {
  function malloc(n: usize): unsafe_ptr<uint8>;
  function free(p: unsafe_ptr<uint8>): void;
}

// A buffer allocated by libc, written through a yoop VIEW, and read back
// through the raw pointer. Both spellings reach the same bytes, which is the
// whole point of `toArray`.
function viaView(): int32 {
  let raw: unsafe_ptr<uint8> = malloc(8);
  let view: uint8[] = unsafe_ptr.toArray<uint8>(raw, 8);
  for (let i = 0; i < 8; i += 1) {
    view[i] = uint8(i * 3);
  }
  printf("view.len=%llu view[5]=%d\n", view.len, int32(view[5]));

  // The same byte through the raw pointer plus an offset.
  let at5: unsafe_ptr<uint8> = raw + 5;
  const echoed: int32 = int32(*at5);
  free(raw);
  return echoed;
}

// The element STRIDE, which is what separates a pointer step from an integer
// one. Four int32s: `p + 2` is 8 bytes along, and `q - p` is 2 rather than 8.
function stride(): int32 {
  let raw: unsafe_ptr<uint8> = malloc(16);
  let ints: unsafe_ptr<int32> = unsafe_ptr.cast<int32>(raw);
  let third: unsafe_ptr<int32> = ints + 2;
  *third = 77;
  const elems: int64 = third - ints;

  // Back to bytes to show the two differ: the same address as a uint8 pointer
  // is 8 along, not 2.
  let bytes: unsafe_ptr<uint8> = unsafe_ptr.cast<uint8>(third);
  const byteDiff: int64 = bytes - raw;

  const readBack: int32 = *third;
  printf("elems=%lld byteDiff=%lld readBack=%d\n", elems, byteDiff, readBack);

  // `p - n` is the mirror of `p + n` and lands back where it started.
  let backAgain: unsafe_ptr<int32> = third - 2;
  let sameStart: int32 = 0;
  if (backAgain == ints) {
    sameStart = 1;
  }
  free(raw);
  return sameStart;
}

// A pointer out to an integer and back in. The address survives, so the two
// pointers compare equal and the value read through the second is the one
// written through the first.
function roundTrip(): int32 {
  let raw: unsafe_ptr<uint8> = malloc(4);
  *raw = 200;
  const n: uintptr = unsafe_ptr.toInt(raw);
  let same: unsafe_ptr<uint8> = unsafe_ptr.fromInt<uint8>(n);
  let matched: int32 = 0;
  if (same == raw) {
    matched = 1;
  }
  const value: int32 = int32(*same);
  free(raw);
  return matched * 1000 + value;
}

function main(): int32 {
  printf("viaView=%d\n", viaView());
  printf("stride=%d\n", stride());
  printf("roundTrip=%d\n", roundTrip());
  return 0;
}
