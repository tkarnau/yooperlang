// Dotted method calls. `x.m(args)` is `Trait.m(ref x, args)` - the receiver is
// borrowed, so a method that writes through `self` changes the caller's value,
// and every receiver shape a `ref` accepts works: a local, a field path, an
// element, a variant, a vtable value, a bounded type parameter. The last line
// is the discharge rule: a hand-written `res.close()` answers the obligation,
// so the closing brace must NOT close it a second time.

trait Shape {
  function area(ref self): int;
  function scale(ref self, k: int): void;
}

type Rect implements Shape {
  w: int,
  h: int,
  function area(ref self): int { return self.w * self.h; }
  function scale(ref self, k: int): void {
    self.w = self.w * k;
    self.h = self.h * k;
  }
}

variant Figure implements Shape {
  Square { s: int },
  Dot,
  function area(ref self): int {
    switch (self) {
      case Figure.Square { s: s }: { return s * s; }
      case Figure.Dot: { return 0; }
    }
  }
  function scale(ref self, k: int): void { }
}

vtable SV for Shape {
  area: () => int,
  scale: (k: int) => void,
}

type Holder {
  r: Rect,
}

function total<T implements Shape>(ref t: T): int {
  return t.area();
}

trait Closer {
  function close(ref self): void;
}

kind tracked {
  appliesTo binding;
  requires Closer;
  mustCall close beforeScopeEnd;
}

type Res implements Closer {
  id: int,
  function close(ref self): void { printf("close %d\n", self.id); }
}

function main(): int {
  let r: Rect = { w: 2, h: 3 };
  printf("area=%d\n", r.area());
  r.scale(2);
  printf("scaled=%d\n", r.area());

  let h: Holder = { r: { w: 1, h: 5 } };
  printf("field=%d\n", h.r.area());

  let xs: Rect[] = [ { w: 1, h: 1 }, { w: 3, h: 3 } ];
  xs[1].scale(2);
  printf("elem=%d\n", xs[1].area());

  let f: Figure = Figure.Square { s: 4 };
  printf("variant=%d\n", f.area());

  let v: SV = SV.from(ref r);
  printf("vtable=%d\n", v.area());
  printf("bound=%d\n", total(ref r));

  tracked res: Res = { id: 7 };
  res.close();
  printf("done\n");
  return 0;
}
