// Expression forms: compound assignment, unary `-` and `!`, bool literals,
// parenthesized grouping, and short-circuiting `&&` / `||`.
//
// The three "side ran" checks are the real test: `false && side()` and
// `true || side()` must print nothing, because the right-hand side is never
// evaluated. A lowering that evaluates both sides passes every other assertion
// here and fails only these.
function side(): bool {
  printf("  side ran\n");
  return true;
}

function inRange(n: int, lo: int, hi: int): bool {
  return n >= lo && n <= hi;
}

// Compound assignment on an ELEMENT. It desugars to `xs[i] = xs[i] <op> v`
// like every other target, which is sound only because the SUBSCRIPT is free
// to read twice - a literal here, a name in the loop below. A subscript that
// could observe being read twice (`xs[g()] += 1`) stays refused.
type Grid { cells: int32[] }

function elementCompound(): int32 {
  let xs: int32[] = [1, 2, 3, 4];
  xs[0] += 100;
  xs[1] -= 1;
  xs[2] *= 3;
  for (let i = 0; i < 4; i += 1) {
    xs[i] += 10;
  }
  // Through a FIELD path bottoming out in an element.
  let g: Grid = { cells: [5, 6] };
  g.cells[1] += 1000;
  return xs[0] + xs[1] + xs[2] + xs[3] + g.cells[1];
}

function main(): int {
  let total: int = 0;
  for (let i = 1; i <= 5; i += 1) {
    total += i * i;
  }
  printf("total=%d neg=%d\n", total, -total);
  printf("not=%d %d\n", !true, !(1 == 1));
  printf("inRange=%d %d\n", inRange(5, 1, 10), inRange(50, 1, 10));

  printf("false && side():\n");
  const a = false && side();
  printf("true || side():\n");
  const b = true || side();
  printf("true && side():\n");
  const c = true && side();
  printf("a=%d b=%d c=%d\n", a, b, c);
  printf("elementCompound=%d\n", elementCompound());
  return 0;
}
