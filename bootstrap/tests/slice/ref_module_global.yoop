// Borrowing a module-level `let`.
//
// A global already IS storage, so `ref counter` is the global's symbol and
// costs no instruction - the same answer a local gets out of its alloca. What
// this fixture is really about is that the three positions a global appears in
// name ONE address: a write through a borrow has to be visible to a later read,
// and a borrow taken twice has to reach the same object both times.

let counter: int32 = 0;
let total: int64 = 0;

type Pair {
  lo: int32,
  hi: int32,
}

let pair: Pair = { lo: 1, hi: 2 };

function bump(ref n: int32): int32 {
  n = n + 1;
  return n;
}

function addTo(ref acc: int64, n: int32): void {
  acc = acc + int64(n);
}

// A borrow of a STRUCT global, written through a field.
function raise(ref p: Pair): void {
  p.hi = p.hi + 10;
}

function main(): int {
  // The write, then the borrow, then the read - all one address.
  counter = 5;
  const after = bump(ref counter);
  printf(`after=${after} counter=${counter}\n`);

  // Twice through the same borrow, so the second call sees the first's store.
  const a = bump(ref counter);
  const b = bump(ref counter);
  printf(`a=${a} b=${b} counter=${counter}\n`);

  addTo(ref total, counter);
  addTo(ref total, counter);
  printf(`total=${total}\n`);

  raise(ref pair);
  printf(`pair.lo=${pair.lo} pair.hi=${pair.hi}\n`);

  // A borrow of a FIELD of a global, which is a gep on the symbol rather than
  // the symbol itself.
  const h = bump(ref pair.hi);
  printf(`h=${h} pair.hi=${pair.hi}\n`);
  return 0;
}
