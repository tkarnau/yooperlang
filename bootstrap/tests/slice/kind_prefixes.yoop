// Kind prefixes in every position that is not a plain `function` keyword: on a
// METHOD, on a PARAMETER, and on a top-level function BESIDE the keyword.
//
// `async` is a kind, not a keyword, so a prefix is an identifier standing where
// `function` would - and a method is a function one scope in. The whole feature
// is that the parser needs no list of blessed words, which is why this file
// declares its own kinds rather than borrowing std's.
//
// Nothing enforces a kind, so none of these change what the program DOES. What
// they change is that the program compiles at all with its annotations intact,
// and that the synthesized `ref self` still arrives - which is the half worth
// asserting, because a prefix sits exactly where the receiver's parser starts.
//
// A parameter takes at most ONE prefix. That is the reference's rule and it is
// refused by name here rather than quietly accepted, so the two agree on what a
// program means and not only on what it looks like.

kind traced {
  appliesTo function;
  signature () => void;
  enumerable as "traced_fns";
}

kind marked {
  appliesTo function;
  signature () => void;
  enumerable as "marked_fns";
}

// The reference restricts a parameter's kind to struct and variant VALUES
// ("kind X can only apply to struct or variant values, got int32"), so every
// prefixed parameter below carries one. The bootstrap does not check that
// clause - it records `appliesTo` and reads nobody - which is the ordinary
// "kinds are not enforced" gap rather than a divergence about this feature.
kind checked {
  appliesTo binding parameter field;
}

trait Shape {
  function area(ref self): int;
  traced perimeter(ref self): int;
}

type Rect implements Shape {
  w: int,
  h: int,
  // The prefix REPLACES the keyword.
  traced area(ref self): int {
    return self.w * self.h;
  }
  // Two prefixes, and the keyword alongside them - both spellings the reference
  // accepts, in one method.
  traced marked function perimeter(ref self): int {
    return 2 * (self.w + self.h);
  }
}

variant Shape2 implements Shape {
  Square { side: int },
  Empty,
  traced area(ref self): int {
    switch (self) {
      case Shape2.Square { side: s }: { return s * s; }
      case Shape2.Empty: { return 0; }
    }
  }
  traced perimeter(ref self): int {
    switch (self) {
      case Shape2.Square { side: s }: { return 4 * s; }
      case Shape2.Empty: { return 0; }
    }
  }
}

// An ENUM case followed by a method is the shape that makes a kind prefix on a
// method ambiguous: `Green function code` is the same two tokens
// `traced function code` opens with, and only the BODY they sit in decides
// which. The comma is here because the reference wants it - the no-comma form
// is a bootstrap parse test rather than a fixture.
trait Coded { function code(ref self): int; }

enum Color implements Coded {
  Red 1,
  Green,
  function code(ref self): int {
    return int(self) * 10;
  }
}

// A TOP-LEVEL declaration takes the prefix-and-keyword spelling too, and that
// is the spelling every `*.test.yoop` in this tree uses (`suite function
// addsNumbers(): void`). A top-level prefix run that stopped on IDENT-then-
// FUNCTION where the METHOD run consumed the keyword would report "unexpected
// token at top level: IDENT". Both go through one function, which is why this
// fixture asserts both in one program: the keyword has to be consumed rather
// than taken for the function's NAME, and a run that stopped one token early
// would emit a function called `function`.
// `traced` declares `signature () => void`, and the reference enforces that on
// a TOP-LEVEL function (it does not on a method), so these two take nothing and
// return nothing and report through a module-level global instead.
traced function tripled(): void {
  tally = tally * 3;
}

traced marked function quadrupled(): void {
  tally = tally * 4;
}

// A prefix on a PARAMETER, with and without `ref` after it.
function boxed(checked b: Rect): int {
  return Shape.area(ref b) + 1;
}

function fromRect(checked ref r: Rect, bump: int): int {
  return Shape.area(ref r) + bump;
}

let tally: int = 1;

function main(): int {
  const r: Rect = { w: 3, h: 4 };
  printf("rect=%d %d\n", Shape.area(ref r), Shape.perimeter(ref r));

  const sq: Shape2 = Shape2.Square { side: 5 };
  const none: Shape2 = Shape2.Empty;
  printf("sq=%d %d empty=%d\n", Shape.area(ref sq), Shape.perimeter(ref sq), Shape.area(ref none));

  // Not `Coded.code(ref Color.Red)`: the reference refuses an enum receiver for
  // a trait method, which is a divergence recorded in bootstrap/README.md, and a
  // fixture has to run identically under both.
  printf("colors=%d %d\n", int(Color.Red), int(Color.Green));

  printf("params=%d %d\n", boxed(r), fromRect(ref r, 100));

  tripled();
  quadrupled();
  printf("tally=%d\n", tally);
  return 0;
}
