// The bounded-wait surface of std/core/concurrency.yoop, and nothing else.
//
// A STUB, on purpose, matching the one beside task_spawn.yoop: the real file
// also carries `awaitTask`, `awaitReadable` and the I/O reactor bridge, and
// every one of those drags in machinery this fixture is not about. The variant
// and the four SIGNATURES below are copied from it exactly - if they drift, the
// fixture is testing something the language does not have.
//
// Each of the four is an INTRINSIC rather than an extern for one reason: each
// takes a `Task<T>`, and an `extern "C"` signature has no way to spell one.

export variant WaitResult<T> {
    Done { value: T },
    Timeout,
    Cancelled,
}

extern "intrinsic" from "compiler" {
    function waitUntil<T>(h: Task<T>, deadline_ns: uint64): WaitResult<T>;
    function cancel<T>(h: Task<T>): void;
    function armComplete<T>(h: Task<T>): c_int;
    function isDone<T>(h: Task<T>): c_int;
}

extern "C" from "yoop_runtime" {
    function yoop_now_ns(): uint64;
    function yoop_sleep_ms(ms: uint64): int32;
}

export function nowNs(): uint64 {
    return yoop_now_ns();
}

export function sleepMs(ms: uint64): int32 {
    return yoop_sleep_ms(ms);
}
