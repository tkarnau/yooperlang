// Integer casts, and the C varargs promotion they exposed.
//
// `narrow(300)` is the load-bearing case. The truncation itself is easy; what is
// easy to get wrong is the printf CALL - passing an i8 to a C variadic leaves
// the upper bits of the slot holding whatever was there before, so the number
// printed is unrelated to the value. It printed 300 before promotion existed.
function sum(xs: int[]): int {
  let total: int = 0;
  for (let i = 0; i < xs.len; i += 1) {
    total += xs[i];
  }
  // xs.len is usize and the sum is int32; widths do not mix without the cast.
  return total + int(xs.len);
}

function widen(small: int8): int64 {
  return int64(small);
}

// Unsigned must ZERO-extend. Sign-extending would turn 200 into -56.
function unsignedWiden(b: uint8): int64 {
  return int64(b);
}

function narrow(big: int64): int8 {
  return int8(big);
}

function main(): int {
  const xs: int[] = [10, 20, 30];
  printf("sum+len=%d\n", sum(xs));
  printf("widen(-1)=%lld unsigned(200)=%lld\n", widen(int8(0 - 1)), unsignedWiden(uint8(200)));
  printf("narrow(300)=%d\n", narrow(int64(300)));
  return 0;
}
