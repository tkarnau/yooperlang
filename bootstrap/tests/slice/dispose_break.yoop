// Disposal on `break` and `continue`.
//
// Leaving a scope through a loop jump leaves it just as much as falling off the
// end does, so the bindings it owns are disposed either way. The bootstrap
// unwinds out to the loop; the JS reference does not, which is why this fixture
// is bootstrap-only - see dispose_break.bootonly.
//
// `continue` matters as much as `break` and is easier to get wrong: it runs
// every iteration rather than once, so a missed disposal there leaks N times.

kind tracked {
  appliesTo binding;
  requires Closer;
  mustCall close beforeScopeEnd;
}

trait Closer {
  function close(ref self): void;
}

type Res implements Closer {
  id: int,
  function close(ref self): void {
    printf("  close %d\n", self.id);
  }
}

function open(n: int): Res {
  printf("  open %d\n", n);
  return { id: n };
}

function main(): int {
  // Breaks on the second iteration. Both iterations dispose - the first at the
  // closing brace, the second on the way out.
  printf("break:\n");
  let i: int = 0;
  while (i < 4) {
    tracked r: Res = open(i);
    if (i == 1) {
      break;
    }
    i = i + 1;
  }

  // `continue` skips the rest of the body, so the disposal has to happen on
  // that path too - three times here, not once.
  printf("continue:\n");
  let j: int = 0;
  while (j < 3) {
    tracked r: Res = open(10 + j);
    j = j + 1;
    continue;
  }

  // A SWITCH nested in a loop, which is where the unwind DEPTH is decided
  // rather than merely used. `break` leaves the switch, so it disposes what the
  // ARM owns and stops - the loop body's binding is still live on the statement
  // after the switch, and disposing it here would be a double free at the
  // closing brace rather than a compile error.
  printf("switch break:\n");
  let k: int = 0;
  while (k < 2) {
    tracked outer: Res = open(20 + k);
    switch (k) {
      case 0: {
        tracked inner: Res = open(100);
        break;
      }
      default: { }
    }
    printf("  after switch %d\n", k);
    k = k + 1;
  }

  // `continue` in the same position targets the LOOP, so it unwinds BOTH - the
  // arm's binding and the loop body's - and the statement after the switch does
  // not run. The two jumps reading one depth is exactly the bug this pair
  // catches.
  printf("switch continue:\n");
  let m: int = 0;
  while (m < 2) {
    tracked outer: Res = open(30 + m);
    m = m + 1;
    switch (m) {
      case 1: {
        tracked inner: Res = open(200);
        continue;
      }
      default: { }
    }
    printf("  after switch %d\n", m);
  }

  printf("done\n");
  return 0;
}
