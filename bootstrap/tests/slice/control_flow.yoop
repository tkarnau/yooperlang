// if / else if / else, a while loop, and assignment.
//
// `classify` returns on every path, so the join block is never emitted -
// getting that wrong puts two terminators in one block and clang rejects it.
function classify(n: int): int {
  if (n < 0) {
    return 0 - 1;
  } else if (n == 0) {
    return 0;
  } else {
    return 1;
  }
}

function sumTo(n: int): int {
  let total: int = 0;
  let i: int = 1;
  while (i <= n) {
    total = total + i;
    i = i + 1;
  }
  return total;
}

function main(): int {
  printf("classify: %d %d %d\n", classify(0 - 5), classify(0), classify(7));
  printf("sumTo(10)=%d sumTo(0)=%d\n", sumTo(10), sumTo(0));
  if (sumTo(4) == 10) {
    printf("sum of 1..4 is 10\n");
  }
  return 0;
}
