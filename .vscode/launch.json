    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env" : {
                "testMode"  : "true"
            },
            "program": "${workspaceFolder}/src/yoopiler.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Typecheck Tests",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env" : {
                "testMode"  : "true"
            },
            "program": "${workspaceFolder}/src/jsyooptypecheck/typecheckTests.js"
        }
    ]
}